---
// Shared shell for every /resources/* freebie kit page, rebuilt 20 Nov 2026
// on Jodie's Etsy template (TemplateLayout). Pages pass eyebrow / heading /
// lede as props and keep their body copy in the default slot.
import TemplateLayout from "./TemplateLayout.astro";
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  eyebrow: string;
  heading: string;
  lede: string;
  meta?: string[];
  guideHref?: string;
  guideLabel?: string;
}
const { title, description, ogImage, eyebrow, heading, lede, meta = [], guideHref, guideLabel } = Astro.props;
import { pillars } from "../data/library.js";
const kitImg = guideHref ? (pillars.find((p) => guideHref.endsWith("/" + p.slug)) || {}).img : undefined;
const pageTitle = title.replace(/\s*[—|-]\s*The Digital Income Edit™?$/, "");
---
<TemplateLayout title={pageTitle} description={description} ogImage={ogImage} stickyHref="#get" stickyLabel="Get it free" heroBuy=".hh .buy">
  <section class="hh">
    <div class={`wrap hh-grid rs2-hh ${kitImg ? "" : "rs2-solo"}`}>
      <div class="box">
        <span class="stk" style="right:-60px;top:-56px">It's<b class="big">free</b></span>
        <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
        <p class="kick">{eyebrow}</p>
        <h1>{heading}</h1>
        <p class="what">{lede}</p>
        <a class="btn buy" href="#get">Get it free <span class="ar">→</span></a>
        {meta.length > 0 && <p class="see">{meta.join(" · ")}</p>}
      </div>
      {kitImg && <figure class="rs2-fig"><div class="hh-ph"><img src={kitImg} alt="" width="720" height="504" decoding="async" /></div></figure>}
    </div>
  </section>
  <section class="sec wash" id="get">
    <div class="wrap">
      <div class="card dash rs2-body">
        <slot />
      </div>
      {guideHref && (
        <a class="card dash rs2-deeper" href={guideHref}>
          <span class="hm-lab">The full system</span>
          <span class="rs2-dt">{guideLabel}</span>
          <span class="btn">Read the guide <span class="ar">→</span></span>
        </a>
      )}
      <p class="see" style="text-align:center;margin-top:30px"><a href="/resources">← All free resources</a></p>
    </div>
  </section>
</TemplateLayout>
