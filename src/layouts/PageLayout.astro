---
import "../styles/global.css";

import Analytics from '@vercel/analytics/astro';
export interface Props {
  title: string;
  description: string;
  wide?: boolean;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, wide = false, ogImage = "/og/default.jpg", noindex = false } = Astro.props;
const SITE = "https://www.thedigitalincomeedit.com";
const canonical = new URL(Astro.url.pathname, SITE).href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${SITE}${ogImage}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel — dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title} | The Digital Income Edit™</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageAbsolute} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />
  <!-- is:global is REQUIRED. Astro scopes component styles with a per-component
       hash, and slotted children carry the *page's* hash, not the layout's.
       Without is:global every selector below compiles to
       `.page-wrap[cid-layout] h1[cid-layout]` and matches nothing, so page
       headers fall back to browser defaults (bold Inter h1, unstyled eyebrow).
       ResourceLayout and CourseLayout already do this correctly.

       Selectors are deliberately low-specificity so the 36 pages that style
       their own hero keep winning. Prose rules use the direct-child combinator
       so they never reach inside cards. -->
  <style is:global>
    .page-wrap{max-width:640px;margin:0 auto;padding:90px 40px 120px}
    .page-wrap.wide{max-width:1100px}
    @media(max-width:640px){.page-wrap{padding:64px 22px 90px}}
    .page-eyebrow{display:block;font-size:11px;font-weight:500;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:24px}
    a.page-eyebrow{transition:color .3s}
    a.page-eyebrow:hover{color:var(--pink)}
    .page-wrap h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(34px,6vw,56px);line-height:1.06;letter-spacing:-.5px;margin-bottom:24px}
    .page-wrap h1 em{font-style:italic;color:var(--pink)}
    .page-wrap > .lede{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:22px;line-height:1.55;color:var(--taupe-deep);margin-bottom:40px;max-width:60ch}
    .page-wrap > p{font-size:17px;line-height:1.75;margin-bottom:24px}
    .page-wrap > ul{margin:0 0 32px;padding-left:20px}
    .page-wrap > ul > li{margin-bottom:12px;line-height:1.65}
  </style>
</head>
<body class="no-js">
  <style>.no-js .reveal{opacity:1;transform:none}</style>

  <nav class="nav">
    <div class="nav-in">
      <a class="logo" href="/">The Digital Income <em>Edit™</em></a>
      <div class="nav-links">
        <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Resources</a><a href="/membership">Membership</a>
        <a class="nav-join" href="/community">Community</a>
      </div>
      <button class="burger" id="burger" aria-label="Menu">☰</button>
    </div>
  </nav>

  <div class="drawer" id="drawer">
    <button class="close" id="close" aria-label="Close">✕</button>
    <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Resources</a><a href="/membership">Membership</a><a href="/community">Community</a>
  </div>

  <main class={wide ? "page-wrap wide" : "page-wrap"}>
    <slot />
  </main>

  <footer>
    <div class="foot-in">
      <div>
        <a class="foot-brand" href="/">The Digital Income <em>Edit™</em></a>
        <div class="foot-tag">Build a business you're obsessed with — online, on your terms.</div>
      </div>
      <div class="foot-col">
        <h2 class="foot-h">Learn</h2>
        <a href="/learn">The Library</a>
        <a href="/learn/complete-pinterest-marketing-guide">Pinterest</a>
        <a href="/learn/ultimate-guide-to-ai">AI</a>
        <a href="/learn/digital-products-guide">Digital Products</a>
      </div>
      <div class="foot-col">
        <h2 class="foot-h">Explore</h2>
        <a href="/shop">Shop</a>
        <a href="/resources">Free Resources</a>
        <a href="/membership">Membership</a>
        <a href="/work-with-me">Work With Me</a>
        <a href="/about">About</a>
      </div>
      <div class="foot-col">
        <h2 class="foot-h">Connect</h2>
        <a href="/community">Community</a>
        <a href="/newsletter">Newsletter</a>
        <a href="https://pinterest.com/Nursemadedigital" rel="noopener" target="_blank">Pinterest</a>
        <a href="https://instagram.com/Nursemadedigital" rel="noopener" target="_blank">Instagram</a>
        <a href="/faq">Questions</a>
        <a href="mailto:hello@thedigitalincomeedit.com">Contact</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 The Digital Income Edit™</span>
      <span><a href="/faq">Questions</a> · <a href="/privacy">Privacy</a> · <a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></span>
    </div>
  </footer>

  <script>
    document.body.classList.remove('no-js');
    const drawer = document.getElementById('drawer');
    document.getElementById('burger').onclick = () => drawer.classList.add('open');
    document.getElementById('close').onclick = () => drawer.classList.remove('open');
    drawer.querySelectorAll('a').forEach(a => a.onclick = () => drawer.classList.remove('open'));
  </script>
  <Analytics />
</body>
</html>
