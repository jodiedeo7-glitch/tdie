---
import visualStyles from "../styles/tdie-visual.css?inline";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HomeChromeHeader from "../components/HomeChromeHeader.astro";
import HomeChromeFooter from "../components/HomeChromeFooter.astro";
import "../styles/global.css";
import "../styles/sales-typography.css";
// Self-host brand fonts so external font requests cannot change the layout.
import "../styles/brand-fonts.css";
// True Polaroid frames on every page (Jodie, 10 Oct 2026).
import "../styles/polaroid.css";

import MetricoolTracker from "../components/MetricoolTracker.astro";
export interface Props {
  title: string;
  description: string;
  wide?: boolean;
  ogImage?: string;
  noindex?: boolean;
  /** Full-bleed page built on src/styles/edit.css: no .page-wrap column. */
  bare?: boolean;
  homeChrome?: boolean;
  /** Extra JSON-LD objects for this page (Product, FAQPage...). */
  schema?: object[];
  /** Opt into the reference-led facelift after this page family passes QA. */
  visualRefresh?: boolean;
  boutiqueHeader?: boolean;
}
const { title, description, wide = false, ogImage = "/og/default.jpg", noindex = false, bare = false, schema = [], visualRefresh = true, boutiqueHeader = false, homeChrome = false } = Astro.props;
const SITE = "https://www.thedigitalincomeedit.com";
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, "") || "/", SITE).href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${SITE}${ogImage}`;
// Breadcrumbs from the path: Home > Section > Page. Section names are title-cased slugs.
const segs = (Astro.url.pathname.replace(/\/+$/, "") || "/").split("/").filter(Boolean);
const crumbName = (s) => s.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
const crumbs = [{ name: "Home", url: `${SITE}/` }, ...segs.map((seg, i) => ({
  name: i === segs.length - 1 ? title : crumbName(seg),
  url: `${SITE}/${segs.slice(0, i + 1).join("/")}`,
}))];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "@id": `${canonical}#page`, url: canonical, name: title, description,
      isPartOf: { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™" },
      publisher: { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/` } },
    ...(segs.length ? [{ "@type": "BreadcrumbList", itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.url })) }] : []),
    ...schema,
  ],
};
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title} | The Digital Income Edit™</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageAbsolute} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageAbsolute} />
  {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <!-- is:global is REQUIRED. Astro scopes component styles with a per-component
       hash, and slotted children carry the *page's* hash, not the layout's.
       Without is:global every selector below compiles to
       `.page-wrap[cid-layout] h1[cid-layout]` and matches nothing, so page
       headers fall back to browser defaults (bold Jost h1, unstyled eyebrow).
       ResourceLayout and CourseLayout already do this correctly.

       Selectors are deliberately low-specificity so the 36 pages that style
       their own hero keep winning. Prose rules use the direct-child combinator
       so they never reach inside cards. -->
  <style is:global>
    .page-wrap{max-width:640px;margin:0 auto;padding:90px 40px 120px}
    .page-wrap.wide{max-width:1100px}
    @media(max-width:640px){.page-wrap{padding:64px 22px 90px}}
    .page-eyebrow{display:block;font-size:11px;font-weight:500;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:24px}
    a.page-eyebrow{transition:color .3s}
    a.page-eyebrow:hover{color:var(--pink)}
    .page-wrap h1{font-family:Gloock,serif;font-weight:300;font-size:clamp(34px,6vw,56px);line-height:1.06;letter-spacing:0;margin-bottom:24px}
    .page-wrap h1 em{font-style:italic;color:var(--pink)}
    .page-wrap > .lede{font-family:Gloock,serif;font-style:italic;font-size:22px;line-height:1.55;color:var(--taupe-deep);margin-bottom:40px;max-width:60ch}
    .page-wrap > p{font-size:17px;line-height:1.75;margin-bottom:24px}
    .page-wrap > ul{margin:0 0 32px;padding-left:20px}
    .page-wrap > ul > li{margin-bottom:12px;line-height:1.65}
  </style>
{visualRefresh && <style is:inline set:html={visualStyles} />}
</head>
<body class:list={["no-js", {"sales-page": Astro.url.pathname.startsWith("/shop") || ["/membership", "/bami", "/work-with-me", "/weekend-ecosystem/preview"].includes(Astro.url.pathname.replace(/\/+$/, ""))}]}>
  <style>.no-js .reveal{opacity:1;transform:none}</style>

  <slot name="before-nav" />
  {homeChrome ? <HomeChromeHeader /> : <SiteNav boutique={boutiqueHeader} />}

  <main class={bare ? "e-page" : wide ? "page-wrap wide" : "page-wrap"}>
    <slot />
  </main>

  {homeChrome ? <HomeChromeFooter /> : <SiteFooter />}

  <script>
    document.body.classList.remove('no-js');
  </script>
  <MetricoolTracker />
</body>
</html>
