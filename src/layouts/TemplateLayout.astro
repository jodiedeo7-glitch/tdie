---
// Shared page shell for pages rebuilt on Jodie's Etsy template (19 Nov 2026):
// meta, nav, footer and the phone sticky button. Look lives in tdie-template.css.
import "../styles/review-bubble.css";
import "../styles/tdie-template.css";
import "../styles/tdie-home.css";
import "../styles/tdie-membership.css";
import "../styles/tdie-shop.css";
import { NAV, NAV_CTA, FOOTER, SOCIAL } from "../data/site.js";
import {WYS_CTA} from "../data/wys-live.js";
import { weekendEcosystem as WE } from "../data/facts.js";
export interface Props { title: string; description: string; ogImage?: string; schema?: object[]; stickyHref?: string; stickyLabel?: string; heroBuy?: string; }
const { title, description, ogImage = "/og/default.jpg", schema = [], stickyHref, stickyLabel, heroBuy = ".hh .buy" } = Astro.props;
const SITE = "https://www.thedigitalincomeedit.com";
const canonical = new URL(Astro.url.pathname, SITE).href;
const og = ogImage.startsWith("http") ? ogImage : SITE + ogImage;
const jsonLd = { "@context": "https://schema.org", "@graph": [ { "@type": "WebPage", "@id": `${canonical}#page`, url: canonical, name: title, description }, ...schema ] };
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFE4EF" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{`${title} | The Digital Income Edit™`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={og} />
  <link rel="preload" as="font" type="font/woff2" href="/wys-sales/fonts/gilda.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/wys-sales/fonts/poppins-400.woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="tdie-t">
<svg width="0" height="0" style="position:absolute"><defs><linearGradient id="spg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff8ac2"/><stop offset=".5" stop-color="#D62E73"/><stop offset="1" stop-color="#c9a8ff"/></linearGradient></defs><symbol id="sp" viewBox="0 0 100 100"><path d="M50 0C53 35 65 47 100 50 65 53 53 65 50 100 47 65 35 53 0 50 35 47 47 35 50 0Z"/></symbol></svg>

<header class="tnav">
 <div class="strip">The Digital Income Edit™</div>
 <nav class="tnav-in" aria-label="Main">
  <ul>{NAV.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  <a class="btn tnav-cta" href={NAV_CTA.href}>7 days free <span class="ar">→</span></a>
  <details class="tmenu"><summary>Menu</summary><div>{NAV.map((l) => <a href={l.href}>{l.label}</a>)}<a href="/resources/faceless-income-blueprint">The Free Blueprint</a><a href={WE.url}>The Weekend Ecosystem™</a><a href={WYS_CTA.href}>The While-You-Sleep Storefront™</a><a href={NAV_CTA.href}>Start 7 days free</a></div></details>
 </nav>
</header>

<main>
<slot />
</main>
<!-- Template pages 50 + 51 -->
<footer class="tfoot">
 <div class="touch"><h2>Get in touch <span class="scr">questions &amp; billing</span></h2><p><a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p></div>
 <div class="wrap tf-cols">{FOOTER.map((col) => <div><h4>{col.h}</h4>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>)}</div>
 <p class="tf-soc">{SOCIAL.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
 <div class="foot">© 2026 The Digital Income Edit™</div>
</footer>

{stickyHref && <a class="stick off" href={stickyHref}>{stickyLabel} <span class="ar">→</span></a>}
<script is:inline define:vars={{heroBuy}}>
(function(){var s=document.querySelector('.stick');if(!s||!('IntersectionObserver'in window))return;var vis=new Set(),passed=false,hero=document.querySelector(heroBuy);
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)vis.add(e.target);else vis.delete(e.target);if(e.target===hero){passed=!e.isIntersecting&&e.boundingClientRect.top<0}});s.classList.toggle('off',!passed||vis.size>0)});
document.querySelectorAll('.buy').forEach(function(b){io.observe(b)})})();
</script>
</body>
</html>
