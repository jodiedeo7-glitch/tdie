---
import PageLayout from "../layouts/PageLayout.astro";

const neverDo = [
  "Write code",
  "Design a page",
  "Hire a developer",
  "Learn WordPress",
  "Stare at a blank page",
  "Film yourself",
  "Think of content ideas",
  "Post daily to stay visible",
  "Pay monthly, forever",
];

const teasers = [
  { n: "22", l: "Modules" },
  { n: "36", l: "Prompts, verbatim" },
  { n: "3", l: "Reference vaults" },
  { n: "30", l: "Assets per article" },
];

const packOut = [
  { n: "10", t: "Pinterest pins",   d: "Each a different layout. Image prompt written out in full.", ac: "#CBB7F7" },
  { n: "8",  t: "Carousel slides",  d: "Hook slide first, plus caption and five real search-term hashtags.", ac: "#CD97DD" },
  { n: "2",  t: "Video concepts",   d: "A six-second loop and an action clip, each with a cover prompt.", ac: "#CF80C2" },
  { n: "3",  t: "Threads / X posts", d: "Three separate ideas, not one idea cut up.", ac: "#D265A8" },
  { n: "1",  t: "Facebook post",    d: "The same material, warmer register.", ac: "#D4498D" },
  { n: "1",  t: "Email",            d: "Subject, preview text, body, one call to action.", ac: "#D53C80" },
  { n: "1",  t: "Community post",   d: "Written the way a person talks.", ac: "#D62E73" },
  { n: "All", t: "Headlines listed", d: "Every headline and subhead, ready to reuse.", ac: "#C8A96A" },
];
---
<PageLayout
  title="The Weekend Ecosystem™ — Waitlist"
  description="Your website + blog, built from what you already have. One weekend with Claude. Join the waitlist for first access and the lowest price it will ever be."
>
  <section class="wl-hero">
    <div class="page-eyebrow">Opening soon · Waitlist</div>
    <h1>The Weekend <em>Ecosystem™</em></h1>
    <p class="lede">Your website + blog, built from what you already have. One weekend with Claude, and you're a business owner — not just a product seller.</p>

    <div class="wl-form">
      <div class="wl-row" id="wl-row">
        <input id="wl-email" type="email" placeholder="you@example.com" autocomplete="email" />
        <button id="wl-go" class="wl-btn">Join the waitlist</button>
      </div>
      <p id="wl-done" class="wl-done">You're on the list. Watch your inbox — one email when the doors open.</p>
      <p id="wl-err" class="wl-err"></p>
      <p class="wl-note">The waitlist opens first, at the lowest price this will ever be. Everyone else waits three days and pays more.</p>
    </div>

    <figure class="wl-fig">
      <img src="/images/we/hook-blog-posts.jpg" alt="You already wrote the blog posts. They're just sitting in your Skool group." loading="eager" width="1200" height="1490" />
    </figure>

    <figure class="wl-fig wl-fig-numbers">
      <img src="/images/we/the-numbers.jpg" alt="22 modules. 36 prompts, verbatim. 3 reference vaults. 1 weekend. Your website and blog, built from what you already have." loading="lazy" width="1200" height="1490" />
    </figure>

    <div class="wl-stats wl-mobile-only">
      {teasers.map((t) => (
        <div class="wl-stat">
          <span class="wl-stat-n">{t.n}</span>
          <span class="wl-stat-l">{t.l}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="wl-block">
    <h2>You already wrote it</h2>
    <p class="wl-lead">Every lesson in your classroom. Every post you've written. The call you recorded in March. The DM where you explained your whole method to one person, for free, at midnight.</p>
    <p class="wl-lead">It's all sitting somewhere nobody can search, on a platform you don't own. This weekend you don't write anything new — you build the place it lives, works, and compounds.</p>

    <figure class="wl-fig wl-fig-wide">
      <img src="/images/we/friday-sunday.jpg" alt="Friday: content scattered across a platform you don't own, no website, no blog, nobody finds you unless they already know you. Sunday: a site on a domain you own, a blog Google can find, an email list that captures, a system that runs without you. You didn't write anything new." loading="lazy" width="1200" height="1490" />
    </figure>
  </section>

  <section class="wl-block">
    <h2>You're not building it. You're approving it.</h2>
    <p class="wl-lead">Nine things Claude does. Three things you do. That's the split that makes a weekend enough.</p>
    <figure class="wl-fig wl-fig-wide">
      <img src="/images/we/who-does-what.jpg" alt="Who actually does the work. Claude does: writes every file your website needs, turns a lesson into a 3,000-word article, runs four SEO passes, builds the supporting article cluster, builds your email capture pages, writes your lead magnets, turns one article into thirty assets, generates every image, commits the files to your site. You do: paste the prompt, read what came back, say yes or say what to change. That's the whole job. Three moves, twenty-two times." loading="lazy" width="1200" height="1490" />
    </figure>
  </section>

  <section class="wl-block">
    <h2>Building a website in 2026</h2>
    <p class="wl-lead">None of this is required anymore. That's the part that hasn't sunk in for most people yet.</p>
    <div class="wl-never">
      {neverDo.map((x) => <span class="wl-never-chip">{x}</span>)}
    </div>
    <p class="wl-never-line">You already wrote it. Claude builds the rest.</p>
  </section>

  <section class="wl-block">
    <h2>Sixteen hours, start to finish</h2>
    <p class="wl-lead">Friday night you find what you already have. By Sunday afternoon it's live and running.</p>
    <figure class="wl-fig wl-fig-wide">
      <img src="/images/we/weekend-timeline.jpg" alt="One weekend, hour by hour. 00 Friday night — Prep, 2 hrs. 01 Saturday morning — The Website, 3 hrs. 02 Saturday afternoon — The Blog, 3 hrs. 03 Saturday night — The Capture System, 3 hrs. 04 Sunday morning — Traffic, 3 hrs. 05 Sunday afternoon — Running It, 2 hrs." loading="lazy" width="1200" height="1490" />
    </figure>
  </section>

  <section class="wl-block">
    <h2>What's actually in it</h2>
    <p class="wl-lead">Twenty-two modules across six phases, every prompt written out word for word, and a fix for every roadblock I hit building this myself.</p>
    <figure class="wl-fig wl-fig-modules">
      <img src="/images/we/module-list.jpg" alt="The full list of 22 modules across six phases: Prep, The Website, The Blog, The Capture System, Traffic, and Running It." loading="lazy" width="1100" height="1191" />
    </figure>
  </section>

  <section class="wl-block">
    <h2>One article becomes a month of content</h2>
    <p class="wl-lead">You paste a published article into one prompt. It comes back as a Repurposing Pack — every asset finished and self-contained, nothing to assemble by hand.</p>

    <div class="wl-pack">
      <div class="wl-pack-top">
        <span class="wl-pack-badge">The part nobody expects</span>
        <span class="wl-pack-total"><b>≈30</b> assets · one prompt · one article</span>
      </div>
      <div class="wl-pack-grid">
        {packOut.map((x) => (
          <div class="wl-pack-cell" style={`--ac:${x.ac}`}>
            <span class="wl-pack-n">{x.n}</span>
            <span class="wl-pack-t">{x.t}</span>
            <span class="wl-pack-d">{x.d}</span>
          </div>
        ))}
      </div>
      <p class="wl-pack-foot">One pack is roughly a month of posting — ten pins across four weeks, one piece per platform per week for the rest. The website isn't work stacked on top of posting. It's the thing that generates the posting.</p>
    </div>
  </section>

  <section class="wl-block">
    <h2>What the waitlist gets</h2>
    <ul class="wl-list">
      <li><strong>First access.</strong> Three full days before anyone else.</li>
      <li><strong>The lowest price it will ever be.</strong> It rises the moment the doors open publicly, and again after that.</li>
      <li><strong>No launch noise.</strong> A handful of emails, then the door opens.</li>
    </ul>
  </section>

  <section class="wl-close">
    <h2>You were a digital product seller.</h2>
    <p class="lede">Now you own the infrastructure.</p>
    <div class="wl-row wl-row-light" id="wl-row2">
      <input id="wl-email2" type="email" placeholder="you@example.com" autocomplete="email" />
      <button id="wl-go2" class="wl-btn wl-btn-light">Join the waitlist</button>
    </div>
    <p id="wl-done2" class="wl-done wl-done-light">You're on the list. Watch your inbox.</p>
    <p id="wl-err2" class="wl-err wl-err-light"></p>
  </section>

  <style>
    .wl-hero{text-align:center;padding:10px 0 60px}
    .wl-hero .page-eyebrow{color:var(--pink)!important}
    .wl-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(42px,8vw,80px);line-height:.98;letter-spacing:-2px;margin:0 0 24px;color:#D62E73}
    .wl-hero h1 em{font-style:italic;color:#2B161B}
    .wl-hero .lede{max-width:600px;margin:0 auto 38px;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:24px;line-height:1.55;color:#5A4048}
    .wl-form{margin-bottom:48px}
    .wl-row{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;max-width:480px;margin:0 auto}
    .wl-row input{flex:1;min-width:230px;padding:16px 18px;border:1px solid rgba(43,22,27,.22);border-radius:5px;
                  font-size:16px;font-family:"Inter",sans-serif;background:#fff;color:#2B161B}
    .wl-row input:focus{outline:none;border-color:var(--pink);box-shadow:0 0 0 3px rgba(214,46,115,.12)}
    .wl-btn{padding:16px 30px;background:var(--pink);color:#fff;border:none;border-radius:5px;cursor:pointer;
            font-size:12px;letter-spacing:2px;text-transform:uppercase;font-family:"Inter",sans-serif;
            transition:transform .2s,box-shadow .2s;white-space:nowrap}
    .wl-btn:hover{transform:translateY(-1px);box-shadow:0 6px 20px rgba(214,46,115,.32)}
    .wl-btn:disabled{opacity:.6;cursor:default;transform:none;box-shadow:none}
    .wl-row-light input{border-color:rgba(251,248,245,.5);background:rgba(255,255,255,.94)}
    .wl-btn-light{background:#FBF8F5;color:#8E2F53}
    .wl-done{display:none;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:20px;line-height:1.5;color:var(--pink);margin:20px auto 0;max-width:44ch}
    .wl-done-light{color:#FBEEF4}
    .wl-err{display:none;font-size:15px;color:var(--pink);margin:14px 0 0}
    .wl-err-light{color:#FFE4EE}
    .wl-note{font-size:14.5px;line-height:1.65;color:#7A5C63;max-width:44ch;margin:20px auto 0}
    .wl-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(43,22,27,.12);border:1px solid rgba(43,22,27,.12);border-radius:6px;overflow:hidden}
    .wl-stat{background:#FBF8F5;padding:24px 16px}
    .wl-stat-n{display:block;font-family:"Fraunces",serif;font-size:clamp(32px,4.4vw,46px);font-weight:300;line-height:1;color:var(--pink);letter-spacing:-1.5px}
    .wl-stat-l{display:block;font-size:10.5px;letter-spacing:2px;text-transform:uppercase;color:#7A5C63;margin-top:9px}
    .wl-fig{margin:0 auto 44px;max-width:520px;padding:0}
    .wl-fig img{width:100%;height:auto;display:block;border-radius:8px;box-shadow:0 14px 44px rgba(43,22,27,.14)}
    .wl-fig-wide{max-width:560px;margin:36px auto 0}
    .wl-fig-modules{max-width:640px;margin:36px auto 0}
    .wl-fig-numbers{max-width:520px;margin:0 auto 8px}
    .wl-mobile-only{display:none}
    .wl-block{padding:64px 0}
    /* section separator — hairline with a centred pink marker */
    .wl-block{position:relative;border-top:none !important}
    .wl-block::before{content:"";position:absolute;top:-4px;left:0;right:0;height:9px;pointer-events:none;
      background:
        radial-gradient(circle at 50% 50%, #D62E73 0 3px, transparent 3.6px),
        linear-gradient(90deg,transparent 0%, rgba(214,46,115,.24) 16%, rgba(200,169,106,.30) 50%, rgba(214,46,115,.24) 84%, transparent 100%);
      background-repeat:no-repeat;
      background-size:100% 9px, 100% 1px;
      background-position:center center, center center}
    .wl-block:first-of-type::before{display:none}

    .wl-block h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,4.6vw,42px);line-height:1.06;margin:0 0 22px;letter-spacing:-.8px;color:#D62E73}
    .wl-lead{font-size:18px;line-height:1.8;max-width:620px;margin:0 0 18px;color:#3B2228}
    /* ── Repurposing Pack callout ── */
    .wl-pack{margin:28px 0 0;padding:26px 28px 24px;border-radius:16px;
      border:1.5px solid rgba(214,46,115,.34);
      background:linear-gradient(150deg,rgba(203,183,247,.20) 0%,rgba(255,138,194,.16) 52%,rgba(214,46,115,.09) 100%);
      box-shadow:0 18px 44px -30px rgba(214,46,115,.55)}
    .wl-pack-top{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:10px 16px;margin-bottom:20px}
    .wl-pack-badge{display:inline-block;background:#D62E73;color:#FBF8F5;font-size:10px;font-weight:600;
      letter-spacing:2.2px;text-transform:uppercase;padding:7px 15px;border-radius:100px;line-height:1}
    .wl-pack-total{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#7A5C63}
    .wl-pack-total b{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:20px;letter-spacing:0;color:#D62E73;vertical-align:-2px}
    .wl-pack-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 44px}
    .wl-pack-cell{display:grid;grid-template-columns:56px 1fr;gap:0 16px;align-items:baseline;
      padding:16px 0;border-bottom:1px solid rgba(214,46,115,.15)}
    .wl-pack-cell:nth-last-child(-n+2){border-bottom:none;padding-bottom:6px}
    .wl-pack-n{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:32px;line-height:1;
      color:var(--ac);text-align:right;letter-spacing:-.5px}
    .wl-pack-t{font-family:"Fraunces",serif;font-weight:400;font-size:17px;line-height:1.25;color:#2B161B}
    .wl-pack-d{grid-column:2;font-size:13.5px;line-height:1.5;color:#7A5C63;margin:5px 0 0}
    .wl-pack-foot{font-size:14.5px;line-height:1.7;color:#5C4048;margin:26px 0 0;max-width:64ch}
    @media(max-width:760px){
      .wl-pack-grid{grid-template-columns:1fr;gap:0}
      .wl-pack-cell:nth-last-child(-n+2){border-bottom:1px solid rgba(214,46,115,.15);padding-bottom:16px}
      .wl-pack-cell:last-child{border-bottom:none;padding-bottom:6px}
    }
    @media(max-width:520px){
      .wl-pack{padding:22px 18px 20px;border-radius:13px}
      .wl-pack-cell{grid-template-columns:46px 1fr;gap:0 13px}
      .wl-pack-n{font-size:26px}
      .wl-pack-t{font-size:15.5px}
      .wl-pack-d{font-size:12.5px}
    }


    .wl-never{display:flex;flex-wrap:wrap;gap:10px;margin:30px 0 26px}
    .wl-never-chip{position:relative;font-size:15.5px;line-height:1.4;padding:11px 17px;border-radius:6px;
                   background:rgba(203,183,247,.16);border:1px solid rgba(43,22,27,.09);color:#7A5C63;
                   text-decoration:line-through;text-decoration-color:rgba(214,46,115,.6);text-decoration-thickness:1.5px}
    .wl-never-chip:nth-child(3n+2){background:rgba(255,138,194,.14)}
    .wl-never-chip:nth-child(3n){background:rgba(200,169,106,.12)}
    .wl-never-line{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:23px;line-height:1.5;color:var(--pink);margin:0}
    .wl-list{list-style:none;padding:0;margin:0;max-width:620px}
    .wl-list li{padding:16px 0 16px 28px;border-bottom:1px solid rgba(43,22,27,.1);font-size:16.5px;line-height:1.65;position:relative;color:#2B161B}
    .wl-list li:before{content:"—";position:absolute;left:0;color:var(--pink)}
    .wl-list strong{color:var(--pink);font-weight:600}
    .wl-close{text-align:center;margin:70px 0 0;padding:72px 40px 68px;border-radius:8px;
              background:linear-gradient(145deg,#B9A2E8 0%,#C79AD2 34%,#C87BA6 64%,#A8446B 100%)}
    .wl-close h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,5vw,48px);margin:0 0 12px;letter-spacing:-1px;color:#fff}
    .wl-close .lede{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:26px;color:#FBEEF4;margin:0 0 32px}
    .wl-close .btn{background:#FBF8F5;color:#8E2F53;border-color:#FBF8F5}
    @media(max-width:720px){
      .wl-fig-numbers{display:none}
      .wl-mobile-only{display:grid}
      .wl-fig-wide,.wl-fig-modules{max-width:100%}
      .wl-stats{grid-template-columns:1fr 1fr}.wl-close{padding:54px 22px 50px}}
  </style>
</PageLayout>

<script>
  function wire(inputId, btnId, rowId, doneId, errId) {
    const input = document.getElementById(inputId);
    const btn = document.getElementById(btnId);
    const row = document.getElementById(rowId);
    const done = document.getElementById(doneId);
    const err = document.getElementById(errId);

    async function join() {
      const email = input.value.trim();
      err.style.display = "none";
      btn.disabled = true;
      btn.textContent = "Adding…";
      try {
        const r = await fetch("/api/waitlist", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Something went wrong.");
        row.style.display = "none";
        done.style.display = "block";
      } catch (e) {
        err.textContent = e.message;
        err.style.display = "block";
        btn.disabled = false;
        btn.textContent = "Join the waitlist";
      }
    }

    btn.addEventListener("click", join);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") join(); });
  }

  wire("wl-email", "wl-go", "wl-row", "wl-done", "wl-err");
  wire("wl-email2", "wl-go2", "wl-row2", "wl-done2", "wl-err2");
</script>
