---
// The Weekly Edit, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../layouts/TemplateLayout.astro";
import FreebieForm from "../components/FreebieForm.astro";

const inside = [
  { t: "A workflow you can run", p: "Not a concept to think about. A sequence you can follow on a Tuesday night with the time you actually have." },
  { t: "The thinking behind a real decision", p: "Something I changed in this business that week, why I changed it, and what it cost me to find out." },
  { t: "Pinterest, AI, digital products", p: "The three engines this brand runs on, and the systems underneath them, written for a business of one." },
  { t: "Nothing you've read four times", p: "No recycled carousel advice. If I don't have something worth your Sunday, I don't send one." },
];
---
<TemplateLayout title="The Weekly Edit Newsletter" description="One email every Sunday: a workflow you can run that week and a real decision from inside The Digital Income Edit™. Free, no daily noise." stickyHref="#subscribe" stickyLabel="Get The Weekly Edit">

<section class="hh">
 <div class="wrap hh-grid nw2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Every<b class="big">Sunday</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">The Weekly Edit</p>
   <h1>One idea you can act on <span class="scr">before Monday.</span></h1>
   <p class="what">For the woman with an hour on Sunday and no patience for another reel. <b>One workflow you can run, one real decision from this business, and the system underneath it.</b></p>
   <a class="btn buy" href="#subscribe">Get The Weekly Edit <span class="ar">→</span></a>
   <p class="see">Every Sunday · One email · Free</p>
  </div>
  <figure class="nw2-fig">
   <div class="hh-ph"><img src="/images/pages/newsletter-journal-desk-560.webp" srcset="/images/pages/newsletter-journal-desk-560.webp 560w, /images/pages/newsletter-journal-desk-900.webp 900w" sizes="(max-width: 900px) 80vw, 360px" width="560" height="695" fetchpriority="high" decoding="async" alt="Hands writing in an open notebook with a gold pen at a sunlit wooden table, beside a cup of coffee, pink peonies and roses, and a pink folder."></div>
   <figcaption class="ab2-cap"><b>Sunday</b> · pen, paper, one idea</figcaption>
  </figure>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>What's in it</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">No daily noise, <span class="scr">no recycled advice.</span></h2>
  <div class="lead"><p>Most newsletters in this space are a content calendar wearing a disguise: five sends a week, each one a repackaged reel. This is one email, once, with something in it.</p></div>
  <div class="faq">{inside.map((i, n) => <div class="qa"><span class="n">{String(n+1).padStart(2,'0')}</span><div><h3>{i.t}</h3><p>{i.p}</p></div></div>)}</div>
 </div>
</section>

<section class="sec" id="subscribe">
 <div class="wrap">
  <p class="kick">Subscribe</p>
  <h2 class="h2">Come <span class="scr">read it.</span></h2>
  <div class="lead"><p>Written for women building without a camera, and without a personal brand to maintain.</p></div>
  <div class="card dash nw2-form" style="position:relative">
   <FreebieForm heading="Get The Weekly Edit" button="Send me Sunday's email" sub="The next one lands Sunday. Unsubscribe anytime." done="You’re in. Watch for Sunday’s email." />
   <p class="bm2-small">No pitch stack, no daily sequence.</p>
  </div>
  <p class="see" style="text-align:center;margin-top:30px"><a href="/learn">← Back to The Library</a></p>
 </div>
</section>
</TemplateLayout>
