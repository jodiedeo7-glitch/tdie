---
import PageLayout from "../layouts/PageLayout.astro";
import FreebieForm from "../components/FreebieForm.astro";

const inside = [
  { t: "A workflow you can run", p: "Not a concept to think about. A sequence you can follow on a Tuesday night with the time you actually have.", ac: "#CBB7F7" },
  { t: "The thinking behind a real decision", p: "Something I changed in this business that week, why I changed it, and what it cost me to find out.", ac: "#CF80C2" },
  { t: "Pinterest, AI, digital products", p: "The three engines this brand runs on, and the systems underneath them — written for a business of one.", ac: "#D4498D" },
  { t: "Nothing you've read four times", p: "No recycled carousel advice. If I don't have something worth your Sunday, I don't send one.", ac: "#D62E73" },
];
---
<PageLayout
  wide
  title="The Weekly Edit — Newsletter"
  description="Practical tutorials, AI workflows, Pinterest strategies, and digital product ideas — one useful email at a time."
>
  <section class="nw-hero">
    <div class="page-eyebrow">The Weekly Edit</div>
    <h1>One idea you can act on<br /><em>before Monday.</em></h1>
    <p class="nw-lede">Practical tutorials, AI workflows, Pinterest strategies and digital product ideas — one beautiful, useful email at a time.</p>
    <div class="nw-meta">
      <span>Every Sunday</span><span class="nw-dot"></span><span>One email</span><span class="nw-dot"></span><span>Free</span>
    </div>
  </section>

  <section class="nw-block nw-first">
    <h2>No daily noise, no recycled advice</h2>
    <p class="nw-lead">Most newsletters in this space are a content calendar wearing a disguise — five sends a week, each one a repackaged reel. This is one email, once, with something in it.</p>
    <div class="nw-grid">
      {inside.map((i) => (
        <div class="nw-card" style={`--ac:${i.ac}`}>
          <h3>{i.t}</h3>
          <p>{i.p}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="nw-block nw-signup">
    <h2>Come read it</h2>
    <p class="nw-sublead">Written for women building quietly, without a personal brand to maintain.</p>
    <div class="nw-form">
      <FreebieForm heading="Get The Weekly Edit" button="Subscribe" />
    </div>
    <p class="nw-fine">Unsubscribe whenever you like. No pitch stack, no daily sequence.</p>
  </section>

  <p class="nw-back"><a href="/learn">← Back to The Library</a></p>

  <style>
    .nw-hero{text-align:center;padding:10px 0 50px}
    .nw-hero .page-eyebrow{color:var(--pink)!important;margin-bottom:24px}
    .nw-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(40px,7vw,74px);line-height:1.02;letter-spacing:-2px;margin:0 0 24px;color:var(--choc)}
    .nw-hero h1 em{font-style:italic;color:var(--pink)}
    .nw-lede{max-width:620px;margin:0 auto;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:25px;line-height:1.5;color:var(--choc-mute)}
    .nw-meta{display:flex;gap:16px;justify-content:center;align-items:center;flex-wrap:wrap;margin-top:30px;
             font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--taupe-deep)}
    .nw-dot{width:3px;height:3px;border-radius:50%;background:var(--gold)}

    .nw-block{padding:72px 0;border-top:1px solid rgba(43,22,27,.1)}
    .nw-first{border-top:none;padding-top:0}
    .nw-block h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,4.8vw,46px);line-height:1.05;margin:0 0 20px;letter-spacing:-1px;color:var(--choc);text-align:center}
    .nw-lead{font-size:18.5px;line-height:1.8;max-width:640px;margin:0 auto;color:var(--choc-soft);text-align:center}
    .nw-sublead{font-size:17px;line-height:1.72;color:var(--choc-mute);max-width:600px;margin:0 auto;text-align:center}

    .nw-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:38px}
    .nw-card{padding:28px;border-radius:2px;
             background:var(--white);
             border:1px solid rgba(43,22,27,.10);border-top:2px solid var(--ac)}
    .nw-card h3{font-family:"Fraunces",serif;font-weight:400;font-size:20px;margin:0 0 10px;line-height:1.22;color:var(--choc)}
    .nw-card p{font-size:15.5px;line-height:1.7;margin:0;color:var(--choc-mute)}

    .nw-signup{text-align:center}
    .nw-form{max-width:560px;margin:0 auto}
    .nw-form :global(.freebie-capture){background:var(--white);
      border:1px solid rgba(43,22,27,.10);border-top:2px solid var(--gold);border-radius:2px;padding:36px 34px;margin:34px 0 0;box-shadow:none;text-align:left}
    .nw-form :global(.fc-h){font-family:"Fraunces",serif;font-weight:400;font-size:25px;color:var(--choc);margin:0 0 8px}
    .nw-form :global(.fc-sub){font-size:14.5px;color:var(--choc-mute);margin:0 0 20px}
    .nw-form :global(.fc-row input){border-radius:2px;border-color:rgba(43,22,27,.18);background:var(--white);padding:14px 16px}
    .nw-form :global(.fc-row button){border-radius:2px;background:var(--pink);padding:14px 30px;font-size:12.5px;
      font-weight:600;letter-spacing:1.6px;text-transform:uppercase;box-shadow:0 10px 26px -10px rgba(214,46,115,.55)}
    .nw-fine{font-size:13.5px;color:var(--taupe-deep);margin:20px 0 0}

    .nw-back{margin-top:62px;text-align:center}
    .nw-back a{color:var(--pink);font-weight:500}

    @media(max-width:820px){.nw-grid{grid-template-columns:1fr}.nw-block{padding:52px 0}}
  </style>
</PageLayout>
