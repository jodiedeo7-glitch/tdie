---
import "../../styles/global.css";

import Analytics from '@vercel/analytics/astro';
// Pillar guides and supporting articles live in src/data/library.js.
import { pillars, articles } from "../../data/library.js";
import { library as LIB, cap } from "../../data/facts.js";
const SITE_URL = "https://www.thedigitalincomeedit.com";
const libLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "@id": `${SITE_URL}/learn#page`, url: `${SITE_URL}/learn`, name: "The Library",
      isPartOf: { "@type": "WebSite", "@id": `${SITE_URL}/#site`, url: `${SITE_URL}/`, name: "The Digital Income Edit™" },
      mainEntity: { "@type": "ItemList", itemListElement: pillars.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.title, url: `${SITE_URL}/learn/${p.slug}` })) } },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "The Library", item: `${SITE_URL}/learn` } ] },
  ],
};
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

// Attach each supporting article to the pillar that carries its category.
const shelf = pillars.map((p) => ({
  ...p,
  cluster: articles.filter((a) => a.category === p.category),
}));

const totalPieces = pillars.length + articles.length;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel — dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Library — Faceless Business Guides | The Digital Income Edit™</title>
  <meta name="description" content={`${pillars.length} free pillar guides and ${articles.length} supporting articles on building a faceless business with AI: offers, email, blogging, automation and more.`} />
  <link rel="canonical" href="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Library | The Digital Income Edit™" />
  <meta property="og:description" content="Every guide, in the order that actually makes sense." />
  <meta property="og:url" content="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,600;0,6..72,700;1,6..72,600;1,6..72,700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body{margin:0;background:var(--cream);font-family:"Inter",sans-serif;color:var(--choc)}

    /* ── HERO ── */
    .lib-hero{position:relative;min-height:58vh;display:flex;align-items:flex-end;overflow:hidden}
    .lib-hero .bg{position:absolute;inset:0;background-image:url(/images/library/hero-office-wide-03.jpg);background-size:cover;background-position:center}
    .lib-hero .veil{position:absolute;inset:0;
      /* Measured from the rendered pixels: the title sat at 2.79:1 over this
         photograph, failing even the 3:1 large-text threshold. Signature pink
         tops out at 4.41 on pure cream, so no veil strength can carry it here.
         Veil raised to .85 at the type and the title moved to --pink-deep. */
      background:linear-gradient(180deg,rgba(251,248,245,.45) 0%,rgba(251,248,245,.85) 55%,var(--cream) 99%)}
    .lib-hero .in{position:relative;max-width:1060px;margin:0 auto;padding:0 28px 52px;width:100%;text-align:center}
    .lib-hero .k{display:inline-block;font-size:11.5px;letter-spacing:2.8px;text-transform:uppercase;color:var(--choc-mute);font-weight:600;margin-bottom:16px;text-decoration:none;transition:opacity .3s}
    .lib-hero .k:hover{opacity:.7}
    .lib-hero h1{font-family:Newsreader,serif;font-weight:300;font-size:clamp(40px,7vw,76px);margin:0 0 14px;letter-spacing:-1.4px;line-height:1;color:var(--pink-deep)}
    .lib-hero p{font-family:Newsreader,serif;font-style:italic;font-size:clamp(19px,2.4vw,24px);color:var(--choc-soft);margin:0 auto;max-width:34ch}

    /* ── COUNT RULE ── */
    .count{max-width:1060px;margin:0 auto;padding:0 28px}
    .count-in{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 30px;
      padding:22px 0 0;border-top:1px solid rgba(43,22,27,.10)}
    .count-in span{font-size:11px;letter-spacing:2.2px;text-transform:uppercase;color:var(--taupe-deep)}
    .count-in b{color:var(--pink-deep);font-weight:600}

    .wrap{max-width:1060px;margin:0 auto;padding:44px 28px 110px}
    a.home{display:inline-block;margin-bottom:38px;font-size:13px;letter-spacing:1px;color:var(--taupe-deep);text-decoration:none}
    a.home:hover{color:var(--pink)}

    /* ── START HERE ── */
    .start{display:grid;grid-template-columns:1fr auto;gap:18px 28px;align-items:center;
      border:1px solid rgba(214,46,115,.22);border-radius:2px;padding:26px 30px;margin-bottom:64px;
      background:var(--white);border:1px solid rgba(43,22,27,.13);border-top:2px solid var(--pink)}
    .start-k{display:block;font-size:10.5px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:var(--pink-deep);margin-bottom:8px}
    .start h2{font-family:Newsreader,serif;font-weight:300;font-size:clamp(21px,2.8vw,27px);letter-spacing:-.4px;margin:0 0 6px;line-height:1.2;color:var(--pink)}
    .start p{font-family:Newsreader,serif;font-style:italic;font-size:18px;color:var(--taupe-deep);margin:0;max-width:52ch}
    .start-go{display:inline-block;white-space:nowrap;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
      color:var(--cream);background:var(--pink-deep);border-radius:2px;padding:13px 24px;text-decoration:none;
      transition:transform .2s,box-shadow .2s}
    .start-go:hover{transform:none;box-shadow:none}

    /* ── SECTION HEAD ── */
    .sec-head{position:relative;margin-bottom:34px;padding-top:44px}
    .sec-head::before{content:"";position:absolute;top:0;left:0;right:0;height:9px;pointer-events:none;
      background:
        radial-gradient(circle at 50% 50%, var(--pink) 0 3px, transparent 3.6px),
        linear-gradient(90deg,transparent 0%, rgba(214,46,115,.24) 16%, rgba(200,169,106,.30) 50%, rgba(214,46,115,.24) 84%, transparent 100%);
      background-repeat:no-repeat;background-size:100% 9px, 100% 1px;
      background-position:center center, center center}
    .sec-head .lbl{font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:10px}
    .sec-head h2{font-family:Newsreader,serif;font-weight:300;font-size:clamp(28px,4.2vw,42px);letter-spacing:-.8px;margin:0 0 10px;color:var(--pink)}
    .sec-head .note{font-family:Newsreader,serif;font-style:italic;font-size:19px;line-height:1.5;color:var(--taupe-deep);margin:0;max-width:50ch}

    /* ── THE SHELF: one block per pillar, cluster nested ── */
    .shelf{display:flex;flex-direction:column;gap:0}
    .pil{position:relative;display:grid;grid-template-columns:112px 1fr;gap:0 30px;
      padding:34px 0 34px 0;border-bottom:1px solid rgba(43,22,27,.09)}
    .pil:first-child{border-top:1px solid rgba(43,22,27,.09)}

    .pil-rail{position:relative;padding-left:20px}
    .pil-spine{position:absolute;left:0;top:6px;bottom:0;width:4px;border-radius:2px;background:var(--ac);
      transition:width .28s cubic-bezier(.24,.65,.3,1)}
    .pil-no{font-family:Newsreader,serif;font-style:italic;font-size:34px;line-height:1;color:var(--choc-soft);display:block}
    .pil-cat{display:block;margin-top:10px;font-size:10px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:var(--taupe-deep);line-height:1.5}
    .pil-time{display:block;margin-top:5px;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--mauve)}

    .pil-main{min-width:0}
    a.pil-link{display:block;text-decoration:none;color:inherit}
    a.pil-link .pil-t{font-family:Newsreader,serif;font-weight:400;font-size:clamp(23px,3vw,31px);line-height:1.16;letter-spacing:-.5px;display:block;
      transition:color .2s}
    a.pil-link:hover .pil-t{color:var(--pink)}
    .pil-s{font-family:Newsreader,serif;font-style:italic;font-size:19px;line-height:1.5;color:var(--taupe-deep);margin:9px 0 0;max-width:54ch}
    .pil-kit{display:inline-flex;align-items:baseline;gap:9px;margin-top:15px}
    .pil-kit-k{font-size:10.5px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;color:var(--gold-deep)}
    .pil-kit-n{font-family:Newsreader,serif;font-size:16px;color:var(--choc-soft)}

    /* nested cluster */
    .clus{margin:20px 0 0;padding:0 0 0 18px;border-left:1px solid rgba(43,22,27,.13);list-style:none;display:flex;flex-direction:column;gap:2px}
    a.clus-row{display:grid;grid-template-columns:1fr auto;gap:6px 18px;align-items:baseline;
      padding:11px 10px 11px 12px;margin-left:-12px;border-radius:2px;text-decoration:none;color:inherit;
      transition:background .25s,transform .25s cubic-bezier(.24,.65,.3,1)}
    a.clus-row:hover{background:rgba(255,138,194,.10);transform:translateX(4px)}
    .clus-t{font-family:Newsreader,serif;font-weight:400;font-size:16px;line-height:1.3}
    .clus-time{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:var(--choc-meta);white-space:nowrap}
    .clus-s{grid-column:1/-1;font-family:Newsreader,serif;font-style:italic;font-size:16px;color:var(--taupe-deep);margin:0}

    /* focus + motion floor */
    a:focus-visible{outline:2px solid var(--pink);outline-offset:3px;border-radius:2px}
    @media(hover:hover){.pil:hover .pil-spine{width:7px}}
    @media(prefers-reduced-motion:reduce){
      *{transition:none !important}
      a.clus-row:hover{transform:none}
      .start-go:hover{transform:none}
    }

    @media(max-width:820px){
      .pil{grid-template-columns:78px 1fr;gap:0 20px;padding:28px 0}
      .pil-rail{padding-left:15px}
      .pil-no{font-size:27px}
      .pil-cat,.pil-time{display:none}
      .start{grid-template-columns:1fr}
      .start-go{justify-self:start}
    }
    @media(max-width:520px){
      .lib-hero{min-height:46vh}
      .wrap{padding:34px 20px 84px}
      .count{padding:0 20px}
      .pil{grid-template-columns:52px 1fr;gap:0 14px}
      .pil-rail{padding-left:12px}
      .pil-no{font-size:22px}
      .clus{padding-left:14px}
    }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(libLd)} />
</head>
<body>
  <SiteNav />
  <main>
  <section class="lib-hero">
    <div class="bg"></div><div class="veil"></div>
    <div class="in">
      <a class="k" href="/">The Digital Income Edit™</a>
      <h1>The Library</h1>
      <p>Every guide, in the order that actually makes sense.</p>
    </div>
  </section>

  <div class="count">
    <div class="count-in">
      <span><b>{pillars.length}</b> pillar guides</span>
      <span><b>{articles.length}</b> supporting articles</span>
      <span><b>{totalPieces}</b> pieces, all free to read</span>
    </div>
  </div>

  <div class="wrap">
    <a class="home" href="/">← Home</a>

    <div class="start">
      <div>
        <span class="start-k">New here</span>
        <h2>Start with number one.</h2>
        <p>It's the widest of the {LIB.guidesWord}, and everything below it assumes you've read it. Twenty minutes, and you leave with a niche, an offer and a traffic source.</p>
      </div>
      <a class="start-go" href={`/learn/${pillars[0].slug}`}>Read guide 01 →</a>
    </div>

    <div class="sec-head">
      <div class="lbl">The {cap(LIB.guidesWord)}</div>
      <h2>The pillar guides</h2>
      <p class="note">Each one is complete on its own, and each carries its own free kit. Read from the top and they build into a business. The shorter pieces underneath a guide answer one problem inside it.</p>
    </div>

    <div class="shelf">
      {shelf.map((p) => (
        <article class="pil" style={`--ac:${p.ac}`}>
          <div class="pil-rail">
            <span class="pil-spine"></span>
            <span class="pil-no">{p.n}</span>
            <span class="pil-cat">{p.category}</span>
            <span class="pil-time">{p.readTime}</span>
          </div>
          <div class="pil-main">
            <a class="pil-link" href={`/learn/${p.slug}`}>
              <span class="pil-t">{p.title}</span>
              <p class="pil-s">{p.sub}</p>
            </a>
            <span class="pil-kit">
              <span class="pil-kit-k">Free kit</span>
              <span class="pil-kit-n">{p.freebie}</span>
            </span>
            {p.cluster.length > 0 && (
              <ul class="clus">
                {p.cluster.map((a) => (
                  <li>
                    <a class="clus-row" href={`/learn/${a.slug}`}>
                      <span class="clus-t">{a.title}</span>
                      <span class="clus-time">{a.readTime}</span>
                      <p class="clus-s">{a.sub}</p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
  </main>
  <SiteFooter />
  <Analytics />
</body>
</html>
