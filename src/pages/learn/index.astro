---
import "../../styles/global.css";

import Analytics from '@vercel/analytics/astro';
// The twelve pillar guides. Slugs of record: Corrections & Decisions Record v2.1, Decision 66.
// `sub` is the outcome, not the topic. `freebie` is the live /resources kit that
// belongs to that pillar — all twelve exist and are deployed.
// `ac` is the spine colour: a twelve-step ramp from Lavender to Signature Hot Pink.
const pillars = [
  { n: "01", title: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", category: "Business Systems", readTime: "20 Min Read", ac: "#CBB7F7",
    sub: "Leave with a niche, an offer and a traffic source — not just a business name.",
    freebie: "The Systems Starter Kit" },
  { n: "02", title: "The Mindset Guide", slug: "mindset-guide", category: "Mindset", readTime: "15 Min Read", ac: "#C7AEF3",
    sub: "Finish the thing you keep restarting.",
    freebie: "The Creator to CEO Kit" },
  { n: "03", title: "The Branding Guide", slug: "branding-guide", category: "Branding", readTime: "16 Min Read", ac: "#C9A2E7",
    sub: "A brand she recognises before she reads the name.",
    freebie: "The Brand Clarity Kit" },
  { n: "04", title: "The Beginner’s Guide to Content Creation for Faceless Brands", slug: "content-creation-guide", category: "Content Creation", readTime: "13 Min Read", ac: "#CD97DD",
    sub: "One session that fills the whole week.",
    freebie: "The Content Creation Kit" },
  { n: "05", title: "The Ultimate Beginner’s Guide to AI", slug: "ultimate-guide-to-ai", category: "AI", readTime: "18 Min Read", ac: "#CE8CD2",
    sub: "Stop collecting prompts. Run a workflow that already knows your brand.",
    freebie: "The AI Starter Kit" },
  { n: "06", title: "The Complete Pinterest Marketing Guide", slug: "complete-pinterest-marketing-guide", category: "Pinterest", readTime: "14 Min Read", ac: "#CF80C2",
    sub: "Traffic that still arrives in the months you post nothing.",
    freebie: "The Pinterest Traffic Kit" },
  { n: "07", title: "The Complete Blogging Guide", slug: "complete-blogging-guide", category: "Blogging", readTime: "17 Min Read", ac: "#D073B5",
    sub: "Posts still being read a year after you publish them.",
    freebie: "The Evergreen Blog Kit" },
  { n: "08", title: "Email Marketing for Beginners", slug: "email-marketing-guide", category: "Email Marketing", readTime: "16 Min Read", ac: "#D265A8",
    sub: "A list that earns, instead of a list you feel guilty about.",
    freebie: "The Email List Starter Kit" },
  { n: "09", title: "Digital Products for Beginners", slug: "digital-products-guide", category: "Digital Products", readTime: "17 Min Read", ac: "#D3579B",
    sub: "A first product priced, packaged and live.",
    freebie: "The First Product Kit" },
  { n: "10", title: "Affiliate Marketing 101", slug: "affiliate-marketing-101", category: "Affiliate Marketing", readTime: "16 Min Read", ac: "#D44A8E",
    sub: "Commission on the products you already recommend for free.",
    freebie: "The Affiliate Starter Kit" },
  { n: "11", title: "How to Automate Your Online Business", slug: "automating-your-online-business", category: "Automation & Paid Traffic", readTime: "15 Min Read", ac: "#D53C80",
    sub: "Get back the hours you spend re-doing the same three tasks.",
    freebie: "The Automation Starter Kit" },
  { n: "12", title: "How to Build Passive Income Streams", slug: "passive-income-guide", category: "Passive Income", readTime: "16 Min Read", ac: "#D62E73",
    sub: "Income that does not stop the week you do.",
    freebie: "The Passive Income Starter Kit" },
];

// Supporting articles — the cluster pieces that sit under a pillar.
// No dedicated freebie: the pillar above each one carries it.
// Matched to their pillar by `category`, so each cluster renders in place.
const articles = [
  { title: "How to Choose Your Niche in a Weekend", slug: "choosing-a-niche", category: "Business Systems", readTime: "12 Min Read",
    sub: "Pick one by Sunday and stop reopening the question." },
  { title: "Everything You've Ever Made Lives in a Room With One Door", slug: "room-with-one-door", category: "Business Systems", readTime: "12 Min Read",
    sub: "You are not short on content. You're short on a place to put it." },
  { title: "How to Create Your First Offer in a Week", slug: "creating-your-first-offer", category: "Digital Products", readTime: "13 Min Read",
    sub: "Something real to sell by Friday." },
  { title: "How to Sell Digital Products Without an Audience", slug: "digital-products-for-beginners", category: "Digital Products", readTime: "12 Min Read",
    sub: "Sales before followers, in that order." },
  { title: "How to Get Your First 1,000 Pinterest Visitors", slug: "pinterest-marketing-guide", category: "Pinterest", readTime: "14 Min Read",
    sub: "The first thousand, from a standing start." },
  { title: "How Pinterest SEO Actually Works", slug: "pinterest-seo", category: "Pinterest", readTime: "11 Min Read",
    sub: "Get found by the woman already searching for it." },
  { title: "How to Write Blog Posts That Still Get Read in a Year", slug: "blogging-guide", category: "Blogging", readTime: "13 Min Read",
    sub: "Write it once. Let it rank for years." },
  { title: "How to Write Your First 5 Emails", slug: "email-marketing-for-beginners", category: "Email Marketing", readTime: "12 Min Read",
    sub: "Five emails that turn a subscriber into a buyer." },
  { title: "How to Earn Your First Affiliate Sale", slug: "affiliate-marketing-for-beginners", category: "Affiliate Marketing", readTime: "11 Min Read",
    sub: "The first commission is the only difficult one." },
  { title: "How to Use AI Without Sounding Like a Robot", slug: "ai-for-online-business", category: "AI", readTime: "12 Min Read",
    sub: "Copy that sounds like you wrote it, because you did." },
  { title: "How to Build a Business That Runs Without You", slug: "business-that-runs-without-you", category: "Automation & Paid Traffic", readTime: "13 Min Read",
    sub: "Take a week off without anything breaking." },
];

// Attach each supporting article to the pillar that carries its category.
const shelf = pillars.map((p) => ({
  ...p,
  cluster: articles.filter((a) => a.category === p.category),
}));

const totalPieces = pillars.length + articles.length;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Library | The Digital Income Edit™</title>
  <meta name="description" content="Every guide from The Digital Income Edit™ — twelve complete pillar guides on Pinterest, AI, digital products, email, blogging and automation, plus the supporting articles underneath them." />
  <link rel="canonical" href="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Library | The Digital Income Edit™" />
  <meta property="og:description" content="Every guide, in the order that actually makes sense." />
  <meta property="og:url" content="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body{margin:0;background:var(--cream);font-family:"Inter",sans-serif;color:var(--choc)}

    /* ── HERO ── */
    .lib-hero{position:relative;min-height:58vh;display:flex;align-items:flex-end;overflow:hidden}
    .lib-hero .bg{position:absolute;inset:0;background-image:url(/images/library/hero-office-wide-03.jpg);background-size:cover;background-position:center}
    .lib-hero .veil{position:absolute;inset:0;
      background:linear-gradient(180deg,rgba(251,248,245,.12) 0%,rgba(251,248,245,.55) 62%,var(--cream) 99%)}
    .lib-hero .in{position:relative;max-width:1060px;margin:0 auto;padding:0 28px 52px;width:100%;text-align:center}
    .lib-hero .k{display:inline-block;font-size:11.5px;letter-spacing:2.8px;text-transform:uppercase;color:var(--pink);font-weight:600;margin-bottom:16px;text-decoration:none;transition:opacity .3s}
    .lib-hero .k:hover{opacity:.7}
    .lib-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(40px,7vw,76px);margin:0 0 14px;letter-spacing:-1.4px;line-height:1;color:#D62E73}
    .lib-hero p{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:clamp(19px,2.4vw,24px);color:var(--choc-soft);margin:0 auto;max-width:34ch}

    /* ── COUNT RULE ── */
    .count{max-width:1060px;margin:0 auto;padding:0 28px}
    .count-in{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 30px;
      padding:22px 0 0;border-top:1px solid rgba(43,22,27,.10)}
    .count-in span{font-size:11px;letter-spacing:2.2px;text-transform:uppercase;color:var(--taupe-deep)}
    .count-in b{color:var(--pink);font-weight:600}

    .wrap{max-width:1060px;margin:0 auto;padding:44px 28px 110px}
    a.home{display:inline-block;margin-bottom:38px;font-size:13px;letter-spacing:1px;color:var(--taupe-deep);text-decoration:none}
    a.home:hover{color:var(--pink)}

    /* ── START HERE ── */
    .start{display:grid;grid-template-columns:1fr auto;gap:18px 28px;align-items:center;
      border:1px solid rgba(214,46,115,.22);border-radius:10px;padding:26px 30px;margin-bottom:64px;
      background:linear-gradient(115deg,rgba(203,183,247,.16),rgba(255,138,194,.13) 62%,rgba(214,46,115,.07))}
    .start-k{display:block;font-size:10.5px;font-weight:600;letter-spacing:2.4px;text-transform:uppercase;color:var(--pink);margin-bottom:8px}
    .start h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(21px,2.8vw,27px);letter-spacing:-.4px;margin:0 0 6px;line-height:1.2;color:#D62E73}
    .start p{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:18px;color:var(--taupe-deep);margin:0;max-width:52ch}
    .start-go{display:inline-block;white-space:nowrap;font-size:11px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
      color:var(--cream);background:var(--pink);border-radius:100px;padding:13px 24px;text-decoration:none;
      transition:transform .2s,box-shadow .2s}
    .start-go:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(214,46,115,.30)}

    /* ── SECTION HEAD ── */
    .sec-head{position:relative;margin-bottom:34px;padding-top:44px}
    .sec-head::before{content:"";position:absolute;top:0;left:0;right:0;height:9px;pointer-events:none;
      background:
        radial-gradient(circle at 50% 50%, #D62E73 0 3px, transparent 3.6px),
        linear-gradient(90deg,transparent 0%, rgba(214,46,115,.24) 16%, rgba(200,169,106,.30) 50%, rgba(214,46,115,.24) 84%, transparent 100%);
      background-repeat:no-repeat;background-size:100% 9px, 100% 1px;
      background-position:center center, center center}
    .sec-head .lbl{font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:10px}
    .sec-head h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,4.2vw,42px);letter-spacing:-.8px;margin:0 0 10px;color:#D62E73}
    .sec-head .note{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:19px;line-height:1.5;color:var(--taupe-deep);margin:0;max-width:50ch}

    /* ── THE SHELF: one block per pillar, cluster nested ── */
    .shelf{display:flex;flex-direction:column;gap:0}
    .pil{position:relative;display:grid;grid-template-columns:112px 1fr;gap:0 30px;
      padding:34px 0 34px 0;border-bottom:1px solid rgba(43,22,27,.09)}
    .pil:first-child{border-top:1px solid rgba(43,22,27,.09)}

    .pil-rail{position:relative;padding-left:20px}
    .pil-spine{position:absolute;left:0;top:6px;bottom:0;width:4px;border-radius:4px;background:var(--ac);
      transition:width .28s cubic-bezier(.24,.65,.3,1)}
    .pil-no{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:34px;line-height:1;color:var(--ac);display:block}
    .pil-cat{display:block;margin-top:10px;font-size:10px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:var(--taupe-deep);line-height:1.5}
    .pil-time{display:block;margin-top:5px;font-size:10px;letter-spacing:1.4px;text-transform:uppercase;color:var(--mauve)}

    .pil-main{min-width:0}
    a.pil-link{display:block;text-decoration:none;color:inherit}
    a.pil-link .pil-t{font-family:"Fraunces",serif;font-weight:400;font-size:clamp(23px,3vw,31px);line-height:1.16;letter-spacing:-.5px;display:block;
      transition:color .2s}
    a.pil-link:hover .pil-t{color:var(--pink)}
    .pil-s{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:19px;line-height:1.5;color:var(--taupe-deep);margin:9px 0 0;max-width:54ch}
    .pil-kit{display:inline-flex;align-items:baseline;gap:9px;margin-top:15px}
    .pil-kit-k{font-size:9.5px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;color:var(--ac)}
    .pil-kit-n{font-family:"Cormorant Garamond",serif;font-size:16px;color:var(--choc-soft)}

    /* nested cluster */
    .clus{margin:20px 0 0;padding:0 0 0 18px;border-left:1px solid rgba(43,22,27,.13);list-style:none;display:flex;flex-direction:column;gap:2px}
    a.clus-row{display:grid;grid-template-columns:1fr auto;gap:6px 18px;align-items:baseline;
      padding:11px 10px 11px 12px;margin-left:-12px;border-radius:6px;text-decoration:none;color:inherit;
      transition:background .25s,transform .25s cubic-bezier(.24,.65,.3,1)}
    a.clus-row:hover{background:rgba(255,138,194,.10);transform:translateX(4px)}
    .clus-t{font-family:"Fraunces",serif;font-weight:400;font-size:16px;line-height:1.3}
    .clus-time{font-size:10px;letter-spacing:1.3px;text-transform:uppercase;color:var(--mauve);white-space:nowrap}
    .clus-s{grid-column:1/-1;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:16px;color:var(--taupe-deep);margin:0}

    /* focus + motion floor */
    a:focus-visible{outline:2px solid var(--pink);outline-offset:3px;border-radius:4px}
    @media(hover:hover){.pil:hover .pil-spine{width:7px}}
    @media(prefers-reduced-motion:reduce){
      *{transition:none !important}
      a.clus-row:hover{transform:none}
      .start-go:hover{transform:none}
    }

    @media(max-width:820px){
      .pil{grid-template-columns:78px 1fr;gap:0 20px;padding:28px 0}
      .pil-rail{padding-left:15px}
      .pil-no{font-size:27px}
      .pil-cat,.pil-time{display:none}
      .start{grid-template-columns:1fr}
      .start-go{justify-self:start}
    }
    @media(max-width:520px){
      .lib-hero{min-height:46vh}
      .wrap{padding:34px 20px 84px}
      .count{padding:0 20px}
      .pil{grid-template-columns:52px 1fr;gap:0 14px}
      .pil-rail{padding-left:12px}
      .pil-no{font-size:22px}
      .clus{padding-left:14px}
    }
  </style>
</head>
<body>
  <section class="lib-hero">
    <div class="bg"></div><div class="veil"></div>
    <div class="in">
      <a class="k" href="/">The Digital Income Edit™</a>
      <h1>The Library</h1>
      <p>Every guide, in the order that actually makes sense.</p>
    </div>
  </section>

  <div class="count">
    <div class="count-in">
      <span><b>{pillars.length}</b> pillar guides</span>
      <span><b>{articles.length}</b> supporting articles</span>
      <span><b>{totalPieces}</b> pieces, all free to read</span>
    </div>
  </div>

  <div class="wrap">
    <a class="home" href="/">← Home</a>

    <div class="start">
      <div>
        <span class="start-k">New here</span>
        <h2>Start with number one.</h2>
        <p>It's the widest of the twelve, and everything below it assumes you've read it. Twenty minutes, and you leave with a niche, an offer and a traffic source.</p>
      </div>
      <a class="start-go" href={`/learn/${pillars[0].slug}`}>Read guide 01 →</a>
    </div>

    <div class="sec-head">
      <div class="lbl">The Twelve</div>
      <h2>The pillar guides</h2>
      <p class="note">Each one is complete on its own, and each carries its own free kit. Read from the top and they build into a business. The shorter pieces underneath a guide answer one problem inside it.</p>
    </div>

    <div class="shelf">
      {shelf.map((p) => (
        <article class="pil" style={`--ac:${p.ac}`}>
          <div class="pil-rail">
            <span class="pil-spine"></span>
            <span class="pil-no">{p.n}</span>
            <span class="pil-cat">{p.category}</span>
            <span class="pil-time">{p.readTime}</span>
          </div>
          <div class="pil-main">
            <a class="pil-link" href={`/learn/${p.slug}`}>
              <span class="pil-t">{p.title}</span>
              <p class="pil-s">{p.sub}</p>
            </a>
            <span class="pil-kit">
              <span class="pil-kit-k">Free kit</span>
              <span class="pil-kit-n">{p.freebie}</span>
            </span>
            {p.cluster.length > 0 && (
              <ul class="clus">
                {p.cluster.map((a) => (
                  <li>
                    <a class="clus-row" href={`/learn/${a.slug}`}>
                      <span class="clus-t">{a.title}</span>
                      <span class="clus-time">{a.readTime}</span>
                      <p class="clus-s">{a.sub}</p>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
  <Analytics />
</body>
</html>
