---
import visualStyles from "../../styles/tdie-visual.css?inline";
import "../../styles/global.css";

// Pillar guides and supporting articles live in src/data/library.js.
import { pillars, articles } from "../../data/library.js";
import { library as LIB, cap } from "../../data/facts.js";
const SITE_URL = "https://www.thedigitalincomeedit.com";
const libLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "CollectionPage", "@id": `${SITE_URL}/learn#page`, url: `${SITE_URL}/learn`, name: "The Library",
      isPartOf: { "@type": "WebSite", "@id": `${SITE_URL}/#site`, url: `${SITE_URL}/`, name: "The Digital Income Edit™" },
      mainEntity: { "@type": "ItemList", itemListElement: pillars.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.title, url: `${SITE_URL}/learn/${p.slug}` })) } },
    { "@type": "BreadcrumbList", itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_URL}/` },
      { "@type": "ListItem", position: 2, name: "The Library", item: `${SITE_URL}/learn` } ] },
  ],
};
import "../../styles/edit.css";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

// Attach each supporting article to the pillar that carries its category.
const shelf = pillars.map((p) => ({
  ...p,
  cluster: articles.filter((a) => a.category === p.category),
}));

const totalPieces = pillars.length + articles.length;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
