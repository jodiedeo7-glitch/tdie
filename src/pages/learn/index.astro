  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Library: Faceless Business Guides | The Digital Income Edit™</title>
  <meta name="description" content={`${pillars.length} free pillar guides and ${articles.length} supporting articles on building a faceless business with AI: offers, email, blogging, automation and more.`} />
  <link rel="canonical" href="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Library | The Digital Income Edit™" />
  <meta property="og:description" content="Every guide, in the order that actually makes sense." />
  <meta property="og:url" content="https://www.thedigitalincomeedit.com/learn" />
  <meta property="og:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://www.thedigitalincomeedit.com/og/default.jpg" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gloock&family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    body.e-page::before,body.e-page::after{display:none}
    /* ── EDITORIAL PUBLICATION PASS ── */
    .lib-head{background:var(--e-cream)}
    .lib-in{min-height:520px}
    .lib-title h1{font-size:clamp(60px,9vw,138px);max-width:9ch}
    .lib-count{align-self:end}
    .start{background:var(--e-paper);padding:30px 24px;border-top:1px solid var(--e-ink);border-bottom:1px solid var(--e-ink)}
    .start-n{font-size:clamp(76px,9vw,126px)}
    .sec-head{margin-top:clamp(10px,2vw,28px)}
    .shelf{border-top:2px solid var(--e-ink)}
    .pil{padding:clamp(42px,5vw,72px) 0;grid-template-columns:clamp(96px,10vw,150px) 1fr;gap:0 clamp(30px,5vw,76px)}
    .pil-no{font-size:clamp(48px,5vw,72px)}
    .pil-main>a.pil-link .pil-t{font-size:clamp(28px,3.4vw,46px);max-width:18ch}
    .pil-s{font-size:16px;max-width:60ch}
    .clus{margin-top:28px;padding-left:22px}
    a.clus-row{padding:15px 12px}
    .clus-t{font-size:18px}
    .clus-s{font-size:14px}
    @media(max-width:860px){.lib-in{min-height:0}.pil{grid-template-columns:78px 1fr}}
    /* ── MASTHEAD ── */
    .lib-head{border-bottom:1px solid var(--e-ink)}
    .lib-in{max-width:1200px;margin:0 auto;padding:clamp(48px,7vw,104px) clamp(16px,4vw,40px) clamp(36px,5vw,64px);display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.65fr);gap:32px clamp(32px,6vw,96px);align-items:end}
    .lib-title h1{font-size:clamp(52px,8.4vw,128px);line-height:.88;letter-spacing:-.05em;margin:0 0 26px}
    .lib-title h1 em{display:block}
    .lib-lede{font-size:clamp(17px,1.5vw,19px);line-height:1.6;color:var(--e-ink-2);max-width:32em;margin:0}
    .lib-count{margin:0;display:grid;gap:0;border-top:1px solid rgba(26,20,23,.2)}
    .lib-count div{display:flex;justify-content:space-between;align-items:baseline;gap:16px;padding:14px 0;border-bottom:1px solid rgba(26,20,23,.14)}
    .lib-count dt{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3)}
    .lib-count dd{margin:0;font-family:var(--e-serif);font-weight:600;font-size:clamp(34px,3.4vw,48px);line-height:1;letter-spacing:-.03em;color:var(--e-ink)}
    .lib-count div:first-child dd{color:var(--e-pink)}
    .wrap{max-width:1200px;margin:0 auto;padding:clamp(40px,5vw,72px) clamp(16px,4vw,40px) clamp(80px,9vw,128px)}
    /* ── START HERE ── */
    .start{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:18px clamp(20px,3vw,40px);align-items:center;padding:28px 0;margin-bottom:clamp(56px,7vw,96px);border-top:1px solid rgba(232,90,155,.7);border-bottom:1px solid rgba(232,90,155,.7)}
    .start-n{font-family:var(--e-serif);font-weight:600;font-size:clamp(64px,8vw,112px);line-height:.8;letter-spacing:-.05em;color:var(--e-pink)}
    .start-k{display:block;font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:8px}
    .start h2{font-family:var(--e-serif);font-weight:600;font-size:clamp(24px,2.6vw,32px);letter-spacing:-.02em;margin:0 0 6px;line-height:1.15;color:var(--e-ink)}
    .start p{font-size:16px;line-height:1.6;color:var(--e-ink-2);margin:0;max-width:52ch}
    .start-go{display:inline-flex;align-items:center;gap:10px;min-height:52px;white-space:nowrap;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;
      color:#fff;background:var(--e-pink);border-radius:999px;padding:14px 26px;text-decoration:none;transition:background .2s}
    .start-go:hover{background:var(--e-pink-t)}
    /* ── SECTION HEAD ── */
    .sec-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px clamp(24px,5vw,80px);align-items:end;margin-bottom:34px}
    .sec-head .lbl{grid-column:1/-1;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);display:flex;align-items:center;gap:12px}
    .sec-head .lbl::before{content:"";width:28px;height:1px;background:var(--e-gold)}
    .sec-head h2{font-family:var(--e-serif);font-weight:600;font-size:clamp(36px,4.6vw,64px);letter-spacing:-.035em;line-height:1;margin:0;color:var(--e-ink)}
    .sec-head .note{font-size:16px;line-height:1.65;color:var(--e-ink-2);margin:0;max-width:44ch}
    /* ── THE SHELF: one block per pillar, cluster nested ── */
    .shelf{display:flex;flex-direction:column;gap:0;border-top:1px solid var(--e-ink)}
    .pil{position:relative;display:grid;grid-template-columns:128px 1fr;gap:0 36px;padding:36px 0;border-bottom:1px solid rgba(26,20,23,.12)}
    .pil-rail{position:relative;padding-left:18px}
    .pil-spine{position:absolute;left:0;top:6px;bottom:0;width:3px;background:var(--ac);transition:width .28s cubic-bezier(.24,.65,.3,1)}
    .pil-no{font-family:var(--e-serif);font-weight:600;font-size:44px;line-height:.9;letter-spacing:-.03em;color:var(--e-ink);display:block}
    .pil-cat{display:block;margin-top:12px;font-size:10.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--e-ink-3);line-height:1.5}
    .pil-time{display:block;margin-top:5px;font-size:11px;color:var(--e-ink-3)}
    .pil-main{min-width:0}
    a.pil-link{display:block;text-decoration:none;color:inherit}
    a.pil-link .pil-t{font-family:var(--e-serif);font-weight:600;font-size:clamp(24px,2.8vw,34px);line-height:1.12;letter-spacing:-.025em;display:block;transition:color .2s}
    a.pil-link:hover .pil-t{color:var(--e-pink-t)}
    .pil-s{font-size:16.5px;line-height:1.55;color:var(--e-ink-2);margin:10px 0 0;max-width:54ch}
    .pil-kit{display:inline-flex;align-items:baseline;gap:9px;margin-top:16px}
    .pil-kit-k{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-pink-t)}
    .pil-kit-n{font-family:var(--e-serif);font-weight:600;font-size:16px;color:var(--e-ink)}
    /* nested cluster */
    .clus{margin:22px 0 0;padding:0 0 0 18px;border-left:1px solid rgba(232,90,155,.7);list-style:none;display:flex;flex-direction:column;gap:2px}
    a.clus-row{display:grid;grid-template-columns:1fr auto;gap:4px 18px;align-items:baseline;padding:11px 10px 11px 12px;margin-left:-12px;text-decoration:none;color:inherit;transition:background .25s}
    a.clus-row:hover{background:var(--e-white)}
    .clus-t{font-family:var(--e-serif);font-weight:600;font-size:17px;line-height:1.3;color:var(--e-ink)}
    .clus-time{font-size:11px;color:var(--e-ink-3);white-space:nowrap}
    .clus-s{grid-column:1/-1;font-size:14.5px;color:var(--e-ink-2);margin:0}
    a:focus-visible{outline:3px solid var(--e-pink);outline-offset:3px}
    @media(hover:hover){.pil:hover .pil-spine{width:6px}}
    @media(prefers-reduced-motion:reduce){*{transition:none !important}}
    @media(max-width:860px){
      .lib-in{grid-template-columns:1fr}
      .sec-head{grid-template-columns:1fr}
      .start{grid-template-columns:auto minmax(0,1fr)}
      .start-go{grid-column:1/-1;justify-self:start}
      .pil{grid-template-columns:78px 1fr;gap:0 18px;padding:28px 0}
      .pil-no{font-size:32px}
      .pil-cat,.pil-time{display:none}
    }
    @media(max-width:520px){
      .pil{grid-template-columns:48px 1fr;gap:0 12px}
      .pil-rail{padding-left:12px}
      .pil-no{font-size:26px}
      .clus{padding-left:14px}
      .start-go{width:100%;justify-content:center}
    }
    .lib-next{margin-top:clamp(72px,10vw,132px);padding:clamp(36px,5vw,64px) 0;border-top:2px solid var(--e-ink);display:grid;grid-template-columns:minmax(0,1.3fr) minmax(260px,.7fr);gap:28px 60px;align-items:end}
  .lib-next h2{font-family:var(--e-serif);font-weight:600;font-size:clamp(34px,4.4vw,58px);line-height:1;letter-spacing:-.035em;margin:10px 0 0;max-width:18ch}
  .lib-next h2 em{font-style:italic}
  .lib-next-actions{display:flex;flex-direction:column;align-items:flex-start;gap:15px}
  .lib-next-primary{display:inline-flex;align-items:center;min-height:52px;padding:14px 22px;background:var(--e-pink);color:#fff;text-decoration:none;font:700 12px/1 Jost,sans-serif;letter-spacing:.1em;text-transform:uppercase}
  .lib-next-primary:hover{background:var(--e-pink-t)}
  .lib-next-secondary{font:600 13px/1.3 Jost,sans-serif;letter-spacing:.08em;text-transform:uppercase;color:var(--e-ink);text-decoration:underline;text-underline-offset:5px}
  @media(max-width:760px){.lib-next{grid-template-columns:1fr}.lib-next-actions{width:100%}.lib-next-primary{width:100%;justify-content:center}}
  /* ── 8 Oct 2026: blog grid ── */
  .bl-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
  .bl-card{display:flex;flex-direction:column;background:#fff;border:2px solid #E891B6;border-radius:24px 8px 24px 8px;overflow:hidden;box-shadow:0 18px 40px -28px rgba(194,24,91,.45);transition:transform .25s}
  @media(hover:hover){.bl-card:hover{transform:translateY(-4px)}}
  .bl-img{position:relative;display:block;aspect-ratio:10/7;overflow:hidden;background:#FFD7E9}
  .bl-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s}
  .bl-card:hover .bl-img img{transform:scale(1.04)}
  .bl-no{position:absolute;left:14px;top:14px;font:600 20px/1 Gloock,serif;background:var(--e-pink);color:#fff;border-radius:999px;min-width:44px;height:44px;display:grid;place-items:center;box-shadow:0 6px 16px -6px rgba(194,24,91,.6)}
  .bl-body{display:flex;flex-direction:column;flex:1;padding:20px 22px 22px}
  .bl-meta{display:flex;justify-content:space-between;gap:10px;margin:0 0 10px;font:600 11px/1.3 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--e-ink-3)}
  .bl-cat{color:var(--e-pink-t)}
  .bl-t{font-family:var(--e-serif);font-weight:600;font-size:23px;line-height:1.15;letter-spacing:-.015em;margin:0 0 8px}
  .bl-t a{color:var(--e-ink);text-decoration:none}
  .bl-t a:hover{color:var(--e-pink-t)}
  .bl-s{font-size:15px;line-height:1.55;color:var(--e-ink-2);margin:0 0 14px}
  .bl-kit{font-size:13.5px;color:var(--e-ink);margin:0 0 18px}
  .bl-kit span{display:inline-block;font:700 10px/1 Jost,sans-serif;letter-spacing:.14em;text-transform:uppercase;background:#FFD7E9;color:var(--e-pink-t);padding:6px 9px;border-radius:999px;margin-right:6px}
  .bl-btn{margin-top:auto;align-self:flex-start;display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:12px 20px;border-radius:999px;background:var(--e-pink);color:#fff;text-decoration:none;font:700 12px/1 Jost,sans-serif;letter-spacing:.1em;text-transform:uppercase}
  .bl-btn:hover{background:var(--e-pink-t)}
  .bl-quick-head{margin-top:clamp(64px,8vw,104px)}
  .bl-quick{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
  .bl-q{display:flex;flex-direction:column;gap:8px;padding:18px 18px 16px;background:linear-gradient(140deg,#FFF2F8,#F6F0FD);border:1.5px solid rgba(232,145,182,.6);border-radius:18px 6px 18px 6px;text-decoration:none;color:inherit;transition:transform .2s,border-color .2s}
  .bl-q:hover{transform:translateY(-3px);border-color:var(--e-pink)}
  .bl-q-cat{font:700 10px/1.3 Jost,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--e-pink-t)}
  .bl-q-t{font-family:var(--e-serif);font-weight:600;font-size:17.5px;line-height:1.25;color:var(--e-ink)}
  .bl-q-s{font-size:13.5px;line-height:1.5;color:var(--e-ink-2)}
  .bl-q-go{margin-top:auto;padding-top:6px;font:700 11px/1 Jost,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--e-pink)}
  @media(max-width:1000px){.bl-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.bl-quick{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:600px){.bl-grid,.bl-quick{grid-template-columns:minmax(0,1fr)}.bl-btn{align-self:stretch;justify-content:center;min-height:48px}}
  .start2{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:28px;align-items:center;margin:0 0 56px;padding:18px;background:linear-gradient(125deg,#FFE3F0,#F3ECFC);border:2px solid #E891B6;border-radius:24px 8px 24px 8px}
  .start2-img{position:relative;display:block;aspect-ratio:10/7;border-radius:16px 4px 16px 4px;overflow:hidden}
  .start2-img img{width:100%;height:100%;object-fit:cover;display:block}
  .start2-badge{position:absolute;left:14px;top:14px;transform:rotate(-6deg);background:#fff;color:var(--e-pink-t);border:2px dashed #E891B6;border-radius:999px;padding:8px 14px;font:700 11px/1 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase}
  .start2-body{padding:6px 10px}
  .start2-k{font:700 11px/1.3 Jost,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 8px}
  .start2 h2{font:600 30px/1.12 Gloock,Georgia,serif!important;margin:0 0 14px!important;color:#1A1417}
  .start2-list{list-style:none;margin:0 0 14px;padding:0;display:grid;gap:8px}
  .start2-list li{position:relative;padding-left:28px;font-size:15.5px;color:#1A1417}
  .start2-list li::before{content:"✓";position:absolute;left:0;top:1px;width:20px;height:20px;border-radius:50%;background:var(--e-pink);color:#fff;font:700 12px/20px Jost,sans-serif;text-align:center}
  .start2-meta{font-size:13.5px;color:#4A3A40;margin:0 0 16px}
  @media(max-width:760px){.start2{grid-template-columns:minmax(0,1fr)}}
  .lib-hero-art{display:none!important}
  .lib-in{align-items:center!important}
  .sec-head{grid-template-columns:minmax(0,1fr)!important;gap:8px!important}
  .sec-head .note{max-width:52em!important}
  .bl-start{position:absolute;right:14px;top:16px;transform:rotate(5deg);background:#fff;color:var(--e-pink-t);border:2px dashed #E891B6;border-radius:999px;padding:7px 12px;font:700 10.5px/1 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase}
</style>
  <script type="application/ld+json" set:html={JSON.stringify(libLd)} />
<style is:inline set:html={visualStyles} />
</head>
<body class="e-page">
  <SiteNav />
  <main>
  <section class="lib-head">
    <div class="lib-in">
      <div class="lib-title">
        <p class="e-kick">The Library · free to read</p>
        <h1>The Library. <em>Read it in order.</em></h1>
        <p class="lib-lede">Every guide on this site started as a lesson inside the classroom. Read from the top and they build into a business. Open any one and it stands on its own.</p>
      </div>
      <div class="lib-hero-side"><figure class="lib-hero-art"><img src="/images/library/detail-shelf-styling-02.jpg" width="1280" height="1280" alt="Pink and cream books, a blush handbag and gold accents on a home-office shelf" decoding="async" /><figcaption>The TDIE library · a pretty place to build your next idea</figcaption></figure>
      <dl class="lib-count">
        <div><dt>Step-by-step guides</dt><dd>{pillars.length}</dd></div>
        <div><dt>Quick reads</dt><dd>{articles.length}</dd></div>
        <div><dt>Pieces, all free</dt><dd>{totalPieces}</dd></div>
      </dl></div>
    </div>
  </section>

  <div class="wrap">
    <div class="sec-head">
      <div class="lbl">Fourteen free guides</div>
      <h2>The step-by-step guides</h2>
      <p class="note">Free, written for beginners, and numbered in order: start with 01 and each guide builds on the last. Every guide comes with a free kit of templates and checklists.</p>
    </div>

    <div class="bl-grid">
      {shelf.map((p) => (
        <article class="bl-card">
          <a class="bl-img" href={`/learn/${p.slug}`} tabindex="-1" aria-hidden="true">
            <img src={p.img} alt="" decoding="async" width="600" height="420" />
            <span class="bl-no">{p.n}</span>{p.n === "01" && <span class="bl-start">Start here</span>}
          </a>
          <div class="bl-body">
            <p class="bl-meta"><span class="bl-cat">{p.category}</span><span>{p.readTime}</span></p>
            <h3 class="bl-t"><a href={`/learn/${p.slug}`}>{p.title}</a></h3>
            <p class="bl-s">{p.sub}</p>
            <p class="bl-kit"><span>Free kit</span> {p.freebie}</p>
            <a class="bl-btn" href={`/learn/${p.slug}`}>Read the guide <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>

    <div class="sec-head bl-quick-head">
      <div class="lbl">Ten minutes or less</div>
      <h2>Quick reads</h2>
      <p class="note">One problem each, answered fast. Every one belongs to a pillar guide above.</p>
    </div>
    <div class="bl-quick">
      {shelf.flatMap((p) => p.cluster.map((a) => (
        <a class="bl-q" href={`/learn/${a.slug}`}>
          <span class="bl-q-cat">{p.category}</span>
          <span class="bl-q-t">{a.title}</span>
          <span class="bl-q-s">{a.sub}</span>
          <span class="bl-q-go">Read it · {a.readTime} <span aria-hidden="true">→</span></span>
        </a>
      )))}
    </div>

    <section class="lib-next" aria-labelledby="lib-next-title">
      <div>
        <p class="e-kick">If you want the build, not just the reading</p>
        <h2 id="lib-next-title">The Library teaches the pieces.<br /><em>The Weekend Ecosystem puts them together.</em></h2>
      </div>
      <div class="lib-next-actions">
        <a class="lib-next-primary" href="/shop/weekend-ecosystem">See the Weekend Ecosystem →</a>
        <a class="lib-next-secondary" href="/membership">Explore membership</a>
      </div>
    </section>
  </div>
  </main>
  <SiteFooter />
</body>
</html>
