---
import "../../styles/global.css";

import Analytics from '@vercel/analytics/astro';
// The twelve pillar guides. Slugs of record: Corrections & Decisions Record v2.1, Decision 66.
// `sub` is the outcome, not the topic. `freebie` is the live /resources kit that
// belongs to that pillar \u2014 all twelve exist and are deployed.
const pillars = [
  { n: "01", title: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", category: "Business Systems", readTime: "20 Min Read",
    sub: "Leave with a niche, an offer and a traffic source \u2014 not just a business name.",
    freebie: "The Systems Starter Kit" },
  { n: "02", title: "The Mindset Guide", slug: "mindset-guide", category: "Mindset", readTime: "15 Min Read",
    sub: "Finish the thing you keep restarting.",
    freebie: "The Creator to CEO Kit" },
  { n: "03", title: "The Branding Guide", slug: "branding-guide", category: "Branding", readTime: "16 Min Read",
    sub: "A brand she recognises before she reads the name.",
    freebie: "The Brand Clarity Kit" },
  { n: "04", title: "The Beginner\u2019s Guide to Content Creation for Faceless Brands", slug: "content-creation-guide", category: "Content Creation", readTime: "13 Min Read",
    sub: "One session that fills the whole week.",
    freebie: "The Content Creation Kit" },
  { n: "05", title: "The Ultimate Beginner\u2019s Guide to AI", slug: "ultimate-guide-to-ai", category: "AI", readTime: "18 Min Read",
    sub: "Stop collecting prompts. Run a workflow that already knows your brand.",
    freebie: "The AI Starter Kit" },
  { n: "06", title: "The Complete Pinterest Marketing Guide", slug: "complete-pinterest-marketing-guide", category: "Pinterest", readTime: "14 Min Read",
    sub: "Traffic that still arrives in the months you post nothing.",
    freebie: "The Pinterest Traffic Kit" },
  { n: "07", title: "The Complete Blogging Guide", slug: "complete-blogging-guide", category: "Blogging", readTime: "17 Min Read",
    sub: "Posts still being read a year after you publish them.",
    freebie: "The Evergreen Blog Kit" },
  { n: "08", title: "Email Marketing for Beginners", slug: "email-marketing-guide", category: "Email Marketing", readTime: "16 Min Read",
    sub: "A list that earns, instead of a list you feel guilty about.",
    freebie: "The Email List Starter Kit" },
  { n: "09", title: "Digital Products for Beginners", slug: "digital-products-guide", category: "Digital Products", readTime: "17 Min Read",
    sub: "A first product priced, packaged and live.",
    freebie: "The First Product Kit" },
  { n: "10", title: "Affiliate Marketing 101", slug: "affiliate-marketing-101", category: "Affiliate Marketing", readTime: "16 Min Read",
    sub: "Commission on the products you already recommend for free.",
    freebie: "The Affiliate Starter Kit" },
  { n: "11", title: "How to Automate Your Online Business", slug: "automating-your-online-business", category: "Automation & Paid Traffic", readTime: "15 Min Read",
    sub: "Get back the hours you spend re-doing the same three tasks.",
    freebie: "The Automation Starter Kit" },
  { n: "12", title: "How to Build Passive Income Streams", slug: "passive-income-guide", category: "Passive Income", readTime: "16 Min Read",
    sub: "Income that does not stop the week you do.",
    freebie: "The Passive Income Starter Kit" },
];

// Supporting articles \u2014 the cluster pieces that sit under a pillar.
// No dedicated freebie: the pillar above each one carries it.
const articles = [
  { title: "How to Choose Your Niche in a Weekend", slug: "choosing-a-niche", category: "Business Systems", readTime: "12 Min Read",
    sub: "Pick one by Sunday and stop reopening the question." },
  { title: "How to Create Your First Offer in a Week", slug: "creating-your-first-offer", category: "Digital Products", readTime: "13 Min Read",
    sub: "Something real to sell by Friday." },
  { title: "How to Sell Digital Products Without an Audience", slug: "digital-products-for-beginners", category: "Digital Products", readTime: "12 Min Read",
    sub: "Sales before followers, in that order." },
  { title: "How to Get Your First 1,000 Pinterest Visitors", slug: "pinterest-marketing-guide", category: "Pinterest", readTime: "14 Min Read",
    sub: "The first thousand, from a standing start." },
  { title: "How Pinterest SEO Actually Works", slug: "pinterest-seo", category: "Pinterest", readTime: "11 Min Read",
    sub: "Get found by the woman already searching for it." },
  { title: "How to Write Blog Posts That Still Get Read in a Year", slug: "blogging-guide", category: "Blogging", readTime: "13 Min Read",
    sub: "Write it once. Let it rank for years." },
  { title: "How to Write Your First 5 Emails", slug: "email-marketing-for-beginners", category: "Email Marketing", readTime: "12 Min Read",
    sub: "Five emails that turn a subscriber into a buyer." },
  { title: "How to Earn Your First Affiliate Sale", slug: "affiliate-marketing-for-beginners", category: "Affiliate Marketing", readTime: "11 Min Read",
    sub: "The first commission is the only difficult one." },
  { title: "How to Use AI Without Sounding Like a Robot", slug: "ai-for-online-business", category: "AI", readTime: "12 Min Read",
    sub: "Copy that sounds like you wrote it, because you did." },
  { title: "How to Build a Business That Runs Without You", slug: "business-that-runs-without-you", category: "Automation & Paid Traffic", readTime: "13 Min Read",
    sub: "Take a week off without anything breaking." },
];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Library | The Digital Income Edit™</title>
  <meta name="description" content="Every guide from The Digital Income Edit™ — twelve complete pillar guides on Pinterest, AI, digital products, email, blogging and automation, plus the supporting articles underneath them." />
  <link rel="canonical" href="https://learn.thedigitalincomeedit.com/learn" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Library | The Digital Income Edit™" />
  <meta property="og:description" content="Every guide, in the order that actually makes sense." />
  <meta property="og:url" content="https://learn.thedigitalincomeedit.com/learn" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    body{margin:0;background:var(--cream);font-family:"Inter",sans-serif;color:var(--choc)}
    .lib-hero{position:relative;min-height:44vh;display:flex;align-items:flex-end;overflow:hidden}
    .lib-hero .bg{position:absolute;inset:0;background-image:url(/images/library/hero-office-wide-03.jpg);background-size:cover;background-position:center}
    .lib-hero .veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,248,245,.4),var(--cream) 96%)}
    .lib-hero .in{position:relative;max-width:820px;margin:0 auto;padding:0 24px 44px;width:100%}
    .lib-hero .k{display:inline-block;transition:opacity .3s;font-size:12px;letter-spacing:2.6px;text-transform:uppercase;color:var(--pink);font-weight:600;margin-bottom:14px}
    .lib-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(34px,5.5vw,58px);margin:0 0 12px;letter-spacing:-.5px}
    .lib-hero p{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:21px;color:var(--choc-soft);margin:0;max-width:38ch}
    .wrap{max-width:820px;margin:0 auto;padding:54px 24px 110px}
    a.home{display:inline-block;margin-bottom:34px;font-size:13px;letter-spacing:1px;color:var(--taupe-deep);text-decoration:none}
    a.home:hover{color:var(--pink)}

    .grp{margin-bottom:78px}
    .grp .lbl{font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:8px}
    .grp h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(26px,3.6vw,36px);letter-spacing:-.4px;margin:0 0 8px}
    .grp .note{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:18px;color:var(--taupe-deep);margin:0 0 26px;max-width:46ch}
    .wrap{max-width:880px}

    a.row{display:grid;grid-template-columns:46px 1fr auto;align-items:start;gap:18px;padding:26px 6px;border-bottom:1px solid var(--gray);text-decoration:none;color:inherit;transition:padding-left .4s cubic-bezier(.24,.65,.3,1),background .4s cubic-bezier(.24,.65,.3,1)}
    a.row .m{display:block;min-width:0}
    a.row .s{display:block;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:18px;line-height:1.45;color:var(--taupe-deep);margin-top:7px;max-width:52ch}
    a.row .f{display:inline-block;margin-top:12px;font-family:"Inter",sans-serif;font-size:10px;font-weight:600;letter-spacing:1.7px;text-transform:uppercase;color:var(--pink);background:rgba(214,46,115,.09);border:1px solid rgba(214,46,115,.22);border-radius:100px;padding:5px 13px}
    a.row:hover .f{background:rgba(214,46,115,.16)}
    a.row:first-of-type{border-top:1px solid var(--gray)}
    a.row:hover{padding-left:16px;background:rgba(255,138,194,.06)}
    a.row .no{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:16px;color:var(--mauve)}
    a.row .t{display:block;font-family:"Fraunces",serif;font-size:clamp(18px,2.4vw,22px);line-height:1.25}
    a.row .c{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--taupe-deep);white-space:nowrap;padding-top:5px}
    a.row.plain{grid-template-columns:1fr auto}
    @media(max-width:640px){a.row{grid-template-columns:34px 1fr;gap:12px}a.row.plain{grid-template-columns:1fr}a.row .c{display:none}}
  </style>
</head>
<body>
  <section class="lib-hero">
    <div class="bg"></div><div class="veil"></div>
    <div class="in">
      <a class="k" href="/">The Digital Income Edit™</a>
      <h1>The Library</h1>
      <p>Every guide, in the order that actually makes sense.</p>
    </div>
  </section>
  <div class="wrap">
    <a class="home" href="/">← Home</a>

    <div class="grp">
      <div class="lbl">The Twelve</div>
      <h2>The pillar guides</h2>
      <p class="note">Each one is complete on its own. Read from the top and they build into a business.</p>
      {pillars.map((p) => (
        <a class="row" href={`/learn/${p.slug}`}>
          <span class="no">{p.n}</span>
          <span class="m">
            <span class="t">{p.title}</span>
            <span class="s">{p.sub}</span>
            <span class="f">Free kit · {p.freebie}</span>
          </span>
          <span class="c">{p.category} · {p.readTime}</span>
        </a>
      ))}
    </div>

    <div class="grp">
      <div class="lbl">Going Deeper</div>
      <h2>Supporting articles</h2>
      <p class="note">Single problems, answered properly. Each one sits underneath a pillar above.</p>
      {articles.map((a) => (
        <a class="row plain" href={`/learn/${a.slug}`}>
          <span class="m">
            <span class="t">{a.title}</span>
            <span class="s">{a.sub}</span>
          </span>
          <span class="c">{a.category} · {a.readTime}</span>
        </a>
      ))}
    </div>
  </div>
  <Analytics />
</body>
</html>
