---
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/edit.css";
import { SKOOL_PLANS, membership, community } from "../data/facts.js";

const { standard: S, premium: P, trialDays } = membership;
const days = `${trialDays} days`;

const title = "Join the Community on Skool";
const description = `Inside the Skool room: daily prompts, ordered trainings and ${community.members} women building faceless businesses beside you. ${days} free.`;

// What actually happens in the room. Facts already on the site, nothing new.
const inside = [
  { n: "01", t: "A prompt every day", p: "Daily Prompts, written for the thing you are actually building, not a generic list you will scroll past." },
  { n: "02", t: "Trainings, in order", p: "The start-here trainings turn a guide you have read into a thing that exists. Ordered, so you always know which room is next." },
  { n: "03", t: "A classroom inside the business it teaches", p: "The site, the funnels and the automation you build are the same ones delivering this page to you right now." },
  { n: "04", t: "Women one step ahead", p: "Not gurus. Women who solved last month what you are stuck on this month, and who are still in the room to ask." },
];
---
<PageLayout bare title={title} description={description}>

  <section class="cm-hero">
    <div class="e-wrap cm-hero-grid">
      <div class="e-rise">
        <p class="e-kick">The room</p>
        <h1 class="cm-h1">Reading it is one thing. <em>Building it is another.</em></h1>
      </div>
      <div class="cm-hero-side e-rise e-rise-2">
        <p class="e-lede">The Digital Income Edit™ community lives on Skool. It is where the build happens: a prompt every day, the trainings in order, and {community.members} women building the same architecture beside you.</p>
        <div class="e-actions">
          <a class="e-btn" href={SKOOL_PLANS}>Start free for {days} <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-btn e-btn--ghost" href="/membership">Compare the two memberships</a>
        </div>
      </div>
    </div>
    <figure class="cm-fig e-wrap">
      <div class="e-figure cm-fig-img">
        <img src="/images/pages/community-studio-1100.webp"
             srcset="/images/pages/community-studio-720.webp 720w, /images/pages/community-studio-1100.webp 1100w, /images/pages/community-studio-1280.webp 1280w"
             sizes="(max-width: 1200px) 100vw, 1200px" width="1280" height="560" decoding="async" fetchpriority="high"
             alt="A wide, sunlit home office: the brand's AI persona working at a round wooden desk beside tall windows, a golden retriever asleep on the rug nearby" />
      </div>
    </figure>
  </section>

  <section class="e-sec cm-inside" aria-labelledby="inside-h">
    <div class="e-wrap cm-inside-grid">
      <div class="cm-inside-head">
        <p class="e-kick">What happens inside</p>
        <h2 class="e-d2" id="inside-h">Four things the room does that a course <em>cannot.</em></h2>
      </div>
      <ol class="cm-list">
        {inside.map((i) => (
          <li>
            <span class="e-num cm-n" aria-hidden="true">{i.n}</span>
            <div>
              <h3>{i.t}</h3>
              <p>{i.p}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="e-sec e-dark cm-who" aria-labelledby="who-h">
    <div class="e-wrap cm-who-grid">
      <div>
        <p class="e-kick">Who is in it</p>
        <h2 class="cm-big" id="who-h"><span class="cm-big-n">{community.members}</span> <span class="cm-big-l">women, building.</span></h2>
      </div>
      <div class="cm-who-copy">
        <p>Most people don't stall because the instructions were unclear. They stall on a Tuesday, alone, at the exact point where the thing stops being fun and starts being work.</p>
        <p class="cm-pull">It is much harder to quit in front of people who are still going.</p>
      </div>
    </div>
  </section>

  <section class="e-sec cm-ways" aria-labelledby="ways-h">
    <div class="e-wrap">
      <div class="cm-ways-head">
        <p class="e-kick">Two ways in</p>
        <h2 class="e-d2" id="ways-h">Same room, <em>two memberships.</em></h2>
      </div>
      <div class="cm-ways-grid">
        <div class="cm-way">
          <p class="cm-way-name">{S.name}</p>
          <p class="e-price cm-way-price">{S.perMonth}</p>
          <p>You build it by hand, with the curriculum and the room.</p>
        </div>
        <div class="cm-way cm-way--p">
          <p class="cm-way-name">{P.name}</p>
          <p class="e-price cm-way-price">{P.perMonth}</p>
          <p>More of the content work done for you, including a content calendar written every month.</p>
        </div>
        <div class="cm-ways-cta">
          <p class="e-small">Either one is free for {days}. Leave from inside the app whenever you like.</p>
          <a class="e-btn" href={SKOOL_PLANS}>Start free for {days} <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href="/membership">Compare the two memberships</a>
        </div>
      </div>
    </div>
  </section>

  <style>
    .cm-hero{padding:clamp(48px,7vw,104px) 0 0}
    .cm-hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.85fr);gap:clamp(28px,5vw,80px);align-items:end}
    .cm-h1{font-size:clamp(44px,6.8vw,100px);line-height:.98;letter-spacing:-.035em;margin:0}
    .cm-hero-side .e-lede{margin-bottom:28px}
    .cm-fig{margin-top:clamp(48px,6vw,88px)}
    .cm-fig-img{aspect-ratio:16/8}
    .cm-fig-img img{object-position:center 40%}

    .cm-inside-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(36px,6vw,96px);align-items:start}
    .cm-inside-head{position:sticky;top:110px}
    .cm-list{list-style:none;margin:0;padding:0}
    .cm-list li{display:grid;grid-template-columns:72px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid var(--e-line)}
    .cm-list li:last-child{border-bottom:1px solid var(--e-line)}
    .cm-n{font-size:40px}
    .cm-list h3{font-size:clamp(22px,2.2vw,28px);line-height:1.15;margin:0 0 8px}
    .cm-list p{margin:0;color:var(--e-ink-2);max-width:36em}

    .cm-who-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(32px,6vw,96px);align-items:end}
    .cm-big{margin:0;line-height:.9}
    .cm-big-n{display:block;font-size:clamp(88px,15vw,200px);letter-spacing:-.05em;color:var(--e-pink)}
    .cm-big-l{display:block;font-size:var(--e-d3);letter-spacing:-.02em;color:#F6EFEA;margin-top:12px}
    .cm-who-copy p{margin:0 0 24px;font-size:18px}
    .cm-pull{font-family:var(--e-serif);font-weight:600;font-size:clamp(24px,2.4vw,30px)!important;line-height:1.3;letter-spacing:-.01em;color:#fff!important;padding-top:24px;border-top:1px solid rgba(200,169,106,.55);margin:0!important}

    .cm-ways-head{max-width:760px;margin:0 0 clamp(32px,4vw,56px)}
    .cm-ways-grid{display:grid;grid-template-columns:1fr 1fr minmax(0,1fr);gap:clamp(20px,3vw,40px);align-items:stretch}
    .cm-way{border-top:1px solid var(--e-ink);padding-top:20px}
    .cm-way--p{border-top:3px solid var(--e-pink);padding-top:18px}
    .cm-way-name{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 10px}
    .cm-way-price{font-size:clamp(34px,3.4vw,44px);margin:0 0 12px}
    .cm-way p:last-child{margin:0;color:var(--e-ink-2)}
    .cm-ways-cta{display:flex;flex-direction:column;align-items:flex-start;gap:12px;padding:24px;background:var(--e-white);border:1px solid var(--e-line);border-radius:6px}
    .cm-ways-cta .e-small{margin:0 0 4px}

    @media (max-width:900px){
      .cm-hero-grid,.cm-inside-grid,.cm-who-grid{grid-template-columns:1fr}
      .cm-inside-head{position:static}
      .cm-ways-grid{grid-template-columns:1fr 1fr}
      .cm-ways-cta{grid-column:1 / -1}
      .cm-fig-img{aspect-ratio:3/2}
    }
    @media (max-width:560px){
      .cm-ways-grid{grid-template-columns:1fr}
      .cm-list li{grid-template-columns:48px minmax(0,1fr);gap:12px}
      .cm-n{font-size:30px}
      .e-actions .e-btn,.cm-ways-cta .e-btn{width:100%}
      .cm-fig{padding-left:0;padding-right:0}
      .cm-fig-img{border-radius:0}
    }
  </style>
</PageLayout>
