---
// Questions, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../layouts/TemplateLayout.astro";
import { membership as M, word } from "../data/facts.js";

// Annual plans expressed as "months' price for twelve", computed from facts.js
// so the sentence can never drift from the prices beside it.
const n = (s) => Number(String(s).replace(/[^0-9.]/g, ""));
const monthsFor = (t) => {
  const r = Math.round((n(t.annual) / n(t.monthly)) * 2) / 2;
  return Number.isInteger(r) ? word(r) : `${word(Math.floor(r))} and a half`;
};

// Beacons affiliate links (shared link for everyone; Beacons does the tracking).
const WE = "https://links.thedigitalincomeedit.com/shop/f7b54195-6a0e-4e95-8b92-fc203770176c";
const WYS = "https://links.thedigitalincomeedit.com/shop/66271fb0-fc54-4aae-ad9f-c826f4635ee7";

const groups = [
  {
    label: "Buying",
    qs: [
      { q: "Do you offer refunds?",
        a: "On digital products, no. Everything in the shop is delivered instantly, so all sales are final: guides, courses, template packs and Pretty & Paid PLR Vault™. That's standard across digital products, mine and everyone else's. Read the page before you buy, and if you're unsure whether something fits where you are, email me first and I'll tell you honestly. Two things work differently: the membership, and The Business Architect Mentorship Intensive™ (BAMI). Both are below." },
      { q: "What about the membership?",
        a: `Different, because it's a subscription rather than a purchase. Both start with a ${M.trial} and you can cancel from inside the app at any time. Canceling stops the next payment; it doesn't refund one you've already made.` },
      { q: "Does BAMI have a guarantee?",
        a: "Yes, and it's the one exception. If within 21 days of your cohort start date you've submitted your completed Phase I business asset and you decide BAMI isn't right for you, email me and your payment is refunded in full within 10 business days. No explanation needed, and it won't count against you if you apply for a later cohort. The Phase I submission is the condition, Phase I is where you settle your identity, your model and your customer, so if you've done that and it still isn't right, it genuinely isn't. Without a submission there's nothing to assess, and the refund comes out of a seat someone else wanted. On a payment plan, any installment already taken is returned and the rest are canceled. If I cancel or move a cohort, you choose a full refund or a seat in the next one at the price you paid." },
      { q: "Can I split the cost of The Weekend Ecosystem™?",
        a: "Yes. It's $67 once (regular $97, Black Friday, until Mon 30 Nov 11:45 pm ET) or 3 payments of $33.33, both at checkout, with every future update included either way." },
      { q: "Where do I get what I bought?",
        a: "Checkout runs through Beacons, and your files arrive by email at the address you paid with. If nothing appears, check spam first, then email me and I'll resend it." },
    ],
  },
  {
    label: "The membership",
    qs: [
      { q: "What's the difference between Standard and Premium?",
        a: `Standard at ${M.standard.monthly} a month teaches you to build it and sell it: the core trainings, Daily Prompts, brand and content training, The Shopify Edit and Pinterest Foundations™. Value Vault guides are bought one at a time. Premium at ${M.premium.monthly} adds The Ads Edit™, the monthly done-for-you content calendar, The Offer Edit, The Funnel Edit, Scaling & Systems, and the Premium Vault with every guide already unlocked.` },
      { q: "Can I pay yearly?",
        a: `Yes. Standard is ${M.standard.annual} for the year and Premium is ${M.premium.annual} (regular $297, Black Friday, until Mon 30 Nov 11:45 pm ET), both billed once. That's roughly ${monthsFor(M.standard)} months' price for twelve on Standard and ${monthsFor(M.premium)} for twelve on Premium. The ${M.trial} applies either way, and annual plans renew annually rather than monthly.` },
      { q: "Is there a free plan?",
        a: `No. There's a ${M.trial} on either tier instead.` },
      { q: "Three things have \"vault\" in the name. Which is which?",
        a: "The Value Vault is the guide collection inside the community. On Standard you buy the guides one at a time; they aren't included in the $9 tier. The Premium Vault is that same collection with every guide already unlocked, included with Premium. Pretty & Paid PLR Vault™ is a separate $11 a month subscription for products you rebrand and resell. It isn't part of either membership." },
      { q: "Is BAMI included?",
        a: "No. The Business Architect Mentorship Intensive™ is separate and by application only." },
    ],
  },
  {
    label: "Affiliate links",
    qs: [
      { q: "Some products here aren't yours. How does that work?",
        a: "Anything marked Recommended · Not mine was built by someone else. I earn a commission if you buy through my link, at no extra cost to you. Those products carry their own prices set by their owners, which can change without notice, and their own delivery and support." },
      { q: "Do you recommend everything you've ever bought?",
        a: "No. Things I've bought and wouldn't recommend don't appear here, and if one turns out not to be worth it I take it down rather than leave it up earning." },
    ],
  },
  {
    label: "Become an affiliate",
    qs: [
      { q: "Can I earn a commission sharing your products?",
        html: `Yes. Two of my products are open to affiliates, with no application and no codes. Everyone uses the same link below:<br><br><strong>The Weekend Ecosystem&trade;</strong>, 30% commission<br><a class="e-link" href="${WE}" rel="noopener" target="_blank" style="overflow-wrap:anywhere">${WE}</a><br><br><strong>The While-You-Sleep Storefront&trade;</strong>, commission shown in Beacons when you add it<br><a class="e-link" href="${WYS}" rel="noopener" target="_blank" style="overflow-wrap:anywhere">${WYS}</a>` },
      { q: "How do I set my link up so I get paid?",
        html: `Beacons tracks every sale, so you need a free Beacons account with a payment processor (Stripe or PayPal) connected. Then:<br><br>1. In Beacons, go to <strong>Products</strong> and tap <strong>+ New Product</strong>.<br>2. Choose <strong>External link</strong>. It has to be this one. Any other product type and the sale won't be credited to you.<br>3. Paste the product link from above and tap <strong>Add</strong>.<br>4. Go to your <strong>Link in Bio</strong>, open the store block you want, and add the product.<br>5. Share your own Beacons store or that product's Beacons link. That's the link that earns.` },
      { q: "My link doesn't have a ref tag in it. Is it broken?",
        a: "No, that's normal. Beacons doesn't use ref tags. Your link sends the buyer through your Beacons store first (you'll see your username flash for a second) and then on to the product page. That quick hop is how Beacons knows the sale was yours." },
      { q: "Can I send people to the sales page on this website instead?",
        a: "Not if you want the commission. Beacons can only credit you when the buyer goes through your Beacons link, and it can't follow anyone who lands on this website first. Always share your Beacons link. It opens the product page, where they can read about it and check out." },
      { q: "What about the membership?",
        a: "The Skool membership has its own affiliate program, separate from Beacons. If you're a member, open the group's three-dot menu and tap Invite people to get your link." },
    ],
  },
  {
    label: "The work itself",
    qs: [
      { q: "Do I have to show my face?",
        a: "No. Nothing taught here requires it. Faceless doesn't mean nobody's there. It means your real face is never the thing being sold." },
      { q: "Do I need an audience to start?",
        a: "No, and starting without one is the point. The order taught here is offer first, then funnel, then automation, then audience, because building the audience first is what leaves people with two years of content and nothing underneath it." },
      { q: "How much time does this actually take?",
        a: "Depends what you're building. The Weekend Ecosystem™ is designed to be finished in two days. The membership moves at whatever pace you set. BAMI assumes four focused hours a week across twelve weeks." },
      { q: "Do I need to be technical?",
        a: "No. AI does the heavy construction throughout. You make the decisions in plain English, and the courses assume you've never opened a code editor." },
    ],
  },
];

const slug = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
---
<TemplateLayout title="Questions" description="Refunds, delivery, membership tiers, affiliate links, and how the work actually runs at The Digital Income Edit™." stickyHref="mailto:hello@thedigitalincomeedit.com" stickyLabel="Email me">

<section class="hh">
 <div class="wrap hh-grid fq2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Ask<b class="big">me</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Questions &amp; billing</p>
   <h1>The things worth <span class="scr">knowing first.</span></h1>
   <p class="what">Buying, billing, what's included where, and how the affiliate side works. <b>If yours isn't here, email&nbsp;me.</b></p>
   <a class="btn buy" href="mailto:hello@thedigitalincomeedit.com">Email me <span class="ar">→</span></a>
   <p class="see">hello@thedigitalincomeedit.com</p>
  </div>
  <nav class="card dash fq2-toc" aria-label="Question topics">
   <p class="pn">Jump to</p>
   <ol>{groups.map((g, i) => <li><a href={`#${slug(g.label)}`}><span class="glit">{String(i + 1).padStart(2, "0")}</span>{g.label}<span class="ar">→</span></a></li>)}</ol>
  </nav>
 </div>
</section>

{groups.map((g, i) => (
 <section class={`sec ${i % 2 === 0 ? "wash" : ""} fq2-sec`} id={slug(g.label)}>
  <div class="wrap">
   <p class="kick">{String(i + 1).padStart(2, "0")} of {groups.length}</p>
   <h2 class="h2"><span class="scr">{g.label}</span></h2>
   <div class="faq">{g.qs.map((item, k) => <div class="qa"><span class="n">{String(k+1).padStart(2,'0')}</span><div><h3>{item.q}</h3>{item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}</div></div>)}</div>
  </div>
 </section>
))}

<section class="sec wash">
 <div class="wrap">
  <div class="card dash fq2-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">Still<b class="big">stuck?</b></span>
   <p class="kick">Contact</p>
   <h2 class="h2">Email me and <span class="scr">a person answers.</span></h2>
   <p><a class="fq2-mail" href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p>
   <div class="fq2-acts">
    <a class="btn buy" href="/resources/find-your-door">Find Your Door <span class="ar">→</span></a>
    <a class="btn" href="/shop">See the shop <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>
</TemplateLayout>
