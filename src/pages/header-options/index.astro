---
import '../../styles/wys-fonts.css';
const options=[1];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>The Digital Income Edit — brand banner</title></head><body><main><h1>The Digital Income Edit — brand banner</h1>{options.map(n=><section><div class="label"><h2>Brand banner</h2><a href={`/header-options/${n}/`}>Open full width →</a></div><iframe src={`/header-options/${n}/`} title={`Brand banner`} loading="eager"></iframe></section>)}</main></body></html>
<style>html{background:#fff;color:#1a1417;font-family:Inter,sans-serif}body{margin:0}main{max-width:1500px;margin:auto;padding:20px}h1{font-size:22px;margin:0 0 24px;color:#d62e73}section{margin-bottom:28px}.label{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}h2{font-size:18px;margin:0}a{color:#111;font-size:14px}iframe{display:block;width:100%;height:405px;border:0;background:#fff}@media(max-width:760px){main{padding:12px}iframe{height:375px}}</style>
<script>
 for(const frame of document.querySelectorAll('iframe')){
  const size=()=>{const nav=frame.contentDocument?.querySelector('.sn');if(nav)frame.style.height=`${Math.ceil(nav.getBoundingClientRect().bottom)}px`;};
  frame.addEventListener('load',size);
  if(frame.contentDocument?.readyState==='complete')size();
  window.addEventListener('resize',size);
 }
</script>
