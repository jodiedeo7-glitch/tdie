---
const options=[1,2,3,4,5,6];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Six TDIE header options</title></head><body><main><h1>Six coded header options</h1>{options.map(n=><section><div class="label"><h2>Header {n}</h2><a href={`/header-options/${n}/`}>Open full width →</a></div><iframe src={`/header-options/${n}/`} title={`Header ${n}`} loading="eager"></iframe></section>)}</main></body></html>
<style>html{background:#eee;color:#111;font-family:Arial,sans-serif}body{margin:0}main{max-width:1500px;margin:auto;padding:20px}h1{font-size:22px;margin:0 0 24px}section{margin-bottom:28px}.label{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}h2{font-size:18px;margin:0}a{color:#111;font-size:14px}iframe{display:block;width:100%;height:310px;border:0;background:#fff}@media(max-width:760px){main{padding:12px}iframe{height:265px}}</style>
