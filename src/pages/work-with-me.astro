---
// Work With Me, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../layouts/TemplateLayout.astro";
import { weekendEcosystem } from "../data/facts.js";
const SITE = "https://www.thedigitalincomeedit.com";

// The application mechanism is a plain email, exactly as before: same address,
// same subject lines, so existing inbox filters keep working. The body is a
// short prompt so an application arrives with what the first reply needs.
const EMAIL = "hello@thedigitalincomeedit.com";
const BODY = [
  "Where my business is now:",
  "",
  "What I sell, or want to sell:",
  "",
  "What I'd like built, and why now:",
  "",
  "My timeline:",
  "",
  "Anything else you should know:",
  "",
].join("\n");
const mailto = (subject: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(BODY)}`;
const APPLY = mailto("Application: Work With Me");

// The five existing engagements, unchanged in name and subject line, set in
// the order of the method: offer first, funnel second, automation third,
// audience last, then anything custom.
const services = [
  {
    room: "The offer",
    name: "Digital Product Strategy",
    copy: "We decide what you sell, who it's for and how it's structured, then position it, set its price and map the launch. Everything else in the build is designed around this.",
    subject: "Application: Digital Product Strategy",
  },
  {
    room: "The funnel",
    name: "SEO Blog Strategy",
    copy: "A search-first content plan so your blog is found on Google and every post walks a reader toward the offer: keyword mapping, post outlines and an editorial calendar you can actually keep.",
    subject: "Application: SEO Blog Strategy",
  },
  {
    room: "The automation",
    name: "AI Business Systems",
    copy: "Custom AI workflows for your content, your admin and your customer's path from first click to purchase, so the repeat work runs without you at the desk.",
    subject: "Application: AI Business Systems",
  },
  {
    room: "The audience",
    name: "Pinterest Strategy",
    copy: "Keyword research, boards and a pinning rhythm, pointed at an offer and a funnel that already know what to do with a visitor. One room in the build, never the whole house.",
    subject: "Application: Pinterest Strategy",
  },
  {
    room: "Something larger",
    name: "Custom Projects",
    copy: "A bigger or unusual build. Tell me what you have in mind and we'll scope an engagement around your goals, your timeline and your brand.",
    subject: "Application: Custom Project",
  },
];

const forYou = [
  "You have something to sell, or you're ready to decide what it is, and you want it built properly.",
  "You want the whole build designed in one order, not another tactic bolted onto the side.",
  "You'd rather your real face was never required.",
  "You want AI doing the heavy construction and you making the decisions.",
  "You want to stay involved while the work happens, not hand it off and hope.",
];

const notForYou = [
  "You want an income promise or a guaranteed number. I don't make them.",
  "The goal is a follower count or a single viral tactic.",
  "You need someone to be the face on camera for you.",
  "You'd rather learn it and build it yourself, at your own pace.",
];

const process = [
  { n: "01", t: "Apply by email", c: "Tell me where your business is, what you sell or want to sell, and what you want built. A few honest paragraphs are enough." },
  { n: "02", t: "Discovery call", c: "If we're a fit, we get on a call and agree the vision, the scope and the result you are after. If we're not, I'll say so and point you somewhere better." },
  { n: "03", t: "Strategy and build", c: "I design the strategy and build the systems, content or offer we agreed on, and keep you in the loop throughout." },
  { n: "04", t: "Launch and support", c: "We launch, refine, and set you up to keep it running long after our work together ends." },
];

const faqs = [
  { q: "Is every engagement really application-based?", a: "Yes. Every engagement starts with an email so we can both be sure it's the right fit before anything begins. No pressure and no hard sell." },
  { q: "How soon can we start?", a: "Once we've had our discovery call, most projects begin within one to two weeks, depending on availability." },
  { q: "Do you offer payment plans?", a: "Yes. Flexible payment options are available for most engagements, and we cover the details on the call." },
  { q: "What if I'm just starting out?", a: "Say so in your email. If an engagement isn't the right fit yet, I'll point you somewhere better, often something free in the Library." },
];

const schema = [
  {
    "@type": "Service",
    "@id": `${SITE}/work-with-me#services`,
    name: "Application-based strategy engagements",
    serviceType: "Business strategy for faceless digital businesses",
    provider: { "@id": `${SITE}/#org` },
    url: `${SITE}/work-with-me`,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Engagements",
      itemListElement: services.map((s) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: s.name } })),
    },
  },
];
---
<TemplateLayout title="Work With Me" description="Application-based strategy for your offer, funnel, automation and traffic, designed as one build by the founder of The Digital Income Edit™." schema={schema} stickyHref={APPLY} stickyLabel="Apply by email">

<section class="hh">
 <div class="wrap hh-grid ww2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">By<b class="big">application</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Work with me · By application</p>
   <h1>An offer, a funnel, a system. <span class="scr">Built to work together.</span></h1>
   <p class="what">Stop piecing your business together from another saved tutorial. Work with me on product strategy, your sales path, AI workflows or traffic, with a clear scope agreed before the build starts. <b>You bring what you have and what you want built. We decide the strategy and deliverables together.</b></p>
   <a class="btn buy" href={APPLY}>Apply by email <span class="ar">→</span></a>
   <p class="see"><a href="#process">How it works ↓</a></p>
  </div>
  <div class="card dash ww2-glance">
   <p class="pn">At a glance</p>
   <dl>
    <div><dt>Format</dt><dd>Private strategy and build engagements, by application only</dd></div>
    <div><dt>First step</dt><dd>An email, then a discovery call if we're a fit</dd></div>
    <div><dt>Reply</dt><dd>Within one to two business days</dd></div>
    <div><dt>Scope</dt><dd>Agreed together on the call, never a template</dd></div>
   </dl>
  </div>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>How I work</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">Architecture first. <span class="scr">Tactics after.</span></h2>
  <div class="p44 ww2-how">
   <div class="ph"><img src="/images/pages/work-golden-hour-desk-1280.webp" width="1280" height="549" loading="lazy" decoding="async" alt="A woman seen from behind at a round oak desk at golden hour, typing on a laptop beside peonies, an open notebook and a pink journal, a golden retriever asleep by the glass doors."></div>
   <div class="card dash">
    <p class="pn">The order: offer · funnel · automation · audience</p>
    <p><b>Every engagement starts from the offer and is built outward in one order, so each piece has somewhere to send the next.</b></p>
    <p>It's the same method I used to build The Digital Income Edit™, faceless and solo, with AI: offer first, funnel second, automation third, audience last. That means I'll ask about what you sell before I ask about your followers, and I'll design the rooms to work together before we switch the traffic on.</p>
   </div>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">The engagements</p>
  <h2 class="h2">What do you need <span class="scr">built or connected?</span></h2>
  <div class="lead"><p>Choose product strategy, blog strategy, AI systems, Pinterest strategy or a custom project. On the discovery call, we identify what's holding you up and agree what the engagement will deliver.</p></div>
  <div class="faq">{services.map((s, i) => <a class="qa hm-link ww2-svc" href={mailto(s.subject)} aria-label={`Apply for ${s.name} by email`}><span class="n">{String(i+1).padStart(2,'0')}</span><div><span class="hm-lab">{s.room}</span><h3>{s.name}</h3><p>{s.copy}</p></div><span class="ww2-go">Apply →</span></a>)}</div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">Fit</p>
  <h2 class="h2">Better to know <span class="scr">before you write.</span></h2>
  <div class="p21">
   <div class="col"><span class="scr">Yes</span><div class="card dash"><h3>This is for you if</h3><ul class="chk">{forYou.map((f) => <li>{f}</li>)}</ul></div></div>
   <div class="col"><span class="scr">Not yet</span><div class="card dash"><h3>This isn't for you if</h3><ul class="chk hm-x">{notForYou.map((f) => <li>{f}</li>)}</ul><p class="ww2-alt">If the last one is you, {weekendEcosystem.name} walks you through the same build yourself, over one weekend.</p><a class="btn" href={weekendEcosystem.url}>See {weekendEcosystem.name} <span class="ar">→</span></a></div></div>
  </div>
 </div>
</section>

<section class="sec" id="process">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">The process</p>
  <h2 class="h2">Four steps, <span class="scr">in order.</span></h2>
  <div class="lead"><p>You always know what happens next, and nothing is agreed until we've spoken.</p></div>
  <div class="p18 hm-four">{process.map((p) => <div class="box"><span class="num hm-num">{p.n}</span><h3>{p.t}</h3><p>{p.c}</p></div>)}</div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <div class="p23 ww2-two">
   <div class="pc"><div class="hd">Proof</div><div class="bd"><h3>Everything I'd design for you is running here first.</h3><p>No screenshots and no borrowed logos. Walk through the build itself:</p><ul class="chk"><li><a href="/learn">The Library</a></li><li><a href={weekendEcosystem.preview}>The course, from the inside</a></li><li><a href="/resources/weekend-build-challenge">The five-day funnel</a></li><li><a href="/membership">The classroom</a></li></ul></div></div>
   <div class="pc"><div class="hd">Prefer a fixed scope?</div><div class="bd"><h3>Done-for-you services.</h3><p>Built on the automations I run for this business, they live in the DFY Services classroom inside the community. Each one is ordered by DM, and most can also be paid through a direct checkout.</p><a class="btn" href="https://www.skool.com/thedigitalincomeedit/classroom/c83b49d5">See the done-for-you services <span class="ar">→</span></a></div></div>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Questions</span></p>
  <h2 class="h2">Before <span class="scr">you email.</span></h2>
  <div class="faq">{faqs.map((f, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{f.q}</h3><p>{f.a}</p></div></div>)}</div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <div class="p42 dash ww2-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">Applications<b class="big">open</b></span>
   <div class="ph"><img src="/images/home/founder-window-seat-640.webp" width="640" height="426" loading="lazy" decoding="async" alt="Tommy Kate working from a window seat"></div>
   <div class="tx">
    <p class="kick">Applications are open</p>
    <h2>Tell me what</h2>
    <span class="scr">you're building.</span>
    <p>Where it is now, what it sells and what you want it to become. I read every email personally and reply within one to two business days.</p>
    <a class="btn buy" href={APPLY}>Apply by email <span class="ar">→</span></a>
    <p class="see"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
   </div>
  </div>
 </div>
</section>
</TemplateLayout>
