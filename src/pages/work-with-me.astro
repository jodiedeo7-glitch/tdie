---
import PageLayout from "../layouts/PageLayout.astro";
import { weekendEcosystem } from "../data/facts.js";
import "../styles/edit.css";

const SITE = "https://www.thedigitalincomeedit.com";

// The application mechanism is a plain email, exactly as before: same address,
// same subject lines, so existing inbox filters keep working. The body is a
// short prompt so an application arrives with what the first reply needs.
const EMAIL = "hello@thedigitalincomeedit.com";
const BODY = [
  "Where my business is now:",
  "",
  "What I sell, or want to sell:",
  "",
  "What I'd like built, and why now:",
  "",
  "My timeline:",
  "",
  "Anything else you should know:",
  "",
].join("\n");
const mailto = (subject: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(BODY)}`;
const APPLY = mailto("Application: Work With Me");

// The five existing engagements, unchanged in name and subject line, set in
// the order of the method: offer first, funnel second, automation third,
// audience last, then anything custom.
const services = [
  {
    room: "The offer",
    name: "Digital Product Strategy",
    copy: "We decide what you sell, who it is for and how it is structured, then position it, set its price and map the launch. Everything else in the build is designed around this.",
    subject: "Application: Digital Product Strategy",
  },
  {
    room: "The funnel",
    name: "SEO Blog Strategy",
    copy: "A search-first content plan so your blog is found on Google and every post walks a reader toward the offer: keyword mapping, post outlines and an editorial calendar you can actually keep.",
    subject: "Application: SEO Blog Strategy",
  },
  {
    room: "The automation",
    name: "AI Business Systems",
    copy: "Custom AI workflows for your content, your admin and your customer's path from first click to purchase, so the repeat work runs without you at the desk.",
    subject: "Application: AI Business Systems",
  },
  {
    room: "The audience",
    name: "Pinterest Strategy",
    copy: "Keyword research, boards and a pinning rhythm, pointed at an offer and a funnel that already know what to do with a visitor. One room in the build, never the whole house.",
    subject: "Application: Pinterest Strategy",
  },
  {
    room: "Something larger",
    name: "Custom Projects",
    copy: "A bigger or unusual build. Tell me what you have in mind and we will scope an engagement around your goals, your timeline and your brand.",
    subject: "Application: Custom Project",
  },
];

const forYou = [
  "You have something to sell, or you are ready to decide what it is, and you want it built properly.",
  "You want the whole build designed in one order, not another tactic bolted onto the side.",
  "You would rather your real face was never required.",
  "You want AI doing the heavy construction and you making the decisions.",
  "You want to stay involved while the work happens, not hand it off and hope.",
];

const notForYou = [
  "You want an income promise or a guaranteed number. I don't make them.",
  "The goal is a follower count or a single viral tactic.",
  "You need someone to be the face on camera for you.",
  "You would rather learn it and build it yourself, at your own pace.",
];

const process = [
  { n: "01", t: "Apply by email", c: "Tell me where your business is, what you sell or want to sell, and what you want built. A few honest paragraphs are enough." },
  { n: "02", t: "Discovery call", c: "If we are a fit, we get on a call and agree the vision, the scope and the result you are after. If we are not, I will say so and point you somewhere better." },
  { n: "03", t: "Strategy and build", c: "I design the strategy and build the systems, content or offer we agreed on, and keep you in the loop throughout." },
  { n: "04", t: "Launch and support", c: "We launch, refine, and set you up to keep it running long after our work together ends." },
];

const faqs = [
  { q: "Is every engagement really application-based?", a: "Yes. Every engagement starts with an email so we can both be sure it is the right fit before anything begins. No pressure and no hard sell." },
  { q: "How soon can we start?", a: "Once we have had our discovery call, most projects begin within one to two weeks, depending on availability." },
  { q: "Do you offer payment plans?", a: "Yes. Flexible payment options are available for most engagements, and we cover the details on the call." },
  { q: "What if I'm just starting out?", a: "Say so in your email. If an engagement isn't the right fit yet, I will point you somewhere better, often something free in the Library." },
];

const schema = [
  {
    "@type": "Service",
    "@id": `${SITE}/work-with-me#services`,
    name: "Application-based strategy engagements",
    serviceType: "Business strategy for faceless digital businesses",
    provider: { "@id": `${SITE}/#org` },
    url: `${SITE}/work-with-me`,
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Engagements",
      itemListElement: services.map((s) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: s.name } })),
    },
  },
];
---
<PageLayout
  bare
  title="Work With Me"
  description="Application-based strategy for your offer, funnel, automation and traffic, designed as one build by the founder of The Digital Income Edit™."
  schema={schema}
>
  <!-- HERO -->
  <section class="ww-hero" aria-labelledby="ww-h1">
    <div class="e-wrap ww-hero-grid">
      <div class="e-rise">
        <p class="e-kick">Work with me · By application</p>
        <h1 id="ww-h1" class="ww-h1">An offer, a funnel, a system. <em>Built to work together.</em></h1>
        <p class="e-lede">Stop piecing your business together from another saved tutorial. Work with me on product strategy, your sales path, AI workflows or traffic, with a clear scope agreed before the build starts. <strong>You bring what you have and what you want built. We decide the strategy and deliverables together.</strong></p>
        <div class="e-actions">
          <a class="e-btn" href={APPLY}>Apply by email <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href="#process">How an engagement runs</a>
        </div>
      </div>
      <aside class="ww-glance e-rise e-rise-2" aria-label="At a glance">
        <p class="ww-glance-h">At a glance</p>
        <dl>
          <div><dt>Format</dt><dd>Private strategy and build engagements, by application only</dd></div>
          <div><dt>First step</dt><dd>An email, then a discovery call if we are a fit</dd></div>
          <div><dt>Reply</dt><dd>Within one to two business days</dd></div>
          <div><dt>Scope</dt><dd>Agreed together on the call, never a template</dd></div>
        </dl>
      </aside>
    </div>
  </section>

  <!-- HOW I WORK: the page's one oversized statement -->
  <section class="e-white ww-how-sec" aria-labelledby="ww-how">
    <div class="e-wrap">
      <p class="e-kick">How I work</p>
      <h2 id="ww-how" class="ww-state"><span>Architecture first.</span> <em>Tactics after.</em></h2>
    </div>
    <figure class="ww-bleed e-unveil">
      <img
        src="/images/pages/work-golden-hour-desk-1280.webp"
        srcset="/images/pages/work-golden-hour-desk-800.webp 800w, /images/pages/work-golden-hour-desk-1280.webp 1280w"
        sizes="100vw" width="1280" height="549" loading="lazy" decoding="async"
        alt="A woman seen from behind at a round oak desk at golden hour, typing on a laptop beside peonies, an open notebook and a pink journal, a golden retriever asleep by the glass doors." />
    </figure>
    <div class="e-wrap ww-how-body">
      <p class="e-credit ww-how-cap">The order: <b>offer</b> · funnel · automation · audience</p>
      <div class="ww-how-copy e-reveal">
        <p class="ww-how-lead">Every engagement starts from the offer and is built outward in one order, so each piece has somewhere to send the next.</p>
        <p>It is the same method I used to build The Digital Income Edit™, faceless and solo, with AI: offer first, funnel second, automation third, audience last. That means I will ask about what you sell before I ask about your followers, and I will design the rooms to work together before we switch the traffic on.</p>
      </div>
    </div>
  </section>

  <!-- THE ENGAGEMENTS -->
  <section class="e-sec" aria-labelledby="ww-eng">
    <div class="e-wrap">
      <div class="ww-head">
        <div>
          <p class="e-kick">The engagements</p>
          <h2 id="ww-eng" class="e-d2">What do you need <em>built or connected?</em></h2>
        </div>
        <p class="e-lede">Choose product strategy, blog strategy, AI systems, Pinterest strategy or a custom project. On the discovery call, we identify what is holding you up and agree what the engagement will deliver.</p>
      </div>
      <ol class="ww-svc">
        {services.map((s, i) => (
          <li>
            <span class="ww-svc-n e-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="ww-svc-name">
              <span class="ww-room">{s.room}</span>
              <h3>{s.name}</h3>
            </div>
            <p>{s.copy}</p>
            <a class="e-link" href={mailto(s.subject)} aria-label={`Apply for ${s.name} by email`}>Apply <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FIT -->
  <section class="e-sec e-paper" aria-labelledby="ww-fit">
    <div class="e-wrap">
      <p class="e-kick">Fit</p>
      <h2 id="ww-fit" class="e-d2 ww-fit-h">Better to know <em>before you write.</em></h2>
      <div class="ww-fit">
        <div class="ww-fit-col">
          <h3>This is for you if</h3>
          <ul class="e-list">
            {forYou.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="ww-fit-col ww-fit-col--no">
          <h3>This is not for you if</h3>
          <ul class="e-list">
            {notForYou.map((f) => <li>{f}</li>)}
          </ul>
          <p class="ww-fit-alt">If the last one is you, {weekendEcosystem.name} walks you through the same build yourself, over one weekend. <a class="e-link" href={weekendEcosystem.url}>See {weekendEcosystem.name}</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="e-sec" id="process" aria-labelledby="ww-process">
    <div class="e-wrap ww-proc">
      <div class="ww-proc-head">
        <p class="e-kick">The process</p>
        <h2 id="ww-process" class="e-d2">Four steps, <em>in order.</em></h2>
        <p class="ww-proc-lede">You always know what happens next, and nothing is agreed until we have spoken.</p>
      </div>
      <ol class="ww-steps">
        {process.map((p) => (
          <li class="e-reveal">
            <span class="ww-step-n" aria-hidden="true">{p.n}</span>
            <div>
              <h3>{p.t}</h3>
              <p>{p.c}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROOF AND THE FIXED-SCOPE ALTERNATIVE -->
  <section class="e-sec-sm e-white" aria-labelledby="ww-proof">
    <div class="e-wrap ww-proof">
      <div>
        <p class="e-kick">Proof</p>
        <h2 id="ww-proof" class="e-d3">Everything I would design for you is running here first.</h2>
        <p>No screenshots and no borrowed logos. Walk through the build itself: <a class="e-link" href="/learn">the Library</a>, <a class="e-link" href={weekendEcosystem.preview}>the course, from the inside</a>, <a class="e-link" href="/resources/weekend-build-challenge">the five-day funnel</a> and <a class="e-link" href="/community">the classroom</a>.</p>
      </div>
      <div class="ww-dfy">
        <p class="e-kick">Prefer a fixed scope?</p>
        <p>Done-for-you services, built on the automations I run for this business, live in the DFY Services classroom inside the community. Each one is ordered by DM, and most can also be paid through a direct checkout.</p>
        <a class="e-link" href="https://www.skool.com/thedigitalincomeedit/classroom/c83b49d5">See the done-for-you services <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- QUESTIONS -->
  <section class="e-sec" aria-labelledby="ww-faq">
    <div class="e-wrap ww-faq-wrap">
      <div>
        <p class="e-kick">Questions</p>
        <h2 id="ww-faq" class="e-d2">Before <em>you email.</em></h2>
      </div>
      <div class="ww-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS
       Deliberately absent. Real client words only. Nothing goes here until
       genuine, attributable client testimonials exist. Do not fill with examples. -->

  <!-- CLOSE: the page's one dark room -->
  <section class="e-sec e-dark" aria-labelledby="ww-close">
    <div class="e-wrap ww-close">
      <p class="e-kick">Applications are open</p>
      <h2 id="ww-close" class="ww-close-h">Tell me what <em>you are building.</em></h2>
      <p class="e-lede">Where it is now, what it sells and what you want it to become. I read every email personally and reply within one to two business days.</p>
      <div class="e-actions">
        <a class="e-btn" href={APPLY}>Apply by email <span class="ar" aria-hidden="true">→</span></a>
        <a class="e-link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero */
  .ww-hero{padding:clamp(48px,7vw,112px) 0 clamp(56px,7vw,104px)}
  .ww-hero-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.75fr);gap:clamp(36px,6vw,96px);align-items:end}
  .ww-h1{font-size:clamp(46px,7vw,104px);line-height:.96;letter-spacing:-.035em;margin:0 0 28px;max-width:10.5em}
  .ww-glance{border-top:1px solid var(--e-ink);padding-top:18px}
  .ww-glance-h{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 6px}
  .ww-glance dl{margin:0}
  .ww-glance dl > div{padding:14px 0;border-bottom:var(--e-hair)}
  .ww-glance dt{font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--e-ink-3);margin-bottom:4px}
  .ww-glance dd{margin:0;font-size:15.5px;line-height:1.5;color:var(--e-ink)}

  /* How I work: one oversized statement, one full-bleed frame */
  .ww-how-sec{padding:clamp(88px,12vw,168px) 0 clamp(80px,10vw,140px)}
  .ww-state{font-size:clamp(44px,8.2vw,124px);line-height:.9;letter-spacing:-.05em;margin:0 0 clamp(44px,6vw,80px)}
  .ww-state span,.ww-state em{display:block}
  .ww-state em{padding-left:clamp(0px,14vw,210px)}
  .ww-bleed{margin:0;overflow:hidden;background:var(--e-paper);aspect-ratio:1280/549;max-height:640px;width:100%}
  .ww-bleed img{display:block;width:100%;height:100%;object-fit:cover;object-position:40% 55%}
  .ww-how-body{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:clamp(24px,5vw,72px);padding-top:clamp(28px,3vw,40px)}
  .ww-how-cap{margin:6px 0 0;padding-top:14px;border-top:var(--e-hair);align-self:start;max-width:34em}
  .ww-how-copy{max-width:36em}
  .ww-how-copy p{color:var(--e-ink-2);margin:0 0 18px}
  .ww-how-copy .ww-how-lead{font-family:var(--e-serif);font-weight:600;font-size:clamp(23px,2.3vw,30px);line-height:1.3;letter-spacing:-.015em;color:var(--e-ink);margin-bottom:22px}

  /* Section heads */
  .ww-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:16px 64px;align-items:end;margin-bottom:clamp(36px,5vw,56px)}
  .ww-head .e-lede{margin:0 0 20px}

  /* Engagements */
  .ww-svc{list-style:none;margin:0;padding:0;border-top:1px solid var(--e-ink)}
  .ww-svc li{display:grid;grid-template-columns:72px minmax(0,1fr) minmax(0,1.35fr) auto;gap:16px 40px;align-items:baseline;padding:30px 0;border-bottom:var(--e-hair)}
  .ww-svc-n{font-size:40px}
  .ww-room{display:block;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:6px}
  .ww-svc h3{font-size:clamp(24px,2.4vw,32px);line-height:1.12;margin:0}
  .ww-svc p{margin:0;color:var(--e-ink-2);font-size:16px}

  /* Fit */
  .ww-fit-h{max-width:12em;margin-bottom:clamp(32px,4vw,48px)}
  .ww-fit{display:grid;grid-template-columns:1fr 1fr;gap:0}
  .ww-fit-col{padding:28px clamp(0px,3vw,40px) 8px 0;border-top:1px solid var(--e-ink)}
  .ww-fit-col--no{padding-left:clamp(24px,3vw,40px);border-left:var(--e-hair)}
  .ww-fit h3{font-size:26px;margin:0 0 20px}
  .ww-fit .e-list li{color:var(--e-ink-2)}
  .ww-fit-alt{margin:24px 0 0;padding-top:18px;border-top:var(--e-hair);font-size:15.5px;color:var(--e-ink-2)}
  .ww-fit-alt .e-link{display:flex;width:max-content;max-width:100%}

  /* Process: the heading holds the left, the steps read down the right */
  .ww-proc{display:grid;grid-template-columns:minmax(0,4fr) minmax(0,7fr);gap:clamp(32px,7vw,120px);align-items:start}
  .ww-proc-head{position:sticky;top:120px}
  .ww-proc-lede{font-size:17px;color:var(--e-ink-2);margin:0;max-width:22em}
  .ww-steps{list-style:none;margin:0;padding:0;border-top:1px solid var(--e-ink)}
  .ww-steps li{display:grid;grid-template-columns:clamp(64px,8vw,112px) minmax(0,1fr);gap:clamp(12px,3vw,36px);align-items:baseline;padding:clamp(24px,3vw,38px) 0;border-bottom:var(--e-hair)}
  .ww-step-n{font-family:var(--e-serif);font-weight:600;font-size:clamp(40px,5vw,64px);line-height:.9;letter-spacing:-.04em;color:var(--e-pink)}
  .ww-steps h3{font-size:clamp(24px,2.4vw,30px);line-height:1.15;margin:0 0 10px}
  .ww-steps p{font-size:16px;margin:0;color:var(--e-ink-2);max-width:34em}

  /* Proof + DFY */
  .ww-proof{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:clamp(32px,6vw,88px);align-items:start}
  .ww-proof p:not(.e-kick){color:var(--e-ink-2);margin:0 0 12px}
  .ww-proof .e-link{min-height:0;display:inline}
  .ww-dfy{padding-left:clamp(0px,3vw,40px);border-left:var(--e-hair)}
  .ww-dfy .e-link{display:inline-flex;min-height:44px}

  /* FAQ */
  .ww-faq-wrap{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(24px,6vw,88px);align-items:start}
  .ww-faq{border-top:1px solid var(--e-ink)}
  .ww-faq details{border-bottom:var(--e-hair)}
  .ww-faq summary{font-family:var(--e-serif);font-weight:600;font-size:21px;line-height:1.3;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:18px;align-items:center;min-height:44px;padding:20px 0}
  .ww-faq summary::-webkit-details-marker{display:none}
  .ww-faq summary::after{content:"+";flex:none;color:var(--e-pink);font-family:var(--e-sans);font-weight:400;font-size:26px;line-height:1}
  .ww-faq details[open] summary::after{content:"\2212"}
  .ww-faq details p{margin:0 0 22px;color:var(--e-ink-2);max-width:40em}

  /* Close */
  .ww-close{max-width:1080px;padding-top:clamp(16px,4vw,56px);padding-bottom:clamp(16px,4vw,56px)}
  .ww-close-h{font-size:clamp(44px,7.6vw,112px);line-height:.94;letter-spacing:-.04em;margin:0 0 28px;max-width:9.5em;color:#fff}
  .ww-close .e-lede{margin-bottom:36px}
  .ww-close .e-link{word-break:break-all}

  @media (max-width:1000px){
    .ww-svc li{grid-template-columns:56px minmax(0,1fr) auto;}
    .ww-svc li p{grid-column:2 / 3}
    .ww-svc li .e-link{grid-column:3;grid-row:1}
  }
  @media (max-width:820px){
    .ww-hero-grid,.ww-head,.ww-proof,.ww-faq-wrap,.ww-proc,.ww-how-body{grid-template-columns:1fr}
    .ww-proc-head{position:static}
    .ww-bleed{aspect-ratio:16/10}
    .ww-dfy{padding-left:0;border-left:0;padding-top:28px;border-top:var(--e-hair)}
  }
  @media (max-width:600px){
    .ww-fit{grid-template-columns:1fr}
    .ww-fit-col--no{padding-left:0;border-left:0;margin-top:32px}
    .ww-bleed{aspect-ratio:4/3}
    .ww-bleed img{object-position:30% 50%}
    .ww-steps li{grid-template-columns:52px minmax(0,1fr)}
    .ww-step-n{font-size:38px}
    .ww-svc li{grid-template-columns:44px minmax(0,1fr);gap:10px 14px;padding:26px 0}
    .ww-svc-n{font-size:30px}
    .ww-svc li p,.ww-svc li .e-link{grid-column:2;grid-row:auto}
  }
</style>
