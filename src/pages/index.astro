    .node .top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px}
    .node .n{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1.5px dashed var(--hp-pink);color:var(--hp-pink-2);font-family:var(--hp-serif);font-weight:600;font-size:17px}
    .node .room{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-pink-2)}
    .node h3{font-size:24px;line-height:1.15;margin:0 0 10px}
    .node p{font-size:15px;line-height:1.6;color:var(--hp-ink-2);margin:0 0 18px;flex:1}
    .node .go{font-size:14px;font-weight:700;color:var(--hp-pink-2)}
    .map li:not(:nth-child(3n))::after{content:"";position:absolute;right:-22px;top:47px;width:22px;border-top:2px dashed var(--hp-pink);opacity:.6}
    .machine-foot{margin-top:34px;text-align:center;font-size:16px;color:var(--hp-ink-2)}
    .machine-foot strong{color:var(--hp-pink-2);font-weight:600}
    @media(max-width:980px){.map{grid-template-columns:1fr 1fr}.map li::after{display:none}}
    @media(max-width:620px){.map{grid-template-columns:1fr;gap:14px}}

    /* ============ TINA ============ */
    .review{background:
        radial-gradient(50% 60% at 50% 0%,rgba(255,138,194,.22) 0%,transparent 70%),var(--hp-cream)}
    .quote{position:relative;max-width:940px;margin:0 auto;padding:clamp(34px,5vw,64px) clamp(22px,5vw,72px);border-radius:28px;text-align:left}
    .quote .mark{position:absolute;top:-42px;left:clamp(18px,4vw,56px);width:84px;height:84px;border-radius:50%;background:var(--hp-grad);color:#fff;
      font-family:var(--hp-serif);font-weight:600;font-size:74px;line-height:1;display:grid;place-items:center;padding-top:22px;box-shadow:var(--hp-shadow-sm)}
    .quote .tag{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-pink-2);margin:10px 0 18px}
    .quote blockquote{margin:0 0 28px;font-family:var(--hp-serif);font-weight:600;font-size:clamp(23px,2.7vw,33px);line-height:1.3;letter-spacing:-.015em;color:var(--hp-ink)}
    .quote figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;padding-top:22px;border-top:1px solid rgba(200,169,106,.55)}
    .quote figcaption strong{font-family:var(--hp-serif);font-weight:600;font-size:22px;color:var(--hp-ink)}
    .quote .src{font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--hp-ink-2)}
    .quote .stars{color:var(--hp-pink-2);letter-spacing:4px;font-size:18px}

    /* ============ PATH ============ */
    .path{display:grid;grid-template-columns:1fr 1.25fr 1fr;gap:22px;align-items:stretch}
    .stop{position:relative;display:flex;flex-direction:column;border-radius:24px;padding:28px 26px}
    .stop .lvl{display:inline-flex;align-self:flex-start;align-items:center;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-pink-2);margin-bottom:16px;padding:7px 12px;border-radius:999px;border:1px solid rgba(214,46,115,.35);background:#fff}
    .stop h3{font-size:28px;line-height:1.1;margin:0 0 10px}
    .stop p{font-size:15.5px;line-height:1.6;color:var(--hp-ink-2);margin:0 0 18px}
    .stop .act{margin-top:auto;display:flex;flex-direction:column;gap:10px;align-items:flex-start}
    .stop .act .pill{width:100%;padding:15px 20px;letter-spacing:.08em;font-size:12.5px}
    .stop-free .thumb{border-radius:16px;overflow:hidden;margin-bottom:18px;aspect-ratio:4/3;box-shadow:var(--hp-shadow-sm)}
    .stop-free .thumb img{width:100%;height:100%;object-fit:cover;object-position:center 60%}
    .stop-hero{background:var(--hp-grad);color:#fff;border:1px solid rgba(255,255,255,.35);box-shadow:0 40px 70px -30px rgba(214,46,115,.75),0 12px 26px -16px rgba(26,20,23,.3);overflow:hidden;isolation:isolate}
    .stop-hero::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(115deg,rgba(255,255,255,.42) 0%,rgba(255,255,255,.08) 30%,rgba(255,255,255,0) 46%)}
    .stop-hero .lvl{background:rgba(255,255,255,.18);color:#fff;border-color:rgba(255,255,255,.55)}
    .stop-hero h3{color:#fff;font-size:clamp(30px,3vw,38px)}
    .stop-hero p{color:rgba(255,255,255,.94)}
    .stop-hero .price{font-family:var(--hp-serif);font-weight:600;font-size:clamp(40px,4.4vw,54px);line-height:1;color:#fff;margin:4px 0 6px}
    .stop-hero .price small{font-family:var(--hp-sans);font-size:14px;font-weight:600;letter-spacing:.02em;margin-left:6px;color:rgba(255,255,255,.92)}
    .stop-hero .plan{font-size:14px;font-weight:600;color:#fff;margin:0 0 18px;padding-bottom:18px;border-bottom:1px solid rgba(255,255,255,.35)}
    .stop-hero .we-photo{border-radius:16px;overflow:hidden;margin:0 0 20px;aspect-ratio:560/376;border:3px solid rgba(255,255,255,.7)}
    .stop-hero .we-photo img{width:100%;height:100%;object-fit:cover}
    .stop-hero .sticker{color:var(--hp-pink-2);right:14px;top:14px;width:98px;height:98px;padding:14px}
    .stop-hero .sticker b{font-size:26px}
    .stop-hero .quiet{color:#fff;border-color:rgba(255,255,255,.6)}
    .stop-mem .mini{list-style:none;margin:0 0 18px;padding:0;display:grid;gap:10px}
    .stop-mem .mini li{display:flex;justify-content:space-between;gap:12px;padding:12px 14px;border-radius:12px;background:#fff;border:1px solid rgba(200,169,106,.45);font-size:14.5px;color:var(--hp-ink-2)}
    .stop-mem .mini b{font-family:var(--hp-serif);font-weight:600;font-size:19px;color:var(--hp-pink-2)}
    .path-foot{margin-top:30px;text-align:center}
    @media(max-width:1020px){.path{grid-template-columns:1fr 1fr}.stop-hero{grid-column:1/-1;order:-1}}
    @media(max-width:680px){.path{grid-template-columns:1fr}.stop-hero{order:0}}

    /* ============ MEMBERSHIP ============ */
    .mem{background:linear-gradient(180deg,#FDEFF5 0%,var(--hp-cream) 100%)}
    .mem-grid{display:grid;grid-template-columns:1fr 1fr;gap:24px;max-width:980px;margin:0 auto;position:relative}
    .tier{position:relative;display:flex;flex-direction:column;padding:30px 28px 28px;border-radius:24px}
    .tier.premium{border:2px solid var(--hp-pink);box-shadow:0 0 0 6px rgba(214,46,115,.08),var(--hp-shadow)}
    .tier .badge{display:inline-flex;align-self:flex-start;padding:7px 14px;border-radius:999px;font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;margin-bottom:16px}
    .tier.standard .badge{background:#FFE3F0;color:var(--hp-pink-2);border:1px solid var(--hp-bubble)}
    .tier.premium .badge{background:var(--hp-grad);color:#fff}
    .tier h3{font-size:28px;line-height:1.1;margin:0 0 12px}
    .tier .pr{font-family:var(--hp-serif);font-weight:600;font-size:52px;line-height:1;color:var(--hp-pink);letter-spacing:-.02em}
    .tier .pr small{font-family:var(--hp-sans);font-size:15px;font-weight:600;color:var(--hp-ink-2);letter-spacing:0}
    .tier .alt{font-size:14.5px;font-weight:600;color:var(--hp-ink-2);margin:8px 0 4px}
    .tier .trial{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--hp-pink-2);margin:0 0 16px}
    .tier .buys{font-family:var(--hp-serif);font-weight:600;font-size:20px;line-height:1.3;margin:0 0 16px;padding-top:16px;border-top:1px solid rgba(200,169,106,.55)}
    .tier ul{list-style:none;margin:0 0 24px;padding:0;display:grid;gap:10px}
    .tier li{position:relative;padding-left:26px;font-size:15px;line-height:1.5;color:var(--hp-ink-2)}
    .tier li::before{content:"";position:absolute;left:0;top:4px;width:15px;height:15px;border-radius:50%;background:var(--hp-grad);box-shadow:inset 0 0 0 4px #fff,0 0 0 1px var(--hp-pink)}
    .tier .pill{margin-top:auto;width:100%}
    .mem-grid > .sticker{left:50%;top:-44px;margin-left:-59px}
    .mem-foot{text-align:center;margin-top:28px;font-size:15px;color:var(--hp-ink-2)}
    @media(max-width:760px){.mem-grid{grid-template-columns:1fr;margin-top:64px}.mem-grid > .sticker{left:auto;right:6px;margin-left:0;top:-58px;width:100px;height:100px}}

    /* ============ LIBRARY ============ */
    .shelf{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
    .book{display:flex;flex-direction:column;height:100%;padding:24px 22px;border-radius:18px;background:#fff;border:1px solid rgba(200,169,106,.5);border-top:4px solid var(--hp-pink);box-shadow:var(--hp-shadow-sm);transition:transform .25s ease}
    .book:hover{transform:translateY(-4px)}
    .book .cat{font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--hp-pink-2);margin-bottom:12px}
    .book h3{font-size:22px;line-height:1.2;margin:0 0 16px;flex:1}
    .book .rd{font-size:13px;font-weight:600;color:var(--hp-ink-2)}
    .shelf-foot{margin-top:28px;text-align:center}
    @media(max-width:980px){.shelf{grid-template-columns:1fr 1fr}}
    @media(max-width:560px){.shelf{grid-template-columns:1fr}}

    /* ============ SUNDAY LETTER ============ */
    .letter{padding:clamp(64px,9vw,110px) 0}
    .letter-card{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);overflow:hidden;border-radius:28px;padding:0}
    .letter-photo{position:relative;min-height:320px}
    .letter-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
    .letter-body{padding:clamp(28px,4vw,52px)}
    .letter-body .hp-lede{margin:0 0 6px}
    .letter-body :global(.freebie-capture){margin:18px 0 0;padding:0;border:0;background:transparent}
    .letter-body :global(.fc-h){font-family:var(--hp-serif);font-weight:600;font-size:clamp(30px,3.6vw,42px);line-height:1.08;letter-spacing:-.02em;color:var(--hp-ink);margin:0 0 10px}
    .letter-body :global(.fc-sub){font-size:15px;color:var(--hp-ink-2);margin:0 0 18px}
    .letter-body :global(.fc-row input){min-height:52px;border-radius:999px;border:1px solid rgba(200,169,106,.8);padding:14px 22px;font-size:16px}
    .letter-body :global(.fc-row button){min-height:52px;border-radius:999px;background:var(--hp-grad);font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:14px 28px;box-shadow:0 14px 30px -12px rgba(214,46,115,.65)}
    .letter-body :global(.fc-row button:hover){background:var(--hp-grad);filter:brightness(1.05)}
    .letter-body :global(.fc-done){font-family:var(--hp-serif);font-weight:600;font-style:normal}
    .letter-fine{font-size:13px;color:var(--hp-ink-2);margin:14px 0 0}
    @media(max-width:820px){.letter-card{grid-template-columns:1fr}.letter-photo{min-height:220px}.letter-body :global(.fc-row button){width:100%}}

    /* ============ FOOTER ============ */
    .hp-foot{background:#fff;border-top:1px solid rgba(200,169,106,.55);padding:0;color:var(--hp-ink-2)}
    .hp-foot .wrap{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:32px;padding-top:56px;padding-bottom:44px}
    .hp-foot .brand{display:inline-flex;align-items:center;min-height:44px;font-family:var(--hp-serif);font-weight:600;font-size:24px;color:var(--hp-ink)}
    .hp-foot .brand span{color:var(--hp-pink-2)}
    .hp-foot .tl{margin:10px 0 0;font-size:15px;color:var(--hp-ink-2);max-width:32ch}
    .hp-foot h2{font-family:var(--hp-sans);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-pink-2);margin:0 0 10px}
    .hp-foot nav a{display:flex;align-items:center;min-height:44px;font-size:15px;color:var(--hp-ink-2)}
    .hp-foot nav a:hover{color:var(--hp-pink-2)}
    .hp-foot-bar{background:var(--hp-grad);color:#fff}
    .hp-foot-bar .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;padding-top:16px;padding-bottom:16px;font-size:13px;font-weight:600;letter-spacing:.04em}
    @media(max-width:820px){.hp-foot .wrap{grid-template-columns:1fr 1fr}.hp-foot .wrap > div:first-child{grid-column:1/-1}}

    @media(prefers-reduced-motion:reduce){.pill,.node,.book{transition:none}.pill:hover,.node:hover,.book:hover{transform:none}}
  </style>
</head>
<body class="hp">

  <header class="hp-nav">
    <div class="wrap">
      <a class="hp-logo" href="/">The Digital Income<span>Edit™</span></a>
      <nav class="hp-links" aria-label="Main">
        <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Free resources</a><a href="/membership">Membership</a>
        <a class="cta" href="/community">Community</a>
      </nav>
      <button class="hp-burger" type="button" popovertarget="hp-menu" aria-label="Open menu">Menu</button>
    </div>
  </header>
  <div id="hp-menu" class="hp-drawer" popover>
    <button type="button" popovertarget="hp-menu" popovertargetaction="hide" aria-label="Close menu">Close</button>
    <nav aria-label="Mobile">
      <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Free resources</a><a href="/membership">Membership</a><a class="cta" href="/community">Community</a>
    </nav>
  </div>

  <main>
    <!-- HERO -->
    <section class="hx" aria-labelledby="hero-h">
      <div class="wrap hero-grid">
        <div>
          <p class="kick">The AI-built faceless business</p>
          <h1 id="hero-h">Build the whole business <span class="pk">before anyone knows your name.</span></h1>
          <p class="hp-lede"><strong>Offer first, funnel second, automation third, audience last.</strong> AI does the building, the architecture does the selling, and your real face is never required.</p>
          <p class="hero-proof">You are standing in the proof. I built this site, the classroom behind it and every funnel underneath it, faceless and solo, with AI.</p>
          <div class="hero-cta">
            <a class="pill" href="/resources/faceless-income-blueprint">Get my free Blueprint for one email <span class="ar" aria-hidden="true">→</span></a>
            <a class="quiet" href="/weekend-ecosystem/preview">Take your free look inside, no email needed</a>
          </div>
        </div>
        <div class="hero-fig">
          <div class="hero-slab" aria-hidden="true"></div>
          <div class="hero-frame" aria-hidden="true"></div>
          <span class="hero-tag">The New Faceless</span>
          <div class="hero-photo">
            <img src="/images/home/hero-pink-knit-desk-720.webp"
                 srcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
                 sizes="(max-width: 900px) 78vw, 440px" width="480" height="596" fetchpriority="high" decoding="async"
                 alt="The brand's AI persona in an oversized pink knit sweater, sipping a glitter pink iced coffee at a cream farmhouse desk, her laptop open beside sticky notes and wildflowers, an open window onto the garden behind her." />
          </div>
          <p class="sticker" aria-label="1,200+ members building"><span><b>1,200+</b>members building</span></p>
        </div>
      </div>
    </section>

    <!-- PROOF STRIP -->
    <section class="proof" aria-label="The machine, by the numbers">
      <div class="wrap">
        <div class="glass proof-grid">
          {proof.map((s) => (
            <div class="stat"><b>{s.big}</b><span>{s.small}</span></div>
          ))}
        </div>
      </div>
    </section>

    <!-- THE METHOD -->
    <section class="sec" id="method" aria-labelledby="method-h">
      <div class="wrap">
        <div class="sec-head">
          <p class="kick">The signature method</p>
          <h2 class="h2" id="method-h">Built Backwards. <span class="pk">Four rooms, one order.</span></h2>
          <p class="hp-lede">Most people build forwards: audience first, offer last. That is why most faceless accounts have followers and no business. This method runs the other way, and the order is not negotiable.</p>
        </div>
        <div class="glass method-panel">
          <div class="method-bar">
            <strong>The Built Backwards Method</strong>
            <span>Sequence locked · 01 → 04</span>
          </div>
          <ol class="steps">
            {method.map((m, i) => (
              <li class="step">
                <span class="num" aria-hidden="true">{m.n}</span>
                <p class="ord">{["First", "Second", "Third", "Last"][i]}</p>
                <h3>{m.name}</h3>
                <p>{m.line}</p>
                <p class="out">{m.out}</p>
              </li>
            ))}
          </ol>
          <div class="method-foot">
            <p class="tagline">Build Your Business Backwards. Scale It Forward.™</p>
            <p><strong>AI + architecture.</strong> AI is the build team. The architecture is what makes it a business.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- POINT OF VIEW -->
    <section class="sec pov" aria-labelledby="pov-h">
      <div class="wrap pov-grid">
        <div class="pov-fig">
          <p class="sticker" aria-label="No face required"><span><b>0</b>faces required</span></p>
          <div class="pov-photo">
            <img src="/images/home/founder-window-seat-640.webp"
                 srcset="/images/home/founder-window-seat-640.webp 640w, /images/home/founder-window-seat-1000.webp 1000w"
                 sizes="(max-width: 900px) 92vw, 520px" width="640" height="426" loading="lazy" decoding="async"
                 alt="The brand's AI persona in a cream tee and pink sweatpants on a farmhouse window seat, laptop on her knees, a pink tumbler and lavender on the sill and open pasture outside." />
          </div>
          <div class="glass pov-note">
            <p>"Faceless" was never about hiding. It is about building something that does not need you on camera to sell.</p>
            <span>Jodie, founder</span>
          </div>
        </div>
        <div>
          <div class="sec-head">
            <p class="kick">Point of view</p>
            <h2 class="h2" id="pov-h">Four things I <span class="pk">refuse to teach.</span></h2>
            <p class="hp-lede">You can find all four of these taught everywhere. You will not find them here, and the reasons are the whole method.</p>
          </div>
          <ol class="refuse">
