---
import "../styles/global.css";
import "../styles/edit.css";
// Homepage type, self-hosted: Newsreader SemiBold for display, Inter for everything else.
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

import Analytics from "@vercel/analytics/astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FreebieForm from "../components/FreebieForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { FEATURED as tina } from "../we-reviews.js";
import { membership as M, weekendEcosystem as WE, community, library, SKOOL_PLANS, cap } from "../data/facts.js";

const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. ${community.members} women are building it inside The Digital Income Edit™.`;

// The Built Backwards Method. The order is the method.
const method = [
  { n: "01", name: "Offer", line: "What you sell, who pays for it, what it costs. Decided before a single post exists.", out: "One sentence, one buyer, one price." },
  { n: "02", name: "Funnel", line: "The road a stranger walks from free to paid: the free thing, the page, the emails that do the asking.", out: "A path that sells without you in the room." },
  { n: "03", name: "Automation", line: "AI and schedules take the repeat work. One article becomes 24 finished assets and the emails send themselves.", out: "A business that runs on the Tuesday you skip." },
  { n: "04", name: "Audience", line: "Only now do you turn on traffic, pointed at something that already knows what to do with a visitor.", out: "Attention that lands somewhere." },
];

// What Jodie refuses to teach, and why. Short, because the method already said it.
const refusals = [
  { t: "Audience first.", p: "A year of performing for strangers, with nothing to sell them." },
  { t: "Income screenshots.", p: "A good month proves nothing about a build. Inspect the build instead." },
  { t: "Showing your face.", p: "Your real face is never required. The face of this brand is an AI persona." },
  { t: "One-channel expertise.", p: "Pinterest, blogging and email are rooms inside one build, never the whole house." },
];

// Proof by inspection. Every room is a live page, shown as it really looks.
const rooms = [
  { key: "course", room: "The course", t: "22 modules, delivered as a website", p: "The Weekend Ecosystem™ lives on the very site it teaches you to build.", href: WE.preview, path: "/weekend-ecosystem/preview", go: "Walk the course lobby" },
  { key: "offer", room: "The offer", t: "The One-Sentence Offer tool", p: "Step one of the method, as a free tool. No email.", href: "/resources/one-sentence-offer", path: "/resources/one-sentence-offer", go: "Test your offer" },
  { key: "funnel", room: "The funnel", t: "The Weekend Build Challenge", p: "Five free days by email, walking a stranger in order from nothing to an offer.", href: "/resources/weekend-build-challenge", path: "/resources/weekend-build-challenge", go: "Inspect the funnel" },
  { key: "library", room: "The library", t: "Every article started as a lesson", p: "Each guide began as a Skool lesson and was turned into a page by the method it teaches.", href: "/learn/turn-skool-content-into-a-blog", path: "/learn/turn-skool-content-into-a-blog", go: "Read one, lesson to article" },
  { key: "classroom", room: "The classroom", t: "The Skool room behind it", p: `Where ${community.members} women build the same thing, beside each other.`, href: "/community", path: "/community", go: "See the room" },
  { key: "email", room: "The email", t: "The Sunday letter", p: "Written once a week and delivered by the automation underneath this site.", href: "/newsletter", path: "/newsletter", go: "Read the letter" },
];

// A curated few of the pillar guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation & Paid Traffic", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      logo: `${SITE}/icon-512.png`,
      sameAs: ["https://pinterest.com/TheDigitalIncomeEditTDIE", "https://instagram.com/the.faceless.homestead.mama"] },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FBF8F5" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
        imagesizes="(max-width: 900px) 100vw, 46vw" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    body.e-page::before,body.e-page::after{display:none}

    /* ============ 1 · HERO: an editorial cover ============ */
    .cover{display:grid;grid-template-columns:minmax(0,1.08fr) minmax(0,.92fr);min-height:min(88vh,860px);border-bottom:1px solid rgba(200,169,106,.45)}
    .cover-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,6vw,96px) clamp(20px,5vw,72px) clamp(40px,5vw,72px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut)))}
    .cover h1{font-size:clamp(48px,6.8vw,104px);line-height:.94;letter-spacing:-.04em;margin:0 0 28px;max-width:10.5ch}
    .cover h1 em{display:block}
    .cover .e-lede{font-size:clamp(18px,1.5vw,20px);max-width:31em;margin-bottom:34px}
    .cover .e-lede strong{color:var(--e-ink);font-weight:600}
    .cover-meta{display:flex;flex-wrap:wrap;gap:8px 22px;margin:34px 0 0;padding:18px 0 0;border-top:1px solid rgba(200,169,106,.5);list-style:none;font-size:13.5px;color:var(--e-ink-2)}
    .cover-meta b{font-family:var(--e-serif);font-weight:600;font-size:20px;color:var(--e-pink-t);margin-right:6px;letter-spacing:-.01em}
    .cover-photo{position:relative;margin:0;min-height:420px;background:var(--e-paper)}
    .cover-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:32% 40%}
    .cover-photo figcaption{position:absolute;left:0;bottom:0;background:var(--e-cream);padding:12px 18px 0 0;font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-2)}
    .cover-photo figcaption span{color:var(--e-pink-t)}
    @media(max-width:900px){
      .cover{grid-template-columns:1fr;min-height:0}
      .cover-copy{padding:40px var(--e-gut) 36px}
      .cover-photo{min-height:0;aspect-ratio:4/3;max-height:620px}
      .cover-photo img{object-position:30% 38%}
      .cover .e-actions .e-btn{width:100%}
    }

    /* ============ 2 · THE METHOD: signature IP ============ */
    .method-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(40px,6vw,72px)}
    .method-head .e-d2{margin:0}
    .forwards{margin:0;font-size:15px;line-height:1.7;color:var(--e-ink-2)}
    .forwards s{text-decoration-color:var(--e-pink);text-decoration-thickness:2px;color:var(--e-ink-3);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:13px}
    .forwards strong{display:block;margin-top:10px;color:var(--e-ink);font-weight:600}
    .stack{list-style:none;margin:0;padding:0;border-top:1px solid var(--e-ink)}
    .tier-row{display:grid;grid-template-columns:clamp(44px,6vw,90px) minmax(0,1.45fr) minmax(0,1fr);gap:clamp(16px,3vw,48px);align-items:center;padding:clamp(18px,2.6vw,30px) 0;border-bottom:1px solid rgba(26,20,23,.18);position:relative}
    .tier-row .n{font-family:var(--e-serif);font-weight:600;font-size:clamp(18px,1.8vw,22px);color:var(--e-pink-t)}
    .tier-row h3{font-size:clamp(40px,6.9vw,100px);line-height:.9;letter-spacing:-.045em;margin:0;color:var(--e-ink);overflow-wrap:normal;word-break:keep-all;white-space:nowrap}
    .tier-row:nth-child(1) h3{color:var(--e-pink)}
    .tier-row p{margin:0;font-size:16px;line-height:1.6;color:var(--e-ink-2)}
    .tier-row p b{display:block;margin-top:8px;font-weight:600;color:var(--e-ink)}
    .tier-row .ord{display:block;font-family:var(--e-sans);font-size:11.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-ink-3);margin-top:6px}
    .tier-row:not(:last-child)::after{content:"↓";position:absolute;left:clamp(0px,1vw,6px);bottom:-14px;width:28px;height:28px;display:grid;place-items:center;background:var(--e-cream);color:var(--e-pink);font-size:16px;font-weight:700;z-index:1}
    .method-foot{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:baseline;gap:12px 32px;margin-top:28px}
    .method-foot .tl{font-family:var(--e-serif);font-weight:600;font-size:clamp(20px,2vw,26px);margin:0}
    .method-foot p{margin:0;color:var(--e-ink-2)}
    @media(max-width:760px){
      .method-head{grid-template-columns:1fr}
      .tier-row{grid-template-columns:40px minmax(0,1fr)}
      .tier-row h3{font-size:min(12.4vw,64px)}
      .tier-row p{grid-column:2}
    }

    /* ============ 3 · FACELESS: the one dark moment ============ */
    .faceless{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);background:var(--e-ink);color:#F6EFEA}
    .faceless-photo{position:relative;margin:0;min-height:520px}
    .faceless-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 40%}
    .faceless-copy{padding:clamp(56px,8vw,112px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) clamp(56px,8vw,112px) clamp(28px,5vw,80px)}
    .faceless h2{font-size:clamp(40px,5.2vw,76px);line-height:.98;letter-spacing:-.035em;margin:0 0 22px;color:#fff}
    .faceless .e-lede{color:rgba(246,239,234,.82);margin-bottom:34px}
    .refuse-h{font-family:var(--e-sans);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-bubble);margin:0 0 6px}
    .refuse{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.2)}
    .refuse li{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:18px;padding:16px 0;border-bottom:1px solid rgba(255,255,255,.2)}
    .refuse strong{font-family:var(--e-serif);font-weight:600;font-size:22px;line-height:1.2;color:#fff}
    .refuse span{font-size:15px;line-height:1.55;color:rgba(246,239,234,.78)}
    @media(max-width:900px){
      .faceless{grid-template-columns:1fr}
      .faceless-photo{min-height:0;aspect-ratio:3/2}
      .faceless-copy{padding:48px var(--e-gut) 56px}
      .refuse li{grid-template-columns:1fr;gap:4px}
    }

    /* ============ 4 · THE SHOWROOM: proof by inspection ============ */
    .show-head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(36px,5vw,60px)}
    .show-head .e-d2{margin:0}
    .show-head p{margin:0;color:var(--e-ink-2);font-size:17px}
    .rooms{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(16px,2vw,24px)}
    .rooms li{grid-column:span 2;min-width:0}
    .rooms li:nth-child(1){grid-column:span 4;grid-row:span 2}
    .room{display:flex;flex-direction:column;height:100%;background:var(--e-white);border:1px solid var(--e-line);border-radius:6px;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease}
    .room:hover{transform:translateY(-3px);box-shadow:var(--e-lift)}
    .shot{position:relative;margin:0;background:var(--e-paper);border-bottom:1px solid var(--e-line)}
    .shot .bar{display:flex;align-items:center;gap:6px;padding:8px 12px;background:#F1EAE3;border-bottom:1px solid var(--e-line);font-size:11.5px;color:var(--e-ink-3);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
    .shot .bar i{width:8px;height:8px;border-radius:50%;background:rgba(26,20,23,.18);flex:none}
    .shot img{width:100%;aspect-ratio:16/10;object-fit:cover;object-position:top center;display:block}
    .rooms li:nth-child(1) .shot img{aspect-ratio:16/11}
    .room-body{padding:20px 22px 20px;display:flex;flex-direction:column;flex:1}
    .room-body .k{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:8px}
    .room-body h3{font-size:22px;line-height:1.15;margin:0 0 8px}
    .rooms li:nth-child(1) .room-body h3{font-size:clamp(26px,2.6vw,34px)}
    .room-body p{font-size:15px;line-height:1.55;color:var(--e-ink-2);margin:0 0 14px;flex:1}
    .room-body .go{font-size:14px;font-weight:700;color:var(--e-pink-t)}
    @media(max-width:1020px){.rooms{grid-template-columns:repeat(2,minmax(0,1fr))}.rooms li,.rooms li:nth-child(1){grid-column:span 1;grid-row:auto}.rooms li:nth-child(1){grid-column:1/-1}}
    @media(max-width:620px){.rooms{grid-template-columns:minmax(0,1fr)}.show-head{grid-template-columns:1fr}}

    /* ============ 5 · THE FLAGSHIP: product editorial ============ */
    .flag{background:var(--e-white);border-top:1px solid var(--e-line);border-bottom:1px solid var(--e-line)}
    .flag-grid{display:grid;grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr);gap:clamp(32px,6vw,96px);align-items:start}
    .flag-fig{margin:0;position:sticky;top:96px}
    .flag-fig .e-figure{aspect-ratio:4/5}
    .flag-fig .e-figure img{object-position:40% 50%}
    .flag h2{font-size:clamp(38px,4.8vw,66px);line-height:1;letter-spacing:-.035em;margin:0 0 20px}
    .flag .for{font-size:17px;color:var(--e-ink-2);margin:0 0 30px;max-width:34em}
    .flag .for strong{color:var(--e-ink);font-weight:600}
    .ba{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--e-line);border-radius:6px;overflow:hidden;margin:0 0 28px}
    .ba > div{padding:22px 22px 20px}
    .ba > div + div{background:var(--e-blush);border-left:1px solid var(--e-line)}
    .ba h3{font-family:var(--e-sans);font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 12px}
    .ba ul{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:15px;line-height:1.5;color:var(--e-ink-2)}
    .evidence{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--e-ink);border-bottom:1px solid rgba(26,20,23,.18);margin:0 0 30px}
    .evidence div{padding:16px 10px 16px 0}
    .evidence b{display:block;font-family:var(--e-serif);font-weight:600;font-size:clamp(26px,2.6vw,34px);line-height:1;color:var(--e-ink);letter-spacing:-.02em}
    .evidence span{display:block;font-size:12.5px;line-height:1.4;color:var(--e-ink-2);margin-top:6px}
    .buy{display:flex;flex-wrap:wrap;align-items:center;gap:18px 28px;margin:0 0 34px}
    .buy .e-price{font-size:clamp(48px,5vw,64px);color:var(--e-pink)}
    .buy .terms{font-size:14.5px;line-height:1.5;color:var(--e-ink-2)}
    .buy .terms b{color:var(--e-ink);font-weight:600}
    .quote{margin:0;padding:26px 0 0;border-top:1px solid rgba(200,169,106,.6)}
    .quote blockquote{margin:0 0 14px;font-family:var(--e-serif);font-weight:600;font-size:clamp(19px,1.7vw,22px);line-height:1.45;color:var(--e-ink)}
    .quote blockquote::before{content:"“";color:var(--e-pink);margin-right:2px}
    .quote blockquote::after{content:"”";color:var(--e-pink)}
    .quote figcaption{font-size:13.5px;color:var(--e-ink-2)}
    .quote figcaption strong{color:var(--e-ink);font-weight:600;margin-right:10px}
    .quote .stars{color:var(--e-pink);letter-spacing:3px;margin-left:10px}
    @media(max-width:900px){.flag-grid{grid-template-columns:1fr}.flag-fig{position:relative;top:0}.flag-fig .e-figure{aspect-ratio:3/2}.evidence{grid-template-columns:1fr 1fr}.buy .e-btn{width:100%}}
    @media(max-width:520px){.ba{grid-template-columns:1fr}.ba > div + div{border-left:0;border-top:1px solid var(--e-line)}}

    /* ============ 6 · FIT: where to start ============ */
    .fit{width:100%;border-collapse:collapse;text-align:left}
    .fit th,.fit td{padding:20px 18px;border-bottom:1px solid rgba(26,20,23,.14);vertical-align:top}
    .fit thead th{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3);border-bottom:1px solid var(--e-ink);padding-top:0}
    .fit tbody th{font-family:var(--e-serif);font-weight:600;font-size:clamp(20px,1.9vw,24px);line-height:1.2;color:var(--e-ink);width:30%}
    .fit td{font-size:15.5px;line-height:1.55;color:var(--e-ink-2)}
    .fit .p{font-family:var(--e-serif);font-weight:600;font-size:22px;color:var(--e-ink);white-space:nowrap}
    .fit .p small{display:block;font-family:var(--e-sans);font-size:12.5px;font-weight:500;color:var(--e-ink-3);white-space:normal;margin-top:4px}
    .fit tr.hl th,.fit tr.hl td{background:var(--e-blush)}
    .fit a{font-weight:700;color:var(--e-pink-t);text-decoration:underline;text-underline-offset:4px;text-decoration-color:rgba(184,36,95,.4);display:inline-flex;min-height:44px;align-items:center}
    @media(max-width:760px){
      .fit thead{display:none}
      .fit,.fit tbody,.fit tr,.fit th,.fit td{display:block;width:100%}
      .fit tr{border-bottom:1px solid rgba(26,20,23,.18);padding:18px 0}
      .fit th,.fit td{border:0;padding:4px 14px}
      .fit tbody th{width:auto;font-size:22px;padding-bottom:8px}
      .fit tr.hl{background:var(--e-blush)}
      .fit tr.hl th,.fit tr.hl td{background:transparent}
    }

    /* ============ 7 · MEMBERSHIP: choose your room ============ */
    .mem-grid{display:grid;grid-template-columns:1fr 1fr;gap:0;border:1px solid var(--e-ink);border-radius:6px;overflow:hidden;background:var(--e-white)}
    .mem-grid article{padding:clamp(26px,3.4vw,44px);display:flex;flex-direction:column}
    .mem-grid article + article{border-left:1px solid var(--e-ink);background:var(--e-cream)}
    .mem-grid .who{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 12px}
    .mem-grid h3{font-size:clamp(26px,2.6vw,34px);line-height:1.1;margin:0 0 10px}
    .mem-grid .sell{font-family:var(--e-serif);font-weight:600;font-size:clamp(20px,1.8vw,23px);line-height:1.3;color:var(--e-ink);margin:0 0 20px}
    .mem-grid .e-price{font-size:46px;color:var(--e-pink)}
    .mem-grid .e-price small{font-family:var(--e-sans);font-size:15px;font-weight:600;color:var(--e-ink-2);letter-spacing:0}
    .mem-grid .alt{font-size:14px;color:var(--e-ink-2);margin:8px 0 20px}
    .mem-grid .e-list{margin:0 0 26px;font-size:15px;color:var(--e-ink-2)}
    .mem-grid .e-btn{margin-top:auto;align-self:flex-start}
    @media(max-width:780px){.mem-grid{grid-template-columns:1fr}.mem-grid article + article{border-left:0;border-top:1px solid var(--e-ink)}.mem-grid .e-btn{width:100%}}

    /* ============ 8 · LIBRARY + 9 · LETTER: quiet supporting content ============ */
    .shelf{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--e-ink)}
    .shelf li + li{border-left:1px solid rgba(26,20,23,.14)}
    .shelf a{display:flex;flex-direction:column;height:100%;padding:22px 20px 24px;transition:background .2s}
    .shelf a:hover{background:var(--e-white)}
    .shelf .cat{font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:10px}
    .shelf h3{font-size:21px;line-height:1.22;margin:0 0 14px;flex:1}
    .shelf .rd{font-size:13px;color:var(--e-ink-3)}
    @media(max-width:900px){.shelf{grid-template-columns:1fr 1fr}.shelf li:nth-child(3){border-left:0}.shelf li:nth-child(n+3){border-top:1px solid rgba(26,20,23,.14)}}
    @media(max-width:520px){.shelf{grid-template-columns:1fr}.shelf li + li{border-left:0;border-top:1px solid rgba(26,20,23,.14)}}
    .letter{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(24px,5vw,72px);align-items:center}
    .letter .e-figure{aspect-ratio:4/5;max-height:520px}
    .letter :global(.freebie-capture){margin:18px 0 0;padding:0;border:0;background:transparent}
    .letter :global(.fc-h){font-family:var(--e-serif);font-weight:600;font-size:clamp(32px,3.8vw,48px);line-height:1.04;letter-spacing:-.03em;color:var(--e-ink);margin:0 0 12px}
    .letter :global(.fc-sub){font-size:16px;color:var(--e-ink-2);margin:0 0 20px}
    .letter :global(.fc-row input){min-height:52px;border-radius:999px;border:1px solid rgba(26,20,23,.3);padding:14px 22px;font-size:16px;background:#fff}
    .letter :global(.fc-row button){min-height:52px;border-radius:999px;background:var(--e-pink);font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:14px 28px}
    .letter :global(.fc-row button:hover){background:var(--e-pink-t)}
    .letter :global(.fc-done){font-family:var(--e-serif);font-weight:600;font-style:normal}
    @media(max-width:820px){.letter{grid-template-columns:1fr}.letter .e-figure{aspect-ratio:3/2}.letter :global(.fc-row button){width:100%}}

    @media(prefers-reduced-motion:reduce){.room,.shelf a{transition:none}.room:hover{transform:none}}
  </style>
</head>
<body class="e-page">
  <SiteNav />

  <main>
    <!-- 1 · HOOK: the cover -->
    <section class="cover" aria-labelledby="hero-h">
      <div class="cover-copy">
        <p class="e-kick e-rise">For women building without a personal brand</p>
        <h1 id="hero-h" class="e-rise e-rise-2">Build the whole business <em>before anyone knows your name.</em></h1>
        <p class="e-lede e-rise e-rise-3"><strong>The AI-built faceless business, in the right order: offer, funnel, automation, then audience.</strong> AI does the building. The order does the selling. Your real face is never required.</p>
        <div class="e-actions">
          <a class="e-btn" href="/resources/faceless-income-blueprint">Get the free Blueprint <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href={WE.preview}>See inside the $97 build, no email</a>
        </div>
        <ul class="cover-meta" aria-label="The business, by the numbers">
          <li><b>{community.members}</b>women in the community</li>
          <li><b>{library.guides}</b>free pillar guides</li>
          <li><b>{WE.modules}</b>module flagship, delivered as a website</li>
        </ul>
      </div>
      <figure class="cover-photo">
        <img src="/images/home/hero-pink-knit-desk-720.webp"
             srcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
             sizes="(max-width: 900px) 100vw, 46vw" width="480" height="596" fetchpriority="high" decoding="async"
             alt="The brand's AI persona in an oversized pink knit sweater, sipping a glitter pink iced coffee at a cream farmhouse desk, her laptop open beside sticky notes and wildflowers, an open window onto the garden behind her." />
        <figcaption><span>The New Faceless</span> · this site is the case study</figcaption>
      </figure>
    </section>

    <!-- 2 · DIFFERENTIATION + METHOD -->
    <section class="e-sec" id="method" aria-labelledby="method-h">
      <div class="e-wrap">
        <div class="method-head">
          <div>
            <p class="e-kick">The signature method</p>
            <h2 class="e-d2" id="method-h">Built Backwards. <em>The order is the method.</em></h2>
          </div>
          <p class="forwards">
            Most people build it forwards: <s>audience</s> → <s>automation</s> → <s>funnel</s> → <s>offer</s>. That is how you end up with followers and no business.
            <strong>You are not learning four topics. You are learning the sequence.</strong>
          </p>
        </div>
        <ol class="stack">
          {method.map((m, i) => (
            <li class="tier-row">
              <span class="n" aria-hidden="true">{m.n}</span>
              <h3>{m.name}<span class="ord">{["First", "Second", "Third", "Last"][i]}</span></h3>
              <p>{m.line}<b>{m.out}</b></p>
            </li>
          ))}
        </ol>
        <div class="method-foot">
          <p class="tl">Build Your Business Backwards. Scale It Forward.™</p>
          <p><strong>AI + architecture.</strong> AI is the build team. The architecture is what makes it a business.</p>
        </div>
      </div>
    </section>

    <!-- 3 · THE FACELESS MOMENT -->
    <section class="faceless" aria-labelledby="faceless-h">
      <figure class="faceless-photo">
        <img src="/images/home/founder-window-seat-1000.webp"
             srcset="/images/home/founder-window-seat-640.webp 640w, /images/home/founder-window-seat-1000.webp 1000w"
             sizes="(max-width: 900px) 100vw, 50vw" width="1000" height="666" loading="lazy" decoding="async"
             alt="The brand's AI persona in a cream tee and pink sweatpants on a farmhouse window seat, laptop on her knees, a pink tumbler and lavender on the sill and open pasture outside." />
      </figure>
      <div class="faceless-copy">
        <p class="e-kick">The New Faceless</p>
        <h2 id="faceless-h">Faceless doesn't mean nobody's there.</h2>
        <p class="e-lede">It means your real face is never required. The business is built first, the brand's face is an AI persona, and everything you need to trust is on the page, open to inspect.</p>
        <p class="refuse-h">Four things I refuse to teach</p>
        <ul class="refuse">
          {refusals.map((r) => <li><strong>{r.t}</strong><span>{r.p}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- 4 · PROOF: the showroom -->
    <section class="e-sec" id="showroom" aria-labelledby="show-h">
      <div class="e-wrap">
        <div class="show-head">
          <div>
            <p class="e-kick">Proof by inspection</p>
            <h2 class="e-d2" id="show-h">Walk through the build. <em>Every room is open.</em></h2>
          </div>
          <p>No income screenshots. Every article on this site started as a Skool lesson, and the course is delivered on the very site it teaches you to build. Open any room and look for yourself.</p>
        </div>
        <ul class="rooms">
          {rooms.map((r, i) => (
            <li>
              <a class="room" href={r.href}>
                <figure class="shot">
                  <span class="bar" aria-hidden="true"><i></i><i></i><i></i>thedigitalincomeedit.com{r.path}</span>
                  <img src={`/images/home/room-${r.key}-${i === 0 ? 1100 : 640}.webp`} width={i === 0 ? 1100 : 640} height={i === 0 ? 756 : 400}
                       loading="lazy" decoding="async" alt={`The live ${r.t} page on this site, as it looks today.`} />
                </figure>
                <span class="room-body">
                  <span class="k">{r.room}</span>
                  <h3>{r.t}</h3>
                  <p>{r.p}</p>
                  <span class="go">{r.go} <span aria-hidden="true">→</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 · THE FLAGSHIP OFFER -->
    <section class="e-sec flag" id="weekend-ecosystem" aria-labelledby="flag-h">
      <div class="e-wrap flag-grid">
        <figure class="flag-fig">
          <div class="e-figure">
            <img src="/images/home/build-armchair-laptop-900.webp"
                 srcset="/images/home/build-armchair-laptop-560.webp 560w, /images/home/build-armchair-laptop-900.webp 900w"
                 sizes="(max-width: 900px) 100vw, 46vw" width="900" height="604" loading="lazy" decoding="async"
                 alt="Over the shoulder of the brand's AI persona in a pink hoodie, curled in a farmhouse armchair in fuzzy socks, building on her laptop with a pink tumbler at her side." />
          </div>
          <figcaption class="e-cap">Built with Claude doing the building. No code, no camera.</figcaption>
        </figure>
        <div>
          <p class="e-kick">The flagship · {WE.name}</p>
          <h2 id="flag-h">Your own website and blog, <em>built in a weekend</em> from what you've already written.</h2>
          <p class="for"><strong>For you if</strong> your best writing is sitting in a Skool group, a notes app or a feed you don't own, and you want it working for you on a domain that is yours.</p>
          <div class="ba">
            <div>
              <h3>Friday, you have</h3>
              <ul><li>Posts and lessons you already wrote</li><li>No website, or one you avoid</li><li>A list that isn't growing</li></ul>
            </div>
            <div>
              <h3>Sunday, you have</h3>
              <ul><li>A live site and blog on your own domain</li><li>Email capture and your offer, wired in</li><li>One prompt that turns each article into {WE.assetsPerArticle} assets</li></ul>
            </div>
          </div>
          <div class="evidence" aria-label="What's inside">
            <div><b>{WE.modules}</b><span>modules, as a live website</span></div>
            <div><b>{WE.prompts}</b><span>prompts, written out in full</span></div>
            <div><b>{WE.assetsPerArticle}</b><span>assets from each article</span></div>
            <div><b>Free</b><span>every future update</span></div>
          </div>
          <div class="buy">
            <p class="e-price" style="margin:0">{WE.price}</p>
            <p class="terms" style="margin:0"><b>One payment, or {WE.plan}.</b><br />Yours for good, updates included.</p>
          </div>
          <div class="e-actions" style="margin-bottom:34px">
            <a class="e-btn" href={WE.url}>Build my site this weekend <span class="ar" aria-hidden="true">→</span></a>
            <a class="e-link" href={WE.preview}>See inside first, no email</a>
          </div>
          <figure class="quote">
            <blockquote>{tina.quote}</blockquote>
            <figcaption><strong>{tina.name}</strong>Skool review · public<span class="stars" role="img" aria-label={`${tina.stars} out of 5 stars`}>{"★".repeat(tina.stars)}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6 · FIT: where to start -->
    <section class="e-sec" id="start" aria-labelledby="fit-h">
      <div class="e-wrap">
        <div class="e-center" style="max-width:760px;margin:0 auto clamp(32px,5vw,56px)">
          <p class="e-kick">Where to start</p>
          <h2 class="e-d2" id="fit-h">Three ways in. <em>Pick the one that fits today.</em></h2>
        </div>
        <table class="fit">
          <caption class="sr-only" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Where to start with The Digital Income Edit™</caption>
          <thead><tr><th scope="col">If you are</th><th scope="col">Start with</th><th scope="col">It costs</th><th scope="col"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Go</span></th></tr></thead>
          <tbody>
            <tr>
              <th scope="row">New, and want the plan before anything else</th>
              <td>The Faceless Income Blueprint™: the niche, the first product and the traffic plan, in the order this method runs. Not sure? <a href="/resources/find-your-door">Find your door</a>, free, no email.</td>
              <td><span class="p">Free<small>for your email</small></span></td>
              <td><a href="/resources/faceless-income-blueprint">Get the Blueprint</a></td>
            </tr>
            <tr class="hl">
              <th scope="row">Ready to build the site this weekend</th>
              <td>{WE.name}: your website, blog, email capture and offer routing, built from what you already wrote.</td>
              <td><span class="p">{WE.price}<small>or {WE.plan}</small></span></td>
              <td><a href={WE.url}>Build my weekend</a></td>
            </tr>
            <tr>
              <th scope="row">Building for the long haul, beside other women</th>
              <td>The membership on Skool. Standard teaches the whole build. Premium writes your content month for you.</td>
              <td><span class="p">{M.standard.perMonth}<small>Premium {M.premium.perMonth} · {M.trial}</small></span></td>
              <td><a href="#membership">Choose your room</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7 · MEMBERSHIP -->
    <section class="e-sec e-paper" id="membership" aria-labelledby="mem-h">
      <div class="e-wrap">
        <div style="max-width:760px;margin:0 0 clamp(32px,5vw,52px)">
          <p class="e-kick">The membership</p>
          <h2 class="e-d2" id="mem-h">Choose your room. <em>Both start free for {M.trialDays} days.</em></h2>
        </div>
        <div class="mem-grid">
          <article>
            <p class="who">You build it</p>
            <h3>{M.standard.name}</h3>
            <p class="sell">The whole build, by hand, with the room beside you.</p>
            <p class="e-price">{M.standard.monthly}<small>/month</small></p>
            <p class="alt">or {M.standard.perYear} · {M.trial}</p>
            <ul class="e-list">
              <li>The Essentials Edit, AI Foundations for Creators and Canva Crash Course</li>
              <li>Pinterest Foundations™, The Email Edit and The Shopify Edit</li>
              <li>Daily Prompts and the community, every day</li>
              <li>The Value Vault guides, bought à la carte</li>
            </ul>
            <a class="e-btn e-btn--ghost" href={SKOOL_PLANS}>Start Standard free <span class="ar" aria-hidden="true">→</span></a>
          </article>
          <article>
            <p class="who">More of it done for you</p>
            <h3>{M.premium.name}</h3>
            <p class="sell">Everything in Standard, with your content month written before you sit down.</p>
            <p class="e-price">{M.premium.monthly}<small>/month</small></p>
            <p class="alt">or {M.premium.perYear} · {M.trial}</p>
            <ul class="e-list">
              <li>A done-for-you content calendar, every month</li>
              <li>The Offer Edit, The Funnel Edit and Scaling &amp; Systems</li>
              <li>The Ads Edit™</li>
              <li>The Premium Vault: every Value Vault guide, already unlocked</li>
            </ul>
            <a class="e-btn" href={SKOOL_PLANS}>Start Premium free <span class="ar" aria-hidden="true">→</span></a>
          </article>
        </div>
        <p style="margin:22px 0 0"><a class="e-link" href="/membership">Compare the two memberships in full <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <!-- 8 · DEEPER CONTENT -->
    <section class="e-sec" aria-labelledby="lib-h">
      <div class="e-wrap">
        <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:12px 32px;margin-bottom:28px">
          <div style="max-width:640px">
            <p class="e-kick">The library</p>
            <h2 class="e-d3" id="lib-h" style="font-size:clamp(30px,3.6vw,46px);margin:0">{cap(library.guidesWord)} pillar guides, free. <em>Start with these four.</em></h2>
          </div>
          <a class="e-link" href="/learn">Explore the Library <span aria-hidden="true">→</span></a>
        </div>
        <ul class="shelf">
          {guides.map((g) => (
            <li>
              <a href={`/learn/${g.slug}`}>
                <span class="cat">{g.cat}</span>
                <h3>{g.t}</h3>
                <span class="rd">{g.read} read</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9 · EMAIL -->
    <section class="e-sec e-white" style="border-top:1px solid var(--e-line)" aria-label="The Sunday letter">
      <div class="e-wrap letter">
        <div class="e-figure">
          <img src="/images/home/sunday-journal-640.webp" srcset="/images/home/sunday-journal-640.webp 640w, /images/home/sunday-journal-1100.webp 1100w"
               sizes="(max-width: 820px) 100vw, 40vw" width="640" height="794" loading="lazy" decoding="async"
               alt="Hands writing in a cream journal at a sunlit desk, a pink folder, a gold pen and a small vase of blush flowers beside it." />
        </div>
        <div>
          <p class="e-kick">Every Sunday</p>
          <FreebieForm
            heading="One idea you can build with before Monday."
            button="Send me the Sunday letter"
            sub="Offers, funnels, automation and the AI underneath them, written for women building quietly. One letter a week."
            done="You're in. Your first Sunday letter is on its way." />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <Analytics />
</body>
</html>
