---
// Homepage, rebuilt 19 Nov 2026 on Jodie's Etsy template layouts, in the approved WYS sales-page style.
import {WYS_CTA} from "../data/wys-live.js";
import "../styles/review-bubble.css";
import "../styles/tdie-template.css";
import "../styles/tdie-home.css";
import SiteHeader from "../components/SiteHeader.astro";
import { NAV, NAV_CTA, FOOTER, SOCIAL } from "../data/site.js";
import BlueprintForm from "../components/BlueprintForm.astro";
import { MEMBER_REVIEWS } from "../we-reviews.js";
import ReviewBubble from "../components/ReviewBubble.astro";
import MembershipPlans from "../components/MembershipPlans.astro";
import { weekendEcosystem as WE, membership as MEM, SKOOL_PLANS } from "../data/facts.js";

const BRITTANY = MEMBER_REVIEWS.find((r) => r.id === "brittany-miller-skool");
const alsoFrom = [
  { label: "Shop the looks", title: "The Lifestyle Edit", href: "/lifestyle" },
  { label: "Amazon storefront system", title: "The While-You-Sleep Storefront™", href: WYS_CTA.href },
  { label: "Digital product stock", title: "Pretty & Paid PLR Vault™", href: "/shop/pretty-and-paid-plr-vault" },
  { label: "Physical products", title: "The Shopify Starter Kit", href: "/resources/shopify-starter-kit" },
];
const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;
const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. Women are building it inside The Digital Income Edit™.`;
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];
const steps = [{name:'Offer',line:'Decide what you sell before you post a thing.'},{name:'Funnel',line:'Build the page and emails that sell it for you.'},{name:'Automation',line:'AI takes the daily repeat work off your plate.'},{name:'Audience',line:'Then send traffic somewhere already built to sell.'}];
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™", logo: `${SITE}/icon-512.png`, sameAs: SOCIAL.map((s) => s.href) },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFE4EF" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href="/wys-sales/fonts/gilda.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/wys-sales/fonts/poppins-400.woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="tdie-t">
<svg width="0" height="0" style="position:absolute"><defs><linearGradient id="spg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff8ac2"/><stop offset=".5" stop-color="#D62E73"/><stop offset="1" stop-color="#c9a8ff"/></linearGradient></defs><symbol id="sp" viewBox="0 0 100 100"><path d="M50 0C53 35 65 47 100 50 65 53 53 65 50 100 47 65 35 53 0 50 35 47 47 35 50 0Z"/></symbol></svg>

<SiteHeader />

<main id="home-content">
<!-- Template page 2: header card + photo -->
<section class="hh">
 <div class="wrap hh-grid">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Inside<b class="big">900+</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">If you want the income without becoming the content</p>
   <h1>Build a faceless business. <span class="scr">Keep your life off camera.</span></h1>
   <p class="what"><b>The Digital Income Edit™ membership</b> gives you the training, the community and new material every month to build your offer, funnel, emails and content with AI, in the right order. Offer, funnel, automation, then audience.</p>
   <a class="btn buy" href={SKOOL_PLANS}>Start your 7 days free <span class="ar">→</span></a>
   <p class="need">{MEM.standard.name} {MEM.standard.perMonth} · {MEM.premium.name} {MEM.premium.perMonth}. Cancel in Skool before the trial ends and you pay nothing.</p>
   <p class="see"><a href="#blueprint">Or get the free Blueprint ↓</a></p>
  </div>
  <div class="hh-ph">
   <img src="/images/brand/hero-tk-car.webp" alt="Tommy Kate, the AI face of The Digital Income Edit™, laughing in her pink car" width="1100" height="1639" fetchpriority="high" decoding="async">
   <p class="hh-cap"><b>Meet Tommy Kate.</b> The AI face of this brand. <span>Yours can have one too.</span></p>
  </div>
 </div>
</section>

<!-- Template page 9: band -->
<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Starting from scratch?</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>

<!-- Template page 14: text card + photo + script line -->
<section class="sec">
 <div class="wrap p14">
  <div>
   <h2>47 saved videos. <span class="glit">Zero products.</span></h2>
   <ul class="hm-crossed"><li>Prompts everywhere. Nothing built.</li><li>No interest in being an influencer.</li><li>Ideas everywhere. Nothing connected.</li></ul>
   <p>You don't need more ideas.</p>
   <span class="scr">You need the right order.</span>
  </div>
  <div class="ph"><img src="/images/pages/we-close-kitchen-1200.webp" alt="Tommy Kate working on her laptop at the kitchen table with her golden retriever" width="1200" height="1489" loading="lazy" decoding="async"></div>
 </div>
</section>

<!-- Template page 18: the method, four boxes -->
<section class="sec wash" id="method">
 <div class="wrap">
  <span class="stk hs" style="left:30px;top:-10px">Step 1<b class="big">free</b></span>
  <p class="kick">The Built Backwards Method</p>
  <h2 class="h2">Built backwards. <span class="scr">The order is the method.</span></h2>
  <div class="lead"><p>The order to build a business, not a list of things to buy. Most people grow an audience and hope it buys. You build what it will buy first.</p></div>
  <div class="p18 hm-four">{steps.map((st,i) => <div class="box"><span class="num hm-num">{String(i+1).padStart(2,'0')}</span><h3>{st.name}</h3><p>{st.line}</p></div>)}</div>
  <div class="btnwrap"><a class="btn" href="#blueprint">Start with step 1: the free Blueprint <span class="ar">↓</span></a></div>
 </div>
</section>

<!-- Template pages 18 + 25: membership -->
<section class="sec" id="membership">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">The membership · the whole package</p>
  <h2 class="h2">One membership. <span class="scr">The whole business.</span></h2>
  <div class="lead"><p>This is where everything here comes together. Not one course you finish and forget, but the full classroom, something new every day, the community beside you and, with Premium, your content written for you every month.</p></div>
  <div class="p18">
   <div class="box"><div class="cb"></div><span class="step">01</span><h3>The whole build, in order</h3><p>Brand, content, email, Pinterest and selling, in one classroom you keep coming back to.</p></div>
   <div class="box"><div class="cb"></div><span class="step">02</span><h3>New every day and every month</h3><p>A fresh AI photo prompt daily, new lessons as they land, and with Premium a full content calendar each month.</p></div>
   <div class="box"><div class="cb"></div><span class="step">03</span><h3>Never building alone</h3><p>900+ women in the Skool community, asking the same questions you are.</p></div>
  </div>
  <div class="hm-plans"><MembershipPlans /></div>
  <p class="hm-compare"><a href="/membership#compare">See the full membership comparison</a></p>
  <div class="hm-reviews">{MEMBER_REVIEWS.map((r) => <ReviewBubble quote={r.quote} name={r.name} source={r.source} stars={r.stars} />)}</div>
  <p class="hm-swipe-note">Swipe for more reviews <span aria-hidden="true">→</span></p>
 </div>
</section>

<!-- Template page 44: photo + card -->
<section class="sec wash">
 <div class="wrap">
  <p class="kick">The proof is the build</p>
  <h2 class="h2 hm-proof-h">This whole business was built <span class="scr">faceless, with AI.</span></h2>
  <div class="p44 hm-proof">
   <div class="ph"><a href="https://www.skool.com/thedigitalincomeedit/about"><img src="/images/pages/skool-about-current.webp" alt="The Digital Income Edit™ Skool group, as it looks today" width="1440" height="979" loading="lazy" decoding="async"></a></div>
   <div class="card dash">
    <span class="stk r" style="right:-40px;top:-56px">Open it<b>and look</b></span>
    <p>This site, the emails, the course and the Skool classroom. Every article here started as a Skool lesson, and the course is delivered on the very site it teaches you to build. Open any of it and look. The sales are real too.</p>
    <ul class="chk"><li>No filming</li><li>No audience first</li><li>No performing</li></ul>
    <a class="btn" href="https://www.skool.com/thedigitalincomeedit/about">Take a free look inside <span class="ar">→</span></a>
    <p class="see"><a href={WE.preview}>Or see inside the course, free</a></p>
   </div>
 </div>
  <div class="pf-row" aria-label="Real sales from the Beacons dashboard">
   <figure class="pf"><img src="/images/proof/beacons-30-days-blurred.webp" width="1179" height="884" loading="lazy" decoding="async" alt="Beacons sales activity for the last 30 days: 469 views, 56 orders, 11.9% conversion. Earnings blurred."><figcaption>Last 30 days on Beacons. Earnings blurred.</figcaption></figure>
   <figure class="pf"><img src="/images/proof/beacons-lifetime-blurred.webp" width="1100" height="1420" loading="lazy" decoding="async" alt="Beacons lifetime sales by product: The Weekend Ecosystem, The While-You-Sleep Storefront, Pretty and Paid PLR Vault and others, climbing since August. Totals blurred."><figcaption>Lifetime sales by product. Totals blurred.</figcaption></figure>
  </div>
 </div>
</section>

<!-- Template pages 24 + 25: the free Blueprint -->
<section class="sec" id="blueprint">
 <div class="wrap p25">
  <div class="intro">
   <span class="scr">free download...</span>
   <h2>The Faceless Income Blueprint™</h2>
   <div class="hm-fan" aria-label="The Blueprint cover and three inside pages">
    <img class="hm-pg a" src="/images/brand/bp-page-3.webp" width="260" height="368" alt="A page from The Faceless Income Blueprint" loading="lazy" decoding="async">
    <img class="hm-pg b" src="/images/brand/bp-page-4.webp" width="260" height="368" alt="Another page from the Blueprint" loading="lazy" decoding="async">
    <img class="hm-pg c" src="/images/brand/blueprint-cover.webp" width="300" height="424" alt="The Faceless Income Blueprint cover" loading="lazy" decoding="async">
   </div>
  </div>
  <div class="pc dash" style="position:relative">
   <span class="stk r" style="right:-60px;top:-70px">15 pages<b class="big">free</b></span>
   <div class="pn">Don't know what to sell?</div>
   <h3 class="hm-bp-h">Start with the <span class="glit">Blueprint.</span></h3>
   <ul class="chk"><li>Your whole business on one map</li><li>The one thing to build first</li><li>A seven-day plan to build it</li></ul>
   <BlueprintForm heading="" sub="" button="Send me the Blueprint" />
  </div>
 </div>
</section>

<!-- Template page 20 + 21: Weekend Ecosystem, Friday to Sunday -->
<div class="band"><svg class="spk sm" style="left:20%"><use href="#sp"/></svg><h2>Want your own website too?</h2><svg class="spk" style="right:20%"><use href="#sp"/></svg></div>
<section class="sec wash" id="owned-website">
 <div class="wrap">
  <p class="kick">One-time · $67 (regular {WE.price}, Black Friday)</p>
  <h2 class="h2">The Weekend Ecosystem™ <span class="scr">give your work a home.</span></h2>
  <div class="lead"><p>Turn the material you already made into your own website and blog, with email sign-ups connected.</p></div>
  <div class="p21">
   <div class="col"><span class="scr">Friday</span><div class="card dash"><ul class="chk hm-x"><li>Material in different places</li><li>No website to send readers</li><li>No connected email sign-up</li></ul></div></div>
   <div class="col"><span class="scr">Sunday</span><div class="card dash"><ul class="chk"><li>Your own website</li><li>A blog ready to publish</li><li>Email sign-ups connected</li></ul></div></div>
  </div>
  <div class="p42 dash hm-we" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">{WE.modules}<b class="big">modules</b></span>
   <div class="ph"><img src="/images/brand/we-inside.webp" alt="Inside The Weekend Ecosystem course" width="1080" height="480" loading="lazy" decoding="async"></div>
   <div class="tx">
    <h2>Your website and blog, <span class="scr">built in one weekend.</span></h2>
    <ul class="chk"><li>A live website on your own domain</li><li>Email sign-ups connected to your site</li><li>One prompt turns each article into {WE.assetsPerArticle} posts</li><li>{WE.prompts} prompts</li></ul>
    <a class="btn" href={WE.url}>Get {WE.name} · $67 <span class="ar">→</span></a>
    <p class="hm-small">$67 (regular {WE.price}, Black Friday, until Mon 30 Nov 11:45 pm ET), or {WE.plan}.</p>
   </div>
  </div>
 </div>
</section>

<!-- Template page 21: more help, two cards -->
<section class="sec">
 <div class="wrap">
  <p class="kick">Want it built with you?</p>
  <h2 class="h2">More help, <span class="scr">when you're ready.</span></h2>
  <div class="p21">
   <div class="col"><span class="scr">Mentorship</span><div class="card dash"><h3>Business Architect Mentorship Intensive™ (BAMI)</h3><p>Twelve weeks to build your offer, sales page, welcome emails and content system, with written review of your work at each of six phase gates.</p><a class="btn" href="/bami">Join the BAMI waitlist <span class="ar">→</span></a></div></div>
   <div class="col"><span class="scr">Done with you</span><div class="card dash"><h3>Work With Me</h3><p>An offer, a funnel and a system, built to work together. See the engagements and what each one includes.</p><a class="btn" href="/work-with-me">See how it works <span class="ar">→</span></a></div></div>
  </div>
 </div>
</section>

<!-- Template page 47: numbered list -->
<section class="sec wash">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">The free library</span></p>
  <h2 class="h2">Free guides. <span class="scr">Start with these.</span></h2>
  <div class="faq">{guides.map((g,i) => <a class="qa hm-link" href={`/learn/${g.slug}`}><span class="n">{String(i+1).padStart(2,'0')}</span><div><span class="hm-lab">{g.cat} · {g.read}</span><h3>{g.t}</h3></div><span class="hm-go">→</span></a>)}</div>
  <div class="btnwrap"><a class="btn" href="/learn">See every guide <span class="ar">→</span></a></div>
  <p class="kick" style="margin-top:70px">Also from The Digital Income Edit™</p>
  <div class="faq hm-also">{alsoFrom.map((a) => <a class="qa hm-link" href={a.href}><span class="n">✦</span><div><span class="hm-lab">{a.label}</span><h3>{a.title}</h3></div><span class="hm-go">→</span></a>)}</div>
 </div>
</section>

<!-- Template page 42: close -->
<section class="sec">
 <div class="wrap">
  <div class="p42 dash" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">7 days<b class="big">free</b></span>
   <div class="ph"><img src="/images/pages/newsletter-journal-desk-900.webp" alt="Planning the build at the desk, a journal open beside a coffee and fresh peonies" width="900" height="1117" loading="lazy" decoding="async"></div>
   <div class="tx">
    <svg class="spk sm" style="right:30px;top:30px"><use href="#sp"/></svg>
    <p class="kick">Build it backwards</p>
    <h2>Stop saving videos.</h2>
    <span class="scr">Start building.</span>
    <p>Seven days free inside the membership. Cancel in Skool before the trial ends and you pay nothing.</p>
    <a class="btn buy" href={SKOOL_PLANS}>Start your 7 days free <span class="ar">→</span></a>
    <p class="see"><a href="#blueprint">Or get the free Blueprint</a></p>
   </div>
  </div>
 </div>
</section>
</main>

<!-- Template pages 50 + 51 -->
<footer class="tfoot">
 <div class="touch"><h2>Get in touch <span class="scr">questions &amp; billing</span></h2><p><a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p></div>
 <div class="wrap tf-cols">{FOOTER.map((col) => <div><h4>{col.h}</h4>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>)}</div>
 <p class="tf-soc">{SOCIAL.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
 <div class="foot">© 2026 The Digital Income Edit™</div>
</footer>

<a class="stick off" href={SKOOL_PLANS}>Start your 7 days free <span class="ar">→</span></a>
<script is:inline>
(function(){var s=document.querySelector('.stick');if(!s||!('IntersectionObserver'in window))return;var vis=new Set(),passed=false,up=false,lastY=scrollY,hero=document.querySelector('.hh .buy');
function show(){s.classList.toggle('off',!passed||!up||vis.size>0)}
var io=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting)vis.add(e.target);else vis.delete(e.target);if(e.target===hero){passed=!e.isIntersecting&&e.boundingClientRect.top<0}});show()});
document.querySelectorAll('.btn,.offer-cta,form,.tfoot,#blueprint').forEach(function(b){if(b!==s)io.observe(b)});
addEventListener('scroll',function(){var y=scrollY;if(Math.abs(y-lastY)>6){up=y<lastY;lastY=y;show()}},{passive:true})})();
</script>
</body>
</html>
