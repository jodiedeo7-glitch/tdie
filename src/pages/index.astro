// Shop — every name, price and URL is a Product Register v3.1 row. Nothing here is inferred.
const shop = [
  { name: "The Weekend Ecosystem\u2122", price: "$97", note: "one-time \u00b7 waitlist open", copy: "Your website + blog, built from what you already have. 22 modules, 36 prompts, three reference vaults \u2014 and one prompt that turns each article into thirty finished assets. A live site, so every future update is included. Waitlist gets in three days early at the lowest price it will ever be.", url: "/weekend-ecosystem-waitlist", aff: false },
  { name: "Pretty & Paid PLR Vault™", price: "$7", note: "per month · on sale from $11 · price locked", copy: "Done-for-you digital products you rebrand and sell as your own, plus the content and training to launch them. 20 new products every month, and the full resell licence stays yours even if you cancel. On sale at $7 — join now and that stays your price permanently. Its own subscription, never part of the membership.", url: "/shop/pretty-and-paid-plr-vault/", aff: false },
  { name: "Build Your First Freebie in One Afternoon", price: "$7", note: "one-time", copy: "Build the lead magnet and the paid offer behind it in a single afternoon.", url: "/go/first-freebie", aff: false },
  { name: "150 UGC Brand Contacts", price: "$15", note: "one-time", copy: "A curated list of brands actively paying creators. Skip the research, start pitching.", url: "/go/ugc-brand-contacts", aff: false },
  { name: "The Tommy Kate Edit", price: "$17", note: "one-time \u00b7 lifetime access", copy: "A prompt pack for faceless lifestyle creators \u2014 ready-to-use AI prompts so you never start a caption from a blank screen. Lifetime updates included.", url: "/go/the-tommy-kate-edit", aff: false },
  { name: "The One and Done Money Stream", price: "$27", note: "one-time", copy: "Set up one reliable digital income stream. Create it once, let it earn on repeat.", url: "/go/one-and-done-money-stream", aff: false },
  { name: "Zero Income Claim Guide \u2014 100 DFY Reels", price: "$37", note: "one-time \u00b7 mine", copy: "A hundred done-for-you hooks and captions for the stage before you have proof \u2014 nothing to screenshot, no income claims, nothing that gets an account flagged.", url: "/go/zero-income-claim-reels", aff: false },
  { name: "Leni Loves", price: "$37", note: "one-time \u00b7 theirs", copy: "A collection of aesthetic templates and resources for your brand and content.", url: "/go/leni-loves", aff: true },
  { name: "The AI Subs Method", price: "$147", note: "one-time", copy: "A step-by-step system for growing and monetising a faceless AI subscription channel.", url: "/go/ai-subs-method", aff: true },
];

// Membership tiers. Inclusion lists read from the live Skool plans screen,
// 26 July 2026. Skool forces the free tier label to "Standard"; the canonical
// name is Free Community (Product Register v3.1, Part 1) and that is what ships.
const tiers = [
  {
    name: "Free Community",
    price: "$0",
    per: "forever",
    line: "Enough to build the thing. Not enough to sell it yet.",
    feature: false,
    cta: "Join free",
    ghost: true,
    href: "https://www.skool.com/thedigitalincomeedit/about",
    items: [
      "The Essentials Edit",
      "AI Foundations for Creators",
      "Canva Crash Course",
      "The Value Vault",
      "Daily Prompts",
    ],
  },
  {
    name: "Premium",
    price: "$9",
    per: "per month",
    line: "The half where it starts making money.",
    feature: true,
    cta: "Join Premium",
    ghost: false,
    href: "https://www.skool.com/thedigitalincomeedit/plans",
    items: [
      "Everything in the free community",
      "AI Twin / Influencer Creation",
      "The Monetization Edit",
      "Brand Building \u00b7 The Content Edit",
      "The Email Edit \u00b7 The Pinterest Edit",
      "The Tommy Kate Edit \u2014 included, not $17 here",
      "Pinterest Foundations\u2122",
      "Vacation & Luxe Babe Vault bonuses",
    ],
  },
  {
    name: "VIP",
    price: "$27",
    per: "per month",
    line: "Premium is what you build by hand. VIP buys the hours back.",
    feature: false,
    cta: "Join VIP",
    ghost: true,
    href: "https://www.skool.com/thedigitalincomeedit/plans",
    items: [
      "Everything in Premium",
      "Monthly DFY Content Calendar",
