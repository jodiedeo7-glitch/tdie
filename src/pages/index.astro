---
import "../styles/global.css";
import "../styles/sales-typography.css";
import "../styles/edit.css";
// Homepage type, self-hosted: Newsreader SemiBold for display, Inter for everything else.
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FreebieForm from "../components/FreebieForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { FEATURED as tina } from "../we-reviews.js";
import { membership as M, weekendEcosystem as WE, community, library, SKOOL_PLANS, cap } from "../data/facts.js";

const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. ${community.members} women are building it inside The Digital Income Edit™.`;

// The Built Backwards Method. The order is the method.
const method = [
  { n: "01", name: "Offer", line: "What you sell, who pays for it, what it costs. Decided before a single post exists.", out: "One sentence, one buyer, one price." },
  { n: "02", name: "Funnel", line: "The road a stranger walks from free to paid: the free thing, the page, the emails that do the asking.", out: "A path that sells without you in the room." },
  { n: "03", name: "Automation", line: "AI and schedules take the repeat work. One article becomes 24 finished assets and the emails send themselves.", out: "A business that runs on the Tuesday you skip." },
  { n: "04", name: "Audience", line: "Only now do you turn on traffic, pointed at something that already knows what to do with a visitor.", out: "Attention that lands somewhere." },
];

// What Jodie refuses to teach, and why. Short, because the method already said it.
const differences = [
  { t: "Build the offer before the audience.", p: "Know what you're selling, who it's for and where the money comes from before you spend a year performing for strangers." },
  { t: "Show the business, not the screenshot.", p: "The site itself is the case study. Open the pages. Inspect the funnel. Look at the actual outputs." },
  { t: "Use AI as the build team — not the personality.", p: "AI can write, organize and build. It does not need to become the voice of your brand." },
  { t: "Build traffic into a business.", p: "Pinterest, email, content and social are useful when they lead somewhere. They are not the destination." },
];

// Proof by inspection. Every room is a live page, shown as it really looks.
const rooms = [
  { key: "course", room: "The course", t: "22 modules, delivered as a website", p: "The Weekend Ecosystem™ lives on the very site it teaches you to build.", href: WE.preview, path: "/weekend-ecosystem/preview", go: "Walk the course lobby" },
  { key: "offer", room: "The offer", t: "The One-Sentence Offer tool", p: "Step one of the method, as a free tool. No email.", href: "/resources/one-sentence-offer", path: "/resources/one-sentence-offer", go: "Test your offer" },
  { key: "funnel", room: "The funnel", t: "The Weekend Build Challenge", p: "Five free days by email, walking a stranger in order from nothing to an offer.", href: "/resources/weekend-build-challenge", path: "/resources/weekend-build-challenge", go: "Inspect the funnel" },
  { key: "library", room: "The library", t: "Every article started as a lesson", p: "Each guide began as a Skool lesson and was turned into a page by the method it teaches.", href: "/learn/turn-skool-content-into-a-blog", path: "/learn/turn-skool-content-into-a-blog", go: "Read one, lesson to article" },
  { key: "classroom", room: "The classroom", t: "The Skool room behind it", p: `Where ${community.members} women build the same thing, beside each other.`, href: "/community", path: "/community", go: "See the room" },
  { key: "email", room: "The email", t: "The Weekly Edit, every Sunday", p: "Written once a week and delivered by the automation underneath this site.", href: "/newsletter", path: "/newsletter", go: "Read the letter" },
];

// A curated few of the pillar guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation & Paid Traffic", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      logo: `${SITE}/icon-512.png`,
      sameAs: ["https://pinterest.com/TheDigitalIncomeEditTDIE", "https://instagram.com/the.faceless.homestead.mama"] },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FBF8F5" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
        imagesizes="(max-width: 900px) 100vw, 44vw" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    body.e-page::before,body.e-page::after{display:none}

    /* ============ ART DIRECTION · editorial overrides ============ */
    .e-page{background:var(--e-cream)}
    .cover{background:var(--e-cream);grid-template-columns:minmax(0,1.03fr) minmax(0,.97fr);min-height:calc(100vh - 58px);overflow:clip}
    .mast{background:var(--e-cream);position:relative;z-index:3}
    .cover-copy{position:relative;z-index:2;padding-right:clamp(24px,6vw,110px)}
    .cover h1{font-size:clamp(48px,5vw,76px);max-width:11.5ch;line-height:.92}
    .cover h1 em{margin-left:.22em}
    .cover .e-lede{max-width:31em;font-size:clamp(17px,1.45vw,20px);line-height:1.55}
    .cover-photo{min-height:680px;margin:clamp(30px,4vw,64px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) clamp(30px,4vw,64px) 0;box-shadow:0 0 0 1px rgba(26,20,23,.14)}
    .cover-photo img{object-position:35% 40%;transform:scale(1.025)}
    .cover-photo figcaption{right:auto;left:0;padding:10px 18px 10px 14px;background:var(--e-cream);border-right:1px solid rgba(26,20,23,.14);border-bottom:1px solid rgba(26,20,23,.14)}
    .cover-meta{border-top:1px solid rgba(26,20,23,.22);padding-top:14px;margin-top:30px}
    .cover-meta li{max-width:13em}
    .method-head{padding-top:clamp(10px,3vw,34px)}
    .method-head .e-d2{font-size:clamp(48px,6.2vw,94px);max-width:11ch}
    .recognition{padding-top:clamp(100px,12vw,180px);padding-bottom:clamp(100px,12vw,180px)}
    .recognition-copy h2{font-size:clamp(46px,6.6vw,100px);max-width:11ch}
    .recognition-list li{padding:22px 0;font-size:clamp(22px,2.3vw,34px);max-width:30em}
    .faceless{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
    .faceless-photo{min-height:720px}
    .faceless-copy{padding-left:clamp(40px,7vw,120px)}
    .faceless h2{font-size:clamp(52px,6.4vw,104px);max-width:9ch}
    .showroom{background:var(--e-white)}
    .show-head{grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr)}
    .show-head .e-d2{font-size:clamp(48px,6.4vw,94px);max-width:10ch}
    .rooms{gap:clamp(42px,5vw,82px) clamp(22px,3vw,52px)}
    .rooms li:nth-child(1){grid-column:span 4}
    .room .e-artifact{background:var(--e-cream);padding:10px}
    .room .e-art-img{overflow:hidden}
    .room .e-art-img img{transition:transform .5s cubic-bezier(.2,.7,.2,1)}
    .room:hover .e-art-img img{transform:scale(1.025)}
    .rooms li:nth-child(1) .room .e-art-img img{aspect-ratio:16/10}
    .room-body{padding:20px 2px 0}
    .rooms li:nth-child(1) .room-body h3{font-size:clamp(32px,3.4vw,48px);max-width:13ch}
    .flag{background:var(--e-paper)}
    .flag-grid{gap:clamp(52px,8vw,140px)}
    .flag-visual .photo{box-shadow:18px 18px 0 var(--e-blush)}
    .flag h2{font-size:clamp(48px,6vw,92px);max-width:10ch}
    .flag .for{font-size:18px;line-height:1.6}
    .ba{margin-top:44px}
    .ba h3{font-size:clamp(34px,3.2vw,48px)}
    .buy .e-price{font-size:clamp(64px,7vw,100px);line-height:.9}
    .fit-head .e-d2{font-size:clamp(48px,5.8vw,88px);max-width:11ch}
    .fit tbody tr{transition:background .2s}
    .fit tbody tr:not(.hl):hover{background:rgba(255,255,255,.7)}
    .mem-grid .std{margin-top:clamp(16px,3vw,42px);margin-bottom:clamp(16px,3vw,42px)}
    .mem-grid .prm{box-shadow:18px 18px 0 var(--e-blush)}
    .lib-head h2{font-size:clamp(38px,4.8vw,68px);max-width:14ch}
    .shelf{background:var(--e-paper)}
    .shelf a{min-height:300px;padding:26px 24px 28px}
    .shelf h3{font-size:clamp(23px,2.2vw,31px)}
    .letter{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}
    .letter .e-figure{box-shadow:12px 12px 0 var(--e-blush)}
    @media(max-width:900px){
      .cover{min-height:0}
      .cover-photo{margin:0;min-height:0;aspect-ratio:4/3;box-shadow:none}
      .cover-photo img{transform:none}
      .faceless-photo{min-height:0}
      .faceless-copy{padding-left:var(--e-gut)}
      .show-head{grid-template-columns:1fr}
    }
    @media(max-width:620px){
      .cover h1{font-size:clamp(44px,10.5vw,62px);line-height:.94}
      .cover h1 em{margin-left:0}
      .recognition-copy h2{font-size:clamp(42px,12vw,64px)}
      .rooms li:nth-child(1) .room-body h3{font-size:32px}
      .flag h2{font-size:clamp(44px,12vw,62px)}
      .mem-grid .prm{box-shadow:10px 10px 0 var(--e-blush)}
    }

    /* ============ PROOF / PRODUCT · artifact-first treatment ============ */
    .show-head{margin-bottom:clamp(42px,6vw,76px)}
    .show-head>p{font-size:16px;line-height:1.7;max-width:30em;padding-top:14px}
    .room{display:block}
    .room .e-artifact{border:1px solid rgba(26,20,23,.16);box-shadow:0 12px 28px rgba(26,20,23,.06)}
    .room .e-artifact figcaption{display:flex;justify-content:space-between;gap:20px;padding:11px 6px 2px;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--e-ink-3)}
    .room .e-artifact figcaption b{color:var(--e-ink);font-weight:700}
    .room-body p{max-width:36em;line-height:1.65}
    .room-body .go{display:inline-block;margin-top:10px;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
    .flag{overflow:clip}
    .flag-grid{align-items:center}
    .flag-visual{position:relative}
    .flag-visual .photo{margin-left:0}
    .flag-visual .e-artifact{border:1px solid rgba(26,20,23,.18);box-shadow:16px 16px 0 var(--e-blush)}
    .ba{display:grid;grid-template-columns:1fr auto 1fr;gap:clamp(18px,3vw,38px);align-items:center;border-top:1px solid var(--e-ink);border-bottom:1px solid rgba(26,20,23,.2);padding:28px 0;margin:48px 0 30px}
    .ba>div{min-height:150px}
    .ba .arrow{font-family:var(--e-serif);font-size:42px;color:var(--e-pink)}
    .ba .when{display:block;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3);margin-bottom:8px}
    .ba h3{margin:0 0 14px;font-family:var(--e-serif);font-size:clamp(34px,3.4vw,52px);line-height:.95}
    .ba ul{margin:0;padding-left:18px;font-size:14px;line-height:1.65;color:var(--e-ink-2)}
    .evidence{display:flex;flex-wrap:wrap;gap:8px 28px;margin:0 0 30px;padding:0;list-style:none;border-bottom:1px solid rgba(26,20,23,.14);padding-bottom:22px}
    .evidence li{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--e-ink-3)}
    .evidence b{font-family:var(--e-serif);font-size:22px;letter-spacing:0;text-transform:none;color:var(--e-ink);margin-right:5px}
    .buy{display:flex;align-items:end;gap:20px;margin:0 0 24px}
    .buy .e-price{margin:0}
    .buy .terms{margin:0 0 5px;font-size:13px;line-height:1.5;color:var(--e-ink-2)}
    .quote{margin:42px 0 0;padding:26px 0 0;border-top:1px solid rgba(26,20,23,.2)}
    .quote blockquote{font-family:var(--e-serif);font-size:clamp(22px,2.3vw,32px);line-height:1.18;margin:0 0 14px;max-width:28em}
    .quote figcaption{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--e-ink-3)}
    .quote figcaption strong{color:var(--e-ink);margin-right:8px}
    .quote .stars{display:block;margin-top:8px;color:var(--e-gold)}
    @media(max-width:760px){
      .ba{grid-template-columns:1fr;gap:22px}
      .ba .arrow{transform:rotate(90deg);justify-self:center}
      .ba>div{min-height:0}
      .buy{align-items:start}
      .quote{margin-top:30px}
    }

    /* ============ 1 · COVER ============ */
    .cover{position:relative;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);min-height:min(92vh,900px);border-bottom:1px solid rgba(26,20,23,.18)}
    .mast{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut)));border-bottom:1px solid rgba(26,20,23,.14)}
    .mast span{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--e-ink-3)}
    .mast span:first-child{color:var(--e-pink-t)}
    .mast i{flex:1;height:1px;background:rgba(200,169,106,.6)}
    .cover-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(44px,6vw,104px) clamp(20px,4vw,64px) clamp(40px,5vw,80px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut)))}
    .cover .e-kick{margin-bottom:28px}
    .cover h1{font-size:clamp(48px,5vw,76px);line-height:.92;letter-spacing:-.04em;margin:0 0 28px;max-width:11.5ch}
    .cover h1 em{display:block}
    .cover .e-lede{font-size:clamp(17px,1.35vw,19px);max-width:31em;margin-bottom:30px;color:var(--e-ink-2)}
    .cover .e-lede strong{color:var(--e-ink);font-weight:600}
    .cover-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:26px 0 0;padding:20px 0 0;list-style:none;border-top:1px solid rgba(26,20,23,.16);color:var(--e-ink-3)}
    .cover-meta li{max-width:none;text-align:center;padding:0 12px;line-height:1.4}
    .cover-meta li+li{border-left:1px solid rgba(26,20,23,.12)}
    .cover-meta b{display:block;font-family:var(--e-serif);font-weight:600;font-size:26px;line-height:1.1;color:var(--e-ink);margin:0 0 7px;letter-spacing:-.02em}
    .cover-meta span{display:block;font-size:12px;line-height:1.45}
    .cover-photo{position:relative;margin:0;min-height:460px;background:var(--e-paper);overflow:hidden}
    .cover-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:32% 40%}
    .cover-photo figcaption{position:absolute;right:0;top:0;background:var(--e-cream);padding:0 max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) 12px 18px;line-height:1.5}
    .cover-photo figcaption .e-credit{display:block}
    @media(max-width:900px){
      .cover{grid-template-columns:1fr;min-height:0}
      .mast{padding:12px var(--e-gut)}
      .mast span:last-child{display:none}
      .cover-copy{padding:36px var(--e-gut) 40px}
      .cover h1{font-size:clamp(44px,10.5vw,62px);line-height:.94}
      .cover-photo{min-height:0;aspect-ratio:4/3;max-height:640px}
      .cover-photo img{object-position:30% 38%}
      .cover .e-actions .e-btn{width:100%}
      .cover-photo figcaption{display:none}
      .cover-copy{padding-bottom:26px}
      .cover-copy .e-actions{display:flex;flex-direction:column;align-items:stretch;gap:12px}
      .cover-copy .e-actions .e-btn{min-height:48px;padding:13px 16px;font-size:12px;letter-spacing:.09em;border-radius:8px}
      .cover-copy .e-actions .e-link{align-self:center;font-size:14px;font-weight:500;line-height:1.5;text-decoration:none;padding:5px 0}
      .cover-copy .e-actions .e-link:hover{text-decoration:underline;text-underline-offset:4px}
      .cover-meta{margin-top:20px;padding-top:18px}
      .cover-meta li{padding:0 7px}
      .cover-meta span{font-size:11.5px}
    }

    /* ============ 2 · BUILT BACKWARDS: the staircase ============ */
    .method-head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(48px,7vw,96px)}
    .method-head .e-d2{margin:0;font-size:clamp(40px,5.6vw,80px)}
    .forwards{margin:0;font-size:15px;line-height:1.7;color:var(--e-ink-2);padding-left:22px;border-left:1px solid rgba(200,169,106,.7)}
    .forwards .fw{display:block;margin-bottom:10px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3)}
    .forwards s{text-decoration-color:var(--e-pink);text-decoration-thickness:2px}
    .forwards strong{display:block;margin-top:12px;color:var(--e-ink);font-weight:600;font-size:16px}
    .stair{list-style:none;margin:0;padding:0;position:relative;counter-reset:s}
    .stair::before{content:"";position:absolute;left:clamp(14px,2.2vw,30px);top:10px;bottom:10px;width:2px;background:linear-gradient(var(--e-pink),var(--e-pink)) top/2px 100% no-repeat;opacity:.9}
    .step{--i:0;position:relative;display:grid;grid-template-columns:clamp(44px,6vw,84px) minmax(0,1fr) minmax(0,.5fr);gap:clamp(12px,2.4vw,40px);align-items:end;padding:clamp(16px,2.2vw,28px) 0;border-bottom:1px solid rgba(26,20,23,.14)}
    .step:first-child{border-top:1px solid var(--e-ink)}
    .step .dot{position:relative;z-index:1;align-self:center;justify-self:start;margin-left:calc(clamp(14px,2.2vw,30px) - 7px);width:16px;height:16px;border-radius:50%;background:var(--e-cream);border:2px solid var(--e-pink)}
    .step:first-child .dot{background:var(--e-pink)}
    .step h3{padding-left:calc(var(--i) * clamp(0px,3vw,44px));font-size:clamp(44px,6.6vw,96px);line-height:.86;letter-spacing:-.05em;margin:0;color:var(--e-ink);white-space:nowrap;overflow-wrap:normal;word-break:keep-all}
    .step h3 .ord{display:block;font-family:var(--e-sans);font-size:11.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:10px}
    .step:first-child h3{color:var(--e-pink)}
    .step p{margin:0;font-size:15.5px;line-height:1.6;color:var(--e-ink-2);padding-bottom:6px}
    .step p b{display:block;margin-top:8px;font-weight:600;color:var(--e-ink)}
    .scale{display:grid;grid-template-columns:clamp(44px,6vw,84px) minmax(0,1fr);gap:clamp(12px,2.4vw,40px);align-items:center;padding-top:26px}
    .scale .dot{margin-left:calc(clamp(14px,2.2vw,30px) - 7px);width:16px;height:16px;border-radius:50%;background:var(--e-ink)}
    .scale p{margin:0;display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:10px 32px}
    .scale .tl{font-family:var(--e-serif);font-weight:600;font-size:clamp(22px,2.4vw,32px);letter-spacing:-.02em;color:var(--e-ink)}
    .scale .ai{font-size:15px;color:var(--e-ink-2)}
    .scale .ai b{color:var(--e-ink);font-weight:600}
    /* The order builds as you scroll: each word sets in from outline to solid. */
    @media (prefers-reduced-motion:no-preference){
      @supports (animation-timeline:view()) and (-webkit-text-stroke:1px black){
        .step h3 .w{-webkit-text-stroke:1.5px currentColor;animation:set-in linear both;animation-timeline:var(--e-tl);animation-range:entry 30% cover 45%}
        @keyframes set-in{from{-webkit-text-fill-color:transparent;transform:translateX(-18px)}to{-webkit-text-fill-color:currentColor;transform:none}}
        .stair::before{animation:draw linear both;animation-timeline:var(--e-tl);animation-range:entry 20% exit 60%;transform-origin:top}
        @keyframes draw{from{transform:scaleY(.04)}to{transform:scaleY(1)}}
      }
    }
    @media(max-width:760px){
      .method-head{grid-template-columns:1fr}
      .step{grid-template-columns:40px minmax(0,1fr);align-items:start}
      .step p{grid-column:2}
      .step h3{font-size:min(12.6vw,64px);padding-left:calc(var(--i) * 3.2vw)}
      .stair::before{left:19px}
      .step .dot,.scale .dot{margin-left:12px;margin-top:18px;align-self:start}
      .scale{grid-template-columns:40px minmax(0,1fr)}
    }

    /* ============ 3 · RECOGNITION: the human pause ============ */
    .recognition{padding:clamp(76px,10vw,150px) 0;background:var(--e-cream);border-top:1px solid rgba(26,20,23,.12);border-bottom:1px solid rgba(26,20,23,.12)}
    .recognition-inner{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1.3fr);gap:clamp(32px,7vw,110px);align-items:start}
    .recognition-kicker{padding-top:10px}
    .recognition-kicker .e-kick{margin:0}
    .recognition-copy{max-width:900px}
    .recognition-copy h2{font-size:clamp(40px,6vw,88px);line-height:.94;letter-spacing:-.045em;margin:0 0 34px}
    .recognition-copy h2 em{color:var(--e-pink)}
    .recognition-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--e-ink)}
    .recognition-list li{padding:18px 0;border-bottom:1px solid rgba(26,20,23,.15);font-family:var(--e-serif);font-weight:600;font-size:clamp(21px,2vw,30px);line-height:1.18}
    .recognition-list li::before{content:"“";color:var(--e-pink);margin-right:5px}
    .recognition-note{margin:26px 0 0;font-size:15px;line-height:1.65;color:var(--e-ink-2);max-width:40em}
    @media(max-width:760px){.recognition-inner{grid-template-columns:1fr;gap:20px}.recognition-copy h2{margin-bottom:26px}}

    /* ============ 4 · FACELESS: the one dark moment ============ */
    .faceless{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);background:var(--e-ink);color:#F6EFEA}
    .faceless-photo{position:relative;margin:0;min-height:600px;overflow:hidden}
    .faceless-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}
    .faceless-photo figcaption{position:absolute;left:0;top:0;background:var(--e-ink);padding:0 18px 12px 0;max-width:80%}
    .faceless-photo figcaption .e-credit{color:rgba(246,239,234,.72)}
    .faceless-photo figcaption .e-credit b{color:var(--e-bubble)}
    .faceless-copy{padding:clamp(64px,9vw,128px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) clamp(64px,9vw,128px) clamp(28px,5vw,88px);display:flex;flex-direction:column;justify-content:center}
    .faceless .e-kick{color:var(--e-bubble)}
    .faceless h2{font-size:clamp(44px,5.8vw,88px);line-height:.94;letter-spacing:-.04em;margin:0 0 26px;color:#fff}
    .faceless h2 em{color:var(--e-bubble)}
    .faceless .e-lede{color:rgba(246,239,234,.8);margin-bottom:44px;max-width:30em}
    .refuse-h{font-family:var(--e-sans);font-size:11.5px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:rgba(246,239,234,.6);margin:0 0 8px}
    .refuse{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.22)}
    .refuse li{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:20px;padding:17px 0;border-bottom:1px solid rgba(255,255,255,.14)}
    .refuse strong{font-family:var(--e-serif);font-weight:600;font-size:21px;line-height:1.2;color:#fff}
    .refuse span{font-size:14.5px;line-height:1.55;color:rgba(246,239,234,.74)}
    @media(max-width:900px){
      .faceless{grid-template-columns:1fr}
      .faceless-photo{min-height:0;aspect-ratio:4/3}
      .faceless-copy{padding:52px var(--e-gut) 60px}
      .refuse li{grid-template-columns:1fr;gap:4px}
    }

    /* ============ 4 · THE SHOWROOM: exhibits ============ */
    .show-head{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(40px,6vw,72px)}
    .show-head .e-d2{margin:0}
    .show-head p{margin:0;color:var(--e-ink-2);font-size:16.5px;max-width:30em}
    .rooms{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:clamp(28px,3vw,44px) clamp(18px,2.2vw,32px)}
    .rooms li{grid-column:span 2;min-width:0}
    .rooms li:nth-child(1){grid-column:span 4;grid-row:span 2}
    .rooms li:nth-child(5){transform:translateY(clamp(0px,2.4vw,36px))}
    .room{display:flex;flex-direction:column;height:100%}
    .room .e-artifact figcaption{flex-direction:column;gap:2px}
    .room .e-artifact figcaption span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
    .rooms li:nth-child(1) .e-artifact figcaption{flex-direction:row}
    .room .e-art-img img{aspect-ratio:16/10;object-fit:cover;object-position:top center}
    .rooms li:nth-child(1) .e-art-img img{aspect-ratio:16/11}
    .room-body{padding:16px 2px 0;display:flex;flex-direction:column}
    .room-body h3{font-size:22px;line-height:1.15;margin:0 0 6px;transition:color .2s}
    .rooms li:nth-child(1) .room-body h3{font-size:clamp(28px,2.8vw,38px)}
    .room-body p{font-size:15px;line-height:1.55;color:var(--e-ink-2);margin:0 0 10px;max-width:34em}
    .room-body .go{font-size:13.5px;font-weight:700;color:var(--e-pink-t);display:inline-flex;gap:6px;align-items:center}
    .room-body .go .ar{transition:transform .25s}
    .room:hover h3{color:var(--e-pink-t)}
    .room:hover .go .ar{transform:translateX(4px)}
    @media(max-width:1020px){.rooms{grid-template-columns:repeat(2,minmax(0,1fr))}.rooms li,.rooms li:nth-child(1){grid-column:span 1;grid-row:auto}.rooms li:nth-child(1){grid-column:1/-1}.rooms li:nth-child(5){transform:none}}
    @media(max-width:620px){.rooms{grid-template-columns:minmax(0,1fr)}.show-head{grid-template-columns:1fr}}

    /* ============ 5 · THE FLAGSHIP: product editorial ============ */
    .flag{background:var(--e-white);border-top:1px solid var(--e-line);border-bottom:1px solid var(--e-line);overflow:hidden}
    .flag-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(40px,6vw,104px);align-items:start}
    .flag-visual{position:relative;padding-bottom:clamp(90px,11vw,170px)}
    .flag-visual .photo{margin:0;aspect-ratio:4/5;overflow:hidden;background:var(--e-paper)}
    .flag-visual .photo img{width:100%;height:100%;object-fit:cover;object-position:50% 40%}
    .flag-visual .e-artifact{position:absolute;right:clamp(-82px,-6vw,-18px);bottom:0;width:min(72%,460px)}
    .flag-visual .credit{margin:14px 0 0;max-width:36%}
    .flag h2{font-size:clamp(40px,5vw,72px);line-height:.98;letter-spacing:-.04em;margin:0 0 22px}
    .flag .for{font-size:17px;color:var(--e-ink-2);margin:0 0 36px;max-width:32em}
    .flag .for strong{color:var(--e-ink);font-weight:600}
    .ba{display:grid;grid-template-columns:1fr auto 1fr;gap:clamp(12px,2vw,28px);align-items:start;margin:0 0 36px;padding:26px 0;border-top:1px solid var(--e-ink);border-bottom:1px solid rgba(26,20,23,.16)}
    .ba h3{font-size:clamp(28px,2.6vw,36px);line-height:1;margin:0 0 4px}
    .ba .when{display:block;font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3);margin-bottom:14px}
    .ba > div + div + div h3{color:var(--e-pink)}
    .ba .arrow{align-self:center;font-family:var(--e-serif);font-size:40px;color:var(--e-pink);line-height:1}
    .ba ul{list-style:none;margin:0;padding:0;display:grid;gap:8px;font-size:15px;line-height:1.45;color:var(--e-ink-2)}
    .evidence{display:flex;flex-wrap:wrap;gap:6px 22px;margin:0 0 34px;padding:0;list-style:none;font-size:13px;color:var(--e-ink-3)}
    .evidence b{font-family:var(--e-serif);font-weight:600;font-size:20px;color:var(--e-ink);margin-right:5px}
    .buy{display:flex;flex-wrap:wrap;align-items:center;gap:18px 28px;margin:0 0 30px}
    .buy .e-price{font-size:clamp(56px,5.6vw,80px);color:var(--e-pink);margin:0}
    .buy .terms{font-size:14.5px;line-height:1.5;color:var(--e-ink-2);margin:0}
    .buy .terms b{color:var(--e-ink);font-weight:600}
    .quote{margin:36px 0 0;padding:28px 0 0;border-top:1px solid rgba(200,169,106,.6)}
    .quote blockquote{margin:0 0 14px;font-family:var(--e-serif);font-weight:600;font-size:clamp(19px,1.7vw,22px);line-height:1.45;color:var(--e-ink)}
    .quote blockquote::before{content:"“";color:var(--e-pink);margin-right:2px}
    .quote blockquote::after{content:"”";color:var(--e-pink)}
    .quote figcaption{font-size:13.5px;color:var(--e-ink-2)}
    .quote figcaption strong{color:var(--e-ink);font-weight:600;margin-right:10px}
    .quote .stars{color:var(--e-pink);letter-spacing:3px;margin-left:10px}
    @media(max-width:900px){.flag-grid{grid-template-columns:1fr}.flag-visual{max-width:560px}.flag-visual .e-artifact{right:-6px;width:70%}.flag-visual .credit{display:none}.flag-visual{padding-bottom:110px}.buy .e-btn,.flag .e-actions .e-btn{width:100%}}
    @media(max-width:520px){.ba{grid-template-columns:1fr}.ba .arrow{transform:rotate(90deg);justify-self:start}}

    /* ============ 6 · FIT: where to start ============ */
    .fit-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:end;margin-bottom:clamp(32px,5vw,56px)}
    .fit-head .e-d2{margin:0}
    .fit-head p{margin:0;color:var(--e-ink-2)}
    .fit{width:100%;border-collapse:collapse;text-align:left}
    .fit th,.fit td{padding:22px 18px;border-bottom:1px solid rgba(26,20,23,.14);vertical-align:top}
    .fit thead th{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3);border-bottom:1px solid var(--e-ink);padding-top:0}
    .fit tbody th{font-family:var(--e-serif);font-weight:600;font-size:clamp(20px,1.9vw,25px);line-height:1.2;color:var(--e-ink);width:30%}
    .fit td{font-size:15.5px;line-height:1.55;color:var(--e-ink-2)}
    .fit .p{font-family:var(--e-serif);font-weight:600;font-size:24px;color:var(--e-ink);white-space:nowrap}
    .fit .p small{display:block;font-family:var(--e-sans);font-size:12.5px;font-weight:500;color:var(--e-ink-3);white-space:normal;margin-top:4px}
    .fit tr.hl th,.fit tr.hl td{background:var(--e-blush)}
    .fit a{font-weight:700;color:var(--e-pink-t);text-decoration:underline;text-underline-offset:4px;text-decoration-color:rgba(184,36,95,.4);display:inline-flex;min-height:44px;align-items:center}
    @media(max-width:760px){
      .fit-head{grid-template-columns:1fr}
      .fit thead{display:none}
      .fit,.fit tbody,.fit tr,.fit th,.fit td{display:block;width:100%}
      .fit tr{border-bottom:1px solid rgba(26,20,23,.18);padding:18px 0}
      .fit th,.fit td{border:0;padding:4px 14px}
      .fit tbody th{width:auto;font-size:22px;padding-bottom:8px}
      .fit tr.hl{background:var(--e-blush)}
      .fit tr.hl th,.fit tr.hl td{background:transparent}
    }

    /* ============ 7 · MEMBERSHIP: two rooms, visibly different ============ */
    .mem-head{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:24px 64px;align-items:end;margin-bottom:clamp(32px,5vw,52px)}
    .mem-head .e-d2{margin:0}
    .mem-head p{margin:0;color:var(--e-ink-2)}
    .mem-grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);align-items:stretch}
    .mem-grid article{padding:clamp(30px,3.6vw,52px);display:flex;flex-direction:column}
    .mem-grid .std{background:var(--e-white);border:1px solid rgba(26,20,23,.16);border-right:0;margin:clamp(0px,2.4vw,32px) 0}
    .mem-grid .prm{background:var(--e-ink);color:#F6EFEA}
    .mem-grid .who{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 14px}
    .mem-grid .prm .who{color:var(--e-bubble)}
    .mem-grid h3{font-size:clamp(34px,3.4vw,50px);line-height:1;letter-spacing:-.035em;margin:0 0 10px}
    .mem-grid .prm h3{color:#fff}
    .mem-grid .prm h3 em{color:var(--e-bubble)}
    .mem-grid .name{font-size:14px;color:var(--e-ink-2);margin:0 0 24px}
    .mem-grid .prm .name{color:rgba(246,239,234,.72)}
    .mem-grid .e-price{font-size:48px;color:var(--e-pink);margin:0}
    .mem-grid .prm .e-price{color:#fff}
    .mem-grid .e-price small{font-family:var(--e-sans);font-size:15px;font-weight:600;color:var(--e-ink-2);letter-spacing:0}
    .mem-grid .prm .e-price small{color:rgba(246,239,234,.72)}
    .mem-grid .alt{font-size:14px;color:var(--e-ink-2);margin:8px 0 24px}
    .mem-grid .prm .alt{color:rgba(246,239,234,.72)}
    .mem-grid .e-list{margin:0 0 30px;font-size:15px;color:var(--e-ink-2)}
    .mem-grid .prm .e-list{color:rgba(246,239,234,.86)}
    .mem-grid .prm .e-list li::before{background:var(--e-bubble)}
    .mem-grid .e-btn{margin-top:auto;align-self:flex-start}
    @media(max-width:780px){.mem-head{grid-template-columns:1fr}.mem-grid{grid-template-columns:1fr}.mem-grid .std{border-right:1px solid rgba(26,20,23,.16);border-bottom:0;margin:0}.mem-grid .e-btn{width:100%}}

    /* ============ 8 · LIBRARY + 9 · LETTER: quiet ============ */
    .lib-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:12px 32px;margin-bottom:28px}
    .lib-head h2{font-size:clamp(30px,3.4vw,44px);line-height:1.05;margin:0;max-width:18ch}
    .shelf{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--e-ink)}
    .shelf li + li{border-left:1px solid rgba(26,20,23,.14)}
    .shelf a{display:flex;flex-direction:column;height:100%;padding:22px 20px 24px;transition:background .2s}
    .shelf a:hover{background:var(--e-white)}
    .shelf .n{font-family:var(--e-serif);font-weight:600;font-size:15px;color:var(--e-pink-t);margin-bottom:18px}
    .shelf .cat{font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3);margin-bottom:8px}
    .shelf h3{font-size:21px;line-height:1.22;margin:0 0 14px;flex:1}
    .shelf .rd{font-size:13px;color:var(--e-ink-3)}
    @media(max-width:900px){.shelf{grid-template-columns:1fr 1fr}.shelf li:nth-child(3){border-left:0}.shelf li:nth-child(n+3){border-top:1px solid rgba(26,20,23,.14)}}
    @media(max-width:520px){.shelf{grid-template-columns:1fr}.shelf li + li{border-left:0;border-top:1px solid rgba(26,20,23,.14)}}
    .letter{display:grid;grid-template-columns:minmax(0,.75fr) minmax(0,1.25fr);gap:clamp(28px,6vw,96px);align-items:center}
    .letter .e-figure{aspect-ratio:4/5;max-height:560px}
    .letter :global(.freebie-capture){margin:18px 0 0;padding:0;border:0;background:transparent}
    .letter :global(.fc-h){font-family:var(--e-serif);font-weight:600;font-size:clamp(34px,4.2vw,56px);line-height:1;letter-spacing:-.035em;color:var(--e-ink);margin:0 0 14px}
    .letter :global(.fc-sub){font-size:16px;color:var(--e-ink-2);margin:0 0 22px;max-width:32em}
    .letter :global(.fc-row input){min-height:52px;border-radius:999px;border:1px solid rgba(26,20,23,.3);padding:14px 22px;font-size:16px;background:#fff}
    .letter :global(.fc-row button){min-height:52px;border-radius:999px;background:var(--e-pink);font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:14px 28px}
    .letter :global(.fc-row button:hover){background:var(--e-pink-t)}
    .letter :global(.fc-done){font-family:var(--e-serif);font-weight:600;font-style:normal}
    @media(max-width:820px){.letter{grid-template-columns:1fr}.letter .e-figure{aspect-ratio:3/2}.letter :global(.fc-row button){width:100%}}

    @media(prefers-reduced-motion:reduce){.shelf a,.room-body h3,.room-body .go .ar{transition:none}}
    /* ============ HOMEPAGE CONVERSION PASS · 28 Sep 2026 ============ */
  .cover-copy .e-actions{gap:14px 20px}
  .recognition{position:relative}
  .recognition::before{content:"YOU ARE NOT BEHIND";display:block;margin-bottom:22px;font:700 10px/1 Inter,sans-serif;letter-spacing:.2em;color:var(--e-pink-t)}
  .recognition-list{border-top:1px solid rgba(26,20,23,.2)}
  .recognition-list li{display:flex;gap:18px;align-items:baseline}
  .recognition-list li::before{content:"↳";font-family:Newsreader,Georgia,serif;font-size:28px;color:var(--e-pink);flex:none}
  .flag .e-actions{margin-top:28px}
  .fit{scroll-margin-top:90px}
  .mem-grid .std,.mem-grid .prm{transition:transform .25s ease}
  .mem-grid .std:hover,.mem-grid .prm:hover{transform:translateY(-3px)}
  @media(max-width:620px){
    .cover-copy .e-actions{align-items:stretch}
    .recognition-list li{gap:12px}
  }
  .tdie-manifesto{max-width:1180px;margin:0 auto;padding:clamp(72px,9vw,132px) 24px clamp(58px,7vw,96px);display:grid;grid-template-columns:1fr 2fr;border-top:1px solid rgba(26,20,23,.16)}
  .tdie-manifesto-kicker{font:700 10px/1.35 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:var(--e-pink-t);max-width:170px}
  .tdie-manifesto p{margin:0;font:600 clamp(42px,6vw,88px)/.9 Newsreader,Georgia,serif;letter-spacing:-.035em}
  .tdie-manifesto em{font-style:italic;color:var(--e-pink)}
  @media(max-width:700px){.tdie-manifesto{display:block;padding-top:72px}.tdie-manifesto-kicker{display:block;margin-bottom:28px}.tdie-manifesto p{font-size:clamp(48px,14vw,70px)}}
</style>
</head>
<body class="e-page sales-page">
  <SiteNav />

  <main>
    <!-- 1 · HOOK: the cover -->
    <section class="cover" aria-labelledby="hero-h">
      <div class="mast" aria-hidden="true"><span>The New Faceless</span><i></i><span>Build Your Business Backwards. Scale It Forward.™</span></div>
      <div class="cover-copy">
        <p class="e-kick">For women building without a personal brand</p>
        <h1 id="hero-h">Build a faceless business. <em>Keep your life off camera.</em></h1>
        <p class="e-lede"><strong>A product to sell. A website to send people to. Emails and content that connect the two.</strong> Build them in that order, with AI helping with the work and your real face never required.</p>
        <div class="e-actions">
          <a class="e-btn" href="/resources/faceless-income-blueprint">Get the free Blueprint <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href={WE.preview}>Preview the $97 website course</a>
        </div>
        <ul class="cover-meta" aria-label="The business, by the numbers">
          <li><b>{community.members}</b><span>women<br />building inside</span></li>
          <li><b>{WE.modules}</b><span>course<br />modules</span></li>
          <li><b>{library.guides}</b><span>free guides<br />to get started</span></li>
        </ul>
      </div>
      <figure class="cover-photo">
        <img src="/images/home/hero-pink-knit-desk-720.webp"
             srcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
             sizes="(max-width: 900px) 100vw, 44vw" width="480" height="596" fetchpriority="high" decoding="async"
             alt="Tommy Kate, the brand's AI persona, in an oversized pink knit sweater, sipping a glitter pink iced coffee at a cream farmhouse desk, her laptop open beside sticky notes and wildflowers, an open window onto the garden behind her." />
        <figcaption><span class="e-credit"><b>On the cover</b> · Tommy Kate, the brand's AI persona</span></figcaption>
      </figure>
    </section>

    <!-- 2 · DIFFERENTIATION + METHOD: the staircase -->
    <section class="e-sec" id="method" aria-labelledby="method-h">
      <div class="e-wrap">
        <div class="method-head">
          <div>
            <p class="e-kick">The signature method</p>
            <h2 class="e-d2" id="method-h">Built Backwards. <em>The order is the method.</em></h2>
          </div>
          <p class="forwards">
            <span class="fw">How most people build it</span>
            <s>Audience</s>, then <s>automation</s>, then <s>funnel</s>, then <s>offer</s>. That is how you end up with followers and no business.
            <strong>You are not learning four topics. You are learning the sequence.</strong>
          </p>
        </div>
        <ol class="stair">
          {method.map((m, i) => (
            <li class="step" style={`--i:${i}`}>
              <span class="dot" aria-hidden="true"></span>
              <h3><span class="ord">{m.n} · {["First", "Second", "Third", "Last"][i]}</span><span class="w">{m.name}</span></h3>
              <p>{m.line}<b>{m.out}</b></p>
            </li>
          ))}
        </ol>
        <div class="scale">
          <span class="dot" aria-hidden="true"></span>
          <p><span class="tl">Build Your Business Backwards. Scale It Forward.™</span><span class="ai"><b>AI + architecture.</b> AI is the build team. The architecture is what makes it a business.</span></p>
        </div>
      </div>
    </section>

    <!-- 3 · THE HUMAN RECOGNITION MOMENT -->
    <div class="tdie-manifesto" aria-label="TDIE brand philosophy">
  <span class="tdie-manifesto-kicker">A note from the woman with too many tabs open</span>
  <p>Organized business.<br /><em>Unfiltered human.</em></p>
</div>

<section class="recognition" aria-labelledby="recognition-h">
      <div class="e-wrap recognition-inner">
        <div class="recognition-kicker">
          <p class="e-kick">If this sounds familiar</p>
        </div>
        <div class="recognition-copy">
          <h2 id="recognition-h">You don't need another pile of ideas. <em>You need the next useful move.</em></h2>
          <ul class="recognition-list">
            <li>You've saved 47 videos about digital products and still haven't built one.</li>
            <li>You know AI can do more, but everything you've found feels like another pile of prompts.</li>
            <li>You don't want to become an influencer just to make money online.</li>
            <li>You have ideas, products, content and tools — but nothing connects them.</li>
          </ul>
          <p class="recognition-note">TDIE starts with the part most online-business advice skips: deciding what the business actually is. Then we build the pieces around it.</p>
        </div>
      </div>
    </section>

    <!-- 4 · THE FACELESS MOMENT -->
    <section class="faceless" aria-labelledby="faceless-h">
      <figure class="faceless-photo">
        <img class="e-unveil" src="/images/home/machine-flatlay-1116.webp"
             srcset="/images/home/machine-flatlay-800.webp 800w, /images/home/machine-flatlay-1116.webp 1116w"
             sizes="(max-width: 900px) 100vw, 52vw" width="1116" height="744" loading="lazy" decoding="async"
             alt="A real-world editorial flat lay of the business system: notebook pages, a laptop, printed planning materials and tactile desk objects arranged on a warm cream workspace." />
        <figcaption><span class="e-credit"><b>The business</b> · not the personality</span></figcaption>
      </figure>
      <div class="faceless-copy">
        <p class="e-kick">The New Faceless</p>
        <h2 id="faceless-h">Faceless doesn't mean <em>nobody's there.</em></h2>
        <p class="e-lede">It means your real face is never required. The business is built first, the brand's face is an AI persona, and everything you need to trust is on the page, open to inspect.</p>
        <p class="refuse-h">What we do differently</p>
        <ul class="refuse">
          {differences.map((r) => <li><strong>{r.t}</strong><span>{r.p}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- 4 · PROOF: the showroom -->
    <section class="e-sec showroom" id="showroom" aria-labelledby="show-h">
      <div class="e-wrap">
        <div class="show-head">
          <div>
            <p class="e-kick">Real pages. Real outputs. Open the evidence.</p>
            <h2 class="e-d2" id="show-h">Don't take our word for it. <em>Look inside.</em></h2>
          </div>
          <p>The website is the case study. These are real pages, real workflows and real outputs from the business itself. Open anything that interests you.</p>
        </div>
        <ul class="rooms">
          {rooms.map((r, i) => (
            <li>
              <a class="room e-reveal" href={r.href}>
                <figure class="e-artifact">
                  <div class="e-art-img">
                    <img src={`/images/home/room-${r.key}-${i === 0 ? 1100 : 640}.webp`} width={i === 0 ? 1100 : 640} height={i === 0 ? 756 : 400}
                         loading="lazy" decoding="async" alt={`The live ${r.t} page on this site, as it looks today.`} />
                  </div>
                  <figcaption><b>Exhibit {String(i + 1).padStart(2, "0")} · {r.room}</b><span>{r.path}</span></figcaption>
                </figure>
                <span class="room-body">
                  <h3>{r.t}</h3>
                  <p>{r.p}</p>
                  <span class="go">{r.go} <span class="ar" aria-hidden="true">→</span></span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5 · THE FLAGSHIP OFFER -->
    <section class="e-sec flag" id="weekend-ecosystem" aria-labelledby="flag-h">
      <div class="e-wrap flag-grid">
        <div class="flag-visual">
          <figure class="photo">
            <img class="e-unveil" src="/images/home/flagship-attic-900.webp"
                 srcset="/images/home/flagship-attic-560.webp 560w, /images/home/flagship-attic-900.webp 900w, /images/home/flagship-attic-1200.webp 1200w"
                 sizes="(max-width: 900px) 100vw, 46vw" width="900" height="1117" loading="lazy" decoding="async"
                 alt="Tommy Kate, the brand's AI persona, laughing in a pink gaming chair in a farmhouse attic loft, a glitter pink tumbler in her hand and her laptop open on the desk." />
          </figure>
          <figure class="e-artifact">
            <div class="e-art-img">
              <img src="/images/home/flagship-module-760.webp" srcset="/images/home/flagship-module-440.webp 440w, /images/home/flagship-module-760.webp 760w"
                   sizes="(max-width: 900px) 72vw, 440px" width="760" height="559" loading="lazy" decoding="async"
                   alt="A real module from the course: Phase 1, Module 5 of 22, Claude Builds the Repo, with the scaffold prompt ready to copy." />
            </div>
            <figcaption><b>The real interface</b><span>Module 5 of {WE.modules}</span></figcaption>
          </figure>
          <p class="credit e-credit"><b>Saturday afternoon</b> · Tommy Kate, mid-build</p>
        </div>
        <div>
          <p class="e-kick">The flagship · {WE.name}</p>
          <h2 id="flag-h">Your content, turned into <em>a website you own.</em></h2>
          <p class="for"><strong>For you if</strong> your best writing is sitting in a Skool group, a notes app or a feed you don't own, and you want it working for you on a domain that is yours.</p>
          <div class="ba">
            <div>
              <span class="when">You walk in with</span>
              <h3>Friday.</h3>
              <ul><li>Posts and lessons you already wrote</li><li>No website, or one you avoid</li><li>A list that isn't growing</li></ul>
            </div>
            <span class="arrow" aria-hidden="true">→</span>
            <div>
              <span class="when">You walk out with</span>
              <h3>Sunday.</h3>
              <ul><li>A live site and blog on your own domain</li><li>Email capture and your offer, wired in</li><li>One prompt that turns each article into {WE.assetsPerArticle} assets</li></ul>
            </div>
          </div>
          <ul class="evidence" aria-label="What's inside">
            <li><b>{WE.modules}</b>modules, delivered as a website</li>
            <li><b>{WE.prompts}</b>prompts, written out in full</li>
            <li><b>Free</b>every future update</li>
          </ul>
          <div class="buy">
            <p class="e-price">{WE.price}</p>
            <p class="terms"><b>One payment, or {WE.plan}.</b><br />Yours for good, updates included.</p>
          </div>
          <div class="e-actions">
            <a class="e-btn" href={WE.url}>Build my site this weekend <span class="ar" aria-hidden="true">→</span></a>
            <a class="e-link" href={WE.preview}>See inside first, no email</a>
          </div>
          <figure class="quote">
            <blockquote>{tina.quote}</blockquote>
            <figcaption><strong>{tina.name}</strong>Skool review · public<span class="stars" role="img" aria-label={`${tina.stars} out of 5 stars`}>{"★".repeat(tina.stars)}</span></figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- 6 · FIT: where to start -->
    <section class="e-sec" id="start" aria-labelledby="fit-h">
      <div class="e-wrap">
        <div class="fit-head">
          <div>
            <p class="e-kick">Where to start</p>
            <h2 class="e-d2" id="fit-h">Where are you stuck? <em>Start there.</em></h2>
          </div>
          <p>You don't need to know which product you need yet. Find the part that's holding you up, then take the next useful step.</p>
        </div>
        <table class="fit">
          <caption style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Where to start with The Digital Income Edit™</caption>
          <thead><tr><th scope="col">If you are</th><th scope="col">Start with</th><th scope="col">It costs</th><th scope="col"><span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Go</span></th></tr></thead>
          <tbody>
            <tr>
              <th scope="row">I don't know what to sell.</th>
              <td>Start with The Faceless Income Blueprint™ to work through the niche, first product and traffic plan. Still unsure? <a href="/resources/find-your-door">Find your door</a>, free, no email.</td>
              <td><span class="p">Free<small>download</small></span></td>
              <td><a href="/resources/faceless-income-blueprint">Get the Blueprint</a></td>
            </tr>
            <tr class="hl">
              <th scope="row">I know what I want to sell, but nobody finds me.</th>
              <td>Start with the method, then build the home base: {WE.name} turns what you've already written into a website, blog, email capture and offer routing.</td>
              <td><span class="p">{WE.price}<small>or {WE.plan}</small></span></td>
              <td><a href={WE.url}>Build my weekend</a></td>
            </tr>
            <tr>
              <th scope="row">People find me, but my business isn't connected.</th>
              <td>Use the membership to build the missing pieces around what you already have. Standard gives you the system; Premium removes more of the recurring content work.</td>
              <td><span class="p">{M.standard.perMonth}<small>Premium {M.premium.perMonth} · {M.trial}</small></span></td>
              <td><a href="#membership">Compare memberships</a></td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- 7 · MEMBERSHIP -->
    <section class="e-sec e-paper" id="membership" aria-labelledby="mem-h">
      <div class="e-wrap">
        <div class="mem-head">
          <div>
            <p class="e-kick">The membership</p>
            <h2 class="e-d2" id="mem-h">Build it yourself. <em>Or remove more of the work.</em></h2>
          </div>
          <p>Both memberships give you the system and the community. Premium changes the workload: more of the recurring content gets handled before it reaches your desk.</p>
        </div>
        <div class="mem-grid">
          <article class="std">
            <p class="who">{M.standard.short}</p>
            <h3>You build it.</h3>
            <p class="name">{M.standard.name}: foundations, AI, branding, content and traffic training, with a community beside you.</p>
            <p class="e-price">{M.standard.monthly}<small>/month</small></p>
            <p class="alt">or {M.standard.perYear} · {M.trial}</p>
            <ul class="e-list">
              <li>The Essentials Edit, AI Foundations for Creators and Canva Crash Course</li>
              <li>Pinterest Foundations™, The Email Edit and The Shopify Edit</li>
              <li>Daily Prompts and the community, every day</li>
              <li>The Value Vault guides, bought à la carte</li>
            </ul>
            <a class="e-btn" href={SKOOL_PLANS}>Start Standard free <span class="ar" aria-hidden="true">→</span></a>
          </article>
          <article class="prm">
            <p class="who">{M.premium.short}</p>
            <h3>It's written <em>for you.</em></h3>
            <p class="name">{M.premium.name}: everything in Standard, with your content month written before you sit down.</p>
            <p class="e-price">{M.premium.monthly}<small>/month</small></p>
            <p class="alt">or {M.premium.perYear} · {M.trial}</p>
            <ul class="e-list">
              <li>A done-for-you content calendar, every month</li>
              <li>The Offer Edit, The Funnel Edit and Scaling &amp; Systems</li>
              <li>The Ads Edit™</li>
              <li>The Premium Vault: every Value Vault guide, already unlocked</li>
            </ul>
            <a class="e-btn e-btn--light" href={SKOOL_PLANS}>Start Premium free <span class="ar" aria-hidden="true">→</span></a>
          </article>
        </div>
        <p style="margin:24px 0 0"><a class="e-link" href="/membership">Compare the two memberships in full <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <!-- 8 · DEEPER CONTENT -->
    <section class="e-sec" aria-labelledby="lib-h">
      <div class="e-wrap">
        <div class="lib-head">
          <div>
            <p class="e-kick">The library</p>
            <h2 id="lib-h">{cap(library.guidesWord)} pillar guides, free. <em>Start with these four.</em></h2>
          </div>
          <a class="e-link" href="/learn">Explore the Library <span aria-hidden="true">→</span></a>
        </div>
        <ul class="shelf">
          {guides.map((g, i) => (
            <li>
              <a href={`/learn/${g.slug}`}>
                <span class="n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <span class="cat">{g.cat}</span>
                <h3>{g.t}</h3>
                <span class="rd">{g.read} read</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 9 · EMAIL -->
    <section class="e-sec e-white" style="border-top:1px solid var(--e-line)" aria-label="The Weekly Edit newsletter">
      <div class="e-wrap letter">
        <div class="e-figure">
          <img class="e-unveil" src="/images/home/sunday-journal-640.webp" srcset="/images/home/sunday-journal-640.webp 640w, /images/home/sunday-journal-1100.webp 1100w"
               sizes="(max-width: 820px) 100vw, 36vw" width="640" height="794" loading="lazy" decoding="async"
               alt="Hands writing in a cream journal at a sunlit desk, a pink folder, a gold pen and a small vase of blush flowers beside it." />
        </div>
        <div>
          <p class="e-kick">The Weekly Edit · every Sunday</p>
          <FreebieForm
            heading="One idea you can build with before Monday."
            button="Send me The Weekly Edit"
            sub="Offers, funnels, automation and the AI underneath them, written for women building quietly. One letter a week."
            done="You're in. Your first Weekly Edit arrives on Sunday." />
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</body>
</html>
