<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>The Digital Income Edit™ — Build a Faceless Digital Business</title>
  <meta name="description" content="The Digital Income Edit™ is an editorial library for women building faceless digital income — twelve complete guides on Pinterest, AI, digital products, email, blogging and automation." />
  <link rel="canonical" href="https://www.thedigitalincomeedit.com/" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="The Digital Income Edit™" />
  <meta property="og:description" content="Build a business you're obsessed with — online, on your terms." />
  <meta property="og:url" content="https://www.thedigitalincomeedit.com/" />
  <meta property="og:image" content="https://www.thedigitalincomeedit.com/images/library/hero-office-wide-02.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;0,9..144,500&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <style>
    /* ── Weekend Ecosystem band ── */
    .we-band{max-width:var(--wide);margin:0 auto;padding:0 40px 8px}
    .we-band-row{display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap}
    .we-band-badge{display:inline-flex;align-items:center;gap:6px;background:#D62E73;color:#FBF8F5;
                   font-size:10.5px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;
                   padding:6px 13px 6px 12px;border-radius:100px;line-height:1;white-space:nowrap;
                   box-shadow:0 0 0 0 rgba(214,46,115,.42);animation:weGlow 2.8s ease-in-out infinite}
    .we-band-badge::before{content:"";width:6px;height:6px;border-radius:50%;background:#FF8AC2;flex:none}
    @keyframes weGlow{
      0%,100%{box-shadow:0 0 0 0 rgba(214,46,115,.38)}
      50%{box-shadow:0 0 0 7px rgba(214,46,115,0)}
    }
    @media(prefers-reduced-motion:reduce){.we-band-badge{animation:none}}
    @media(max-width:600px){.we-band{padding:0 22px 8px}}
    .we-band-in{display:grid;grid-template-columns:280px 1fr;gap:0;align-items:stretch;text-decoration:none;color:inherit;
                border:1px solid rgba(214,46,115,.24);border-radius:8px;overflow:hidden;
                background:linear-gradient(120deg,rgba(203,183,247,.20),rgba(255,138,194,.16) 60%,rgba(214,46,115,.10));
                transition:border-color .2s,box-shadow .2s,transform .2s}
    .we-band-in:hover{border-color:#D62E73;box-shadow:0 10px 32px rgba(214,46,115,.16);transform:translateY(-2px)}
    .we-band-img{overflow:hidden}
    .we-band-img img{width:100%;height:100%;object-fit:cover;object-position:center top;display:block}
    .we-band-txt{padding:30px 34px}
    .we-band-k{font-size:11px;letter-spacing:2.4px;text-transform:uppercase;color:#D62E73;margin-bottom:12px}
    .we-band-txt h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(26px,3.6vw,38px);line-height:1.05;letter-spacing:-.8px;margin:0 0 12px}
    .we-band-txt p{font-size:16px;line-height:1.7;margin:0 0 18px;max-width:60ch}
    .we-band-go{display:inline-block;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#D62E73;font-weight:500}
    @media(max-width:780px){
      .we-band-in{grid-template-columns:1fr}
      .we-band-img{max-height:260px}
      .we-band-txt{padding:24px 22px}
    }

    /* ---------- HERO ---------- */
    .h-hero{position:relative;min-height:82vh;display:flex;align-items:flex-end;overflow:hidden}
    .h-hero .bg{position:absolute;inset:0;background-image:url(/images/library/hero-office-wide-02.jpg);background-size:cover;background-position:center}
    .h-hero .veil{position:absolute;inset:0;background:linear-gradient(180deg,rgba(251,248,245,.34) 0%,rgba(251,248,245,.62) 52%,var(--cream) 97%)}
    .h-hero .in{position:relative;width:100%;max-width:var(--wide);margin:0 auto;padding:0 40px 70px;text-align:center}
    .h-hero .k{display:inline-block;transition:opacity .3s;font-size:11px;font-weight:600;letter-spacing:3.2px;text-transform:uppercase;color:var(--pink);margin-bottom:22px}
    .h-hero h1{font-family:var(--display);font-weight:300;font-size:clamp(40px,6.6vw,84px);line-height:1.02;letter-spacing:-1.4px;max-width:15ch;margin:0 auto 24px;color:var(--pink)}
    .h-hero .sub{font-family:var(--serif);font-style:italic;font-size:clamp(19px,2.3vw,25px);line-height:1.55;color:var(--choc-soft);max-width:52ch;margin:0 auto 36px}
    .h-cta{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
    .btn.quiet{background:transparent;color:var(--choc)!important;border:1px solid var(--taupe);box-shadow:none}
    .btn.quiet:hover{border-color:var(--pink);color:var(--pink)!important}
    @media(max-width:600px){.h-hero{min-height:76vh}.h-hero .in{padding:0 22px 52px}}

    /* ---------- SHARED SECTION FURNITURE ---------- */
    .sec{max-width:var(--wide);margin:0 auto;padding:104px 40px;position:relative}
    .sec::before{content:"";position:absolute;top:0;left:40px;right:40px;height:9px;pointer-events:none;
      background:
        radial-gradient(circle at 50% 50%, #D62E73 0 3px, transparent 3.6px),
        linear-gradient(90deg,transparent 0%, rgba(214,46,115,.24) 16%, rgba(200,169,106,.30) 50%, rgba(214,46,115,.24) 84%, transparent 100%);
      background-repeat:no-repeat;background-size:100% 9px, 100% 1px;
      background-position:center center, center center}
    .shop-band .sec::before,.mem .sec::before{display:none}

    .sec-head{text-align:center;max-width:44ch;margin:0 auto 56px}
    .sec-head .k{font-size:11px;font-weight:600;letter-spacing:3px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:16px}
    .sec-head h2{font-family:var(--display);font-weight:300;font-size:clamp(32px,4.8vw,54px);line-height:1.05;letter-spacing:-.7px;margin-bottom:16px;color:var(--pink)}
    .sec-head p{font-family:var(--serif);font-style:italic;font-size:20px;line-height:1.55;color:var(--taupe-deep)}
    @media(max-width:600px){.sec{padding:70px 22px}}

    /* ---------- START HERE ---------- */
    .free-grid{display:grid;grid-template-columns:1fr 1fr;gap:30px;max-width:940px;margin:0 auto}
    .free-card{background:var(--white);border:1px solid var(--gray);border-radius:var(--r);overflow:hidden;display:flex;flex-direction:column}
    .free-card .ph{aspect-ratio:4/5;background-color:var(--blush);background-size:cover;background-position:center top;border-bottom:1px solid var(--gray)}
    @media(max-width:760px){.free-card .ph{aspect-ratio:3/4}}
    .free-card .bd{padding:30px 30px 32px;display:flex;flex-direction:column;flex:1}
    .free-card .tag{font-size:10px;font-weight:600;letter-spacing:2.2px;text-transform:uppercase;color:var(--pink);margin-bottom:12px}
    .free-card h3{font-family:var(--display);font-weight:400;font-size:25px;line-height:1.15;margin-bottom:12px}
    .free-card p{font-size:15.5px;line-height:1.65;color:var(--taupe-deep);margin-bottom:22px;flex:1}
    @media(max-width:760px){.free-grid{grid-template-columns:1fr}}

    /* ---------- THE LIBRARY (contents) ---------- */
    .contents{max-width:940px;margin:0 auto;display:flex;flex-direction:column;gap:9px}
    a.entry{position:relative;display:grid;grid-template-columns:62px 1fr auto;align-items:center;gap:22px;
      padding:22px 26px 22px 22px;border-radius:16px;background:var(--white);
      border:1px solid rgba(183,159,150,.20);overflow:hidden;
      transition:transform .4s var(--ease),box-shadow .4s var(--ease),border-color .4s var(--ease)}
    a.entry::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--ac);
      transition:width .4s var(--ease)}
    a.entry:hover{transform:translateY(-2px);border-color:rgba(214,46,115,.30);
      box-shadow:0 14px 34px -18px rgba(43,22,27,.28)}
    a.entry:hover::before{width:9px}
    a.entry:focus-visible{outline:2px solid var(--pink);outline-offset:3px}
    a.entry .no{font-family:var(--serif);font-style:italic;font-size:30px;line-height:1;color:var(--ac);text-align:center}
    a.entry .ttl{font-family:var(--display);font-weight:400;font-size:clamp(19px,2.2vw,23px);line-height:1.24}
    a.entry .ttl span{display:block;font-family:var(--sans);font-size:10px;font-weight:600;letter-spacing:2px;text-transform:uppercase;color:var(--ac);margin-bottom:9px;filter:brightness(.82)}
    a.entry .rd{font-size:11px;letter-spacing:1.6px;text-transform:uppercase;color:var(--taupe);white-space:nowrap}
    @media(max-width:640px){
      a.entry{grid-template-columns:40px 1fr;gap:14px;padding:18px 18px 18px 16px;border-radius:13px}
      a.entry .no{font-size:23px}
      a.entry .rd{display:none}
    }
    @media(prefers-reduced-motion:reduce){a.entry:hover{transform:none}}
    .sec-foot{text-align:center;margin-top:46px}

    /* ---------- SHOP ---------- */
    .shop-band{background:linear-gradient(168deg,#FDEAF3 0%,#FBDFEC 46%,#FDEDF4 100%);
      border-top:1px solid rgba(255,138,194,.44);border-bottom:1px solid rgba(255,138,194,.44)}
    .shop-band .sec-head .k{color:var(--pink)}
    .shop-band .sh{border-color:rgba(255,138,194,.46)}
    .shop-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
    @media(max-width:900px){.shop-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:600px){.shop-grid{grid-template-columns:1fr}}
    .sh{background:var(--white);border-radius:16px;padding:30px 28px 30px;display:flex;flex-direction:column;border:1px solid rgba(183,159,150,.28)}
    .sh h3{font-family:var(--display);font-weight:400;font-size:22px;line-height:1.2;margin-bottom:6px}
    .sh .price{font-family:var(--serif);font-size:26px;color:var(--pink);margin-bottom:2px}
    .sh .note{font-size:11px;letter-spacing:1.8px;text-transform:uppercase;color:var(--taupe-deep);margin-bottom:16px}
    .sh p{font-size:15px;line-height:1.62;color:var(--choc-soft);margin-bottom:22px;flex:1}
    .sh .go{font-size:12px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:var(--pink)}
    .sh .aff{display:inline-block;font-size:10px;letter-spacing:1.6px;text-transform:uppercase;color:var(--gold-deep);border:1px solid var(--gold);border-radius:100px;padding:3px 10px;margin-bottom:14px}
    .disclose{max-width:60ch;margin:38px auto 0;text-align:center;font-size:13.5px;line-height:1.7;color:var(--taupe-deep)}

    /* ---------- MEMBERSHIP ---------- */
    .mem{background:var(--choc);color:var(--cream)}
    .mem .sec-head h2,.mem .sec-head p{color:var(--cream)}
    .mem .sec-head .k{color:var(--mauve)}
    .mem .sec-head p{color:var(--rose)}
    .tiers{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:1080px;margin:0 auto;align-items:stretch}
    @media(max-width:900px){.tiers{grid-template-columns:1fr;max-width:460px}}
    .tier{position:relative;display:flex;flex-direction:column;padding:34px 30px 32px;border-radius:20px;
      background:rgba(255,255,255,.045);border:1px solid rgba(255,255,255,.13)}
    .tier.feat{background:rgba(255,138,194,.10);border-color:rgba(255,138,194,.42);
      box-shadow:0 40px 80px -50px rgba(255,138,194,.6)}
    .tier .flag{position:absolute;top:-11px;left:30px;background:var(--pink);color:var(--white);
      font-size:9.5px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;padding:5px 13px;border-radius:100px}
    .tier .nm{font-family:var(--display);font-size:26px;font-weight:400;margin-bottom:10px}
    .tier .pr{font-family:var(--serif);font-size:44px;line-height:1;color:var(--mauve);margin-bottom:12px}
    .tier .pr em{display:block;font-family:var(--sans);font-style:normal;font-size:10.5px;font-weight:500;
      letter-spacing:2px;text-transform:uppercase;color:var(--taupe);margin-top:8px}
    .tier .ln{font-family:var(--serif);font-style:italic;font-size:17px;line-height:1.5;color:var(--rose);
      margin-bottom:22px;padding-bottom:20px;border-bottom:1px solid rgba(255,255,255,.14)}
    .tier ul{list-style:none;margin:0 0 28px;flex:1}
    .tier li{position:relative;padding-left:22px;margin-bottom:11px;font-size:15px;line-height:1.55;color:var(--rose)}
    .tier li::before{content:"";position:absolute;left:2px;top:9px;width:5px;height:5px;background:var(--mauve);transform:rotate(45deg)}
    .tier .btn{width:100%;justify-content:center}
    .mem-note{max-width:64ch;margin:48px auto 0;text-align:center;font-size:14px;line-height:1.8;color:var(--taupe)}
    .mem-note strong{color:var(--rose)}

    /* ---------- NEWSLETTER ---------- */
    .news .btnrow{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
  </style>
</head>
<body class="no-js">
  <style>.no-js .reveal{opacity:1;transform:none}</style>

  <LaunchCountdown href="/weekend-ecosystem-waitlist" />

  <nav class="nav">
    <div class="nav-in">
      <a class="logo" href="/">The Digital Income <em>Edit™</em></a>
      <div class="nav-links">
        <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Resources</a><a href="/membership">Membership</a>
        <a class="nav-join" href="/community">Community</a>
      </div>
      <button class="burger" id="burger" aria-label="Menu">☰</button>
    </div>
  </nav>

  <div class="drawer" id="drawer">
    <button class="close" id="close" aria-label="Close">✕</button>
    <a href="/learn">Learn</a><a href="/shop">Shop</a><a href="/resources">Resources</a><a href="/membership">Membership</a><a href="/community">Community</a>
  </div>

  <!-- HERO -->
  <section class="h-hero">
    <div class="bg"></div>
    <div class="veil"></div>
    <div class="in">
      <a class="k" href="/">The Digital Income Edit™</a>
      <h1>Build a business you're obsessed with.</h1>
      <p class="sub">Faceless doesn't mean nobody's there. It means your face was never the thing you were selling.</p>
      <div class="h-cta">
        <a class="btn" href="/learn">Read the Library <span class="a">→</span></a>
        <a class="btn quiet" href="/resources/faceless-income-blueprint">Get the Blueprint free</a>
      </div>
    </div>
  </section>

  <!-- START HERE -->
  <!-- WEEKEND ECOSYSTEM — WAITLIST -->
  <section class="we-band">
    <a class="we-band-in" href="/weekend-ecosystem-waitlist">
      <div class="we-band-img">
        <img src="/images/we/cover-sofa.jpg" alt="The Weekend Ecosystem — your website and blog, built from what you already have." loading="lazy" width="1200" height="1490" />
      </div>
      <div class="we-band-txt">
        <div class="we-band-row">
          <span class="we-band-badge">New</span>
          <span class="we-band-k" style="margin:0">Waitlist open · Three days early</span>
        </div>
        <h2>The Weekend Ecosystem™</h2>
