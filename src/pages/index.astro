---
import "../styles/home.css";
// Homepage type, self-hosted: Gloock SemiBold for display, Jost for everything else.
import "../styles/brand-fonts.css";
import newsreader600 from "../assets/fonts/gloock-latin-400-normal.woff2?url";
import inter400 from "../assets/fonts/jost-latin-400-normal.woff2?url";

import { NAV, NAV_CTA, FOOTER, SOCIAL } from "../data/site.js";
import BlueprintForm from "../components/BlueprintForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { FEATURED } from "../we-reviews.js";
import { membership as M, weekendEcosystem as WE, community, library, SKOOL_PLANS, cap } from "../data/facts.js";

const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. Women are building it inside The Digital Income Edit™.`;

// The Built Backwards Method. The order is the method.
const method = [
  { n: "01", name: "Offer", line: "What you sell, who pays for it, what it costs. Decided before a single post exists.", out: "One sentence, one buyer, one price." },
  { n: "02", name: "Funnel", line: "The road a stranger walks from free to paid: the free thing, the page, the emails that do the asking.", out: "A path that sells without you in the room." },
  { n: "03", name: "Automation", line: "AI and schedules take the repeat work. One article becomes 24 finished assets and the emails send themselves.", out: "A business that runs on the Tuesday you skip." },
  { n: "04", name: "Audience", line: "Only now do you turn on traffic, pointed at something that already knows what to do with a visitor.", out: "Attention that lands somewhere." },
];

// What Jodie refuses to teach, and why. Short, because the method already said it.
const differences = [
  { t: "Build the offer before the audience.", p: "Know what you're selling, who it's for and where the money comes from before you spend a year performing for strangers." },
  { t: "Show the business, not the screenshot.", p: "The site itself is the case study. Open the pages. Inspect the funnel. Look at the actual outputs." },
  { t: "Use AI as the build team — not the personality.", p: "AI can write, organize and build. It does not need to become the voice of your brand." },
  { t: "Build traffic into a business.", p: "Pinterest, email, content and social are useful when they lead somewhere. They are not the destination." },
];

// Proof by inspection. Every room is a live page, shown as it really looks.
const rooms = [
  { key: "course", room: "The course", t: "The Weekend Ecosystem™", p: "Look inside the course before you buy: the full module list and a real lesson. Free, no email.", href: WE.preview, path: "/weekend-ecosystem/preview", go: "Look inside the course" },
  { key: "offer", room: "Free tool", t: "The One-Sentence Offer tool", p: "Type what you sell and get it down to one clear sentence a buyer understands. Free.", href: "/resources/one-sentence-offer", path: "/resources/one-sentence-offer", go: "Try the free tool" },
  { key: "funnel", room: "Free email challenge", t: "The Weekend Build Challenge", p: "Five free emails, one small build a day, from no idea to your first offer.", href: "/resources/weekend-build-challenge", path: "/resources/weekend-build-challenge", go: "See the challenge" },
  { key: "library", room: "Free blog article", t: "Turn your Skool lessons into a blog", p: "A real article on this site that started as a Skool lesson. Read it free.", href: "/learn/turn-skool-content-into-a-blog", path: "/learn/turn-skool-content-into-a-blog", go: "Read the article" },
  { key: "classroom", room: "The membership", t: "The Skool classroom", p: `See what's inside the membership, where women build their faceless businesses together.`, href: "/membership#room", path: "/membership", go: "See the membership" },
  { key: "blueprint", room: "Free guide", t: "The Faceless Income Blueprint™", p: "The whole machine on one page, and the one thing to build first. Free, delivered right on the page.", href: "/resources/faceless-income-blueprint", path: "/resources/faceless-income-blueprint", go: "Get the Blueprint" },
];

// A curated few of the pillar guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation & Paid Traffic", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      logo: `${SITE}/icon-512.png`,
      sameAs: ["https://pinterest.com/TheDigitalIncomeEditTDIE", "https://instagram.com/the.faceless.homestead.mama"] },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFE4EF" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="home-v9">

<header class="nav"><div class="wrap">
  <ul class="lft">{NAV.slice(0,3).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  <a class="logo" href="/" aria-label="The Digital Income Edit home"><span class="l1">The Digital Income</span><span class="l2">Edit<sup>™</sup><i class="spark"></i></span><span class="rule"><i></i><b class="dot"></b><i></i></span></a>
  <div class="r"><ul><li><a href="/membership">Membership</a></li></ul><a class="btn" href={NAV_CTA.href}>7 days free</a>
    <details class="mnav"><summary aria-label="Menu">Menu</summary><nav>{NAV.map((l) => <a href={l.href}>{l.label}</a>)}<a href="/resources/faceless-income-blueprint">The Free Blueprint</a><a href="/lifestyle">Lifestyle</a></nav></details>
  </div>
</div><div class="drip"></div></header>

<main>
<section class="hero"><div class="wrap grid">
  <div class="copy">
    <span class="kick">For women building without a personal brand</span>
    <h1>Build a faceless business. <em>Keep your life off camera.</em></h1>
    <p class="lede">Sell something, build the site that sells it, and let emails bring buyers back. AI does most of the work.</p>
    <div class="ctas"><a class="btn" href="#blueprint">Get the free Blueprint</a><a class="link" href={WE.url}>See the {WE.price} course</a></div>
    <div class="trust"><span>No camera</span><span>No code</span><span>Step by step</span></div>
  </div>
  <div class="stage">
    <a class="prod pwe" href={WE.url}><img src="/images/we/hook-blog-posts.jpg" alt="The Weekend Ecosystem course" width="1200" height="1490" fetchpriority="high"><span class="tag">{WE.name}<b>{WE.price}</b><i class="go">See the course →</i></span></a>
    <a class="prod pbp" href="#blueprint"><img src="/images/brand/blueprint-cover.webp" alt="The Faceless Income Blueprint" width="900" height="1165"><span class="tag">The Faceless Income Blueprint™<b>Free</b><i class="go">Get it free →</i></span></a>
  </div>
</div><div class="surface"></div></section>

<section class="honest sp"><div class="wrap">
  <span class="kick">Be honest</span>
  <h2>47 saved videos. <em>Zero products.</em></h2>
  <div class="lines"><span>Prompts everywhere. Nothing built.</span><span>No interest in being an influencer.</span><span>Ideas everywhere. Nothing connected.</span></div>
  <p class="next">You don't need more ideas. <em>You need the next step.</em></p>
</div></section>

<section class="method" id="method"><div class="wrap">
  <div class="plate">
    <span class="kick">The Built Backwards Method</span>
    <h2>Built backwards. <em>The order is the method.</em></h2>
    <div class="steps">
      <div class="step"><div class="n">1</div><h3>Offer</h3><p>Pick what you sell.</p><a class="st" href="/resources/find-your-door">Start here</a></div>
      <div class="step"><div class="n">2</div><h3>Funnel</h3><p>Build the path to buy it.</p></div>
      <div class="step"><div class="n">3</div><h3>Automation</h3><p>AI does the repeat work.</p></div>
      <div class="step"><div class="n">4</div><h3>Audience</h3><p>Then bring people in.</p></div>
    </div>
  </div>
</div><div class="drip2"></div></section>

<section class="we sp"><div class="wrap feature">
  <div class="pic"><div class="frame"><div class="bar"><i></i><i></i><i></i><span>Inside {WE.name}</span></div><img src="/images/brand/we-inside.webp" alt="Inside The Weekend Ecosystem course" width="1080" height="480" loading="lazy"></div><figure class="quote"><div class="stars">★★★★★</div><blockquote>"{FEATURED.pull}"</blockquote><figcaption><a href={FEATURED.url} rel="noopener" target="_blank">{FEATURED.name}</a> · {FEATURED.tenure}</figcaption></figure><div class="sticker"><i class="in"></i><span>Built in one weekend</span></div></div>
  <div>
    <span class="kick">The course · {WE.price}</span>
    <h2>The Weekend <em>Ecosystem™</em></h2>
    <p class="sub">Your website and blog, built in one weekend.</p>
    <div class="nums"><div><b>{WE.modules}</b>Modules</div><div><b>{WE.prompts}</b>Prompts</div><div><b>{WE.assetsPerArticle}</b>Posts per article</div></div>
    <ul class="res"><li>A live website on your own domain</li><li>Email sign-ups and your offer, connected</li><li>One prompt turns each article into {WE.assetsPerArticle} posts</li></ul>
    <div class="buy"><a class="btn" href={WE.url}>Get {WE.name}</a><small>Or {WE.plan}. Yours for good.<br><a class="link" href={WE.preview}>See inside first</a></small></div>
  </div>
</div></section>

<section class="fs sp r"><div class="wrap">
  <div class="head"><span class="kick">The weekend</span><h2>Friday night to Sunday. <em>Here's what changes.</em></h2></div>
  <div class="days">
    <div class="day fri"><h3>Friday</h3><ul><li><span>No website</span></li><li><span>No blog</span></li><li><span>Nobody finds you</span></li></ul></div>
    <div class="arrow">→</div>
    <div class="day sun"><h3>Sunday</h3><ul><li>Your own website</li><li>A blog Google finds</li><li>An email list that grows</li></ul></div>
  </div>
</div></section>

<section class="mem" id="membership"><div class="wrap">
  <div class="head"><span class="kick">The membership</span><h2>Build it with us. <em>Pick your help.</em></h2><p>Both start with {M.trialDays} days free.</p></div>
  <div class="tiers">
    <div class="tier"><span class="nm">{M.standard.short}</span><h3>{M.standard.name}</h3><p class="price">{M.standard.monthly}<small>/month</small></p><p class="yr">or {M.standard.perYear}</p>
      <ul><li>Step-by-step trainings</li><li>Daily Prompts</li><li>The community</li></ul><a class="btn" href={SKOOL_PLANS}><span class="lg">Start Standard free</span><span class="sm">Start free</span></a></div>
    <div class="tier prem"><div class="sticker"><i class="in"></i><span>Most help</span></div><span class="nm">{M.premium.short}</span><h3>{M.premium.name}</h3><p class="price">{M.premium.monthly}<small>/month</small></p><p class="yr">or {M.premium.perYear}</p>
      <ul><li>Everything in Standard</li><li>Your content calendar, done for you</li><li>Every Value Vault guide</li></ul><a class="btn" href={SKOOL_PLANS}><span class="lg">Start Premium free</span><span class="sm">Start free</span></a></div>
  </div>
  <div class="group"><img src="/images/brand/skool-group.webp" alt="The Digital Income Edit group on Skool" width="975" height="674" loading="lazy"><div><span class="kick">Inside the members' group</span><h3>This is the real group.</h3><p>It lives on Skool, a private members' app. Lessons, weekly threads and the women building beside you.</p><a class="btn" href="/membership">See the membership</a></div></div>
</div><div class="drip3"></div></section>

<section class="bp" id="blueprint"><div class="wrap grid">
  <div class="bpstage"><div class="prod pg p3"><img src="/images/brand/bp-page-5.webp" alt="" loading="lazy"></div><div class="prod pg p2"><img src="/images/brand/bp-page-4.webp" alt="" loading="lazy"></div><div class="prod pg p1"><img src="/images/brand/bp-page-3.webp" alt="Inside The Faceless Income Blueprint" loading="lazy"></div></div>
  <div class="txt"><span class="kick">Free download</span><h2>Don't know what to sell? <em>Start with the Blueprint.</em></h2><p>Fifteen pages: the whole business on one map, the one thing to build first, and a seven-day plan.</p>
    <BlueprintForm heading="" sub="" button="Send me the Blueprint" /></div>
</div><div class="surface"></div></section>

<section class="lib sp r t"><div class="wrap">
  <div class="head"><div><span class="kick">The free library</span><h2>Free guides. <em>Start with these.</em></h2></div><a class="btn" href="/learn">See every guide</a></div>
  <div class="guides">
    {guides.map((g, i) => <a class="g" href={`/learn/${g.slug}`}><div class="top"></div><span class="tp">{["Start here","AI basics","Skool","Automation"][i]}</span><h3>{g.t}</h3><span class="btn">Read the guide</span></a>)}
  </div>
</div></section>
</main>

<footer><div class="wrap"><a class="logo" href="/"><span class="l1">The Digital Income</span><span class="l2">Edit<sup>™</sup><i class="spark"></i></span><span class="rule"><i></i><b class="dot"></b><i></i></span></a>
<div class="fcols">
{FOOTER.map((col) => <div><h4>{col.h}</h4>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>)}
</div>
<p class="fsoc">{SOCIAL.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
<p class="fcopy">© 2026 The Digital Income Edit™ · <a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p>
</div></footer>
</body>

</html>
