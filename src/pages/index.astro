    .refuse p{margin:0;font-size:16px;line-height:1.6;color:var(--hp-ink-2)}
    @media(max-width:900px){.pov-grid{grid-template-columns:1fr;gap:28px}.pov-fig{position:relative;top:0;max-width:520px;order:2;margin-top:24px}}

    /* ============ WALK THE MACHINE ============ */
    .machine{background:#F7EEE9 url(/images/home/machine-flatlay-800.webp) center/cover no-repeat;isolation:isolate}
    .machine::before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(251,248,245,.93) 0%,rgba(251,248,245,.84) 50%,rgba(251,248,245,.94) 100%)}
    @media(min-width:900px){.machine{background-image:url(/images/home/machine-flatlay-1116.webp);background-attachment:scroll}}
    .map{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);gap:22px;position:relative}
    .map li{position:relative}
    .node{display:flex;flex-direction:column;height:100%;padding:26px 24px 22px;border-radius:20px;transition:transform .25s ease,box-shadow .25s ease}
