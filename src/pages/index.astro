---
import "../styles/global.css";
// Homepage type, self-hosted and scoped to this file only: Newsreader SemiBold
// for headlines and prices, Inter for everything else. No other page loads these.
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

import Analytics from "@vercel/analytics/astro";
import FreebieForm from "../components/FreebieForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { FEATURED as tina } from "../we-reviews.js";

const SITE = "https://www.thedigitalincomeedit.com";
const SKOOL_PLANS = "https://www.skool.com/thedigitalincomeedit/plans";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = "Build a faceless business with AI in the right order: offer, funnel, automation, then audience. 1,200+ women are building it inside The Digital Income Edit™.";

// Proof strip: real, countable figures only. No income numbers on this page.
const proof = [
  { big: "1,200+", small: "women inside the community" },
  { big: "13", small: "guides in the library" },
  { big: "22", small: "modules, delivered as a live website" },
  { big: "1 → 24", small: "one article becomes 24 finished assets" },
  { big: "Solo", small: "site, classroom, funnels and emails, built faceless with AI" },
];

// The Built Backwards Method. Offer first, funnel second, automation third, audience last.
const method = [
  { n: "01", name: "Offer", line: "What you sell, who pays for it and what it costs. Decided before a single post exists.", out: "One sentence, one buyer, one price" },
  { n: "02", name: "Funnel", line: "The road a stranger walks from free to paid: the free thing, the page, the emails that do the asking.", out: "A path that sells without you in the room" },
  { n: "03", name: "Automation", line: "AI and schedules take the repeat work. The emails send themselves and one article becomes 24 finished assets.", out: "A machine that runs on a Tuesday you skip" },
  { n: "04", name: "Audience", line: "Only now do you turn on traffic, pointed at a machine that already knows what to do with a visitor.", out: "Traffic that lands somewhere" },
];

// What Jodie refuses to teach, and why.
const refusals = [
  { t: "Audience first.", p: "Growing followers before you have anything to sell is a year of performing for strangers. The audience is the last room I build, never the first." },
  { t: "Income screenshots.", p: "A screenshot proves someone had a good month. It proves nothing about a machine. I would rather hand you the machine and let you walk through it." },
  { t: "Showing your face.", p: "Faceless means your real face is never required. The face of this brand is an AI persona, and the business behind her is real, built and running." },
  { t: "One-channel experts.", p: "Pinterest, blogging, email and automation are rooms inside one build. Anyone selling you a single room as the whole house is selling you a dependency." },
];

// Walk the machine: every node links to the live page it describes.
const machine = [
  { n: "01", room: "The offer", t: "The One-Sentence Offer tool", p: "Step one of the method as a free tool. Type your offer, watch it get checked. No email.", href: "/resources/one-sentence-offer", go: "Test your offer free" },
  { n: "02", room: "The course", t: "22 modules, delivered as a website", p: "The Weekend Ecosystem™ lives on the very site it teaches you to build. Walk the lobby.", href: "/weekend-ecosystem/preview", go: "Open your free look inside" },
  { n: "03", room: "The funnel", t: "The Weekend Build Challenge", p: "Five free days by email that walk a stranger, in order, from nothing to an offer.", href: "/resources/weekend-build-challenge", go: "Inspect your five-day funnel" },
  { n: "04", room: "The classroom", t: "The Skool room behind it", p: "Where 1,200+ women build the same machine, lesson by lesson, beside each other.", href: "/community", go: "See your future classroom" },
  { n: "05", room: "The library", t: "Every article started as a lesson", p: "Each guide on this site began as a Skool lesson and was turned into a page by the method it teaches.", href: "/learn/turn-skool-content-into-a-blog", go: "Read your proof, lesson to article" },
  { n: "06", room: "The email", t: "The Sunday letter", p: "Written once a week, delivered to every subscriber by the automation underneath this site.", href: "/newsletter", go: "Read your Sunday letter" },
];

// A curated few of the thirteen guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation & Paid Traffic", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

// Membership, compact. Full tier detail lives on /membership.
const tiers = [
  {
    key: "standard",
    name: "Membership Standard",
    price: "$9",
    per: "/month",
    alt: "or $99/year",
    buys: "The build, by hand, with the room beside you.",
    items: [
      "The Essentials Edit, AI Foundations for Creators and Canva Crash Course",
      "Pinterest Foundations™, The Email Edit and The Shopify Edit",
      "Daily Prompts and the community, every day",
      "The Value Vault guides, bought à la carte",
    ],
    cta: "Start my 7 free days of Standard",
  },
  {
    key: "premium",
    name: "Membership Premium",
    price: "$35",
    per: "/month",
    alt: "or $297/year",
    buys: "The whole architecture, with your content month written for you.",
    items: [
      "Everything in Standard",
      "The Offer Edit, The Funnel Edit and Scaling & Systems",
      "The Ads Edit™ and a done-for-you content calendar every month",
      "The Premium Vault: every Value Vault guide, already unlocked",
    ],
    cta: "Start my 7 free days of Premium",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      sameAs: ["https://pinterest.com/TheDigitalIncomeEditTDIE", "https://instagram.com/the.faceless.homestead.mama"] },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FBF8F5" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
        imagesizes="(max-width: 900px) 78vw, 440px" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    /* ============ HOMEPAGE DESIGN SYSTEM (scoped to this page) ============ */
    :root{
      --hp-ink:#1A1417;--hp-ink-2:#4A3F44;--hp-pink:#D62E73;--hp-pink-2:#B8245F;--hp-bubble:#FF8AC2;
      --hp-gold:#C8A96A;--hp-lav:#CBB7F7;--hp-cream:#FBF8F5;--hp-white:#FFFFFF;
      --hp-serif:"Newsreader",Georgia,serif;--hp-sans:"Inter",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      --hp-glass:rgba(255,255,255,.78);--hp-line:1px solid rgba(200,169,106,.55);
      --hp-shadow:0 30px 60px -28px rgba(214,46,115,.38),0 10px 24px -14px rgba(26,20,23,.18);
      --hp-shadow-sm:0 18px 36px -22px rgba(214,46,115,.40),0 4px 12px -6px rgba(26,20,23,.10);
      --hp-grad:linear-gradient(135deg,#E8458A 0%,#D62E73 45%,#B8245F 100%);
      --hp-w:1200px;--hp-gut:clamp(16px,4vw,40px);
    }
    body.hp{font-family:var(--hp-sans);color:var(--hp-ink);background:var(--hp-cream);font-size:17px;line-height:1.65}
    body.hp::before,body.hp::after{display:none}
    .hp h1,.hp h2,.hp h3{font-family:var(--hp-serif);font-weight:600;font-style:normal;color:var(--hp-ink);letter-spacing:-.02em}
    .hp em{font-style:normal}
    .hp .pk{color:var(--hp-pink)}
    .wrap{max-width:var(--hp-w);margin:0 auto;padding-left:var(--hp-gut);padding-right:var(--hp-gut)}
    .hp .kick{display:inline-flex;align-items:center;gap:10px;font-family:var(--hp-sans);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--hp-pink-2);margin:0 0 18px}
    .hp .kick::before{content:"";width:26px;height:1px;background:var(--hp-gold)}
    .h2{font-size:clamp(34px,5vw,58px);line-height:1.04;margin:0 0 18px}
    .hp-lede{font-family:var(--hp-sans);font-size:clamp(17px,1.6vw,19px);line-height:1.65;color:var(--hp-ink-2);max-width:60ch}
    .sec{padding:clamp(72px,10vw,128px) 0;position:relative}
    .sec-head{max-width:760px;margin:0 0 clamp(36px,5vw,56px)}
    .sec-head.c{margin-left:auto;margin-right:auto;text-align:center}
    .hp .sec-head.c .kick{justify-content:center}
    .sec-head.c .hp-lede{margin-left:auto;margin-right:auto}
    a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid var(--hp-pink);outline-offset:3px;border-radius:4px}

    /* Buttons: hot pink gradient pills, white caps */
    .pill{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:15px 30px;border-radius:999px;
      background:var(--hp-grad);color:#fff!important;font-family:var(--hp-sans);font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
      text-align:center;line-height:1.3;box-shadow:0 14px 30px -12px rgba(214,46,115,.65),inset 0 1px 0 rgba(255,255,255,.35);
      transition:transform .25s ease,box-shadow .25s ease}
    .pill:hover{transform:translateY(-2px);box-shadow:0 20px 38px -14px rgba(214,46,115,.75),inset 0 1px 0 rgba(255,255,255,.35)}
    .pill .ar{transition:transform .25s ease}
    .pill:hover .ar{transform:translateX(4px)}
    .pill.white{background:#fff;color:var(--hp-pink-2)!important;box-shadow:0 14px 30px -14px rgba(26,20,23,.45)}
    .quiet{display:inline-flex;align-items:center;gap:8px;min-height:44px;font-size:15px;font-weight:600;color:var(--hp-pink-2);
      border-bottom:1px solid rgba(214,46,115,.35);transition:border-color .2s}
    .quiet:hover{border-color:var(--hp-pink-2)}

    /* Glass card with a thin gold border and deep pink-tinted shadow */
    .glass{background:var(--hp-glass);-webkit-backdrop-filter:blur(14px) saturate(140%);backdrop-filter:blur(14px) saturate(140%);
      border:var(--hp-line);border-radius:22px;box-shadow:var(--hp-shadow)}

    /* Round tilted sticker with dashed inner ring */
    .sticker{position:absolute;z-index:3;width:118px;height:118px;border-radius:50%;background:#fff;display:grid;place-items:center;text-align:center;
      box-shadow:0 16px 30px -12px rgba(214,46,115,.55);transform:rotate(-12deg);color:var(--hp-pink-2);
      font-family:var(--hp-sans);font-weight:800;font-size:12.5px;line-height:1.15;letter-spacing:.08em;text-transform:uppercase;padding:18px}
    .sticker::before{content:"";position:absolute;inset:7px;border-radius:50%;border:1.5px dashed var(--hp-pink);opacity:.8}
    .sticker b{display:block;font-family:var(--hp-serif);font-weight:600;font-size:30px;letter-spacing:-.02em;line-height:1;margin-bottom:3px;text-transform:none}
    .sticker.pinkfill{background:var(--hp-grad);color:#fff}
    .sticker.pinkfill::before{border-color:rgba(255,255,255,.85)}

    /* ============ NAV ============ */
    .hp-nav{position:sticky;top:0;z-index:60;background:rgba(251,248,245,.86);-webkit-backdrop-filter:blur(14px) saturate(150%);backdrop-filter:blur(14px) saturate(150%);border-bottom:1px solid rgba(200,169,106,.35)}
    .hp-nav .wrap{display:flex;align-items:center;justify-content:space-between;min-height:68px;gap:16px}
    .hp-logo{font-family:var(--hp-serif);font-weight:600;font-size:21px;letter-spacing:-.01em;color:var(--hp-ink);display:inline-flex;align-items:center;min-height:44px}
    .hp-logo span{color:var(--hp-pink-2);margin-left:.25em}
    .hp-links{display:flex;align-items:center;gap:30px}
    .hp-links a{font-size:13px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--hp-ink-2);display:inline-flex;align-items:center;min-height:44px}
    .hp-links a:hover{color:var(--hp-pink-2)}
    .hp-links a.cta{padding:0 20px;border-radius:999px;background:var(--hp-grad);color:#fff;box-shadow:0 10px 22px -12px rgba(214,46,115,.7)}
    .hp-burger{display:none;min-width:44px;min-height:44px;border:1px solid rgba(200,169,106,.6);border-radius:999px;background:#fff;color:var(--hp-ink);
      font:600 12px/1 var(--hp-sans);letter-spacing:.14em;text-transform:uppercase;padding:0 16px;cursor:pointer}
    .hp-drawer{margin:0;inset:0;width:100%;max-width:none;height:100%;max-height:none;border:0;padding:84px 24px 32px;background:var(--hp-cream)}
    .hp-drawer::backdrop{background:rgba(26,20,23,.3)}
    .hp-drawer a{display:flex;align-items:center;min-height:56px;font-family:var(--hp-serif);font-weight:600;font-size:30px;border-bottom:1px solid rgba(200,169,106,.35);color:var(--hp-ink)}
    .hp-drawer a.cta{color:var(--hp-pink-2)}
    .hp-drawer button{position:absolute;top:14px;right:16px;min-width:44px;min-height:44px;border-radius:999px;border:1px solid rgba(200,169,106,.6);background:#fff;font:600 12px/1 var(--hp-sans);letter-spacing:.14em;text-transform:uppercase;padding:0 16px;cursor:pointer;color:var(--hp-ink)}
    @media(max-width:900px){.hp-links{display:none}.hp-burger{display:inline-flex;align-items:center}}

    /* ============ HERO ============ */
    .hx{position:relative;overflow:hidden;padding:clamp(40px,7vw,96px) 0 clamp(120px,14vw,170px);
      background:
        radial-gradient(60% 55% at 85% 20%,rgba(255,138,194,.30) 0%,transparent 60%),
        linear-gradient(180deg,#FFF6F9 0%,var(--hp-cream) 100%)}
    .hero-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(40px,6vw,88px);align-items:center}
    .hx h1{font-size:clamp(44px,6.4vw,86px);line-height:.98;letter-spacing:-.035em;margin:0 0 26px}
    .hx h1 .pk{display:block}
    .hx .hp-lede{font-size:clamp(18px,1.7vw,21px);color:var(--hp-ink-2);margin:0 0 14px;max-width:34em}
    .hx .hp-lede strong{color:var(--hp-ink);font-weight:600}
    .hero-proof{font-size:15.5px;line-height:1.6;color:var(--hp-ink-2);margin:0 0 32px;padding-left:16px;border-left:2px solid var(--hp-pink);max-width:36em}
    .hero-cta{display:flex;flex-wrap:wrap;align-items:center;gap:14px 26px}
    .hero-fig{position:relative;max-width:440px;margin-left:auto;width:100%}
    .hero-slab{position:absolute;left:-8%;right:8%;top:14%;bottom:-6%;border-radius:28px;background:var(--hp-grad);box-shadow:var(--hp-shadow)}
    .hero-slab::after{content:"";position:absolute;inset:0;border-radius:inherit;background:linear-gradient(120deg,rgba(255,255,255,.38) 0%,rgba(255,255,255,0) 38%)}
    .hero-frame{position:absolute;left:6%;right:-5%;top:6%;bottom:-3%;border:1px solid var(--hp-gold);border-radius:24px}
    .hero-photo{position:relative;z-index:2;margin:0 0 0 4%;width:92%;border-radius:22px;overflow:hidden;box-shadow:0 34px 60px -26px rgba(26,20,23,.5);aspect-ratio:480/596}
    .hero-photo img{width:100%;height:100%;object-fit:cover}
    .hero-fig .sticker{right:-18px;bottom:-26px}
    .hero-tag{position:absolute;z-index:3;left:-6%;top:-14px;background:#fff;border:var(--hp-line);border-radius:999px;padding:8px 16px;font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--hp-pink-2);box-shadow:var(--hp-shadow-sm)}
    @media(max-width:900px){
      .hero-grid{grid-template-columns:1fr}
      .hero-fig{margin:10px auto 0;max-width:340px}
      .hero-fig .sticker{right:-10px;bottom:-30px;width:104px;height:104px}
      .hero-cta .pill{width:100%}
    }

    /* ============ PROOF STRIP ============ */
    .proof{position:relative;z-index:4;margin-top:clamp(-96px,-8vw,-64px)}
    .proof-grid{display:grid;grid-template-columns:repeat(5,1fr);padding:10px;gap:0}
    .stat{padding:22px 20px;text-align:center;position:relative}
    .stat + .stat::before{content:"";position:absolute;left:0;top:22%;bottom:22%;width:1px;background:rgba(200,169,106,.55)}
    .stat b{display:block;font-family:var(--hp-serif);font-weight:600;font-size:clamp(34px,3.6vw,46px);line-height:1;color:var(--hp-pink);letter-spacing:-.02em;margin-bottom:8px}
    .stat span{display:block;font-size:13.5px;line-height:1.45;color:var(--hp-ink-2);max-width:18ch;margin:0 auto}
    @media(max-width:900px){
      .proof-grid{grid-template-columns:1fr 1fr}
      .stat + .stat::before{display:none}
      .stat{border-bottom:1px solid rgba(200,169,106,.35)}
      .stat:nth-child(odd):not(:last-child){border-right:1px solid rgba(200,169,106,.35)}
      .stat:last-child{grid-column:1/-1;border-bottom:0}
    }

    /* ============ METHOD ============ */
    .method-panel{position:relative;padding:clamp(22px,3vw,34px);border-radius:28px}
    .method-bar{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:center;padding:0 6px 20px;margin-bottom:22px;border-bottom:1px solid rgba(200,169,106,.5)}
    .method-bar strong{font-family:var(--hp-serif);font-weight:600;font-size:22px;color:var(--hp-ink)}
    .method-bar span{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-pink-2)}
    .steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:s}
    .step{position:relative;background:#fff;border-radius:18px;padding:26px 22px 24px;border:1px solid rgba(214,46,115,.22);box-shadow:var(--hp-shadow-sm);display:flex;flex-direction:column}
    .step:not(:last-child)::after{content:"";position:absolute;right:-15px;top:46px;width:12px;height:12px;border-top:2px solid var(--hp-pink);border-right:2px solid var(--hp-pink);transform:rotate(45deg);z-index:2}
    .step .num{font-family:var(--hp-serif);font-weight:600;font-size:56px;line-height:.9;color:var(--hp-pink);letter-spacing:-.03em}
    .step .ord{font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--hp-ink-2);margin:12px 0 4px}
    .step h3{font-size:30px;line-height:1.05;margin:0 0 12px}
    .step p{font-size:15px;line-height:1.6;color:var(--hp-ink-2);margin:0 0 18px;flex:1}
    .step .out{font-size:13.5px;font-weight:600;line-height:1.45;color:var(--hp-pink-2);padding-top:14px;border-top:1px dashed rgba(214,46,115,.45)}
    .method-foot{display:flex;flex-wrap:wrap;gap:12px 28px;align-items:center;justify-content:space-between;margin-top:26px;padding:0 6px}
    .method-foot p{margin:0;font-size:16px;color:var(--hp-ink-2);max-width:62ch}
    .method-foot p strong{color:var(--hp-pink-2);font-weight:600}
    .tagline{font-family:var(--hp-serif);font-weight:600;font-size:clamp(20px,2.2vw,24px);color:var(--hp-ink)}
    @media(max-width:980px){
