---
import {WYS_CTA} from "../data/wys-live.js";
import "../styles/home.css";
import "../styles/home-sections.css";
import "../styles/home-finish.css";
import "../styles/review-bubble.css";
import "../styles/home-v11.css";
// Homepage type, self-hosted: Gloock SemiBold for display, Jost for everything else.
import "../styles/brand-fonts.css";
import newsreader600 from "../assets/fonts/gloock-latin-400-normal.woff2?url";
import inter400 from "../assets/fonts/jost-latin-400-normal.woff2?url";

import { NAV, NAV_CTA, FOOTER, SOCIAL } from "../data/site.js";
import BlueprintForm from "../components/BlueprintForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { FEATURED, MEMBER_REVIEWS } from "../we-reviews.js";
import ReviewBubble from "../components/ReviewBubble.astro";
import MembershipPlans from "../components/MembershipPlans.astro";
import { weekendEcosystem as WE, membership as MEM, SKOOL_PLANS } from "../data/facts.js";

const BRITTANY = MEMBER_REVIEWS.find((r) => r.id === "brittany-miller-skool");

// Everything else The Digital Income Edit™ makes, named, in one compact row.
const alsoFrom = [
  { label: "Shop the looks", title: "The Lifestyle Edit", href: "/lifestyle" },
  { label: "Amazon storefront system", title: "The While-You-Sleep Storefront™", href: WYS_CTA.href },
  { label: "Digital product stock", title: "Pretty & Paid PLR Vault™", href: "/shop/pretty-and-paid-plr-vault" },
  { label: "Physical products", title: "The Shopify Starter Kit", href: "/resources/shopify-starter-kit" },
];

const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. Women are building it inside The Digital Income Edit™.`;

// A curated few of the pillar guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      logo: `${SITE}/icon-512.png`,
      sameAs: SOCIAL.map((s) => s.href) },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FFE4EF" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</head>
<body class="home-v9 home-v11">

<header class="nav"><div class="wrap">
  <ul class="lft">{NAV.slice(0,3).map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
  <a class="logo" href="/" aria-label="The Digital Income Edit home"><span class="l1">The Digital Income</span><span class="l2">Edit<sup>™</sup><i class="spark"></i></span><span class="rule"><i></i><b class="dot"></b><i></i></span></a>
  <div class="r"><ul><li><a href="/membership">Membership</a></li></ul><a class="btn" href={NAV_CTA.href}>7 days free</a>
    <details class="mnav"><summary aria-label="Menu">Menu</summary><nav>{NAV.map((l) => <a href={l.href}>{l.label}</a>)}<a href="/resources/faceless-income-blueprint">The Free Blueprint</a><a href={WE.url}>The Weekend Ecosystem™</a><a href="/learn">Free Library</a><a href="/work-with-me">Work With Me</a><a href="/lifestyle">Lifestyle</a></nav></details>
  </div>
</div><div class="hx-gborder" aria-hidden="true"></div></header>

<a class="home-skip" href="#home-content">Skip to content</a>
<main id="home-content">

<section class="h11-hero" aria-labelledby="h11-title">
  <div class="h11-copy">
    <span class="h11-kick">For women building without a personal brand</span>
    <h1 id="h11-title">Build a faceless business. <em>Keep your life <i class="stress">off camera.</i></em></h1>
    <p class="h11-lede"><b>The Digital Income Edit™ membership</b> shows you how to build the whole business with AI, in the right order: offer, funnel, automation, then audience.</p>
    <div class="h11-ctas">
      <a class="h11-btn" href={SKOOL_PLANS}>Start your 7 days free <span aria-hidden="true">→</span></a>
      <a class="h11-link" href="#blueprint">Or get the free Blueprint</a>
    </div>
    <p class="h11-terms">{MEM.standard.name} {MEM.standard.perMonth} · {MEM.premium.name} {MEM.premium.perMonth}. Cancel in Skool before the trial ends and you pay nothing.</p>
    <div class="h11-proofrow">
      <figure class="rv-bubble h11-mini"><span class="rv-q o" aria-hidden="true">&ldquo;</span><span class="rv-stars" aria-label="5 out of 5">★★★★★</span><blockquote>This is the best plan to follow BY FAR!</blockquote><figcaption><b>{BRITTANY.name}</b>, {BRITTANY.source}</figcaption><span class="rv-q c" aria-hidden="true">&rdquo;</span></figure>
      <span class="h11-count"><b>900<span class="h11-plus">+</span></b> members building inside</span>
    </div>
  </div>
  <div class="h11-photo">
    <img src="/images/brand/hero-tk-car.webp" alt="Tommy Kate, the AI face of The Digital Income Edit™, laughing in her pink car" width="1200" height="1500" fetchpriority="high" decoding="async">
    <span class="h11-sticker"><b>Meet Tommy Kate.</b> The AI face of this brand. Yours can have one too.</span>
  </div>
</section>

<section class="home-honest" aria-labelledby="honest-title">
  <div class="home-sheet">
    <i class="home-tape" aria-hidden="true"></i>
    <span class="home-kicker">Starting from scratch?</span>
    <h2 id="honest-title">47 saved videos. <em><i class="stress">Zero</i> products.</em></h2>
    <ul class="home-crossed">
      <li>Prompts everywhere. Nothing built.</li>
      <li>No interest in being an influencer.</li>
      <li>Ideas everywhere. Nothing connected.</li>
    </ul>
    <p class="home-next">You don't need more ideas. <em>You need the right order.</em></p>
  </div>
</section>

<section class="home-method" id="method" aria-labelledby="method-title">
  <div class="home-inner home-method-layout">
    <div class="home-method-copy">
      <span class="home-kicker">The Built Backwards Method</span>
      <h2 id="method-title">Built backwards. <em>The <i class="stress">order</i> is the method.</em></h2>
      <p>The order to build a business, not a list of things to buy. Most people grow an audience and hope it buys. You build what it will buy first.</p>
      <a class="h11-link" href="#blueprint">Start with step 1: the free Blueprint</a>
    </div>
    <ol class="home-pile">
      {[{name:'Offer',line:'Decide what you sell before you post a thing.'},
        {name:'Funnel',line:'Build the page and emails that sell it for you.'},
        {name:'Automation',line:'AI takes the daily repeat work off your plate.'},
        {name:'Audience',line:'Then send traffic somewhere already built to sell.'}].map((step,i) =>
        <li class="home-method-card">
          {i === 0 && <i class="home-tape" aria-hidden="true"></i>}
          <span class="home-step-number" aria-hidden="true">{String(i+1).padStart(2,'0')}</span>
          <div><h3>{step.name}</h3><p>{step.line}</p></div>
        </li>)}
    </ol>
  </div>
</section>

<section class="h11-machine" aria-labelledby="machine-title">
  <div class="h11-inner h11-machine-grid">
    <a class="h11-shot" href="https://www.skool.com/thedigitalincomeedit/about"><img src="/images/pages/skool-about-current.webp" alt="The Digital Income Edit™ Skool group, as it looks today" width="1440" height="979" loading="lazy" decoding="async"></a>
    <div>
      <span class="h11-kick">The proof is the build</span>
      <h2 id="machine-title">This whole business was built <em>faceless, with AI.</em></h2>
      <p>This site, the emails, the course and the Skool classroom. Every article here started as a Skool lesson, and the course is delivered on the very site it teaches you to build. No income screenshots. Open any of it and look.</p>
      <ul class="h11-ticks"><li>No filming</li><li>No audience first</li><li>No performing</li></ul>
      <div class="h11-ctas"><a class="h11-btn h11-btn--sm" href="https://www.skool.com/thedigitalincomeedit/about">Take a free look inside <span aria-hidden="true">→</span></a><a class="h11-link" href={WE.preview}>Or see inside the course, free</a></div>
    </div>
  </div>
</section>

<section class="home-blueprint" id="blueprint" aria-labelledby="blueprint-title">
  <div class="home-inner">
    <div class="home-blueprint-head">
      <span class="home-kicker">Free download · 15 pages</span>
      <h2 id="blueprint-title">Don't know what to <i class="stress">sell</i>? <em>Start with the Blueprint.</em></h2>
      <p class="home-product-name">The Faceless Income Blueprint™</p>
    </div>
    <div class="home-fan" aria-label="The Blueprint cover and three inside pages">
      <img class="home-page home-page-one" src="/images/brand/bp-page-3.webp" width="260" height="368" alt="A page from The Faceless Income Blueprint" decoding="async">
      <img class="home-page home-page-two" src="/images/brand/bp-page-4.webp" width="260" height="368" alt="Another page from the Blueprint" decoding="async">
      <img class="home-page home-page-three" src="/images/brand/bp-page-5.webp" width="260" height="368" alt="The Blueprint's third preview page" decoding="async">
      <div class="home-cover"><i class="home-tape" aria-hidden="true"></i><img src="/images/brand/blueprint-cover.webp" width="300" height="424" alt="The Faceless Income Blueprint cover" decoding="async"></div>
    </div>
    <div class="home-signup-card">
      <ul class="home-checklist"><li>Your whole business on one map</li><li>The one thing to build first</li><li>A seven-day plan to build it</li></ul>
      <BlueprintForm heading="" sub="" button="Send me the Blueprint" />
    </div>
  </div>
</section>

<section class="mem" id="membership"><div class="wrap">
  <div class="head"><span class="h11-kick">The membership · on Skool</span><h2>Two ways in. <em>Both <i class="stress">free</i> for 7 days.</em></h2></div>
  <p class="home-membership-fit">It lives on Skool, the community app where the classroom and the group are. Standard teaches the build. Premium adds the sales training, every guide unlocked and content written for you every month. Starting from scratch? Either one works.</p>
  <MembershipPlans />
  <p class="home-premium-note"><a href="/membership#compare">See the full membership comparison</a></p>
  <div class="rv-row h11-rv4">{MEMBER_REVIEWS.map((r) => <ReviewBubble quote={r.quote} name={r.name} source={r.source} stars={r.stars} />)}</div>
</div></section>

<section class="home-course-zone" id="owned-website" aria-labelledby="owned-title">
<header class="home-course-heading home-inner"><span class="home-kicker">Have lessons, guides or posts?</span><h2 id="owned-title">The Weekend <em>Ecosystem™</em></h2><p>Turn the material you already made into your own website and blog, with email sign&#8209;ups connected, in one weekend. No paid product needed. No material yet? <a href="#blueprint">Start with the free&nbsp;Blueprint.</a></p></header>
<section class="fs sp r" aria-label="Your weekend website build"><div class="wrap">
  <div class="days">
    <div class="day fri"><h3>Friday</h3><ul><li><span>Material in different places</span></li><li><span>No website to send readers</span></li><li><span>No connected email sign-up</span></li></ul></div>
    <div class="arrow">→</div>
    <div class="day sun"><h3>Sunday</h3><ul><li>Your own website</li><li>A blog ready to publish</li><li>Email sign-ups connected</li></ul></div>
  </div>
</div></section>

<section class="we sp"><div class="wrap feature">
  <div class="pic"><div class="frame"><div class="bar"><i></i><i></i><i></i><span>Inside {WE.name}</span></div><img src="/images/brand/we-inside.webp" alt="Inside The Weekend Ecosystem course" width="1080" height="480" loading="lazy" decoding="async"></div><figure class="rv-bubble"><span class="rv-q o" aria-hidden="true">&ldquo;</span><span class="rv-stars" aria-label="5 out of 5">★★★★★</span><blockquote>{FEATURED.pull}</blockquote><figcaption><b><a href={FEATURED.url} rel="noopener" target="_blank">{FEATURED.name}</a></b>, {FEATURED.tenure}</figcaption><span class="rv-q c" aria-hidden="true">&rdquo;</span></figure><div class="sticker"><i class="in"></i><span>Built in one weekend</span></div></div>
  <div>
    <span class="h11-kick">The course · {WE.price}</span>
    <h3 class="home-course-subhead">Give your work <em>a home of its own.</em></h3>
    <p class="sub">Your website and blog, built in one weekend.</p>
    <div class="nums"><div><b>{WE.modules}</b>Modules</div><div><b>{WE.prompts}</b>Prompts</div><div><b>{WE.assetsPerArticle}</b>Posts per article</div></div>
    <ul class="res"><li>A live website on your own domain</li><li>Email sign-ups connected to your site</li><li>One prompt turns each article into {WE.assetsPerArticle} posts</li></ul>
    <div class="buy"><a class="h11-btn" href={WE.url}><b class="h11-full">Get {WE.name}</b><b class="h11-short" aria-hidden="true">Get the course · {WE.price}</b> <span aria-hidden="true">→</span></a><small>{WE.price}, or {WE.plan}. Yours for good, every future update included.</small><a class="h11-link" href={WE.preview}>See inside first, free</a></div>
  </div>
</div></section>
</section>

<section class="h11-help" aria-labelledby="help-title">
  <div class="h11-inner">
    <span class="h11-kick">Want it built with you?</span>
    <h2 id="help-title">More help, <em>when you're ready.</em></h2>
    <div class="h11-help-grid">
      <article class="h11-card">
        <span class="h11-label">Mentorship · founding cohort</span>
        <h3>Business Architect Mentorship Intensive™ <span class="h11-abbr">(BAMI)</span></h3>
        <p>Twelve weeks to build your offer, sales page, welcome emails and content system, with written review of your work at each of six phase gates.</p>
        <a class="h11-btn h11-btn--sm" href="/bami">Join the BAMI waitlist <span aria-hidden="true">→</span></a>
      </article>
      <article class="h11-card">
        <span class="h11-label">Done with you</span>
        <h3>Work With Me</h3>
        <p>An offer, a funnel and a system, built to work together. See the engagements and what each one includes.</p>
        <a class="h11-btn h11-btn--sm" href="/work-with-me">See how it works <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </div>
</section>

<section class="h11-more" aria-labelledby="more-title">
  <div class="h11-inner">
    <div class="h11-more-head"><div><span class="h11-kick">The free library</span><h2 id="more-title">Free guides. <em>Start with these.</em></h2></div><a class="h11-link" href="/learn">See every guide</a></div>
    <ul class="h11-guides">{guides.map((g) => <li><a href={`/learn/${g.slug}`}><span class="h11-label">{g.cat} · {g.read}</span><b>{g.t}</b><span class="h11-go" aria-hidden="true">→</span></a></li>)}</ul>
    <div class="h11-also">
      <span class="h11-kick">Also from The Digital Income Edit™</span>
      <ul>{alsoFrom.map((a) => <li><a href={a.href}><span class="h11-label">{a.label}</span><b>{a.title}</b><span class="h11-go" aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </div>
</section>

<section class="h11-close" aria-labelledby="close-title">
  <div class="h11-inner">
    <span class="h11-kick">Build it backwards</span>
    <h2 id="close-title">Stop saving videos. <em>Start <i class="stress">building.</i></em></h2>
    <p>Seven days free inside the membership. Cancel in Skool before the trial ends and you pay nothing.</p>
    <div class="h11-ctas h11-ctas--center"><a class="h11-btn" href={SKOOL_PLANS}>Start your 7 days free <span aria-hidden="true">→</span></a><a class="h11-link" href="#blueprint">Or get the free Blueprint</a></div>
  </div>
</section>
</main>
<div class="h11-sticky" aria-hidden="true" hidden><a class="h11-btn" href={SKOOL_PLANS} tabindex="-1">Start your 7 days free <span aria-hidden="true">→</span></a></div>
<script is:inline>
(function(){var bar=document.querySelector('.h11-sticky');if(!bar||!('IntersectionObserver' in window))return;bar.hidden=false;
var hide=new Set(),targets=['.h11-hero','#blueprint','.membership-offers','.h11-close','footer'].map(function(s){return document.querySelector(s)}).filter(Boolean);
var io=new IntersectionObserver(function(es){es.forEach(function(e){e.isIntersecting?hide.add(e.target):hide.delete(e.target)});bar.classList.toggle('on',hide.size===0)},{threshold:0});
targets.forEach(function(t){io.observe(t)});})();
</script>

<footer><div class="wrap"><a class="logo" href="/"><span class="l1">The Digital Income</span><span class="l2">Edit<sup>™</sup><i class="spark"></i></span><span class="rule"><i></i><b class="dot"></b><i></i></span></a>
<div class="fcols">
{FOOTER.map((col) => <div><h4>{col.h}</h4>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>)}
</div>
<p class="fsoc">{SOCIAL.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
<p class="fcopy">© 2026 The Digital Income Edit™ · <a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p>
</div></footer>
</body>

</html>
