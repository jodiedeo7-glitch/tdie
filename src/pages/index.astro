---
import visualStyles from "../styles/tdie-visual.css?inline";
import "../styles/global.css";
import "../styles/sales-typography.css";
import "../styles/edit.css";
// Homepage type, self-hosted: Newsreader SemiBold for display, Inter for everything else.
import "@fontsource/newsreader/latin-600.css";
import "@fontsource/inter/latin-400.css";
import "@fontsource/inter/latin-500.css";
import "@fontsource/inter/latin-600.css";
import "@fontsource/inter/latin-700.css";
import newsreader600 from "@fontsource/newsreader/files/newsreader-latin-600-normal.woff2?url";
import inter400 from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";

import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FreebieForm from "../components/FreebieForm.astro";
// Tina's words come from the single verbatim source, unedited.
import { membership as M, weekendEcosystem as WE, community, library, SKOOL_PLANS, cap } from "../data/facts.js";

const SITE = "https://www.thedigitalincomeedit.com";
const OG_IMAGE = `${SITE}/og/home-built-backwards-2026-09.jpg`;

const title = "Faceless Digital Business Built With AI | The Digital Income Edit™";
const description = `Build a faceless business with AI in the right order: offer, funnel, automation, then audience. ${community.members} women are building it inside The Digital Income Edit™.`;

// The Built Backwards Method. The order is the method.
const method = [
  { n: "01", name: "Offer", line: "What you sell, who pays for it, what it costs. Decided before a single post exists.", out: "One sentence, one buyer, one price." },
  { n: "02", name: "Funnel", line: "The road a stranger walks from free to paid: the free thing, the page, the emails that do the asking.", out: "A path that sells without you in the room." },
  { n: "03", name: "Automation", line: "AI and schedules take the repeat work. One article becomes 24 finished assets and the emails send themselves.", out: "A business that runs on the Tuesday you skip." },
  { n: "04", name: "Audience", line: "Only now do you turn on traffic, pointed at something that already knows what to do with a visitor.", out: "Attention that lands somewhere." },
];

// What Jodie refuses to teach, and why. Short, because the method already said it.
const differences = [
  { t: "Build the offer before the audience.", p: "Know what you're selling, who it's for and where the money comes from before you spend a year performing for strangers." },
  { t: "Show the business, not the screenshot.", p: "The site itself is the case study. Open the pages. Inspect the funnel. Look at the actual outputs." },
  { t: "Use AI as the build team — not the personality.", p: "AI can write, organize and build. It does not need to become the voice of your brand." },
  { t: "Build traffic into a business.", p: "Pinterest, email, content and social are useful when they lead somewhere. They are not the destination." },
];

// Proof by inspection. Every room is a live page, shown as it really looks.
const rooms = [
  { key: "course", room: "The course", t: "The Weekend Ecosystem™", p: "Look inside the course before you buy: the full module list and a real lesson. Free, no email.", href: WE.preview, path: "/weekend-ecosystem/preview", go: "Look inside the course" },
  { key: "offer", room: "Free tool", t: "The One-Sentence Offer tool", p: "Type what you sell and get it down to one clear sentence a buyer understands. Free.", href: "/resources/one-sentence-offer", path: "/resources/one-sentence-offer", go: "Try the free tool" },
  { key: "funnel", room: "Free email challenge", t: "The Weekend Build Challenge", p: "Five free emails, one small build a day, from no idea to your first offer.", href: "/resources/weekend-build-challenge", path: "/resources/weekend-build-challenge", go: "See the challenge" },
  { key: "library", room: "Free blog article", t: "Turn your Skool lessons into a blog", p: "A real article on this site that started as a Skool lesson. Read it free.", href: "/learn/turn-skool-content-into-a-blog", path: "/learn/turn-skool-content-into-a-blog", go: "Read the article" },
  { key: "classroom", room: "The membership", t: "The Skool classroom", p: `See what's inside the membership, where ${community.members} women build their faceless businesses.`, href: "/membership#room", path: "/membership", go: "See the membership" },
  { key: "email", room: "Free newsletter", t: "The Weekly Edit", p: "One useful idea every Sunday, sent by the same automation you'll learn to build.", href: "/newsletter", path: "/newsletter", go: "Read the newsletter" },
];

// A curated few of the pillar guides. The full library lives at /learn.
const guides = [
  { cat: "Business Systems", t: "How to Build a Faceless Digital Business", slug: "how-to-build-a-faceless-digital-business", read: "20 min" },
  { cat: "AI", t: "The Ultimate Beginner's Guide to AI", slug: "ultimate-guide-to-ai", read: "18 min" },
  { cat: "Blogging", t: "How to Turn Your Skool Content Into a Blog", slug: "turn-skool-content-into-a-blog", read: "14 min" },
  { cat: "Automation & Paid Traffic", t: "How to Automate Your Online Business", slug: "automating-your-online-business", read: "15 min" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", "@id": `${SITE}/#org`, name: "The Digital Income Edit™", url: `${SITE}/`, slogan: "Build Your Business Backwards. Scale It Forward.™",
      logo: `${SITE}/icon-512.png`,
      sameAs: ["https://pinterest.com/TheDigitalIncomeEditTDIE", "https://instagram.com/the.faceless.homestead.mama"] },
    { "@type": "WebSite", "@id": `${SITE}/#site`, url: `${SITE}/`, name: "The Digital Income Edit™", publisher: { "@id": `${SITE}/#org` } },
    { "@type": "WebPage", "@id": `${SITE}/#page`, url: `${SITE}/`, name: title, description, isPartOf: { "@id": `${SITE}/#site` } },
  ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Meta Pixel, dataset 1274879031402082 -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window,document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '1274879031402082');
    fbq('track', 'PageView');
  </script>
  <noscript><img height="1" width="1" style="display:none" alt=""
    src="https://www.facebook.com/tr?id=1274879031402082&ev=PageView&noscript=1" /></noscript>
  <!-- End Meta Pixel -->
  <meta name="google-site-verification" content="c0MzbaUMBCrxCzIuIJfqoxBus1ConcrweH0DkKajo_Y" />
  <meta name="p:domain_verify" content="6cee3a8fcd59239f253a242581e683ac" />
  <meta name="facebook-domain-verification" content="ez227fq8aajppa81pknp97e3mhkoeh" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#FBF8F5" />
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`${SITE}/`} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="The Digital Income Edit™" />
  <meta property="og:title" content="Build the whole business before anyone knows your name." />
  <meta property="og:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta property="og:url" content={`${SITE}/`} />
  <meta property="og:image" content={OG_IMAGE} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="The Digital Income Edit™: build the whole business before anyone knows your name. Offer, funnel, automation, audience." />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Build the whole business before anyone knows your name." />
  <meta name="twitter:description" content="The AI-built faceless business, built backwards: offer first, funnel second, automation third, audience last." />
  <meta name="twitter:image" content={OG_IMAGE} />
  <link rel="preload" as="font" type="font/woff2" href={newsreader600} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={inter400} crossorigin />
  <link rel="preload" as="image" type="image/webp"
        imagesrcset="/images/home/hero-pink-knit-desk-480.webp 480w, /images/home/hero-pink-knit-desk-720.webp 720w, /images/home/hero-pink-knit-desk-960.webp 960w"
        imagesizes="(max-width: 900px) 100vw, 44vw" fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <style>
    body.e-page::before,body.e-page::after{display:none}

    /* ============ ART DIRECTION · editorial overrides ============ */
    .e-page{background:var(--e-cream)}
    .cover{background:var(--e-cream);grid-template-columns:minmax(0,1.03fr) minmax(0,.97fr);min-height:calc(100vh - 58px);overflow:clip}
    .mast{background:var(--e-cream);position:relative;z-index:3}
    .cover-copy{position:relative;z-index:2;padding-right:clamp(24px,6vw,110px)}
    .cover h1{font-size:clamp(48px,5vw,76px);max-width:11.5ch;line-height:.92}
    .cover h1 em{margin-left:.22em}
    .cover .e-lede{max-width:31em;font-size:clamp(17px,1.45vw,20px);line-height:1.55}
    .cover-photo{min-height:680px;margin:clamp(30px,4vw,64px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) clamp(30px,4vw,64px) 0;box-shadow:0 0 0 1px rgba(26,20,23,.14)}
    .cover-photo img{object-position:35% 40%;transform:scale(1.025)}
    .cover-photo figcaption{right:auto;left:0;padding:10px 18px 10px 14px;background:var(--e-cream);border-right:1px solid rgba(26,20,23,.14);border-bottom:1px solid rgba(26,20,23,.14)}
    .cover-meta{border-top:1px solid rgba(26,20,23,.22);padding-top:14px;margin-top:30px}
    .cover-meta li{max-width:13em}
    .method-head{padding-top:clamp(10px,3vw,34px)}
    .method-head .e-d2{font-size:clamp(48px,6.2vw,94px);max-width:11ch}
    .recognition{padding-top:clamp(100px,12vw,180px);padding-bottom:clamp(100px,12vw,180px)}
    .recognition-copy h2{font-size:clamp(46px,6.6vw,100px);max-width:11ch}
    .recognition-list li{padding:22px 0;font-size:clamp(22px,2.3vw,34px);max-width:30em}
    .faceless{grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr)}
    .faceless-photo{min-height:720px}
    .faceless-copy{padding-left:clamp(40px,7vw,120px)}
    .faceless h2{font-size:clamp(52px,6.4vw,104px);max-width:9ch}
    .showroom{background:var(--e-white)}
    .show-head{grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr)}
    .show-head .e-d2{font-size:clamp(48px,6.4vw,94px);max-width:10ch}
    .rooms{gap:clamp(42px,5vw,82px) clamp(22px,3vw,52px)}
    .rooms li:nth-child(1){grid-column:span 4}
    .room .e-artifact{background:var(--e-cream);padding:10px}
    .room .e-art-img{overflow:hidden}
    .room .e-art-img img{transition:transform .5s cubic-bezier(.2,.7,.2,1)}
    .room:hover .e-art-img img{transform:scale(1.025)}
    .rooms li:nth-child(1) .room .e-art-img img{aspect-ratio:16/10}
    .room-body{padding:20px 2px 0}
    .rooms li:nth-child(1) .room-body h3{font-size:clamp(32px,3.4vw,48px);max-width:13ch}
    .flag{background:var(--e-paper)}
    .flag-grid{gap:clamp(52px,8vw,140px)}
    .flag-visual .photo{box-shadow:18px 18px 0 var(--e-blush)}
    .flag h2{font-size:clamp(48px,6vw,92px);max-width:10ch}
    .flag .for{font-size:18px;line-height:1.6}
    .ba{margin-top:44px}
    .ba h3{font-size:clamp(34px,3.2vw,48px)}
    .buy .e-price{font-size:clamp(64px,7vw,100px);line-height:.9}
    .fit-head .e-d2{font-size:clamp(48px,5.8vw,88px);max-width:11ch}
    .fit tbody tr{transition:background .2s}
    .fit tbody tr:not(.hl):hover{background:rgba(255,255,255,.7)}
    .mem-grid .std{margin-top:clamp(16px,3vw,42px);margin-bottom:clamp(16px,3vw,42px)}
    .mem-grid .prm{box-shadow:18px 18px 0 var(--e-blush)}
    .lib-head h2{font-size:clamp(38px,4.8vw,68px);max-width:14ch}
    .shelf{background:var(--e-paper)}
    .shelf a{min-height:300px;padding:26px 24px 28px}
    .shelf h3{font-size:clamp(23px,2.2vw,31px)}
    .letter{grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr)}
    .letter .e-figure{box-shadow:12px 12px 0 var(--e-blush)}
    @media(max-width:900px){
      .cover{min-height:0}
      .cover-photo{margin:0;min-height:0;aspect-ratio:4/3;box-shadow:none}
      .cover-photo img{transform:none}
      .faceless-photo{min-height:0}
      .faceless-copy{padding-left:var(--e-gut)}
      .show-head{grid-template-columns:1fr}
    }
    @media(max-width:620px){
      .cover h1{font-size:clamp(44px,10.5vw,62px);line-height:.94}
      .cover h1 em{margin-left:0}
      .recognition-copy h2{font-size:clamp(42px,12vw,64px)}
      .rooms li:nth-child(1) .room-body h3{font-size:32px}
      .flag h2{font-size:clamp(44px,12vw,62px)}
      .mem-grid .prm{box-shadow:10px 10px 0 var(--e-blush)}
    }

    /* ============ PROOF / PRODUCT · artifact-first treatment ============ */
    .show-head{margin-bottom:clamp(42px,6vw,76px)}
    .show-head>p{font-size:16px;line-height:1.7;max-width:30em;padding-top:14px}
    .room{display:block}
    .room .e-artifact{border:1px solid rgba(26,20,23,.16);box-shadow:0 12px 28px rgba(26,20,23,.06)}
    .room .e-artifact figcaption{display:flex;justify-content:space-between;gap:20px;padding:11px 6px 2px;font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--e-ink-3)}
    .room .e-artifact figcaption b{color:var(--e-ink);font-weight:700}
    .room-body p{max-width:36em;line-height:1.65}
    .room-body .go{display:inline-block;margin-top:10px;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase}
    .flag{overflow:clip}
    .flag-grid{align-items:center}
    .flag-visual{position:relative}
    .flag-visual .photo{margin-left:0}
    .flag-visual .e-artifact{border:1px solid rgba(26,20,23,.18);box-shadow:16px 16px 0 var(--e-blush)}
    .ba{display:grid;grid-template-columns:1fr auto 1fr;gap:clamp(18px,3vw,38px);align-items:center;border-top:1px solid var(--e-ink);border-bottom:1px solid rgba(26,20,23,.2);padding:28px 0;margin:48px 0 30px}
    .ba>div{min-height:150px}
    .ba .arrow{font-family:var(--e-serif);font-size:42px;color:var(--e-pink)}
    .ba .when{display:block;font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3);margin-bottom:8px}
    .ba h3{margin:0 0 14px;font-family:var(--e-serif);font-size:clamp(34px,3.4vw,52px);line-height:.95}
    .ba ul{margin:0;padding-left:18px;font-size:14px;line-height:1.65;color:var(--e-ink-2)}
    .evidence{display:flex;flex-wrap:wrap;gap:8px 28px;margin:0 0 30px;padding:0;list-style:none;border-bottom:1px solid rgba(26,20,23,.14);padding-bottom:22px}
    .evidence li{font-size:12px;letter-spacing:.05em;text-transform:uppercase;color:var(--e-ink-3)}
    .evidence b{font-family:var(--e-serif);font-size:22px;letter-spacing:0;text-transform:none;color:var(--e-ink);margin-right:5px}
    .buy{display:flex;align-items:end;gap:20px;margin:0 0 24px}
    .buy .e-price{margin:0}
    .buy .terms{margin:0 0 5px;font-size:13px;line-height:1.5;color:var(--e-ink-2)}
    .quote{margin:42px 0 0;padding:26px 0 0;border-top:1px solid rgba(26,20,23,.2)}
    .quote blockquote{font-family:var(--e-serif);font-size:clamp(22px,2.3vw,32px);line-height:1.18;margin:0 0 14px;max-width:28em}
    .quote figcaption{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--e-ink-3)}
    .quote figcaption strong{color:var(--e-ink);margin-right:8px}
    .quote .stars{display:block;margin-top:8px;color:var(--e-gold)}
    @media(max-width:760px){
      .ba{grid-template-columns:1fr;gap:22px}
      .ba .arrow{transform:rotate(90deg);justify-self:center}
      .ba>div{min-height:0}
      .buy{align-items:start}
      .quote{margin-top:30px}
    }

    /* ============ 1 · COVER ============ */
    .cover{position:relative;display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);min-height:min(92vh,900px);border-bottom:1px solid rgba(26,20,23,.18)}
    .mast{grid-column:1/-1;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut)));border-bottom:1px solid rgba(26,20,23,.14)}
    .mast span{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--e-ink-3)}
    .mast span:first-child{color:var(--e-pink-t)}
    .mast i{flex:1;height:1px;background:rgba(200,169,106,.6)}
    .cover-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(44px,6vw,104px) clamp(20px,4vw,64px) clamp(40px,5vw,80px) max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut)))}
    .cover .e-kick{margin-bottom:28px}
    .cover h1{font-size:clamp(48px,5vw,76px);line-height:.92;letter-spacing:-.04em;margin:0 0 28px;max-width:11.5ch}
    .cover h1 em{display:block}
    .cover .e-lede{font-size:clamp(17px,1.35vw,19px);max-width:31em;margin-bottom:30px;color:var(--e-ink-2)}
    .cover .e-lede strong{color:var(--e-ink);font-weight:600}
    .cover-meta{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;margin:26px 0 0;padding:20px 0 0;list-style:none;border-top:1px solid rgba(26,20,23,.16);color:var(--e-ink-3)}
    .cover-meta li{max-width:none;text-align:center;padding:0 12px;line-height:1.4}
    .cover-meta li+li{border-left:1px solid rgba(26,20,23,.12)}
    .cover-meta b{display:block;font-family:var(--e-serif);font-weight:600;font-size:26px;line-height:1.1;color:var(--e-ink);margin:0 0 7px;letter-spacing:-.02em}
    .cover-meta span{display:block;font-size:12px;line-height:1.45}
    .cover-photo{position:relative;margin:0;min-height:460px;background:var(--e-paper);overflow:hidden}
    .cover-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:32% 40%}
    .cover-photo figcaption{position:absolute;right:0;top:0;background:var(--e-cream);padding:0 max(var(--e-gut),calc((100vw - var(--e-w))/2 + var(--e-gut))) 12px 18px;line-height:1.5}
    .cover-photo figcaption .e-credit{display:block}
    @media(max-width:900px){
      .cover{grid-template-columns:1fr;min-height:0}
      .mast{padding:12px var(--e-gut)}
      .mast span:last-child{display:none}
      .cover-copy{padding:36px var(--e-gut) 40px}
      .cover h1{font-size:clamp(44px,10.5vw,62px);line-height:.94}
      .cover-photo{min-height:0;aspect-ratio:4/3;max-height:640px}
      .cover-photo img{object-position:30% 38%}
      .cover .e-actions .e-btn{width:100%}
      .cover-photo figcaption{display:none}
      .cover-copy{padding-bottom:26px}
      .cover-copy .e-actions{display:flex;flex-direction:column;align-items:stretch;gap:12px}
      .cover-copy .e-actions .e-btn{min-height:48px;padding:13px 16px;font-size:12px;letter-spacing:.09em;border-radius:8px}
      .cover-copy .e-actions .e-link{align-self:center;font-size:14px;font-weight:500;line-height:1.5;text-decoration:none;padding:5px 0}
      .cover-copy .e-actions .e-link:hover{text-decoration:underline;text-underline-offset:4px}
      .cover-meta{margin-top:20px;padding-top:18px}
      .cover-meta li{padding:0 7px}
      .cover-meta span{font-size:11.5px}
    }

    /* ============ 2 · BUILT BACKWARDS: the staircase ============ */
    .method-head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:clamp(24px,5vw,80px);align-items:end;margin-bottom:clamp(48px,7vw,96px)}
    .method-head .e-d2{margin:0;font-size:clamp(40px,5.6vw,80px)}
    .forwards{margin:0;font-size:15px;line-height:1.7;color:var(--e-ink-2);padding-left:22px;border-left:1px solid rgba(200,169,106,.7)}
    .forwards .fw{display:block;margin-bottom:10px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3)}
    .forwards s{text-decoration-color:var(--e-pink);text-decoration-thickness:2px}
    .forwards strong{display:block;margin-top:12px;color:var(--e-ink);font-weight:600;font-size:16px}
    .stair{list-style:none;margin:0;padding:0;position:relative;counter-reset:s}
    .stair::before{content:"";position:absolute;left:clamp(14px,2.2vw,30px);top:10px;bottom:10px;width:2px;background:linear-gradient(var(--e-pink),var(--e-pink)) top/2px 100% no-repeat;opacity:.9}
    .step{--i:0;position:relative;display:grid;grid-template-columns:clamp(44px,6vw,84px) minmax(0,1fr) minmax(0,.5fr);gap:clamp(12px,2.4vw,40px);align-items:end;padding:clamp(16px,2.2vw,28px) 0;border-bottom:1px solid rgba(26,20,23,.14)}
    .step:first-child{border-top:1px solid var(--e-ink)}
