      .step::before{content:"";position:absolute;left:-31px;top:34px;width:16px;height:16px;border-radius:50%;background:var(--hp-pink);box-shadow:0 0 0 4px var(--hp-cream)}
      .step .num{font-size:46px}
    }

    /* ============ POINT OF VIEW ============ */
    .pov{background:linear-gradient(180deg,var(--hp-cream) 0%,#FDEFF5 100%)}
    .pov-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(40px,6vw,80px);align-items:start}
    .pov-fig{position:sticky;top:100px}
