---
import PageLayout from "../../layouts/PageLayout.astro";
import Testimonial from "../../components/Testimonial.astro";
import { Image } from "astro:assets";

// The While-You-Sleep Storefront(TM). Standalone Beacons product, never included
// free in any tier. Canon row drafted in ops/cloud-output/storefront-product/
// CANON_ROWS_DRAFT.md and registered at the desktop finish before this merges.
// Proof is the machine only: never a sales, commission or income claim. This page
// carries the Meta Pixel, so no earnings figures and no affiliate rate appear on it.
// Every image below is one of Jodie's own published pins from src/lifestyle/.

import witchFlat from "../../lifestyle/pink-witch-halloween-costume-flatlay.jpg";
import witchLife from "../../lifestyle/pink-witch-halloween-costume-lifestyle.jpg";
import officeFlat from "../../lifestyle/pink-workwear-freezing-office-flatlay.jpg";
import catLife from "../../lifestyle/pink-cat-halloween-costume-lifestyle.jpg";
import angelFlat from "../../lifestyle/pink-angel-halloween-costume-flatlay.jpg";
import suitLife from "../../lifestyle/pink-suit-law-student-halloween-costume-lifestyle.jpg";
import porchFlat from "../../lifestyle/pink-halloween-porch-decor-flatlay.jpg";
import sequinLife from "../../lifestyle/pink-sequin-mini-dress-halloween-costume-lifestyle.jpg";

// The public Beacons product, rebuilt 2 Oct 2026 (Decision 123). Unlisted until launch.
const CHECKOUT = "https://links.thedigitalincomeedit.com/shop/66271fb0-fc54-4aae-ad9f-c826f4635ee7";
const JOIN = "https://www.skool.com/thedigitalincomeedit/plans";

// Eastern times as UTC (EDT is UTC-4 until 1 Nov 2026). Decision 123, 1 Oct 2026.
// soon: before the member presale. presale: Skool members only, no public checkout.
// sale: launch weekend, $27 against the regular $37, with a countdown. regular: $37 for everyone.
const PRESALE_OPENS = "2026-10-05T23:00:00Z"; // Mon 5 Oct 2026, 7:00 pm ET
const PUBLIC_PRICE_AT = "2026-10-09T13:00:00Z"; // Fri 9 Oct 2026, 9:00 am ET
const SALE_ENDS = "2026-10-12T04:00:00Z"; // Sun 11 Oct 2026, 11:59 pm ET (midnight)
const stageAt = (t) => t < Date.parse(PRESALE_OPENS) ? "soon" : t < Date.parse(PUBLIC_PRICE_AT) ? "presale" : t < Date.parse(SALE_ENDS) ? "sale" : "regular";
// RELEASE HOLD (Jodie, 2 Oct 2026, 8:55 pm ET): the kit is not released. While HOLD is true the
// page never opens the presale, never shows the checkout and ignores the dates above.
// Set HOLD to false only when Jodie releases the kit.
const HOLD = true;
const stage = HOLD ? "held" : stageAt(Date.now());

const proof = [
  { img: witchFlat, alt: "Overhead flat lay on pink satin of a pink velvet witch hat, black velvet mini dress, pink lace gloves, black platform Mary Janes, gold moon earrings and a black crescent bag.", cap: "Pin 1 · flat lay" },
  { img: witchLife, alt: "Mirror selfie in a farmhouse hallway of a woman in a black velvet mini dress, pink velvet witch hat, pink lace gloves and black Mary Janes, holding a pink tumbler.", cap: "Pin 2 · three days later" },
  { img: officeFlat, alt: "That girl collage on blush pink of a pink cable knit cardigan, beige wide leg trousers, black penny loafers, brown leather laptop tote, pearl stud earrings and a hot pink tumbler.", cap: "Evergreen collage" },
  { img: catLife, alt: "Woman walking down farmhouse porch steps at dusk in a pink sweater dress, pink cat ears, white thigh high socks and bow flats, carrying a pink heart bag and tumbler.", cap: "Lifestyle · walk-away" },
  { img: angelFlat, alt: "That girl collage on blush pink of a hot pink ruffle dress, pink feather angel wings, a white feather halo, white platform heels, a pink rose clutch and silver star earrings.", cap: "Collage" },
  { img: suitLife, alt: "Woman taking a full length mirror selfie in a bright bedroom, wearing a hot pink skirt suit, pearls, a pink velvet headband and pink patent pumps, holding a pink satchel.", cap: "Lifestyle" },
  { img: porchFlat, alt: "Overhead photo of a white painted porch floor with pink velvet pumpkins, a pink ghost print candy basket, a pink check BOO ghost door sign, hot pink creepy cloth and a pink SPOOKY ghost doormat.", cap: "Theme list" },
  { img: sequinLife, alt: "Woman at a Halloween house party under string lights, wearing a hot pink sequin mini dress, hot pink tassel earrings and silver strappy heels, holding a rose gold glitter clutch.", cap: "Lifestyle" },
];

const steps = [
  { n: "01", t: "Plan a look", p: "Use your configured theme, schedule, and eligible look ideas to prepare a bounded draft." },
  { n: "02", t: "Use approved product inputs", p: "Work from product details and affiliate links you provide or an authorized integration available to your account. Do not assume Amazon API access." },
  { n: "03", t: "Prepare a destination", p: "Use your eligible Idea List or website path. A destination must resolve before a Pin can be approved for scheduling." },
  { n: "04", t: "Prepare Pin drafts", p: "Create images and Pin copy with disclosure and alt text, then check framing, product fidelity, and metadata." },
  { n: "05", t: "Review, authorize, and track", p: "You select each exact Pin and authorize its schedule. Record only the status the selected publisher confirms." },
];

const needs = [
  "A ChatGPT account with Work and Scheduled Tasks available for the chosen workflow",
  "A supported Cloud or Local execution mode and the needed connected actions",
  "Amazon Associates, plus Influencer approval for Idea Lists",
  "Amazon Creators API access (Amazon opens it at 10 qualifying sales in 30 days) for automatic product finding",
  "A Pinterest business account and a public board verifiable through a supported path",
  "A connected image provider and supported model if your chosen path requires one",
  "A connected Metricool account only if you choose TIME-SAVING publishing; scheduling remains account-dependent until tested",
];

const inside = [
  "A guided setup prompt that records your choices and account-specific blockers",
  "The themed-look recipe, for any theme and any season",
  "The Brand Closet™ Outfit of the Day recipe, for members of Rose's community",
  "Three canonical recurring task prompts: weekly planning, optional Outfit of the Day, and reconciliation",
  "Persona and no-persona paths, Influencer and Associates-only paths",
  "The blog half, for any site on GitHub",
  "A Preparation Guide and a Setup Guide, with every prompt printed in full",
];
---
<PageLayout
  wide
  ogImage={witchFlat.src}
  title="The While-You-Sleep Storefront™ · Amazon Pins on a Schedule"
  description="A guided workflow for turning approved Amazon product inputs into reviewable Pinterest Pin drafts, with customer approval before each schedule."
>
  <section class="ws-hero">
    <div class="page-eyebrow">Amazon links to Pinterest pins · on a schedule</div>
    <h1>The <em>While-You-Sleep</em> Storefront™</h1>
    <p class="lede">Turn your approved Amazon product inputs into Pinterest Pin drafts, with images and copy prepared for your review. You choose each finished Pin and authorize its schedule after checking the destination, board, disclosure, and details.</p>
    <div class="ws-cta-row">
      <a class="btn" href="#buy">See exactly what you get <span class="a">→</span></a>
      <a class="ws-link" href="#proof">See the real pins first →</a>
    </div>
    <ul class="ws-trust">
      <li>Guided setup; timing depends on your accounts</li>
      <li>Review and approve each Pin before scheduling</li>
      <li>Cloud or local execution, when available</li>
    </ul>
  </section>

  <section class="ws-strip" id="proof">
    {proof.slice(0, 4).map((p) => (
      <figure><Image src={p.img} alt={p.alt} widths={[240, 360, 480]} sizes="(max-width: 700px) 45vw, 230px" /><figcaption>{p.cap}</figcaption></figure>
    ))}
  </section>
  <p class="ws-note">Examples from Jodie's own workflow. They do not verify the customer account setup or show retail products unless identified as such.</p>

  <section class="ws-sec">
    <div class="ws-kicker">The problem nobody says out loud</div>
    <h2>If the sale depends on you being online, <em>it's not passive yet.</em></h2>
    <p class="ws-p">Posting, replying, filming the reel, filming it again because the light changed. The feed forgets you by Wednesday and you start over on Thursday. That's not a business that runs while you sleep. That's a second shift.</p>
    <p class="ws-p">Pinterest works the other way round. Nobody's there to be entertained. They're typing "pink witch costume" or "cozy fall outfit" into a search bar with their wallet already half open. A pin you schedule today can still be found months from now. The only job is making sure something of yours is there when they search.</p>
    <p class="ws-p">So I stopped doing that job myself.</p>
  </section>

  <section class="ws-sec ws-tint">
    <div class="ws-kicker">What the tasks can help prepare</div>
    <h2>Five jobs the workflow can help prepare.</h2>
    <div class="ws-steps">
      {steps.map((s) => (
        <div class="ws-step"><span class="ws-num">{s.n}</span><h3>{s.t}</h3><p>{s.p}</p></div>
      ))}
    </div>
    <p class="ws-close">No prices on any pin, no brand names in any listing, and Amazon's own photos never posted: they're only the reference for new images.</p>
  </section>

  <section class="ws-sec">
    <div class="ws-kicker">Two content workflows and reconciliation</div>
  <h2>Your themed workflow, plus an optional Outfit of the Day path.</h2>
    <div class="ws-grid-2">
      <div class="ws-card">
        <h3>Themed looks</h3>
        <p>On the configured schedule, prepare look drafts for your theme: cozy mom, coastal home, pink everything, dark academia, or another customer-selected direction. Cadence depends on your setup and account.</p>
      </div>
      <div class="ws-card ws-card-pink">
        <h3>The Brand Closet™ Outfit of the Day</h3>
        <p>If you have the required Brand Closet™ access, the optional workflow can use lesson topics as inspiration to prepare original drafts with your approved product inputs. It does not reuse member-only materials. You review each Pin and authorize any schedule.</p>
      </div>
    </div>
  </section>

  <section class="ws-sec">
    <div class="ws-kicker">The receipts, from my own log</div>
    <h2>The machine, not a payout.</h2>
    <div class="ws-stats">
      <div><span class="ws-stat">15</span><span class="ws-statlab">Looks built</span></div>
      <div><span class="ws-stat">15</span><span class="ws-statlab">Idea Lists</span></div>
      <div><span class="ws-stat">15</span><span class="ws-statlab">Shop-the-look pages live</span></div>
      <div><span class="ws-stat">84</span><span class="ws-statlab">Tagged product links</span></div>
      <div><span class="ws-stat">26</span><span class="ws-statlab">Pins built</span></div>
    </div>
    <p class="ws-p">These figures describe Jodie's historical workflow records, not customer results or proof that the current customer Work, Drive, and publisher path has passed an end-to-end test. No sales or income claim is being made. Setup time varies with account access, board checks, connections, task configuration, and first-run review.</p>
    <div class="ws-gallery">
      {proof.slice(4).map((p) => (
        <figure><Image src={p.img} alt={p.alt} widths={[240, 360, 480]} sizes="(max-width: 700px) 45vw, 230px" /><figcaption>{p.cap}</figcaption></figure>
      ))}
    </div>
  </section>

  <section class="ws-sec">
    <div class="ws-kicker">Up front, so nobody's surprised</div>
    <h2>What you need before you buy.</h2>
    <div class="ws-grid-2">
      <div class="ws-card">
        <ul class="ws-yes">{needs.map((n) => (<li>{n}</li>))}</ul>
        <p class="ws-fine-dark">The Outfit of the Day line also needs authorized access to the relevant Brand Closet™ lesson. It is optional. TIME-SAVING publishing additionally requires a connected Metricool account and a successful account-specific test.</p>
      </div>
      <div class="ws-card ws-callout">
        <h3>The honest part</h3>
        <p>Automatic product finding isn't ready yet. It needs Amazon's Creators API, which Amazon opens at 10 qualifying sales in 30 days, and a tested ChatGPT connection to it. No such connection has been tested in any account yet, mine included, and being eligible doesn't prove one works.</p>
        <p>Cloud execution may work while your computer is off when enabled for your account and required connections. Local runs need your computer and any required local session. Do not assume missed work catches up automatically.</p>
        <p>Every Pin begins as a draft. You choose the exact finished Pin and authorize its schedule after review. Cancellation or removal depends on the connected publisher and may require action in Pinterest.</p>
      </div>
    </div>
  </section>

  <section class="ws-sec">
    <div class="ws-kicker">The blog half</div>
    <h2>Have The Weekend Ecosystem™? Your looks become pages Google can find.</h2>
    <p class="ws-p">One paste adds a shop-the-look section to your own site, with every look page written for search. My Pinterest block is on my domain only, so your pins can link to your own pages.</p>
    <p class="ws-p">No site? You can point your pins at Idea Lists you make yourself from the machine's look plan. And if you ever want the blog half, <a href="/shop/weekend-ecosystem">The Weekend Ecosystem™</a> is $97 one-time, or 3 × $33.33. Here's what one owner said about building her site with it:</p>
    <Testimonial variant="line" />
  </section>

  <section class="ws-sec" id="buy">
    <div class="ws-kicker">The price</div>
    <div class="ws-price-box">
      <div class="ws-price-state" data-stage="held" hidden={stage !== "held"}>
        <div class="ws-price-fig">Not on sale yet</div>
        <p class="ws-price-when">The While-You-Sleep Storefront™ isn't on sale yet, and there's no presale open. Members of The Digital Income Edit™ community on Skool will hear first when it is.</p>
      </div>
      <div class="ws-price-state" data-stage="soon" hidden={stage !== "soon"}>
        <div class="ws-price-fig">Members first</div>
        <p class="ws-price-when">The presale is for members of The Digital Income Edit™ community on Skool only. It opens Monday 5 October, 7:00 pm Eastern. It goes public on Friday 9 October.</p>
        <p class="ws-price-when">Not a member yet? Membership Standard starts with a 7-day free trial, then $9/month, and the member price is waiting inside.</p>
      </div>
      <div class="ws-price-state" data-stage="presale" hidden={stage !== "presale"}>
        <div class="ws-price-fig">Members only</div>
        <p class="ws-price-when">The presale is open now for members of The Digital Income Edit™ community on Skool, until Thursday 8 October, 11:59 pm Eastern. It isn't on the public shop until Friday 9 October.</p>
        <p class="ws-price-when">Not a member yet? Membership Standard starts with a 7-day free trial, then $9/month, and the member price is waiting inside.</p>
      </div>
      <div class="ws-price-state" data-stage="sale" hidden={stage !== "sale"}>
        <div class="ws-price-fig"><s class="ws-was">$37</s> $27<span> launch weekend</span></div>
        <p class="ws-price-when">The launch price ends Sunday 11 October, 11:59 pm Eastern. From Monday it's $37.</p>
        <p class="ws-count" data-ends={SALE_ENDS} aria-live="polite"></p>
      </div>
      <div class="ws-price-state" data-stage="regular" hidden={stage !== "regular"}>
        <div class="ws-price-fig">$37<span> one-time</span></div>
        <p class="ws-price-when">The whole kit, yours to keep.</p>
      </div>
      <ul class="ws-price-list">{inside.map((i) => (<li>{i}</li>))}</ul>
      <a class="btn ws-buy ws-join" href={JOIN} rel="noopener" hidden={stage === "sale" || stage === "regular"}>Join the community <span class="a">→</span></a>
      <a class="btn ws-buy ws-checkout" href={CHECKOUT} rel="noopener" hidden={stage === "held" || stage === "soon" || stage === "presale"}>Get The While-You-Sleep Storefront™ <span class="a">→</span></a>
      <p class="ws-fine">No refunds on digital products.</p>
    </div>
  </section>

  <section class="ws-sec ws-tint">
    <div class="ws-kicker">Questions</div>
    <h2>Asked, answered.</h2>
    <details class="ws-faq"><summary>Do I need to be good at tech?</summary>
      <p>The guide uses plain language and a guided setup prompt. The number of questions depends on your account path and choices. You configure only the tasks and connected actions available to you.</p></details>
    <details class="ws-faq"><summary>Does my computer have to stay on?</summary>
      <p>It depends on the execution mode available to your account. Supported Cloud runs may work with your computer off; Local runs require your computer and any needed local session. Missed-run recovery must be verified in your own setup.</p></details>
    <details class="ws-faq"><summary>Will Pins publish without my approval?</summary>
      <p>No. Each Pin stays a draft until you select that exact finished Pin and authorize its schedule after checking the image, destination, public board, disclosure, title, and alt text. A setup test does not prove that future runs or publishing will work unattended.</p></details>
    <details class="ws-faq"><summary>What if I don't have an AI persona?</summary>
      <p>Take the no-persona path: the workflow uses flat lays and collages. Use an image provider and model confirmed available in your own account.</p></details>
    <details class="ws-faq"><summary>I'm an Amazon Associate but not an Influencer yet.</summary>
      <p>There's an Associates-only path that uses a page on your own site as the destination. The kit describes supported page-file and site workflows; what can be written or published depends on your site platform and connected actions, and may require your own steps. Influencer approval allows the Idea List path without a website.</p></details>
    <details class="ws-faq"><summary>Will it make me money?</summary>
      <p>I can't promise that and neither can anyone honest. Pinterest is search, and pins get found over weeks and months. This builds and runs the machine. What people buy is up to them and Amazon.</p></details>
    <details class="ws-faq"><summary>Do I have to post on Instagram?</summary>
      <p>No. Instagram isn't part of the machine. There's an optional add-on page for feed posts, and it says plainly that stories are posted by hand.</p></details>
  </section>

  <section class="ws-final">
    <h2>People are searching for you. Be there when they do.</h2>
    <a class="ws-link" href="#buy">Back to the price →</a>
  </section>

  <p style="margin-top:60px"><a href="/shop" style="color:var(--pink);font-weight:500">← Back to the Shop</a></p>

<script is:inline define:vars={{ PRESALE_OPENS, PUBLIC_PRICE_AT, SALE_ENDS, HOLD }}>
  (() => {
    if (HOLD) return;
    const stageAt = (t) => t < Date.parse(PRESALE_OPENS) ? "soon" : t < Date.parse(PUBLIC_PRICE_AT) ? "presale" : t < Date.parse(SALE_ENDS) ? "sale" : "regular";
    const apply = () => {
      const s = stageAt(Date.now());
      document.querySelectorAll(".ws-price-state").forEach((el) => { el.hidden = el.dataset.stage !== s; });
      const pre = s === "soon" || s === "presale";
      const join = document.querySelector(".ws-join");
      const buy = document.querySelector(".ws-checkout");
      if (join) join.hidden = !pre;
      if (buy) buy.hidden = pre;
      const c = document.querySelector(".ws-count");
      if (c && s === "sale") {
        const left = Math.max(0, Date.parse(SALE_ENDS) - Date.now());
        const d = Math.floor(left / 86400000), h = Math.floor(left / 3600000) % 24, m = Math.floor(left / 60000) % 60, sec = Math.floor(left / 1000) % 60;
        c.textContent = (d ? d + "d " : "") + h + "h " + String(m).padStart(2, "0") + "m " + String(sec).padStart(2, "0") + "s left at $27";
      }
      return s;
    };
    apply();
    setInterval(apply, 1000);
  })();
</script>
</PageLayout>

<style>
  .ws-hero{max-width:760px;margin:0 auto}
  .ws-hero h1 em{font-style:normal;color:var(--pink)}
  .ws-cta-row{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin:4px 0 26px}
  .ws-link{color:var(--pink-deep);font-weight:500;font-size:15px}
  .ws-trust{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:9px}
  .ws-trust li{font-size:11.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--pink-deep);background:var(--rose);border-radius:999px;padding:8px 16px;margin:0}

  .ws-strip,.ws-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin:52px 0 10px}
  .ws-strip figure,.ws-gallery figure{margin:0}
  .ws-strip img,.ws-gallery img{width:100%;height:auto;aspect-ratio:2/3;object-fit:cover;display:block;border-radius:12px;box-shadow:0 26px 44px -26px rgba(214,46,115,.45)}
  .ws-strip figure:nth-child(odd){transform:rotate(-1.2deg)}
  .ws-strip figure:nth-child(even){transform:rotate(1.2deg) translateY(10px)}
  .ws-strip figcaption,.ws-gallery figcaption{font-size:10.5px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pink-deep);margin-top:12px}
  .ws-note{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--choc-mute);text-align:center;margin:18px auto 0;max-width:52ch}

  .ws-sec{max-width:1000px;margin:0 auto;padding:72px 0;border-top:1px solid var(--gray)}
  .ws-sec.ws-tint{background:linear-gradient(160deg,var(--rose) 0%,var(--blush) 100%);border-radius:18px;padding:60px 44px;margin:72px auto;border-top:none}
  .ws-kicker{font-size:11.5px;letter-spacing:2.6px;text-transform:uppercase;color:var(--pink-deep);margin-bottom:16px;font-weight:600}
  .ws-sec h2,.ws-final h2{font-family:var(--display);font-weight:600;font-size:clamp(27px,3.6vw,40px);line-height:1.15;letter-spacing:-.4px;margin:0 0 26px;max-width:24ch;color:#1A1417}
  .ws-sec h3{font-family:var(--display);font-weight:600;font-size:21px;margin:0 0 9px;line-height:1.25;color:var(--pink-deep)}
  .ws-p{font-size:17px;line-height:1.75;color:var(--choc-soft);max-width:66ch;margin:0 0 16px}
  .ws-p a{color:var(--pink);font-weight:500}
  .ws-close{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--choc-soft);margin-top:30px}

  .ws-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:16px}
  .ws-step{background:rgba(255,253,252,.86);border:1px solid rgba(200,169,106,.5);border-radius:16px;padding:22px 18px;box-shadow:0 26px 44px -30px rgba(214,46,115,.45)}
  .ws-step p{font-size:14.5px;line-height:1.6;margin:0;color:var(--choc-soft)}
  .ws-num{display:inline-grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--pink);color:var(--white);font:600 15px/1 var(--display);margin-bottom:12px}

  .ws-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .ws-card{background:var(--white);border:1px solid rgba(200,169,106,.5);border-radius:16px;padding:30px;box-shadow:0 30px 50px -34px rgba(214,46,115,.45)}
  .ws-card p{font-size:15.5px;line-height:1.7;margin:0 0 10px;color:var(--choc-soft)}
  .ws-card p:last-child{margin-bottom:0}
  .ws-card-pink{background:linear-gradient(140deg,#F0589A 0%,var(--pink) 55%,var(--pink-deep) 100%);border:none}
  .ws-card-pink h3,.ws-card-pink p{color:var(--white)}
  .ws-callout{border-left:4px solid var(--pink);background:var(--rose)}
  .ws-fine-dark{font-size:14px!important;color:var(--choc-mute)!important;margin-top:14px!important}

  .ws-yes{list-style:none;padding:0;margin:0}
  .ws-yes li{font-size:15.5px;line-height:1.55;margin-bottom:12px;padding-left:28px;position:relative;color:#1A1417}
  .ws-yes li::before{content:"✓";position:absolute;left:0;color:var(--pink);font-weight:700}

  .ws-stats{display:grid;grid-template-columns:repeat(5,1fr);gap:14px;margin:0 0 28px}
  .ws-stats div{background:var(--white);border:1px solid rgba(200,169,106,.5);border-radius:14px;padding:20px 10px;text-align:center}
  .ws-stat{display:block;font-family:var(--display);font-weight:600;font-size:40px;line-height:1;color:var(--pink)}
  .ws-statlab{display:block;font-size:10.5px;letter-spacing:1.6px;text-transform:uppercase;color:var(--choc-mute);margin-top:8px}

  .ws-price-box{background:var(--white);border:2px solid var(--ink);border-radius:2px;padding:44px;text-align:center;box-shadow:none;max-width:640px;margin:0 auto;position:relative}
.ws-price-box::before{content:"THE EDIT";position:absolute;top:-1px;left:0;background:var(--ink);color:var(--white);padding:7px 10px;font:700 9px/1 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase}
  .ws-price-fig{font-family:var(--display);font-weight:600;font-size:64px;line-height:1;margin-bottom:8px;color:var(--pink)}
