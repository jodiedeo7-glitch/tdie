<style is:global set:html={`*{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:clip}
body{margin:0;overflow-x:clip;font-family:'Jost',system-ui,sans-serif;color:#2A1A22;font-size:18px;line-height:1.45;background:#FBF4F2 url(/wys-new/bg.jpg) repeat;background-size:760px}
img{max-width:100%;display:block}
a{color:#C2185B}
a:focus-visible,button:focus-visible,summary:focus-visible{outline:3px solid #1A1417;outline-offset:3px}
.wrap{max-width:1040px;margin:0 auto;padding:0 28px}

/* header */
.top{position:sticky;top:0;z-index:30;background:#fff;border-bottom:4px solid #F6C9DA;height:60px;display:flex;align-items:center;justify-content:center}
.top a.brand{font-family:'Playfair Display',serif;font-weight:700;font-size:25px;color:#1A1417;text-decoration:none}
.menubtn{position:absolute;right:14px;top:8px;width:44px;height:44px;border:0;background:none;cursor:pointer;display:flex;align-items:center;justify-content:center}
.menu{display:none;position:absolute;right:10px;top:60px;background:#fff;border:1px solid #F1BBD0;box-shadow:0 10px 24px rgba(26,20,23,.14);padding:6px 0;min-width:270px}
.menu.open{display:block}
.menu a{display:block;padding:13px 20px;color:#9E1C55;text-decoration:none;font-weight:600}
.menu a:hover{background:#FCE7EF}

/* hero */
.hero{position:relative;overflow:hidden;background:#F9E6EA}
.hero>img.ph{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:right center}
.hero .in{position:relative;max-width:1180px;margin:0 auto;padding:56px 28px 64px;min-height:560px;display:flex;align-items:center}
.hero .copy{max-width:470px}
h1.big{font-family:'Playfair Display',serif;font-weight:800;font-size:66px;line-height:1.02;margin:0;color:#C2185B;background:linear-gradient(180deg,#D62E73 0%,#A81652 100%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;text-shadow:none}
.name{display:inline-block;background:url(/wys-new/brush-hot.png) center/100% 100% no-repeat;padding:18px 54px 22px 40px;margin:18px 0 14px -18px;transform:rotate(-3deg)}
.name span{display:block;font-family:'Satisfy',cursive;color:#fff;font-size:40px;line-height:1.02;text-align:center;text-shadow:0 1px 2px rgba(120,10,60,.25)}
.hero p.sub{font-size:20px;font-weight:500;margin:0 0 26px;max-width:400px}
.btn{display:inline-flex;align-items:center;gap:12px;min-height:58px;padding:0 34px;border-radius:12px;background:linear-gradient(180deg,#E0457F,#C2185B);color:#fff;font-weight:700;font-size:20px;letter-spacing:.03em;text-transform:uppercase;text-decoration:none;box-shadow:0 8px 18px rgba(194,24,91,.32)}
.btn:hover{background:#A81652;color:#fff}
.btn svg{flex:0 0 auto}

/* titles */
.sec{padding:30px 0}
.t{text-align:center;margin:0 0 22px}
.t h2{display:inline-block;margin:0;padding:16px 70px 20px;background:url(/wys-new/brush-light.png) center/100% 100% no-repeat;font-family:'Satisfy',cursive;font-weight:400;font-size:52px;line-height:1;color:#9E1C55;transform:rotate(-1deg)}
.paper{background:url(/wys-new/paper-pink.png) center/100% 100% no-repeat;padding:40px 40px 38px;position:relative}
.paper.cream{background-image:url(/wys-new/paper-cream.png)}
.tape{position:absolute;top:-16px;left:-30px;width:110px;transform:rotate(-36deg);z-index:2}
.ttl{font-family:'Satisfy',cursive;font-weight:400;font-size:50px;color:#9E1C55;margin:0 0 14px;line-height:1}
.ck{display:flex;gap:12px;align-items:flex-start;margin:0 0 10px;font-size:19px}
.ck svg{flex:0 0 22px;margin-top:4px}

.ps{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(0,.88fr);gap:34px;align-items:start}
.sol .sh{display:inline-block;background:url(/wys-new/brush-light.png) center/100% 100% no-repeat;padding:12px 44px 16px 26px;margin:6px 0 14px}
.sol .sh h2{margin:0}
.sol p{font-size:20px;margin:0}
.heart{width:70px}

/* before after */
.ba{display:grid;grid-template-columns:minmax(0,1fr) 120px minmax(0,1fr);align-items:center;gap:8px;position:relative}
.mon{background:#1F1A1D;border-radius:16px;padding:12px 12px 16px;box-shadow:0 14px 28px rgba(26,20,23,.26)}
.mon .bar{display:flex;align-items:center;gap:7px;height:26px;background:#2E282B;border-radius:7px;padding:0 10px;margin-bottom:9px}
.mon .bar i{width:8px;height:8px;border-radius:50%;background:#6E6468;display:block}
.mon .bar b{flex:1;height:14px;background:#fff;border-radius:7px;margin-left:12px;font-size:9px;font-weight:400;color:#888;padding-left:8px;line-height:14px}
.mon .scr{background:#fff;border-radius:5px;aspect-ratio:16/10;overflow:hidden}
.mon .empty{height:100%;display:flex;align-items:center;justify-content:center;background:#F2EFF0}
.grid4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding:12px;align-content:center;height:100%}
.grid4 img{width:100%;aspect-ratio:228/309;object-fit:cover}
.grid4 i{display:block;height:5px;background:#E8DCE1;margin-top:5px}
.lab{display:block;width:80%;margin:-34px auto 0;position:relative;text-align:center;color:#fff;padding:12px 10px 14px;background:center/100% 100% no-repeat}
.lab.dark{background-image:url(/wys-new/brush-dark.png)}
.lab.hot{background-image:url(/wys-new/brush-hot.png)}
.lab b{display:block;font-size:26px;letter-spacing:.04em;text-transform:uppercase;line-height:1.1}
.lab span{font-size:16px;font-weight:500}
.arrow{width:110px;margin:0 auto}

/* how it works */
.hiw{display:grid;grid-template-columns:1fr 40px 1fr 40px 1fr 40px 1fr;align-items:start;text-align:center}
.hiw .ic{width:92px;height:92px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#FCDCE8,#F4B3CC);display:flex;align-items:center;justify-content:center;margin:0 auto 12px}
.hiw .ar{padding-top:34px;color:#C2185B}
.hiw p{margin:0;font-weight:700;font-size:19px;line-height:1.2}

/* deliverables */
.del{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.dc{background:#fff;box-shadow:0 10px 22px rgba(26,20,23,.13);text-align:center;padding-bottom:16px;position:relative}
.dc .im{height:170px;overflow:hidden;position:relative;background:#F9E3EB}
.dc .im img.cover{width:100%;height:100%;object-fit:cover}
.dc .pocket{position:relative;margin-top:-26px;background:#fff;padding-top:24px;border-top:1px solid #F3E5EA}
.dc .n{font-weight:800;font-size:56px;line-height:1;color:#C2185B;margin:0}
.dc .l{font-weight:700;font-size:21px;line-height:1.12;margin:4px 0 0}
.dc .logo{position:absolute;left:50%;top:-30px;transform:translateX(-50%);width:56px;height:56px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 10px rgba(0,0,0,.12);z-index:2}
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px;padding:8px;height:100%}
.three img{width:100%;height:100%;object-fit:cover}
.blog{padding:12px 14px;text-align:left;height:100%;background:#fff}
.blog .h{height:9px;width:72%;background:#2A1A22;margin-bottom:6px}
.blog .s{height:6px;background:#E3D8DC;margin-bottom:5px}
.blog .row{display:grid;grid-template-columns:1fr 1.1fr;gap:10px;margin-top:8px}
.blog .row img{width:100%;height:96px;object-fit:cover}
.phone{width:96px;margin:14px auto 0;background:#1A1417;border-radius:16px 16px 0 0;padding:6px 6px 0}
.phone img{width:100%;height:150px;object-fit:cover;border-radius:11px 11px 0 0}

/* results */
.res{display:grid;grid-template-columns:minmax(0,1.55fr) 90px minmax(0,.75fr);align-items:center;gap:8px}
.dash{background:#fff;border-radius:8px;box-shadow:0 12px 26px rgba(26,20,23,.15);padding:22px 26px}
.dash .sel{display:inline-flex;align-items:center;gap:12px;border:1px solid #CFC6CA;border-radius:7px;padding:7px 12px;font-weight:600;font-size:16px}
.dash .row{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin-top:18px}
.dash .row div{padding:0 18px;border-left:1px solid #E6DDE1}
.dash .row div:first-child{padding-left:0;border-left:0}
.dash small{font-size:15px;color:#55464C;display:block}
.dash strong{display:block;font-size:34px;margin:6px 0 2px}
.dash .up{color:#2E7D32;font-size:15px;font-weight:600}
.note{background:url(/wys-new/paper-pink.png) center/100% 100% no-repeat;padding:30px 24px;transform:rotate(3deg);text-align:center}
.note p{font-family:'Satisfy',cursive;color:#7A1745;font-size:34px;line-height:1.1;margin:0}

/* included */
.inc2{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);gap:20px;align-items:center}
.stack{position:relative;height:250px}
.pola{position:absolute;background:#fff;padding:10px 10px 26px;box-shadow:0 10px 22px rgba(26,20,23,.18)}
.card2{position:absolute;right:0;top:6px;width:64%;transform:rotate(6deg);background:url(/wys-new/paper-pink.png) center/100% 100% no-repeat;padding:42px 16px;text-align:center;box-shadow:0 10px 22px rgba(26,20,23,.12)}
.card2 p{font-family:'Playfair Display',serif;font-weight:700;font-size:24px;line-height:1.12;margin:0;color:#7A1745}

/* offer */
.offer{text-align:center;position:relative;padding:44px 34px 80px}
.bfbar{display:inline-block;background:linear-gradient(180deg,#C2185B,#A81652);color:#fff;font-weight:600;font-size:30px;letter-spacing:.06em;text-transform:uppercase;padding:9px 40px}
.pr{display:flex;justify-content:center;align-items:center;gap:24px;flex-wrap:wrap;margin-top:10px}
.price{font-family:'Playfair Display',serif;font-weight:800;font-size:120px;line-height:1;margin:0;color:#C2185B}
.pr .side{border-left:3px solid #2A1A22;padding-left:22px;text-align:left;font-family:'Playfair Display',serif;font-size:34px;line-height:1.15}
.gift{position:absolute;left:-10px;bottom:-6px;width:210px}
.coffee{position:absolute;left:10px;bottom:10px;width:120px}
.offer .after{font-size:20px;margin:6px 0 24px}

/* faq */
.faq{display:grid;grid-template-columns:200px minmax(0,1fr);gap:24px;align-items:start}
.faq h2{font-family:'Playfair Display',serif;font-weight:800;font-size:56px;color:#9E1C55;margin:0}
details{background:#FCE7EF;border:1px solid #F1BBD0;border-radius:8px;margin:0 0 9px;padding:12px 18px}
summary{cursor:pointer;font-weight:600;font-size:18px;list-style:none;display:flex;justify-content:space-between;gap:12px}
summary::-webkit-details-marker{display:none}
summary::after{content:'+';font-size:24px;line-height:1}
details[open] summary::after{content:'−'}
details p{margin:10px 0 2px;font-size:17px}
.foot{text-align:center;font-size:13px;color:#6A5A61;padding:26px 18px 40px}

/* weekend */
.days{display:grid;grid-template-columns:minmax(0,1fr) 50px minmax(0,1fr) 50px minmax(0,1fr);align-items:center}
.pol{background:#fff;padding:12px 12px 16px;box-shadow:0 12px 24px rgba(26,20,23,.17);position:relative}
.pol .pin{position:absolute;top:-12px;left:50%;width:20px;height:20px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#F7A9C8,#C2185B);transform:translateX(-50%);box-shadow:0 2px 4px rgba(0,0,0,.25);z-index:2}
.pol .day{position:absolute;top:24px;left:22px;font-family:'Satisfy',cursive;font-size:46px;color:#C2185B;text-shadow:0 0 10px #fff,0 0 4px #fff,0 0 2px #fff;margin:0}
.pol img{width:100%;aspect-ratio:254/232;object-fit:cover}
.pol .cks{padding:12px 6px 0}
.icons{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));text-align:center;background:url(/wys-new/paper-pink.png) center/100% 100% no-repeat;padding:26px 18px}
.icons div{padding:6px 8px;border-left:1px solid #EFA9C4}
.icons div:first-child{border-left:0}
.icons p{margin:8px 0 0;font-weight:700;font-size:20px;line-height:1.15}
.one{display:grid;grid-template-columns:minmax(0,.9fr) 90px minmax(0,1.1fr);align-items:center;gap:8px}
.posts{position:relative;background:#fff;padding:12px;box-shadow:0 10px 22px rgba(26,20,23,.14)}
.posts .g{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:6px}
.posts .g div{aspect-ratio:2/3;background:linear-gradient(160deg,#FDE8F0,#F6C3D6);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-size:11px;font-weight:700;color:#7A1745}
.star{position:absolute;right:-26px;top:-46px;width:130px;height:130px;background:url(/wys-new/star.png) center/contain no-repeat;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-weight:700;line-height:1}
.star b{font-size:44px}.star span{font-size:22px}
.laptop .base{height:15px;background:linear-gradient(#DAD2D6,#B9B0B5);border-radius:0 0 14px 14px;margin:0 -16px}
.covers{position:relative;height:240px}
.cover{position:absolute;right:0;top:0;width:66%;aspect-ratio:1;transform:rotate(6deg);background:url(/wys-new/paper-pink.png) center/100% 100% no-repeat;display:flex;align-items:center;justify-content:center;text-align:center;box-shadow:0 10px 22px rgba(26,20,23,.14)}
.cover p{font-family:'Playfair Display',serif;font-weight:700;font-size:30px;line-height:1.05;color:#7A1745;margin:0}
.wprice{font-family:'Playfair Display',serif;font-weight:800;font-size:38px;color:#9E1C55;margin:0 0 6px;text-transform:uppercase}


@media (max-width:1279px) and (min-width:861px){
  .hero>img.ph{position:relative;height:auto;inset:auto;aspect-ratio:1502/708;object-position:center}
  .hero{display:flex;flex-direction:column-reverse}
  .hero .in{min-height:0;padding:36px 28px 40px;justify-content:flex-start;width:100%}
  .hero .copy{max-width:640px}
}
@media (max-width:860px){
  body{font-size:17px}
  .wrap{padding:0 18px}
  .hero>img.ph{position:relative;height:auto;inset:auto;aspect-ratio:1502/708;object-position:center}
  .hero .in{min-height:0;padding:28px 18px 30px}
  .hero{display:flex;flex-direction:column-reverse}
  h1.big{font-size:44px}
  .name span{font-size:32px}
  .ps,.faq,.inc2{grid-template-columns:minmax(0,1fr)}
  .ba,.days,.one{grid-template-columns:minmax(0,1fr);row-gap:26px}
  .ba .arrow,.days .ar,.one .arrow{display:none}
  .hiw{grid-template-columns:1fr 1fr;row-gap:22px}.hiw .ar{display:none}
  .del{grid-template-columns:repeat(2,minmax(0,1fr))}
  .res{grid-template-columns:minmax(0,1fr)}.res .arrow{display:none}
  .dash .row div{padding:0 10px}.dash strong{font-size:26px}
  .t h2{font-size:40px;padding:14px 40px 18px}
  .ttl{font-size:42px}
  .paper{padding:34px 26px 30px}
  .paper.offer{padding-bottom:100px}
  .price{font-size:92px}
  .pr .side{font-size:26px}
  .gift{position:relative;left:auto;bottom:auto;width:150px;margin:16px auto 0}
  .coffee{display:none}
  .bfbar{font-size:22px;padding:8px 20px}
  .btn{font-size:17px;padding:0 22px}
  .icons{grid-template-columns:repeat(3,minmax(0,1fr));row-gap:14px}
  .icons div{border-left:0}
  .star{right:0;top:-50px;width:104px;height:104px}.star b{font-size:34px}.star span{font-size:17px}
  .covers{height:220px}
  .top a.brand{font-size:19px;padding-right:40px}
  .name{margin-left:0}
  .pr .side{border-left:0;padding-left:0;text-align:center}
}
@media (max-width:420px){
  .del{gap:10px}.dc .l{font-size:18px}.dc .n{font-size:46px}
  .posts .g{grid-template-columns:repeat(4,minmax(0,1fr))}
}

.bundles{display:grid;gap:10px;justify-items:center;max-width:620px;margin:0 auto}
.bnote{font-size:16px;margin:0 0 10px;max-width:560px}
.bnote2{font-size:16px;margin:14px auto 0;max-width:600px}
[hidden]{display:none!important}

.sub2{font-size:17px;margin:-12px 0 24px;max-width:430px}
.pl{font-weight:700;font-size:20px;margin:0 0 12px}
.lead{text-align:center;font-size:19px;max-width:640px;margin:-6px auto 22px}
.pages4{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.pg4{background:#fff;padding:22px 20px;box-shadow:0 10px 22px rgba(26,20,23,.12);border-top:4px solid #F2A9C6}
.pg4 p{margin:0;font-size:16px}
.pg4 .pn{font-weight:800;font-size:30px;color:#C2185B;line-height:1;margin-bottom:8px}
.pg4 .ph4{font-family:'Playfair Display',serif;font-weight:700;font-size:23px;margin-bottom:6px}
.need{max-width:760px;margin:0 auto}
.choices{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;text-align:left;margin:4px 0 0}
.choice{background:#fff;padding:20px 18px 22px;box-shadow:0 10px 22px rgba(26,20,23,.13);display:flex;flex-direction:column}
.choice .who{font-family:'Satisfy',cursive;font-size:30px;color:#9E1C55;margin:0;line-height:1.1}
.choice .cp{font-family:'Playfair Display',serif;font-weight:800;font-size:46px;color:#C2185B;margin:4px 0 6px;line-height:1}
.choice .cw{font-size:16px;margin:0 0 16px;flex:1}
.choice .btn{font-size:16px;padding:0 18px;min-height:52px;justify-content:center}
.btn.btn2{background:#fff;color:#C2185B;border:2px solid #C2185B;box-shadow:none}
.btn.btn2:hover{background:#FCE7EF;color:#A81652}
@media (max-width:860px){.pages4{grid-template-columns:repeat(2,minmax(0,1fr))}.choices{grid-template-columns:minmax(0,1fr)}}
@media (max-width:520px){.pages4{grid-template-columns:minmax(0,1fr)}}
`}></style>
</head>
<body>
<header class="top"><a class="brand" href="/">The Digital Income Edit™</a>
<button class="menubtn" type="button" aria-label="Open page menu" aria-expanded="false" aria-controls="menu" onclick="var m=document.getElementById('menu');this.setAttribute('aria-expanded',m.classList.toggle('open'))"><svg width="24" height="20" viewBox="0 0 24 20" aria-hidden="true"><path d="M2 3h20M2 10h20M2 17h20" stroke="#1A1417" stroke-width="2.6"></path></svg></button>
<nav class="menu" id="menu" aria-label="Site"><a href="/">Home</a><a href="/shop">Shop</a><a href="/shop/weekend-ecosystem">The Weekend Ecosystem™</a><a href="/lifestyle">Lifestyle</a><a href="/membership">Membership</a></nav>
</header>
<main>


<section class="hero">
<img class="ph" src="/wys-new/hero-storefront.jpg" alt="A laptop on a fluffy pink blanket showing an Amazon storefront full of looks, beside a sparkly mug of marshmallows">
<div class="in"><div class="copy">
<h1 class="big">Your Storefront. Planned While You Sleep.</h1>
<div class="name"><span>The While-You-Sleep<br>Storefront™</span></div>
<p class="sub">Your Amazon (and beyond) storefront, fully planned and posted for you every night.</p>
<a class="btn" href="#offer">Get started now <svg width="14" height="22" viewBox="0 0 14 22" aria-hidden="true"><path d="M3 3l8 8-8 8" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
</div></div>
</section>

<section class="sec" style="padding-top:46px"><div class="wrap ps">
<div class="paper"><img class="tape" src="/wys-new/tape.png" alt="">
