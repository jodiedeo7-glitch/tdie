---
import WysDecor from '../../components/WysDecor.astro';
import WysShelf from '../../components/WysShelf.astro';
import WysStories from '../../components/WysStories.astro';
import WysFrame from '../../components/WysFrame.astro';
import WysCollage from '../../components/WysCollage.astro';
import WysWorksheet from '../../components/WysWorksheet.astro';
import WysKit from '../../components/WysKit.astro';
import WysFaq from '../../components/WysFaq.astro';
import {Image} from 'astro:assets';
import {packages} from '../../data/wys-packages.js';
import {WYS_ROOT} from '../../data/wys.js';
---
<WysFrame title="The While-You-Sleep Storefront™ | TDIE" description="A repeatable storefront-content workflow. Explore complete WYS packages with photographs, Pinterest graphics, Instagram slides, articles and copy." ogImage={packages[1].photos[1].src.src}>
 <div class="wx-hero-band"><WysDecor kind="drip"/><header class="wys-wrap wx-hero"><div><p class="wys-ribbon">The While-You-Sleep Storefront™</p><h1>Amazon affiliate content.<br/><em>With AI on your side.</em></h1><p class="wys-lede">Guides and reusable AI prompts for creating Amazon affiliate content, from choosing products and checking shopping links to making styling images, blog posts, Pinterest Pins and Instagram posts. Follow the same process for your next shopping idea instead of planning every post from scratch.</p><div class="wys-actions"><a class="wys-button" href={WYS_ROOT+'/look-inside'}>Look inside the full examples →</a><a class="wys-text-link" href="#kit">Explore the planned kit ↓</a></div><p class="wx-hero-note">Customer product on hold. Explore now; checkout and delivery stay closed.</p></div><WysCollage look={1}/></header></div>
 <WysShelf/><div class="wx-ticker"><span>3 PHOTO ROLES</span><span>3 PINTEREST GRAPHICS</span><span>3 INSTAGRAM SLIDES</span><span>ARTICLE + PRODUCTS + COPY</span></div>
 <WysStories/>
 <section class="wx-process-band"><div class="wys-wrap wys-section"><div class="wx-centered"><p class="wys-label">The flow, without the guesswork</p><h2>Choose the products.<br/><em>Create more from one idea.</em></h2></div><div class="wx-process"><div><b>START WITH A REAL LOOK</b><h3>Pick the pieces.</h3><p>Define the theme, record the actual products and choose the account path that fits your storefront or website.</p></div><div><b>BUILD THE WHOLE EDIT</b><h3>Create the posts and pictures.</h3><p>Three photo roles become Pinterest graphics, carousel slides, an article and consistent channel copy.</p></div><div><b>REPEAT WITH CONTROL</b><h3>Publish on your terms.</h3><p>Keep your review choices and checkpoints. Verify destinations before publishing, then use a manual or tested mixed path.</p></div></div></div></section>
 <WysWorksheet/><div id="kit"><WysKit/></div>
 <section class="wys-wrap wys-section"><div class="wx-paths"><div><p class="wys-label">Made to fit your actual setup</p><h2>You don’t need<br/><em>someone else’s business.</em></h2><p>Choose the path supported by your accounts and tools. The process starts there, rather than assuming you already have every connection.</p></div><div class="wx-path-list"><div><b>Influencer route</b><p>Eligible Amazon Idea Lists and your own verified destinations.</p></div><div><b>Associates-only route</b><p>Your own approved website page, without an Influencer storefront assumption.</p></div><div><b>Manual or mixed</b><p>Review and carry out steps yourself; connect only what your tested setup supports.</p></div><div><b>Optional persona & closet</b><p>A no-person path is available. Brand Closet needs your own authorized membership access.</p></div></div></div></section>
 <WysFaq/>
 <section class="wys-wrap wys-section"><div class="wx-last-call"><p class="wys-label">A little less to keep checking</p><h2>Stay close to<br/><em>what comes next.</em></h2><p>Follow TDIE’s existing Weekly Edit while the customer product remains on hold. No purchase, reserved place or promised launch date.</p><a class="wys-button" href={WYS_ROOT+'/waitlist'}>Get The Weekly Edit →</a></div></section>
</WysFrame>
