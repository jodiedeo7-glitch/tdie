---
// Pretty & Paid PLR Vault™ sales page, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
const CHECKOUT = "/go/pretty-and-paid-plr-vault";

const gates = [
  { n: "01", t: "No product",  p: "Designing one from a blank Canva page is the job that eats the month." },
  { n: "02", t: "No shop",     p: "Etsy, Stan, Beacons. Forty-seven half-relevant tutorials saved, and still not live." },
  { n: "03", t: "Nothing to post", p: "The shop exists. Now it needs reels, Pins, carousels, stories." },
  { n: "04", t: "Listings that don't sell", p: "Titles, tags, descriptions, mockups. Where good products die quietly." },
];

const previews = [
  { img: "canva-templates.jpg",      label: "Canva Templates" },
  { img: "faceless-reels.jpg",       label: "Faceless Reels" },
  { img: "stock-imagery.jpg",        label: "Stock Imagery" },
  { img: "guides-ebooks.jpg",        label: "Guides & eBooks" },
  { img: "printables-planners.jpg",  label: "Printables & Planners" },
  { img: "pinterest-templates.jpg",  label: "Pinterest Templates" },
  { img: "carousel-templates.jpg",   label: "Carousel Posts" },
  { img: "engagement-stories.jpg",   label: "Engagement Stories" },
  { img: "announcement-posts.jpg",   label: "Social Media Stories" },
  { img: "ai-prompt-packs.jpg",      label: "AI Prompt Packs" },
  { img: "coloring-pages.jpg",       label: "Coloring Page Sets" },
  { img: "ai-influencer-prompts.jpg",label: "AI Influencer Prompts" },
];

const steps = [
  { n: "01", t: "Download", p: "Pick a bundle." },
  { n: "02", t: "Rebrand",  p: "Your colors, fonts, name. In Canva." },
  { n: "03", t: "List",     p: "Glow Studio writes the title, description, tags, mockups." },
  { n: "04", t: "Sell",     p: "Post from the content packs. Keep what you earn." },
];

const timeline = [
  { w: "Week One",   t: "You pick a lane and open the files.",
    p: "Nine vaults, ninety-two products. Pick the three that fit your niche, swap the colors and fonts and logo, and they're finished and sitting on your desktop." },
  { w: "Week Two",   t: "Your shop exists.",
    p: "Etsy, Stan or Beacons. The training walks you through opening it, so your first listings can go up with real products behind them, not placeholders." },
  { w: "Week Three", t: "You stop scrambling for content.",
    p: "Faceless reels and templates ready to queue, so Sunday posting means picking from a folder instead of starting from nothing." },
  { w: "Week Four",  t: "The next drop lands.",
    p: "Twenty brand-new products waiting for you. Your shelf refills before it ever looks empty." },
];

const dayThirty = [
  "A storefront with real, finished products in it",
  "A content bank deep enough to post from for months",
  "Ninety-two rebrandable products no one can take back",
  "A shelf that restocks itself with twenty new products every month",
];
---
<TemplateLayout title="Pretty & Paid PLR Vault™" description="Pretty & Paid PLR Vault™: finished planners, guides, printables and templates to rebrand in Canva and sell as your own. $11/month. What you download stays yours, even after you cancel." ogImage="/og/pretty-and-paid-plr-vault.jpg" stickyHref={CHECKOUT} stickyLabel="Open the Vault · $11/mo">

<section class="hh">
 <div class="wrap hh-grid plr-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">New every month<b class="big">20</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Pretty &amp; Paid PLR Vault™ · $11/month</p>
   <h1>Stock your shop. <span class="scr">Skip the blank Canva page.</span></h1>
   <p class="what">Finished planners, guides, printables and templates you can put your name on and sell. <b>Pick a finished product, put your colors and your name on it in Canva, and list it.</b> The posts to sell it, the shop training and the listing tool come in the same $11.</p>
   <p class="price plr-price"><b class="glit">$11</b>per month</p>
   <a class="btn buy" href={CHECKOUT}>Open Pretty &amp; Paid PLR Vault™ <span class="ar">→</span></a>
   <p class="need">Full resell license · Yours after you cancel · Nine vaults, 92 products</p>
   <p class="see"><a href="#preview">See inside first ↓</a></p>
  </div>
  <div class="plr-stack" aria-hidden="true">{previews.slice(0,3).map((p,i) => <img class={`s${i}`} src={`/images/vault/${p.img}`} alt="" decoding="async">)}</div>
 </div>
 <ul class="wrap we-cred plr-cred"><li><b class="glit">150+</b>downloads inside</li><li><b class="glit">20</b>new every month</li><li><b class="glit">92</b>products in nine vaults</li><li><b class="glit">$11</b>a month</li></ul>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>The real bottleneck</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">The blank-page problem happens <span class="scr">before the sale.</span></h2>
  <div class="p18 hm-four">{gates.map((g) => <div class="box"><span class="num hm-num">{g.n}</span><h3>{g.t}</h3><p>{g.p}</p></div>)}</div>
  <p class="we-foot plr-foot">One subscription covers all four. Your part is the rebrand and the publish button.</p>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">What's inside</p>
  <h2 class="h2">Four things, <span class="scr">one subscription.</span></h2>
  <div class="p21 plr-four">
   <div class="col"><span class="scr">Products</span><div class="card dash"><p>Planners, journals, guides, eBooks, printables, coloring pages. Canva-editable. Full PLR license.</p><p class="plr-sm">One download is a bundle, not a file: 30-page guides, 50+ template sets, 100+ reel packs.</p></div></div>
   <div class="col"><span class="scr">Content</span><div class="card dash"><p>The marketing to sell them, so launch day never opens on a blank feed.</p><ul class="plr-chips"><li>Faceless Reels</li><li>Stock photos</li><li>AI influencer images</li><li>Pinterest</li><li>Carousels</li><li>Social media stories</li></ul></div></div>
   <div class="col"><span class="scr">Training</span><div class="card dash"><p>Etsy. Stan Store. Beacons. Canva rebranding. Taught in order, in one place.</p></div></div>
   <div class="col"><span class="scr">Glow Studio</span><div class="card dash"><p>An AI tool built into the Vault. Name your product, get back:</p><ul class="chk"><li>4 branded mockup prompts</li><li>An SEO product title</li><li>A full description</li><li>SEO tags</li></ul></div></div>
  </div>
  <div class="p23 plr-two">
   <div class="pc"><div class="hd">20 new products every month</div><div class="bd"><p>The library you join is the smallest it will ever be.</p></div></div>
   <div class="pc"><div class="hd">Yours to keep, permanently</div><div class="bd"><p>The license survives cancellation. A key to the room, not a lease on what you carry out of it.</p></div></div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">How it works</p>
  <h2 class="h2">Download. Rebrand. <span class="scr">List. Sell.</span></h2>
  <div class="p18 hm-four">{steps.map((s) => <div class="box"><span class="num hm-num">{s.n}</span><h3>{s.t}</h3><p>{s.p}</p></div>)}</div>
 </div>
</section>

<section class="sec" id="preview">
 <div class="wrap">
  <p class="kick">A real look</p>
  <h2 class="h2">Not a description. <span class="scr">The actual thing.</span></h2>
  <div class="lead"><p>Each one is a single example. The sets they come from run thirty, fifty, a hundred pieces deep.</p></div>
  <div class="plr-gal">{previews.map((p) => <figure><img src={`/images/vault/${p.img}`} alt={`${p.label} preview from Pretty & Paid PLR Vault™`} loading="lazy" decoding="async"><figcaption>{p.label}</figcaption></figure>)}</div>
  <div class="p25 plr-peek" id="sneak-peek"><div class="pc dash" style="position:relative">
   <span class="stk r" style="right:-50px;top:-60px">Sneak peek<b class="big">free</b></span>
   <div class="pn">The sneak peek</div>
   <h3 class="hm-bp-h">Take a full set <span class="glit">home first.</span></h3>
   <p>One complete piece from inside the Vault, as a PDF, sent to your inbox and opened right here. Enter your email and it's yours.</p>
   <div class="v-peek-row" id="sp-row"><input id="sp-email" type="email" placeholder="you@example.com" autocomplete="email" /><button id="sp-go" class="btn">Send me the sneak peek <span class="ar">→</span></button></div>
   <p id="sp-done" class="v-peek-done">It's ready. <a id="sp-link" href="#" target="_blank" rel="noopener">Open the sneak peek →</a></p>
   <p id="sp-err" class="v-peek-err"></p>
  </div></div>
 </div>
</section>

<div class="band"><svg class="spk sm" style="left:20%"><use href="#sp"/></svg><h2>Thirty days from now</h2><svg class="spk" style="right:20%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">What you'd <span class="scr">actually have.</span></h2>
  <div class="faq">{timeline.map((r, i) => <div class="qa"><span class="n">0{i+1}</span><div><span class="hm-lab">{r.w}</span><h3>{r.t}</h3><p>{r.p}</p></div></div>)}</div>
  <div class="p25 we-mid"><div class="pc dash"><div class="pn">By day thirty, on your own hard drive</div><ul class="chk">{dayThirty.map((d) => <li>{d}</li>)}</ul></div></div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <h2 class="h2">Who it's for, <span class="scr">and who it isn't.</span></h2>
  <div class="p21">
   <div class="col"><span class="scr">Yes</span><div class="card dash"><h3>For you if</h3><ul class="chk"><li>You want to sell and have nothing to sell yet</li><li>You'd rather rebrand than build from blank</li><li>You're building faceless</li><li>You can open Canva and change a color</li></ul></div></div>
   <div class="col"><span class="scr">Not yet</span><div class="card dash"><h3>Not for you if</h3><ul class="chk hm-x"><li>You want to learn to design from scratch. The Vault doesn't teach that</li><li>You want personal coaching. The Vault includes rebranding and shop training, but not individual coaching</li><li>You expect exclusive files. PLR means others download the same source. Your rebrand is what makes it yours.</li></ul></div></div>
  </div>
 </div>
</section>

<section class="sec wash" id="price">
 <div class="wrap">
  <div class="p42 dash plr-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">Yours<b class="big">to keep</b></span>
   <div class="ph"><img src="/images/vault/printables-planners.jpg" width="1000" height="470" loading="lazy" decoding="async" alt="Printables and planners preview from Pretty & Paid PLR Vault™"></div>
   <div class="tx">
    <p class="kick">The price</p>
    <h2>$11 a month.</h2>
    <span class="scr">A separate subscription.</span>
    <p>Pretty &amp; Paid PLR Vault™ bills on its own, through Beacons. One price, nothing else to buy before you can use it. <b>You're paying for stock, not lessons.</b></p>
    <ul class="chk"><li>The full product library</li><li>All marketing content packs</li><li>Etsy, Stan, Beacons &amp; Canva training</li><li>PLR Glow Studio</li><li>20 new products monthly</li><li>Full PLR license, permanently</li></ul>
    <p class="price plr-price"><b class="glit">$11</b>per month</p>
    <a class="btn buy" href={CHECKOUT}>Open Pretty &amp; Paid PLR Vault™ <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>

<section class="quote holo">
 <div class="q we-note"><span class="mk o">“</span>
  <p class="we-nk">Nothing to lose, by design</p>
  <p class="we-nb">Join for one month. Download every last file. Cancel the next morning if you want to, <b>and all of it is still yours.</b> Permanently, fully licensed to edit, rebrand and sell for as long as you like. Canceling closes the door to what comes next. It never reaches back for what you already have.</p>
 <span class="mk c">”</span></div>
</section>

<section class="sec">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Questions</span></p>
  <h2 class="h2">Frequently <span class="scr">asked.</span></h2>
  <div class="faq">
   <div class="qa"><span class="n">01</span><div><h3>What happens to my downloads if I cancel?</h3><p>Nothing. They're yours permanently, license included. Canceling closes the door on new downloads. It never takes back what's on your computer.</p></div></div>
   <div class="qa"><span class="n">02</span><div><h3>What does the PLR license let me do?</h3><p>Rebrand, customize and sell the products as your own, keeping what you earn. Full private label rights.</p></div></div>
   <div class="qa"><span class="n">03</span><div><h3>Is this its own subscription?</h3><p>Yes. Pretty &amp; Paid PLR Vault™ is $11 a month, billed on its own through Beacons. It doesn't need anything else to work.</p></div></div>
   <div class="qa"><span class="n">04</span><div><h3>Do I need design skills?</h3><p>No. Everything opens in Canva as an editable template, and the rebranding training covers the workflow.</p></div></div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap" style="text-align:center">
  <h2 class="h2">Your next product <span class="scr">starts with a finished file.</span></h2>
  <div class="btnwrap"><a class="btn buy" href={CHECKOUT}>Open Pretty &amp; Paid PLR Vault™ · $11/month <span class="ar">→</span></a></div>
  <p class="mb-note"><a href="#preview">Still deciding? Look through the previews</a><br><a href="/shop">Back to the Shop</a></p>
 </div>
</section>
<script>
  (() => {
    const input = document.getElementById("sp-email");
    const btn = document.getElementById("sp-go");
    const row = document.getElementById("sp-row");
    const done = document.getElementById("sp-done");
    const link = document.getElementById("sp-link");
    const err = document.getElementById("sp-err");
    if (!btn) return;
    const label = btn.innerHTML;
    async function go() {
      const email = input.value.trim();
      err.style.display = "none";
      btn.disabled = true;
      btn.textContent = "Sending…";
      try {
        const r = await fetch("/api/sneak-peek", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        const d = await r.json();
        if (!r.ok) throw new Error(d.error || "Something went wrong.");
        link.href = d.url;
        row.style.display = "none";
        done.style.display = "block";
      } catch (e) {
        err.textContent = e.message;
        err.style.display = "block";
        btn.disabled = false;
        btn.innerHTML = label;
      }
    }
    btn.addEventListener("click", go);
    input.addEventListener("keydown", (e) => { if (e.key === "Enter") go(); });
  })();
</script>
</TemplateLayout>
