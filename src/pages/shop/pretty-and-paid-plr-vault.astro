---
import PageLayout from "../../layouts/PageLayout.astro";

const CHECKOUT = "https://links.thedigitalincomeedit.com/shop/e7555c8f-7348-4ab4-99ce-0569d6dd0839";

const gates = [
  { n: "01", t: "No product",  p: "Designing one from a blank Canva page is the job that eats the month." },
  { n: "02", t: "No shop",     p: "Etsy, Stan, Beacons — forty-seven half-relevant tutorials, still not live." },
  { n: "03", t: "Nothing to post", p: "The shop exists. Now it needs reels, Pins, carousels, stories." },
  { n: "04", t: "Listings that don't sell", p: "Titles, tags, descriptions, mockups. Where good products die quietly." },
];

const previews = [
  { img: "canva-templates.jpg",      label: "Canva Templates" },
  { img: "faceless-reels.jpg",       label: "Faceless Reels" },
  { img: "stock-imagery.jpg",        label: "Stock Imagery" },
  { img: "guides-ebooks.jpg",        label: "Guides & eBooks" },
  { img: "printables-planners.jpg",  label: "Printables & Planners" },
  { img: "pinterest-templates.jpg",  label: "Pinterest Templates" },
  { img: "carousel-templates.jpg",   label: "Carousel Posts" },
  { img: "engagement-stories.jpg",   label: "Engagement Stories" },
  { img: "announcement-posts.jpg",   label: "Social Media Stories" },
  { img: "ai-prompt-packs.jpg",      label: "AI Prompt Packs" },
  { img: "coloring-pages.jpg",       label: "Coloring Page Sets" },
  { img: "ai-influencer-prompts.jpg",label: "AI Influencer Prompts" },
];

const steps = [
  { n: "01", t: "Download", p: "Pick a bundle." },
  { n: "02", t: "Rebrand",  p: "Your colors, fonts, name. In Canva." },
  { n: "03", t: "List",     p: "Glow Studio writes the title, description, tags, mockups." },
  { n: "04", t: "Sell",     p: "Post from the content packs. Keep what you earn." },
];

const timeline = [
  { w: "Week One",   t: "You pick a lane and open the files.",
    p: "Nine vaults, ninety-two products. Pick the three that fit your niche, swap the colors and fonts and logo, and they're finished and sitting on your desktop." },
  { w: "Week Two",   t: "Your shop exists.",
    p: "Etsy, Stan, or Beacons — the training walks you through opening it. Your first listings go up with real products behind them, not placeholders." },
  { w: "Week Three", t: "You stop scrambling for content.",
    p: "A month of faceless reels and templates queued up, so posting takes twenty minutes on a Sunday instead of your whole week." },
  { w: "Week Four",  t: "The next drop lands.",
    p: "Twenty brand-new products, a fresh theme, waiting for you. Your shelf refills before it ever looks empty." },
];

const dayThirty = [
  "A storefront with real, finished products in it",
  "A content bank deep enough to post from for months",
  "Ninety-two rebrandable products no one can take back",
  "A system that restocks itself on the first of every month",
];
---
<PageLayout
  wide
  title="Pretty & Paid PLR Vault™"
  description="Pretty & Paid PLR Vault™ — a stocked library of done-for-you digital products, licensed to rebrand and sell as your own. $11/month. What you download is yours permanently."
>
  <!-- HERO -->
  <section class="v-hero">
    <div class="page-eyebrow">Digital Product Library · $11/month</div>
    <h1>Pretty &amp; Paid PLR Vault™</h1>
    <p class="lede">Done-for-you digital products, licensed to rebrand and sell as your own.</p>
    <div class="v-cta-row">
      <a class="btn" href={CHECKOUT}>Open the Vault — $11/month <span class="a">→</span></a>
      <a class="v-link" href="#preview">See inside first →</a>
    </div>
    <div class="v-stats">
      <div><span class="v-stat">150+</span><span class="v-statlab">Downloads inside</span></div>
      <div><span class="v-stat">20+</span><span class="v-statlab">New every month</span></div>
      <div><span class="v-stat">$11</span><span class="v-statlab">A month</span></div>
    </div>
    <ul class="v-trust">
      <li>Full resell license</li>
      <li>Yours after you cancel</li>
      <li>Nine vaults · 92 products</li>
    </ul>
  </section>

  <!-- PREVIEW STRIP — visual proof, above the fold-ish -->
  <section class="v-strip">
    {previews.slice(0,4).map(p => (
      <figure><img src={`/images/vault/${p.img}`} alt={`${p.label} preview from Pretty & Paid PLR Vault`} loading="lazy" /><figcaption>{p.label}</figcaption></figure>
    ))}
  </section>

  <!-- PROBLEM -->
  <section class="v-sec">
    <div class="v-kicker">The Real Bottleneck</div>
    <h2>Nobody gets stuck on selling. They get stuck before it.</h2>
    <div class="v-grid-4">
      {gates.map(g => (
        <div class="v-gate"><span class="v-num">{g.n}</span><h3>{g.t}</h3><p>{g.p}</p></div>
      ))}
    </div>
    <p class="v-close">Most people are stuck at all four at once. The Vault handles all four.</p>
  </section>

  <!-- WHAT'S INSIDE -->
  <section class="v-sec">
    <div class="v-kicker">What's Inside</div>
    <h2>Four things, one subscription.</h2>
    <div class="v-grid-2">
      <div class="v-card">
        <h3>The Products</h3>
        <p>Planners, journals, guides, eBooks, printables, coloring pages. Canva-editable. Full PLR license.</p>
        <p class="v-fine-dark">One download is a bundle, not a file — 30-page guides, 50+ template sets, 100+ reel packs.</p>
      </div>
      <div class="v-card">
        <h3>The Content</h3>
        <p>The marketing to sell them, so launch day never opens on a blank feed.</p>
        <ul class="v-chips">
          <li>Faceless Reels</li><li>Stock photos</li><li>AI influencer images</li>
          <li>Pinterest</li><li>Carousels</li><li>Social media stories</li>
        </ul>
      </div>
      <div class="v-card">
        <h3>The Training</h3>
        <p>Etsy. Stan Store. Beacons. Canva rebranding. Taught in order, in one place.</p>
      </div>
      <div class="v-card v-card-feature">
        <h3>PLR Glow Studio</h3>
        <p>An AI tool built into the Vault. Name your product, get back:</p>
        <ul>
          <li>4 branded mockup prompts</li>
          <li>An SEO product title</li>
          <li>A full description</li>
          <li>SEO tags</li>
        </ul>
      </div>
    </div>

    <div class="v-two-callouts">
      <div class="v-callout">
        <h3>20 new products every month</h3>
        <p>The library you join is the smallest it will ever be.</p>
      </div>
      <div class="v-callout v-callout-gold">
        <h3>Yours to keep, permanently</h3>
        <p>The license survives cancellation. A key to the room, not a lease on what you carry out of it.</p>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="v-sec v-tint">
    <div class="v-kicker">How It Works</div>
    <h2>Download. Rebrand. List. Sell.</h2>
    <div class="v-steps">
      {steps.map(s => (
        <div class="v-step"><span class="v-num">{s.n}</span><h3>{s.t}</h3><p>{s.p}</p></div>
      ))}
    </div>
  </section>

  <!-- FULL PREVIEW GRID + GATED FREEBIE -->
  <section class="v-sec" id="preview">
    <div class="v-kicker">A Real Look</div>
    <h2>Not a description. The actual thing.</h2>
    <p class="v-note">Each one is a single example. The sets they come from run thirty, fifty, a hundred pieces deep.</p>
    <div class="v-gallery">
      {previews.map(p => (
        <figure><img src={`/images/vault/${p.img}`} alt={`${p.label} preview from Pretty & Paid PLR Vault`} loading="lazy" /><figcaption>{p.label}</figcaption></figure>
      ))}
    </div>
  </section>

  <!-- THIRTY DAYS -->
  <section class="v-sec">
    <div class="v-kicker">Thirty Days From Now</div>
    <h2>What you'd actually have.</h2>
    <div class="v-timeline">
      {timeline.map(r => (
        <div class="v-tl-row">
          <div class="v-tl-week">{r.w}</div>
          <div class="v-tl-body"><h3>{r.t}</h3><p>{r.p}</p></div>
        </div>
      ))}
    </div>
    <div class="v-daythirty">
      <div class="v-kicker">By day thirty, on your own hard drive</div>
      <ul>{dayThirty.map(d => (<li>{d}</li>))}</ul>
    </div>
  </section>

  <!-- FIT -->
  <section class="v-sec">
    <div class="v-kicker">Fit</div>
    <h2>Who it's for — and who it isn't.</h2>
    <div class="v-grid-2">
      <div class="v-fit">
        <h3>For you if</h3>
        <ul class="v-yes">
          <li>You want to sell and have nothing to sell yet</li>
          <li>You'd rather rebrand than build from blank</li>
          <li>You're building faceless</li>
          <li>You can open Canva and change a color</li>
        </ul>
      </div>
      <div class="v-fit">
        <h3>Not for you if</h3>
        <ul class="v-no">
          <li>You want to learn to design from scratch — the Vault doesn't teach that</li>
          <li>You want coaching or courses — this is inventory, not education</li>
          <li>You expect exclusive files. PLR means others download the same source. Your rebrand is what makes it yours.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="v-sec">
    <div class="v-kicker">The Price</div>
    <div class="v-price-box">
      <div class="v-price-fig">$11<span>/month</span></div>
      <ul class="v-price-list">
        <li>The full product library</li>
        <li>All marketing content packs</li>
        <li>Etsy, Stan, Beacons &amp; Canva training</li>
        <li>PLR Glow Studio</li>
        <li>20 new products monthly</li>
        <li>Full PLR license — permanently</li>
      </ul>
      <a class="btn" href={CHECKOUT}>Open Pretty &amp; Paid PLR Vault™ <span class="a">→</span></a>
      <p class="v-fine">All ninety-two products, every training inside, and twenty brand-new ones each month.</p>
    </div>

    <div class="v-nothing">
      <div class="v-kicker">Nothing to lose, by design</div>
      <p>Join for one month. Download every last file. Cancel the next morning if you want to — <em>and all of it is still yours.</em> Permanently, fully licensed to edit, rebrand, and sell for as long as you like. Cancelling closes the door to what comes next; it never reaches back for what you've already saved. You are paying for the doorway and the new work that arrives each month — never renting the work already sitting on your desktop. Stay because it keeps handing you more. Not because leaving would cost you something.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="v-sec v-tint">
    <div class="v-kicker">Questions</div>
    <h2>Frequently asked</h2>
    <details class="v-faq"><summary>What happens to my downloads if I cancel?</summary>
      <p>Nothing. They're yours permanently, license included. Canceling closes the door on new downloads — it never takes back what's on your computer.</p></details>
    <details class="v-faq"><summary>What does the PLR license let me do?</summary>
      <p>Rebrand, customize and sell the products as your own, keeping what you earn. Full private label rights.</p></details>
    <details class="v-faq"><summary>Do I need design skills?</summary>
      <p>No. Everything opens in Canva as an editable template, and the rebranding training covers the workflow.</p></details>
  </section>

  <!-- FINAL -->
  <section class="v-final">
    <h2>Stock the shop today, or spend another month deciding what to sell.</h2>
    <a class="btn" href={CHECKOUT}>Open Pretty &amp; Paid PLR Vault™ — $11/month <span class="a">→</span></a>
    <p class="v-fine"><a href="#preview">Still deciding? Look through the previews →</a></p>
  </section>

  <p style="margin-top:60px"><a href="/shop" style="color:var(--pink);font-weight:500">← Back to the Shop</a></p>
</PageLayout>

<style>
  .v-hero{max-width:720px;margin:0 auto}
  .v-hero h1{color:var(--pink)}
  .v-cta-row{display:flex;align-items:center;gap:24px;flex-wrap:wrap;margin:4px 0 26px}
  .v-link{color:var(--pink);font-weight:500;font-size:15px}
  .v-trust{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:9px}
  .v-trust li{font-size:11.5px;letter-spacing:1.2px;text-transform:uppercase;color:var(--taupe-deep);
    border:1px solid var(--gray);border-radius:100px;padding:7px 15px;margin:0}

  .v-strip{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:52px 0 10px}
  .v-strip figure{margin:0}
  .v-strip img,.v-gallery img{width:100%;display:block;border-radius:12px;border:1px solid var(--gray)}
  .v-strip figcaption,.v-gallery figcaption{font-size:10.5px;letter-spacing:1.8px;text-transform:uppercase;
    color:var(--taupe-deep);margin-top:9px}

  .v-sec{max-width:1000px;margin:0 auto;padding:72px 0;border-top:1px solid var(--gray)}
  .v-sec.v-tint{background:var(--pink);border-radius:var(--r);padding:60px 44px;margin:72px auto;border-top:none;color:var(--white)}
  .v-sec.v-tint .v-kicker{color:var(--rose)}
  .v-sec.v-tint h2{color:var(--white)}
  .v-sec.v-tint .v-faq{border-bottom-color:rgba(255,255,255,.28)}
  .v-sec.v-tint .v-faq summary{color:var(--white)}
  .v-sec.v-tint .v-faq summary::after{color:var(--rose)}
  .v-sec.v-tint .v-faq p{color:rgba(255,255,255,.9)}
  .v-kicker{font-size:11.5px;letter-spacing:2.6px;text-transform:uppercase;color:var(--pink);margin-bottom:16px}
  .v-sec h2{font-family:var(--display);font-weight:300;font-size:clamp(27px,3.6vw,38px);line-height:1.15;
    letter-spacing:-.4px;margin:0 0 30px;max-width:22ch}
  .v-sec h3{font-family:var(--display);font-weight:400;font-size:20px;margin:0 0 9px;line-height:1.25}
  .v-gate h3,.v-card h3,.v-callout h3,.v-step h3,.v-daythirty h3{color:var(--pink)}
  .v-close{font-family:var(--serif);font-style:italic;font-size:19px;color:var(--choc-soft);margin-top:30px}
  .v-note{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--taupe-deep);margin-top:-14px}

  .v-num{display:block;font-family:var(--display);font-size:12.5px;letter-spacing:2px;color:var(--gold);margin-bottom:10px}

  .v-grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
  .v-gate{background:var(--rose);border:1px solid var(--pink-soft);border-radius:var(--r);padding:26px 22px}
  .v-gate p{font-size:14.5px;line-height:1.6;margin:0}

  .v-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:22px}
  .v-card{background:var(--rose);border:1px solid var(--pink-soft);border-radius:var(--r);padding:30px}
  .v-card p{font-size:15.5px;line-height:1.7;margin-bottom:10px}
  .v-card p:last-child{margin-bottom:0}
  .v-card ul{margin:10px 0 0;padding-left:18px}
  .v-card li{font-size:15px;line-height:1.55;margin-bottom:7px}
  .v-card-feature{border-color:var(--pink);background:var(--rose)}
  .v-fine-dark{font-size:14px!important;color:var(--taupe-deep)}

  .v-chips{list-style:none;padding:0!important;margin:12px 0 0;display:flex;flex-wrap:wrap;gap:8px}
  .v-chips li{margin:0;font-size:13px;background:var(--white);border-radius:100px;padding:7px 14px;color:var(--choc-soft)}

  .v-two-callouts{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:22px}
  .v-callout{border-left:3px solid var(--pink);background:var(--rose);border-radius:0 14px 14px 0;padding:24px 26px}
  .v-callout h3{margin-bottom:6px}
  .v-callout p{margin:0;font-size:15px;line-height:1.65}
  .v-callout-gold{border-left-color:var(--gold);background:var(--rose)}

  .v-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:22px}
  .v-step{background:var(--rose);border:none;border-radius:var(--r);padding:26px 22px}
  .v-step .v-num{color:var(--pink)}
  .v-step p{font-size:14.5px;line-height:1.6;margin:0;color:var(--choc-soft)}

  .v-gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin:6px 0 12px}
  .v-gallery figure{margin:0}

  .v-fit ul{list-style:none;padding:0;margin:0}
  .v-fit li{font-size:15px;line-height:1.6;margin-bottom:13px;padding-left:26px;position:relative}
  .v-yes li::before{content:"✓";position:absolute;left:0;color:var(--pink);font-weight:600}
  .v-no li::before{content:"✕";position:absolute;left:0;color:var(--taupe);font-weight:600}

  .v-faq{border-bottom:1px solid var(--gray);padding:18px 0}
  .v-faq summary{cursor:pointer;font-family:var(--display);font-size:17.5px;font-weight:400;list-style:none;
    display:flex;justify-content:space-between;gap:20px;align-items:flex-start}
  .v-faq summary::-webkit-details-marker{display:none}
  .v-faq summary::after{content:"+";color:var(--pink);font-size:21px;line-height:1;flex-shrink:0}
  .v-faq[open] summary::after{content:"–"}
  .v-faq p{margin:14px 0 0;font-size:15.5px;line-height:1.7;color:var(--choc-soft)}

  .v-price-box{background:var(--choc);color:var(--cream);border-radius:var(--r);padding:44px;text-align:center}
  .v-price-fig{font-family:var(--display);font-weight:300;font-size:58px;line-height:1;margin-bottom:6px}
  .v-price-fig span{font-family:var(--sans);font-size:15px;letter-spacing:1px;color:var(--taupe)}
  .v-price-list{list-style:none;padding:0;margin:24px auto 30px;max-width:420px;text-align:left}
  .v-price-list li{font-size:15px;line-height:1.5;margin-bottom:11px;padding-left:20px;position:relative;color:var(--cream)}
  .v-price-list li::before{content:"—";position:absolute;left:0;color:var(--gold)}
  .v-fine{font-size:13px;color:var(--taupe);margin:16px 0 0}

  .v-stats{display:flex;gap:0;border-top:1px solid var(--gray);border-bottom:1px solid var(--gray);margin:26px 0 22px}
  .v-stats div{flex:1;padding:20px 8px;text-align:center;border-right:1px solid var(--gray)}
  .v-stats div:last-child{border-right:none}
  .v-stat{display:block;font-family:var(--display);font-weight:300;font-size:32px;line-height:1;color:var(--choc)}
  .v-statlab{display:block;font-size:10.5px;letter-spacing:1.8px;text-transform:uppercase;color:var(--taupe-deep);margin-top:8px}

  .v-timeline{border-top:1px solid var(--gray)}
  .v-tl-row{display:grid;grid-template-columns:150px 1fr;gap:26px;padding:26px 0;border-bottom:1px solid var(--gray)}
  .v-tl-week{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--pink);padding-top:5px}
  .v-tl-body h3{margin:0 0 7px}
  .v-tl-body p{font-size:15.5px;line-height:1.7;margin:0;color:var(--choc-soft)}

  .v-daythirty{background:var(--rose);border-radius:var(--r);padding:30px 34px;margin-top:32px}
  .v-daythirty ul{list-style:none;padding:0;margin:0}
  .v-daythirty li{font-size:15.5px;line-height:1.6;margin-bottom:12px;padding-left:24px;position:relative;color:var(--choc-soft)}
  .v-daythirty li:last-child{margin-bottom:0}
  .v-daythirty li::before{content:"—";position:absolute;left:0;color:var(--pink)}

  .v-nothing{background:var(--choc);color:var(--cream);border-radius:var(--r);padding:32px 36px;margin-top:24px}
  .v-nothing .v-kicker{color:var(--rose)}
  .v-nothing p{font-size:15.5px;line-height:1.75;margin:0;color:rgba(255,255,255,.9)}

  .v-final{max-width:720px;margin:76px auto 0;text-align:center;padding-top:64px;border-top:1px solid var(--gray)}
  .v-final h2{font-family:var(--display);font-weight:300;font-size:clamp(27px,3.6vw,38px);line-height:1.15;margin:0 auto 28px;max-width:24ch}
  .v-final .v-fine a{color:var(--pink)}

  @media(max-width:900px){
    .v-grid-4{grid-template-columns:1fr 1fr}
    .v-gallery{grid-template-columns:1fr 1fr}
    .v-steps{grid-template-columns:1fr 1fr}
    .v-sec.v-tint{padding:48px 24px}
  }
  @media(max-width:600px){
    .v-strip{grid-template-columns:1fr 1fr}
    .v-tl-row{grid-template-columns:1fr;gap:8px}
    .v-grid-2,.v-two-callouts{grid-template-columns:1fr}
    .v-price-box{padding:32px 22px}
  }
</style>
