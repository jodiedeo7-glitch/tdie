---
// The Weekend Ecosystem™ sales page, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import { MODULES } from "../../we-manifest.js";
import { S, HREF } from "../../we-stage.js";
import { SALE } from "../../we-sale.js";
import { OBJECTIONS } from "../../we-objections.js";
import { KIT_DEADLINE, kitLive } from "../../we-kit.js";
import Testimonial from "../../components/Testimonial.astro";
// Hours per phase, from the weekend timeline: 2 + 3 + 3 + 3 + 3 + 2 = 16.
const HOURS = [2, 3, 3, 3, 3, 2];
const phases = [...new Set(MODULES.map((m) => m.phase))].map((p, i) => {
  const inPhase = MODULES.filter((m) => m.phase === p);
  const [when, what] = [inPhase[0].phaseLabel, inPhase[0].phaseSub];
  return {
    day: when.split("·")[1]?.trim() ?? when,
    title: what.split("—")[0].trim(),
    sub: what.split("—")[1]?.trim(),
    accent: inPhase[0].accent,
    hrs: HOURS[i],
    mods: inPhase,
  };
});

const friday = [
  "Content scattered across a platform you don't own",
  "No website",
  "No blog",
  "Nobody finds you unless they already know you",
];

const sunday = [
  "A website on a domain you own, deploying automatically",
  "A blog Google can find, starting with a pillar article",
  "An email list that captures, tested by you, not assumed",
  "A free resource with automated delivery",
  "Every reader routed to a free offer and a paid one",
  "Brand-consistent images without your face in any of them",
];

const life = [
  { t: "Your time back", p: "One article turns into 24 pins, posts and emails. You stop posting daily just to stay visible." },
  { t: "Your control", p: "Your domain, your list, your links. Bridge pages mean every outbound link is yours to change. Nothing you build is rented." },
  { t: "Your face, optional", p: "Every image on your site is generated on brand, without you in it. Nobody needs you on camera." },
];

const proof = [
  { t: "How to Build a Faceless Digital Business", u: "/learn/how-to-build-a-faceless-digital-business", n: "3,000+ words", img: "/images/library-cards/hero-office-wide-01.webp" },
  { t: "The Complete Pinterest Marketing Guide", u: "/learn/complete-pinterest-marketing-guide", n: "Pillar + cluster", img: "/images/library-cards/detail-phone-pinterest-grid-01.webp" },
  { t: "Automating Your Online Business", u: "/learn/automating-your-online-business", n: "Built from a lesson", img: "/images/library-cards/flatlay-automation-systems.webp" },
];

const claudeDoes = [
  "Writes every file your website needs: config, layouts, pages, the homepage",
  "Turns a Skool lesson into a 3,000-word article written for a stranger",
  "Runs four separate SEO passes over it: Google, Pinterest, AI search, readability",
  "Generates the supporting article cluster around each pillar",
  "Builds your email capture, resource pages and bridge pages",
  "Writes your lead magnets from your own material",
  "Turns one article into twenty-four assets across six platforms",
  "Generates every image, on brand, without your face",
  "Commits the finished files straight to your site",
];

const youDo = ["Paste the prompt", "Read what came back", "Say yes, or say what to change"];

const neverDo = [
  "Write code", "Design a page", "Hire a developer", "Learn WordPress", "Write a blog post from a blank page",
  "Film yourself", "Think of content ideas", "Post daily to stay visible", "Pay monthly for a site builder",
];


const included = [
  { t: "22 modules", p: "My exact build, in order. Each one teaches the step, hands you the prompt I used, and tells you what broke for me there and how I fixed it." },
  { t: "The Quick Sheet", p: "All 37 prompts on one page in running order, one line each. For your second build, and your third." },
  { t: "The Prompt Vault", p: "Every prompt verbatim and organized by tool: Claude, Chrome, image generation, GitHub." },
  { t: "The Troubleshooting Vault", p: "An FAQ plus every roadblock from a real build, paired with the fix that worked." },
  { t: "The Template Vault", p: "Canon File, pillar map, live-facts block, product register, operating cadence. Fill in and keep." },
  { t: "The Ask-For-It List", p: "51 things you can change on your site by asking in one sentence: design tweaks, new pages, fixes, legal pages, SEO. The list I actually use." },
  { t: "Progress tracking + certificate", p: "Tick off each module, watch the ring fill, and unlock a completion certificate at twenty-two." },
  { t: "Every future update, free", p: "It's a live site you log into, not a PDF. When the tools change or I find a better way, new and rewritten modules appear in your account. One payment, forever." },
];

const forYou = [
  "You run a Skool group and everything you've written lives inside it",
  "You sell digital products but don't own a real website",
  "You have content, courses or calls piling up with nowhere to send people",
  "You want a blog that compounds instead of a feed that resets",
  "You'd rather not be on camera",
];

const notForYou = [
  "You want someone to write your content for you",
  "You have no existing content and nothing to say yet",
  "You want a done-for-you agency build",
];

const faqs = [
  { q: "How much is actually automated?", a: "The building and the writing. Claude produces the site files, the articles, the SEO passes, the lead magnets, the images and the twenty-four repurposed assets per article. What stays yours is approval: reading what came back and saying yes or saying what to change. That's deliberate. Anything published under your name should be read by you first." },
  { q: "Do I need a paid Claude plan?", a: "For most of the course, no. Module 1 uses Claude in Chrome, the browser extension that reads your platforms and builds your content inventory automatically, and that needs a paid Claude plan (the cheapest one is enough). If you'd rather not pay for it, Module 1 includes a full by-hand version that takes about an hour with a spreadsheet and gets you the same result. Nothing later in the weekend depends on which route you take. Beyond that, the only thing you have to pay for is your domain." },
  { q: "What if I don't use Skool?", a: "It works the same. Skool is the most common case because so much content gets trapped there, but the method applies to any pile of existing content: a course platform, a newsletter archive, a folder of PDFs." },
  { q: "Will I have to be on camera?", a: "No. Module 18 covers producing brand-consistent images without your face in any of them." },
  { q: "What if I don't have a paid product yet?", a: "Build the site anyway. Every article routes to a free resource, you build the list, and the list tells you what to sell. That's a better sequence than guessing at a product first." },
  { q: "How fast do I get access?", a: "Access is added automatically, usually within an hour of purchase, including evenings and weekends. Your access email goes to the address you buy with and tells you how to open the course. If it hasn't arrived after an hour, check your spam folder, then email hello@thedigitalincomeedit.com if you need help." },
  { q: "What happens when the tools change?", a: "You get the update, free. This is a live site you log into rather than a file you download, so when something changes, or I find a better way to do a step, the module is rewritten and new ones get added. Everyone who has ever bought sees the new version next time they log in." },
  { q: "Is this part of your membership?", a: "No. It's a standalone one-time purchase and isn't part of either membership." },
];

const showKit = kitLive();
const schema = [
      {
        "@type": "Product",
        "name": "The Weekend Ecosystem™",
        "description": "A 22-module course that turns content you have already made into a website and blog on a domain you own, over one weekend, with Claude AI doing the building.",
        "brand": { "@type": "Brand", "name": "The Digital Income Edit™" },
        "url": "https://www.thedigitalincomeedit.com/shop/weekend-ecosystem",
        "image": "https://www.thedigitalincomeedit.com/images/we/hook-blog-posts.jpg",
        "offers": {
          "@type": "Offer",
          "price": "97.00",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://www.thedigitalincomeedit.com/shop/weekend-ecosystem"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          ...OBJECTIONS.map((o) => ({ "@type": "Question", "name": o.q, "acceptedAnswer": { "@type": "Answer", "text": o.a.join(" ") } })),
          ...faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
        ]
      }];
---
<TemplateLayout title="The Weekend Ecosystem™" description="Your own website, blog and email list, built in one weekend from what you already wrote, with Claude doing the building. $97, or 3 × $33.33." ogImage="/og/weekend-ecosystem-2026-09.jpg" schema={schema} stickyHref={HREF} stickyLabel="Get it · $97">

<section class="hh">
 <div class="wrap hh-grid we-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Every update<b class="big">free</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">The Weekend Ecosystem™ · standalone course</p>
   <h1>Your website, blog and email list. <span class="scr">Built around the life you already have.</span></h1>
   <p class="what">Turn the posts and lessons you've already written into a live website on your own domain, with a blog, email capture and a path to your offers. <b>A weekend build course with 22 modules and 37 copy-paste prompts.</b> Claude helps build it.</p>
   <div class="we-price">
     <div class="we-opts"><div><span>Pay once</span><b class="glit">{SALE.ACTIVE ? SALE.price : "$97"}</b><small>one-time</small></div><em>or</em><div><span>Split it</span><b class="glit">3 × $33.33</b><small>three payments, $99.99 total</small></div></div>
     <a class="btn buy" href={HREF}>{S.cta} <span class="ar">→</span></a>
     <p class="we-pn">Both options are at checkout. Every future update included, free.</p>
     <p class="see"><a href="/weekend-ecosystem/preview">Look inside first, free</a></p>
    </div>
  </div>
  <div class="hh-ph we-ph">
   <img src="/images/we/hook-blog-posts.jpg" width="1200" height="1490" fetchpriority="high" decoding="async" alt="The Weekend Ecosystem™: you already wrote the blog posts. They're just sitting in your Skool group.">
   <p class="hh-cap"><b>No code. No camera.</b> Built from what <span>you already wrote.</span></p>
  </div>
 </div>
 <ul class="wrap we-cred"><li><b class="glit">22</b>modules, in build order</li><li><b class="glit">37</b>build prompts, written in full</li><li><b class="glit">3</b>reference vaults</li><li><b class="glit">∞</b>future updates, free</li></ul>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Friday to Sunday</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">Here's what's different <span class="scr">by Sunday.</span></h2>
  <div class="lead"><p>Not a plan for a website. The website, live, with your work already on it.</p></div>
  <div class="p21">
   <div class="col"><span class="scr">Friday</span><div class="card dash"><ul class="chk hm-x">{friday.map((x) => <li>{x}</li>)}</ul></div></div>
   <div class="col"><span class="scr">Sunday</span><div class="card dash"><ul class="chk">{sunday.map((x) => <li>{x}</li>)}</ul></div></div>
  </div>
  <p class="we-foot">And you didn't write anything new.</p>
  <div class="p18">{life.map((x, i) => <div class="box"><div class="cb"></div><span class="step">0{i+1}</span><h3>{x.t}</h3><p>{x.p}</p></div>)}</div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">Built with this system</p>
  <h2 class="h2">This site is <span class="scr">the proof.</span></h2>
  <div class="lead"><p>I built this site faceless and solo with AI, wrote down every step as I went, and that record became the course. The pages you're on right now, the blog, the checkout and the members' area were all built with the twenty-two modules you'd get.</p></div>
  <div class="looks we-proof">{proof.map((p, i) => <a class="look" href={p.u}><span class="ph"><img src={p.img} alt="" loading="lazy" decoding="async"><span class="num">{String(i+1).padStart(2,'0')}</span></span><span class="tag">{p.n}</span><h3>{p.t}</h3><span class="we-go">Read it →</span></a>)}</div>
 </div>
</section>

<section class="sec wash" id="inside">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">Everything in the box</p>
  <h2 class="h2">Here's what you're <span class="scr">actually getting.</span></h2>
  <div class="lead"><p>Not a PDF. A live site you log into, with every piece below waiting inside the minute your access opens.</p></div>
  <div class="faq we-inc">{included.map((x, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{x.t}</h3><p>{x.p}</p></div></div>)}</div>
  <div class="p25 we-mid"><div class="pc dash" style="position:relative"><span class="stk r" style="right:-50px;top:-60px">One payment<b class="big">or three</b></span><div class="pn">All of it, for one payment or three.</div><div class="we-price">
       <div class="we-opts"><div><span>Pay once</span><b class="glit">{SALE.ACTIVE ? SALE.price : "$97"}</b><small>one-time</small></div><em>or</em><div><span>Split it</span><b class="glit">3 × $33.33</b><small>three payments, $99.99 total</small></div></div>
       <a class="btn buy" href={HREF}>{S.cta} <span class="ar">→</span></a>
       <p class="we-pn">Both options are at checkout. Every future update included, free.</p>
       <p class="see"><a href="/weekend-ecosystem/preview">Look inside first, free</a></p>
      </div></div></div>
 </div>
</section>

<section class="quote holo">
 <div class="q we-note"><span class="mk o">“</span>
  <p class="we-nk">A note before you scroll</p>
  <p class="we-nh">You already <span class="glit">wrote it.</span></p>
  <p class="we-nb">Most people start a blog by opening a blank page and trying to think of something to say. Then they do it again Tuesday. Then they stop.</p>
  <p class="we-nb">You have the opposite problem: years of writing sitting in a classroom nobody can search, on a platform you don't own. Lessons. Call recordings. Posts. The DM where you explained your entire method to one person, for free, at midnight.</p>
  <p class="we-nb"><b>This weekend you don't write anything new. You build the place it all lives, works, and compounds.</b></p>
  <span class="scr we-sig">xoxo, Jodie</span>
 <span class="mk c">”</span></div>
</section>

<section class="sec">
 <div class="wrap">
  <h2 class="h2">You're not building a website. <span class="scr">You're approving one.</span></h2>
  <div class="lead"><p>This is the part people don't believe until they see the split.</p></div>
  <div class="p21 we-who">
   <div class="col"><span class="scr">Claude does</span><div class="card dash"><ul class="chk">{claudeDoes.map((x) => <li>{x}</li>)}</ul></div></div>
   <div class="col"><span class="scr">You do</span><div class="card dash"><ul class="chk">{youDo.map((x) => <li>{x}</li>)}</ul><p class="we-who-n">That's the whole job. Three moves, twenty-two times.</p></div></div>
  </div>
  <p class="kick" style="margin-top:56px">You never have to</p>
  <ul class="we-never">{neverDo.map((x) => <li>{x}</li>)}</ul>
 </div>
</section>

<div class="band"><svg class="spk sm" style="left:20%"><use href="#sp"/></svg><h2>Hour by hour</h2><svg class="spk" style="right:20%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">The weekend, <span class="scr">hour by hour.</span></h2>
  <div class="lead"><p>Sixteen hours in six phases. Each builds a working piece, and each piece feeds the next: the website holds the blog, the blog fills the list, the list buys the product.</p></div>
  <div class="p18 we-phases">{phases.map((p, i) => <div class="box"><span class="num hm-num">{String(i+1).padStart(2,'0')}</span><span class="step">{p.day} · {p.hrs} hrs</span><h3>{p.title}</h3>{p.sub && <p class="we-ps">{p.sub.charAt(0).toUpperCase() + p.sub.slice(1)}</p>}<ol>{p.mods.map((m) => <li><b>{String(m.num).padStart(2, "0")}</b>{m.title}</li>)}</ol></div>)}</div>
 </div>
</section>

<section class="sec" id="questions">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Before you decide</span></p>
  <h2 class="h2">The six things <span class="scr">that stop people.</span></h2>
  <div class="faq">{OBJECTIONS.map((o) => <div class="qa" id={o.id}><span class="n">{String(o.n).padStart(2,'0')}</span><div><h3>{o.q}</h3>{o.a.map((para) => <p>{para}</p>)}{o.kit && showKit && <p data-kit-deadline={KIT_DEADLINE}>The Keep It Running Kit comes with orders before the deadline.</p>}</div></div>)}</div>
  <div class="sh-rv"><Testimonial variant="pull" /></div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">Is it <span class="scr">for you?</span></h2>
  <div class="p21">
   <div class="col"><span class="scr">Yes</span><div class="card dash"><h3>This is for you if</h3><ul class="chk">{forYou.map((x) => <li>{x}</li>)}</ul></div></div>
   <div class="col"><span class="scr">Not yet</span><div class="card dash"><h3>It isn't if</h3><ul class="chk hm-x">{notForYou.map((x) => <li>{x}</li>)}</ul></div></div>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <svg class="spk" style="left:8%;top:40px"><use href="#sp"/></svg>
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Everything else</span></p>
  <h2 class="h2">Your questions, <span class="scr">answered.</span></h2>
  <div class="faq">{faqs.map((x, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{x.q}</h3><p>{x.a}</p></div></div>)}</div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <div class="p42 dash we-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">One<b class="big">weekend</b></span>
   <div class="ph"><img src="/images/pages/we-close-kitchen-1200.webp" width="1200" height="1489" loading="lazy" decoding="async" alt="Tommy Kate working on her laptop at the kitchen table with her golden retriever"></div>
   <div class="tx">
    <p class="kick">One weekend from here</p>
    <h2>You were a digital product seller.</h2>
    <span class="scr">Now you own the infrastructure.</span>
    <p>A website, a blog and a list that keep working on the days you don't. You pay once and own the thing. It costs about a dollar a month to run, plus your domain.</p>
    <div class="we-price">
     <div class="we-opts"><div><span>Pay once</span><b class="glit">{SALE.ACTIVE ? SALE.price : "$97"}</b><small>one-time</small></div><em>or</em><div><span>Split it</span><b class="glit">3 × $33.33</b><small>three payments, $99.99 total</small></div></div>
     <a class="btn buy" href={HREF}>{S.cta} <span class="ar">→</span></a>
     <p class="we-pn">Both options are at checkout. Every future update included, free.</p>
     <p class="see"><a href="/weekend-ecosystem/preview">Look inside first, free</a></p>
    </div>
    <p class="we-acc">{S.access}</p>
   </div>
  </div>
 </div>
</section>
</TemplateLayout>
