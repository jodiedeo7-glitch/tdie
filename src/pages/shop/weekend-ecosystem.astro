---
import PageLayout from "../../layouts/PageLayout.astro";
import { MODULES } from "../../we-manifest.js";

// PLACEHOLDER — fill when the Beacons product is created. Do not guess.
const CHECKOUT = "";

const phases = [...new Set(MODULES.map((m) => m.phase))].map((p) => {
  const inPhase = MODULES.filter((m) => m.phase === p);
  const [when, what] = [inPhase[0].phaseLabel, inPhase[0].phaseSub];
  return {
    day: when.split("·")[1]?.trim() ?? when,
    title: what.split("—")[0].trim(),
    sub: what.split("—")[1]?.trim(),
    accent: inPhase[0].accent,
    mods: inPhase,
  };
});

const problems = [
  { t: "It's all trapped in Skool", p: "Every lesson, every call, every post you've written. None of it searchable, none of it ranking, none of it on a domain you own." },
  { t: "Nobody finds you unless they already know you", p: "A member has to join before they can read a word. There's no front door — only a members' entrance." },
  { t: "You post, then you post again", p: "A feed resets to zero every day. Nothing you made last March is working for you this March." },
  { t: "You've started a blog three times", p: "Blank page, no idea what to write, quit by week three. That's not a discipline problem. It's a wrong-starting-point problem." },
];

const ACC = ["#CBB7F7","#CD9CDD","#CF80C2","#D265A8","#D4498D","#D62E73"];

const stats = [
  { n: "22", l: "Modules" },
  { n: "36", l: "Prompts, verbatim" },
  { n: "3", l: "Reference vaults" },
  { n: "1", l: "Weekend" },
];

const included = [
  { t: "22 modules", p: "Each one teaches the step, hands you the prompt, and tells you what breaks there and how to fix it." },
  { t: "The Quick Sheet", p: "All 36 prompts on one page in running order, one line each. For your second build, and your third." },
  { t: "The Prompt Vault", p: "Every prompt verbatim and organised by tool — Claude, Chrome, image generation, GitHub." },
  { t: "The Troubleshooting Vault", p: "An FAQ plus every roadblock from a real build, paired with the fix that worked." },
  { t: "The Template Vault", p: "Canon File, pillar map, live-facts block, product register, operating cadence. Fill in and keep." },
  { t: "Progress tracking + certificate", p: "Tick off each module, watch the ring fill, and unlock a completion certificate at twenty-two." },
];

const proof = [
  { t: "How to Build a Faceless Digital Business", u: "/learn/how-to-build-a-faceless-digital-business", n: "3,000+ words" },
  { t: "The Complete Pinterest Marketing Guide", u: "/learn/complete-pinterest-marketing-guide", n: "Pillar + cluster" },
  { t: "Automating Your Online Business", u: "/learn/automating-your-online-business", n: "Built from a lesson" },
];

const claudeDoes = [
  "Writes every file your website needs — config, layouts, pages, the homepage",
  "Turns a Skool lesson into a 3,000-word article written for a stranger",
  "Runs four separate SEO passes over it — Google, Pinterest, AI search, readability",
  "Generates the supporting article cluster around each pillar",
  "Builds your email capture, resource pages and bridge pages",
  "Writes your lead magnets from your own material",
  "Turns one article into ten pins, a carousel, two reels, three posts and an email",
  "Generates every image, on brand, without your face",
  "Commits the finished files straight to your site",
];

const youDo = [
  "Paste the prompt",
  "Read what came back",
  "Say yes, or say what to change",
];

const neverDo = [
  "Write code",
  "Design a page",
  "Hire a developer",
  "Learn WordPress",
  "Write a blog post from a blank page",
  "Film yourself",
  "Think of content ideas",
  "Post daily to stay visible",
  "Pay monthly for a site builder",
];

const bySunday = [
  "A website on a domain you own, deploying automatically",
  "A pillar article and the start of a cluster around it",
  "Email capture that works — tested by you, not assumed",
  "A free resource with automated delivery",
  "Every reader routed to a free offer and a paid one",
  "Bridge pages, so every outbound link is yours to change",
  "A traffic source that compounds instead of resetting",
  "One article turning into a month of assets",
  "Brand-consistent images without your face in any of them",
  "A cadence you can hold at 2–4 hours a day",
];

const forYou = [
  "You run a Skool group and everything you've written lives inside it",
  "You sell digital products but don't own a real website",
  "You have content, courses or calls piling up with nowhere to send people",
  "You want a blog that compounds instead of a feed that resets",
  "You'd rather not be on camera",
];

const notForYou = [
  "You want someone to write your content for you",
  "You have no existing content and nothing to say yet",
  "You want a done-for-you agency build",
];

const faqs = [
  { q: "Do I need to know how to code?", a: "No, and you won't write a line of it. Claude generates every file; you paste it and click commit. If something is wrong the deploy fails and tells you in plain English, and you paste that back. The course assumes you have never opened a code editor." },
  { q: "How much is actually automated?", a: "The building and the writing. Claude produces the site files, the articles, the SEO passes, the lead magnets, the images and the thirty repurposed assets per article. What stays yours is approval — reading what came back and saying yes or saying what to change. That's deliberate. Anything published under your name should be read by you first." },
  { q: "What does it cost to run the site?", a: "About a dollar a month. GitHub and Vercel are free at your traffic level; the domain is $10–15 a year." },
  { q: "Do I need a paid Claude plan?", a: "It makes the longer builds smoother, but no module requires a specific plan or any tool subscription beyond your domain." },
  { q: "Can I really do it in a weekend?", a: "The build, yes — the modules are timed to it: two hours Friday, eight Saturday, five Sunday. Filling the site out afterwards is ongoing, which is what the operating cadence in Module 21 is for." },
  { q: "What if I don't use Skool?", a: "It works the same. Skool is the most common case because so much content gets trapped there, but the method applies to any pile of existing content — a course platform, a newsletter archive, a folder of PDFs." },
  { q: "Will I have to be on camera?", a: "No. Module 18 covers producing brand-consistent images without your face in any of them." },
  { q: "What if I don't have a paid product yet?", a: "Build the site anyway. Every article routes to a free resource, you build the list, and the list tells you what to sell. That's a better sequence than guessing at a product first." },
  { q: "Is this part of your membership?", a: "No. It's a standalone one-time purchase and isn't part of any membership tier." },
];
---
<PageLayout
  wide
  title="The Weekend Ecosystem™"
  description="The website-and-blog system that turns digital product sellers into digital business owners. Built from what you already have, in one weekend, with Claude AI. $97 one-time."
>
  <!-- HERO -->
  <section class="we-hero">
    <div class="page-eyebrow">Standalone Course · $97 one-time</div>
    <h1>The Weekend <em>Ecosystem™</em></h1>
    <p class="lede">Your website + blog, built from what you already have. One weekend with Claude, and you're a business owner — not just a product seller.</p>
    <div class="we-cta-row">
      {CHECKOUT
        ? <a class="btn" href={CHECKOUT}>Get the course — $97 <span class="a">→</span></a>
        : <span class="we-soon">Enrollment opens shortly</span>}
    </div>
    <p class="we-access">Access is tied to the email you buy with — use one you check.</p>
    <div class="we-hero-strip">
      {phases.map((p, i) => (
        <span class="we-chip" style={`--ac:${p.accent}`}>
          <span class="we-chip-n">{String(i).padStart(2, "0")}</span>{p.title}
        </span>
      ))}
    </div>
  </section>

  <section class="we-stats">
    {stats.map((s, i) => (
      <div class="we-stat" style={`--ac:${ACC[i * 2 > 5 ? 5 : i * 2]}`}>
        <span class="we-stat-n">{s.n}</span>
        <span class="we-stat-l">{s.l}</span>
      </div>
    ))}
  </section>

  <!-- THESIS -->
  <section class="we-block we-thesis">
    <h2>You already wrote it</h2>
    <p class="we-lead">Most people start a blog by opening a blank page and trying to think of something to say. Then they do it again Tuesday. Then they stop.</p>
    <p class="we-lead">You have the opposite problem — years of writing sitting in a classroom nobody can search, on a platform you don't own. Lessons. Call recordings. Posts. The DM where you explained your entire method to one person, for free, at midnight.</p>
    <p class="we-lead we-lead-hit">This weekend you don't write anything new. You build the place it all lives, works, and compounds.</p>
  </section>

  <!-- PROOF -->
  <section class="we-block we-proof">
    <span class="we-proof-tag">Built with this system</span>
    <h2>You're reading this on it</h2>
    <p class="we-sublead">This website, and every article on it, came out of the process in this course. Most of them started life as a lesson inside my Skool group. Open one and see what a Skool lesson looks like after a Saturday afternoon.</p>
    <div class="we-proof-grid">
      {proof.map((p) => (
        <a class="we-proof-card" href={p.u}>
          <span class="we-proof-n">{p.n}</span>
          <span class="we-proof-t">{p.t}</span>
          <span class="we-proof-go">Read it →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="we-block">
    <h2>What's actually wrong right now</h2>
    <div class="we-grid">
      {problems.map((x, i) => (
        <div class="we-card">
          <span class="we-num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{x.t}</h3>
          <p>{x.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- THE WEEKEND -->
  <section class="we-block">
    <h2>The weekend, hour by hour</h2>
    <p class="we-sublead">Six phases. Each builds a working piece, and each piece feeds the next — the website holds the blog, the blog fills the list, the list buys the product.</p>
    <div class="we-phases">
      {phases.map((p, i) => (
        <div class="we-phase" style={`--ac:${p.accent}`}>
          <span class="we-phase-edge"></span>
          <div class="we-phase-head">
            <span class="we-phase-n">{String(i).padStart(2, "0")}</span>
            <div>
              <span class="we-phase-when">{p.day}</span>
              <h3 class="we-phase-t">{p.title}</h3>
              <p class="we-phase-s">{p.sub}</p>
            </div>
          </div>
          <ul class="we-phase-mods">
            {p.mods.map((m) => (
              <li><span class="we-pm-n">{String(m.num).padStart(2, "0")}</span>{m.title}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- HANDS OFF -->
  <section class="we-block">
    <h2>Who does what</h2>
    <p class="we-sublead">This is the part people don't believe until they see the split. You are not building a website this weekend. You are approving one.</p>

    <div class="we-who">
      <div class="we-who-col we-who-ai">
        <span class="we-who-tag">Claude does</span>
        <ul>{claudeDoes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="we-who-col we-who-you">
        <span class="we-who-tag">You do</span>
        <ul>{youDo.map((x) => <li>{x}</li>)}</ul>
        <p class="we-who-note">That's the whole job. Three moves, twenty-two times.</p>
      </div>
    </div>

    <div class="we-never">
      <span class="we-never-tag">You never have to</span>
      <div class="we-never-grid">
        {neverDo.map((x) => <span class="we-never-chip">{x}</span>)}
      </div>
    </div>
  </section>

  <!-- WHAT'S INCLUDED -->
  <section class="we-block">
    <h2>What comes with it</h2>
    <div class="we-grid we-grid-3">
      {included.map((x, i) => (
        <div class="we-card we-card-pink" style={`--ac:${ACC[i]}`}>
          <h3>{x.t}</h3>
          <p>{x.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- INSIDE -->
  <section class="we-block">
    <h2>Inside the course</h2>
    <p class="we-sublead">Every prompt sits in a copy card. Every module has its own colour, a numbered spine of actions, and a collapsed panel of fixes for when something breaks.</p>
    <div class="we-inside">
      <div class="we-shot">
        <div class="we-shot-bar"><span></span><span></span><span></span></div>
        <div class="we-shot-body">
          <span class="we-shot-eyebrow">Phase 0 — Module 2 of 22</span>
          <span class="we-shot-h">Build Your Canon File</span>
          <div class="we-shot-step"><span class="we-shot-num">01</span><span class="we-shot-label">Copy and fill</span></div>
          <div class="we-shot-prompt">
            <div class="we-shot-prompt-bar"><span>Copy this prompt</span><em>Copy</em></div>
            <code>CANON FILE — [YOUR BRAND]<br/><br/>PRODUCTS — exact names, prices, URLs<br/>| Product | Price | Platform | URL |<br/><br/>DOES NOT EXIST — never reference<br/>- No free trial<br/>- No annual plan</code>
          </div>
          <div class="we-shot-road"><span>If you get stuck</span><em>+ Claude keeps forgetting my Canon File</em></div>
        </div>
      </div>
      <div class="we-inside-side">
        <div class="we-mini">
          <span class="we-mini-tag">Progress</span>
          <div class="we-mini-ring"><span>22</span></div>
          <p>Tick each module off. The ring fills as you go, and every phase keeps its own tally.</p>
        </div>
        <div class="we-mini we-mini-cert">
          <span class="we-mini-tag">At twenty-two</span>
          <span class="we-mini-cert-h">Certificate of Completion</span>
          <p>Your name, the date, and something to post when you're done.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- BY SUNDAY -->
  <section class="we-block">
    <h2>By Sunday afternoon</h2>
    <ul class="we-checks">{bySunday.map((x) => <li><span class="we-tick"></span>{x}</li>)}</ul>
  </section>

  <!-- FIT -->
  <section class="we-block we-split">
    <div>
      <h3 class="we-sub">This is for you if</h3>
      <ul class="we-list we-list-tight">{forYou.map((x) => <li>{x}</li>)}</ul>
    </div>
    <div>
      <h3 class="we-sub">It isn't if</h3>
      <ul class="we-list we-list-tight we-list-muted">{notForYou.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="we-block">
    <h2>Questions</h2>
    <div class="we-faq">
      {faqs.map((x) => (
        <details>
          <summary>{x.q}</summary>
          <p>{x.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CLOSE -->
  <section class="we-close">
    <span class="we-close-eyebrow">One weekend from here</span>
    <h2>You were a digital product seller.</h2>
    <p class="lede">Now you own the infrastructure.</p>
    <div class="we-cta-row">
      {CHECKOUT
        ? <a class="btn" href={CHECKOUT}>Get the course — $97 <span class="a">→</span></a>
        : <span class="we-soon">Enrollment opens shortly</span>}
    </div>
    <p class="we-close-note">One-time payment, $97. Access is tied to the email you buy with — use one you check.</p>
    <p class="we-close-anchor">A developer quotes four figures for this build. A site builder charges more than this every year, forever. You pay once and own the thing.</p>
  </section>

  <style>
    /* ── hero ── */
    .we-hero{text-align:center;padding:10px 0 54px}
    .we-hero .page-eyebrow{color:var(--pink)!important}
    .we-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(44px,8.4vw,86px);line-height:.96;letter-spacing:-2px;margin:0 0 26px;color:#2B161B}
    .we-hero h1 em{font-style:italic;color:var(--pink)}
    .we-hero .lede{max-width:600px;margin:0 auto 36px;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:25px;line-height:1.5;color:#5A4048}
    .we-cta-row{display:flex;justify-content:center;gap:18px;flex-wrap:wrap}
    .we-soon{display:inline-block;padding:16px 36px;border-radius:4px;font-size:12px;letter-spacing:2.2px;text-transform:uppercase;
             background:rgba(214,46,115,.08);border:1px solid rgba(214,46,115,.3);color:var(--pink)}
    .we-hero-strip{display:flex;justify-content:center;gap:8px;flex-wrap:wrap;margin-top:46px}
    .we-chip{display:inline-flex;align-items:center;gap:7px;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;padding:8px 15px;border-radius:22px;
             background:color-mix(in srgb,var(--ac) 26%,transparent);color:#3B2228;border:1px solid color-mix(in srgb,var(--ac) 60%,transparent)}
    .we-chip-n{font-family:"JetBrains Mono",monospace;font-size:10px;opacity:.55}

    /* ── stat strip ── */
    .we-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:rgba(43,22,27,.12);
              border:1px solid rgba(43,22,27,.12);border-radius:6px;overflow:hidden;margin-bottom:8px}
    .we-stat{background:#FBF8F5;padding:26px 18px;text-align:center}
    .we-stat-n{display:block;font-family:"Fraunces",serif;font-size:clamp(34px,4.6vw,50px);font-weight:300;line-height:1;color:var(--ac);letter-spacing:-1.5px}
    .we-stat-l{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#7A5C63;margin-top:10px}

    /* ── blocks ── */
    .we-block{padding:76px 0;border-top:1px solid rgba(43,22,27,.1)}
    .we-block h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(30px,5vw,50px);line-height:1.04;margin:0 0 22px;letter-spacing:-1px;color:#2B161B}
    .we-lead{font-size:18.5px;line-height:1.8;max-width:640px;margin:0 0 20px;color:#3B2228}
    .we-lead-hit{font-family:"Cormorant Garamond",serif;font-size:25px;font-style:italic;line-height:1.55;color:var(--pink);
                 border-left:2px solid var(--pink);padding-left:22px;margin-top:30px}
    .we-sublead{font-size:17px;line-height:1.72;color:#5A4048;max-width:640px;margin:0 0 40px}
    .we-thesis{border-top:none;padding-top:70px}

    /* ── problem cards ── */
    .we-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:36px}
    .we-grid-3{grid-template-columns:repeat(auto-fit,minmax(250px,1fr))}
    .we-card{padding:28px 28px 26px;border-radius:6px;background:#FFFDFB;border:1px solid rgba(43,22,27,.14)}
    .we-card-pink{background:linear-gradient(160deg,color-mix(in srgb,var(--ac) 20%,transparent),color-mix(in srgb,var(--ac) 5%,transparent));
                  border:1px solid color-mix(in srgb,var(--ac) 44%,transparent)}
    .we-card h3{font-family:"Fraunces",serif;font-weight:400;font-size:20px;margin:0 0 11px;line-height:1.22;color:#2B161B}
    .we-card p{font-size:15.5px;line-height:1.7;margin:0;color:#57404A}
    .we-num{display:block;font-family:"JetBrains Mono",monospace;font-size:12px;letter-spacing:2px;color:var(--pink);margin-bottom:14px}

    /* ── phases ── */
    .we-phases{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .we-phase{position:relative;overflow:hidden;border:1px solid color-mix(in srgb,var(--ac) 40%,transparent);border-radius:6px;padding:26px 28px 24px;
              background:linear-gradient(165deg,color-mix(in srgb,var(--ac) 22%,transparent),color-mix(in srgb,var(--ac) 5%,transparent))}
    .we-phase-edge{position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--ac)}
    .we-phase-head{display:flex;gap:16px;align-items:flex-start;padding-bottom:16px;margin-bottom:14px;border-bottom:1px solid color-mix(in srgb,var(--ac) 55%,transparent)}
    .we-phase-n{font-family:"Fraunces",serif;font-size:54px;font-weight:300;line-height:.8;color:var(--ac);letter-spacing:-2.5px;flex-shrink:0}
    .we-phase-when{display:block;font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#8A6B44;margin-bottom:5px}
    .we-phase-t{font-family:"Fraunces",serif;font-weight:400;font-size:23px;margin:0 0 4px;line-height:1.12;color:#2B161B}
    .we-phase-s{font-size:14.5px;line-height:1.5;color:#5A4048;margin:0}
    .we-phase-mods{list-style:none;padding:0;margin:0}
    .we-phase-mods li{font-size:15.5px;line-height:1.45;padding:7px 0;color:#2B161B}
    .we-pm-n{font-family:"JetBrains Mono",monospace;font-size:10.5px;letter-spacing:1px;color:color-mix(in srgb,var(--ac) 78%,#2B161B);margin-right:10px}

    /* ── proof ── */
    .we-proof{border-top:none;padding-top:0}
    .we-proof-tag{display:block;font-family:"JetBrains Mono",monospace;font-size:10.5px;letter-spacing:2.6px;text-transform:uppercase;color:var(--pink);margin-bottom:14px}
    .we-proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:34px}
    .we-proof-card{display:flex;flex-direction:column;gap:9px;padding:22px 22px 20px;border-radius:6px;text-decoration:none;
                   background:linear-gradient(165deg,rgba(203,183,247,.2),rgba(214,46,115,.06));
                   border:1px solid rgba(185,162,232,.5);transition:transform .2s,border-color .2s}
    .we-proof-card:hover{transform:translateY(-2px);border-color:var(--pink)}
    .we-proof-n{font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:1.8px;text-transform:uppercase;color:#6B4FA8}
    .we-proof-t{font-family:"Fraunces",serif;font-size:19px;line-height:1.24;color:#2B161B}
    .we-proof-go{font-size:12.5px;letter-spacing:1.4px;text-transform:uppercase;color:var(--pink);margin-top:auto;padding-top:6px}

    /* ── inside the course ── */
    .we-inside{display:grid;grid-template-columns:1.42fr 1fr;gap:18px;margin-top:36px;align-items:start}
    .we-shot{border-radius:8px;overflow:hidden;border:1px solid rgba(43,22,27,.16);background:#FBF8F5;box-shadow:0 10px 34px rgba(43,22,27,.09)}
    .we-shot-bar{display:flex;gap:6px;padding:11px 14px;background:rgba(43,22,27,.055);border-bottom:1px solid rgba(43,22,27,.09)}
    .we-shot-bar span{width:9px;height:9px;border-radius:50%;background:rgba(43,22,27,.16)}
    .we-shot-body{padding:24px 26px 26px}
    .we-shot-eyebrow{display:block;font-family:"JetBrains Mono",monospace;font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:#CD9CDD;margin-bottom:10px}
    .we-shot-h{display:block;font-family:"Fraunces",serif;font-size:27px;font-weight:300;letter-spacing:-.6px;color:#2B161B;margin-bottom:22px}
    .we-shot-step{display:flex;align-items:center;gap:13px;margin-bottom:14px}
    .we-shot-num{width:31px;height:31px;border-radius:50%;background:#CD9CDD;color:#fff;display:flex;align-items:center;justify-content:center;
                 font-family:"JetBrains Mono",monospace;font-size:11px;flex-shrink:0}
