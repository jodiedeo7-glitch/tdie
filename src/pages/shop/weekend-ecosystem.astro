---
import PageLayout from "../../layouts/PageLayout.astro";
import { MODULES } from "../../we-manifest.js";
import { S, HREF } from "../../we-stage.js";
import { OBJECTIONS } from "../../we-objections.js";
import { KIT_DEADLINE, kitLive } from "../../we-kit.js";
import SaleBanner from "../../components/SaleBanner.astro";
import KitBanner from "../../components/KitBanner.astro";
import Testimonial from "../../components/Testimonial.astro";
import WePrice from "../../components/WePrice.astro";
import WeBundle from "../../components/WeBundle.astro";
import WeRibbon from "../../components/WeRibbon.astro";
import "../../styles/we.css";

// Hours per phase, from the weekend timeline: 2 + 3 + 3 + 3 + 3 + 2 = 16.
const HOURS = [2, 3, 3, 3, 3, 2];
const phases = [...new Set(MODULES.map((m) => m.phase))].map((p, i) => {
  const inPhase = MODULES.filter((m) => m.phase === p);
  const [when, what] = [inPhase[0].phaseLabel, inPhase[0].phaseSub];
  return {
    day: when.split("·")[1]?.trim() ?? when,
    title: what.split("—")[0].trim(),
    sub: what.split("—")[1]?.trim(),
    accent: inPhase[0].accent,
    hrs: HOURS[i],
    mods: inPhase,
  };
});

const friday = [
  "Content scattered across a platform you don't own",
  "No website",
  "No blog",
  "Nobody finds you unless they already know you",
];

const sunday = [
  "A website on a domain you own, deploying automatically",
  "A blog Google can find, starting with a pillar article",
  "An email list that captures, tested by you, not assumed",
  "A free resource with automated delivery",
  "Every reader routed to a free offer and a paid one",
  "Brand-consistent images without your face in any of them",
];

const life = [
  { t: "Your time back", p: "One article turns into a month of pins, posts and emails. You stop posting daily just to stay visible." },
  { t: "Your control", p: "Your domain, your list, your links. Bridge pages mean every outbound link is yours to change. Nothing you build is rented." },
  { t: "Your face, optional", p: "Every image on your site is generated on brand, without you in it. Nobody needs you on camera." },
];

const proof = [
  { t: "How to Build a Faceless Digital Business", u: "/learn/how-to-build-a-faceless-digital-business", n: "3,000+ words" },
  { t: "The Complete Pinterest Marketing Guide", u: "/learn/complete-pinterest-marketing-guide", n: "Pillar + cluster" },
  { t: "Automating Your Online Business", u: "/learn/automating-your-online-business", n: "Built from a lesson" },
];

const claudeDoes = [
  "Writes every file your website needs: config, layouts, pages, the homepage",
  "Turns a Skool lesson into a 3,000-word article written for a stranger",
  "Runs four separate SEO passes over it: Google, Pinterest, AI search, readability",
  "Generates the supporting article cluster around each pillar",
  "Builds your email capture, resource pages and bridge pages",
  "Writes your lead magnets from your own material",
  "Turns one article into twenty-four assets across six platforms",
  "Generates every image, on brand, without your face",
  "Commits the finished files straight to your site",
];

const youDo = ["Paste the prompt", "Read what came back", "Say yes, or say what to change"];

const neverDo = [
  "Write code", "Design a page", "Hire a developer", "Learn WordPress", "Write a blog post from a blank page",
  "Film yourself", "Think of content ideas", "Post daily to stay visible", "Pay monthly for a site builder",
];


const included = [
  { t: "22 modules", p: "My exact build, in order. Each one teaches the step, hands you the prompt I used, and tells you what broke for me there and how I fixed it." },
  { t: "The Quick Sheet", p: "All 36 prompts on one page in running order, one line each. For your second build, and your third." },
  { t: "The Prompt Vault", p: "Every prompt verbatim and organised by tool: Claude, Chrome, image generation, GitHub." },
  { t: "The Troubleshooting Vault", p: "An FAQ plus every roadblock from a real build, paired with the fix that worked." },
  { t: "The Template Vault", p: "Canon File, pillar map, live-facts block, product register, operating cadence. Fill in and keep." },
  { t: "The Ask-For-It List", p: "51 things you can change on your site by asking in one sentence: design tweaks, new pages, fixes, legal pages, SEO. The list I actually use." },
  { t: "Progress tracking + certificate", p: "Tick off each module, watch the ring fill, and unlock a completion certificate at twenty-two." },
  { t: "Every future update, free", p: "It's a live site you log into, not a PDF. When the tools change or I find a better way, new and rewritten modules appear in your account. One payment, forever." },
];

const forYou = [
  "You run a Skool group and everything you've written lives inside it",
  "You sell digital products but don't own a real website",
  "You have content, courses or calls piling up with nowhere to send people",
  "You want a blog that compounds instead of a feed that resets",
  "You'd rather not be on camera",
];

const notForYou = [
  "You want someone to write your content for you",
  "You have no existing content and nothing to say yet",
  "You want a done-for-you agency build",
];

const faqs = [
  { q: "How much is actually automated?", a: "The building and the writing. Claude produces the site files, the articles, the SEO passes, the lead magnets, the images and the twenty-four repurposed assets per article. What stays yours is approval: reading what came back and saying yes or saying what to change. That's deliberate. Anything published under your name should be read by you first." },
  { q: "Do I need a paid Claude plan?", a: "For most of the course, no. Module 1 uses Claude in Chrome, the browser extension that reads your platforms and builds your content inventory automatically, and that needs a paid Claude plan (the cheapest one is enough). If you'd rather not pay for it, Module 1 includes a full by-hand version that takes about an hour with a spreadsheet and gets you the same result. Nothing later in the weekend depends on which route you take. Beyond that, the only thing you have to pay for is your domain." },
  { q: "What if I don't use Skool?", a: "It works the same. Skool is the most common case because so much content gets trapped there, but the method applies to any pile of existing content: a course platform, a newsletter archive, a folder of PDFs." },
  { q: "Will I have to be on camera?", a: "No. Module 18 covers producing brand-consistent images without your face in any of them." },
  { q: "What if I don't have a paid product yet?", a: "Build the site anyway. Every article routes to a free resource, you build the list, and the list tells you what to sell. That's a better sequence than guessing at a product first." },
  { q: "How fast do I get access?", a: "I open it by hand for each buyer rather than running an automated system, so it's usually within the hour during waking hours. I'm one person, so please allow a few hours if you buy late at night. You'll get an email the moment your access is live, telling you exactly how to get in. If it's been longer than that, email hello@thedigitalincomeedit.com and I'll sort it straight away." },
  { q: "What happens when the tools change?", a: "You get the update, free. This is a live site you log into rather than a file you download, so when something changes, or I find a better way to do a step, the module is rewritten and new ones get added. Everyone who has ever bought sees the new version next time they log in." },
  { q: "Is this part of your membership?", a: "No. It's a standalone one-time purchase and isn't part of either membership." },
];

const showKit = kitLive();
---
<PageLayout
  ogImage="/og/weekend-ecosystem-2026-09.jpg"
  wide
  title="The Weekend Ecosystem™"
  description="A business that keeps selling on the Tuesday you're too tired to post: your own website, blog and email list, built in one weekend from content you already wrote, with Claude AI. $97 one-time, or 3 × $33.33."
>
<div class="wx">

  <!-- HERO: ideal state first, price and one CTA on the first screen -->
  <section class="wx-hero">
    <div>
      <p class="wx-brand"><span class="wx-dot"></span><span>The Weekend Ecosystem™<span class="wx-brand-x"> · Standalone course</span></span></p>
      <SaleBanner variant="bar" />
      <h1>A business that keeps selling <em>on the Tuesday you're too tired to post.</em></h1>
      <p class="wx-lede">Your own website, blog and email list, on a domain you own. Your articles sit where Google can find them, every page collects emails, and every reader is routed to your free offer and your paid one. <strong>Built in one weekend from content you've already written. No code, and your face is never required.</strong></p>
      <WePrice id="get" preview />
    </div>
    <div class="wx-collage">
      <figure class="wx-polaroid">
        <span class="wx-tape wx-tape-l" aria-hidden="true"></span>
        <img src="/images/we/cover-sofa.jpg" alt="A woman on a farmhouse porch at sunrise holding a pink mug, the red barn and pasture behind her." loading="eager" width="1200" height="1490" />
        <figcaption>Tuesday. Porch. Coffee. The site's still working.</figcaption>
      </figure>
      <div class="wx-collage-peek"><WeBundle variant="peek" /></div>
      <span class="wx-sticker wx-sticker-a" aria-hidden="true"><span>No code<br />no camera</span></span>
      <span class="wx-sticker wx-sticker-b" aria-hidden="true"><span>Every update<br />free</span></span>
    </div>
  </section>

  <WeRibbon />

  {showKit && <KitBanner variant="hero" />}

  <!-- IDEAL STATE: Friday to Sunday, before any module list -->
  <section class="wx-sec">
    <span class="wx-kicker" style="text-align:center">Friday night to Sunday afternoon</span>
    <h2 class="wx-sec-h">Here's what's different <em>by Sunday.</em></h2>
    <p class="wx-sub">Not a plan for a website. The website, live, with your work already on it.</p>
    <div class="wx-fs">
      <div class="wx-card wx-fri">
        <h3>Friday</h3>
        <ul>{friday.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="wx-hot wx-sun">
        <h3>Sunday</h3>
        <ul>{sunday.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
    <p class="wx-fs-foot">And you didn't write anything new.</p>

    <div class="wx-life">
      {life.map((x) => (
        <div class="wx-card">
          <h3>{x.t}</h3>
          <p>{x.p}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- WHAT'S IN THE BOX: the packaging, right after the ideal state -->
  <section class="wx-sec" id="inside">
    <span class="wx-kicker" style="text-align:center">Everything in the box</span>
    <h2 class="wx-sec-h">Here's what you're <em>actually getting.</em></h2>
    <p class="wx-sub">Not a PDF. A live site you log into, with every piece below waiting inside the minute your access opens.</p>
    <WeBundle />
    <ul class="wx-box-list">
      {included.map((x) => (
        <li><b>{x.t}</b><span>{x.p}</span></li>
      ))}
    </ul>

    <div class="wx-card wx-mid">
      <p class="wx-mid-l">All of it, for one payment or three.</p>
      <WePrice preview />
    </div>
  </section>

  <!-- A NOTE FROM JODIE -->
  <section class="wx-sec">
    <div class="wx-note">
      <span class="wx-tape wx-tape-c" aria-hidden="true"></span>
      <span class="wx-note-k">A note before you scroll</span>
      <h2>You already <em>wrote it.</em></h2>
      <p>Most people start a blog by opening a blank page and trying to think of something to say. Then they do it again Tuesday. Then they stop.</p>
      <p>You have the opposite problem: years of writing sitting in a classroom nobody can search, on a platform you don't own. Lessons. Call recordings. Posts. The DM where you explained your entire method to one person, for free, at midnight.</p>
      <p class="wx-note-hit">This weekend you don't write anything new. You build the place it all lives, works, and compounds.</p>
      <p class="wx-sign">xoxo, Jodie</p>
    </div>
  </section>

  <!-- SHOW THE MACHINE -->
  <section class="wx-sec">
    <span class="wx-kicker" style="text-align:center">Built with this system</span>
    <h2 class="wx-sec-h">This site is <em>the proof.</em></h2>
    <p class="wx-sub">I built this site faceless and solo with AI, wrote down every step as I went, and that record became the course. The pages you're on right now, the blog, the checkout and the members' area were all built with the twenty-two modules you'd be buying. Open an article and see what one of my Skool lessons looks like after a Saturday afternoon.</p>
    <div class="wx-proof">
      {proof.map((p) => (
        <a class="wx-card" href={p.u}>
          <span class="wx-proof-n">{p.n}</span>
          <span class="wx-proof-t">{p.t}</span>
          <span class="wx-proof-go">Read it →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- WHO DOES WHAT -->
  <section class="wx-sec">
    <h2 class="wx-sec-h">You're not building a website. <em>You're approving one.</em></h2>
    <p class="wx-sub">This is the part people don't believe until they see the split.</p>
    <div class="wx-who">
      <div class="wx-card wx-who-ai">
        <span class="wx-kicker" style="color:#6B4FA8">Claude does</span>
        <ul>{claudeDoes.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="wx-hot wx-who-you">
        <span class="wx-kicker">You do</span>
        <ul>{youDo.map((x) => <li>{x}</li>)}</ul>
        <p class="wx-who-note">That's the whole job. Three moves, twenty-two times.</p>
      </div>
    </div>
    <div class="wx-card">
      <span class="wx-kicker">You never have to</span>
      <div class="wx-never-grid">{neverDo.map((x) => <span>{x}</span>)}</div>
    </div>
  </section>

  <!-- THE WEEKEND (resume copy sits here, below the ideal state) -->
  <section class="wx-sec">
    <h2 class="wx-sec-h">The weekend, <em>hour by hour.</em></h2>
    <p class="wx-sub">Sixteen hours in six phases. Each builds a working piece, and each piece feeds the next: the website holds the blog, the blog fills the list, the list buys the product.</p>
    <div class="wx-phases">
      {phases.map((p) => (
        <div class="wx-card wx-phase" style={`--ac:${p.accent}`}>
          <div class="wx-phase-top">
            <span class="wx-phase-when">{p.day}</span>
            <span class="wx-phase-hrs">{p.hrs} hrs</span>
          </div>
          <h3>{p.title}</h3>
          {p.sub && <p class="wx-phase-sub">{p.sub.charAt(0).toUpperCase() + p.sub.slice(1)}</p>}
          <ol>
            {p.mods.map((m) => (
              <li><b>{String(m.num).padStart(2, "0")}</b>{m.title}</li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <!-- OBJECTIONS -->
  <section class="wx-sec" id="questions">
    <span class="wx-kicker" style="text-align:center">Before you decide</span>
    <h2 class="wx-sec-h">The six things <em>that stop people.</em></h2>
    <p class="wx-sub">Straight answers. No guarantee, because there isn't one, and no refunds, because there aren't any.</p>
    <div class="wx-obj">
      {OBJECTIONS.map((o) => (
        <>
          <div class={`wx-card wx-obj-card${o.id === "no-refunds" ? " wx-obj-refund" : ""}`} id={o.id}>
            <span class="wx-obj-n">{String(o.n).padStart(2, "0")}</span>
            <p class="wx-obj-q">{o.q}</p>
            {o.a.map((para) => <p>{para}</p>)}
            {o.id === "no-refunds" && (
              <p><a class="wx-link" href="/weekend-ecosystem/preview">Look inside first →</a></p>
            )}
            {o.kit && showKit && (
              <p data-kit-deadline={KIT_DEADLINE}><strong>One real deadline:</strong> buy by Sunday, October 4, 11:59 pm Eastern, on one payment or three, and The Keep It Running Kit comes with it. That's six of my paid guides. After that it's gone.</p>
            )}
          </div>
          {o.id === "cant-build" && <Testimonial variant="full" eyebrow="What a member built with it" />}
        </>
      ))}
    </div>

    <div class="wx-card wx-mid">
      <p class="wx-mid-l">If those were the only things in the way, here's the door.</p>
      <WePrice preview />
    </div>
  </section>

  <!-- FIT -->
  <section class="wx-sec">
    <h2 class="wx-sec-h">Is it <em>for you?</em></h2>
    <div class="wx-fit">
      <div class="wx-card">
        <h3>This is for you if</h3>
        <ul>{forYou.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="wx-card wx-fit-no">
        <h3>It isn't if</h3>
        <ul>{notForYou.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="wx-sec">
    <h2 class="wx-sec-h">Everything <em>else.</em></h2>
    <div class="wx-faq">
      {faqs.map((x) => (
        <details>
          <summary>{x.q}</summary>
          <p>{x.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CLOSE -->
  <section class="wx-card wx-close">
    <div class="wx-close-img">
      <img src="/images/we/cover-kitchen.jpg" alt="A woman working on a laptop in a pink attic loft, wildflowers on the desk and a barn through the window." loading="lazy" width="1200" height="1490" />
    </div>
    <div class="wx-close-body">
      <span class="wx-kicker">One weekend from here</span>
      <h2>You were a digital product seller. <em>Now you own the infrastructure.</em></h2>
      <p class="wx-close-l">A website, a blog and a list that keep working on the days you don't. You pay once and own the thing. It costs about a dollar a month to run, plus your domain.</p>
      <SaleBanner variant="inline" />
      <WePrice note="No refunds. Both options are at checkout. Every future update included, free." preview />
      <p class="wx-access">{S.access}</p>
      <div class="wx-final-line"><Testimonial variant="line" /></div>
    </div>
  </section>

  <div class="wx-sticky" id="wx-sticky">
    <div class="wx-sticky-in">
      <p class="wx-sticky-p"><b>$97</b>or 3 × $33.33</p>
      <a class="wx-btn" href={HREF}>{S.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>

</div>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Product",
        "name": "The Weekend Ecosystem™",
        "description": "A 22-module course that turns content you have already made into a website and blog on a domain you own, over one weekend, with Claude AI doing the building.",
        "brand": { "@type": "Brand", "name": "The Digital Income Edit™" },
        "url": "https://www.thedigitalincomeedit.com/shop/weekend-ecosystem",
        "image": "https://www.thedigitalincomeedit.com/images/we/cover-sofa.jpg",
        "offers": {
          "@type": "Offer",
          "price": "97.00",
          "priceCurrency": "USD",
          "availability": "https://schema.org/InStock",
          "url": "https://www.thedigitalincomeedit.com/shop/weekend-ecosystem"
        }
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          ...OBJECTIONS.map((o) => ({ "@type": "Question", "name": o.q, "acceptedAnswer": { "@type": "Answer", "text": o.a.join(" ") } })),
          ...faqs.map((f) => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
        ]
      }
    ]
  })} />
</PageLayout>

<script>
  // Mobile buy bar: shows once the first price block has scrolled away,
  // hides again whenever any price block is on screen.
  const bar = document.getElementById("wx-sticky");
  const blocks = [...document.querySelectorAll(".wp")];
  if (bar && blocks.length) {
    const seen = new Set();
    const first = blocks[0];
    const update = () => {
      const past = first.getBoundingClientRect().bottom < 0;
      bar.classList.toggle("on", past && seen.size === 0);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      update();
    });
    blocks.forEach((b) => io.observe(b));
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
