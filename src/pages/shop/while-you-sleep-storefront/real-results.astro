---
// Jodie's Real Results for The While-You-Sleep Storefront™, rebuilt 20 Nov 2026 on
// Jodie's Etsy template. Shows two current looks the system built (wys-live.js liveLooks).
import {Image} from 'astro:assets';
import TemplateLayout from '../../../layouts/TemplateLayout.astro';
import WysClock from '../../../components/WysClock.astro';
import {liveLooks, roles, WYS_CTA} from '../../../data/wys-live.js';
const [mantel, walk] = liveLooks;
const facts = [
 ['A website, not a PDF', 'A website that gets regular updates and never goes stale, with new affiliate brand automations on the way.'],
 ['15 minutes to start', 'The Quick Start takes about 15 minutes. Customizing it takes about an hour.'],
 ['Built on Claude', 'Runs on your own Claude account. ChatGPT version on the way.'],
 ['Fully automatic', 'Every pin and carousel schedules itself. I recommend checking your Metricool calendar once a day.'],
 ['Themed Idea Lists', 'Each pin links to the themed Amazon Idea List its products came from. Many looks live in each list.'],
 ['Your computer stays on', 'Your computer needs to be on and signed into Amazon while it works overnight.'],
];
---
<TemplateLayout title="Jodie’s Real Results: The While-You-Sleep Storefront™ Running for Real" description="Real results, not mockups. Every piece of two real looks The While-You-Sleep Storefront™ built on my own storefront: 3 photos, the Pinterest pins, a blog post and an Instagram carousel for each." ogImage={walk.photos.styled.src.src} stickyHref={WYS_CTA.href} stickyLabel="See the storefront">
<WysClock/>
<section class="hh">
 <div class="wrap hh-grid rr2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Real<b class="big">results</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Free look inside the system · running for real</p>
   <h1>The While-You-Sleep Storefront™ <span class="scr">One real night's work.</span></h1>
   <p class="what">Not mockups. <b>Two real looks it built on its own for my storefront, and every piece of each: 3 photos, the Pinterest pins, a blog post and an Instagram carousel.</b></p>
   <a class="btn buy" href={WYS_CTA.href} data-wys-cta><span data-wys-cta-label>{WYS_CTA.label}</span> <span class="ar">→</span></a>
   <p class="see"><a href="/lifestyle">See it live on the Lifestyle blog</a></p>
  </div>
  <div class="rr2-six">{[mantel, walk].flatMap((look) => roles.map((r) => <figure><div class="rr2-ph"><Image src={look.photos[r.key].src} alt={look.photos[r.key].alt} widths={[200, 360]} sizes="(max-width:900px) 30vw, 170px" loading="eager"/></div><figcaption>{r.name}</figcaption></figure>))}</div>
 </div>
</section>

{liveLooks.map((look, i) => <>
 <div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Look {i + 1} of 2</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
 <section class={`sec ${i ? '' : 'wash'}`} id={look.slug}>
  <div class="wrap">
   <p class="kick">{look.category}</p>
   <h2 class="h2">{look.name.replace(/^The /, 'The ')} <span class="scr">start to finish.</span></h2>
   <div class="lead"><p>The blog post is live on The Digital Income Edit™. The pins and carousel are built from the same three photos and shown here as examples.</p></div>
   <p class="rr2-step"><span class="glit">1</span> Three photos, always in this order</p>
   <div class="rr2-three">{roles.map((r) => <figure class="card dash"><div class="rr2-ph"><Image src={look.photos[r.key].src} alt={look.photos[r.key].alt} widths={[280, 440]} sizes="(max-width:700px) 80vw, 280px"/></div><figcaption><b>{r.name}</b><span>{r.note}</span></figcaption></figure>)}</div>
   <p class="rr2-becomes">becomes</p>
   <div class="rr2-outs">
    <div class="card dash rr2-out">
     <p class="rr2-step"><span class="glit">2</span> 5 Pinterest pins</p>
     <span class="rr2-ex">Example</span>
     <div class="rr2-pins">{roles.map((r) => <div class="rr2-pin"><Image src={look.photos[r.key].src} alt="" widths={[160, 260]} sizes="110px"/><span>{look.short} · {r.name}</span></div>)}</div>
     <p class="rr2-note">Each pin links to the themed Amazon Idea List its products came from. The Roundup shows every piece together under one headline, and the Found It pin shows the look’s most interesting piece.</p>
    </div>
    <div class="card dash rr2-out">
     <p class="rr2-step"><span class="glit">3</span> 1 blog post</p>
     <span class="rr2-ex">Live page</span>
     <a class="rr2-blog" href={look.url} target="_blank" rel="noopener"><Image src={look.blogDesk} alt={`Screenshot of the live blog post ${look.name}`} widths={[420, 760]} sizes="(max-width:800px) 80vw, 340px"/></a>
     <p class="rr2-note">{look.blogLine}</p>
     <a class="btn" href={look.url} target="_blank" rel="noopener">Open the live post <span class="ar">↗</span></a>
    </div>
    <div class="card dash rr2-out">
     <p class="rr2-step"><span class="glit">4</span> 1 Instagram carousel</p>
     <span class="rr2-ex">Example</span>
     <div class="rr2-ig">{roles.map((r) => <Image src={look.photos[r.key].src} alt="" widths={[160, 260]} sizes="100px"/>)}</div>
     <p class="rr2-note">Swipe order: Basic, Styled, Lifestyle.</p>
    </div>
   </div>
  </div>
 </section>
</>)}

<section class="sec wash">
 <div class="wrap">
  <p class="kick">What you’re getting</p>
  <h2 class="h2">Fifteen minutes tonight. <span class="scr">Hands off after that.</span></h2>
  <div class="rr2-facts">{facts.map(([t, p], k) => <div class="card dash"><span class="hm-lab">{String(k + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{p}</p></div>)}</div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <div class="p42 dash ww2-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">One<b class="big">payment</b></span>
   <div class="ph"><Image src={walk.photos.lifestyle.src} alt={walk.photos.lifestyle.alt} widths={[320, 560]} sizes="(max-width:800px) 80vw, 360px"/></div>
   <div class="tx">
    <p class="kick">The While-You-Sleep Storefront™</p>
    <h2>Go to bed.</h2>
    <span class="scr">Wake up posted.</span>
    <p class="rr2-price"><b class="glit">$37</b> one payment</p>
    <a class="btn buy" href={WYS_CTA.href} data-wys-cta><span data-wys-cta-label>{WYS_CTA.label}</span> <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>
</TemplateLayout>
