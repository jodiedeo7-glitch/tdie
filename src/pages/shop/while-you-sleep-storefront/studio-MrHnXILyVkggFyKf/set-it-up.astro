---
import WysBuyerFrame from '../../../../components/WysBuyerFrame.astro';
import {WYS_BUYER_ROOT} from '../../../../data/wys-buyer.js';
import {SECTIONS, ASKS} from '../../../../scripts/wys-buyer-prompts.js';
---
<WysBuyerFrame title="Set It Up" current="setup">
 <header class="wb2-hero">
  <div class="wys-wrap">
   <p class="wb2-kicker">Step 1 of 3 · Set it up</p>
   <h1>Your answers write your prompts</h1>
   <p>Fill in Quick Start and you can paste tonight. Open the other sections to make it fully yours. Your prompts update as you type, and this page remembers your answers on this device.</p>
  </div>
 </header>

 <section class="wb2-sec" style="padding-top:8px">
  <div class="wys-wrap">
   <div class="wb2-card wb2-intro" style="margin-bottom:18px">
    <h3>Before you start</h3>
    <ul>
     <li><b>Quick Start is the only must.</b> Your Amazon details, whether your storefront has a face, and where your posts go. About 15 minutes.</li>
     <li><b>Everything else is tap to pick.</b> It's already ticked the way I run my own storefront. Untick what isn't you, tick what is, and type anything I missed in the "Anything else?" box.</li>
     <li><b>Your prompt writes itself as you go.</b> Nothing is sent anywhere, and this page remembers your answers on this device, so you can stop and come back.</li>
    </ul>
   </div>
   <div class="wb2-card" style="margin-bottom:22px" data-platform="chatgpt" hidden>
    <h3>Before you paste (ChatGPT, being tested)</h3>
    <ol class="wb2-steps">
     <li><b>Open ChatGPT</b> on the computer you use. This version is still being tested, so expect to stay with it for the first look.</li>
     <li><b>Connect your tools.</b> Click your name, then <b>Settings</b>, then <b>Apps</b>, and connect <b>Google Drive</b>, <b>Metricool</b> (for automatic pins and carousels), <b>GitHub</b> (for automatic blog posts) and <b>Higgsfield</b> (only if you chose it for photos). Or let it walk you through. <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="connectAll" target="_blank" rel="noopener">Do it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Sign in to Amazon</b> in the browser tool ChatGPT uses: open amazon.com and sign in yourself. <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="okAmazon" target="_blank" rel="noopener">Check it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Connect Pinterest inside Metricool.</b> Log in to Metricool, open your brand's Connections, and add your Pinterest business account (and Instagram, if it's on). <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="okMetricool" target="_blank" rel="noopener">Check it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Fill in everything below.</b> The "Check your connections" section tells you exactly how to connect each tool and has a button to test it.</li>
     <li><b>Copy Your setup prompt</b>, start a new chat in ChatGPT, paste it and send it.</li>
    </ol>
   </div>
   <div class="wb2-card" style="margin-bottom:22px" data-platform="claude">
    <h3>Before you paste: do these in order</h3>
    <ol class="wb2-steps">
     <li><b>Get the Claude desktop app</b> from <a href="https://claude.com/download" target="_blank" rel="noopener">claude.com/download</a>, and open it on the computer that will stay on overnight.</li>
     <li><b>Connect your tools.</b> In Claude click <b>Settings</b>, then <b>Connectors</b>, and connect <b>Google Drive</b>, <b>Metricool</b> (for automatic pins and carousels), <b>GitHub</b> (for automatic blog posts) and <b>Higgsfield</b> (for automatic photos). Or let Claude walk you through it. <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="connectAll" target="_blank" rel="noopener">Do it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Sign in to Amazon.</b> Open the browser inside the Claude desktop app, go to amazon.com and sign in yourself. Stay signed in. <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="okAmazon" target="_blank" rel="noopener">Check it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Connect Pinterest inside Metricool.</b> Log in to Metricool, open your brand's Connections, and add your Pinterest business account (and Instagram, if it's on). <span class="wb2-btnrow"><a class="wb2-btn wb2-do" data-ask="okMetricool" target="_blank" rel="noopener">Check it for me <span class="arr" aria-hidden="true">→</span></a></span></li>
     <li><b>Fill in everything below.</b> The "Check your connections" section tells you exactly how to connect each tool and has a button to test it.</li>
     <li><b>Copy Your setup prompt</b>, start a new chat in Claude, paste it and send it. Stay with it for the first look.</li>
    </ol>
   </div>

   <div class="wb2-build">
    <form class="wb2-form" id="wb2-form" autocomplete="off" onsubmit="return false">
     {SECTIONS.map((s) => (
      <details open={s.open}>
       <summary>{s.title}</summary>
       <p class="wb2-sec-note">{s.note}</p>
       {s.fields.map((f) => (
        <div class="wb2-field" data-show={f.show} data-private={f.private ? '1' : undefined}>
         {f.type === 'note' ? (
          <div class="wb2-upsell">
           <p class="wb2-upsell-t">{f.title}</p>
           <p>{f.text}</p>
           {f.link && <a href={f.link} target="_blank" rel="noopener">{f.linkText} <span aria-hidden="true">→</span></a>}
          </div>
         ) : f.type === 'pick' ? (
          <fieldset>
           <legend>{f.label}</legend>
           <p class="wb2-pick-hint">Tick all that fit.</p>
           <div class="wb2-chips">{f.options.map((lab) => <label class="wb2-chip"><input type="checkbox" name={f.id} value={lab} checked={f.def.includes(lab)}/><span>{lab}</span></label>)}</div>
           <label class="wb2-more"><b>Anything else? <span>(optional, separate with commas)</span></b><input type="text" name={f.id + '__more'} placeholder="Type your own"/></label>
          </fieldset>
         ) : f.type === 'radio' || f.type === 'checks' ? (
          <fieldset>
           <legend>{f.label}</legend>
           {f.type === 'radio'
            ? f.options.map(([val, lab]) => <label class="wb2-opt"><input type="radio" name={f.id} value={val} checked={f.def === val}/>{lab}</label>)
            : f.options.map((lab) => <label class="wb2-opt"><input type="checkbox" name={f.id} value={lab} checked={f.def.includes(lab)}/>{lab}</label>)}
          </fieldset>
         ) : (
          <>
           <label for={'f-' + f.id}>{f.label}</label>
           {f.type === 'select' ? (
            <select id={'f-' + f.id} name={f.id}>{f.options.map(([val, lab]) => <option value={val} selected={f.def === val}>{lab}</option>)}</select>
           ) : f.type === 'textarea' ? (
            <textarea id={'f-' + f.id} name={f.id}>{f.def}</textarea>
           ) : (
            <input type="text" id={'f-' + f.id} name={f.id} value={f.def ?? ''} placeholder={f.ph ?? ''}/>
           )}
          </>
         )}
         {f.help && <p class="wb2-help">{f.help}</p>}
         {f.how && (
          <div class="wb2-how">
           <p class="wb2-how-t">How to connect it</p>
           <ol data-platform="claude">{f.how.claude.map((x) => <li set:html={x}/>)}</ol>
           <ol data-platform="chatgpt" hidden>{f.how.chatgpt.map((x) => <li set:html={x}/>)}</ol>
          </div>
         )}
         {ASKS[f.id] && (
          <div class="wb2-btnrow">
           <a class="wb2-btn wb2-do" data-ask={f.id} target="_blank" rel="noopener">{f.id.startsWith('ok') ? 'Check it for me' : 'Do it for me'} <span class="arr" aria-hidden="true">→</span></a>
           <button type="button" class="wb2-copyask" data-ask={f.id}>Copy the request</button>
          </div>
         )}
        </div>
       ))}
      </details>
     ))}
     <p class="wb2-small">Changed your mind later? Change your answers here, copy the new nightly run, and tell Claude: "Replace my While-You-Sleep nightly run task's prompt with this." Small fixes don't need this page: just tell Claude what to change and it writes it into your log.</p>
    </form>

    <div class="wb2-out">
     <div class="wb2-missing" id="wb2-missing" role="status"></div>
     <div class="wb2-box">
      <div class="wb2-box-head"><h3>Your setup prompt</h3><button type="button" class="wb2-btn wb2-copy" data-copy="setup">Copy <span class="arr" aria-hidden="true">→</span></button></div>
      <pre id="out-setup"></pre>
     </div>
     <div class="wb2-box">
      <div class="wb2-box-head"><h3>Your nightly run</h3><button type="button" class="wb2-btn wb2-copy" data-copy="nightly">Copy <span class="arr" aria-hidden="true">→</span></button></div>
      <pre id="out-nightly"></pre>
     </div>
     <p class="wb2-small">The setup prompt already contains your nightly run, so you only paste the setup prompt. The nightly run is here for when you change your answers later.</p>
     <p><a class="wb2-btn" href={WYS_BUYER_ROOT + '/help'}>Stuck? If Something Breaks <span class="arr" aria-hidden="true">→</span></a></p>
    </div>
   </div>
  </div>
 </section>
</WysBuyerFrame>

<style>
 .wb2-how{margin:10px 0 4px;padding:12px 14px;border-radius:12px;background:#FFF5FA;border:1px solid #F1CFE0}
 .wb2-how-t{margin:0 0 6px;font:700 13px/1.3 Jost,sans-serif;color:#B8245F;text-transform:uppercase;letter-spacing:.04em}
 .wb2-how ol{margin:0;padding-left:20px;font-size:14.5px;line-height:1.5}.wb2-how li{margin:3px 0}
 .wb2-how ol[hidden]{display:none}
 .wb2-btnrow{display:inline-flex;flex-wrap:wrap;gap:10px;align-items:center;margin:8px 0 2px}
 .wb2-do{min-height:44px;padding:0 18px;font-size:14px}
 .wb2-copyask{background:none;border:0;padding:6px 4px;font:600 13px/1.2 Jost,sans-serif;color:#7a5a6c;text-decoration:underline;cursor:pointer;min-height:44px}
 .wb2-steps li .wb2-btnrow{display:flex;margin-top:8px}
 .wb2-steps li a.wb2-btn,.wb2-steps li a.wb2-btn:hover{text-decoration:none;color:var(--wys-ink)}
 .wb2-copy[disabled]{opacity:.45;cursor:not-allowed}
 .wb2-pick-hint{margin:-2px 0 8px;font-size:13px;color:#7a5a6c}
 .wb2-chips{display:flex;flex-wrap:wrap;gap:8px}
 .wb2-chip{position:relative;display:inline-flex;cursor:pointer}
 .wb2-chip input{position:absolute;opacity:0;width:1px;height:1px}
 .wb2-chip span{display:inline-flex;align-items:center;min-height:36px;padding:6px 14px;border:1px solid #D9B9CB;border-radius:999px;background:#fff;font:400 14px/1.3 Jost,sans-serif;color:var(--wys-ink)}
 .wb2-chip input:checked+span{border-color:#B8245F;background:#FFE8F2;color:#8A1D4A;font-weight:600;box-shadow:inset 0 0 0 1px #B8245F}
 .wb2-chip input:checked+span::before{content:"✓";margin-right:6px;color:#B8245F}
 .wb2-chip input:focus-visible+span{outline:3px solid #C4AFE4;outline-offset:2px}
 .wb2-more{display:grid;gap:6px;margin-top:12px;font:600 14px/1.4 Jost,sans-serif}
 .wb2-more b{font-weight:600}.wb2-more span{font-weight:400;color:#7a5a6c}
 .wb2-upsell{margin-top:4px;padding:12px 14px;border-radius:12px;background:#F6F1FF;border:1px solid #E2D6FB}
 .wb2-upsell p{margin:0 0 6px;font-size:15px;line-height:1.5}
 .wb2-upsell .wb2-upsell-t{font-weight:600;color:#B8245F}
 .wb2-upsell a{font-weight:600;font-size:15px;color:#B8245F}
</style>

<script>
 import {SECTIONS, ASKS, defaults, setup, nightly, missing, shown, pickValue} from '../../../../scripts/wys-buyer-prompts.js';
 const KEY = 'wys-buyer-answers-v1';
 const form = document.getElementById('wb2-form');
 const outs = {setup: document.getElementById('out-setup'), nightly: document.getElementById('out-nightly')};
 const miss = document.getElementById('wb2-missing');
 const fields = SECTIONS.flatMap((s) => s.fields).filter((f) => f.type !== 'note');
 let texts = {setup: '', nightly: ''};
 // The ChatGPT version is private while it is tested: it only appears with ?chatgpt=1 on the link.
 const unlocked = new URLSearchParams(location.search).has('chatgpt');

 function load() {
  let saved = null;
  try {saved = JSON.parse(localStorage.getItem(KEY) || 'null');} catch (e) {}
  if (!saved) return;
  for (const f of fields) {
   if (f.type === 'pick') {
    if (Array.isArray(saved[f.id + '__picked'])) {
     form.querySelectorAll(`[name="${f.id}"]`).forEach((el) => {el.checked = saved[f.id + '__picked'].includes(el.value);});
     form.elements[f.id + '__more'].value = saved[f.id + '__more'] || '';
    } else if (typeof saved[f.id] === 'string') {
     // Answers saved before the tick boxes: tick what matches, keep the rest as typed.
     const parts = saved[f.id].split(f.sep ? /\n|,/ : /,/).map((x) => x.trim()).filter(Boolean);
     const opts = new Set(f.options);
     form.querySelectorAll(`[name="${f.id}"]`).forEach((el) => {el.checked = parts.includes(el.value);});
     form.elements[f.id + '__more'].value = parts.filter((x) => !opts.has(x) && x !== f.none).join(', ');
    }
    continue;
   }
   if (!(f.id in saved)) continue;
   const val = saved[f.id];
   if (f.type === 'radio' || f.type === 'checks') {
    form.querySelectorAll(`[name="${f.id}"]`).forEach((el) => {el.checked = f.type === 'radio' ? el.value === val : (val || []).includes(el.value);});
   } else {const el = form.elements[f.id]; if (el) el.value = val;}
  }
 }
 function read() {
  const a = defaults();
  for (const f of fields) {
   if (f.type === 'pick') {
    const picked = [...form.querySelectorAll(`[name="${f.id}"]:checked`)].map((el) => el.value);
    const more = form.elements[f.id + '__more'].value;
    a[f.id] = pickValue(f, picked, more); a[f.id + '__picked'] = picked; a[f.id + '__more'] = more;
   }
   else if (f.type === 'checks') a[f.id] = [...form.querySelectorAll(`[name="${f.id}"]:checked`)].map((el) => el.value);
   else if (f.type === 'radio') {const el = form.querySelector(`[name="${f.id}"]:checked`); a[f.id] = el ? el.value : f.def;}
   else a[f.id] = form.elements[f.id].value;
  }
  return a;
 }
 function update() {
  const a = read();
  if (!unlocked) a.platform = 'claude';
  // ChatGPT cannot make Idea Lists yet (Amazon refuses its browser), so that choice is locked to by hand.
  if (a.platform === 'chatgpt') a.listMode = 'hand';
  form.querySelectorAll('[name="listMode"]').forEach((el) => {
   const lock = a.platform === 'chatgpt';
   el.disabled = lock && el.value === 'auto';
   if (lock) el.checked = el.value === 'hand';
  });
  form.querySelectorAll('[data-show]').forEach((el) => {el.hidden = !shown(el.dataset.show, a);});
  form.querySelectorAll('[data-private]').forEach((el) => {el.hidden = !unlocked;});
  document.querySelectorAll("[data-platform]").forEach((el) => {el.hidden = el.dataset.platform !== a.platform;});
  // "Do it for me" buttons: open the buyer's own AI with the request already written.
  const gpt = a.platform === 'chatgpt';
  document.querySelectorAll('a[data-ask]').forEach((el) => {
   const text = ASKS[el.dataset.ask](a, a.platform);
   el.href = (gpt ? 'https://chatgpt.com/?q=' : 'https://claude.ai/new?q=') + encodeURIComponent(text);
   const arrow = el.querySelector('.arr');
   el.firstChild.textContent = (el.dataset.ask.startsWith('ok') || el.dataset.ask === 'okAmazon' ? 'Check it for me' : 'Do it for me') + ' in ' + (gpt ? 'ChatGPT' : 'Claude') + ' ';
  });
  try {localStorage.setItem(KEY, JSON.stringify(a));} catch (e) {}
  texts = {setup: setup(a), nightly: nightly(a)};
  outs.setup.textContent = texts.setup;
  outs.nightly.textContent = texts.nightly;
  const m = missing(a);
  miss.hidden = !m.length;
  miss.textContent = m.length ? `Your prompts are locked. Still needed: ${m.join('; ')}.` : '';
  document.querySelectorAll('.wb2-copy').forEach((b) => {b.disabled = m.length > 0; b.title = m.length ? 'Finish the list above first' : '';});
 }
 document.querySelectorAll('.wb2-copy').forEach((b) => b.addEventListener('click', async () => {
  if (b.disabled) return;
  const t = texts[b.dataset.copy];
  try {await navigator.clipboard.writeText(t);} catch (e) {
   const r = document.createRange(); r.selectNodeContents(outs[b.dataset.copy]); const s = getSelection(); s.removeAllRanges(); s.addRange(r); document.execCommand('copy');
  }
  const old = b.innerHTML; b.textContent = 'Copied'; setTimeout(() => {b.innerHTML = old;}, 1600);
 }));
 document.addEventListener('click', async (e) => {
  const b = e.target.closest && e.target.closest('button.wb2-copyask');
  if (!b) return;
  const a = read(); if (!unlocked) a.platform = 'claude';
  const t = ASKS[b.dataset.ask](a, a.platform);
  try {await navigator.clipboard.writeText(t);} catch (err) {
   const ta = document.createElement('textarea'); ta.value = t; document.body.appendChild(ta); ta.select(); document.execCommand('copy'); ta.remove();
  }
  const old = b.textContent; b.textContent = 'Copied. Paste it into your AI.'; setTimeout(() => {b.textContent = old;}, 1800);
 });
 form.addEventListener('input', update);
 form.addEventListener('change', update);
 load();
 update();
</script>
