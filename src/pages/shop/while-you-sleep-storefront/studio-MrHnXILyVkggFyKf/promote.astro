---
import {Image, getImage} from 'astro:assets';
import WysBuyerFrame from '../../../../components/WysBuyerFrame.astro';
import WysClock from '../../../../components/WysClock.astro';
import WysWhen from '../../../../components/WysWhen.astro';
import {liveLooks, roles} from '../../../../data/wys-live.js';

const L = '[YOUR AFFILIATE LINK]';
const posts = [
 {where: 'Facebook group or Skool post', note: 'Facebook: put the link in the first comment, never in the post. Skool: hide the link behind the words.', text:
`I stopped making my Amazon content by hand. 😮‍💨

Every night while I sleep, my storefront plans 2 looks, finds the products, makes the photos, schedules the Pinterest pins, writes the blog posts and lines up my Instagram carousels.

I set it up once. That's it.

It's called The While-You-Sleep Storefront™ and it runs on your own Claude account. Quick Start is about 15 minutes.

Launch weekend it's $27 (then $37).

Link's in the comments 👇

(Affiliate link: I earn a commission if you buy through it, at no extra cost to you.)`},
 {where: 'Facebook first comment', note: 'Post this 5 minutes after the post above goes live.', text:
`Here it is 👉 ${L}
(affiliate link)`},
 {where: 'Instagram caption', note: 'No links on Instagram. Put your link in your bio first.', text:
`POV: your Amazon storefront posts itself while you sleep 😴🩷

Planned. Pinned. Posted. Blogged. You slept.

Every night it plans the looks, finds the products, makes the photos and schedules everything. I set it up once.

It's called The While-You-Sleep Storefront™. Launch weekend only, it's $27.

Link in bio 🔗 (affiliate)

#amazoninfluencer #amazonfinds #pinterestmarketing #affiliatemarketing #amazonstorefront`},
 {where: 'Threads', note: 'Put the link in a reply to your own post, not in the post itself.', text:
`the most annoying part of being an Amazon influencer was making the content

so now it makes itself. every night. 2 looks, 6 pins, 2 blog posts, 2 carousels while I'm asleep

set it up once. that's the whole job

link below if you want it (affiliate) 👇`},
 {where: 'Story text (3 frames)', note: 'Use the link sticker on the last frame.', text:
`Frame 1: My Amazon storefront posts itself now 😴
Frame 2: Every night: 2 looks, 6 pins, 2 blog posts, 2 Instagram carousels. I set it up once.
Frame 3: The While-You-Sleep Storefront™. $27 launch weekend only 👇 (affiliate link sticker)`},
 {where: 'Email to your list', note: 'Subject line first, then the email.', text:
`Subject: my Amazon storefront posts itself now

Quick one.

I've been setting up my Amazon content the hard way for way too long. Now it happens every night while I sleep: it plans 2 looks, finds the products, makes the photos, schedules the Pinterest pins, writes the blog posts and lines up my Instagram carousels.

It's called The While-You-Sleep Storefront™. It runs on your own Claude account and the Quick Start takes about 15 minutes.

It's $27 for launch weekend, then $37.

Get it here: ${L}

(That's my affiliate link. I earn a commission if you buy through it, at no extra cost to you.)`}
];

// After launch weekend (WYS_REGULAR_AT) the same copy shows the regular price.
const REG = [
 ['Launch weekend it\'s $27 (then $37).', 'It\'s $37, one payment.'],
 ['It\'s called The While-You-Sleep Storefront™. Launch weekend only, it\'s $27.', 'It\'s called The While-You-Sleep Storefront™. One payment of $37.'],
 ['Frame 3: The While-You-Sleep Storefront™. $27 launch weekend only 👇 (affiliate link sticker)', 'Frame 3: The While-You-Sleep Storefront™. One payment of $37 👇 (affiliate link sticker)'],
 ['It\'s $27 for launch weekend, then $37.', 'It\'s $37, one payment.']
];
const regular = (t) => REG.reduce((acc, [a, b]) => acc.split(a).join(b), t);
const postsReg = posts.map((q) => ({...q, text: regular(q.text)}));

const photos = await Promise.all(liveLooks.flatMap((look) => roles.map(async (r) => {
 const full = await getImage({src: look.photos[r.key].src, format: 'jpg', width: 1080});
 return {look, role: r, full: full.src};
})));
---
<WysBuyerFrame title="Promote It" current="promote">
 <WysClock/>
 <header class="wb2-hero">
  <div class="wys-wrap">
   <p class="wb2-kicker">Promote it</p>
   <h1>Love it? Share it and earn</h1>
   <p>You can promote The While-You-Sleep Storefront™ as an affiliate. <WysWhen wait="Your link opens at the full launch." launch="The affiliate program is open now."/> Everything you need to share it is on this page.</p>
  </div>
 </header>

 <section class="wb2-sec" style="padding-top:8px">
  <div class="wys-wrap">
   <div class="wb2-grid">
    <div class="wb2-card"><span class="wb2-n">1</span><h3>When</h3><p><WysWhen wait="The affiliate program opens at the full launch on Friday 16 October 2026. Nothing to sign up for before then." launch="The affiliate program is open now. Get your link from Beacons (below)."/></p></div>
    <div class="wb2-card"><span class="wb2-n">2</span><h3>What you earn</h3><p>40% of each sale through your link, paid through Beacons.</p></div>
    <div class="wb2-card"><span class="wb2-n">3</span><h3>The prices</h3><p><WysWhen wait="Launch weekend it&#39;s $27 (regular $37). After launch weekend it&#39;s $37 for everyone." regular="$37 for everyone, one payment."/></p></div>
   </div>
   <div class="wb2-grid two">
    <div class="wb2-card must"><h3><WysWhen wait="Get your link on Friday" launch="Get your link"/></h3><p>Your affiliate link comes from Beacons: add The While-You-Sleep Storefront™ as an affiliate product in your own Beacons. Paste the link wherever these posts say {L}.</p></div>
    <div class="wb2-card"><h3>The rules</h3><ul><li>Never promise anyone money or results. Show what it makes for you.</li><li>Always say it's an affiliate link.</li><li>Facebook: link in the first comment. Instagram: link in bio. Threads: link in a reply.</li><li>Never mention the commission rate on Facebook or Instagram.</li></ul></div>
   </div>
  </div>
 </section>

 <section class="wb2-sec" style="background:#fff">
  <div class="wys-wrap">
   <h2>Ready-to-post copy</h2>
   <p class="wb2-lede">Copy, swap in your link, post. Change the wording to sound like you if you like.</p>
   <div class="wb2-grid two">
    {[['wait presale launch', posts, 'p'], ['regular', postsReg, 'r']].map(([when, list, pre]) => list.map((p, i) => (
     <div class="wb2-box" style="margin:0" data-wys-when={when}>
      <div class="wb2-box-head"><h3>{p.where}</h3><button type="button" class="wb2-btn wb2-copy" data-copy={pre + i}>Copy <span class="arr" aria-hidden="true">→</span></button></div>
      <p class="wb2-small" style="margin:10px 14px 0">{p.note}</p>
      <pre id={pre + i}>{p.text}</pre>
     </div>
    )))}
   </div>
  </div>
 </section>

 <section class="wb2-sec" style="background:#fff">
  <div class="wys-wrap">
   <h2>Promo images to post</h2>
   <p class="wb2-lede">Ready-made images for your posts. They are safe for Facebook and Instagram. Tap an image to open the full-size file, then save it and post it with the copy above.</p>
   <div class="wb2-promos">
    {[1,2,3,4,5,6,7].map((n) => (
     <figure data-wys-when={n === 6 ? 'wait presale launch' : n === 7 ? 'regular' : undefined}>
      <a href={`/images/wys-promo/wys-affiliate-promo-${n}.jpg`} target="_blank" rel="noopener" download><img src={`/images/wys-promo/wys-affiliate-promo-${n}.jpg`} alt={`Promo image ${n}: The While-You-Sleep Storefront`} width="1080" height="1350" loading="lazy"/></a>
      <figcaption>Image {n}{n === 6 ? ' · launch weekend $27' : n === 7 ? ' · $37 price' : ''}</figcaption>
     </figure>
    ))}
   </div>
  </div>
 </section>

 <section class="wb2-sec">
  <div class="wys-wrap">
   <h2>Photos you can use</h2>
   <p class="wb2-lede">Real looks the system made for my storefront: Basic, Styled and Lifestyle. Use them in your posts as examples of what it makes. Tap a photo to open the full-size file to save.</p>
   <div class="wb2-photos">
    {photos.map((ph) => (
     <figure>
      <a href={ph.full} target="_blank" rel="noopener" download><Image src={ph.look.photos[ph.role.key].src} alt={ph.look.photos[ph.role.key].alt} widths={[200, 320]} sizes="(max-width:900px) 30vw, 180px"/></a>
      <figcaption><b>{ph.look.short}</b> · {ph.role.name}</figcaption>
     </figure>
    ))}
   </div>
  </div>
 </section>
</WysBuyerFrame>

<script>
 document.querySelectorAll('.wb2-copy').forEach((b) => b.addEventListener('click', async () => {
  const el = document.getElementById(b.dataset.copy);
  try {await navigator.clipboard.writeText(el.textContent);} catch (e) {
   const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s.removeAllRanges(); s.addRange(r); document.execCommand('copy');
  }
  const old = b.innerHTML; b.textContent = 'Copied'; setTimeout(() => {b.innerHTML = old;}, 1600);
 }));
</script>
