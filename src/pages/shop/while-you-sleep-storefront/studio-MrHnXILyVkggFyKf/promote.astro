---
import WysBuyerFrame from '../../../../components/WysBuyerFrame.astro';
---
<WysBuyerFrame title="Promote It" current="promote">
 <header class="wb2-hero">
  <div class="wys-wrap">
   <p class="wb2-kicker">Promote it</p>
   <h1>Love it? Share it and earn</h1>
   <p>You can promote The While-You-Sleep Storefront™ as an affiliate. Your link opens at the full launch.</p>
  </div>
 </header>
 <section class="wb2-sec" style="padding-top:8px">
  <div class="wys-wrap">
   <div class="wb2-grid">
    <div class="wb2-card"><span class="wb2-n">1</span><h3>When</h3><p>The affiliate program opens at the full launch on Friday 16 October 2026. Nothing to sign up for before then.</p></div>
    <div class="wb2-card"><span class="wb2-n">2</span><h3>What you earn</h3><p>40% of each sale through your link, paid through Beacons.</p></div>
    <div class="wb2-card"><span class="wb2-n">3</span><h3>The prices</h3><p>Launch weekend it's $27 (regular $37). After launch weekend it's $37 for everyone.</p></div>
   </div>
   <div class="wb2-grid two">
    <div class="wb2-card must"><h3>Your promo kit</h3><p>Ready-made posts and graphics land right here before launch weekend, so you can share on day one.</p></div>
    <div class="wb2-card"><h3>The one rule</h3><p>Never promise anyone money or results. Show what it makes for you, your real looks, pins and posts, and let that do the talking.</p></div>
   </div>
  </div>
 </section>
</WysBuyerFrame>
