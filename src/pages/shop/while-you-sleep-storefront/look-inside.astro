---
import WysDecor from '../../../components/WysDecor.astro';
import WysShelf from '../../../components/WysShelf.astro';
import WysStories from '../../../components/WysStories.astro';
import WysFrame from '../../../components/WysFrame.astro';
import WysHero from '../../../components/WysHero.astro';
import WysPackage from '../../../components/WysPackage.astro';
import WysWorksheet from '../../../components/WysWorksheet.astro';
import WysKit from '../../../components/WysKit.astro';
import WysFaq from '../../../components/WysFaq.astro';
import {Image} from 'astro:assets';
import {packages} from '../../../data/wys-packages.js';
import {WYS_ROOT} from '../../../data/wys.js';
---
<WysFrame current="inside" title="Look Inside | The While-You-Sleep Storefront™" description="Two real looks, start to finish: the photos, Pinterest pins, Instagram post and blog post The While-You-Sleep Storefront™ made from five Amazon finds." ogImage={packages[0].photos[1].src.src}>
 <WysHero><p class="wys-ribbon">Look inside</p><h1>The While-You-Sleep<br/><em>Storefront™</em></h1><p class="wz-header-tagline">Two real looks, start to finish.</p><p class="wys-lede">Each one started as five Amazon finds. This is everything it made from them: three photos, three Pinterest pins, an Instagram post and a blog post.<br/><b>Pretty Wicked</b> is a pink Halloween entryway. <b>Ghoul Fuel</b> is a pink Halloween coffee bar.</p><div class="wys-actions"><a class="wys-button" href="#choose-package">See the two looks ↓</a><a class="wys-button" href={WYS_ROOT+'/waitlist'}>Join the launch list</a></div></WysHero>
 <WysShelf inside/><div class="wx-ticker"><span>PICK THE FINDS</span><span>STYLE THE LOOK</span><span>MAKE THE CONTENT</span><span>SCHEDULE EVERY PIECE</span></div>
 <WysStories inside/>
 <div class="wys-wrap wx-packages">{packages.map((e,i)=><WysPackage example={e} number={i+1}/>)}</div>
 <section class="wx-process-band"><div class="wys-wrap wys-section"><div class="wx-centered"><p class="wys-label">Why this matters</p><h2>Making all of this by hand<br/><em>is the part that burns people out.</em></h2><p>One look means photos, pins, a caption and a blog post. Then you do it again tomorrow, and the day after.</p><p>The While-You-Sleep Storefront™ makes every piece for you from your own Amazon finds, in your own style, and schedules it.</p><p>Your theme changes. Your products change. The work keeps getting done.</p></div></div></section>

 <section class="wys-wrap wys-section"><div class="wx-last-call wz-example-finale"><WysDecor class="wz-finale-flower"/><p class="wys-label">Two looks. The complete content.</p><h2>Start with the finds.<br/><em>See where the idea goes.</em></h2><div class="wz-finale-looks">{packages.map(e=><article class="wz-finale-look"><h3>{e.name}</h3><p>{e.category}</p><div class="wz-finale-photos">{e.photos.map((photo,i)=><figure><Image src={photo.src} alt={photo.alt} widths={[240,400]} sizes="(max-width:700px) 23vw, 130px"/><figcaption>{['The finds','The setting','The moment'][i]}</figcaption></figure>)}</div><p>3 photos · 3 Pinterest pins · 1 Instagram post · 1 blog post</p><a class="wys-button" href={`#${e.slug}`} data-return-example={e.slug}>See every piece of {e.name} ↑</a></article>)}</div><p>Your next look comes from your own finds and your own style. It is in final testing now.</p><div class="wys-actions"><a href={WYS_ROOT+'/waitlist'} class="wys-button">Join the launch list →</a><a href={WYS_ROOT} class="wys-text-link">How it works →</a></div></div></section>
 <script>document.querySelectorAll<HTMLAnchorElement>('[data-return-example]').forEach(a=>a.addEventListener('click',()=>document.getElementById(a.dataset.returnExample!)?.querySelector<HTMLButtonElement>('[data-panel-button="0"]')?.click()));</script>
</WysFrame>
