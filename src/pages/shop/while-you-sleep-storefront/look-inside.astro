---
import {Image} from 'astro:assets';
import WysFrame from '../../../components/WysFrame.astro';
import WysCta from '../../../components/WysCta.astro';
import WysPin from '../../../components/WysPin.astro';
import WysLookFlow from '../../../components/WysLookFlow.astro';
import WysOffer from '../../../components/WysOffer.astro';
import {liveLooks, roles} from '../../../data/wys-live.js';
const [ghost, plaid] = liveLooks;
---
<WysFrame focus current="inside" title="Look Inside The While-You-Sleep Storefront™ | One night’s work" description="See every piece of two looks The While-You-Sleep Storefront™ built: 3 photos, 3 Pinterest pins, a blog post and an Instagram carousel for each." ogImage={plaid.photos.styled.src.src}>
 <header class="wc-hero">
  <div class="wys-wrap">
   <div class="wc-head" style="margin-bottom:0">
    <h1>Look inside<br/><em>one night’s work.</em></h1>
    <p class="wc-hero-line" style="margin-inline:auto;max-width:44ch">Two looks The While-You-Sleep Storefront™ built, every piece of each: 3 photos, 3 Pinterest pins, a blog post and an Instagram carousel.</p>
    <WysCta note="Member presale opens Tuesday 13 October."/>
   </div>
   <div class="wc-six">{[ghost, plaid].flatMap((look) => roles.map((r) => <figure>{r.key === 'basic' ? <WysPin look={look} role="basic" sizes="(max-width:900px) 30vw, 180px" eager/> : <Image src={look.photos[r.key].src} alt={look.photos[r.key].alt} widths={[200, 360]} sizes="(max-width:900px) 30vw, 180px" loading="eager"/>}<figcaption>{r.name}</figcaption></figure>))}</div>
  </div>
 </header>

 {liveLooks.map((look, i) => <section class={`wc-section ${i ? '' : 'wc-flow-band'}`} id={look.slug}>
  <div class="wys-wrap">
   <div class="wc-look-head">
    <p class="wc-kicker">Look {i + 1} of 2 · {look.category}</p>
    <h2>{look.name}</h2>
    <p>The blog post is live on The Digital Income Edit™. The pins and carousel are built from the same three photos and shown here as examples.</p>
    <a class="wc-button wc-button-small" href={look.url} target="_blank" rel="noopener">Open the live blog post <span aria-hidden="true">↗</span></a>
   </div>
   <WysLookFlow look={look}/>
  </div>
 </section>)}

 <section class="wys-wrap wc-section">
  <div class="wc-head">
   <p class="wc-kicker">What you’re getting</p>
   <h2>The setup, in plain words</h2>
  </div>
  <div class="wc-facts">
   <div><h3>A website, not a PDF</h3><p>You get access to a website, so it can be updated as things change.</p></div>
   <div><h3>15 minutes to start</h3><p>The Quick Start takes about 15 minutes. Customizing it takes about an hour.</p></div>
   <div><h3>Claude, ChatGPT or both</h3><p>Use the one you already have, or both.</p></div>
   <div><h3>Automatic, or approve first</h3><p>It runs automatically by default. Switch on approvals to OK each look first. I recommend approvals on for the first few days.</p></div>
   <div><h3>Themed Idea Lists</h3><p>Each pin links to the themed Amazon Idea List its products came from. Many looks live in each list.</p></div>
   <div class="wc-fact-must"><h3>Your computer stays on</h3><p>Your computer needs to be on and signed into Amazon while it works overnight.</p></div>
  </div>
  <WysCta note="Joining the waitlist doesn’t place an order."/>
 </section>

 <section class="wc-section" style="background:#fff">
  <div class="wys-wrap">
   <div class="wc-head">
    <p class="wc-kicker">The offer</p>
    <h2>Members first.<br/><em>Then everyone.</em></h2>
   </div>
   <WysOffer/>
  </div>
 </section>

 <div class="wc-final" style="background-image:url(/images/brand/gl-tile.webp)">
  <div class="wc-final-card">
   <p class="wc-kicker">The While-You-Sleep Storefront™</p>
   <h2>Go to bed.<br/><em>Wake up posted.</em></h2>
   <WysCta note="Get the email the moment it opens."/>
  </div>
 </div>
</WysFrame>
