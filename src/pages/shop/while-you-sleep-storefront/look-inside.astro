---
import WysDecor from '../../../components/WysDecor.astro';
import WysShelf from '../../../components/WysShelf.astro';
import WysStories from '../../../components/WysStories.astro';
import WysFrame from '../../../components/WysFrame.astro';
import WysHero from '../../../components/WysHero.astro';
import WysPackage from '../../../components/WysPackage.astro';
import WysWorksheet from '../../../components/WysWorksheet.astro';
import WysKit from '../../../components/WysKit.astro';
import WysFaq from '../../../components/WysFaq.astro';
import {Image} from 'astro:assets';
import {packages} from '../../../data/wys-packages.js';
import {WYS_ROOT} from '../../../data/wys.js';
---
<WysFrame current="inside" title="Look Inside WYS | Two Complete Content Examples" description="Explore two complete WYS content examples: three photographs, three Pins, three Instagram slides, a full article, five finds and copy for each look." ogImage={packages[0].photos[1].src.src}>
 <WysHero><p class="wys-ribbon">Look inside</p><h1>The While-You-Sleep<br/><em>Storefront™</em></h1><p class="wz-header-tagline">Two pink Halloween examples</p><p class="wys-lede">Pretty Wicked: a pink Halloween entryway.<br/>Ghoul Fuel: a pink Halloween coffee bar.<br/>See the photos, Pins, Instagram carousel and full blog story for each.</p><a class="wys-button" href="#choose-package">Explore the complete examples ↓</a></WysHero>
 <WysShelf inside/><div class="wx-ticker"><span>SELECT THE PIECES</span><span>STYLE THE LOOK</span><span>MAKE THE CONTENT</span><span>CHECK THE DESTINATIONS</span></div>
 <WysStories inside/>
 <div class="wys-wrap wx-packages">{packages.map((e,i)=><WysPackage example={e} number={i+1}/>)}</div>
 <section class="wx-process-band"><div class="wys-wrap wys-section"><div class="wx-centered"><p class="wys-label">One product selection does more of the work.</p><h2>This is the part you shouldn’t have to reinvent for every post.</h2><p>The products give the visuals their direction. The visuals help tell the story. The article explains the look. The Pins and carousel introduce it.</p><p>WYS is designed to give you a repeatable way to create those pieces around your own shopping ideas.</p><p>Your theme changes. Your products change. You still have a process to follow.</p></div></div></section>

 <section class="wys-wrap wys-section"><div class="wx-last-call wz-example-finale"><WysDecor class="wz-finale-flower"/><p class="wys-label">Two looks. The complete content.</p><h2>Start with the finds.<br/><em>See where the idea goes.</em></h2><div class="wz-finale-looks">{packages.map(e=><article class="wz-finale-look"><h3>{e.name}</h3><p>{e.category}</p><div class="wz-finale-photos">{e.photos.map((photo,i)=><figure><Image src={photo.src} alt={photo.alt} widths={[240,400]} sizes="(max-width:700px) 23vw, 130px"/><figcaption>{['The finds','The setting','The moment'][i]}</figcaption></figure>)}</div><p>3 styling images · 3 Pinterest Pins · 1 Instagram carousel · a full article + copy</p><a class="wys-button" href={`#${e.slug}`} data-return-example={e.slug}>See the complete {e.name} package ↑</a></article>)}</div><p>Your own products and theme give the next look its direction. WYS gives you a process for building the images, article and social content around them.</p><div class="wys-actions"><a href={WYS_ROOT} class="wys-button">Explore the WYS system →</a><a href={WYS_ROOT+'/waitlist'} class="wys-text-link">Join the waitlist →</a></div></div></section>
 <script>document.querySelectorAll<HTMLAnchorElement>('[data-return-example]').forEach(a=>a.addEventListener('click',()=>document.getElementById(a.dataset.returnExample!)?.querySelector<HTMLButtonElement>('[data-panel-button="0"]')?.click()));</script>
</WysFrame>
