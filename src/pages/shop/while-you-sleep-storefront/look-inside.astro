---
import WysDecor from '../../../components/WysDecor.astro';
import WysShelf from '../../../components/WysShelf.astro';
import WysStories from '../../../components/WysStories.astro';
import WysFrame from '../../../components/WysFrame.astro';
import WysCollage from '../../../components/WysCollage.astro';
import WysPackage from '../../../components/WysPackage.astro';
import WysWorksheet from '../../../components/WysWorksheet.astro';
import WysKit from '../../../components/WysKit.astro';
import WysFaq from '../../../components/WysFaq.astro';
import {Image} from 'astro:assets';
import {packages} from '../../../data/wys-packages.js';
import {WYS_ROOT} from '../../../data/wys.js';
---
<WysFrame current="inside" title="Look Inside WYS | Two Complete Worked Examples" description="Explore two complete WYS content examples: three photographs, three Pins, three Instagram slides, a full article, product records and copy for each look." ogImage={packages[0].photos[1].src.src}>
 <div class="wx-hero-band"><WysDecor kind="drip"/><header class="wys-wrap wx-hero"><div><p class="wys-ribbon">The While-You-Sleep Storefront™ / Look Inside</p><h1>One idea.<br/><em>A whole content package.</em></h1><p class="wys-lede">See what WYS prepares for one shopping idea: styling images, Pinterest Pins, an Instagram carousel and a complete blog article. Open either Halloween look to explore every piece, including the selected products and post captions.</p><a class="wys-button" href="#choose-package">Open a complete example ↓</a><p class="wx-hero-note">Explore the workflow now. Customer checkout and delivery remain on hold.</p></div><WysCollage/></header></div>
 <WysShelf inside/><div class="wx-ticker"><span>SELECT THE PIECES</span><span>STYLE THE LOOK</span><span>MAKE THE CONTENT</span><span>CHECK THE DESTINATIONS</span></div>
 <WysStories inside/>
 <div class="wys-wrap wx-packages">{packages.map((e,i)=><WysPackage example={e} number={i+1}/>)}</div>
 <section class="wx-process-band"><div class="wys-wrap wys-section"><div class="wx-centered"><p class="wys-label">Here’s what the system does</p><h2>From “I have an idea”<br/><em>to “I have a whole edit.”</em></h2></div><div class="wx-process"><div><b>01 / YOUR INPUT</b><h3>A look with a purpose.</h3><p>Choose your theme, season, category, source products and channels. Select the account path that fits your actual setup.</p></div><div><b>02 / THE CONTENT</b><h3>One connected package.</h3><p>Prepare the basic, styled and optional-persona lifestyle views, then graphics, article and channel copy built around the same pieces.</p></div><div><b>03 / YOUR CONTROL</b><h3>A checked next step.</h3><p>Review the content and verify its destinations. Publish manually or use a supported, tested mixed workflow with your own approval policy.</p></div></div></div></section>
 <WysWorksheet/><WysKit/><WysFaq/>
 <section class="wys-wrap wys-section"><div class="wx-last-call"><p class="wys-label">Like what you see?</p><h2>Keep the possibility.<br/><em>Lose the constant checking.</em></h2><p>Join The Weekly Edit for TDIE updates while the customer product is on hold.</p><a href={WYS_ROOT+'/waitlist'} class="wys-button">Get The Weekly Edit →</a></div></section>
</WysFrame>
