---
import WysFrame from '../../../components/WysFrame.astro';
import WysPhoto from '../../../components/WysPhoto.astro';
import WysCollage from '../../../components/WysCollage.astro';
import FreebieForm from '../../../components/FreebieForm.astro';
import {WYS_ROOT,examples} from '../../../data/wys.js';
---
<WysFrame current="waitlist" title="While-You-Sleep Storefront™ Updates | The Weekly Edit" description="Follow TDIE’s Weekly Edit for updates while the While-You-Sleep Storefront customer product remains on hold. No purchase or reserved place." ogImage={examples[1].photos[2].src.src}>
 <header class="wys-wrap wys-section wys-waitlist-hero wx-waitlist"><div class="wys-waitlist-copy"><p class="wys-ribbon">The While-You-Sleep Storefront™</p><h1>More ideas for your business.<br/><em>Less starting from scratch.</em></h1><p class="wys-lede">Interested in using AI to turn Amazon finds into styling images, articles, Pinterest Pins and Instagram content?</p><p>Explore WYS while the customer kit is being finalized, and join The Weekly Edit to stay connected with The Digital Income Edit™.</p><div class="wys-waitlist-form"><span class="wys-file-tab">THE WEEKLY EDIT / EMAIL SIGNUP</span><FreebieForm heading="Stay in the loop" button="Get The Weekly Edit" sub="You’re subscribing to TDIE’s newsletter. This does not reserve a WYS place or place an order. Unsubscribe anytime." done="Your signup was submitted. Check your inbox for any confirmation from The Weekly Edit. You can explore the WYS examples below."/></div><div class="wys-waitlist-fine"><span class="wys-status">Customer product on hold</span><p>No checkout, countdown or reserved place. Unsubscribe whenever you like.</p></div></div><div class="wys-waitlist-art"><WysCollage look={1}/></div></header>
 <section class="wys-example-band"><div class="wys-wrap wys-section"><div class="wys-section-head"><div><p class="wys-label">Plenty of pretty to explore now</p><h2>See the idea in action<br/><em>while you’re here.</em></h2></div><p>Five selected products. Three styling images. Three Pinterest graphics. An Instagram carousel. A full article.</p></div><div class="wys-browse-pair">{examples.map((example,i)=><a class="wys-browse-card" href={`${WYS_ROOT}/look-inside#${example.slug}`}><WysPhoto photo={example.photos[1]} treatment={i?'lavender':'double'} caption={example.category}/><span class="wys-label">The Lifestyle edit</span><h3>{example.name}</h3><span class="wys-button">Explore the complete example <span aria-hidden="true">→</span></span></a>)}</div></div></section>
 <section class="wys-wrap wys-section"><div class="wys-ticket wys-waitlist-ticket"><div><p class="wys-label">Curious about the process?</p><h2>The photographs are only<br/><em>one part of the story.</em></h2></div><div><p>Open the two Halloween examples and see how one shopping idea carries through every piece.</p><a class="wys-button" href={WYS_ROOT+'/look-inside'}>Take a look inside <span aria-hidden="true">→</span></a></div></div></section>
</WysFrame>
