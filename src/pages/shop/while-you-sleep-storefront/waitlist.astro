---
import WysFrame from '../../../components/WysFrame.astro';
import WysPhoto from '../../../components/WysPhoto.astro';
import WysCollage from '../../../components/WysCollage.astro';
import FreebieForm from '../../../components/FreebieForm.astro';
import {WYS_ROOT,examples} from '../../../data/wys.js';
---
<WysFrame current="waitlist" title="While-You-Sleep Storefront™ Updates | The Weekly Edit" description="Follow TDIE’s Weekly Edit for updates while the While-You-Sleep Storefront customer product remains on hold. No purchase or reserved place." ogImage={examples[1].photos[2].src.src}>
 <header class="wys-wrap wys-section wys-waitlist-hero wx-waitlist"><div class="wys-waitlist-copy"><p class="wys-ribbon">The next chapter, when it’s ready</p><h1>Keep a little room<br/>for <em>what’s next.</em></h1><p class="wys-lede">Follow The Weekly Edit while the While-You-Sleep Storefront™ customer product is on hold. A place to hear from TDIE without another thing to keep checking.</p><div class="wys-waitlist-form"><span class="wys-file-tab">THE WEEKLY EDIT / EMAIL SIGNUP</span><FreebieForm heading="Stay in the loop" button="Get The Weekly Edit" sub="This subscribes you to The Weekly Edit, TDIE’s existing newsletter. It does not reserve a WYS spot, place an order or promise a launch date." done="Your signup was submitted. Check your inbox for any confirmation from The Weekly Edit."/></div><div class="wys-waitlist-fine"><span class="wys-status">Customer product on hold</span><p>No checkout, countdown or reserved place. Unsubscribe whenever you like.</p></div></div><div class="wys-waitlist-art"><WysCollage look={1}/></div></header>
 <section class="wys-example-band"><div class="wys-wrap wys-section"><div class="wys-section-head"><div><p class="wys-label">Plenty of pretty to explore now</p><h2>While you’re here,<br/><em>open a little inspiration.</em></h2></div><p>The styling articles are available to read. Their pending affiliate destinations stay pending.</p></div><div class="wys-browse-pair">{examples.map((example,i)=><a class="wys-browse-card" href={`/lifestyle/${example.slug}`}><WysPhoto photo={example.photos[1]} treatment={i?'lavender':'double'} caption={example.category}/><span class="wys-label">The Lifestyle edit</span><h3>{example.name}</h3><span class="wys-button">Read the styling article <span aria-hidden="true">→</span></span></a>)}</div></div></section>
 <section class="wys-wrap wys-section"><div class="wys-ticket wys-waitlist-ticket"><div><p class="wys-label">Curious about the process?</p><h2>The photographs are only<br/><em>one part of the story.</em></h2></div><div><p>Open two complete packages: photographs, Pinterest graphics, Instagram slides, the full article, five product records and the copy that ties each look together.</p><a class="wys-button" href={WYS_ROOT+'/look-inside'}>Take a look inside <span aria-hidden="true">→</span></a></div></div></section>
</WysFrame>
