---
import WysFrame from '../../../components/WysFrame.astro';
import FreebieForm from '../../../components/FreebieForm.astro';
import WysNightFeed from '../../../components/WysNightFeed.astro';
import WysYouDo from '../../../components/WysYouDo.astro';
import WysOffer from '../../../components/WysOffer.astro';
import {WYS_ROOT} from '../../../data/wys.js';
import {liveLooks} from '../../../data/wys-live.js';
---
<WysFrame focus current="waitlist" title="The While-You-Sleep Storefront™ Waitlist" description="Join the waitlist for The While-You-Sleep Storefront™ and get the email the moment it opens. Member presale opens Tuesday 13 October 2026." ogImage={liveLooks[0].photos.lifestyle.src.src}>
 <header class="wc-hero">
  <div class="wys-wrap wc-wait-grid">
   <div class="wc-hero-copy">
    <p class="wc-kicker">The waitlist</p>
    <h1 class="wh-name">The <span class="wh-nb">While-You-Sleep</span> Storefront™</h1>
    <p class="wh-sub">Be first in <em>when it opens.</em></p>
    <p class="wc-hero-line">It’s not a guide. It’s an automation you set up once. Then every night it plans <b>2&nbsp;looks</b>, makes the Pinterest pins, writes the blog posts and posts to Instagram, while you sleep.</p>
    <div class="wc-wait-form">
     <span class="wc-example-tag" style="left:28px;transform:rotate(-2deg)">Not open yet</span>
     <FreebieForm action="/api/wys-waitlist" heading="Join the waitlist" button="Join the waitlist" sub="You’ll get the email the moment it opens, plus updates from The Digital Income Edit™. Unsubscribe anytime." done="You’re on the waitlist. Watch your inbox for the email when it opens."/>
    </div>
    <p class="wc-wait-fine">Joining the waitlist doesn’t place an order. Member presale opens Tuesday 13 October 2026. Full launch Friday 16 October 2026.</p>
   </div>
   <div class="wc-hero-phone"><WysNightFeed/></div>
  </div>
 </header>

 <section class="wc-section" style="background:#fff">
  <div class="wys-wrap">
   <div class="wc-head">
    <p class="wc-kicker">You do / It does</p>
    <h2>Set it up once.<br/><em>It does the rest.</em></h2>
   </div>
   <WysYouDo/>
  </div>
 </section>

 <section class="wys-wrap wc-section">
  <div class="wc-head">
   <p class="wc-kicker">The dates</p>
   <h2>Members first.<br/><em>Then everyone.</em></h2>
  </div>
  <WysOffer/>
 </section>

 <div class="wc-final" style="background-image:url(/images/brand/gl-tile.webp)">
  <div class="wc-final-card">
   <p class="wc-kicker">While you wait</p>
   <h2>See every piece of<br/><em>one night’s work.</em></h2>
   <p class="wc-body">Two real looks, start to finish: the photos, the pins, the live blog posts and the carousels.</p>
   <div class="wc-cta"><a class="wc-button" href={WYS_ROOT + '/look-inside'}>Look inside <span aria-hidden="true">→</span></a></div>
  </div>
 </div>
</WysFrame>
