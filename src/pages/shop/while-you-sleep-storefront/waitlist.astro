---
import WysFrame from '../../../components/WysFrame.astro';
import WysPhoto from '../../../components/WysPhoto.astro';
import WysCollage from '../../../components/WysCollage.astro';
import BlueprintForm from '../../../components/BlueprintForm.astro';
import {WYS_ROOT,examples} from '../../../data/wys.js';
---
<WysFrame current="waitlist" title="Join the launch list | The While-You-Sleep Storefront™" description="Be first to hear when The While-You-Sleep Storefront™ opens. Set it up once; it turns your Amazon finds into photos, pins, posts and blog posts." ogImage={examples[1].photos[2].src.src}>
 <header class="wys-wrap wys-section wys-waitlist-hero wx-waitlist"><div class="wys-waitlist-copy"><p class="wys-ribbon">The While-You-Sleep Storefront™</p><h1>Be first<br/><em>when it opens.</em></h1><p class="wys-lede">Planned. Pinned. Posted. Blogged. You slept.</p><p>Set it up once and it turns the finds on your Amazon storefront into photos, Pinterest pins, an Instagram post and a blog post, then schedules them. It's in final testing now.</p><div class="wys-waitlist-form"><span class="wys-file-tab">THE LAUNCH LIST</span><BlueprintForm kit="wys-waitlist" file="" heading="Get the launch email" sub="One email the moment it opens. Nothing else." button="Put me on the list" doneTitle="You're on the list." doneSub="You'll hear the moment The While-You-Sleep Storefront™ opens." fine="Just the launch email. Unsubscribe anytime." /></div><div class="wys-waitlist-fine"><span class="wys-status">Not on sale yet</span><p>Joining the list doesn't buy or reserve anything.</p></div></div><div class="wys-waitlist-art"><WysCollage look={1}/></div></header>
 <section class="wys-example-band"><div class="wys-wrap wys-section"><div class="wys-section-head"><div><p class="wys-label">See it in action</p><h2>Two real looks,<br/><em>start to finish.</em></h2></div><p>Each one: three photos, three Pinterest pins, an Instagram post and a blog post, all made from five Amazon finds.</p></div><div class="wys-browse-pair">{examples.map((example,i)=><a class="wys-browse-card" href={`${WYS_ROOT}/look-inside#${example.slug}`}><WysPhoto photo={example.photos[1]} treatment={i?'lavender':'double'} caption={example.category}/><span class="wys-label">The Lifestyle edit</span><h3>{example.name}</h3><span class="wys-button">Explore the complete example <span aria-hidden="true">→</span></span></a>)}</div></div></section>
 <section class="wys-wrap wys-section"><div class="wys-ticket wys-waitlist-ticket"><div><p class="wys-label">Curious about the process?</p><h2>The photographs are only<br/><em>one part of the story.</em></h2></div><div><p>Open the two Halloween examples and see how one shopping idea carries through every piece.</p><a class="wys-button" href={WYS_ROOT+'/look-inside'}>Take a look inside <span aria-hidden="true">→</span></a></div></div></section>
</WysFrame>
