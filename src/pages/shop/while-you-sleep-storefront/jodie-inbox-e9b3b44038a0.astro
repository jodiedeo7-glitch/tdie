---
// Jodie's private inbox for the buyer-website box. Not linked anywhere, not indexed.
// Everything loads only after her inbox key is entered (checked by /api/wys-inbox).
import WysFrame from '../../../components/WysFrame.astro';
import '../../../styles/wys-buyer.css';
---
<WysFrame focus noindex title="Storefront Inbox" description="Private inbox.">
 <section class="wb2-sec jin">
  <div class="wys-wrap">
   <p class="wb2-kicker">Just for Jodie</p>
   <h1 class="jin-h">Storefront inbox</h1>
   <p class="jin-lede">Everything buyers send from the box on their Storefront website: things that look weird, and sets they love.</p>
   <form class="jin-key" hidden>
    <label><b>Your inbox key</b><input name="key" type="password" autocomplete="current-password" required></label>
    <button class="wb2-btn jin-btn" type="submit">Open my inbox <span class="arr" aria-hidden="true">→</span></button>
   </form>
   <div class="jin-bar" hidden>
    <div class="jin-tabs" role="group" aria-label="Show">
     <button type="button" data-f="all" aria-pressed="true">Everything</button>
     <button type="button" data-f="love" aria-pressed="false">Sets they love</button>
     <button type="button" data-f="share" aria-pressed="false">OK to share</button>
     <button type="button" data-f="feedback" aria-pressed="false">Something weird</button>
    </div>
    <button type="button" class="jin-refresh">Refresh</button>
   </div>
   <p class="jin-status" role="status" aria-live="polite"></p>
   <div class="jin-list"></div>
  </div>
 </section>
</WysFrame>
<style is:global>
 .wb2-sec.jin{padding-top:96px}
 @media (min-width:900px){.wb2-sec.jin{padding-top:190px}}
 .wys-world .jin-h{font-size:34px;margin:0 0 6px}
 .jin-lede{margin:0 0 16px;font-size:16px;max-width:60ch}
 .jin [hidden]{display:none!important}
 .jin-key{display:grid;gap:12px;max-width:420px}
 .jin-key label{display:grid;gap:6px;font:600 14px/1.3 Jost,sans-serif}
 .jin-key input{padding:12px 14px;border:1px solid #E9B4CF;border-radius:12px;font:400 16px Jost,sans-serif}
 .jin .jin-key .jin-btn{justify-self:start;border:1.5px solid var(--wys-pink)!important;border-radius:999px!important;background:#fff!important;color:var(--wys-ink)!important;padding:0 22px!important;min-height:48px;font:700 15px/1.2 Jost,sans-serif!important;box-shadow:none!important}
 .jin-bar{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;margin-bottom:12px}
 .jin-tabs{display:flex;flex-wrap:wrap;gap:8px}
 .jin-bar button{appearance:none;min-height:40px;padding:0 16px;border:1px solid #D9B9CB!important;border-radius:999px!important;background:#fff!important;color:var(--wys-ink)!important;font:600 14px/1.2 Jost,sans-serif!important;box-shadow:none!important;cursor:pointer}
 .jin-bar button[aria-pressed=true]{border-color:#B8245F!important;background:#FFE8F2!important;color:#8A1D4A!important}
 .jin-status{margin:0 0 10px;font-size:15px;min-height:1.2em}
 .jin-list{display:grid;gap:14px}
 .jin-item{padding:16px 18px;border:1px solid #E9B4CF;border-radius:16px;background:#fff}
 .jin-item.love{border-color:#B8245F}
 .jin-meta{display:flex;flex-wrap:wrap;gap:6px 12px;align-items:center;font-size:13px;color:#7a5a6c;margin-bottom:8px}
 .jin-tag{display:inline-flex;padding:3px 10px;border-radius:999px;font:700 11px/1.4 Jost,sans-serif;letter-spacing:.08em;text-transform:uppercase;background:#F6F1FF;color:#5b3c8a}
 .jin-tag.love{background:#FFE8F2;color:#8A1D4A}
 .jin-tag.ok{background:#E7F6EE;color:#1d6b43}.jin-tag.no{background:#F4F1F2;color:#6b5a62}
 .jin-who{font:600 15px/1.4 Jost,sans-serif;margin:0 0 4px}
 .jin-msg{margin:0 0 10px;font-size:15px;white-space:pre-wrap}
 .jin-photos{display:flex;flex-wrap:wrap;gap:10px}
 .jin-photos a{display:block}
 .jin-photos img{max-width:180px;max-height:240px;width:auto;height:auto;border-radius:10px;border:1px solid #E9B4CF;background:#FFF7FB}
</style>
<script>
 const KEY='wys-inbox-key';
 const keyForm=document.querySelector('.jin-key'),bar=document.querySelector('.jin-bar'),list=document.querySelector('.jin-list'),status=document.querySelector('.jin-status');
 let key='',items=[],filter='all';const blobs=new Map();
 const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
 try{key=localStorage.getItem(KEY)||'';}catch{}
 async function api(q=''){const r=await fetch('/api/wys-inbox'+q,{headers:{'X-Inbox-Key':key}});if(r.status===401)throw new Error('key');if(!r.ok)throw new Error('That didn\'t load. Try Refresh.');return r;}
 async function photo(id){if(blobs.has(id))return blobs.get(id);const u=URL.createObjectURL(await (await api('?photo='+id)).blob());blobs.set(id,u);return u;}
 function render(){
  const shown=items.filter(i=>filter==='all'||(filter==='share'?i.kind==='love'&&i.consent:i.kind===filter));
  status.textContent=shown.length?'':(items.length?'Nothing here yet in this view.':'Nothing yet. When a buyer sends something, it shows up here.');
  list.innerHTML=shown.map(i=>{const love=i.kind==='love';const when=new Date(i.created_at).toLocaleString([], {dateStyle:'medium',timeStyle:'short'});
   return `<article class="jin-item ${love?'love':''}"><div class="jin-meta"><span class="jin-tag ${love?'love':''}">${love?'Set they love':'Something weird'}</span>${love?`<span class="jin-tag ${i.consent?'ok':'no'}">${i.consent?'OK to share':'Not for sharing'}</span>`:''}<span>${esc(when)}</span><span>${esc(i.page)}</span></div>
   <p class="jin-who">${esc(i.name||'No name')}${i.email?` · <a href="mailto:${esc(i.email)}">${esc(i.email)}</a>`:''}${i.credit?` · credit: ${esc(i.credit)}`:''}</p>
   ${i.message?`<p class="jin-msg">${esc(i.message)}</p>`:''}<div class="jin-photos" data-ids="${i.photo_ids.join(',')}"></div></article>`;}).join('');
  list.querySelectorAll('.jin-photos').forEach(async box=>{for(const id of box.dataset.ids.split(',').filter(Boolean)){try{const u=await photo(id);box.insertAdjacentHTML('beforeend',`<a href="${u}" download="buyer-photo-${id}.jpg" target="_blank"><img src="${u}" alt="Buyer photo"></a>`);}catch{}}});
 }
 async function load(){status.textContent='Loading…';
  try{items=(await (await api()).json()).items||[];keyForm.hidden=true;bar.hidden=false;render();}
  catch(e){if(e.message==='key'){try{localStorage.removeItem(KEY);}catch{}keyForm.hidden=false;bar.hidden=true;list.innerHTML='';status.textContent=key?'That key doesn\'t match. Try again.':'';}else status.textContent=e.message;}}
 keyForm.addEventListener('submit',e=>{e.preventDefault();key=keyForm.key.value.trim();try{localStorage.setItem(KEY,key);}catch{}load();});
 document.querySelectorAll('.jin-tabs button').forEach(b=>b.addEventListener('click',()=>{filter=b.dataset.f;document.querySelectorAll('.jin-tabs button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));render();}));
 document.querySelector('.jin-refresh').addEventListener('click',load);
 if(key)load();else keyForm.hidden=false;
</script>
