---
import PageLayout from "../../layouts/PageLayout.astro";
---
<PageLayout
  title="Shop"
  description="Digital products, templates, and tools from The Digital Income Edit™."
>
  <div class="page-eyebrow">Shop</div>
  <h1>The Shop</h1>
  <p class="lede">Digital products built to remove your next bottleneck — not add another course to your pile.</p>

  <div style="border-top:1px solid var(--gray);margin-top:40px">
    <a href="/shop/pretty-and-paid-plr-vault/" style="display:flex;justify-content:space-between;align-items:baseline;padding:26px 0;border-bottom:1px solid var(--gray);text-decoration:none;color:inherit">
      <span style="font-family:'Fraunces',serif;font-size:22px">Pretty &amp; Paid PLR Vault™</span>
      <span style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--taupe-deep)">$11/month · Membership</span>
    </a>
  </div>

  <h2 style="font-family:'Fraunces',serif;font-size:26px;margin-top:64px;margin-bottom:8px">The Value Vault</h2>
  <p style="margin-bottom:0">Short, single-problem guides. Buy one when you need it, or unlock every guide — plus every future drop — inside VIP at $27/month.</p>

  <div style="border-top:1px solid var(--gray);margin-top:32px">
