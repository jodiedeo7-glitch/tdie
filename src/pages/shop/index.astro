---
<PageLayout
  wide={true}
  title="Shop"
  description="Every live product from The Digital Income Edit™ — the Value Vault, memberships, one-time guides, the AI Influencer suite, done-for-you services, and recommended tools."
>
  <div class="page-eyebrow">Shop</div>
  <h1>Everything, in one place</h1>
  <p class="lede">Nothing here is a course you will not finish. Short, specific, and built to remove the next bottleneck rather than add to your pile.</p>

  <!-- ── THE VALUE VAULT ─────────────────────────────────── -->
  <section class="vault">
    <div class="vault-head">
      <div class="vault-k">The Value Vault</div>
      <div class="vault-script">Value Vault</div>
      <p class="vault-sub">Single-problem guides, priced like a coffee. Buy the one you need this week — or open all of them at once inside VIP, where the whole collection unlocks as the VIP Vault.</p>
    </div>
    <div class="vault-grid">
      {vault.map((v) => (
        <a class="vcard" href={v.url}>
          <div class="vprice">{v.price}</div>
          <div class="vnote">{v.note}</div>
          <h3>{v.name}</h3>
          <p>{v.copy}</p>
          <span class="vgo">Get the guide →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── READING THE PRICES ──────────────────────────────── -->
  <div class="prices-note">
    <strong>Two numbers repeat on this page, so here is what each one buys.</strong>
    <span><b>$9</b> is either Membership Premium, which bills every month, or the Pinterest batching guide, which is a one-time download. <b>$27</b> is either Membership VIP, which bills every month, or one of three one-time purchases — Pinterest Foundations™, The One and Done Money Stream, or the Bonus Bundle. Recurring items are labelled <em>per month</em>. Everything else is paid once.</span>
  </div>

  <!-- ── CATEGORIES ──────────────────────────────────────── -->
  {groups.map((g) => (
    <section class="grp" id={g.id}>
      <div class="grp-head">
        <div class="grp-k">{g.label}</div>
        <h2>{g.title}</h2>
        <p class="grp-note">{g.note}</p>
      </div>
      <div class="rows">
        {g.items.map((it) => (
          <a class="row" href={it.url} rel={it.aff ? "sponsored nofollow" : null} target={it.aff ? "_blank" : null}>
            <span class="r-main">
              <span class="r-name">{it.name}{it.aff && <span class="r-aff">Affiliate</span>}</span>
              <span class="r-copy">{it.copy}</span>
            </span>
            <span class="r-price">{it.price}<em>{it.note}</em></span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p class="disclose">
    Products marked <strong>Affiliate</strong> are not mine. I recommend them because I use them, and I earn a commission if you buy — at no extra cost to you. Their owners set those prices and can change them without telling me.
  </p>

  <p class="back"><a href="/learn">← Back to The Library</a></p>
</PageLayout>

<style>
  /* ---------- VALUE VAULT (top, pink) ---------- */
  .vault{
    margin:56px 0 0;padding:54px 44px 50px;border-radius:26px;
    background:linear-gradient(165deg,#FFEAF3 0%,var(--rose) 46%,#F9DCE8 100%);
    border:1px solid rgba(214,46,115,.16);
    box-shadow:0 40px 80px -60px rgba(214,46,115,.55);
  }
  .vault-head{text-align:center;max-width:52ch;margin:0 auto 40px}
  .vault-k{font-size:11px;font-weight:600;letter-spacing:3.2px;text-transform:uppercase;color:var(--pink);margin-bottom:10px}
  .vault-script{
    font-family:var(--display);font-style:italic;font-weight:300;
    font-size:clamp(46px,7vw,76px);line-height:1;letter-spacing:-1.5px;
    color:var(--pink);margin-bottom:6px;
  }
  .vault-sub{
    font-family:var(--serif);font-style:italic;font-size:20px;line-height:1.55;
    color:var(--choc-soft);margin:0;
  }
  .vault-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
  @media(max-width:860px){.vault-grid{grid-template-columns:1fr}.vault{padding:40px 24px 36px}}
  .vcard{
    display:flex;flex-direction:column;background:var(--white);border-radius:16px;
    padding:26px 24px 24px;border:1px solid rgba(214,46,115,.12);
    transition:transform .35s var(--ease),box-shadow .35s var(--ease);
  }
  .vcard:hover{transform:translateY(-3px);box-shadow:0 24px 44px -26px rgba(214,46,115,.5)}
  .vprice{font-family:var(--serif);font-size:30px;line-height:1;color:var(--pink)}
  .vnote{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--taupe-deep);margin:6px 0 14px}
  .vcard h3{font-family:var(--display);font-weight:400;font-size:20px;line-height:1.22;margin:0 0 10px}
  .vcard p{font-size:14.5px;line-height:1.6;color:var(--choc-soft);margin:0 0 18px;flex:1}
  .vgo{font-size:11px;font-weight:600;letter-spacing:1.6px;text-transform:uppercase;color:var(--pink)}

  /* ---------- PRICE NOTE ---------- */
  .prices-note{
    margin:44px 0 0;padding:22px 26px;border-left:2px solid var(--gold);
    background:rgba(200,169,106,.07);border-radius:0 12px 12px 0;
  }
  .prices-note strong{display:block;font-size:14px;margin-bottom:8px}
  .prices-note span{display:block;font-size:14px;line-height:1.75;color:var(--choc-soft)}

  /* ---------- CATEGORY GROUPS ---------- */
  .grp{margin-top:78px}
  .grp-head{margin-bottom:24px}
  .grp-k{font-size:11px;font-weight:600;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:8px}
  .grp-head h2{font-family:var(--display);font-weight:300;font-size:clamp(27px,3.6vw,38px);letter-spacing:-.4px;margin:0 0 8px}
  .grp-note{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--taupe-deep);margin:0;max-width:56ch}

  .rows{border-top:1px solid var(--gray)}
  a.row{
    display:grid;grid-template-columns:1fr auto;gap:26px;align-items:start;
    padding:24px 8px;border-bottom:1px solid var(--gray);
    transition:padding-left .4s var(--ease),background .4s var(--ease);
  }
  a.row:hover{padding-left:16px;background:rgba(255,138,194,.07)}
  .r-name{display:block;font-family:var(--display);font-size:21px;line-height:1.25}
  .r-copy{display:block;font-size:14.5px;line-height:1.6;color:var(--taupe-deep);margin-top:6px;max-width:62ch}
  .r-aff{
    display:inline-block;margin-left:10px;vertical-align:middle;font-family:var(--sans);
    font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;color:var(--gold-deep);
    border:1px solid var(--gold);border-radius:100px;padding:2px 9px;
  }
  .r-price{
    text-align:right;white-space:nowrap;font-family:var(--serif);font-size:25px;color:var(--pink);line-height:1.1;
  }
  .r-price em{
    display:block;font-family:var(--sans);font-style:normal;font-size:10px;letter-spacing:1.6px;
    text-transform:uppercase;color:var(--taupe-deep);margin-top:5px;
  }
  @media(max-width:620px){
    a.row{grid-template-columns:1fr;gap:12px}
    .r-price{text-align:left}
  }

  .disclose{margin-top:56px;font-size:14px;line-height:1.75;color:var(--taupe-deep)}
  .back{margin-top:44px}
  .back a{color:var(--pink);font-weight:500}
</style>
