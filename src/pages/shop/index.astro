---
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/edit.css";
import { membership, weekendEcosystem as we, SKOOL_PLANS } from "../../data/facts.js";
// Tina's words come from the single verbatim source, unedited.
import Testimonial from "../../components/Testimonial.astro";

// Every name, price and URL below is a products[] row in ops/canon/canon.json.
// Nothing is inferred. Membership and Weekend Ecosystem facts come from
// src/data/facts.js only. Affiliate rows ship link, rel="sponsored" and the
// disclosure as a set (Standing Rule 18), in their own section, never in a
// primary slot. Pretty & Paid PLR Vault is its own section, never beside the
// membership band.

const SITE = "https://www.thedigitalincomeedit.com";

// 01 START HERE: $0 only (journey_slot_rules.free).
const free = [
  { name: "The Faceless Income Blueprint™", url: "/resources/faceless-income-blueprint", go: "Get the Blueprint",
    copy: "Niche, first product, first traffic source: the whole shape of the business in one document." },
  // Canon name: "$10/Day Traffic Machine" + "Starter Map", set on two lines so the page carries no dash.
  { name: "$10/Day Traffic Machine", sub: "Starter Map", url: "/resources/starter-map", go: "Get the Starter Map",
    copy: "Ten pages on buying traffic without gambling: what to spend, what to watch, when to stop." },
  { name: "FREE GUIDE - One & Done Money Stream", url: "/go/free-guide-one-done-money-stream", go: "Read the free guide",
    copy: "The short version of the one-product, one-system approach." },
];

// 03 MEMBERSHIP: compact. Full comparison lives on /membership.
const tiers = [
  { key: "standard", t: membership.standard,
    buys: "Foundations, AI, branding, content and traffic training, with daily prompts and community.",
    items: ["Pinterest Foundations™, The Email Edit and The Shopify Edit", "Daily Prompts and the community", "The Value Vault guides, bought à la carte"] },
  { key: "premium", t: membership.premium,
    buys: "Standard plus offer, funnel and systems training, a written monthly content calendar and unlocked guides.",
    items: ["Everything in Standard", "The Offer Edit, The Funnel Edit, Scaling & Systems and The Ads Edit™", "The Premium Vault: every Value Vault guide, already unlocked"] },
];

// 04 GUIDES. The Value Vault: ledger-confirmed items only.
const vault = [
  { name: "Build Your First Freebie in One Afternoon", price: "$7", url: "/vault/freebie-in-an-afternoon", go: "Build my freebie",
    copy: "The lead magnet and the paid offer behind it, both finished before dinner." },
  { name: "The Operating Prompts™", price: "$19", url: "/go/the-operating-prompts", go: "Get The Operating Prompts™",
    copy: "The thirty-four prompts that actually run my business. Strict on purpose, built on your own Brand Card." },
  { name: "How I Batch & Schedule a Month of Pinterest in One 3-Hour Block", price: "$9", url: "/go/how-i-batch-schedule-a-month-of-pinterest-in-one-3-hour-bloc", go: "Get the batching guide",
    copy: "A month of pins queued in a single sitting. The exact order I work in." },
];

const guides = [
  { name: "Pinterest Foundations™", price: "$27", terms: "one-time · Skool course", url: "https://www.skool.com/thedigitalincomeedit/classroom/ede8aaca",
    copy: "The full Pinterest system as a course. Also included with Membership Standard; buying it outright is for people who only want this one thing." },
  { name: "The One and Done Money Stream", price: "$27", terms: "one-time", url: "/go/one-and-done-money-stream",
    copy: "One digital income stream, built once, set to earn on repeat. Includes resell rights." },
  { name: "BONUS BUNDLE WITH RESELL RIGHTS", price: "$27", terms: "one-time", url: "/go/bonus-bundle-with-resell-rights",
    copy: "A bundle of ready-made products you can put your own name on and sell." },
  { name: "550+ BRILLIANT chatGPT prompts for your business", price: "$2", terms: "one-time", url: "/go/550-brilliant-chatgpt-prompts-for-your-business",
    copy: "A wide prompt library to raid when you are staring at a blank box." },
];

// 05 AI & CREATOR
const suite = [
  { n: "01", name: "AI Influencer Flash Sale", price: "$50", url: "/go/ai-influencer-flash-sale",
    copy: "The entry point into the AI influencer build." },
  { n: "02", name: "AI Influencer Starter Twin", price: "$97", url: "/go/ai-influencer-starter-twin",
    copy: "Your persona, generated to stay the same face every time." },
  { n: "03", name: "AI Influencer Brand Bundle", price: "$147", url: "/go/ai-influencer-brand-bundle",
    copy: "The persona plus the brand assets that surround her." },
  { n: "04", name: "AI Influencer Content Drop", price: "$297", url: "/go/ai-influencer-content-drop",
    copy: "A delivered content library for a persona already built." },
];

const creator = [
  { name: "The Tommy Kate Edit", price: "$17", terms: "one-time · lifetime access", url: "/go/the-tommy-kate-edit",
    copy: "The AI prompt bank behind a consistent faceless persona, with lifetime updates. Also inside both memberships." },
  { name: "150 UGC Brand Contacts", price: "$15", terms: "one-time", url: "/go/ugc-brand-contacts",
    copy: "Brands actively paying creators, with the contact route. Skip the research, start pitching." },
  { name: "Zero Income Claim Guide - 100 DFY Reels", price: "$37", terms: "one-time", url: "/go/zero-income-claim-reels",
    copy: "A hundred done-for-you hooks and captions for Reels, written for the stage before you have social proof: no screenshots, no income claims, nothing that gets an account flagged." },
];

// 07 DONE FOR YOU
const dfy = [
  { name: "DFY Instagram Audit + Growth Optimization", price: "$197", terms: "one-time", url: "/go/dfy-instagram-audit-growth-optimization",
    copy: "A full read of the account and the specific changes that move it." },
  { name: "DFY Instagram Audit + Custom Viral Content Calendar", price: "$350", terms: "one-time", url: "/go/dfy-instagram-audit-custom-viral-content-calendar",
    copy: "The audit, plus a content calendar built for your account rather than a template." },
  { name: "#TDIE FB GROUP PROMO", price: "$10", terms: "per month · promotion slot", url: "/go/tdie-fb-group-promo",
    copy: "A recurring promotion placement inside the Facebook group." },
];

// 08 RECOMMENDED: affiliate, not owned. Prices are the owners' and can change.
const recommended = [
  { name: "Leni Loves", price: "$27", terms: "on sale, regular $37", url: "/go/leni-loves",
    copy: "Aesthetic templates and brand resources." },
  { name: "The Conversion Architect", price: "$47", terms: "one-time", url: "/go/the-conversion-architect",
    copy: "Conversion structure for offers and pages." },
  { name: "Claude Studio Kit", price: "$57", terms: "one-time", url: "/go/claude-studio-kit",
    copy: "A working setup for running Claude as a studio rather than a chat box." },
  { name: "The Faceless Launch Formula by @thebossdigitalwealth | Stan", price: "$77", terms: "one-time", url: "/go/the-faceless-launch-formula-by-thebossdigitalwealth-stan",
    copy: "A launch framework built for faceless brands." },
  { name: "Earn With Skool (SCC)", price: "$97", terms: "one-time", url: "/go/earn-with-skool-scc",
    copy: "The course I used to build this community's own Skool group." },
  { name: "The AI Subs Method", price: "$147", terms: "one-time", url: "/go/ai-subs-method",
    copy: "Growing and monetising a faceless AI subscription channel." },
  { name: "NAVIA AI STUDIO", price: "$197", terms: "one-time", url: "/go/navia-ai-studio",
    copy: "An AI production studio setup." },
];

const index = [
  { id: "start-here", n: "01", t: "Free" },
  { id: "flagship", n: "02", t: "The Weekend Ecosystem™" },
  { id: "membership", n: "03", t: "The membership" },
  { id: "guides", n: "04", t: "Guides" },
  { id: "ai-creator", n: "05", t: "AI & creator" },
  { id: "plr-vault", n: "06", t: "Pretty & Paid PLR Vault™" },
  { id: "done-for-you", n: "07", t: "Done for you" },
  { id: "recommended", n: "08", t: "Recommended" },
];

// Owned products only, in page order. Affiliates are not listed as ours.
const abs = (u) => (u.startsWith("http") ? u : `${SITE}${u}`);
const owned = [
  ...free.map((f) => ({ name: f.sub ? `${f.name} ${f.sub}` : f.name, url: f.url })),
  { name: we.name, url: we.url },
  { name: membership.standard.name, url: SKOOL_PLANS },
  { name: membership.premium.name, url: SKOOL_PLANS },
  ...vault, ...guides, ...suite, ...creator,
  { name: "Pretty & Paid PLR Vault™", url: "/shop/pretty-and-paid-plr-vault" },
  ...dfy,
];
const schema = [{
  "@type": "ItemList",
  name: "The Digital Income Edit™ shop",
  itemListElement: owned.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.name, url: abs(p.url) })),
}];
---
<PageLayout
  bare
  title="Shop"
  description="The Digital Income Edit™ shop, in order: free guides first, then The Weekend Ecosystem™, the membership, single guides and done-for-you services."
  schema={schema}
>
  <!-- MASTHEAD -->
  <header class="mast">
    <div class="e-wrap mast-grid">
      <div class="e-rise">
        <p class="e-kick">The shop</p>
        <h1 class="mast-h">Something to sell. Somewhere to send them. <em>Less work to repeat.</em></h1>
        <p class="e-lede">Find the next piece your business needs: ready-made products to rebrand, a course to build your own website, training and monthly content, or a private service. Start with the free resources if you are still deciding what to sell.</p>
      </div>
      <nav class="idx e-rise e-rise-2" aria-label="On this page">
        <p class="idx-h">On this page</p>
        <ol>
          {index.map((s) => (
            <li><a href={`#${s.id}`}><span class="idx-n">{s.n}</span>{s.t}</a></li>
          ))}
        </ol>
      </nav>
    </div>
  </header>

  <!-- 01 START HERE -->
  <section class="e-sec-sm sec" id="start-here" aria-labelledby="h-free">
    <div class="e-wrap">
      <div class="head">
        <p class="e-kick">01 · Free</p>
        <h2 class="e-d3" id="h-free">Start with what costs <em>nothing.</em></h2>
        <p class="note">Finished guides, not teasers. No card, no trial.</p>
      </div>
      <ul class="free e-reveal">
        {free.map((f) => (
          <li>
            <span class="free-tag">Free</span>
            <h3>{f.name}{f.sub && <span class="sub">{f.sub}</span>}</h3>
            <p>{f.copy}</p>
            <a class="e-link" href={f.url}>{f.go} <span class="ar" aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 THE FLAGSHIP -->
  <section class="e-dark flag" id="flagship" aria-labelledby="h-flag">
    <div class="flag-grid">
      <figure class="flag-fig">
        <div class="flag-img e-unveil">
          <img src="/images/we/module-list.jpg" width="1100" height="1191" loading="lazy" alt="The real module list inside The Weekend Ecosystem™" />
        </div>
        <figcaption class="e-credit flag-cap"><b>Pictured</b> Tommy Kate, the brand's AI persona</figcaption>
      </figure>
      <div class="flag-body">
        <p class="e-kick">02 · The course</p>
        <p class="flag-name">{we.name}</p>
        <h2 class="flag-h" id="h-flag">Your website and blog, <em>built in one weekend.</em></h2>
        <p class="e-lede">A real site on a domain you own, built from the content you already have, with Claude doing the heavy lifting. No code, no designer, no starting from blank.</p>

        <dl class="flag-dl">
          <div>
            <dt>Who it is for</dt>
            <dd>You run a Skool group, sell digital products, or have courses and calls piling up, and none of it lives on a site you own.</dd>
          </div>
          <div>
            <dt>What changes</dt>
            <dd>Your lessons become articles Google can find, your products get a home that is yours, and every future update lands in your account free.</dd>
          </div>
        </dl>

        <Testimonial variant="pull" />

        <p class="flag-ev">{we.modules} modules · {we.prompts} prompts · {we.assetsPerArticle} assets from every article</p>

        <div class="flag-buy">
          <p class="flag-price"><span class="e-price">{we.price}</span><span class="flag-terms">one-time, or {we.plan}</span></p>
          <div class="e-actions">
            <a class="e-btn" href={we.url}>Build my weekend site <span class="ar" aria-hidden="true">→</span></a>
            <a class="e-btn e-btn--ghost" href={we.preview}>See inside first, no email</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 03 THE MEMBERSHIP -->
  <section class="e-sec-sm e-white sec" id="membership" aria-labelledby="h-mem">
    <div class="e-wrap mem-grid">
      <div class="head">
        <p class="e-kick">03 · The membership</p>
        <h2 class="mem-h" id="h-mem">Training beside you. <em>Monthly content if you want it.</em></h2>
        <p class="note">Two tiers of one Skool community. Both open with a <span class="nw">{membership.trial}</span>.</p>
        <div class="e-actions mem-actions">
          <a class="e-btn e-btn--ghost" href="/membership">Compare Standard and Premium</a>
          <a class="e-link" href={SKOOL_PLANS}>Start my {membership.trial} <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="tiers">
        {tiers.map((x) => (
          <div class={`tier tier--${x.key}`}>
            <h3>{x.t.name}</h3>
            <p class="tier-price"><span class="e-price">{x.t.monthly}</span><span class="tier-per">/month</span> <span class="tier-alt">or {x.t.perYear}</span></p>
            <p class="tier-buys">{x.buys}</p>
            <ul class="e-list">{x.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 GUIDES -->
  <section class="e-sec sec" id="guides" aria-labelledby="h-guides">
    <div class="e-wrap">
      <div class="head">
        <p class="e-kick">04 · Guides</p>
        <h2 class="e-d3" id="h-guides">The useful stuff, <em>edited.</em></h2>
      </div>

      <div class="sub-head">
        <h3>The Value Vault</h3>
        <p class="note">Single-problem guides, each with its own price, bought à la carte. Membership Premium holds every one already unlocked, as The Premium Vault.</p>
      </div>
      <ul class="trio e-reveal">
        {vault.map((v) => (
          <li>
            <p class="trio-price"><span class="e-price">{v.price}</span> one-time</p>
            <h4>{v.name}</h4>
            <p>{v.copy}</p>
            <a class="e-link" href={v.url}>{v.go} <span class="ar" aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>

      <div class="sub-head">
        <h3>More guides and products</h3>
      </div>
      <ul class="rows">
        {guides.map((r) => (
          <li class="row">
            <div class="row-main"><h4><a href={r.url}>{r.name}</a></h4><p>{r.copy}</p></div>
            <p class="row-price"><span class="e-price">{r.price}</span><span class="row-terms">{r.terms}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 05 AI & CREATOR -->
  <section class="e-sec e-white sec" id="ai-creator" aria-labelledby="h-ai">
    <div class="e-wrap">
      <div class="head">
        <p class="e-kick">05 · AI & creator</p>
        <h2 class="e-d3" id="h-ai">Build the persona, <em>then feed her.</em></h2>
      </div>

      <div class="sub-head">
        <h3>The AI Influencer Suite</h3>
        <p class="note">Four stages of the same build, sold separately. Start at the stage you are at.</p>
      </div>
      <ol class="steps e-reveal">
        {suite.map((s) => (
          <li>
            <span class="step-n" aria-hidden="true">{s.n}</span>
            <h4><a href={s.url}>{s.name}</a></h4>
            <p>{s.copy}</p>
            <p class="step-price"><span class="e-price">{s.price}</span> one-time</p>
          </li>
        ))}
      </ol>

      <div class="sub-head">
        <h3>For creators</h3>
      </div>
      <ul class="rows">
        {creator.map((r) => (
          <li class="row">
            <div class="row-main"><h4><a href={r.url}>{r.name}</a></h4><p>{r.copy}</p></div>
            <p class="row-price"><span class="e-price">{r.price}</span><span class="row-terms">{r.terms}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 06 PRETTY & PAID PLR VAULT: its own subscription, off the membership ladder -->
  <section class="e-sec-sm e-blush sec" id="plr-vault" aria-labelledby="h-plr">
    <div class="e-wrap plr-grid">
      <div>
        <p class="e-kick">06 · Pretty &amp; Paid PLR Vault™</p>
        <h2 class="plr-h" id="h-plr">Stock your shop. <span>Skip starting from scratch.</span></h2>
        <p class="plr-lede">A stocked library of done-for-you digital products with a full PLR licence, so you can put your own name on them and sell. Twenty new products arrive every month: planners, journals, guides, printables, Pinterest and carousel templates, Reel packs. What you download stays yours, even if you cancel.</p>
        <p class="note">Its own subscription on Beacons. Not part of either membership, and not the same thing as The Value Vault.</p>
      </div>
      <div class="plr-buy">
        <p class="plr-price"><span class="e-price">$11</span><span class="row-terms">per month · Beacons</span></p>
        <a class="e-btn e-btn--ghost" href="/shop/pretty-and-paid-plr-vault">Open the PLR library</a>
      </div>
    </div>
  </section>

  <!-- 07 DONE FOR YOU -->
  <section class="e-sec-sm sec" id="done-for-you" aria-labelledby="h-dfy">
    <div class="e-wrap">
      <div class="head">
        <p class="e-kick">07 · Done for you</p>
        <h2 class="e-d3" id="h-dfy">Handed back <em>finished.</em></h2>
        <p class="note">I do the work and return it built.</p>
      </div>
      <ul class="rows">
        {dfy.map((r) => (
          <li class="row">
            <div class="row-main"><h3><a href={r.url}>{r.name}</a></h3><p>{r.copy}</p></div>
            <p class="row-price"><span class="e-price">{r.price}</span><span class="row-terms">{r.terms}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 08 RECOMMENDED: affiliate links, rel sponsored -->
  <section class="e-sec-sm e-paper sec rec" id="recommended" aria-labelledby="h-rec">
    <div class="e-wrap rec-grid">
      <div class="head">
        <p class="e-kick">08 · Recommended, not mine</p>
        <h2 class="rec-h" id="h-rec">Things Jodie recommends</h2>
      </div>
      <ul class="rows rows--quiet">
        {recommended.map((r) => (
          <li class="row">
            <div class="row-main">
              <h3><a href={r.url} rel="sponsored nofollow noopener" target="_blank">{r.name}<span class="sr"> (opens in a new tab)</span></a></h3>
              <p>{r.copy}</p>
            </div>
            <p class="row-price"><span class="e-price">{r.price}</span><span class="row-terms">{r.terms}</span></p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <p class="e-wrap outro">Not sure which door is yours? <a class="e-link" href="/resources/find-your-door">Find your door in two minutes</a></p>
</PageLayout>

<style>
  .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .sec{scroll-margin-top:96px}
  .note{font-size:15.5px;line-height:1.6;color:var(--e-ink-3);margin:0;max-width:46em}
  .e-link .ar{transition:transform .2s}
  .e-link:hover .ar{transform:translateX(3px)}

  /* MASTHEAD */
  .mast{padding:clamp(56px,8vw,112px) 0 clamp(40px,5vw,64px);border-bottom:var(--e-hair)}
  .mast-grid{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:clamp(32px,6vw,96px);align-items:end}
  .mast .e-lede{margin-bottom:0;max-width:34em}
  .mast-h{font-size:clamp(42px,5.4vw,76px);line-height:.95;letter-spacing:-.035em;margin:0 0 28px}
  .mast-h em{display:block;font-size:clamp(84px,14vw,208px);line-height:.8;letter-spacing:-.06em;margin:.04em 0 0 -.04em}
  .idx-h{font-size:11.5px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3);margin:0 0 8px}
  .idx ol{list-style:none;margin:0;padding:0;border-top:1px solid var(--e-line)}
  .idx li{border-bottom:1px solid var(--e-line)}
  .idx a{display:flex;align-items:center;gap:14px;min-height:44px;font-size:15px;font-weight:500;color:var(--e-ink);text-decoration:none}
  .idx a:hover{color:var(--e-pink-t)}
  .idx-n{font-family:var(--e-serif);font-weight:600;font-size:14px;color:var(--e-pink-t);min-width:22px}

  .head{margin-bottom:clamp(28px,4vw,44px)}
  .head .e-d3,.head .e-d2{max-width:18em}

  /* 01 FREE */
  .free{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:var(--e-hair)}
  .free li{display:flex;flex-direction:column;padding:26px 28px 8px 0}
  .free li + li{padding-left:28px;border-left:1px solid var(--e-line)}
  .free-tag{font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-pink-t);margin-bottom:12px}
  .free h3{font-size:23px;line-height:1.18;margin:0 0 10px}
  .free .sub{display:block;font-family:var(--e-sans);font-size:13px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--e-ink-3);margin-top:6px}
  .free p{font-size:15.5px;color:var(--e-ink-2);margin:0 0 10px;flex:1}

  /* 02 FLAGSHIP */
  /* The one big editorial moment: the photograph bleeds off the left edge
     and runs the full height of the room; the copy keeps the page grid. */
  .flag{padding:0;overflow:hidden}
  .flag-grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);align-items:stretch}
  .flag-fig{margin:0;display:flex;flex-direction:column;min-height:100%}
  .flag-img{position:relative;flex:1;min-height:560px;overflow:hidden;background:var(--e-ink)}
  .flag-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:64% 42%}
  .flag .flag-cap{margin:0;padding:14px var(--e-gut) 16px;color:rgba(246,239,234,.7);border-top:1px solid rgba(200,169,106,.45)}
  .flag .flag-cap b{color:var(--e-bubble);margin-right:8px}
  .flag-body{padding:clamp(72px,9vw,136px) max(var(--e-gut),calc((100vw - var(--e-w)) / 2 + var(--e-gut))) clamp(72px,9vw,136px) clamp(36px,6vw,96px);max-width:none}
  .flag-h{font-size:clamp(44px,6.6vw,96px);line-height:.95;letter-spacing:-.04em;margin:0 0 28px;color:#fff;max-width:9.5em}
