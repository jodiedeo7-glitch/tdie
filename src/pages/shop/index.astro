---
// Shop, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
// Every name, price and URL is unchanged from the canon rows below.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import "../../styles/tdie-shop.css";
import { membership, weekendEcosystem as we, SKOOL_PLANS } from "../../data/facts.js";
import Testimonial from "../../components/Testimonial.astro";
import {WYS_CTA} from "../../data/wys-live.js";
const SITE = "https://www.thedigitalincomeedit.com";

// 01 START HERE: $0 only (journey_slot_rules.free).
const free = [
  { name: "The Faceless Income Blueprint™", img: "/images/pages/blueprint-cover-desk-960.webp", url: "/resources/faceless-income-blueprint", go: "Get the Blueprint",
    copy: "Niche, first product, first traffic source: the whole shape of the business in one document." },
  // Canon name: "$10/Day Traffic Machine" + "Starter Map", set on two lines so the page carries no dash.
  { name: "$10/Day Traffic Machine", sub: "Starter Map", img: "/images/pages/starter-map-cover-480.webp", url: "/resources/starter-map", go: "Get the Starter Map",
    copy: "Ten pages on buying traffic without gambling: what to spend, what to watch, when to stop." },
  { name: "FREE GUIDE - One & Done Money Stream", url: "/go/free-guide-one-done-money-stream", go: "Read the free guide",
    copy: "One product, one system, in a short free read. Start here if you want one thing to sell, not ten." },
];

// 03 MEMBERSHIP: compact. Full comparison lives on /membership.
const tiers = [
  { key: "standard", t: membership.standard,
    buys: "Foundations, AI, branding, content and traffic training, with daily prompts and community.",
    items: ["Pinterest Foundations™, The Email Edit and The Shopify Edit", "Daily Prompts and the community", "The Value Vault guides, bought à la carte"] },
  { key: "premium", t: membership.premium,
    buys: "Standard plus offer, funnel and systems training, a written monthly content calendar and unlocked guides.",
    items: ["Everything in Standard", "The Offer Edit, The Funnel Edit, Scaling & Systems and The Ads Edit™", "The Premium Vault: every Value Vault guide, already unlocked"] },
];

// 04 GUIDES. The Value Vault: ledger-confirmed items only.
const vault = [
  { name: "Build Your First Freebie in One Afternoon", img: "/images/covers/first-freebie.webp", price: "$7", url: "/vault/freebie-in-an-afternoon", go: "Build my freebie",
    copy: "The lead magnet and the paid offer behind it, both finished before dinner." },
  { name: "The Operating Prompts™", price: "$19", url: "/go/the-operating-prompts", go: "Get The Operating Prompts™",
    copy: "The thirty-four prompts that actually run my business. Strict on purpose, built on your own Brand Card." },
  { name: "How I Batch & Schedule a Month of Pinterest in One 3-Hour Block", img: "/images/covers/pinterest-batch.webp", price: "$9", url: "/go/how-i-batch-schedule-a-month-of-pinterest-in-one-3-hour-bloc", go: "Get the batching guide",
    copy: "A month of pins queued in a single sitting. The exact order I work in." },
];

const guides = [
  { name: "Pinterest Foundations™", price: "$27", terms: "one-time · Skool course", url: "https://www.skool.com/thedigitalincomeedit/classroom/ede8aaca",
    copy: "The full Pinterest system as a course. Also included with Membership Standard; buying it outright is for people who only want this one thing." },
  { name: "The One and Done Money Stream", price: "$27", terms: "one-time", url: "/go/one-and-done-money-stream",
    copy: "One digital product, built once and sold again and again. Includes resell rights." },
  { name: "BONUS BUNDLE WITH RESELL RIGHTS", price: "$27", terms: "one-time", url: "/go/bonus-bundle-with-resell-rights",
    copy: "A bundle of ready-made products you can put your own name on and sell." },
  { name: "550+ BRILLIANT chatGPT prompts for your business", price: "$2", terms: "one-time", url: "/go/550-brilliant-chatgpt-prompts-for-your-business",
    copy: "A wide prompt library to raid when you're staring at a blank box." },
];

// 05 AI & CREATOR
const suite = [
  { n: "01", name: "AI Influencer Flash Sale", price: "$50", url: "/go/ai-influencer-flash-sale",
    copy: "The entry point into the AI influencer build." },
  { n: "02", name: "AI Influencer Starter Twin", price: "$97", url: "/go/ai-influencer-starter-twin",
    copy: "Your persona, generated to stay the same face every time." },
  { n: "03", name: "AI Influencer Brand Bundle", price: "$147", url: "/go/ai-influencer-brand-bundle",
    copy: "The persona plus the brand assets that surround her." },
  { n: "04", name: "AI Influencer Content Drop", price: "$297", url: "/go/ai-influencer-content-drop",
    copy: "A delivered content library for a persona already built." },
];

const creator = [
  { name: "150 UGC Brand Contacts", price: "$15", terms: "one-time", url: "/go/ugc-brand-contacts",
    copy: "Brands that work with UGC creators, with how to reach each one. Skip the research, start pitching." },
  { name: "Zero Income Claim Guide - 100 DFY Reels", price: "$37", terms: "one-time", url: "/go/zero-income-claim-reels",
    copy: "A hundred done-for-you hooks and captions for Reels, written for the stage before you have social proof: no screenshots, no income claims, nothing that reads as one." },
];

// 07 DONE FOR YOU
const dfy = [
  { name: "DFY Instagram Audit + Growth Optimization", price: "$197", terms: "one-time", url: "/go/dfy-instagram-audit-growth-optimization",
    copy: "A full read of the account and the specific changes that move it." },
  { name: "DFY Instagram Audit + Custom Viral Content Calendar", price: "$350", terms: "one-time", url: "/go/dfy-instagram-audit-custom-viral-content-calendar",
    copy: "The audit, plus a content calendar built for your account rather than a template." },
  { name: "#TDIE FB GROUP PROMO", price: "$10", terms: "per month · promotion slot", url: "/go/tdie-fb-group-promo",
    copy: "A recurring promotion placement inside the Facebook group." },
];

// 08 RECOMMENDED: affiliate, not owned. Prices are the owners' and can change.
const recommended = [
  { name: "Leni Loves", price: "$27", terms: "on sale, regular $37", url: "/go/leni-loves",
    copy: "Aesthetic templates and brand resources." },
  { name: "The Conversion Architect", price: "$47", terms: "one-time", url: "/go/the-conversion-architect",
    copy: "Conversion structure for offers and pages." },
  { name: "Claude Studio Kit", price: "$57", terms: "one-time", url: "/go/claude-studio-kit",
    copy: "A working setup for running Claude as a studio rather than a chat box." },
  { name: "The Faceless Launch Formula by @thebossdigitalwealth | Stan", price: "$77", terms: "one-time", url: "/go/the-faceless-launch-formula-by-thebossdigitalwealth-stan",
    copy: "A launch framework built for faceless brands." },
  { name: "Earn With Skool (SCC)", price: "$97", terms: "one-time", url: "/go/earn-with-skool-scc",
    copy: "The course I used to build this community's own Skool group." },
  { name: "The AI Subs Method", price: "$147", terms: "one-time", url: "/go/ai-subs-method",
    copy: "Growing and monetizing a faceless AI subscription channel." },
  { name: "NAVIA AI STUDIO", price: "$197", terms: "one-time", url: "/go/navia-ai-studio",
    copy: "An AI production studio setup." },
];

const index = [
  { id: "start-here", n: "01", t: "Free" },
  { id: "membership", n: "02", t: "The membership" },
  { id: "flagship", n: "03", t: "The Weekend Ecosystem™" },
  { id: "storefront", n: "04", t: "The While-You-Sleep Storefront™" },
  { id: "guides", n: "05", t: "Guides" },
  { id: "ai-creator", n: "06", t: "AI & creator" },
  { id: "plr-vault", n: "07", t: "Pretty & Paid PLR Vault™" },
  { id: "done-for-you", n: "08", t: "Done for you" },
  { id: "recommended", n: "09", t: "Recommended" },
];

// Owned products only, in page order. Affiliates are not listed as ours.
const abs = (u) => (u.startsWith("http") ? u : `${SITE}${u}`);
const owned = [
  ...free.map((f) => ({ name: f.sub ? `${f.name} ${f.sub}` : f.name, url: f.url })),
  { name: membership.standard.name, url: SKOOL_PLANS },
  { name: membership.premium.name, url: SKOOL_PLANS },
  { name: we.name, url: we.url },
  { name: "The While-You-Sleep Storefront™", url: WYS_CTA.href },
  ...vault, ...guides, ...suite, ...creator,
  { name: "Pretty & Paid PLR Vault™", url: "/shop/pretty-and-paid-plr-vault" },
  ...dfy,
];
const schema = [{
  "@type": "ItemList",
  name: "The Digital Income Edit™ shop",
  itemListElement: owned.map((p, i) => ({ "@type": "ListItem", position: i + 1, name: p.name, url: abs(p.url) })),
}];
---
<TemplateLayout title="Shop" description="The Digital Income Edit™ shop: free guides first, then the membership, then add-ons like The Weekend Ecosystem™, The While-You-Sleep Storefront™, single guides and done-for-you services." schema={schema} stickyHref={SKOOL_PLANS} stickyLabel="Start the membership free">

<section class="hh">
 <div class="wrap hh-grid sh-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Free<b class="big">guides first</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">The shop</p>
   <h1>Something to sell. Somewhere to send them. <span class="scr">Less work to repeat.</span></h1>
   <p class="what">Start with <b>the membership</b>: the training, the community and fresh material every month, free for 7 days. Everything else here is an add-on that does one job in the same business: something to sell, a website that sells it, or the repeat work taken off your plate.</p>
   <a class="btn buy" href={SKOOL_PLANS}>Start the membership free <span class="ar">→</span></a>
   <p class="see"><a href="#start-here">Or start with the free guides ↓</a></p>
  </div>
  <div class="sh-fan" aria-hidden="true">
   <img class="a" src="/images/we/hook-blog-posts.jpg" width="1200" height="1490" alt="">
   <img class="b" src="/images/brand/blueprint-cover.webp" width="900" height="1165" alt="">
  </div>
 </div>
 <nav class="wrap sh-chips" aria-label="On this page">{index.map((x) => <a href={`#${x.id}`}><span>{x.n}</span>{x.t}</a>)}</nav>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>01 · Free</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash" id="start-here">
 <div class="wrap">
  <h2 class="h2">Start with what costs <span class="scr">nothing.</span></h2>
  <div class="lead"><p>Finished guides, not teasers. No card, no trial.</p></div>
  <div class="looks sh-cards">{free.map((f, i) => <div class="look"><a class="ph" href={f.url}>{f.img ? <img src={f.img} alt={f.name} loading="lazy" decoding="async"> : <span class="sh-type">{f.name.replace(/^FREE GUIDE - /, "")}</span>}<span class="num">{String(i+1).padStart(2,'0')}</span></a><span class="tag">Free</span><h3>{f.name}{f.sub && <small>{f.sub}</small>}</h3><p class="sh-c">{f.copy}</p><a class="btn" href={f.url}>{f.go} <span class="ar">→</span></a></div>)}</div>
 </div>
</section>

<section class="sec" id="membership">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">02 · The membership · start here</p>
  <h2 class="h2">The whole package. <span class="scr">One membership.</span></h2>
  <div class="lead"><p>The full classroom, something new every day, the community, and with Premium your content written every month. Everything else in this shop is an add-on. Both tiers open with a {membership.trial}.</p></div>
  <div class="p23 sh-tiers">{tiers.map((x, i) => <div class="pc" style="position:relative">{i === 1 && <span class="stk" style="right:-50px;top:-60px">Content<b class="big">written</b></span>}<div class="hd">{x.t.name}</div><div class="bd"><div class="amt glit">{x.t.monthly}</div><p class="sh-per">per month · or {x.t.perYear}</p><p>{x.buys}</p><ul class="chk">{x.items.map((it) => <li>{it}</li>)}</ul><a class="btn buy" href={SKOOL_PLANS}>Start my {membership.trial} <span class="ar">→</span></a></div></div>)}</div>
  <p class="mb-note"><a href="/membership">Compare Standard and Premium side by side</a></p>
 </div>
</section>

<div class="band"><svg class="spk sm" style="left:20%"><use href="#sp"/></svg><h2>Add-on courses</h2><svg class="spk" style="right:20%"><use href="#sp"/></svg></div>
<section class="sec wash" id="flagship">
 <div class="wrap">
  <div class="p42 dash" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">03<b class="big">course</b></span>
   <div class="ph"><img src="/images/we/hook-blog-posts.jpg" width="1200" height="1490" loading="lazy" decoding="async" alt="The Weekend Ecosystem™: you already wrote the blog posts."></div>
   <div class="tx">
    <p class="kick">{we.name}</p>
    <h2>Your website and blog,</h2>
    <span class="scr">built in one weekend.</span>
    <p>A real site on a domain you own, built from the content you already have, with Claude doing the heavy lifting. No code, no designer, no starting from blank.</p>
    <ul class="chk"><li><span><b>Who it's for:</b> you run a Skool group, sell digital products, or have courses and calls piling up, and none of it lives on a site you own.</span></li><li><span><b>What changes:</b> your lessons become articles Google can find, your products get a home that's yours, and every future update lands in your account free.</span></li></ul>
    <p class="sh-ev">{we.modules} modules · {we.prompts} prompts · {we.assetsPerArticle} assets from every article</p>
    <p class="sh-price"><b class="glit">{we.price}</b> one-time, or {we.plan}</p>
    <a class="btn buy" href={we.url}>Build my weekend site <span class="ar">→</span></a>
    <p class="see"><a href={we.preview}>See inside first, no email</a></p>
   </div>
  </div>
  <div class="sh-rv"><Testimonial variant="pull" /></div>

  <div class="p42 dash sh-wys" style="position:relative" id="storefront">
   <span class="stk r" style="right:-44px;top:-44px">Every night<b class="big">3 looks</b></span>
   <div class="ph"><img src="/wys-sales/img/hero-storefront.jpg" loading="lazy" decoding="async" alt="Laptop showing Tommy Kate's storefront"></div>
   <div class="tx">
    <p class="kick">04 · Add-on system</p>
    <h2>The <span class="nw">While-You-Sleep</span> Storefront™</h2>
    <span class="scr">Set it up once.</span>
    <p>Each night it plans and sources one look each from Amazon, Walmart and Sam's Club, makes 15 Pinterest pins, writes 3 blog posts and posts 3 Instagram carousels.</p>
    <p class="sh-price"><b class="glit">$37</b> one payment</p>
    <a class="btn" href={WYS_CTA.href}>See the Storefront <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>

<section class="sec" id="guides">
 <div class="wrap">
  <p class="kick">05 · Guides</p>
  <h2 class="h2">The useful stuff, <span class="scr">edited.</span></h2>
  <h3 class="sh-sub">The Value Vault</h3>
  <div class="lead"><p>Single-problem guides, each with its own price, bought à la carte. Membership Premium holds every one already unlocked, as The Premium Vault.</p></div>
  <div class="looks sh-cards">{vault.map((v, i) => <div class="look"><a class="ph" href={v.url}>{v.img ? <img src={v.img} alt={v.name} loading="lazy" decoding="async"> : <span class="sh-type">{v.name}</span>}<span class="num">{String(i+1).padStart(2,'0')}</span></a><span class="tag">{v.price} one-time</span><h3>{v.name}</h3><p class="sh-c">{v.copy}</p><a class="btn" href={v.url}>{v.go} <span class="ar">→</span></a></div>)}</div>
  <h3 class="sh-sub" style="margin-top:70px">More guides and products</h3>
  <div class="faq sh-rows">{guides.map((r, i) => <a class="qa hm-link sh-row" href={r.url}><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{r.name}</h3><p>{r.copy}</p></div><span class="sh-p"><b class="glit">{r.price}</b><small>{r.terms}</small></span></a>)}</div>
 </div>
</section>

<section class="sec wash" id="ai-creator">
 <div class="wrap">
  <svg class="spk" style="left:8%;top:40px"><use href="#sp"/></svg>
  <p class="kick">06 · AI &amp; creator</p>
  <h2 class="h2">Build the persona, <span class="scr">then feed her.</span></h2>
  <h3 class="sh-sub">The AI Influencer Suite</h3>
  <div class="lead"><p>Four stages of the same build, sold separately. Start at the stage you're at.</p></div>
  <div class="p18 hm-four">{suite.map((s) => <a class="box sh-box" href={s.url}><span class="num hm-num">{s.n}</span><h3>{s.name}</h3><p>{s.copy}</p><p class="sh-price"><b class="glit">{s.price}</b> one-time</p><span class="sh-go">See it →</span></a>)}</div>
  <h3 class="sh-sub" style="margin-top:70px">For creators</h3>
  <div class="faq sh-rows">{creator.map((r, i) => <a class="qa hm-link sh-row" href={r.url}><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{r.name}</h3><p>{r.copy}</p></div><span class="sh-p"><b class="glit">{r.price}</b><small>{r.terms}</small></span></a>)}</div>
 </div>
</section>

<section class="sec" id="plr-vault">
 <div class="wrap">
  <div class="p42 dash sh-plr" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">20 new<b class="big">monthly</b></span>
   <div class="tx">
    <p class="kick">07 · Pretty &amp; Paid PLR Vault™</p>
    <h2>Stock your shop.</h2>
    <span class="scr">Skip starting from scratch.</span>
    <p>A stocked library of done-for-you digital products with a full PLR license, so you can put your own name on them and sell. Twenty new products arrive every month: planners, journals, guides, printables, Pinterest and carousel templates, Reel packs. What you download stays yours.</p>
    <p class="sh-small">Its own subscription on Beacons. Not part of either membership, and not the same thing as The Value Vault.</p>
    <p class="sh-price"><b class="glit">$11</b> per month · Beacons</p>
    <a class="btn" href="/shop/pretty-and-paid-plr-vault">Open the PLR library <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>

<div class="band"><svg class="spk" style="left:20%"><use href="#sp"/></svg><h2>08 · Done for you</h2><svg class="spk sm" style="right:20%"><use href="#sp"/></svg></div>
<section class="sec wash" id="done-for-you">
 <div class="wrap">
  <h2 class="h2">Handed back <span class="scr">finished.</span></h2>
  <div class="lead"><p>I do the work and return it built.</p></div>
  <div class="faq sh-rows">{dfy.map((r, i) => <a class="qa hm-link sh-row" href={r.url}><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{r.name}</h3><p>{r.copy}</p></div><span class="sh-p"><b class="glit">{r.price}</b><small>{r.terms}</small></span></a>)}</div>
 </div>
</section>

<section class="sec" id="recommended">
 <div class="wrap">
  <p class="kick">09 · Recommended, not mine</p>
  <h2 class="h2">Things Jodie <span class="scr">recommends.</span></h2>
  <div class="faq sh-rows">{recommended.map((r, i) => <a class="qa hm-link sh-row" href={r.url} rel="sponsored nofollow noopener" target="_blank"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{r.name}</h3><p>{r.copy}</p></div><span class="sh-p"><b class="glit">{r.price}</b><small>{r.terms}</small></span></a>)}</div>
  <p class="mb-note"><b>These are affiliate links.</b> Other people built these products, and I earn a commission if you buy through my link, at no extra cost to you.</p>
  <p class="mb-note">Not sure which door is yours? <a href="/resources/find-your-door">Take the 3-minute quiz →</a></p>
 </div>
</section>
</TemplateLayout>
