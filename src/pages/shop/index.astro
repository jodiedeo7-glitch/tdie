---
import PageLayout from "../../layouts/PageLayout.astro";

// ─────────────────────────────────────────────────────────────
// Every name, price and URL below is a Product Register v3.1 row.
// Nothing here is inferred. Ownership flags drive the affiliate
// badge and rel="sponsored" (Standing Rule 18 — link, rel and
// disclosure ship as a set).
// ─────────────────────────────────────────────────────────────

// TOP BLOCK — The Value Vault. Ledger-confirmed items only.
const vault = [
  { name: "Build Your First Freebie in One Afternoon", price: "$7", note: "one-time", url: "/vault/freebie-in-an-afternoon",
    copy: "The lead magnet and the paid offer behind it, both finished before dinner." },
  { name: "8 Claude Prompts That Save Me 12 Hours a Week", price: "$5", note: "one-time", url: "/go/8-claude-prompts-that-save-me-12-hours-a-week",
    copy: "Eight prompts I actually run every week. Paste, edit two lines, done." },
  { name: "How I Batch & Schedule a Month of Pinterest in One 3-Hour Block", price: "$9", note: "one-time", url: "/go/how-i-batch-schedule-a-month-of-pinterest-in-one-3-hour-bloc",
    copy: "A month of pins queued in a single sitting. The exact order I work in." },
];

const groups = [
  {
    id: "free",
    label: "Start Here",
    title: "Free downloads",
    note: "Finished guides, not teasers. No card, no trial.",
    items: [
      { name: "The Faceless Income Blueprint\u2122", price: "$0", note: "free", url: "/resources/faceless-income-blueprint", aff: false,
        copy: "Niche, first product, first traffic source \u2014 the whole shape of the business in one document." },
      { name: "The $10/Day Traffic Machine \u2014 Starter Map", price: "$0", note: "free", url: "/resources/starter-map", aff: false,
        copy: "Ten pages on buying traffic without gambling: what to spend, what to watch, when to stop." },
      { name: "FREE GUIDE \u2014 One & Done Money Stream", price: "$0", note: "free", url: "/go/free-guide-one-done-money-stream", aff: false,
        copy: "The short version of the one-product, one-system approach." },
    ],
  },
  {
    id: "recurring",
    label: "Billed Monthly",
    title: "Memberships & subscriptions",
    note: "Three separate doors. Only two of them are rungs on the same ladder.",
    items: [
      { name: "Membership Standard", price: "$9", note: "per month \u00b7 Skool", url: "https://www.skool.com/thedigitalincomeedit/plans", aff: false,
        copy: "The full build curriculum \u2014 the start-here trainings, your AI twin, offer, content, email and Pinterest. Free for 7 days." },
      { name: "Membership Premium", price: "$27", note: "per month \u00b7 Skool", url: "https://www.skool.com/thedigitalincomeedit/plans", aff: false,
        copy: "Everything in Standard, plus The Ads Edit\u2122, the monthly done-for-you content calendar, Scaling & Systems, and the Premium Vault \u2014 the entire Value Vault unlocked." },
      { name: "Pretty & Paid PLR Vault\u2122", price: "$11", note: "per month \u00b7 Beacons", url: "/shop/pretty-and-paid-plr-vault", aff: false,
        copy: "Rebrandable products you resell as your own, refreshed monthly. Its own subscription, not part of any membership \u2014 and not the same thing as The Value Vault below." },
      { name: "#TDIE FB GROUP PROMO", price: "$10", note: "per month \u00b7 promotion slot", url: "/go/tdie-fb-group-promo", aff: false,
        copy: "A recurring promotion placement inside the Facebook group." },
    ],
  },
  {
    id: "courses",
    label: "Courses",
    title: "Delivered inside Skool",
    note: "Bought once, opened inside the classroom.",
    items: [
      { name: "Pinterest Foundations\u2122", price: "$27", note: "one-time \u00b7 Skool", url: "https://www.skool.com/thedigitalincomeedit/classroom/ede8aaca?md=63eb80fb5d114f77870c962337a58a1b", aff: false,
        copy: "The full Pinterest system as a course. Also included with Membership Standard \u2014 buying it outright is for people who only want this one thing." },
    ],
  },
  {
    id: "products",
    label: "One-Time",
    title: "Products & guides",
    note: "Buy it, use it that week, never think about it again.",
    items: [
            { name: "550+ BRILLIANT chatGPT prompts for your business", price: "$2", note: "one-time", url: "/go/550-brilliant-chatgpt-prompts-for-your-business", aff: false,
        copy: "A wide prompt library to raid when you are staring at a blank box." },
      { name: "150 UGC Brand Contacts", price: "$15", note: "one-time", url: "/go/ugc-brand-contacts", aff: false,
        copy: "Brands actively paying creators, with the contact route. Skip the research, start pitching." },
      { name: "The Tommy Kate Edit", price: "$17", note: "one-time \u00b7 lifetime access", url: "/go/the-tommy-kate-edit", aff: false,
        copy: "The AI prompt bank behind a consistent faceless persona. Lifetime updates. Also included with Premium." },
      { name: "The One and Done Money Stream", price: "$27", note: "one-time", url: "/go/one-and-done-money-stream", aff: false,
        copy: "One digital income stream, built once, set to earn on repeat. Includes resell rights." },
      { name: "BONUS BUNDLE WITH RESELL RIGHTS", price: "$27", note: "one-time", url: "/go/bonus-bundle-with-resell-rights", aff: false,
        copy: "A bundle of ready-made products you can rebrand and sell as your own." },
      { name: "Zero Income Claim Guide \u2014 100 DFY Reels", price: "$37", note: "one-time", url: "/go/zero-income-claim-reels", aff: false,
        copy: "A hundred done-for-you hooks and captions for Reels that sell nothing you have not earned yet \u2014 no screenshots, no income claims, nothing that gets an account flagged. Written for the stage before you have social proof." },
    ],
  },
  {
    id: "ai-influencer",
    label: "The AI Influencer Suite",
    title: "Build the persona, then feed her",
    note: "Four steps of the same build, sold separately.",
    items: [
      { name: "AI Influencer Flash Sale", price: "$50", note: "one-time", url: "/go/ai-influencer-flash-sale", aff: false,
        copy: "The entry point into the AI influencer build." },
      { name: "AI Influencer Starter Twin", price: "$97", note: "one-time", url: "/go/ai-influencer-starter-twin", aff: false,
        copy: "Your persona, generated to stay the same face every time." },
      { name: "AI Influencer Brand Bundle", price: "$147", note: "one-time", url: "/go/ai-influencer-brand-bundle", aff: false,
        copy: "The persona plus the brand assets that surround her." },
      { name: "AI Influencer Content Drop", price: "$297", note: "one-time", url: "/go/ai-influencer-content-drop", aff: false,
        copy: "A delivered content library for a persona already built." },
    ],
  },
  {
    id: "dfy",
    label: "Done For You",
    title: "Services",
    note: "I do the work and hand it back finished.",
    items: [
      { name: "DFY Instagram Audit + Growth Optimization", price: "$197", note: "one-time", url: "/go/dfy-instagram-audit-growth-optimization", aff: false,
        copy: "A full read of the account and the specific changes that move it." },
      { name: "DFY Instagram Audit + Custom Viral Content Calendar", price: "$350", note: "one-time", url: "/go/dfy-instagram-audit-custom-viral-content-calendar", aff: false,
        copy: "The audit, plus a content calendar built for your account rather than a template." },
    ],
  },
  {
    id: "affiliate",
    label: "Not Mine",
    title: "Recommended, not made here",
    note: "Products I use and rate, built by other people. Prices are theirs and can change without notice.",
    items: [
      { name: "Leni Loves", price: "$37", note: "one-time", url: "/go/leni-loves", aff: true,
        copy: "Aesthetic templates and brand resources." },
      { name: "The Conversion Architect", price: "$47", note: "one-time", url: "/go/the-conversion-architect", aff: true,
        copy: "Conversion structure for offers and pages." },
      { name: "Claude Studio Kit", price: "$57", note: "one-time", url: "/go/claude-studio-kit", aff: true,
        copy: "A working setup for running Claude as a studio rather than a chat box." },
      { name: "The Faceless Launch Formula by @thebossdigitalwealth | Stan", price: "$77", note: "one-time", url: "/go/the-faceless-launch-formula-by-thebossdigitalwealth-stan", aff: true,
        copy: "A launch framework built for faceless brands." },
      { name: "Earn With Skool (SCC)", price: "$97", note: "one-time", url: "/go/earn-with-skool-scc", aff: true,
        copy: "Building and earning from a Skool community." },
      { name: "The AI Subs Method", price: "$147", note: "one-time", url: "/go/ai-subs-method", aff: true,
        copy: "Growing and monetising a faceless AI subscription channel." },
      { name: "NAVIA AI STUDIO", price: "$197", note: "one-time", url: "/go/navia-ai-studio", aff: true,
        copy: "An AI production studio setup." },
    ],
  },
];
---
<PageLayout
  wide={true}
  title="Shop"
  description="Every live product from The Digital Income Edit™ — the Value Vault, memberships, one-time guides, the AI Influencer suite, done-for-you services, and recommended tools."
>
  <div class="page-eyebrow">Shop</div>
  <h1>Everything, in one place</h1>
  <p class="lede">Nothing here is a course you will not finish. Short, specific, and built to remove the next bottleneck rather than add to your pile.</p>

  <!-- ── THE VALUE VAULT ─────────────────────────────────── -->
  <!-- ── FLAGSHIP ─────────────────────────────────────────── -->
  <a class="flag" href="/shop/weekend-ecosystem">
    <div class="flag-img">
      <img src="/images/we/cover-sofa.jpg" alt="The Weekend Ecosystem — your website and blog, built from what you already have." loading="eager" width="1200" height="1490" />
    </div>
    <div class="flag-body">
      <span class="flag-k">The flagship · Standalone</span>
      <h2 class="flag-h">The Weekend <em>Ecosystem™</em></h2>
      <p class="flag-sub">Your website + blog, built from what you already have. One weekend with Claude, and you're a business owner — not just a product seller.</p>
      <div class="flag-stats">
        <span><b>22</b>modules</span>
        <span><b>36</b>prompts</span>
        <span><b>3</b>vaults</span>
        <span><b>24</b>assets per article</span>
      </div>
      <ul class="flag-list">
        <li>A real site on a domain you own — no code, no designer</li>
        <li>Your Skool lessons become articles Google can find</li>
        <li>Every future update included, permanently</li>
      </ul>
      <div class="flag-foot">
        <span class="flag-price">$97<em>one-time</em></span>
        <span class="flag-go">See what's inside →</span>
      </div>
    </div>
  </a>

  <section class="vault">
    <div class="vault-head">
      <div class="vault-k">The Value Vault</div>
      <div class="vault-script">Value Vault</div>
      <p class="vault-sub">Single-problem guides, priced like a coffee. Buy the one you need this week — or open all of them at once inside Premium, where the whole collection unlocks as the Premium Vault.</p>
    </div>
    <div class="vault-grid">
      {vault.map((v) => (
        <a class="vcard" href={v.url}>
          <div class="vprice">{v.price}</div>
          <div class="vnote">{v.note}</div>
          <h3>{v.name}</h3>
          <p>{v.copy}</p>
          <span class="vgo">Get the guide →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- ── READING THE PRICES ──────────────────────────────── -->
  <div class="prices-note">
    <strong>Two numbers repeat on this page, so here is what each one buys.</strong>
    <span><b>$9</b> is either Membership Standard, which bills every month after a free 7-day trial, or the Pinterest batching guide, which is a one-time download. <b>$27</b> is either Membership Premium, which bills every month, or one of three one-time purchases — Pinterest Foundations™, The One and Done Money Stream, or the Bonus Bundle. Recurring items are labelled <em>per month</em>. Everything else is paid once. <b>$11</b> is Pretty &amp; Paid PLR Vault™, its own Beacons subscription — it lands two dollars from Membership Standard by coincidence, not because one upgrades into the other.</span>
  </div>

  <!-- ── CATEGORIES ──────────────────────────────────────── -->
  {groups.map((g) => (
    <section class="grp" id={g.id}>
      <div class="grp-head">
        <div class="grp-k">{g.label}</div>
        <h2>{g.title}</h2>
        <p class="grp-note">{g.note}</p>
      </div>
      <div class="rows">
        {g.items.map((it) => (
          <a class="row" href={it.url} rel={it.aff ? "sponsored nofollow" : null} target={it.aff ? "_blank" : null}>
            <span class="r-main">
              <span class="r-name">{it.name}{it.aff && <span class="r-aff">Affiliate</span>}</span>
              <span class="r-copy">{it.copy}</span>
            </span>
            <span class="r-price">{it.price}<em>{it.note}</em></span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <p class="disclose">
    Products marked <strong>Affiliate</strong> are not mine. I recommend them because I use them, and I earn a commission if you buy — at no extra cost to you. Their owners set those prices and can change them without telling me.
  </p>

  <p class="back"><a href="/learn">← Back to The Library</a></p>
</PageLayout>

<style>
  /* ---------- FLAGSHIP ---------- */
  /* Paper, not gradient. The 2px pink top rule is the house card pattern
     already used by .toc .plate and .rail-card in global.css. */
  .flag{display:grid;grid-template-columns:300px 1fr;align-items:stretch;gap:0;margin:0 0 56px;
        border-radius:2px;overflow:hidden;text-decoration:none;color:inherit;
        background:var(--white);
        border:1px solid var(--gray);border-top:2px solid var(--pink);
        transition:border-color .35s var(--ease),box-shadow .35s var(--ease)}
  .flag:hover{border-color:rgba(214,46,115,.4);border-top-color:var(--pink);
              box-shadow:0 18px 44px -30px rgba(43,22,27,.35)}
  .flag-img{overflow:hidden;background:var(--cream-deep);display:flex;align-items:center}
  .flag-img img{width:100%;height:100%;object-fit:cover;display:block}
  .flag-body{padding:38px 40px 34px}
  .flag-k{display:block;font-size:11px;font-weight:500;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:16px}
  .flag-h{font-family:var(--display);font-weight:300;font-size:clamp(28px,3.6vw,42px);line-height:1.04;
          letter-spacing:-1.2px;margin:0 0 14px;color:var(--choc)}
  .flag-h em{font-style:italic;color:var(--pink)}
  .flag-sub{font-size:16.5px;line-height:1.7;color:var(--choc-soft);margin:0 0 24px;max-width:52ch}
  .flag-stats{display:flex;gap:30px;flex-wrap:wrap;padding:18px 0;margin-bottom:22px;
              border-top:1px solid var(--gray);border-bottom:1px solid var(--gray)}
  .flag-stats span{display:flex;align-items:baseline;gap:7px;font-size:11px;letter-spacing:2px;
                   text-transform:uppercase;color:var(--taupe-deep)}
  .flag-stats b{font-family:var(--display);font-size:26px;font-weight:300;color:var(--choc);letter-spacing:-1px}
  .flag-list{list-style:none;padding:0;margin:0 0 26px}
  .flag-list li{position:relative;padding:6px 0 6px 22px;font-size:15.5px;line-height:1.6;color:var(--choc-soft)}
  .flag-list li:before{content:"";position:absolute;left:0;top:14px;width:5px;height:5px;
                       background:var(--gold-deep);transform:rotate(45deg)}
  .flag-foot{display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
  .flag-price{font-family:var(--display);font-size:34px;font-weight:300;color:var(--choc);letter-spacing:-1px}
  .flag-price em{font-style:normal;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--taupe-deep);margin-left:9px}
  .flag-go{font-size:11px;letter-spacing:2.2px;text-transform:uppercase;color:var(--cream);background:var(--choc);
           padding:15px 30px;border-radius:2px;white-space:nowrap;
           transition:background .35s var(--ease)}
  .flag:hover .flag-go{background:var(--pink)}
  @media(max-width:860px){
    .flag{grid-template-columns:1fr}
    .flag-img{aspect-ratio:16/10}
    .flag-body{padding:28px 22px 26px}
    .flag-stats{gap:20px}
    .flag-foot{flex-direction:column;align-items:stretch;gap:16px}
    .flag-go{text-align:center}
  }

  /* ---------- VALUE VAULT ---------- */
  /* Was a full pink gradient panel. Now paper inside a gold hairline frame —
     the section reads as a plate, not a highlight box. */
  .vault{
    margin:56px 0 0;padding:54px 44px 50px;border-radius:2px;
    background:var(--white);
    border:1px solid rgba(200,169,106,.42);
  }
  .vault-head{text-align:center;max-width:52ch;margin:0 auto 40px}
  .vault-k{font-size:11px;font-weight:500;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:14px}
  .vault-script{
    font-family:var(--display);font-style:italic;font-weight:300;
    font-size:clamp(40px,6vw,64px);line-height:1.02;letter-spacing:-1.5px;
    color:var(--choc);margin-bottom:10px;
  }
  .vault-sub{
    font-family:var(--serif);font-style:italic;font-size:20px;line-height:1.55;
    color:var(--taupe-deep);margin:0;
  }
  .vault-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--gray);border:1px solid var(--gray)}
  @media(max-width:860px){.vault-grid{grid-template-columns:1fr}.vault{padding:40px 22px 36px}}
  .vcard{
    display:flex;flex-direction:column;background:var(--white);
    padding:28px 26px 26px;
    transition:background .35s var(--ease);
  }
  .vcard:hover{background:var(--cream)}
  .vprice{font-family:var(--display);font-weight:300;font-size:30px;line-height:1;color:var(--choc);letter-spacing:-1px}
  .vnote{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--taupe-deep);margin:8px 0 16px}
  .vcard h3{font-family:var(--display);font-weight:400;font-size:20px;line-height:1.22;margin:0 0 10px}
  .vcard p{font-size:14.5px;line-height:1.6;color:var(--choc-soft);margin:0 0 20px;flex:1}
  .vgo{font-size:10.5px;font-weight:500;letter-spacing:2px;text-transform:uppercase;color:var(--pink)}

  /* ---------- PRICE NOTE ---------- */
  .prices-note{
    margin:44px 0 0;padding:22px 26px;border-left:2px solid var(--gold);
    background:rgba(200,169,106,.07);border-radius:0 2px 2px 0;
  }
  .prices-note strong{display:block;font-size:14px;margin-bottom:8px}
  .prices-note span{display:block;font-size:14px;line-height:1.75;color:var(--choc-soft)}

  /* ---------- CATEGORY GROUPS ---------- */
  .grp{margin-top:78px}
  .grp-head{margin-bottom:26px}
  .grp-k{font-size:11px;font-weight:500;letter-spacing:2.8px;text-transform:uppercase;color:var(--gold-deep);margin-bottom:10px}
  .grp-head h2{font-family:var(--display);font-weight:300;font-size:clamp(27px,3.6vw,38px);line-height:1.08;letter-spacing:-.4px;margin:0 0 10px}
  .grp-note{font-family:var(--serif);font-style:italic;font-size:18px;line-height:1.5;color:var(--taupe-deep);margin:0;max-width:56ch}

  .rows{border-top:1px solid var(--gray)}
  a.row{
    display:grid;grid-template-columns:1fr auto;gap:26px;align-items:start;
    padding:24px 8px;border-bottom:1px solid var(--gray);
    transition:padding-left .4s var(--ease),background .4s var(--ease);
  }
  a.row:hover{padding-left:16px;background:var(--cream-deep)}
  .r-name{display:block;font-family:var(--display);font-size:21px;line-height:1.25}
  .r-copy{display:block;font-size:14.5px;line-height:1.6;color:var(--taupe-deep);margin-top:6px;max-width:62ch}
  .r-aff{
    display:inline-block;margin-left:10px;vertical-align:middle;font-family:var(--sans);
    font-size:9.5px;font-weight:500;letter-spacing:1.8px;text-transform:uppercase;color:var(--gold-deep);
    border:1px solid rgba(200,169,106,.6);border-radius:2px;padding:3px 9px;
  }
  .r-price{
    text-align:right;white-space:nowrap;font-family:var(--display);font-weight:300;font-size:25px;color:var(--choc);line-height:1.1;letter-spacing:-.5px;
  }
  .r-price em{
    display:block;font-family:var(--sans);font-style:normal;font-size:10px;letter-spacing:1.8px;
    text-transform:uppercase;color:var(--taupe-deep);margin-top:6px;
  }
  @media(max-width:620px){
    a.row{grid-template-columns:1fr;gap:12px}
    .r-price{text-align:left}
  }

  .disclose{margin-top:56px;font-size:14px;line-height:1.75;color:var(--taupe-deep)}
  .back{margin-top:44px}
  .back a{color:var(--pink);font-weight:500}
</style>
