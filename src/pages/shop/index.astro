    </a>
    <a href="https://links.thedigitalincomeedit.com/shop/02d1799d-a588-438f-a9a5-7313e39bb8a0" style="display:flex;justify-content:space-between;align-items:baseline;padding:26px 0;border-bottom:1px solid var(--gray);text-decoration:none;color:inherit">
      <span style="font-family:'Fraunces',serif;font-size:22px">8 Claude Prompts That Save Me 12 Hours a Week</span>
      <span style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--taupe-deep)">$5 one-time</span>
    </a>
    <a href="https://links.thedigitalincomeedit.com/shop/8e31e02b-cc67-4217-ba21-139fb88584aa" style="display:flex;justify-content:space-between;align-items:baseline;padding:26px 0;border-bottom:1px solid var(--gray);text-decoration:none;color:inherit">
