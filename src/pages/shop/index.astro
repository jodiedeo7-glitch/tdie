      <span style="font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--taupe-deep)">$9 one-time</span>
    </a>
  </div>

  <p style="margin-top:60px"><a href="/learn" style="color:var(--pink);font-weight:500">← Back to The Library</a></p>
</PageLayout>
