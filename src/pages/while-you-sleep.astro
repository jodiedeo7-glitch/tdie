---
// WYS landing page: PRIVATE PREVIEW (8 Oct 2026). noindex, linked from nowhere; the
// customer release hold still stands. Photos live in src/assets/wys-private (git-ignored,
// master file section 9), so this page only builds where those photos exist.
// Purpose: build desire, explain the documented offer, send people to the waitlist.
import PageLayout from "../layouts/PageLayout.astro";
import { Image } from "astro:assets";
import "../styles/wys.css";
import { INSIDE, WAITLIST_PAGE, PRESALE_LINE, PHOTOS, CLOTHING, DECOR_A, OUTPUTS, PATHS, LIMITS } from "../data/wys-landing.js";
const { clLife, clBasic, clStyled, pwLife, pwBasic } = PHOTOS;
---
<PageLayout wide noindex ogImage={clLife.src}
  title="The While-You-Sleep Storefront™ · A storefront built around your taste"
  description="Amazon picks turned into styled photographs, Pinterest pins, Instagram slides and a shop-the-look page. Member presale Sunday, October 11.">
<div class="wy">

  <section class="wy-hero" aria-labelledby="hero-h">
    <div class="wy-hero-copy">
      <p class="wy-badge"><span class="wy-pearl" aria-hidden="true"></span>{PRESALE_LINE}</p>
      <p class="wy-hero-intro">Introducing</p>
      <h1 class="wy-h1" id="hero-h"><span class="wy-hero-name">The While-You-Sleep Storefront™<span class="wy-spark" aria-hidden="true"></span></span></h1>
      <p class="wy-hero-tag">A storefront built around your taste.</p>
      <p class="wy-lede">You pick the vibe and the Amazon products. Each look comes back as styled photographs, Pinterest pins, Instagram slides and a page people can shop.</p>
      <div class="wy-btns">
        <a class="wy-btn wy-btn-hot" href={WAITLIST_PAGE}>Join the Waitlist <span aria-hidden="true">→</span></a>
        <a class="wy-btn wy-btn-pearl" href={INSIDE}>Look Inside <span aria-hidden="true">→</span></a>
      </div>
      <p class="wy-small">Presale is for members of The Digital Income Edit™ community on Skool. The full launch follows next week.</p>
    </div>
    <div class="wy-hero-art">
      <div class="wy-hero-glow" aria-hidden="true"></div>
      <figure class="wy-hero-main wy-chrome">
        <Image src={clLife} alt={CLOTHING.shots[2].alt} widths={[420, 640, 900]} sizes="(max-width: 960px) 80vw, 460px" loading="eager" />
      </figure>
      <figure class="wy-hero-flat wy-polaroid">
        <span class="wy-pin" aria-hidden="true"></span>
        <Image src={clBasic} alt={CLOTHING.shots[0].alt} widths={[220, 320, 440]} sizes="(max-width: 960px) 40vw, 220px" loading="eager" />
        <figcaption>The picks</figcaption>
      </figure>
      <p class="wy-note" aria-hidden="true">
        the picks
        <svg viewBox="0 0 74 46"><path d="M4 6 C 26 4, 48 14, 62 36"/><path d="M52 34 L63 38 L64 26"/></svg>
      </p>
    </div>
  </section>

  <section class="wy-band wy-bleed" aria-labelledby="band-h">
    <div class="wy-band-in">
      <div class="wy-fan" aria-label="The Off Duty look: basic, styled and lifestyle">
        <figure class="wy-polaroid"><Image src={clBasic} alt={CLOTHING.shots[0].alt} widths={[240, 360, 480]} sizes="(max-width: 960px) 46vw, 250px" /><figcaption>01 · Basic</figcaption></figure>
        <figure class="wy-polaroid"><Image src={clStyled} alt={CLOTHING.shots[1].alt} widths={[240, 360, 480]} sizes="(max-width: 960px) 46vw, 250px" /><figcaption>02 · Styled</figcaption></figure>
        <figure class="wy-polaroid"><Image src={clLife} alt={CLOTHING.shots[2].alt} widths={[240, 360, 480]} sizes="(max-width: 960px) 46vw, 250px" /><figcaption>03 · Lifestyle</figcaption></figure>
      </div>
      <div>
        <p class="wy-kicker">One look in</p>
        <h2 class="wy-h2" id="band-h">A whole storefront post out.</h2>
        <p class="wy-lede">Not three pretty pictures and a shrug. Every look is finished for the places people shop.</p>
        <ol class="wy-ledger">
          {OUTPUTS.map((o) => (<li><span class="n">{o.n}</span><div><b>{o.t}</b><span>{o.p}</span></div></li>))}
        </ol>
      </div>
    </div>
  </section>

  <section class="wy-sec wy-split" aria-labelledby="cat-h">
    <div class="wy-split-art">
      <figure class="wy-split-main wy-chrome">
        <Image src={pwLife} alt={DECOR_A.shots[2].alt} widths={[420, 640, 900]} sizes="(max-width: 960px) 92vw, 540px" />
      </figure>
      <figure class="wy-split-inset wy-polaroid">
        <span class="wy-pin" aria-hidden="true"></span>
        <Image src={pwBasic} alt={DECOR_A.shots[0].alt} widths={[200, 300, 400]} sizes="(max-width: 960px) 38vw, 200px" />
        <figcaption>The picks</figcaption>
      </figure>
    </div>
    <div>
      <p class="wy-kicker">Built for what you sell</p>
      <h2 class="wy-h2" id="cat-h">An outfit gets worn. A room gets lived in.</h2>
      <p class="wy-lede">Each category has its own recipe, so a hallway never gets treated like a pair of jeans.</p>
      <ul class="wy-roles">
        <li><b>Basic</b><span>The picks, laid out flat.<i>Outfit flat lay, or a curated object flat lay.</i></span></li>
        <li><b>Styled</b><span>The look, finished.<i>A fuller getting-ready flat lay, or the products in their room.</i></span></li>
        <li><b>Lifestyle</b><span>The look, lived.<i>Worn in her world, or a moment in the space.</i></span></li>
      </ul>
      <p class="wy-small" style="margin-top:16px">Shown: Pretty Wicked, the Halloween entryway. Styling illustrations; product shapes are approximate.</p>
    </div>
  </section>

  <section class="wy-sec" aria-labelledby="routes-h">
    <p class="wy-kicker">Three routes, one finish line</p>
    <h2 class="wy-h2" id="routes-h" style="margin-top:12px">Run it the way your budget likes.</h2>
    <div class="wy-rail">
      {PATHS.map((p) => (<div class="wy-route"><h3>{p.t}</h3><p>{p.p}</p></div>))}
    </div>
  </section>

  <section class="wy-sec wy-honest" aria-labelledby="honest-h">
    <h3 id="honest-h">Good to know</h3>
    <ul>{LIMITS.map((l) => (<li>{l}</li>))}</ul>
  </section>

  <section class="wy-close wy-on-pink" aria-labelledby="close-h">
    <div>
      <p class="wy-badge"><span class="wy-pearl" aria-hidden="true"></span>{PRESALE_LINE}</p>
      <h2 class="wy-h2" id="close-h">Get the presale link the second it opens.</h2>
      <p>Join the waitlist, or take the full tour first.</p>
    </div>
    <div class="wy-btns">
      <a class="wy-btn wy-btn-hot" href={WAITLIST_PAGE}>Join the Waitlist <span aria-hidden="true">→</span></a>
      <a class="wy-btn wy-btn-pearl" href={INSIDE}>Look Inside <span aria-hidden="true">→</span></a>
    </div>
  </section>

</div>
</PageLayout>
