---
import PageLayout from "../layouts/PageLayout.astro";
import { library, community, weekendEcosystem, cap } from "../data/facts.js";
import { FEATURED } from "../we-reviews.js";
import "../styles/edit.css";

const SITE = "https://www.thedigitalincomeedit.com";

// What I learned. Founder lessons, stated once each, no villain required.
const lessons = [
  {
    t: "The offer decides everything downstream.",
    p: "A page, an email, a pin: each one is only as clear as the sentence it is selling. So the sentence comes first, before a single post exists.",
  },
  {
    t: "Reach is rented. Architecture is owned.",
    p: "Traffic arrives and leaves on someone else's schedule. A funnel on a domain you own keeps working on the Tuesday you skip.",
  },
  {
    t: "Faceless is not the same as hidden.",
    p: "My real face is never required. The brand's face is an AI persona, and the business behind her is real, built and running.",
  },
  {
    t: "The channels are rooms, not the house.",
    p: "Pinterest, blogging, email and automation each have a place inside one build. None of them is the headline, and none of them is the whole business.",
  },
];

// Why the order matters: the method in four rooms.
const order = [
  { n: "01", name: "Offer", p: "What you sell, who pays for it and what it costs them. Decided on paper, first." },
  { n: "02", name: "Funnel", p: "The road a stranger walks from a free thing to a paid one: the page, the emails, the ask." },
  { n: "03", name: "Automation", p: `AI and schedules take the repeat work. One article becomes ${weekendEcosystem.assetsPerArticle} finished assets.` },
  { n: "04", name: "Audience", p: "Only now does the traffic switch on, pointed at a house that already knows what to do with a visitor." },
];

// What you can inspect. Every row is a live page on this site.
const inspect = [
  { room: "The library", t: "Every guide started as a lesson", p: `${cap(library.guidesWord)} step-by-step guides and ${library.articles} quick reads, each one a Skool lesson first, turned into a page by the method it teaches.`, href: "/learn", go: "Open the Library" },
  { room: "The course", t: "The Weekend Ecosystem™, from the inside", p: `${weekendEcosystem.modules} modules, delivered as a live website on the very kind of site it teaches you to build. No email needed to look.`, href: weekendEcosystem.preview, go: "Take the free look inside" },
  { room: "The offer", t: "The One-Sentence Offer tool", p: "Step one of the method, as a free tool. Type your offer as you say it now and watch it get checked. No email.", href: "/resources/one-sentence-offer", go: "Test your offer" },
  { room: "The funnel", t: "The Weekend Build Challenge", p: "Five free days by email that walk a stranger, in order, from a model to an offer to a way to be found.", href: "/resources/weekend-build-challenge", go: "Inspect the five days" },
  { room: "The email", t: "The Weekly Edit, every Sunday", p: "Written once a week and delivered by the automation underneath this site.", href: "/newsletter", go: "Read the letter" },
  { room: "The classroom", t: "The community behind it all", p: `Where women build the same business, lesson by lesson, beside each other.`, href: "/membership#room", go: "See the classroom" },
];

const schema = [
  {
    "@type": "Person",
    "@id": `${SITE}/about#founder`,
    name: "Jodie",
    jobTitle: "Founder",
    worksFor: { "@id": `${SITE}/#org` },
    url: `${SITE}/about`,
  },
];
---
<PageLayout
  bare
  title="About"
  description="How Jodie built The Digital Income Edit™ backwards with AI: offer first, funnel second, automation third, audience last. Walk through every room."
  schema={schema}
>
  <!-- HERO: the founder line, the founder's world -->
  <section class="ab-hero" aria-labelledby="ab-h1">
    <div class="e-wrap ab-hero-grid">
      <div class="ab-hero-copy e-rise">
        <p class="e-kick">About the founder</p>
        <h1 id="ab-h1" class="ab-h1">I didn't build an audience and then work out <em>what to sell them.</em></h1>
        <p class="e-lede">I built the business first. The offer, then the funnel, then the automation, and only then the audience, with AI doing the heavy construction and me making every decision. This site is what came out of it, and every room is open.</p>
        <p class="ab-byline">Jodie, founder of The Digital Income Edit™</p>
      </div>
      <figure class="ab-hero-fig e-rise e-rise-2">
        <div class="ab-hero-img e-figure">
        <img
          src="/images/pages/about-porch-red-barn-840.webp"
          srcset="/images/pages/about-porch-red-barn-560.webp 560w, /images/pages/about-porch-red-barn-840.webp 840w, /images/pages/about-porch-red-barn-1120.webp 1120w"
          sizes="(max-width: 820px) 92vw, 520px"
          width="840" height="1042" fetchpriority="high" decoding="async"
          alt="The brand's AI persona on a weathered farmhouse porch at golden hour, in a cream knit sweater and wool socks, holding a pink mug, with a red barn and open pasture behind her." />
        </div>
        <figcaption class="e-credit ab-credit"><b>Tommy Kate</b> The brand's AI persona, photographed in her world. My face is never required.</figcaption>
      </figure>
    </div>
  </section>

  <!-- HOW I BUILT IT -->
  <section class="e-sec e-white" aria-labelledby="ab-built">
    <div class="e-wrap ab-split">
      <div>
        <p class="e-kick">How I built it</p>
        <h2 id="ab-built" class="ab-built-h"><span class="e-giant ab-giant">Backwards,</span> <span class="ab-built-sub"><em>on purpose.</em></span></h2>
      </div>
      <div class="ab-prose">
        <p class="ab-first">I started with no audience and nothing to post. So I started where every other decision gets made: what I would sell, who it was for and what it would cost her.</p>
        <p>Then I built the road a stranger walks from a free guide to a paid one. Then I handed the repeat work to AI and to schedules, so the emails send themselves and one article becomes {weekendEcosystem.assetsPerArticle} finished assets. Only after all of that did I turn on traffic.</p>
        <p>I did it faceless and I did it solo. AI was the build team; I was the architect. The site you are reading, the classroom behind it and the emails that land if you join all came off that one method.</p>
      </div>
    </div>
  </section>

  <!-- WHAT I LEARNED -->
  <section class="e-sec" aria-labelledby="ab-learned">
    <div class="e-wrap">
      <div class="ab-head">
        <p class="e-kick">What I learned</p>
        <h2 id="ab-learned" class="e-d2">Four things the build <em>taught me.</em></h2>
      </div>
      <ol class="ab-lessons">
        {lessons.map((l, i) => (
          <li class={i === 0 ? "ab-lead" : "e-reveal"}>
            <span class="ab-lnum e-num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="ab-lt">{l.t}</h3>
              <p>{l.p}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- THE IMAGE MOMENT: full bleed, nothing over it -->
  <figure class="ab-bleed">
    <div class="ab-bleed-img e-unveil">
    <img
      src="/images/pages/about-office-desk-wide-1600.webp"
      srcset="/images/pages/about-office-desk-wide-960.webp 960w, /images/pages/about-office-desk-wide-1600.webp 1600w, /images/pages/about-office-desk-wide-2400.webp 2400w"
      sizes="100vw" width="1600" height="1073" loading="lazy" decoding="async"
      alt="A woman seen from behind at a walnut desk in a sunlit cream study, typing on a laptop beside an open notebook, a brass lamp and white flowers on the built-in shelves." />
    </div>
    <figcaption class="e-wrap e-credit ab-bleed-cap"><b>The TDIE studio</b> The room where the building happens. A desk, a window and one decision at a time.</figcaption>
  </figure>

  <!-- WHY THE ORDER MATTERS -->
  <section class="e-sec e-paper" aria-labelledby="ab-order">
    <div class="e-wrap">
      <p class="e-kick">Why the order matters</p>
      <h2 id="ab-order" class="ab-order-h">Offer first, funnel second, automation third, <em>audience last.</em></h2>
      <ol class="ab-order">
        {order.map((o) => (
          <li>
            <span class="ab-on" aria-hidden="true">{o.n}</span>
            <h3>{o.name}</h3>
            <p>{o.p}</p>
          </li>
        ))}
      </ol>
      <div class="ab-order-foot">
        <p>Build the rooms in that order and the audience walks into a house that is already finished. That is the whole reason for going backwards.</p>
        <p class="ab-tagline">Build Your Business Backwards. Scale It Forward.™</p>
      </div>
    </div>
  </section>

  <!-- PULL STATEMENT -->
  <section class="e-sec-sm" aria-label="A note on proof">
    <div class="e-wrap">
      <blockquote class="ab-pull e-reveal">
        <p>I'm not going to show you screenshots. <em>I'm going to show you the business,</em> and let you walk through it.</p>
      </blockquote>
    </div>
  </section>

  <!-- WHAT YOU CAN INSPECT -->
  <section class="e-sec e-white" aria-labelledby="ab-inspect">
    <div class="e-wrap">
      <div class="ab-head ab-head--row">
        <div>
          <p class="e-kick">What you can inspect</p>
          <h2 id="ab-inspect" class="e-d2">Every room <em>is open.</em></h2>
        </div>
        <p class="e-lede ab-head-lede">Proof here is the business itself. Open any of these and look at how it was put together.</p>
      </div>
      <ul class="ab-rooms">
        {inspect.map((r) => (
          <li class="e-reveal">
            <a href={r.href}>
              <span class="ab-room">{r.room}</span>
              <span class="ab-rt">{r.t}</span>
              <span class="ab-rp">{r.p}</span>
              <span class="ab-go">{r.go} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- NEXT STEP: the page's one dark room -->
  <section class="e-sec e-dark" aria-labelledby="ab-next">
    <div class="e-wrap ab-next">
      <div>
        <p class="e-kick">Free download</p>
        <h2 id="ab-next" class="e-d2">See the whole build <em>on one page.</em></h2>
        <p class="e-lede">The Faceless Income Blueprint™ is free: the entire business, offer to audience, laid out on a single page, with a simple way to find the room you are stuck in.</p>
        <div class="e-actions">
          <a class="e-btn" href="/resources/faceless-income-blueprint">Get the free Blueprint <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href={weekendEcosystem.url}>Or build it over one weekend with {weekendEcosystem.name}</a>
        </div>
        <p class="ab-sign">xoxo, Jodie</p>
      </div>
      <figure class="ab-quote">
        <blockquote>
          <p>“{FEATURED.line}”</p>
        </blockquote>
        <figcaption>{FEATURED.name}, on {weekendEcosystem.name}</figcaption>
      </figure>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero */
  .ab-hero{padding:clamp(40px,6vw,88px) 0 clamp(28px,4vw,48px)}
  .ab-hero-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.95fr);gap:clamp(32px,5vw,80px);align-items:end}
  .ab-h1{font-size:clamp(42px,6vw,88px);line-height:.98;letter-spacing:-.035em;margin:0 0 28px}
  .ab-byline{font-size:14px;font-weight:600;letter-spacing:.04em;color:var(--e-ink-2);margin:0;padding-top:18px;border-top:var(--e-hair);display:inline-block}
  .ab-hero-fig{margin:0 calc(var(--e-gut) * -1) 0 0}
  .ab-hero-img{aspect-ratio:4/5;border-radius:2px 0 0 2px}
  .ab-hero-img img{object-position:50% 30%}
  .ab-credit{display:block;margin-top:14px;max-width:34em;line-height:1.6}
  .ab-credit b{margin-right:10px}

  /* How I built it */
  .ab-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,6vw,96px);align-items:start}
  /* The page's one oversized statement. */
  .ab-built-h{margin:0}
  .ab-split > div:first-child{grid-column:1 / -1}
  .ab-split .ab-prose{grid-column:2;margin-top:calc(clamp(0px,9vw,130px) * -1)}
  .ab-giant{display:block;font-size:clamp(72px,14vw,196px);margin-left:-.05em}
  .ab-built-sub{display:block;font-size:var(--e-d3);letter-spacing:-.02em;margin:20px 0 0 clamp(0px,6vw,96px)}
  .ab-prose p{font-size:18px;line-height:1.75;color:var(--e-ink-2);margin:0 0 22px;max-width:36em}
  .ab-prose .ab-first{font-family:var(--e-serif);font-weight:600;font-size:clamp(24px,2.4vw,30px);line-height:1.3;letter-spacing:-.015em;color:var(--e-ink)}

  /* What I learned */
  .ab-head{max-width:720px;margin-bottom:clamp(36px,5vw,64px)}
  .ab-head--row{max-width:none;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px 64px;align-items:end}
  .ab-head-lede{margin:0 0 20px}
  .ab-lessons{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0 clamp(28px,4vw,64px)}
  .ab-lessons .ab-lead{grid-column:1 / -1;padding:0 0 clamp(48px,6vw,88px);border-top:0}
  .ab-lead > div{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:20px clamp(32px,6vw,96px);align-items:end}
  .ab-lead .ab-lnum{display:none}
  .ab-lead .ab-lt{font-size:clamp(30px,3.8vw,52px);line-height:1.02;letter-spacing:-.03em;margin:0}
  .ab-lead p{font-size:18px;padding-bottom:6px}
  .ab-lessons li{display:grid;grid-template-columns:1fr;align-content:start;gap:10px;padding:28px 0;border-top:var(--e-hair)}
  .ab-lnum{font-size:32px}
  .ab-lt{font-size:clamp(21px,1.9vw,25px);line-height:1.18;margin:0 0 10px}
  .ab-lessons p{margin:0;color:var(--e-ink-2);max-width:32em}

  /* Full-bleed image */
  .ab-bleed{margin:0}
  .ab-bleed-img{overflow:hidden}
  .ab-bleed img{display:block;width:100%;height:clamp(320px,62vw,760px);object-fit:cover;object-position:50% 45%}
  .ab-bleed-cap{display:block;padding-top:14px;padding-bottom:0}
  .ab-bleed-cap b{margin-right:10px}

  /* Why the order matters */
  .ab-order-h{font-size:clamp(34px,5.2vw,72px);line-height:1.02;letter-spacing:-.03em;max-width:15em;margin:0 0 clamp(40px,5vw,64px)}
  .ab-order{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:0}
  .ab-order li{padding:26px 28px 8px 0;border-top:1px solid var(--e-ink)}
  .ab-order li + li{padding-left:28px;border-left:var(--e-hair)}
  .ab-on{display:block;font-size:12px;font-weight:700;letter-spacing:.2em;color:var(--e-pink-t);margin-bottom:10px}
  .ab-order h3{font-size:30px;margin:0 0 10px}
  .ab-order p{font-size:16px;margin:0;color:var(--e-ink-2)}
  .ab-order-foot{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.8fr);gap:24px 64px;align-items:end;margin-top:clamp(40px,5vw,64px);padding-top:28px;border-top:var(--e-hair)}
  .ab-order-foot p{margin:0;font-size:18px;color:var(--e-ink-2);max-width:34em}
  .ab-order-foot .ab-tagline{font-family:var(--e-serif);font-weight:600;font-size:22px;line-height:1.3;color:var(--e-pink-t);text-align:right}

  /* Pull statement */
  .ab-pull{margin:0 0 0 auto;max-width:900px;padding:clamp(24px,4vw,48px) 0;border-top:var(--e-hair)}
  .ab-pull p{font-family:var(--e-serif);font-weight:600;font-size:clamp(30px,4.2vw,56px);line-height:1.1;letter-spacing:-.025em;margin:0;color:var(--e-ink)}
  .ab-pull em{font-style:normal;color:var(--e-pink)}

  /* Inspect */
  .ab-rooms{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--e-ink)}
  .ab-rooms li{border-bottom:var(--e-hair)}
  .ab-rooms li:not(:nth-child(3n+1)){border-left:var(--e-hair)}
  .ab-rooms a{display:flex;flex-direction:column;gap:10px;height:100%;padding:28px 28px 24px;color:var(--e-ink);text-decoration:none;transition:background .2s}
  .ab-rooms a:hover{background:var(--e-cream)}
  .ab-go span{transition:transform .2s}
  .ab-rooms a:hover .ab-go span{transform:translateX(4px)}
  .ab-room{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t)}
  .ab-rt{font-family:var(--e-serif);font-weight:600;font-size:24px;line-height:1.2;letter-spacing:-.015em}
  .ab-rp{font-size:15.5px;line-height:1.6;color:var(--e-ink-2)}
  .ab-go{margin-top:auto;padding-top:8px;min-height:44px;display:inline-flex;align-items:center;gap:6px;font-weight:600;color:var(--e-pink-t);text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:1px;text-decoration-color:rgba(184,36,95,.4)}
  .ab-rooms a:hover .ab-go{text-decoration-color:currentColor}

  /* Next step */
  .ab-next{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.8fr);gap:clamp(40px,6vw,96px);align-items:center}
  .ab-sign{font-family:var(--e-serif);font-weight:600;font-size:22px;color:var(--e-bubble)!important;margin:36px 0 0}
  .ab-quote{margin:0;padding:28px 0 0;border-top:1px solid rgba(232,90,155,.6)}
  .ab-quote blockquote{margin:0}
  .ab-quote p{font-family:var(--e-serif);font-weight:600;font-size:clamp(22px,2.2vw,28px);line-height:1.3;color:#1A1417!important;margin:0 0 16px}
  .ab-quote figcaption{font-size:14px;color:#B8245F}

  @media (max-width:1000px){
    .ab-rooms{grid-template-columns:1fr 1fr}
    .ab-lessons{grid-template-columns:1fr}
    .ab-rooms li:not(:nth-child(3n+1)){border-left:0}
    .ab-rooms li:nth-child(2n){border-left:var(--e-hair)}
    .ab-order{grid-template-columns:1fr 1fr}
    .ab-order li:nth-child(3){padding-left:0;border-left:0}
  }
  @media (max-width:820px){
    .ab-hero-grid,.ab-split,.ab-lessons,.ab-head--row,.ab-order-foot,.ab-next{grid-template-columns:1fr}
    .ab-hero-fig{max-width:520px;margin-right:0}
    .ab-built-sub{margin-left:0}
    .ab-split .ab-prose{grid-column:1;margin-top:0}
    .ab-lead > div{grid-template-columns:1fr}
    .ab-order-foot .ab-tagline{text-align:left}
  }
  @media (prefers-reduced-motion:reduce){.ab-go span{transition:none}.ab-rooms a:hover .ab-go span{transform:none}}
  @media (max-width:560px){
    .ab-rooms,.ab-order{grid-template-columns:1fr}
    .ab-rooms li:nth-child(2n){border-left:0}
    .ab-rooms a{padding:24px 0}
    .ab-order li,.ab-order li + li{padding:22px 0 18px;border-left:0}
    .ab-lnum{font-size:28px}
  }
  /* ── ABOUT · founder/editorial pass ── */
  .ab-hero{padding-top:clamp(70px,9vw,140px)}
  .ab-h1{font-size:clamp(54px,7vw,104px);line-height:.9;letter-spacing:-.045em;max-width:11ch}
  .ab-hero-img{border-radius:0}
  .ab-hero-img img{box-shadow:14px 14px 0 var(--e-blush)}
  .ab-built-h{font-size:clamp(64px,10vw,140px)}
  .ab-built-sub{font-size:clamp(34px,5vw,68px)}
  .ab-lessons .ab-lead{padding-top:30px;border-top:2px solid var(--e-ink)}
  .ab-bleed-img{border-top:1px solid var(--e-ink);border-bottom:1px solid var(--e-ink)}
  .ab-order li{min-height:260px}
  .ab-rooms li:nth-child(1){grid-column:span 2;background:var(--e-paper)}
  .ab-rooms li:nth-child(1) .ab-rt{font-size:clamp(28px,3vw,42px)}
  .ab-rooms li:nth-child(4){grid-column:span 2}
  @media(max-width:1000px){
    .ab-rooms li:nth-child(1),.ab-rooms li:nth-child(4){grid-column:auto}
  }
  @media(max-width:560px){
    .ab-h1{font-size:clamp(48px,14vw,72px)}
    .ab-built-h{font-size:clamp(58px,16vw,84px)}
  }
</style>
