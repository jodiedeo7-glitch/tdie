---
// BAMI, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../layouts/TemplateLayout.astro";
const stats = [
  { n: "12", l: "Weeks" },
  { n: "6", l: "Phases" },
  { n: "24", l: "Modules" },
  { n: "24", l: "Named assets" },
];

const phases = [
  {
    n: "I", when: "Weeks 1\u20132", title: "The Specification", sub: "Modules 1\u20134",
    body: "You settle who is building, and how, before you build anything. By the close of Phase I the whole business exists on paper, your identity as founder, the method, your model, and the one woman you're building for.",
    items: ["The Founder's Declaration\u2122", "The Business Blueprint\u2122", "The Business Model Decision\u2122", "The Customer Blueprint\u2122"],
  },
  {
    n: "II", when: "Weeks 3\u20134", title: "The Brand", sub: "Modules 5\u20138",
    body: "Your look, your faceless decision, the persona that fronts the brand, and a message that finally says who this is for. By the close of Phase II the brand is something a stranger could recognize.",
    items: ["The Brand Guide\u2122", "The Faceless Decision\u2122", "The Persona Bible\u2122", "The Messaging Guide\u2122"],
  },
  {
    n: "III", when: "Weeks 5\u20136", title: "The Offer", sub: "Modules 9\u201312",
    body: "The ecosystem, the offer that carries it, the asset that attracts the right woman, and the funnel between them. By the close of Phase III there's something real to buy, at a real price, with a path to it.",
    items: ["The Offer Ecosystem Map\u2122", "The Signature Offer\u2122", "The Lead Asset\u2122", "The Funnel Frame\u2122"],
  },
  {
    n: "IV", when: "Weeks 7\u20138", title: "The Machine", sub: "Modules 13\u201316",
    body: "Email architecture, a published sales page, a content system that survives a bad week, and one platform chosen properly rather than five run half-heartedly. By the close of Phase IV the selling machine stands on its own.",
    items: ["The Welcome Sequence\u2122", "The Sales Page\u2122", "The Content Planner\u2122", "The Platform Plan\u2122"],
  },
  {
    n: "V", when: "Weeks 9\u201310", title: "The Traffic", sub: "Modules 17\u201320",
    body: "The engine that brings people in, the loop that keeps the list warm, a launch with dates on it, and an honest answer about whether you've earned the right to spend on ads. By the close of Phase V people arrive, and they keep arriving.",
    items: ["The Pinterest System\u2122", "The Nurture System\u2122", "The Launch Planner\u2122", "The Amplification Plan\u2122"],
  },
  {
    n: "VI", when: "Weeks 11\u201312", title: "The Business", sub: "Modules 21\u201324",
    body: "Automation, the numbers worth watching, a weekly rhythm you can hold, and the document that proves all of it exists. By the close of Phase VI it runs without you holding it up.",
    items: ["The Automation Planner\u2122", "The Business Dashboard\u2122", "The CEO Review System\u2122", "The Business Architecture Binder\u2122"],
  },
];

const problems = [
  { t: "You've bought this before", p: "Three programs, maybe five. You finished none of them and concluded something is wrong with you. Nothing is wrong with you, you kept buying information when nobody was checking whether anything got built." },
  { t: "You've got pieces, not a business", p: "A logo. A half-written freebie. A Canva folder called BRAND FINAL v3. Nothing connects, because it was built in the order you happened to learn it rather than the order a business needs." },
  { t: "You've got an audience and no offer", p: "People follow you. You post consistently. You have never had anything real to sell them, so all of that attention just sits there doing nothing." },
  { t: "You won't show your face", p: "Good. Nothing in these twelve weeks requires it. The brand's face is a persona, and building yours is inside the curriculum." },
];
const faqs = [
  { q: "When does it start?", a: "Dates aren't set yet. The waitlist hears them first, before anywhere public." },
  { q: "What will it cost?", a: "The founding price goes to the waitlist before it goes anywhere public." },
  { q: "Are there live calls?", a: "No. Every module is recorded and released on the phase calendar. The personal component is written review of your work at each of the six phase gates." },
  { q: "How much time does this take?", a: "Four focused hours a week is the floor. If you have twenty you'll move faster. The sequence is the same either way." },
  { q: "Do I need a product already?", a: "No. Phase III builds your Signature Offer™ from nothing, once Phases I and II have settled who it's for." },
  { q: "Is it in the membership?", a: "No. BAMI is separate, by application only. Standard and Premium don't include it." },
  { q: "What do I get when I finish?", a: "The Weekend Ecosystem™, free: my full website-and-blog course, $97 on its own. It's earned at completion rather than included at purchase, and it applies to the founding cohort." },
  { q: "Do I need to show my face?", a: "No." },
  { q: "What if it isn't right for me?", a: "Do Phase I, and if the program isn't for you, you get your money back. Submit your completed Phase I asset within 21 days of your cohort start date, tell me it isn't right, and you're refunded in full within 10 business days. No explanation needed, and no prejudice if you apply again later. The submission is the condition, because Phase I is where you settle who is building, what the model is and who you're building for. If you've done that and it still isn't right, it genuinely isn't." },
  { q: "Can I move to a later cohort?", a: "Once, at no cost, if you tell me before your cohort starts. If I cancel or move a cohort, you choose: a full refund, or a seat in the next one at the price you paid." },
];
---
<TemplateLayout title="The Business Architect Mentorship Intensive™" description="A twelve-week mentorship to build your offer, sales page, email sequence and content system, with written review at six phase gates. Join the founding-cohort waitlist." stickyHref="#waitlist" stickyLabel="Join the waitlist">

<section class="hh">
 <div class="wrap hh-grid bm2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Founding<b class="big">cohort</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Business Architect Mentorship Intensive™</p>
   <h1>Turn your business idea <span class="scr">into something people can buy.</span></h1>
   <p class="what">A twelve-week mentorship to build your offer, sales page, welcome emails and content system, with written review of your work at each of six phase gates. <b>Twenty-four finished assets, built in order, so twelve weeks end with a business instead of another folder of notes.</b></p>
   <a class="btn buy" href="#waitlist">Join the waitlist <span class="ar">→</span></a>
   <p class="see">Applications open to the waitlist first. They hear the dates before anyone else.</p>
  </div>
  <div class="bm2-stats">{stats.map((s) => <div class="card dash"><b class="glit">{s.n}</b><span>{s.l}</span></div>)}</div>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>The consumer cycle</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <div class="lead"><p>Buy the course. Consume the course. Feel briefly capable. Abandon it around week three, right before the part where it gets hard. Buy the next one.</p><p>It's not a discipline problem. Every one of those courses handed you information when your actual bottleneck was construction.</p></div>
  <p class="bm2-hit">A module doesn't close because you watched it. It closes because the thing exists.</p>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">Sound familiar?</p>
  <h2 class="h2">You're not missing <span class="scr">information.</span></h2>
  <div class="bm2-grid">{problems.map((c, i) => <div class="card dash"><span class="hm-lab">{String(i+1).padStart(2,'0')}</span><h3>{c.t}</h3><p>{c.p}</p></div>)}</div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">The curriculum</p>
  <h2 class="h2">Six phases. Twelve weeks. <span class="scr">Twenty-four assets.</span></h2>
  <div class="lead"><p>The order is the mechanism. A module opens when the previous asset exists, not when you feel ready.</p></div>
  <div class="bm2-phases">{phases.map((p) => <article class="card dash"><div class="bm2-ph"><span class="glit">{p.n}</span><div><span class="hm-lab">{p.when} · {p.sub}</span><h3>{p.title}</h3></div></div><p>{p.body}</p><ul class="chk">{p.items.map((m) => <li>{m}</li>)}</ul></article>)}</div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">How it runs</p>
  <h2 class="h2">Twelve weeks, and six times <span class="scr">I read your work.</span></h2>
  <div class="p23 bm2-two">
   <div class="pc"><div class="hd">Recorded</div><div class="bd"><p>Every module carries a recorded walkthrough, released the week its phase opens. Watch it at 6am or at midnight. Nothing you paid for happens while you're asleep in another time zone.</p></div></div>
   <div class="pc"><div class="hd">Reviewed</div><div class="bd"><p>At the close of every phase you submit the asset that phase produced, and I write back on the actual work rather than on a template. Six phase gates. Six times someone who has built this looks at yours and tells you the truth about it.</p></div></div>
  </div>
  <p class="bm2-hit">That's the part you can't get from a course.</p>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">The sequence <span class="scr">is the product.</span></h2>
  <div class="lead"><p>There's a version of mentorship where you arrive each week, say what you're stuck on, and get help with that. It feels responsive. It's also how twelve weeks disappear without a business at the end, because the thing you feel stuck on is rarely the thing actually blocking you.</p><p>BAMI is fixed on purpose. What flexes is the feedback. What you build is yours: your model, your customer, your offer. What doesn't flex is the order you build it in.</p></div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <div class="p42 dash bm2-reward" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">Finish &amp;<b class="big">earn it</b></span>
   <div class="ph"><img src="/images/home/founder-window-seat-640.webp" width="640" height="426" loading="lazy" decoding="async" alt="Tommy Kate working from a window seat"></div>
   <div class="tx">
    <p class="kick">Finish and it's yours</p>
    <h2>The Weekend Ecosystem™,</h2>
    <span class="scr">free on completion.</span>
    <p>Complete all six phases and my full website-and-blog course is yours: the site on a domain you own, the blog Google can find, the email capture, and the system that keeps all of it running. Twenty-two modules, every prompt written out, four reference vaults. It's the exact build I used to make this website and everything on it.</p>
    <p class="bm2-price"><b class="glit">$97</b> on its own. You don't buy it. You earn it.</p>
    <a class="btn" href="/shop/weekend-ecosystem">See the Weekend Ecosystem™ <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">Fit</p>
  <h2 class="h2">Who this <span class="scr">isn't for.</span></h2>
  <div class="bm2-grid bm2-three">
   <div class="card dash"><ul class="chk hm-x"><li><b>You want it built for you.</b></li></ul><p>Nobody sets up your store or writes your sales page. You build it; I tell you where it's wrong.</p></div>
   <div class="card dash"><ul class="chk hm-x"><li><b>You have under four hours a week.</b></li></ul><p>Four hours in sequence beats forty scattered ones, but four is the floor, and there are twelve weeks of them.</p></div>
   <div class="card dash"><ul class="chk hm-x"><li><b>You'll keep buying other programs.</b></li></ul><p>Not because they're bad. Because your bottleneck is construction, and running three blueprints at once is how nothing gets built.</p></div>
  </div>
 </div>
</section>

<section class="sec" id="waitlist">
 <div class="wrap">
  <p class="kick">The waitlist</p>
  <h2 class="h2">The founding cohort <span class="scr">is small.</span></h2>
  <div class="lead"><p>BAMI opens by application, to a small founding group first. The waitlist hears first: dates, price, and the application link, before this page is announced anywhere.</p></div>
  <div class="card dash bm-capture">
   <form id="bami-form" novalidate>
    <div class="bm-field"><label for="bami-name">First name</label><input id="bami-name" name="name" type="text" autocomplete="given-name" placeholder="Your first name" /></div>
    <div class="bm-field"><label for="bami-email">Email</label><input id="bami-email" name="email" type="email" autocomplete="email" placeholder="your@email.com" required /></div>
    <div class="bm-field"><label for="bami-stage">Where are you right now?</label><select id="bami-stage" name="stage"><option value="">Choose one</option><option>No business yet</option><option>An idea, nothing built</option><option>Something built that isn't selling</option><option>Something selling that won't scale</option></select></div>
    <button class="btn buy" type="submit" id="bami-submit">Put me on the list</button>
    <p class="bm-msg" id="bami-msg" role="status" aria-live="polite"></p>
   </form>
   <p class="bm2-small">No pitch in the meantime. One email when dates are set.</p>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Questions</span></p>
  <h2 class="h2">Before <span class="scr">you join.</span></h2>
  <div class="faq">{faqs.map((f, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{f.q}</h3><p>{f.a}</p></div></div>)}</div>
  <p class="see" style="text-align:center;margin-top:30px"><a href="/learn">← Back to The Library</a></p>
 </div>
</section>

<script is:inline>
    (function () {
      var f = document.getElementById("bami-form");
      if (!f) return;
      var msg = document.getElementById("bami-msg");
      var btn = document.getElementById("bami-submit");
      f.addEventListener("submit", async function (e) {
        e.preventDefault();
        var email = document.getElementById("bami-email").value.trim();
        if (!email || email.indexOf("@") === -1) {
          msg.className = "bm-msg err";
          msg.textContent = "Enter a valid email address.";
          return;
        }
        btn.disabled = true;
        var original = btn.textContent;
        btn.textContent = "Adding you…";
        try {
          var r = await fetch("/api/bami-waitlist", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name: document.getElementById("bami-name").value.trim(),
              email: email,
              stage: document.getElementById("bami-stage").value,
            }),
          });
          var d = await r.json().catch(function () { return {}; });
          if (r.ok && d.ok) {
            f.querySelectorAll(".bm-field, button").forEach(function (el) { el.style.display = "none"; });
            msg.className = "bm-msg ok";
            msg.textContent = "You're on the list. You'll hear from me before anyone else does.";
          } else {
            msg.className = "bm-msg err";
            msg.textContent = d.error || "Couldn't add you just now. Try again in a moment.";
            btn.disabled = false;
            btn.textContent = original;
          }
        } catch (err) {
          msg.className = "bm-msg err";
          msg.textContent = "Couldn't add you just now. Try again in a moment.";
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    })();
  </script>
</TemplateLayout>
