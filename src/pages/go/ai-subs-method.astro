---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "The AI Subs Method";
const PRICE = "$147";
const NOTE = "one-time";
const DEST = "https://links.thedigitalincomeedit.com/shop/4fb73a6d-56a7-4c3f-b17c-ee28624bc4ac";
const AFF = true;
---
<TemplateLayout
  title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn"
  description="A step-by-step system for growing and monetizing a faceless AI subscription channel."
>
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A step-by-step system for growing and monetizing a faceless AI subscription channel.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      <span class="go-note">{NOTE}</span>
    </div>

    <div class="go-body">
      <p>A full system for building a faceless AI subscription channel, from setup through to monetization.</p>
      <p>It's one of the bigger buys I recommend, and it isn't mine. I earn a commission if you buy through this page.</p>
      <p>It's a genuine commitment — a system to work through, not something you skim. If you want a quick win, this isn't it.</p>
      <p>Price is set by the owner and can change without notice.</p>
    </div>


    <div class="go-good">
      <div>
        <span class="go-good-t">Good fit if</span>
        <p>You're serious about the subscription model and want the whole path laid out.</p>
      </div>
      <div>
        <span class="go-good-t">Not a fit if</span>
        <p>You want something you can finish this week.</p>
      </div>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Get {NAME} — {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
