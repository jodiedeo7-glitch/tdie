---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "The Tommy Kate Edit";
const PRICE = "$17";
const NOTE = "one-time · lifetime access";
const DEST = "https://links.thedigitalincomeedit.com/shop/33f23d28-8b7b-466c-9717-12952c813326";
const AFF = false;
---
<TemplateLayout
  title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn"
  description="A prompt pack for faceless lifestyle creators, so you never start a caption from a blank screen."
>
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A prompt pack for faceless lifestyle creators, so you never start a caption from a blank screen.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      <span class="go-note">{NOTE}</span>
    </div>

    <div class="go-body">
      <p>Ready-to-use AI prompts built specifically for faceless lifestyle content — captions, hooks, and the connective tissue that makes a feed feel like one person made it.</p>
      <p>Lifetime updates are included. When the tools change, the pack changes.</p>
      <p>Included inside Membership Standard at $9 a month, so if you're already thinking about joining, don't buy it here.</p>
    </div>


    <div class="go-good">
      <div>
        <span class="go-good-t">Good fit if</span>
        <p>You post consistently and the writing is the part that stalls you.</p>
      </div>
      <div>
        <span class="go-good-t">Not a fit if</span>
        <p>You're already a member. It's included in Standard and Premium.</p>
      </div>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Get {NAME} — {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
