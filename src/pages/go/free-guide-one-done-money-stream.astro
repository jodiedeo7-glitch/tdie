---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "FREE GUIDE - One & Done Money Stream";
const PRICE = "$0";
const NOTE = "free";
const DEST = "https://links.thedigitalincomeedit.com/shop/d03bc54d-50e6-4725-b401-f91cb3ea251a";
const AFF = false;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="The short version of the one-product, one-system approach.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">The short version of the one-product, one-system approach.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>Four half-built income streams lose to one finished one. This free guide is the short version of that idea: one product, one system, built properly. Read it first. If it clicks, the full build is The One and Done Money Stream at $27.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link, I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Send me the free guide <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
