---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "How I Batch & Schedule a Month of Pinterest in One 3-Hour Block";
const PRICE = "$9";
const NOTE = "one-time";
const DEST = "https://links.thedigitalincomeedit.com/shop/8e31e02b-cc67-4217-ba21-139fb88584aa";
const AFF = false;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="A month of pins queued in a single sitting. The exact order I work in.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A month of pins queued in a single sitting. The exact order I work in.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>Pinterest wants a steady stream of pins. You don't have a steady stream of free time. So don't pin every day: this is the exact order I work in to queue a month of pins in one three-hour block, then leave it alone.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Get the batching guide for {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
