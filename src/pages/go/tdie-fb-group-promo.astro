---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "#TDIE FB GROUP PROMO";
const PRICE = "$10";
const NOTE = "per month · promotion slot";
const DEST = "https://links.thedigitalincomeedit.com/shop/8b706bf8-79cb-4e65-8b8f-01b17cb6fddb";
const AFF = false;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="A recurring promotion placement inside the Facebook group.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A recurring promotion placement inside the Facebook group.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>You have an offer and you want it seen by women building faceless businesses too. This is a recurring promotion spot inside my Facebook group, $10 a month, so your offer shows up again instead of once.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Book my promo spot, {PRICE} a month <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
