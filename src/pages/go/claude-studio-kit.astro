---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "Claude Studio Kit";
const PRICE = "$57";
const NOTE = "one-time";
const DEST = "https://links.thedigitalincomeedit.com/shop/936479ee-b21a-4c8e-80bb-a92b66cf7626";
const AFF = true;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="A working setup for running Claude as a studio rather than a chat box.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A working setup for running Claude as a studio rather than a chat box.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>Most people use Claude like a search bar: one question, one answer, start again tomorrow. This kit is a working setup for running it as a studio instead, so the work builds on itself rather than resetting every time you open it. It isn't mine. I earn a commission if you buy through this page.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      See the Claude Studio Kit, {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
