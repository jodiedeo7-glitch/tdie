---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "Leni Loves";
const PRICE = "$27";
const NOTE = "on sale (regular $37)";
const DEST = "https://links.thedigitalincomeedit.com/shop/759b7d47-a917-40b3-b448-ed1f2ae541c1";
const AFF = true;
---
<TemplateLayout
  title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn"
  description="A collection of aesthetic templates and resources for your brand and content."
>
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">A collection of aesthetic templates and resources for your brand and content.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      <span class="go-note">{NOTE}</span>
    </div>

    <div class="go-body">
      <p>Templates and brand resources for creators who want a coherent look without hiring a designer.</p>
      <p>This one isn't mine. I recommend it because I use it.</p>
      <p>It's on sale right now at $27, regular $37 (checked 11 October 2026). Price is set by the owner and can change without notice.</p>
    </div>


    <div class="go-good">
      <div>
        <span class="go-good-t">Good fit if</span>
        <p>Your content is good and it doesn't look like it belongs together yet.</p>
      </div>
      <div>
        <span class="go-good-t">Not a fit if</span>
        <p>You already have a locked brand system you're happy with.</p>
      </div>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      Get {NAME} — {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
