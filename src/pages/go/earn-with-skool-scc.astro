---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "Earn With Skool (SCC)";
const PRICE = "$97";
const NOTE = "one-time";
const DEST = "https://links.thedigitalincomeedit.com/shop/74512b39-f6d6-48ae-8aca-36e35631da7e";
const AFF = true;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="Building and earning from a Skool community.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">Building and earning from a Skool community.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>This is the course I used to build The Digital Income Edit™ community on Skool, the one you'd be joining. It covers building and earning from a Skool community of your own. If you're the one answering questions in other people's groups, that's your sign. It isn't mine. I earn a commission if you buy through this page.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link, I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      See Earn With Skool, {PRICE} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
