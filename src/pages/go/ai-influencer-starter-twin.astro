---
import TemplateLayout from "../../layouts/TemplateLayout.astro";

const NAME = "AI Influencer Starter Twin";
const PRICE = "$97";
const NOTE = "one-time";
const DEST = "https://links.thedigitalincomeedit.com/shop/fdfdf1a4-ce57-4bdb-8a41-df57e5d13c2f";
const AFF = false;
---
<TemplateLayout title={NAME} stickyHref={DEST} stickyLabel={PRICE === "$0" ? "Get it free" : `Get it · ${PRICE}`} heroBuy=".go .go-btn" description="Your persona, generated to stay the same face every time.">
  <section class="sec wash go2"><div class="wrap"><div class="card dash go"><svg class="spk" style="position:absolute;right:-22px;top:-22px"><use href="#sp"/></svg>
    <div class="kick">{AFF ? "Recommended · Not mine" : "From the shop"}</div>
    <h1>{NAME}</h1>
    <p class="go-lede">Your persona, generated to stay the same face every time.</p>

    <div class="go-meta">
      <span class="go-price">{PRICE}</span>
      {NOTE && <span class="go-note">{NOTE}</span>}
    </div>

    <div class="go-body">
      <p>Your persona, generated to stay the same face every time.</p>
    </div>

    {AFF && (
      <p class="go-disc">
        Affiliate link — I earn a commission if you buy through it, at no cost to you.
        I only recommend things I use. The price is set by the owner and can change without notice.
      </p>
    )}

    <a class="btn buy go-btn" href={DEST} rel={AFF ? "sponsored noopener" : "noopener"}>
      {PRICE === "$0" ? `Get ${NAME} free` : `Get ${NAME} — ${PRICE}`} <span class="ar">→</span>
    </a>

    <p class="go-back"><a href="/shop">← Everything in the shop</a></p>
  </div></div></section>
</TemplateLayout>
