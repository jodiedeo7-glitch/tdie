---
import Frame from '../../components/lifestyle/Frame.astro';
import Card from '../../components/lifestyle/Card.astro';
import Cards from '../../components/lifestyle/Cards.astro';
import Categories from '../../components/lifestyle/Categories.astro';
import { LOOKS } from '../../data/lifestyle.js';
// Explicit editorial selection, independent of imported file order or future dates.
const featured = ['pretty-wicked-entryway', 'ghoul-fuel-coffee-bar', 'pink-witch-halloween-costume'].map(slug => LOOKS.find(look => look.slug === slug)).filter(Boolean);
---
<Frame title="Lifestyle · Pink Outfits, Home Decor & Everyday Finds" description="Browse pink outfit ideas, seasonal home decor and car accessories, with generated styling inspiration and clearly listed shopping finds.">
  <header class="life-hero">
    <div class="life-wrap life-hero-grid">
      <div class="life-hero-copy">
        <p class="life-kicker">The Lifestyle Edit</p>
        <h1>A little pink.<br /><span>A lot of personality.</span></h1>
        <p class="life-intro">Outfits to play with, corners to decorate and little things that make the everyday prettier. Browse the styling ideas, then find the products listed in each article.</p>
        <a class="life-button" href="#browse">Find your next idea <span aria-hidden="true">↓</span></a>
        <p class="life-hero-note"><span class="life-sticker">Picked with personality</span> Generated inspiration. Clearly listed finds.</p>
      </div>
      {featured[0] && <div class="life-feature"><span class="life-feature-label">Seasonal pick</span><Card look={featured[0]} featured /></div>}
    </div>
  </header>
  <section class="life-wrap life-section" aria-labelledby="life-featured">
    <div class="life-section-heading"><div><p class="life-kicker">A few favorites</p><h2 id="life-featured">Start here</h2></div><p>One for your home, one for your coffee corner, one for dressing up.</p></div>
    <Cards looks={featured} />
  </section>
  <section class="life-band" aria-labelledby="life-categories-title"><div class="life-wrap life-section"><p class="life-kicker">Follow your curiosity</p><h2 id="life-categories-title">Find your corner</h2><Categories /></div></section>
  <section class="life-wrap life-section" id="browse" aria-labelledby="life-browse">
    <div class="life-section-heading"><div><p class="life-kicker">Browse the edit</p><h2 id="life-browse">All the pretty possibilities</h2></div><p>{LOOKS.length} articles, ordered by their recorded date.</p></div>
    <Cards looks={LOOKS} />
  </section>
</Frame>
