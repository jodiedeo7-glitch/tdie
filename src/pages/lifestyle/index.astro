---
// /lifestyle hub · founder Amazon storefront section (rebuilt 7 Oct 2026).
// Data: src/data/lifestyle.js (schema wys-founder-1). Styles: src/styles/lifestyle.css.
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/lifestyle.css";
import LookCard from "../../components/lifestyle/LookCard.astro";
import LifestyleOffers from "../../components/lifestyle/LifestyleOffers.astro";
import LifestyleFoot from "../../components/lifestyle/LifestyleFoot.astro";
import PinkFindsSignup from "../../components/PinkFindsSignup.astro";
import WysPromo from "../../components/WysPromo.astro";
import { CATEGORIES, LOOKS, looksIn, STOREFRONT, REL } from "../../data/lifestyle.js";

const latest = LOOKS.slice(0, 24);
const counts = Object.fromEntries(CATEGORIES.map((c) => [c.slug, looksIn(c.slug).length]));
const live = CATEGORIES.filter((c) => counts[c.slug]).length;
const og = latest[0]?.images[0]?.src?.src;
---
<PageLayout
  bare
  title="Lifestyle · Pink Outfits, Rooms and Amazon Finds"
  description="Pink outfits, porches, dorm rooms and car finds, styled head to toe on Tommy Kate, my AI model, with every piece linked on Amazon."
  ogImage={og}
>
  <div class="lsx">
    <header class="lsx-mast">
      <div class="lsx-wrap lsx-mast-grid">
        <div>
          <p class="lsx-brand"><span class="lsx-dot" aria-hidden="true"></span>The Digital Income Edit™ · Lifestyle</p>
          <h1>Pink, on purpose. <em>Every piece linked.</em></h1>
          <p class="lsx-lede">Whole looks, not random links. Each outfit, porch and car kit is styled together first, then every piece goes on one Amazon list so you can shop it in one tap. Beige has to earn its spot.</p>
          <div class="lsx-mast-ctas">
            <a class="lsx-btn" href="#h-latest">See the newest looks</a>
            <a class="lsx-btn lsx-btn--soft" href={STOREFRONT} rel={REL} target="_blank">My Amazon storefront<span class="lsx-sr"> (affiliate link, opens in a new tab)</span></a>
          </div>
          <p class="lsx-meta">{LOOKS.length} looks<i aria-hidden="true"></i>{live} departments open<i aria-hidden="true"></i>No prices, ever</p>
        </div>
        <figure class="lsx-mast-fig">
          <img class="lsx-photo" src="/images/home/flagship-attic-900.webp" srcset="/images/home/flagship-attic-560.webp 560w, /images/home/flagship-attic-900.webp 900w, /images/home/flagship-attic-1200.webp 1200w" sizes="(max-width: 900px) 92vw, 470px" width="900" height="1117" alt="Tommy Kate laughing at her pastel pink desk in the attic loft, in an oversized pink knit, holding her glitter pink tumbler." loading="eager" fetchpriority="high" />
          <span class="lsx-sticker lsx-sticker--a" aria-hidden="true"><span>Every piece linked</span></span>
          <span class="lsx-sticker lsx-sticker--b" aria-hidden="true"><span>New looks weekly</span></span>
          <figcaption><b>Meet Tommy Kate.</b> My AI model, styled in her pink attic loft. She wears the looks so you can see them together.</figcaption>
        </figure>
      </div>
    </header>

    <section class="lsx-sec" aria-labelledby="h-latest">
      <div class="lsx-wrap">
        <div class="lsx-head">
          <div>
            <span class="lsx-kick">Just in</span>
            <h2 id="h-latest">The newest looks</h2>
          </div>
          <p class="lsx-callout"><span class="lsx-tag">Affiliate</span> Every piece links to Amazon. The full disclosure is at the foot of the page.</p>
        </div>
        {latest.length ? (
          <ul class="lsx-grid">
            {latest.map((l, i) => <li><LookCard look={l} eager={i < 4} /></li>)}
          </ul>
        ) : (
          <div class="lsx-card lsx-empty"><p>The first looks land this week.</p></div>
        )}
      </div>
    </section>

    <section class="lsx-sec" aria-labelledby="h-departments">
      <div class="lsx-wrap">
        <div class="lsx-head">
          <div>
            <span class="lsx-kick">The departments</span>
            <h2 id="h-departments">Shop by <em>room.</em></h2>
          </div>
          <p>Ten departments. The ones still filling up say so.</p>
        </div>
        <nav aria-label="Lifestyle departments">
          <ul class="lsx-cats">
            {CATEGORIES.map((c) => (
              <li>
                <a class={`lsx-cat lsx-card${counts[c.slug] ? "" : " is-soon"}`} href={`/lifestyle/${c.slug}`}>
                  <span class="lsx-cat-top">
                    <span class="lsx-cat-name">{c.name}</span>
                    <span class={`lsx-tag${counts[c.slug] ? " lsx-tag--hot" : ""}`}>{counts[c.slug] ? `${counts[c.slug]} look${counts[c.slug] === 1 ? "" : "s"}` : "Soon"}</span>
                  </span>
                  <span class="lsx-cat-blurb">{c.blurb}</span>
                  <span class="lsx-go">{counts[c.slug] ? "Shop " + c.name : "Take a look"} <span aria-hidden="true">→</span></span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </section>

    <section class="lsx-sec" aria-label="The Friday email">
      <div class="lsx-wrap">
        <div class="lsx-card lsx-signup">
          <PinkFindsSignup variant="strip" />
        </div>
        <div style="margin-top:20px"><WysPromo variant="strip" seed="lifestyle-home" /></div>
      </div>
    </section>

    <LifestyleOffers />
    <LifestyleFoot />
  </div>
</PageLayout>
