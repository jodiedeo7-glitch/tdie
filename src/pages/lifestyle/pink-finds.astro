---
import Frame from '../../components/lifestyle/Frame.astro';
import Cards from '../../components/lifestyle/Cards.astro';
import PinkFindsSignup from '../../components/PinkFindsSignup.astro';
import { LOOKS } from '../../data/lifestyle.js';
const latest = LOOKS.slice(0, 6);
---
<Frame title="Pink Finds · The Friday Email" description="Pink outfit ideas, home details and everyday finds in the Pink Finds Friday email. Browse the styling, then shop the clearly listed products." ogImage={latest[0]?.hero?.src.src} signup={false}>
  <header class="life-category-hero"><div class="life-wrap"><nav class="life-breadcrumb" aria-label="Breadcrumb"><a href="/lifestyle">Lifestyle</a><span aria-hidden="true">/</span><span aria-current="page">Pink Finds</span></nav><p class="life-kicker">The Friday email</p><h1>Your cart is already pink.<br /><span>Let's make it good.</span></h1><p class="life-intro">Outfits to play with, home details to borrow and pretty little finds, brought together in one email. See the styling ideas, then decide which listed pieces belong in your own version.</p></div></header>
  <section class="life-wrap life-signup" aria-label="Join Pink Finds"><PinkFindsSignup variant="box" id="join" /></section>
  <section class="life-wrap life-section" aria-labelledby="life-email-details"><h2 id="life-email-details">A little inspiration for Friday</h2><div class="life-email-details"><div><span class="life-sticker">01 · The whole idea</span><h3>See it together</h3><p>Outfits and room details with photographs for inspiration and a clear list of the shopping finds.</p></div><div><span class="life-sticker">02 · Your kind of pink</span><h3>Pick what suits you</h3><p>Borrow a whole arrangement or just one small detail. The extras from your own home can make it yours.</p></div><div><span class="life-sticker">03 · One email</span><h3>The Friday edit</h3><p>Pink Finds arrives on Friday. Unsubscribe whenever you want.</p></div></div></section>
  <section class="life-wrap life-section" aria-labelledby="life-email-preview"><div class="life-section-heading"><h2 id="life-email-preview">A peek at the edit</h2><a class="life-text-link" href="/lifestyle">Browse every article <span aria-hidden="true">→</span></a></div><Cards looks={latest} /></section>
</Frame>
