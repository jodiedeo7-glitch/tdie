---
// /lifestyle/pink-finds · signup page for the Friday Pink Finds email
// (Jodie, 25 Sep 2026; rebuilt in the new Lifestyle system 7 Oct 2026).
// This is the link on Instagram stories and Facebook first comments, so the
// address never changes. No affiliate links live on this page: the looks link
// to their own Lifestyle pages, which carry the Amazon disclosure.
// The form posts to MailerLite form 199525394616943647 (PinkFindsSignup).
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/lifestyle.css";
import LookCard from "../../components/lifestyle/LookCard.astro";
import PinkFindsSignup from "../../components/PinkFindsSignup.astro";
import { LOOKS } from "../../data/lifestyle.js";
const latest = LOOKS.slice(0, 4);
const og = latest[0]?.images[0]?.src?.src;
---
<PageLayout
  bare
  title="Pink Finds · The Friday Email"
  description="If your cart is already pink, this is for you. The week's new pink looks in one Friday email, every piece linked. Outfits, rooms, gifts."
  ogImage={og}
>
  <div class="lsx">
    <header class="lsx-mast">
      <div class="lsx-wrap lsx-mast-grid">
        <div>
          <p class="lsx-crumb"><a href="/lifestyle">Lifestyle</a><i aria-hidden="true">/</i><span>The Friday email</span></p>
          <h1>Your cart is already pink. <em>Let's make it good.</em></h1>
          <p class="lsx-lede">If you've scrolled past the same four viral dupes all month, this is for you. Every Friday I send the week's new looks, styled head to toe and linked piece by piece: outfits, dorm rooms, pretty home things, and the gift guides when the season turns.</p>
        </div>
        <div class="lsx-card lsx-signup" id="join">
          <PinkFindsSignup variant="strip" />
        </div>
      </div>
    </header>

    <section class="lsx-sec" aria-labelledby="h-gets">
      <div class="lsx-wrap">
        <div class="lsx-head"><h2 id="h-gets">What the email <em>is</em></h2></div>
        <ol class="lsx-gets">
          <li class="lsx-get lsx-card">
            <span class="lsx-n" aria-hidden="true">1</span>
            <h3>Whole looks, not random links</h3>
            <p>Every find arrives as a finished outfit or room, so you see it together before anything goes in your cart.</p>
          </li>
          <li class="lsx-get lsx-hot">
            <span class="lsx-n" aria-hidden="true" style="background:#fff;color:#B8245F">2</span>
            <h3>Pink, on purpose</h3>
            <p style="color:rgba(255,255,255,.94)">Hot pink, blush, candy, rose. If it's beige, it had to earn its spot.</p>
          </li>
          <li class="lsx-get lsx-card">
            <span class="lsx-n" aria-hidden="true">3</span>
            <h3>One email. Friday.</h3>
            <p>That's the whole deal. Unsubscribe with one click whenever you want.</p>
          </li>
        </ol>
      </div>
    </section>

    {latest.length > 0 && (
      <section class="lsx-sec" aria-labelledby="h-inbox">
        <div class="lsx-wrap">
          <div class="lsx-head">
            <h2 id="h-inbox">What lands in your inbox</h2>
            <a class="lsx-btn lsx-btn--soft" href="/lifestyle">See every look</a>
          </div>
          <ul class="lsx-grid">
            {latest.map((l) => <li><LookCard look={l} /></li>)}
          </ul>
        </div>
      </section>
    )}

    <section class="lsx-sec" aria-label="Join the Friday email">
      <div class="lsx-wrap">
        <div class="lsx-card lsx-signup"><PinkFindsSignup variant="box" /></div>
      </div>
    </section>

    <div class="lsx-foot">
      <div class="lsx-wrap">
        <p class="lsx-disclosure">The looks are styled on an AI model. The Lifestyle pages they link to contain Amazon affiliate links: as an Amazon Associate I earn from qualifying purchases, at no extra cost to you.</p>
      </div>
    </div>
  </div>
</PageLayout>
