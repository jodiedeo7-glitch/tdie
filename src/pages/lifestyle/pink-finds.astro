---
// /lifestyle/pink-finds (Jodie, 25 Sep 2026): the dedicated signup page
// for the Pink Finds Friday email. This is the link for Instagram
// stories, the Facebook group first comments and every "join the list"
// mention. No affiliate links live on this page; the looks link to their
// own Lifestyle pages, which carry the Amazon disclosure.
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/edit.css";
import { Image } from "astro:assets";
import PinkFindsSignup from "../../components/PinkFindsSignup.astro";
import { LOOKS, categoryOf } from "../../data/lifestyle.js";
const latest = LOOKS.slice(0, 6);
const og = latest[0]?.images[0]?.src?.src;
---
<PageLayout
  bare
  title="Pink Finds · The Friday Email"
  description="If your cart is already pink, this is for you. The week's new pink looks in one Friday email, every piece linked. Outfits, rooms, gifts."
  ogImage={og}
>
  <div class="ls pfp">
    <header class="pfp-mast">
      <div class="e-wrap pfp-mast-grid">
        <div>
          <p class="ls-crumb"><a href="/lifestyle">Lifestyle</a><span aria-hidden="true">/</span><span>The Friday email</span></p>
          <h1 class="e-d2">Your cart is already pink. <em>Let's make it good.</em></h1>
          <p class="e-lede">If you've scrolled past the same four viral dupes all month, this is for you. Every Friday I send the week's new looks, styled head to toe and linked piece by piece. Outfits, dorm rooms, pretty home things, and the gift guides when the season turns.</p>
        </div>
        <div class="pfp-join">
          <PinkFindsSignup variant="strip" id="join" />
        </div>
      </div>
    </header>

    <section class="e-wrap pfp-sec" aria-labelledby="h-gets">
      <h2 class="ls-sr" id="h-gets">What the email is</h2>
      <ol class="pfp-gets">
        <li>
          <span class="pfp-n" aria-hidden="true">01</span>
          <h3 class="pfp-t">Whole looks, not random links</h3>
          <p class="pfp-d">Every find arrives as a finished outfit or room, so you can see it together before anything goes in your cart.</p>
        </li>
        <li>
          <span class="pfp-n" aria-hidden="true">02</span>
          <h3 class="pfp-t">Pink, on purpose</h3>
          <p class="pfp-d">Hot pink, blush, candy, rose. If it's beige, it had to earn its spot.</p>
        </li>
        <li>
          <span class="pfp-n" aria-hidden="true">03</span>
          <h3 class="pfp-t">One email. Friday.</h3>
          <p class="pfp-d">That's the whole deal. Unsubscribe with one click whenever you want.</p>
        </li>
      </ol>
    </section>

    {latest.length > 0 && (
      <section class="e-wrap pfp-sec" aria-labelledby="h-inbox">
        <div class="ls-head-row">
          <h2 class="e-d3" id="h-inbox">What lands in your inbox</h2>
          <a class="e-link" href="/lifestyle">See every look <span aria-hidden="true">→</span></a>
        </div>
        <ul class="ls-grid">
          {latest.map((l) => (
            <li>
              <a class="ls-card" href={`/lifestyle/${l.slug}`}>
                <span class="ls-card-img">
                  <Image src={l.images[0].src} alt={l.images[0].alt || l.title} widths={[320, 480]} sizes="(max-width: 640px) 50vw, (max-width: 1100px) 33vw, 200px" />
                </span>
                <span class="e-credit ls-card-cat">{categoryOf(l.category)?.name}{l.season ? ` · ${l.season}` : ""}</span>
                <h3 class="ls-card-title">{l.title}</h3>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="e-wrap pfp-foot">
      <PinkFindsSignup variant="box" />
      <p class="ls-disclosure">The looks are styled on an AI model. The Lifestyle pages they link to contain Amazon affiliate links: as an Amazon Associate I earn from qualifying purchases, at no extra cost to you.</p>
    </div>
  </div>
</PageLayout>

<style is:global>
  .pfp .ls-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .pfp .ls-crumb{display:flex;flex-wrap:wrap;align-items:center;gap:0 10px;margin:0 0 14px;font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--e-ink-3)}
  .pfp .ls-crumb a{display:inline-flex;align-items:center;min-height:44px;color:var(--e-pink-t);text-decoration:none}
  .pfp .ls-crumb a:hover{text-decoration:underline;text-underline-offset:4px}
  .pfp .ls-crumb [aria-hidden]{color:var(--e-gold)}
  .pfp .pfp-mast{padding:clamp(40px,6vw,88px) 0 clamp(56px,8vw,104px)}
  .pfp .pfp-mast-grid{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(32px,6vw,88px);align-items:end}
  .pfp h1{max-width:12em}
  .pfp .pfp-mast .e-lede{margin:0}
  .pfp .pfp-join .pf-strip{border:1px solid var(--e-line);border-top:3px solid var(--e-pink);border-radius:0}
  .pfp .pfp-join .pf-strip .pf-form{grid-template-columns:1fr;gap:18px}
  .pfp .pfp-sec{margin-bottom:clamp(64px,9vw,120px)}
  .pfp .pfp-gets{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--e-ink)}
  .pfp .pfp-gets li{display:flex;flex-direction:column;padding:26px 28px 6px 0}
  .pfp .pfp-gets li + li{padding-left:28px;border-left:1px solid var(--e-line)}
  .pfp .pfp-n{font-family:var(--e-serif);font-weight:600;font-size:15px;color:var(--e-pink-t);margin-bottom:10px}
  .pfp .pfp-t{font-size:clamp(22px,2.2vw,26px);line-height:1.15;margin:0 0 10px}
  .pfp .pfp-d{font-size:15.5px;line-height:1.6;color:var(--e-ink-2);margin:0}
  .pfp .ls-head-row{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:12px 40px;padding-bottom:18px;margin-bottom:clamp(24px,3vw,36px);border-bottom:1px solid var(--e-ink)}
  .pfp .ls-head-row .e-d3{margin:0}
  .pfp .ls-grid{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:28px clamp(14px,1.6vw,22px)}
  .pfp .ls-card{display:flex;flex-direction:column;text-decoration:none;color:var(--e-ink)}
  .pfp .ls-card-img{display:block;overflow:hidden;border-radius:4px;background:var(--e-paper);aspect-ratio:2/3}
  .pfp .ls-card-img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.7,.2,1)}
  .pfp .ls-card:hover .ls-card-img img{transform:scale(1.035)}
  .pfp .ls-card-cat{margin-top:12px;font-size:10.5px;letter-spacing:.12em}
  .pfp .ls-card-title{font-family:var(--e-serif);font-weight:600;font-size:18px;line-height:1.2;letter-spacing:-.015em;margin:6px 0 0}
  .pfp .ls-card:hover .ls-card-title{color:var(--e-pink-t);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:4px}
  .pfp .ls-card:focus-visible{outline:3px solid var(--e-pink);outline-offset:6px}
  .pfp .pfp-foot{padding-bottom:clamp(56px,8vw,104px)}
  .pfp .ls-disclosure{margin:clamp(40px,5vw,64px) 0 0;padding-top:20px;border-top:var(--e-hair);font-size:13.5px;line-height:1.65;color:var(--e-ink-3);max-width:60em}
  @media(max-width:1100px){.pfp .ls-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
  @media(max-width:860px){
    .pfp .pfp-mast-grid{grid-template-columns:1fr}
    .pfp .pfp-gets{grid-template-columns:1fr}
    .pfp .pfp-gets li,.pfp .pfp-gets li + li{padding:22px 0 8px;border-left:0}
    .pfp .pfp-gets li + li{border-top:1px solid var(--e-line)}
  }
  @media(max-width:640px){.pfp .ls-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:28px 14px}.pfp .ls-card-title{font-size:17px}}
  @media(prefers-reduced-motion:reduce){.pfp .ls-card-img img{transition:none}.pfp .ls-card:hover .ls-card-img img{transform:none}}
</style>
