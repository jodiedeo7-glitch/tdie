---
import Frame from '../../components/lifestyle/Frame.astro';
import Article from '../../components/lifestyle/Article.astro';
import Cards from '../../components/lifestyle/Cards.astro';
import Categories from '../../components/lifestyle/Categories.astro';
import { CATEGORIES, LOOKS, DRAFT_LOOKS } from '../../data/lifestyle.js';
export function getStaticPaths() {
  return [...CATEGORIES.map(category => ({ params: { slug: category.slug }, props: { category } })), ...[...LOOKS, ...DRAFT_LOOKS].map(look => ({ params: { slug: look.slug }, props: { look } }))];
}
const { category, look } = Astro.props;
const articles = category ? LOOKS.filter(article => article.category === category.slug) : [];
---
{look ? <Article look={look} /> : <Frame title={`${category.name} · The Lifestyle Edit`} description={category.blurb}>
  <header class="life-category-hero"><div class="life-wrap"><nav class="life-breadcrumb" aria-label="Breadcrumb"><a href="/lifestyle">Lifestyle</a><span aria-hidden="true">/</span><span aria-current="page">{category.name}</span></nav><p class="life-kicker">Your corner of the edit</p><h1>{category.name}</h1><p class="life-intro">{category.blurb}</p><span class="life-sticker">{articles.length ? `${articles.length} article${articles.length === 1 ? '' : 's'} to explore` : 'Room for something lovely'}</span></div></header>
  <section class="life-wrap life-section" aria-labelledby="life-category-articles"><h2 id="life-category-articles">{articles.length ? `The ${category.name.toLowerCase()} edit` : 'Still collecting'}</h2>{articles.length ? <Cards looks={articles} /> : <div class="life-empty"><p>There are no articles in this category yet. For now, take a look at the outfits, home details and everyday finds already in the edit.</p><a class="life-button" href="/lifestyle#browse">Browse the current articles <span aria-hidden="true">→</span></a></div>}</section>
  <section class="life-band"><div class="life-wrap life-section"><h2>Try another corner</h2><Categories current={category.slug} /></div></section>
</Frame>}
