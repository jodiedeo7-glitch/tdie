---
// /lifestyle/<department> and /lifestyle/<look> (rebuilt 7 Oct 2026).
// Look page order follows the WYS founder output structure: eyebrow back to its
// department, the title as H1, the intro, a one-line affiliate notice, the two
// founder pin images, "Shop the look" (numbered, every piece linked), the
// Idea List button, then up to 4 more looks from the same department.
// A department with no looks yet is noindex and is left out of the sitemap.
import PageLayout from "../../layouts/PageLayout.astro";
import "../../styles/lifestyle.css";
import { Image } from "astro:assets";
import LookCard from "../../components/lifestyle/LookCard.astro";
import LifestyleOffers from "../../components/lifestyle/LifestyleOffers.astro";
import LifestyleFoot from "../../components/lifestyle/LifestyleFoot.astro";
import PinkFindsSignup from "../../components/PinkFindsSignup.astro";
import WysPromo from "../../components/WysPromo.astro";
import { CATEGORIES, LOOKS, looksIn, categoryOf, DISCLOSURE, REL } from "../../data/lifestyle.js";

export function getStaticPaths() {
  return [
    ...CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { kind: "category", category: c } })),
    ...LOOKS.map((l) => ({ params: { slug: l.slug }, props: { kind: "look", look: l } })),
  ];
}

const { kind, category, look } = Astro.props;
const catLooks = kind === "category" ? looksIn(category.slug) : [];
const cat = kind === "look" ? categoryOf(look.category) : category;
const more = kind === "look" ? looksIn(look.category).filter((l) => l.slug !== look.slug).slice(0, 4) : [];
const others = kind === "category" && !catLooks.length ? LOOKS.slice(0, 4) : [];
const pad = (n) => String(n).padStart(2, "0");
// Meta description: the intro cut to 155 characters at a word boundary.
const cut = (s, n = 155) => (s.length <= n ? s : s.slice(0, s.lastIndexOf(" ", n - 1)).replace(/[,;:.\s]+$/, "") + "…");
const caption = (im) => (im.persona ? "Styled on Tommy Kate, my AI model" : "The pieces, styled together");
---
{kind === "category" ? (
  <PageLayout
    bare
    title={`${category.name} · Pink Amazon Finds`}
    description={`${category.blurb} Styled looks with every piece linked on Amazon.`}
    noindex={!catLooks.length}
    ogImage={catLooks[0]?.images[0]?.src?.src}
  >
    <div class="lsx">
      <header class="lsx-lookhead">
        <div class="lsx-wrap">
          <p class="lsx-crumb"><a href="/lifestyle">Lifestyle</a><i aria-hidden="true">/</i><span>Department</span></p>
          <h1>{category.name}</h1>
          <p class="lsx-lede">{category.blurb}</p>
          <p class="lsx-meta">{catLooks.length ? `${catLooks.length} look${catLooks.length === 1 ? "" : "s"}` : "Filling up now"}<i aria-hidden="true"></i>Every piece linked on Amazon<i aria-hidden="true"></i>No prices, ever</p>
        </div>
      </header>

      <section class="lsx-sec" aria-labelledby="h-looks">
        <div class="lsx-wrap">
          {catLooks.length ? (
            <>
              <div class="lsx-head">
                <h2 id="h-looks">Every {category.name.toLowerCase()} look</h2>
                <p class="lsx-callout"><span class="lsx-tag">Affiliate</span> Every piece links to Amazon. The full disclosure is at the foot of the page.</p>
              </div>
              <ul class="lsx-grid">
                {catLooks.map((l, i) => <li><LookCard look={l} showCat={false} eager={i < 4} /></li>)}
              </ul>
            </>
          ) : (
            <>
              <div class="lsx-card lsx-empty">
                <p id="h-looks">The first {category.name.toLowerCase()} looks are on their way.</p>
              </div>
              {others.length > 0 && (
                <div style="margin-top:40px">
                  <div class="lsx-head"><h2>Shop the newest looks meanwhile</h2></div>
                  <ul class="lsx-grid">
                    {others.map((l) => <li><LookCard look={l} /></li>)}
                  </ul>
                </div>
              )}
            </>
          )}
        </div>
      </section>

      <section class="lsx-sec" aria-label="The Friday email">
        <div class="lsx-wrap">
          <div class="lsx-card lsx-signup"><PinkFindsSignup variant="strip" /></div>
          <div style="margin-top:20px"><WysPromo variant="strip" seed={category.slug} /></div>
        </div>
      </section>

      <LifestyleOffers />
      <LifestyleFoot />
    </div>
  </PageLayout>
) : (
  <PageLayout
    bare
    title={look.title}
    description={cut(look.intro)}
    ogImage={look.images[0].src.src}
  >
    <article class="lsx">
      <header class="lsx-lookhead">
        <div class="lsx-wrap">
          <p class="lsx-crumb">
            <a href="/lifestyle">Lifestyle</a><i aria-hidden="true">/</i><a href={`/lifestyle/${cat.slug}`}>{cat.name}</a><i aria-hidden="true">/</i><span>{look.season}</span>
          </p>
          <h1>{look.title}</h1>
          <p class="lsx-lede">{look.intro}</p>
          <p class="lsx-callout"><span class="lsx-tag">Affiliate</span> <span>Every link below goes to Amazon. {DISCLOSURE.split(". ")[0]}.</span></p>
        </div>
      </header>

      <div class="lsx-wrap lsx-lookbody">
        <div class="lsx-pins">
          {look.images.map((im, i) => (
            <figure class="lsx-pin">
              <Image class="lsx-pin-img" src={im.src} alt={im.alt || look.title} widths={[400, 600, 1000]} sizes="(max-width: 640px) 92vw, (max-width: 900px) 46vw, 340px" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : "auto"} />
              <span class="lsx-tag lsx-tag--hot">{pad(i + 1)}</span>
              <figcaption><b>{caption(im)}.</b> AI styling photo; the linked pieces may look slightly different.</figcaption>
            </figure>
          ))}
        </div>

        <aside class="lsx-shop lsx-card" aria-labelledby="h-shop">
          <span class="lsx-kick">{look.items.length} pieces</span>
          <h2 id="h-shop">Shop the look</h2>
          <p class="lsx-shop-sub">Tap any piece. Each one opens on Amazon in a new tab.</p>
          <ol class="lsx-items">
            {look.items.map((it, i) => (
              <li class="lsx-item">
                <span class="lsx-n" aria-hidden="true">{i + 1}</span>
                <span class="lsx-item-main">
                  <a href={it.link} rel={REL} target="_blank">{it.name}<span class="lsx-sr"> (Amazon affiliate link, opens in a new tab)</span></a>
                  {it.note && <span class="lsx-item-note">{it.note}</span>}
                </span>
                <span class="lsx-item-go" aria-hidden="true">Shop</span>
              </li>
            ))}
          </ol>
          {look.listLink && (
            <a class="lsx-btn" href={look.listLink} rel={REL} target="_blank">Shop every piece on Amazon<span class="lsx-sr"> (affiliate link, opens in a new tab)</span></a>
          )}
          <p class="lsx-shop-note">No prices here on purpose: Amazon changes them by the hour, so the list always shows today's.</p>
          <div class="lsx-side"><WysPromo seed={look.slug} /></div>
        </aside>
      </div>

      {more.length > 0 && (
        <section class="lsx-sec" aria-labelledby="h-more">
          <div class="lsx-wrap">
            <div class="lsx-head">
              <h2 id="h-more">More {cat.name.toLowerCase()}</h2>
              <a class="lsx-btn lsx-btn--soft" href={`/lifestyle/${cat.slug}`}>Every {cat.name.toLowerCase()} look</a>
            </div>
            <ul class="lsx-grid">
              {more.map((l) => <li><LookCard look={l} showCat={false} /></li>)}
            </ul>
          </div>
        </section>
      )}

      <section class="lsx-sec" aria-label="The Friday email">
        <div class="lsx-wrap">
          <div class="lsx-card lsx-signup"><PinkFindsSignup variant="strip" /></div>
        </div>
      </section>

      <LifestyleOffers />
      <LifestyleFoot />
    </article>
  </PageLayout>
)}
