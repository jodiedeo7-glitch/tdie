---
// The Pinterest Keyword Planner, rebuilt 20 Nov 2026 on Jodie's Etsy template.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import { membership } from "../../data/facts.js";

// Pinterest Foundations™: canon products[] row, $27 one-time on Skool, also
// included with Membership Standard (inclusion, not a ladder rung).
const FOUNDATIONS = "https://www.skool.com/thedigitalincomeedit/classroom/ede8aaca?md=63eb80fb5d114f77870c962337a58a1b";
const PDF = "/pinterest-keyword-planner.pdf";

const inside = [
  "The four-step keyword method, start to finish",
  "The autocomplete check that separates real searches from guesses",
  "A ten-slot seed word page to start from",
  "A 50-row keyword bank, grouped into your future boards",
];

const steps = [
  { t: "Start with seed words", p: "The obvious phrases for your niche. Ten is plenty." },
  { t: "Check autocomplete", p: "Type each one into the Pinterest search bar and record what autocomplete suggests. Those suggestions are real searches." },
  { t: "Click the guided tiles", p: "Click the guided search tiles across the top of the results for more related keywords." },
  { t: "Aim for 30 to 50", p: "That's plenty to start. Favor specific, longer phrases over broad ones." },
];
---
<TemplateLayout title="The Pinterest Keyword Planner" description="A free planner that takes you from seed words to a bank of 30-50 verified Pinterest keywords, grouped into the topics that become your boards." stickyHref={PDF} stickyLabel="Download the free planner">

<section class="hh">
 <div class="wrap hh-grid bp2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Free<b class="big">planner</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Free planner · Pinterest</p>
   <h1>The Pinterest <span class="scr">Keyword Planner</span></h1>
   <p class="what">Keywords are the load-bearing wall of everything on Pinterest. <b>This is where you build yours.</b></p>
   <a class="btn buy" href={PDF} download>Download the free planner <span class="ar">→</span></a>
   <p class="see">6 pages · Printable PDF · Free</p>
  </div>
  <figure class="bp2-fig"><div class="hh-ph"><img src="/images/pages/keyword-planner-phone-560.webp" srcset="/images/pages/keyword-planner-phone-560.webp 560w, /images/pages/keyword-planner-phone-900.webp 900w" sizes="(max-width: 900px) 80vw, 340px" width="560" height="700" fetchpriority="high" decoding="async" alt="A hand holding a phone with a pink case showing a grid of Pinterest pins, in a bright home office with a round wooden desk, pink peonies and a blush armchair."></div><figcaption class="ab2-cap"><b>Search first</b> · then design the pin</figcaption></figure>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Why it works</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">Keyword first. <span class="scr">Then the pin.</span></h2>
  <div class="card dash bp2-who">
   <p><b>Most Pinterest accounts are flat because of a keyword problem wearing a design costume. The pins look fine. Nobody is searching the words on them.</b></p>
   <p>This planner fixes the order of operations. You choose the keyword first, then you design the pin, never the reverse.</p>
   <p>It's the worksheet system from inside Pinterest Foundations™, extracted and given away. Fill it once per content pillar and you'll never stare at a blank pin description again.</p>
   <p class="sm2-h">What's inside</p>
   <ul class="chk">{inside.map((x) => <li>{x}</li>)}</ul>
   <a class="btn buy sm2-btn" href={PDF} download>Download the PDF <span class="ar">→</span></a>
   <p class="bp2-alt" style="text-align:center">Six pages. Print it, or fill it on screen. No email required, it's just yours.</p>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">How to use it</p>
  <h2 class="h2">Four steps, <span class="scr">in order.</span></h2>
  <div class="p18 hm-four">{steps.map((s, i) => <div class="box"><span class="num hm-num">{String(i + 1).padStart(2, "0")}</span><h3>{s.t}</h3><p>{s.p}</p></div>)}</div>
  <p class="bm2-hit">Verify as you go. If a keyword shows up in Pinterest's autocomplete, real people search it: keep it. If nothing comes up, skip it, however clever the phrase is.</p>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">Going further</p>
  <h2 class="h2">When you want <span class="scr">the turn&#8209;by&#8209;turn.</span></h2>
  <div class="lead"><p>This planner is Lesson 3 of Pinterest Foundations™, the full course this brand teaches Pinterest through, from account architecture to keyword systems to pin production, in sequence, inside the classroom.</p></div>
  <div class="ab2-rooms">
   <a class="card dash" href={FOUNDATIONS} rel="noopener"><span class="hm-lab">$27 · Yours permanently</span><h3>Pinterest Foundations™</h3><p>Standalone, or included with Membership Standard at {membership.standard.perMonth}. Already a Standard member? The whole course is waiting in your classroom.</p><span class="btn">See the course <span class="ar">→</span></span></a>
   <a class="card dash" href="/learn/complete-pinterest-marketing-guide"><span class="hm-lab">The full guide</span><h3>The Complete Pinterest Marketing Guide</h3><p>Account setup, pins, publishing rhythm, and the funnel.</p><span class="btn">Read the guide <span class="ar">→</span></span></a>
   <a class="card dash" href="/resources/faceless-income-blueprint"><span class="hm-lab">FREE GUIDE</span><h3>See the whole machine on one page.</h3><p>Pinterest is the traffic. The Faceless Income Blueprint™ shows where that traffic goes and what to build first. Fifteen pages, free.</p><span class="btn">Get the free Blueprint <span class="ar">→</span></span></a>
  </div>
  <p class="see" style="text-align:center;margin-top:30px"><a href="/resources">← All free resources</a></p>
 </div>
</section>
</TemplateLayout>
