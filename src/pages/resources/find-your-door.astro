        ["I'll end up having to show my face", "Having to show my face", {P:1}, "face"],
        ["I don't have enough material", "Not having enough material", {V:1,K:1}, "material"],
        ["I'll start strong and quit by week three", "Starting strong and quitting by week three", {P:2}, "quit"] ] },
      { sec: "What you've tried", q: "What have you already tried?", sub: "Pick everything that applies.", k: "tried", multi: true, o: [
        ["Bought courses I didn't finish", "Unfinished courses", {P:1}],
        ["Posted daily until I burned out", "Posting daily until burnout", {P:2}],
        ["Opened a shop and stocked it by hand", "Stocking a shop by hand", {V:2}],
        ["Started a blog and abandoned it", "An abandoned blog", {W:2}],
        ["Tried to start a group", "Trying to start a group", {K:2}],
        ["Joined a community and mostly lurked", "Lurking in a community", {S:1,K:1}],
        ["Nothing yet", "Nothing yet", {S:1}, "none"] ] },
      { sec: "How you work", q: "How do you want help to arrive?", k: "style", o: [
        ["Teach me the whole thing, in order", "Taught in order", {S:3}],
        ["Write it for me — I'll press publish", "Written for me", {P:3}],
        ["Hand me finished pieces I can rebrand", "Finished pieces to rebrand", {V:3}],
        ["Walk me through one build, once, and I own it", "One build I own", {W:3}],
        ["Show me how to build the exact thing I want", "The exact thing I want, shown", {K:2}] ] },
      { sec: "How you work", q: "How many hours a week can you honestly give this?", k: "time", o: [
        ["Under 3", "Under 3 hours a week", {P:2,V:1,S:-1}, "t1"],
        ["3 to 7", "3–7 hours a week", {V:1,S:1}, "t2"],
        ["7 to 15", "7–15 hours a week", {S:1,K:1}, "t3"],
        ["15 or more — or one clear weekend", "15+ hours, or a clear weekend", {W:2}, "t4"] ] },
      { sec: "How you work", q: "How do you prefer to pay for help?", k: "pay", o: [
        ["Monthly — and I want to try it free first", "Monthly, with a free trial", {S:2,P:2}],
        ["Once, and then it's mine", "Once, and it's mine", {W:2,K:2}],
        ["A small monthly fee for fresh stock", "Small monthly, for fresh stock", {V:3}] ] },
      { sec: "Where it stops", q: "A stranger Googles the exact thing you know. What do they find?", k: "google", o: [
        ["Nothing — I don't have a thing to be found for yet", "Nothing yet", {S:2}],
        ["Someone else, explaining what I already taught", "Someone else", {W:3}],
        ["A listing of mine, maybe", "A listing, maybe", {V:2}],
        ["Someone else's community", "Someone else's community", {K:2}],
        ["My last post, if they're lucky", "My last post", {P:2}] ] },
      { sec: "The last one", q: "What would you pay to never do again?", sub: "This one breaks ties. Go with your gut.", k: "never", o: [
        ["Make a product from scratch", "Make a product from scratch", {V:3}, null, "V"],
        ["Stare at an empty caption box", "Stare at an empty caption box", {P:3}, null, "P"],
        ["Wonder whether I'm \u201cready\u201d to lead", "Wonder whether I'm ready to lead", {K:3}, null, "K"],
        ["Figure out the order of operations alone", "Figure out the order alone", {S:3}, null, "S"],
        ["Start from zero every time the algorithm moves", "Start from zero every algorithm change", {W:3}, null, "W"] ] }
    ];

    var i = 0, ans = [], cur = null;
    var $ = function(id){ return document.getElementById(id); };
    var quiz = $("fd-quiz"), result = $("fd-result");

    function render(){
      var q = QS[i];
      $("fd-count").textContent = "Question " + (i+1) + " of " + QS.length;
      $("fd-bar").style.width = (i / QS.length * 100) + "%";
      $("fd-sec").textContent = q.sec;
      $("fd-q").textContent = q.q;
      $("fd-qsub").textContent = q.sub || "";
      var box = $("fd-opts"); box.innerHTML = "";
      box.setAttribute("role", q.multi ? "group" : "radiogroup");
      var picked = ans[i] || [];
      q.o.forEach(function(opt, n){
        var b = document.createElement("button");
        b.type = "button"; b.className = "fd-opt" + (q.multi ? " fd-multi" : "");
        b.textContent = opt[0];
        b.setAttribute("aria-pressed", picked.indexOf(n) > -1 ? "true" : "false");
        if (picked.indexOf(n) > -1) b.classList.add("on");
        b.onclick = function(){
          if (!q.multi) {
            ans[i] = [n]; b.classList.add("on");
            setTimeout(next, 220);
            return;
          }
          var sel = (ans[i] || []).slice();
          var isNone = opt[3] === "none";
          var at = sel.indexOf(n);
          if (at > -1) sel.splice(at, 1);
          else if (isNone) sel = [n];
          else { sel = sel.filter(function(x){ return q.o[x][3] !== "none"; }); sel.push(n); }
          ans[i] = sel;
          render();
        };
        box.appendChild(b);
      });
      $("fd-back").hidden = i === 0;
      $("fd-next").hidden = !q.multi;
      $("fd-next").disabled = q.multi && !(ans[i] && ans[i].length);
    }

    function next(){ i++; i < QS.length ? render() : finish(); }

    function pick(k){ var q = QS.filter(function(x){ return x.k === k; })[0]; var idx = QS.indexOf(q); return q.o[(ans[idx] || [0])[0]]; }

    function finish(){
      var score = {S:0,P:0,V:0,W:0,K:0};
      ans.forEach(function(sel, qi){ (sel || []).forEach(function(n){
        var w = QS[qi].o[n][2]; for (var d in w) score[d] += w[d];
      }); });
      var order = ["S","P","W","V","K"];
      var top = Math.max.apply(null, order.map(function(d){ return score[d]; }));
      var tied = order.filter(function(d){ return score[d] === top; });
      var neverDoor = pick("never")[4];
      var stuckQ = pick("stuck"), stuckDoor = null, sw = stuckQ[2], best = -99;
      for (var d0 in sw) if (sw[d0] > best) { best = sw[d0]; stuckDoor = d0; }
      var door = tied.indexOf(neverDoor) > -1 ? neverDoor : (tied.indexOf(stuckDoor) > -1 ? stuckDoor : tied[0]);
      var D = DOORS[door];

      var stage = pick("stage")[1], goal = pick("goal")[1], stuck = stuckQ[1];
      var fearOpt = pick("fear"), timeOpt = pick("time");
      var reframe = FEARS[fearOpt[3]];
      var timeLine = TIME[timeOpt[3]];

      $("fd-r-name").textContent = D.name;
      $("fd-r-price").textContent = D.price;
      $("fd-r-why").textContent = D.why;
      $("fd-read-stage").textContent = stage;
      $("fd-read-goal").textContent = goal;
      $("fd-read-stuck").textContent = stuck;
      $("fd-read-fear").textContent = fearOpt[1];
      $("fd-reframe").textContent = reframe;
      var ol = $("fd-r-list"); ol.innerHTML = "";
      D.moves.forEach(function(t){ var li = document.createElement("li"); li.textContent = t; ol.appendChild(li); });
      $("fd-r-time").textContent = timeLine;
      var btn = $("fd-r-btn");
      btn.href = D.href; $("fd-r-cta").textContent = D.cta;
      if (D.aff) btn.setAttribute("rel", "sponsored nofollow"); else btn.removeAttribute("rel");
      $("fd-r-later").textContent = D.later;
      var alt = $("fd-r-alt"); alt.innerHTML = "";
      if (D.alt) {
        alt.appendChild(document.createTextNode(D.alt.pre));
        var al = document.createElement("a"); al.href = D.alt.href; al.textContent = D.alt.label;
        if (D.alt.aff) al.setAttribute("rel", "sponsored nofollow");
        alt.appendChild(al); alt.appendChild(document.createTextNode(D.alt.post));
        if (D.alt.more) {
          alt.appendChild(document.createTextNode(D.alt.more.pre));
          var am = document.createElement("a"); am.href = D.alt.more.href; am.textContent = D.alt.more.label;
          alt.appendChild(am); alt.appendChild(document.createTextNode(D.alt.more.post));
        }
        alt.hidden = false;
      } else { alt.hidden = true; }
      $("fd-send-h").textContent = "Weekly emails, pointed at " + D.name;

      window.__fdResult = { door: door, stage: stage, goal: goal, stuck: stuck, fear: fearOpt[1],
        reframe: reframe, first_move: D.moves[0], time: timeOpt[1] };

      $("fd-bar").style.width = "100%";
      quiz.hidden = true; result.hidden = false;
      $("fd-send-msg").textContent = "";
      result.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    var form = $("fd-send");

    form.onsubmit = function(e){
      e.preventDefault();
      var msg = $("fd-send-msg"), btn = form.querySelector("button");
      var body = Object.assign({}, window.__fdResult || {}, {
        name: form.elements.namedItem("name").value, email: form.elements.namedItem("email").value, hp: form.elements.namedItem("hp").value
      });
      btn.disabled = true; msg.textContent = "Subscribing…";
      fetch("/api/quiz-result", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) })
        .then(function(r){ return r.json().then(function(j){ return { ok: r.ok, j: j }; }); })
        .then(function(x){
          msg.textContent = x.ok ? "You're on the list. This screen is the only copy of your result — screenshot it before you go." : (x.j.error || "Couldn't add you to the list just now. Try again in a moment.");
          if (!x.ok) btn.disabled = false;
        })
        .catch(function(){ msg.textContent = "Couldn't add you to the list just now. Try again in a moment."; btn.disabled = false; });
    };

    $("fd-next").onclick = function(){ if (ans[i] && ans[i].length) next(); };
    $("fd-back").onclick = function(){ if (i > 0) { i--; render(); } };
    $("fd-retake").onclick = function(){
      i = 0; ans = []; result.hidden = true; quiz.hidden = false;
      form.querySelector("button").disabled = false;
      render(); quiz.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    document.querySelectorAll(".fd-stall").forEach(function(s){
      s.onclick = function(){
        var open = s.classList.toggle("open");
        s.setAttribute("aria-expanded", open ? "true" : "false");
      };
    });

    if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function(es){
        es.forEach(function(e){ if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { threshold: .12 });
      document.querySelectorAll(".fd-rv").forEach(function(el){ io.observe(el); });
    } else {
      document.querySelectorAll(".fd-rv").forEach(function(el){ el.classList.add("in"); });
    }

    render();
  })();
  </script>

