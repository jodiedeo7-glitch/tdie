           cta: "See Earn With Skool (SCC)", href: "/go/earn-with-skool-scc", aff: true,
           alt: { pre: "Already know how you'd run it? ", label: "Open your own group on Skool", post: " — Skool sets its own plan prices. That link is a referral too; same disclosure as above.", href: "https://www.skool.com/signup?ref=97643519c9b448d0a683ab33b6cc68ce", aff: true },
           later: "Once the group exists, The Weekend Ecosystem™ gives it a front door on Google." }
    };
    // Vault is never paired with a membership door (comparison-frame rule).
    var NO_PAIR = { V: ["S","P"], S: ["V"], P: ["V"] };

    var FEARS = {
      expert: "Nobody in a niche asks for credentials. They ask whether you're one step ahead of them. Be useful in public, specifically, for long enough — authority is just what people call that afterwards.",
      nobody: "Nobody comes to an announcement. People come to a door that's been open a while. Build the thing that keeps working after you publish it, and \u201cnobody came\u201d stops being a one-day verdict.",
