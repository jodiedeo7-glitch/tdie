        ["I'm not expert enough to be taken seriously", "Not being expert enough", {K:1,S:1}, "expert"],
        ["I'll build it and nobody will come", "Building it and nobody coming", {K:1,S:1}, "nobody"],
        ["The tech will beat me", "The tech beating me", {P:1,V:1}, "tech"],
