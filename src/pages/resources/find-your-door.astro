           moves: ["Friday night: list everything you've already made — you'll find more than you expect", "Saturday: your site goes live and your best lessons become articles", "Sunday: email capture, offers on every article, and the system that keeps it running"],
           cta: "See The Weekend Ecosystem™", href: "/shop/weekend-ecosystem", aff: false,
           alt: { pre: "Want to see it before you decide? ", label: "Look inside the course first", post: " — a proper look inside, no email needed.", href: "/weekend-ecosystem/preview" },
           later: "When the site needs feeding every month, Membership Premium writes the content." },
      K: { name: "Earn With Skool (SCC)", price: "$97 one-time · recommended, not mine",
