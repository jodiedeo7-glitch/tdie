    var TIME = {
      t1: "At under three hours a week, protect one fixed block — same day, same hour — and give it to move one only. Momentum beats volume at your pace.",
      t2: "At three to seven hours a week, give each move its own week. You'll be through all three inside a month.",
      t3: "At seven to fifteen hours a week, you can do moves one and two this week. Leave the third for next week so it gets your full attention.",
      t4: "With fifteen-plus hours or a clear weekend, do all three before Monday. Then spend next week fixing only what broke."
    };

    // [label, value (what we store), weights]
    var QS = [
      { sec: "Where you are", q: "Where are you, honestly?", k: "stage", o: [
        ["Nothing built yet — I'm still circling an idea", "Circling an idea, nothing built yet", {S:3,W:-2}],
        ["I've made something, but I haven't sold it", "Built something, not selling yet", {S:2,V:1}],
        ["I'm selling, just not consistently", "Selling, but not consistently", {P:2,V:1}],
        ["I have a real body of work — lessons, guides, years of posts", "Sitting on a real body of work", {W:3}],
        ["I already run a community or a course", "Already running a room of my own", {W:3,P:1}],
        ["I help in other people's communities, but haven't opened my own", "Helping in other people's rooms", {K:3}] ] },
      { sec: "What you want", q: "Twelve months from now, what has to be true?", k: "goal", o: [
        ["I've made sales from something I built", "Sales from something I built", {S:3,V:1}],
