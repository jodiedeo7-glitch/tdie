---
import PageLayout from "../../layouts/PageLayout.astro";
import Testimonial from "../../components/Testimonial.astro";
import { membership as M } from "../../data/facts.js";

// ─────────────────────────────────────────────────────────────
// FIND YOUR DOOR — the central free routing guide.
// Every name, price and URL below is copied from a live page:
//   Membership  → src/pages/membership.astro (Standard $9, Premium $35, 7-day trial)
//   WE          → src/pages/shop/weekend-ecosystem.astro (sales page owns its CTA + sale state)
//   Vault       → src/pages/shop/pretty-and-paid-plr-vault.astro ($11/month, own subscription)
//   Earn With Skool (SCC) → src/pages/go/earn-with-skool-scc.astro (affiliate, $97)
// Standing Rule 18: the affiliate door ships link + rel="sponsored" + disclosure together.
// Comparison-frame rule: Pretty & Paid PLR Vault™ is never paired with a membership door.
// Results show on screen for everyone, and stay there — nothing is emailed.
// 24 Sep 2026: quiz-specific Skool UTM, WE payment plan, free/secondary step (alt) on S, W and K results. S also offers The First Product Cheat Sheet.
// The form under the result subscribes to the weekly list, tagged with the door
// the quiz landed on. It posts to /api/quiz-result, which needs MAILERLITE_API_KEY.
// ─────────────────────────────────────────────────────────────

const SKOOL = "https://www.skool.com/thedigitalincomeedit/plans?utm_source=site&utm_medium=quiz&utm_campaign=find-your-door";
const WE = "/shop/weekend-ecosystem";
const VAULT = "/shop/pretty-and-paid-plr-vault";
const SCC = "/go/earn-with-skool-scc";

const stalls = [
  { n: "01", t: "No map", p: "You know a hundred things about online business and can't say which one comes first. That isn't a knowledge problem. It's a sequence problem.", d: "Membership Standard", k: "S" },
  { n: "02", t: "Nothing to post", p: "The business works. The calendar doesn't. You are one missed Tuesday away from going quiet for a month.", d: "Membership Premium", k: "P" },
  { n: "03", t: "Nothing on the shelf", p: "The shop is open and half-empty, and every new product starts on a blank Canva page.", d: "Pretty & Paid PLR Vault™", k: "V" },
  { n: "04", t: "No front door", p: "Years of lessons, calls and guides — all of it behind a login. A stranger can't find a word of it.", d: "The Weekend Ecosystem™", k: "W" },
  { n: "05", t: "No room of your own", p: "You're the one answering questions in other people's groups. You've just never opened your own.", d: "Earn With Skool (SCC)", k: "K" },
];

const stats = [
  { n: "14", l: "Free step-by-step guides in The Library" },
  { n: "22", l: "Modules in The Weekend Ecosystem™" },
  { n: "31", l: "Days of content, released a week at a time around the 1st" },
  { n: "20", l: "New rebrandable products added every month" },
];
---
<PageLayout
  wide
  title="Find Your Door — Free Guide"
  description="A free eleven-question guide. Tell me where you are and where it stops, and I'll point you to the one next step built for it. No email needed."
>
  <div class="fd">

  <!-- HERO -->
  <section class="fd-hero">
    <a class="page-eyebrow" href="/resources">Free Guide · The Digital Income Edit™</a>
    <h1>You don't need another free guide.<br /><em>You need the right door.</em></h1>
    <p class="fd-lede">You've probably saved enough tutorials to build three businesses. The problem isn't information. It's knowing which move matters <em>now</em>.</p>
    <p class="fd-lede fd-lede-small">Answer eleven questions about what you've built, what's stuck, and what you actually want. I'll point you to one next step — not five more things to buy. About three minutes, and you see the answer on screen.</p>
    <div class="fd-row"><a class="btn" href="#quiz">Find my door <span class="a">→</span></a></div>
    <div class="fd-meta"><span>11 questions</span><span class="b"></span><span>Results on screen</span><span class="b"></span><span>One answer</span></div>
  </section>

  <!-- THESIS -->
  <section class="fd-block fd-thesis fd-rv">
    <div class="fd-thesis-grid">
      <figure class="fd-fig">
        <img src="/images/pages/skool-group.webp" alt="The Digital Income Edit™ group on Skool" loading="lazy" decoding="async" />
        <figcaption>The real group on Skool</figcaption>
      </figure>
      <div>
        <h2>I don't sell courses <em>about</em> a business. I sell the parts of mine.</h2>
        <p>Every door on this page is a piece of the machine that is running this page. The site you're reading was built with the course I sell for building it. The articles in The Library started life as lessons in a Skool classroom. The content calendar Premium members get is the one I write and roll out a week at a time around the 1st.</p>
        <p>And it's faceless the way I mean it: <strong>my real face is never required.</strong> Not that nobody appears — the brand's face is its AI persona. That's the New Faceless, and it's the only version I teach.</p>
        <p class="fd-hit">So when I tell you which door is yours, I'm not guessing. I've stood in every one of these rooms.</p>
      </div>
    </div>
    <div class="fd-stats">
      {stats.map((s) => (<div class="fd-stat"><span class="fd-stat-n">{s.n}</span><span class="fd-stat-l">{s.l}</span></div>))}
    </div>
  </section>

  <!-- STALLS -->
  <section class="fd-block fd-rv">
    <span class="fd-section-kicker">Before the quiz</span>
    <h2>Which one sounds uncomfortably familiar?</h2>
    <p class="fd-sub">You don't need to diagnose the whole business. Find the bottleneck that's stealing your attention right now.</p>
    <div class="fd-stalls">
      {stalls.map((s) => (
        <button class="fd-stall" type="button" aria-expanded="false">
          <span class="fd-stall-n">{s.n}</span>
          <span class="fd-stall-t">{s.t}</span>
          <span class="fd-stall-p">{s.p}</span>
          <span class="fd-stall-d">The door for this: <strong>{s.d}</strong></span>
        </button>
      ))}
    </div>
    <p class="fd-sub fd-after">Recognised two? Normal. The quiz decides which one is costing you the most right now.</p>
  </section>

  <!-- QUIZ -->
  <section class="fd-block fd-quiz-wrap" id="quiz">
    <div class="fd-quiz-intro">
      <h2>Eleven questions. <em>Answer them honestly.</em></h2>
      <p class="fd-sub">Where you are, where you want to be, where it stops moving, and the fear underneath it. About three minutes. Your result appears on this screen — no email needed to see it.</p>
    </div>
    <div class="fd-quiz" id="fd-quiz">
      <div class="fd-q-top">
        <span class="fd-q-count" id="fd-count">Question 1 of 11</span>
        <div class="fd-q-bar"><span id="fd-bar"></span></div>
      </div>
      <span class="fd-q-sec" id="fd-sec"></span>
      <h2 class="fd-q-h" id="fd-q"></h2>
      <p class="fd-q-sub" id="fd-qsub"></p>
      <div class="fd-opts" id="fd-opts"></div>
      <div class="fd-q-nav">
        <button class="fd-back" id="fd-back" type="button" hidden>← Back</button>
        <button class="btn fd-next" id="fd-next" type="button" hidden>Next <span class="a">→</span></button>
      </div>
    </div>

    <div class="fd-result" id="fd-result" hidden aria-live="polite">
      <span class="fd-r-eye">Your door</span>
      <h2 class="fd-r-name" id="fd-r-name"></h2>
      <div class="fd-r-price" id="fd-r-price"></div>
      <p class="fd-r-why" id="fd-r-why"></p>

      <span class="fd-r-l">Your read</span>
      <dl class="fd-read">
        <div><dt>Where you are</dt><dd id="fd-read-stage"></dd></div>
        <div><dt>What has to be true</dt><dd id="fd-read-goal"></dd></div>
        <div><dt>Where it stops moving</dt><dd id="fd-read-stuck"></dd></div>
        <div><dt>What's underneath it</dt><dd id="fd-read-fear"></dd></div>
      </dl>
      <p class="fd-reframe" id="fd-reframe"></p>

      <span class="fd-r-l">Your first three moves</span>
      <ol class="fd-r-list" id="fd-r-list"></ol>
      <p class="fd-r-time" id="fd-r-time"></p>
      <a class="btn fd-r-btn" id="fd-r-btn" href="#"><span id="fd-r-cta">Go</span> <span class="a">→</span></a>
      <p class="fd-r-alt" id="fd-r-alt" hidden></p>
      <p class="fd-r-later" id="fd-r-later"></p>
      <p class="fd-r-tool">Whichever door it is, the offer comes first. <a href="/resources/one-sentence-offer">Get what you sell down to one sentence</a>: free, two minutes, results on screen.</p>

      <form class="fd-send" id="fd-send">
        <span class="fd-r-l">Before you go</span>
        <h3 id="fd-send-h">Weekly emails, pointed at your door</h3>
        <p>Your result lives on this screen — screenshot it before you go. The list is where the rest of it happens: one idea a week, written for the door you just landed on. Unsubscribe anytime.</p>
        <div class="fd-send-row">
          <input type="text" name="name" placeholder="First name" autocomplete="given-name" aria-label="First name" maxlength="60" />
          <input type="email" name="email" placeholder="your@email.com" autocomplete="email" aria-label="Email" required />
          <input type="text" name="hp" tabindex="-1" autocomplete="off" aria-hidden="true" class="fd-hp" />
          <button class="btn" type="submit">Subscribe <span class="a">→</span></button>
        </div>
        <p class="fd-send-msg" id="fd-send-msg" role="status"></p>
      </form>

      <button class="fd-back" id="fd-retake" type="button">Retake the quiz</button>
    </div>
  </section>

  <!-- ALL DOORS -->
  <section class="fd-block fd-rv" id="doors">
    <h2>Every door, in plain sight</h2>
    <p class="fd-sub">Skipped the quiz? Here's each one in ten seconds.</p>

    <!-- Membership: two ways in, each priced with what it buys (Standing Rule 32) -->
    <span class="fd-door-k">The Membership · on Skool · both start with a {M.trial}</span>
    <div class="fd-duo">
      <article class="fd-tile">
        <h3>Membership Standard</h3>
        <p class="fd-tp"><b>{M.standard.monthly}</b>/month · or {M.standard.annual} a year</p>
        <p class="fd-tl">Build the thing and start selling it.</p>
        <ul class="fd-chips">
          <li>AI Twin / Influencer Creation</li><li>Brand Building</li><li>The Content Edit</li><li>The Monetization Edit</li><li>The Email Edit</li><li>The Pinterest Edit</li><li>Pinterest Foundations™</li><li>The Tommy Kate Edit</li><li>Canva Crash Course</li><li>Daily Prompts</li>
        </ul>
        <dl class="fd-fit"><dt>Yes if</dt><dd>you have the idea, not the order of operations.</dd><dt>Skip if</dt><dd>you just can't keep up with posting.</dd></dl>
        <a class="btn" href={SKOOL}>Start Standard — 7 days free <span class="a">→</span></a>
      </article>
      <article class="fd-tile fd-tile-p">
        <h3>Membership Premium</h3>
        <p class="fd-tp"><b>{M.premium.monthly}</b>/month · or {M.premium.annual} a year</p>
        <p class="fd-tl">Everything in Standard, plus your content month written for you.</p>
        <ul class="fd-chips">
          <li class="hot">Monthly DFY Content Calendar</li><li>The Ads Edit™</li><li>The Offer Edit</li><li>The Funnel Edit</li><li>Scaling &amp; Systems</li>
        </ul>
        <p class="fd-tn">31 days of posts, 62 Threads posts and a prompt for every Reel, released a week at a time around the 1st.</p>
        <dl class="fd-fit"><dt>Yes if</dt><dd>the blank caption box is why you go quiet.</dd><dt>Skip if</dt><dd>you don't have an offer to point it at yet.</dd></dl>
        <a class="btn" href={SKOOL}>Start Premium — 7 days free <span class="a">→</span></a>
      </article>
    </div>
    <p class="fd-fine">Cancel from inside the Skool app whenever you like. Cancelling stops the next payment.</p>

    <article class="fd-tile fd-tile-img">
      <img src="/images/we/hook-blog-posts.jpg" alt="The Weekend Ecosystem™: you already wrote the blog posts. They're just sitting in your Skool group." width="1200" height="1490" loading="lazy" />
      <div>
        <span class="fd-door-k">Standalone course · yours for good</span>
        <h3>The Weekend Ecosystem™</h3>
        <p class="fd-tp"><b>$97</b> one-time · or 3 × $33.33 · every future update included</p>
        <p class="fd-tl">You're not short on content. You're short on a place to put it.</p>
        <p class="fd-tn">22 modules turn what you've already made into a website on your own domain and a blog Google can find. Claude writes every file. You paste, read, say yes. Sixteen hours, one weekend or three.</p>
        <Testimonial variant="line" />
        <dl class="fd-fit"><dt>Yes if</dt><dd>your work lives on platforms you rent.</dd><dt>Skip if</dt><dd>you haven't made anything yet.</dd></dl>
        <div class="fd-row fd-row-left">
          <a class="btn" href={WE}>See The Weekend Ecosystem™ <span class="a">→</span></a>
          <a class="fd-link" href="/weekend-ecosystem/preview">Look inside first →</a>
        </div>
      </div>
    </article>

    <article class="fd-tile fd-tile-img">
      <img src="/images/vault/ai-influencer-prompts.jpg" alt="AI influencer image pack from Pretty & Paid PLR Vault™" loading="lazy" />
      <div>
        <span class="fd-door-k">Its own subscription · on Beacons · separate from the membership</span>
        <h3>Pretty &amp; Paid PLR Vault™</h3>
        <p class="fd-tp"><b>$11</b>/month · what you download stays yours</p>
        <p class="fd-tl">Stop designing from a blank page. Rebrand finished products and sell them as yours.</p>
        <ul class="fd-chips">
          <li>Planners &amp; journals</li><li>Guides &amp; eBooks</li><li>Printables</li><li>Faceless Reel packs</li><li>AI influencer image packs</li><li>Pinterest &amp; carousel templates</li><li>PLR Glow Studio</li>
        </ul>
        <p class="fd-tn">Canva-editable, full PLR license, 20 new products every month. Your license survives if you cancel.</p>
        <dl class="fd-fit"><dt>Yes if</dt><dd>the empty shelf is your bottleneck.</dd><dt>Skip if</dt><dd>you only sell things you designed yourself.</dd></dl>
        <a class="btn" href={VAULT}>Open Pretty &amp; Paid PLR Vault™ <span class="a">→</span></a>
      </div>
    </article>

    <article class="fd-tile fd-tile-aff">
      <span class="fd-door-k">Recommended · not mine</span>
      <h3>Earn With Skool (SCC)</h3>
      <p class="fd-tp"><b>$97</b> one-time</p>
      <p class="fd-tl">For the woman who keeps answering questions in other people's groups.</p>
      <p class="fd-tn">The course I point you to for building and earning from a Skool community of your own. You don't need to feel ready. Nobody who runs a room felt qualified the week they opened it.</p>
      <dl class="fd-fit"><dt>Yes if</dt><dd>you want your own group and keep talking yourself out of it.</dd><dt>Skip if</dt><dd>you'd rather learn in someone else's room.</dd></dl>
      <a class="btn" href={SCC} rel="sponsored nofollow">See Earn With Skool (SCC) <span class="a">→</span></a>
    </article>
  </section>

  <!-- CLOSE -->
  <section class="fd-block fd-close fd-rv">
    <h2>Pick one. <em>Not all five.</em></h2>
    <p class="fd-lede">The fastest way to stall is to buy the whole ecosystem on a Tuesday night and open none of it. Walk through the door that fixes this month's bottleneck. The next one will be obvious when you get there.</p>
    <div class="fd-row"><a class="btn" href="#quiz">Find my door <span class="a">→</span></a></div>
    <p class="fd-fine">Questions about billing or refunds? <a href="/faq">They're all answered in one place.</a></p>
    <p class="fd-sign">xoxo, Jodie</p>
  </section>

  <p class="fd-backlink"><a href="/resources">← All free resources</a></p>
  </div>

  <script is:inline>
  (function(){
    var SKOOL = "https://www.skool.com/thedigitalincomeedit/plans?utm_source=site&utm_medium=quiz&utm_campaign=find-your-door";

    // ── The five doors. Names, prices and routes match the live pages. ──
    var DOORS = {
      S: { name: "Membership Standard", price: "$9 per month after a free 7-day trial",
           why: "You don't need more information. You need the order it goes in. Standard is the build curriculum — brand, offer, content, email and Pinterest — laid out in the sequence I'd do it again.",
           moves: ["Start the trial and open the start-here trainings before anything else", "Build your AI twin and brand first, so everything after it looks like one business", "Shape one offer inside The Monetization Edit before you make a single product"],
           cta: "Start Standard — 7 days free", href: SKOOL, aff: false,
           alt: { pre: "Not ready for a trial yet? ", label: "Start The Weekend Build Challenge", post: " — free, five days, one small build a day, straight to your inbox.", href: "/resources/weekend-build-challenge",
             more: { pre: " Or grab ", label: "The First Product Cheat Sheet", post: " — free, four pages, eight lessons, one small move each.", href: "https://links.thedigitalincomeedit.com/shop/53d07da4-31ac-4720-beb8-c6498ac40eea" } },
           later: "When content becomes the thing that stops you, Membership Premium writes the month for you." },
      P: { name: "Membership Premium", price: "$35 per month after a free 7-day trial",
