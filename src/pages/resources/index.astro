---
// Free Resources hub, rebuilt 20 Nov 2026 on Jodie's Etsy template in the shared site style.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import WysAnnounce from "../../components/WysAnnounce.astro";
import { library, membership, word, cap } from "../../data/facts.js";
import { pillars } from "../../data/library.js";

// /resources is a set of entry points, not a download shelf.
// 1. Find Your Door (free, no email) is the navigation: the first and strongest move.
// 2. Six situations, each pointing to ONE $0 resource (canon products[] or key_pages).
// 3. The per-pillar kits, quieter, as a scannable index.
// Only $0 resources sit in these slots (canon journey_slot_rules.free).

const FIND_YOUR_DOOR = "/resources/find-your-door";

const doors = [
  {
    s: "I have nothing yet.",
    p: "The whole machine on one page, so you can see how the pieces connect and which one to build first.",
    r: "The Faceless Income Blueprint™",
    f: "Free guide, 15 pages",
    href: "/resources/faceless-income-blueprint",
    go: "Get the Blueprint",
  },
  {
    s: "I have an idea, but no offer.",
    p: "Type what you sell the way you say it now, rebuild it in one sentence and watch four checks run live.",
    r: "The One-Sentence Offer tool",
    f: "Free tool, no email",
    href: "/resources/one-sentence-offer",
    go: "Write my sentence",
  },
  {
    s: "I want it built in order, this week.",
    p: "Five days, one email a day: a model, an offer, a product, a funnel and a way to be found. About thirty minutes a day.",
    r: "The Weekend Build Challenge",
    f: "Free 5-day email challenge",
    href: "/resources/weekend-build-challenge",
    go: "Start the challenge",
  },
  {
    s: "I have content, but no system.",
    p: "Your lessons and posts can become a website you own. Walk through the course that builds it first, before you decide anything.",
    r: "A look inside The Weekend Ecosystem™",
    f: "Free preview, no email",
    href: "/weekend-ecosystem/preview",
    go: "Take the look inside",
  },
  {
    s: "I'm about to pay for traffic.",
    p: "The paid-traffic pipeline on one page: four boxes you fill in before you spend a cent.",
    r: "The $10/Day Traffic Machine Starter Map",
    f: "Free guide",
    href: "/resources/starter-map",
    go: "Get the Starter Map",
  },
  {
    s: "I'd rather sell something physical.",
    p: "Four downloads for a store with no warehouse and no face on it: a setup checklist, a vendor and app guide, AI prompts and a niche list.",
    r: "The Shopify Starter Kit",
    f: "Free kit",
    href: "/resources/shopify-starter-kit",
    go: "Get the kit",
  },
];

// One kit per pillar, in library order. `t` must match library.js `freebie`.
const kitPages = {
  "The Systems Starter Kit": { c: "Business Systems", href: "/resources/business-systems-kit" },
  "The Creator to CEO Kit": { c: "Mindset", href: "/resources/mindset-kit" },
  "The Brand Clarity Kit": { c: "Branding", href: "/resources/branding-kit" },
  "The Content Creation Kit": { c: "Content Creation", href: "/resources/content-creation-kit" },
  "The AI Starter Kit": { c: "AI", href: "/resources/ai-starter-kit" },
  "The Pinterest Traffic Kit": { c: "Pinterest", href: "/resources/pinterest-traffic-kit" },
  "The Evergreen Blog Kit": { c: "Blogging", href: "/resources/blogging-kit" },
  "The Email List Starter Kit": { c: "Email Marketing", href: "/resources/email-starter-kit" },
  "The First Product Kit": { c: "Digital Products", href: "/resources/digital-products-kit" },
  "The Affiliate Starter Kit": { c: "Affiliate Marketing", href: "/resources/affiliate-starter-kit" },
  "The Automation Starter Kit": { c: "Automation", href: "/resources/automation-kit" },
  "The Passive Income Starter Kit": { c: "Passive Income", href: "/resources/passive-income-kit" },
  "The Shopify Starter Kit": { c: "Physical Products", href: "/resources/shopify-starter-kit" },
};
const kits = Object.entries(kitPages).map(([t, k]) => ({ t, ...k }));

// Guides that share a kit, worked out from the library itself.
const byKit = {};
for (const g of pillars) (byKit[g.freebie] ||= []).push(g);
const shared = Object.entries(byKit).filter(([, gs]) => gs.length > 1);
const sharedLine = shared.map(([kit, gs]) => {
  const cats = [...new Set(gs.map((g) => g.category))];
  return `The ${word(gs.length)} ${cats.length === 1 ? cats[0] + " " : ""}guides share ${kit}.`;
}).join(" ");
const countLine = `${cap(library.guidesWord)} guides in the library, ${word(kits.length)} kits to go with them.`;
---
<TemplateLayout title="Free Resources" description="Free guides, tools and kits from The Digital Income Edit™. Start with Find Your Door, or pick the one free resource that fits where you are." stickyHref={FIND_YOUR_DOOR} stickyLabel="Find Your Door">

<section class="hh">
 <div class="wrap hh-grid rh2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">All<b class="big">free</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">Free resources</p>
   <h1>Start with the right one. <span class="scr">Not all of them.</span></h1>
   <p class="what">Everything on this page is free. Choose the situation that sounds like you below. <b>Want a hand choosing? Find Your Door asks thirteen questions and shows a starting point on screen. No email needed.</b></p>
   <a class="btn buy" href="#situations">Choose by situation <span class="ar">→</span></a>
   <p class="see"><a href={FIND_YOUR_DOOR}>Or try Find Your Door</a></p>
  </div>
  <a class="card dash rh2-door" href={FIND_YOUR_DOOR}>
   <p class="pn">Find Your Door</p>
   <p class="rh2-dt">Thirteen questions. <span class="scr">One starting point.</span></p>
   <ol>
    <li><span class="glit">01</span>Where you are right now</li>
    <li><span class="glit">02</span>Where you want to be</li>
    <li><span class="glit">03</span>Where it stops moving</li>
    <li><span class="glit">04</span>The worry underneath it</li>
   </ol>
   <p class="rh2-out">Then one starting point, named on screen, with the reason it fits.</p>
   <p class="hm-lab">About three minutes · Results on screen · No email</p>
   <span class="btn">Find my door <span class="ar">→</span></span>
  </a>
 </div>
 <div class="wrap rh2-wys"><WysAnnounce /></div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Choose by situation</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash" id="situations">
 <div class="wrap">
  <h2 class="h2">Six places to start. <span class="scr">One free resource each.</span></h2>
  <div class="lead"><p>Find the sentence that sounds like you. Each one leads to a single thing to open today, all of them free.</p></div>
  <div class="ab2-rooms rh2-doors">{doors.map((d, i) => <a class="card dash" href={d.href}><span class="hm-lab">{String(i + 1).padStart(2, "0")} · {d.f}</span><h3>{d.s}</h3><p>{d.p}</p><p class="rh2-r">{d.r}</p><span class="btn">{d.go} <span class="ar">→</span></span></a>)}</div>
 </div>
</section>

<section class="sec" id="kits">
 <div class="wrap">
  <p class="kick">By topic</p>
  <h2 class="h2">One kit for each guide <span class="scr">in the library.</span></h2>
  <div class="lead"><p>{countLine} {sharedLine} Reading a guide already? Its kit is the one to take.</p></div>
  <div class="rh2-kits">{kits.map((k) => <a class="card dash" href={k.href}><span class="hm-lab">{k.c}</span><span class="rh2-kt">{k.t}</span><span class="rh2-go">Get the kit →</span></a>)}</div>
  <p class="see" style="text-align:center;margin-top:26px">Also free: <a href="/resources/pinterest-keyword-planner">The Pinterest Keyword Planner</a></p>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <div class="card dash fq2-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">Build it<b class="big">together</b></span>
   <p class="kick">The membership</p>
   <h2 class="h2">When you'd rather build it <span class="scr">beside other women.</span></h2>
   <p>The free pieces get you started. The membership is where the build keeps going: the classroom, the daily prompts and a room to post in before you launch. Membership Standard is {membership.standard.perMonth} after a {membership.trial}.</p>
   <div class="fq2-acts">
    <a class="btn buy" href="/membership">See the membership <span class="ar">→</span></a>
    <a class="btn" href="/resources/find-your-door">Find Your Door <span class="ar">→</span></a>
   </div>
   <p class="see" style="margin-top:18px"><a href="/learn">Back to The Library</a></p>
  </div>
 </div>
</section>
</TemplateLayout>
