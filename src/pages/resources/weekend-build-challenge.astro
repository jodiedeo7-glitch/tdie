---
import PageLayout from "../../layouts/PageLayout.astro";
import ReviewBubble from "../../components/ReviewBubble.astro";
import { FEATURED, MEMBER_REVIEWS } from "../../we-reviews.js";
const BRITTANY = MEMBER_REVIEWS[0];

// Own MailerLite form ("Weekend Build Challenge") → group "Challenge — Weekend Build",
// which triggers the 5-day automation. Do not swap for the shared freebie form.
const CHALLENGE_FORM = "https://assets.mailerlite.com/jsonp/2532349/forms/198806704189605117/subscribe";

const days = [
  { n: 1, verb: "Choose", what: "your model", out: "A business model picked on purpose, and one sentence that says who you help." },
  { n: 2, verb: "Name", what: "your offer", out: "An offer a stranger understands the first time they hear it." },
  { n: 3, verb: "Make", what: "the product", out: "A finished five-to-ten page product. Claude drafts it, Canva dresses it." },
  { n: 4, verb: "Build", what: "the path", out: "A free piece, a welcome email and a route to your product, tested end to end." },
  { n: 5, verb: "Get", what: "found", out: "A week of content from one idea, and the one piece most beginners never see coming." },
];

const faq = [
  { q: "Is it really free?", a: "Yes. No card, no trial that quietly turns into a charge. Five days of assignments, then a handful of follow-ups over the fortnight after — eleven emails in all. One click unsubscribes you from any of it." },
  { q: "What do I need?", a: "A free Claude account, a free Canva account and about thirty minutes a day. No website, no audience, no camera." },
  { q: "When does it start?", a: "The moment you join. The welcome email arrives in a minute or two and Day 1 lands the next day. There's no cohort to wait for." },
  { q: "What happens after Day 5?", a: "You’ll have the skeleton of a small business. On Day 5 I’ll invite you into the membership, $9 a month or $99 a year, where the next assignment comes from once the challenge ends, and I’ll mention it twice more that week. About a week later, a few emails go out about The Weekend Ecosystem™, the $97 course that builds the website, blog and email list it all lives in, for anyone who already has content to move. Both are invitations and neither is a requirement. The five days stand on their own, and you keep everything you built in them." },
];
---
<PageLayout
  wide
  title="The Weekend Build Challenge — Free 5-Day Email Challenge"
  description="Five days, five assignments, one small faceless business built in order: a model, an offer, a product, a funnel and a way to be found. About thirty minutes a day. Free."
>
<div class="wbc">

  <!-- HERO -->
  <section class="hero-x" style="background-image:var(--bgi)">
    <div class="hero-copy">
      <p class="tag">A free five-day email challenge</p>
      <h1>Five days.<br />One small business,<br /><span>built in order.</span></h1>
      <p class="lead">You don't need more time. You need a business that fits the time you already have. One email a day, one assignment, about thirty minutes.</p>
      <ul class="chips"><li>Free</li><li>30 minutes a day</li><li>No camera</li></ul>
      <div class="signup" style="background-image:var(--bgi)">
        <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>
      <iframe name="ml-sink-1" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
      <form class="wbc-form" action={CHALLENGE_FORM} method="post" target="ml-sink-1" data-ml>
        <label class="sr" for="wbc-name-1">First name</label>
        <input id="wbc-name-1" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
        <label class="sr" for="wbc-email-1">Email</label>
        <input id="wbc-email-1" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
        <button type="submit">Start the challenge <span aria-hidden="true">→</span></button>
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <p class="done" role="status" hidden>You're in. Your welcome email lands in a minute or two, and Day 1 arrives tomorrow.</p>
      </form>
        <p class="fine">Free. Starts the moment you join. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
      </div>
      <figure class="rv-bubble mini"><span class="rv-q o" aria-hidden="true"></span><span class="rv-stars" aria-label="5 out of 5">★★★★★</span><blockquote>This is the best plan to follow BY FAR!</blockquote><figcaption><b>{BRITTANY.name}</b>, {BRITTANY.source}</figcaption><span class="rv-q c" aria-hidden="true"></span></figure>
    </div>

    <figure class="hero-pic">
      <img src="/images/library/path-digital-products.jpg" alt="A woman in a cream tee and pink sweatpants working on a laptop in a sunny window seat, a pink iced coffee beside her." width="1200" height="799" loading="eager" />
      <div class="note">
        <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>
        <span class="note-k">Tomorrow's email</span>
        <span class="note-t">Day 1: Choose your model</span>
        <span class="note-s">Thirty minutes. One sentence you'll keep.</span>
      </div>
    </figure>
  </section>

  <!-- THE FIVE DAYS -->
  <section class="week" style="background-image:var(--bgi)">
    <div class="in">
      <div class="sec-head">
        <span class="kick">Day by day</span>
        <h2>What you'll have built by Day 5</h2>
        <p class="week-sub">Not a plan for a business. The pieces of one, made one at a time, in the order they hold each other up.</p>
      </div>
      <ol class="days">
        {days.map((d) => (
          <li class="day" style="background-image:var(--bgi)">
            {d.n === 1 && <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>}
            <span class="d-n">0{d.n}</span>
            <span class="d-l">Day {d.n}</span>
            <h3><em>{d.verb}</em> {d.what}</h3>
            <p>{d.out}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="in how-grid">
      <div class="how-copy">
        <span class="kick">How it works</span>
        <h2>Every email is a working session, not a lesson.</h2>
        <p>Each day gives you one short idea, one assignment and a prompt you paste straight into Claude. You read it in the pickup line and do it after bedtime.</p>
        <p class="callout">By the end of the email, the day's piece exists. <em>Tomorrow's builds on it.</em></p>
      </div>
      <figure class="prompt" style="background-image:var(--bgi)">
        <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>
        <figcaption>From the Day 1 email</figcaption>
        <p>&ldquo;I want to start a faceless online business in the time I have outside my job and family. Here is what I know well, what people ask me about, and what I'd happily talk about for free… Which model fits me best as a starting point, and why? Then write me one sentence: <strong>I help ___ get ___ without ___.</strong>&rdquo;</p>
      </figure>
    </div>
  </section>

  <!-- FIT -->
  <section class="fit">
    <div class="in fit-grid">
      <div class="fit-col yes" style="background-image:var(--bgi)">
        <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>
        <h2>This is for you if</h2>
        <ul>
          <li>You have a job, kids, or both, and your free time comes in thirty-minute pieces.</li>
          <li>You've saved a hundred ideas and started none of them.</li>
          <li>You want something that belongs to you, without becoming an influencer.</li>
        </ul>
      </div>
      <div class="fit-col no">
        <h2>It isn't for you if</h2>
        <ul>
          <li>You want a promise about how fast the money comes. I won't make one.</li>
          <li>You'd rather learn everything before building anything.</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="founder" style="background-image:var(--bgi)">
    <div class="in founder-grid">
      <figure class="pol" style="background-image:var(--bgi)">
        <img src="/images/library/path-blogging.jpg" alt="Over-the-shoulder view of a woman in a pink hoodie typing on a laptop in an armchair." width="1200" height="805" loading="lazy" />
        <figcaption>after bedtime, thirty minutes</figcaption>
      </figure>
      <div class="founder-copy">
        <span class="kick">From the founder</span>
        <p class="q">&ldquo;I built this whole business faceless, with AI, in the hours I actually had. These are the first five steps, <em>in the order that works.</em>&rdquo;</p>
        <p class="by">Jodie, founder of The Digital Income Edit™</p>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section class="reviews">
    <div class="in">
      <div class="sec-head center">
        <span class="kick">Where Day 5 can lead</span>
      </div>
      <div class="rv-row">
        <ReviewBubble quote={FEATURED.quote} name={FEATURED.name} source={FEATURED.source} stars={FEATURED.stars} url={FEATURED.url} />
        <ReviewBubble quote={BRITTANY.quote} name={BRITTANY.name} source={BRITTANY.source} stars={BRITTANY.stars} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="faq-card" style="background-image:var(--bgi)">
      <span class="kick">Questions</span>
      <h2>Before you join</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CLOSE -->
  <section class="close" style="background-image:var(--bgi)">
    <div class="in close-grid">
      <div>
        <span class="kick">Free · 5 days</span>
        <h2>Start today.<br />Have the skeleton by Day 5.</h2>
      </div>
      <div class="signup" style="background-image:var(--bgi)">
        <i class="tape" aria-hidden="true" style="background-image:var(--bgi)"></i>
      <iframe name="ml-sink-2" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
      <form class="wbc-form" action={CHALLENGE_FORM} method="post" target="ml-sink-2" data-ml>
        <label class="sr" for="wbc-name-2">First name</label>
        <input id="wbc-name-2" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
        <label class="sr" for="wbc-email-2">Email</label>
        <input id="wbc-email-2" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
        <button type="submit">Start the challenge <span aria-hidden="true">→</span></button>
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <p class="done" role="status" hidden>You're in. Your welcome email lands in a minute or two, and Day 1 arrives tomorrow.</p>
      </form>
        <p class="fine">Free. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  // The form posts into a hidden iframe, so MailerLite's raw {"success":true}
  // response never opens in a tab. When the iframe finishes loading, the form
  // swaps to the confirmation message.
  document.querySelectorAll('form[data-ml]').forEach(function (f) {
    var sink = document.getElementsByName(f.target)[0];
    var sent = false;
    f.addEventListener('submit', function () {
      sent = true;
      var btn = f.querySelector('button');
      btn.disabled = true; btn.textContent = 'Sending…';
    });
    sink.addEventListener('load', function () {
      if (!sent) return;
      f.querySelectorAll('input:not([type=hidden]), button').forEach(function (el) { el.hidden = true; });
      f.querySelector('.done').hidden = false;
      if (window.fbq) fbq('track', 'Lead', { content_name: 'Weekend Build Challenge' });
    });
  });
</script>
</PageLayout>

<style>
  :global(html body main.page-wrap:has(.wbc)){padding:0!important;max-width:none!important}
  .wbc{--pink:#D62E73;--deep:#B8245F;--ink:#1A1417;--ink2:#4A3640;--lav:#EAE5F8;--blush:#FFF7FA;--rose:#FFE4EF;
    --glit:#c9ccd2 url(/images/brand/silver-glitter-tile.webp) center/360px auto;
    color:var(--ink);font-family:Jost,sans-serif;overflow:clip}
  .in{width:min(1180px,calc(100% - 48px));margin:0 auto;position:relative;z-index:1}
  .ml-sink{position:absolute;width:0;height:0;border:0;visibility:hidden}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  h1,h2,h3{font-family:var(--display);font-weight:300;letter-spacing:0}
  h2{font-family:Gloock,Georgia,serif;font-weight:400;font-size:clamp(30px,3vw,40px);line-height:1.15;margin:0 0 16px;text-wrap:balance}
  em{font-style:normal;color:var(--pink)}
  section{position:relative}

  /* shared pieces: pill label, glitter tape, sparkle scatter */
  .kick,.tag{display:inline-block;border:1.5px solid var(--pink);border-radius:999px;background:#fff;padding:7px 14px;color:var(--deep);font:600 12px/1.2 Jost,sans-serif;letter-spacing:.09em;text-transform:uppercase;margin:0 0 16px}
  .tape{position:absolute;top:-13px;left:42%;width:104px;height:25px;--bgi:url(/images/brand/silver-glitter-tile.webp);background-color:#c9ccd2;background-position:center;background-size:360px auto;transform:rotate(-4deg);box-shadow:0 3px 5px #1a141726;z-index:3}

  /* hero */
  .hero-x{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:64px;align-items:center;padding:64px max(24px,calc((100vw - 1180px)/2)) 84px;
    --bgi:radial-gradient(55% 70% at 25% 40%,#fff 0%,rgba(255,255,255,0) 70%),linear-gradient(180deg,#FFE4EF 0%,var(--blush) 100%);background-color:var(--blush)}
  .hero-x::after{content:"";position:absolute;left:0;right:0;bottom:0;height:8px;background:var(--glit);background-size:500px auto}
  .tag{font-size:13px}
  .hero-x h1{font-size:clamp(42px,4.6vw,66px);line-height:1.02;margin-bottom:22px}
  .hero-x h1 span{color:var(--pink)}
  .lead{font-size:19px;line-height:1.6;color:var(--ink2);max-width:34em;margin:0 0 18px}
  .chips{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin:0 0 30px;padding:0}
  .chips li{display:inline-flex;align-items:center;gap:7px;padding:7px 14px;background:#fff;border:1.5px solid #E9A3C2;border-radius:999px;font:500 14px/1.2 Jost,sans-serif}
  .chips li::before{content:"✓";color:var(--pink);font-weight:700}

  .signup{position:relative;max-width:580px;padding:26px 26px 20px;border:6px solid transparent;border-radius:14px;
    --bgi:linear-gradient(#fff,#fff),url(/images/brand/silver-glitter-tile.webp);background-color:transparent;background-origin:padding-box,border-box;background-clip:padding-box,border-box;background-position:center;background-size:auto,400px auto;box-shadow:0 28px 35px -30px #78234490}
  .wbc-form{border:0!important;box-shadow:none!important;padding:0!important;background:none!important;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.4fr);gap:10px}
  .wbc-form input{font:inherit;font-size:16px;padding:15px 18px;border:1.5px solid #E9A3C2;background:#fff;border-radius:999px;color:var(--ink);min-width:0}
  .wbc-form input:focus{outline:3px solid var(--deep);outline-offset:2px}
  .wbc-form button{grid-column:1/-1;display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:56px;margin-top:4px;border-radius:999px;cursor:pointer;
    background:linear-gradient(180deg,#fff 0%,#fff 55%,#FBF6F9 100%);border:2px solid var(--pink);box-shadow:inset 0 0 0 3px #fff,inset 0 0 0 4px #E9E2EA,0 14px 26px -14px rgba(184,36,95,.75);
    color:var(--ink);font:600 17px/1.2 Jost,sans-serif;transition:transform .15s ease,box-shadow .15s ease}
  .wbc-form button::before{content:"";width:12px;height:12px;flex:none;background:var(--pink);clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%)}
  .wbc-form button span{color:var(--pink);font-weight:700}
  .wbc-form button:hover{transform:translateY(-1px);box-shadow:inset 0 0 0 3px #fff,inset 0 0 0 4px #E9E2EA,0 18px 30px -14px rgba(184,36,95,.85)}
  .wbc-form button:focus-visible{outline:3px solid var(--deep);outline-offset:4px}
  .wbc-form .done{grid-column:1/-1;font-family:Gloock,serif;font-size:22px;line-height:1.3;color:var(--deep);padding:8px 0;margin:0}
  .fine{font-size:13.5px;color:var(--ink2);margin:12px 0 0}
  .rv-bubble.mini{max-width:330px;margin:34px 0 0;transform:rotate(-1deg)}
  .rv-bubble.mini blockquote{font-size:17px}

  .hero-pic{position:relative;margin:0;overflow:visible!important;padding:12px 12px 12px 26px;border-radius:6px;background:#fff;box-shadow:0 40px 60px -40px #78234499}
  .hero-pic::before{content:"";position:absolute;left:0;top:0;bottom:0;width:14px;border-radius:6px 0 0 6px;background:var(--glit);background-size:420px auto}
  .hero-pic img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;object-position:62% center;border-radius:3px}
  .note{position:absolute;left:-40px;bottom:36px;background:#fff;padding:20px 22px 18px;width:260px;border:1.5px solid var(--pink);border-radius:12px;box-shadow:0 24px 40px -24px #78234499;display:flex;flex-direction:column;gap:4px;transform:rotate(-2deg)}
  .note .tape{width:76px;height:20px;top:-10px;left:36%}
  .note-k{font:600 11px/1.2 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--deep)}
  .note-t{font-family:Gloock,serif;font-size:21px;line-height:1.2}
  .note-s{font-size:14px;color:var(--ink2)}

  /* five days: lavender, fades in and out, sparkle at the edge */
  .week{padding:72px 0 84px;--bgi:linear-gradient(180deg,var(--blush) 0,var(--lav) 110px,var(--lav) calc(100% - 110px),var(--blush) 100%);background-color:var(--lav)}
  .week::before{content:"";position:absolute;inset:0;background:url(/images/brand/sparkle-scatter-900.webp) right center/cover;-webkit-mask-image:linear-gradient(270deg,#000,transparent 30%);mask-image:linear-gradient(270deg,#000,transparent 30%);pointer-events:none}
  .sec-head{max-width:640px;margin-bottom:44px}
  .sec-head.center{text-align:center;margin:0 auto 28px}
  .week-sub{font-size:18px;line-height:1.6;color:var(--ink2);margin:0}
  .days{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px}
  .day{position:relative;padding:24px 20px 22px;border-top:6px solid transparent;border-radius:12px;
    --bgi:linear-gradient(#fff,#fff),url(/images/brand/silver-glitter-tile.webp);background-color:transparent;background-origin:padding-box,border-box;background-clip:padding-box,border-box;background-position:center;background-size:auto,300px auto;box-shadow:0 22px 28px -24px #45203790;transform:rotate(-1.5deg)}
  .day:nth-child(2){transform:rotate(1deg) translateY(14px)}
  .day:nth-child(3){transform:rotate(-.5deg)}
  .day:nth-child(4){transform:rotate(1.5deg) translateY(14px)}
  .day:nth-child(5){transform:rotate(-1deg)}
  .d-n{display:block;font:400 44px/1 Gloock,serif;color:var(--pink);margin-bottom:6px}
  .d-l{display:block;font:600 12px/1.2 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--deep);margin-bottom:12px}
  .day h3{font-family:Gloock,serif;font-weight:400;font-size:24px;line-height:1.15;margin:0 0 10px}
  .day p{font-size:15.5px;line-height:1.5;color:var(--ink2);margin:0}

  /* how it works: notebook-paper sheet */
  .how{padding:88px 0}
  .how-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:64px;align-items:center}
  .how-copy p{font-size:18px;line-height:1.65;color:var(--ink2);margin:0 0 16px;max-width:32em}
  .how-copy .callout{display:inline-block;background:#fff;border:1.5px solid var(--pink);border-radius:12px;padding:14px 18px;font:400 21px/1.35 Gloock,serif;color:var(--ink);transform:rotate(1deg);margin-top:6px}
  .prompt{position:relative;margin:0;padding:40px 40px 34px 92px;transform:rotate(-1deg);border-radius:5px;background-color:#fff;
    --bgi:linear-gradient(90deg,transparent 64px,#E85A9B 64px 66px,transparent 66px),repeating-linear-gradient(180deg,transparent 0 37px,#F4C3D8 37px 38px);
    box-shadow:0 3px 6px #1a141710,0 32px 40px -30px #78234465}
  .prompt::before{content:"";position:absolute;inset:-60px -10vw;z-index:-1;pointer-events:none;background:url(/images/brand/sparkle-scatter-900.webp) center/cover;-webkit-mask-image:linear-gradient(90deg,transparent 60%,#000);mask-image:linear-gradient(90deg,transparent 60%,#000)}
  .prompt figcaption{font:600 12px/38px Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:var(--deep)}
  .prompt p{font:500 18px/38px Jost,sans-serif;color:var(--ink);margin:0}
  .prompt strong{font-weight:600;color:var(--pink)}

  /* fit */
  .fit{padding:24px 0 88px}
  .fit-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,1fr);gap:34px;align-items:start}
  .fit-col{position:relative;background:#fff;border-radius:14px;padding:38px 38px 30px}
  .fit-col.yes{border:6px solid transparent;--bgi:linear-gradient(#fff,#fff),url(/images/brand/silver-glitter-tile.webp);background-color:transparent;background-origin:padding-box,border-box;background-clip:padding-box,border-box;background-position:center;background-size:auto,400px auto;box-shadow:0 28px 35px -30px #78234490;transform:rotate(-.6deg)}
  .fit-col.no{border:1.5px solid #E9A3C2;box-shadow:0 20px 30px -26px #78234470;margin-top:28px;transform:rotate(.8deg)}
  .fit-col h2{font-size:30px}
  .fit ul{list-style:none;margin:0;padding:0}
  .fit li{font-size:17.5px;line-height:1.55;padding:13px 0 13px 34px;position:relative;border-top:1px dashed #F4C3D8}
  .fit .yes li::before{content:"✓";position:absolute;left:4px;top:12px;color:var(--pink);font-weight:700;font-size:19px}
  .fit .no li::before{content:"×";position:absolute;left:5px;top:9px;color:var(--pink);font-weight:700;font-size:24px}

  /* founder: a real Polaroid */
  .founder{padding:80px 0;--bgi:linear-gradient(180deg,var(--blush) 0,var(--rose) 50%,var(--blush) 100%);background-color:var(--rose)}
  .founder::before{content:"";position:absolute;inset:0;background:url(/images/brand/sparkle-scatter-900.webp) left center/cover;-webkit-mask-image:linear-gradient(90deg,#000,transparent 28%);mask-image:linear-gradient(90deg,#000,transparent 28%);pointer-events:none}
  .founder-grid{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:72px;align-items:center}
