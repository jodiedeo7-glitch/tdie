---
import PageLayout from "../../layouts/PageLayout.astro";

// Own MailerLite form ("Weekend Build Challenge") → group "Challenge — Weekend Build",
// which triggers the 5-day automation. Do not swap for the shared freebie form.
const CHALLENGE_FORM = "https://assets.mailerlite.com/jsonp/2532349/forms/198806704189605117/subscribe";

const days = [
  { n: 1, verb: "Choose", what: "your model", out: "A business model picked on purpose, and one sentence that says who you help." },
  { n: 2, verb: "Name", what: "your offer", out: "An offer a stranger understands the first time they hear it." },
  { n: 3, verb: "Make", what: "the product", out: "A finished five-to-ten page product. Claude drafts it, Canva dresses it." },
  { n: 4, verb: "Build", what: "the path", out: "A free piece, a welcome email and a route to your product, tested end to end." },
  { n: 5, verb: "Get", what: "found", out: "A week of content from one idea, and the one piece most beginners never see coming." },
];

const faq = [
  { q: "Is it really free?", a: "Yes. No card, no trial that quietly turns into a charge. Five days of assignments, then a handful of follow-ups over the fortnight after — eleven emails in all. One click unsubscribes you from any of it." },
  { q: "What do I need?", a: "A free Claude account, a free Canva account and about thirty minutes a day. No website, no audience, no camera." },
  { q: "When does it start?", a: "The moment you join. The welcome email arrives in a minute or two and Day 1 lands the next day. There's no cohort to wait for." },
  { q: "What happens after Day 5?", a: "You’ll have the skeleton of a small business. On Day 5 I’ll show you The Weekend Ecosystem™, the $97 course that builds the website, blog and email list it all lives in, and I’ll mention it twice more that week. After that a few emails go out about the membership — $9 a month, or $99 a year. Both are invitations and neither is a requirement. The five days stand on their own, and you keep everything you built in them." },
];
---
<PageLayout
  wide
  title="The Weekend Build Challenge — Free 5-Day Email Challenge"
  description="Five days, five assignments, one small faceless business built in order: a model, an offer, a product, a funnel and a way to be found. About thirty minutes a day. Free."
>
<div class="wbc">

  <!-- HERO -->
  <section class="hero-x">
    <div class="hero-copy">
      <p class="tag">A free five-day email challenge</p>
      <h1>Five days.<br />One small business,<br /><span>built in order.</span></h1>
      <p class="lead">You don't need more time. You need a business that fits the time you already have. One email a day, one assignment, about thirty minutes.</p>

      <iframe name="ml-sink-1" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
      <form class="wbc-form" action={CHALLENGE_FORM} method="post" target="ml-sink-1" data-ml>
        <label class="sr" for="wbc-name-1">First name</label>
        <input id="wbc-name-1" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
        <label class="sr" for="wbc-email-1">Email</label>
        <input id="wbc-email-1" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
        <button type="submit">Start the challenge</button>
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <p class="done" role="status" hidden>You're in. Check your inbox — your welcome email is on its way.</p>
      </form>
      <p class="fine">Free. Starts the moment you join. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
    </div>

    <figure class="hero-pic">
      <img src="/images/library/path-digital-products.jpg" alt="A woman in a cream tee and pink sweatpants working on a laptop in a sunny window seat, a pink iced coffee beside her." width="1200" height="799" loading="eager" />
      <div class="note">
        <span class="note-k">Tomorrow's email</span>
        <span class="note-t">Day 1 — Choose your model</span>
        <span class="note-s">Thirty minutes. One sentence you'll keep.</span>
      </div>
    </figure>
  </section>

  <!-- THE FIVE DAYS -->
  <section class="week">
    <div class="week-in">
      <h2>What you'll have built by Day 5</h2>
      <p class="week-sub">Not a plan for a business. The pieces of one, made one at a time, in the order they hold each other up.</p>
      <ol class="days">
        {days.map((d) => (
          <li class="day">
            <span class="d-n">Day {d.n}</span>
            <h3><em>{d.verb}</em> {d.what}</h3>
            <p>{d.out}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how">
    <div class="how-copy">
      <h2>Every email is a working session, not a lesson.</h2>
      <p>Each day gives you one short idea, one assignment and a prompt you paste straight into Claude. You read it in the pickup line and do it after bedtime.</p>
      <p>By the end of the email, the day's piece exists. Tomorrow's builds on it.</p>
    </div>
    <figure class="prompt">
      <figcaption>From the Day 1 email</figcaption>
      <p>&ldquo;I want to start a faceless online business in the time I have outside my job and family. Here is what I know well, what people ask me about, and what I'd happily talk about for free… Which model fits me best as a starting point, and why? Then write me one sentence: <strong>I help ___ get ___ without ___.</strong>&rdquo;</p>
    </figure>
  </section>

  <!-- FIT -->
  <section class="fit">
    <div class="fit-col yes">
      <h2>This is for you if</h2>
      <ul>
        <li>You have a job, kids, or both, and your free time comes in thirty-minute pieces.</li>
        <li>You've saved a hundred ideas and started none of them.</li>
        <li>You want something that belongs to you, without becoming an influencer.</li>
      </ul>
    </div>
    <div class="fit-col no">
      <h2>It isn't for you if</h2>
      <ul>
        <li>You want a promise about how fast the money comes. I won't make one.</li>
        <li>You'd rather learn everything before building anything.</li>
      </ul>
    </div>
  </section>

  <!-- FOUNDER -->
  <section class="founder">
    <img src="/images/library/path-blogging.jpg" alt="Over-the-shoulder view of a woman in a pink hoodie typing on a laptop in an armchair." width="1200" height="805" loading="lazy" />
    <div class="founder-copy">
      <p class="q">&ldquo;I built this whole business faceless, with AI, in the hours I actually had. These are the first five steps, in the order that works.&rdquo;</p>
      <p class="by">Jodie, founder of The Digital Income Edit™</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <h2>Before you join</h2>
    {faq.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>

  <!-- CLOSE -->
  <section class="close">
    <div class="close-in">
      <h2>Start today.<br />Have the skeleton by Day 5.</h2>
      <div>
      <iframe name="ml-sink-2" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
      <form class="wbc-form light" action={CHALLENGE_FORM} method="post" target="ml-sink-2" data-ml>
        <label class="sr" for="wbc-name-2">First name</label>
        <input id="wbc-name-2" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
        <label class="sr" for="wbc-email-2">Email</label>
        <input id="wbc-email-2" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
        <button type="submit">Start the challenge</button>
        <input type="hidden" name="ml-submit" value="1" />
        <input type="hidden" name="anticsrf" value="true" />
        <p class="done" role="status" hidden>You're in. Check your inbox — your welcome email is on its way.</p>
      </form>
        <p class="fine">Free. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
      </div>
    </div>
  </section>
</div>

<script is:inline>
  // The form posts into a hidden iframe, so MailerLite's raw {"success":true}
  // response never opens in a tab. When the iframe finishes loading, the form
  // swaps to the confirmation message.
  document.querySelectorAll('form[data-ml]').forEach(function (f) {
    var sink = document.getElementsByName(f.target)[0];
    var sent = false;
    f.addEventListener('submit', function () {
      sent = true;
      var btn = f.querySelector('button');
      btn.disabled = true; btn.textContent = 'Sending…';
    });
    sink.addEventListener('load', function () {
      if (!sent) return;
      f.querySelectorAll('input:not([type=hidden]), button').forEach(function (el) { el.hidden = true; });
      f.querySelector('.done').hidden = false;
      if (window.fbq) fbq('track', 'Lead', { content_name: 'Weekend Build Challenge' });
    });
  });
</script>
</PageLayout>

<style>
  :global(main.page-wrap:has(.wbc)){padding:0;max-width:none}
  .wbc{--edge:max(24px,calc((100vw - 1180px)/2))}
  .ml-sink{position:absolute;width:0;height:0;border:0;visibility:hidden}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  h1,h2,h3{font-family:var(--display);font-weight:300;letter-spacing:-.5px}

  /* hero */
  .hero-x{display:grid;grid-template-columns:1.15fr 1fr;gap:64px;align-items:center;padding:72px var(--edge) 96px}
  .tag{font-family:var(--serif);font-style:italic;font-size:22px;color:var(--gold-deep);margin-bottom:18px}
  .hero-x h1{font-size:clamp(42px,4.6vw,66px);line-height:1.02;margin-bottom:26px}
  .hero-x h1 span{font-style:italic;color:var(--pink)}
  .lead{font-size:19px;line-height:1.65;color:var(--choc-soft);max-width:34em;margin-bottom:34px}
  .wbc-form{display:grid;grid-template-columns:1fr 1.4fr;gap:10px;max-width:560px}
  .wbc-form input{font:inherit;font-size:16px;padding:16px 18px;border:1px solid rgba(43,22,27,.2);background:var(--white);border-radius:2px;color:var(--choc)}
  .wbc-form input:focus{outline:2px solid var(--pink);outline-offset:1px}
  .wbc-form button{grid-column:1/-1;font:inherit;font-size:16px;font-weight:500;letter-spacing:.3px;padding:18px;border:0;border-radius:2px;background:var(--pink);color:#fff;cursor:pointer;transition:background .3s}
  .wbc-form button:hover{background:var(--pink-deep)}
  .wbc-form button:focus-visible{outline:2px solid var(--choc);outline-offset:3px}
  .wbc-form .done{grid-column:1/-1;font-family:var(--display);font-size:24px;line-height:1.3;color:var(--pink);padding:8px 0}
  .fine{font-size:13.5px;color:var(--choc-meta);margin-top:14px}
  .hero-pic{position:relative;margin:0}
  .hero-pic img{width:100%;aspect-ratio:4/5;object-fit:cover;object-position:62% center;border-radius:2px;box-shadow:0 50px 90px -50px rgba(43,22,27,.5)}
  .note{position:absolute;left:-34px;bottom:38px;background:var(--white);padding:18px 22px 20px;width:250px;box-shadow:0 24px 50px -24px rgba(43,22,27,.45);border-top:3px solid var(--pink);display:flex;flex-direction:column;gap:4px;transform:rotate(-2deg)}
  .note-k{font-family:var(--serif);font-style:italic;font-size:16px;color:var(--gold-deep)}
  .note-t{font-family:var(--display);font-size:21px;line-height:1.2}
  .note-s{font-size:14px;color:var(--choc-meta)}

  /* week */
  .week{background:var(--choc);color:var(--cream)}
  .week-in{padding:96px var(--edge)}
  .week h2{font-size:clamp(34px,4vw,52px);max-width:16ch;line-height:1.08}
  .week-sub{font-family:var(--serif);font-style:italic;font-size:23px;color:rgba(251,248,245,.72);max-width:34em;margin:16px 0 56px}
  .days{list-style:none;display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid rgba(200,169,106,.45)}
  .day{padding:26px 22px 8px 0;position:relative}
  .day + .day{padding-left:22px;border-left:1px solid rgba(200,169,106,.22)}
  .d-n{display:block;font-family:var(--serif);font-style:italic;font-size:19px;color:var(--gold);margin-bottom:14px}
  .day h3{font-size:30px;line-height:1.05;margin-bottom:14px;color:#fff}
  .day h3 em{color:var(--mauve)}
  .day p{font-size:16px;line-height:1.6;color:rgba(251,248,245,.8)}

  /* how */
  .how{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center;padding:110px var(--edge)}
  .how h2{font-size:clamp(32px,3.6vw,46px);line-height:1.1;margin-bottom:22px}
  .how p{font-size:18px;line-height:1.7;color:var(--choc-soft);margin-bottom:16px;max-width:32em}
  .prompt{margin:0;background:var(--white);border:1px solid rgba(43,22,27,.1);padding:34px 36px;position:relative}
  .prompt::before{content:"";position:absolute;inset:10px;border:1px solid rgba(200,169,106,.35);pointer-events:none}
  .prompt figcaption{font-family:var(--serif);font-style:italic;font-size:18px;color:var(--gold-deep);margin-bottom:12px}
  .prompt p{font-family:var(--display);font-size:21px;line-height:1.5;color:var(--choc)}
  .prompt strong{font-weight:400;color:var(--pink)}

  /* fit */
  .fit{display:grid;grid-template-columns:1.3fr 1fr;gap:2px;margin:0 var(--edge);background:rgba(43,22,27,.08)}
  .fit-col{background:var(--cream);padding:46px 44px}
  .fit-col.yes{background:var(--blush)}
  .fit h2{font-size:32px;margin-bottom:20px}
  .fit ul{list-style:none}
  .fit li{font-size:17.5px;line-height:1.6;padding:12px 0 12px 30px;position:relative;border-top:1px solid rgba(43,22,27,.08)}
  .fit .yes li::before{content:"";position:absolute;left:4px;top:22px;width:10px;height:10px;border-radius:50%;background:var(--pink)}
  .fit .no li::before{content:"";position:absolute;left:4px;top:27px;width:12px;height:1.5px;background:var(--choc-meta)}

  /* founder */
  .founder{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center;padding:110px var(--edge)}
  .founder img{width:100%;aspect-ratio:5/4;object-fit:cover;border-radius:2px}
  .founder .q{font-family:var(--display);font-weight:300;font-size:clamp(28px,3.2vw,40px);line-height:1.25;margin-bottom:22px}
  .founder .by{font-family:var(--serif);font-style:italic;font-size:20px;color:var(--gold-deep)}

  /* faq */
  .faq{max-width:760px;margin:0 auto;padding:0 24px 110px}
  .faq h2{font-size:38px;margin-bottom:24px}
  .faq details{border-top:1px solid rgba(43,22,27,.14)}
  .faq details:last-of-type{border-bottom:1px solid rgba(43,22,27,.14)}
  .faq summary{cursor:pointer;list-style:none;font-family:var(--display);font-size:22px;padding:22px 40px 22px 0;position:relative}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"+";position:absolute;right:4px;top:18px;font-size:28px;color:var(--pink);transition:transform .3s}
  .faq details[open] summary::after{transform:rotate(45deg)}
  .faq summary:focus-visible{outline:2px solid var(--pink);outline-offset:2px}
  .faq details p{font-size:17px;line-height:1.7;color:var(--choc-soft);padding:0 0 24px;max-width:40em}

  /* close */
  .close{background:var(--pink);color:#fff}
  .close-in{padding:100px var(--edge);display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
  .close h2{font-size:clamp(38px,4.6vw,60px);line-height:1.04}
  .wbc-form.light input{border-color:transparent}
  .wbc-form.light button{background:var(--choc)}
  .wbc-form.light button:hover{background:#000}
  .wbc-form.light .done{color:#fff}
  .close .fine{color:rgba(255,255,255,.8)}

  @media(max-width:980px){
    .hero-x,.how,.founder,.close-in{grid-template-columns:1fr;gap:40px}
    .hero-x{padding-top:44px;padding-bottom:64px}
    .hero-pic img{aspect-ratio:4/3}
    .note{left:12px;bottom:-26px}
    .days{grid-template-columns:1fr}
    .day,.day + .day{padding:22px 0;border-left:0;border-bottom:1px solid rgba(200,169,106,.22)}
    .fit{grid-template-columns:1fr}
    .how,.founder{padding-top:80px;padding-bottom:80px}
  }
  @media(max-width:520px){
    .wbc-form{grid-template-columns:1fr}
    .fit-col{padding:34px 24px}
    .prompt{padding:28px 24px}
  }
</style>
