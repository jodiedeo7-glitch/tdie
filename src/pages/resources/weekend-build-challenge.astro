---
// The Weekend Build Challenge, rebuilt 20 Nov 2026 on Jodie's Etsy template.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import { FEATURED, MEMBER_REVIEWS } from "../../we-reviews.js";
const BRITTANY = MEMBER_REVIEWS[0];

// Own MailerLite form ("Weekend Build Challenge") → group "Challenge — Weekend Build",
// which triggers the 5-day automation. Do not swap for the shared freebie form.
const CHALLENGE_FORM = "https://assets.mailerlite.com/jsonp/2532349/forms/198806704189605117/subscribe";

const days = [
  { n: 1, verb: "Choose", what: "your model", out: "A business model picked on purpose, and one sentence that says who you help." },
  { n: 2, verb: "Name", what: "your offer", out: "An offer a stranger understands the first time they hear it." },
  { n: 3, verb: "Make", what: "the product", out: "A finished five-to-ten page product. Claude drafts it, Canva dresses it." },
  { n: 4, verb: "Build", what: "the path", out: "A free piece, a welcome email and a route to your product, tested end to end." },
  { n: 5, verb: "Get", what: "found", out: "A week of content from one idea, and the one piece most beginners never see coming." },
];

const faq = [
  { q: "Is it really free?", a: "Yes. No card, no trial that quietly turns into a charge. Five days of assignments, then a handful of follow-ups over the two weeks after: eleven emails in all. One click unsubscribes you from any of it." },
  { q: "What do I need?", a: "A free Claude account, a free Canva account and about thirty minutes a day. No website, no audience, no camera." },
  { q: "When does it start?", a: "The moment you join. The welcome email arrives in a minute or two and Day 1 lands the next day. There's no cohort to wait for." },
  { q: "What happens after Day 5?", a: "You’ll have the skeleton of a small business. On Day 5 I’ll invite you into the membership, $9 a month or $99 a year, where the next assignment comes from once the challenge ends, and I’ll mention it twice more that week. About a week later, a few emails go out about The Weekend Ecosystem™, the $97 course that builds the website, blog and email list it all lives in, for anyone who already has content to move. Both are invitations and neither is a requirement. The five days stand on their own, and you keep everything you built in them." },
];
---
<TemplateLayout title="The Weekend Build Challenge: Free 5-Day Email Challenge" description="Five days, five assignments, one small faceless business built in order: a model, an offer, a product, a funnel and a way to be found. About thirty minutes a day. Free." stickyHref="#join" stickyLabel="Start the challenge" heroBuy=".hh .wbc-form button">

<section class="hh">
 <div class="wrap hh-grid wb2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">5 days<b class="big">free</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">A free five-day email challenge</p>
   <h1>Five days. One small business, <span class="scr">built in order.</span></h1>
   <p class="what">You don't need more time. You need a business that fits the time you already have. <b>One email a day, one assignment, about thirty minutes.</b></p>
   <p class="see">Free · 30 minutes a day · No camera</p>
   <div class="card dash wb2-form">
   <iframe name="ml-sink-1" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
   <form class="wbc-form" action={CHALLENGE_FORM} method="post" target="ml-sink-1" data-ml>
    <label class="sr" for="wbc-name-1">First name</label>
    <input id="wbc-name-1" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
    <label class="sr" for="wbc-email-1">Email</label>
    <input id="wbc-email-1" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
    <button type="submit">Start the challenge <span aria-hidden="true">→</span></button>
    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />
    <p class="done" role="status" hidden>You're in. Your welcome email lands in a minute or two, and Day 1 arrives tomorrow.</p>
   </form>
   <p class="bm2-small">Free. Starts the moment you join. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
  </div>
  </div>
  <figure class="wb2-fig">
   <div class="hh-ph"><img src="/images/library/path-digital-products.jpg" alt="A woman in a cream tee and pink sweatpants working on a laptop in a sunny window seat, a pink iced coffee beside her." width="1200" height="799" loading="eager" /></div>
   <div class="card dash wb2-note"><span class="hm-lab">Tomorrow's email</span><span class="wb2-nt">Day 1: Choose your model</span><span>Thirty minutes. One sentence you'll keep.</span></div>
  </figure>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Day by day</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">What you'll have built <span class="scr">by Day 5.</span></h2>
  <div class="lead"><p>Not a plan for a business. The pieces of one, made one at a time, in the order they hold each other up.</p></div>
  <div class="wb2-days">{days.map((d) => <div class="box"><span class="num hm-num">0{d.n}</span><span class="hm-lab">Day {d.n}</span><h3>{d.verb} {d.what}</h3><p>{d.out}</p></div>)}</div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">How it works</p>
  <h2 class="h2">Every email is a working session, <span class="scr">not a lesson.</span></h2>
  <div class="p23 bm2-two">
   <div class="pc"><div class="hd">Each day</div><div class="bd"><p>Each day gives you one short idea, one assignment and a prompt you paste straight into Claude. You read it in the pickup line and do it after bedtime.</p><p><b>By the end of the email, the day's piece exists. Tomorrow's builds on it.</b></p></div></div>
   <div class="pc"><div class="hd">From the Day 1 email</div><div class="bd"><p>&ldquo;I want to start a faceless online business in the time I have outside my job and family. Here is what I know well, what people ask me about, and what I'd happily talk about for free… Which model fits me best as a starting point, and why? Then write me one sentence: <strong>I help ___ get ___ without ___.</strong>&rdquo;</p></div></div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">Fit</p>
  <h2 class="h2">Better to know <span class="scr">before you join.</span></h2>
  <div class="p21">
   <div class="col"><span class="scr">Yes</span><div class="card dash"><h3>This is for you if</h3><ul class="chk"><li>You have a job, kids, or both, and your free time comes in thirty-minute pieces.</li><li>You've saved a hundred ideas and started none of them.</li><li>You want something that belongs to you, without becoming an influencer.</li></ul></div></div>
   <div class="col"><span class="scr">Not yet</span><div class="card dash"><h3>It isn't for you if</h3><ul class="chk hm-x"><li>You want a promise about how fast the money comes. I won't make one.</li><li>You'd rather learn everything before building anything.</li></ul></div></div>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <div class="p42 dash ww2-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">From<b class="big">Jodie</b></span>
   <div class="ph"><img src="/images/library/path-blogging.jpg" width="1200" height="805" loading="lazy" decoding="async" alt="Over-the-shoulder view of a woman in a pink hoodie typing on a laptop in an armchair."></div>
   <div class="tx">
    <p class="kick">From the founder</p>
    <p class="wb2-q">&ldquo;I built this whole business faceless, with AI, in the hours I actually had. These are the first five steps, in the order that works.&rdquo;</p>
    <p class="ab2-sign">xoxo, Jodie</p>
   </div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">Where Day 5 can lead</p>
  <h2 class="h2">In their <span class="scr">own words.</span></h2>
  <div class="wb2-rv"><figure class="card dash ab2-rv"><span class="ab2-q" aria-hidden="true">&ldquo;</span><span class="wb2-stars" aria-label="5 out of 5">★★★★★</span><blockquote>{FEATURED.quote}</blockquote><figcaption><b>{FEATURED.name}</b>, {FEATURED.source.split(" ·")[0]}</figcaption></figure><figure class="card dash ab2-rv"><span class="ab2-q" aria-hidden="true">&ldquo;</span><span class="wb2-stars" aria-label="5 out of 5">★★★★★</span><blockquote>{BRITTANY.quote}</blockquote><figcaption><b>{BRITTANY.name}</b>, {BRITTANY.source.split(" ·")[0]}</figcaption></figure></div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Questions</span></p>
  <h2 class="h2">Before <span class="scr">you join.</span></h2>
  <div class="faq">{faq.map((f, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{f.q}</h3><p>{f.a}</p></div></div>)}</div>
 </div>
</section>

<section class="sec wash" id="join">
 <div class="wrap">
  <p class="kick">Free · 5 days</p>
  <h2 class="h2">Start today. <span class="scr">Have the skeleton by Day 5.</span></h2>
  <div class="card dash wb2-form">
   <iframe name="ml-sink-2" class="ml-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
   <form class="wbc-form" action={CHALLENGE_FORM} method="post" target="ml-sink-2" data-ml>
    <label class="sr" for="wbc-name-2">First name</label>
    <input id="wbc-name-2" type="text" name="fields[name]" placeholder="First name" autocomplete="given-name" />
    <label class="sr" for="wbc-email-2">Email</label>
    <input id="wbc-email-2" type="email" name="fields[email]" placeholder="Email address" autocomplete="email" required />
    <button type="submit">Start the challenge <span aria-hidden="true">→</span></button>
    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />
    <p class="done" role="status" hidden>You're in. Your welcome email lands in a minute or two, and Day 1 arrives tomorrow.</p>
   </form>
   <p class="bm2-small">Free. Starts the moment you join. Five days of assignments, then a few follow-ups. Unsubscribe anytime.</p>
  </div>
 </div>
</section>

<script is:inline>
  // The form posts into a hidden iframe, so MailerLite's raw {"success":true}
  // response never opens in a tab. When the iframe finishes loading, the form
  // swaps to the confirmation message.
  document.querySelectorAll('form[data-ml]').forEach(function (f) {
    var sink = document.getElementsByName(f.target)[0];
    var sent = false;
    f.addEventListener('submit', function () {
      sent = true;
      var btn = f.querySelector('button');
      btn.disabled = true; btn.textContent = 'Sending…';
    });
    sink.addEventListener('load', function () {
      if (!sent) return;
      f.querySelectorAll('input:not([type=hidden]), button').forEach(function (el) { el.hidden = true; });
      f.querySelector('.done').hidden = false;
      if (window.fbq) fbq('track', 'Lead', { content_name: 'Weekend Build Challenge' });
    });
  });
</script>
</TemplateLayout>
