---
// The Faceless Income Blueprint™ (the FREE GUIDE), rebuilt 20 Nov 2026 on Jodie's Etsy template.
import TemplateLayout from "../../layouts/TemplateLayout.astro";
import BlueprintForm from "../../components/BlueprintForm.astro";
import { membership } from "../../data/facts.js";

// The Faceless Income Blueprint™: canon products[] row, $0.
// Delivered right here (9 Oct 2026): the email goes to the MailerLite group
// "Faceless Income Blueprint" through /api/blueprint and the PDF is handed over
// on screen. The Beacons $0 product stays live for existing links.

const outcomes = [
  "A clear picture of how the pieces of a faceless business connect, so the saved reels and bookmarked guides finally have somewhere to go.",
  "The one engine that is actually holding you back, named on paper instead of guessed.",
  "A seven-day build order, and one next move instead of seventeen.",
];

const inside = [
  { t: "The two-engine framework", p: "The one every faceless business runs on: what you sell, and how you grow." },
  { t: "The bottleneck worksheet", p: "It tells you which engine is actually your bottleneck, instead of guessing." },
  { t: "The 7-day plug-in plan", p: "The exact order to build in, starting tonight." },
  { t: "One clear next step", p: "One thing to do next instead of seventeen." },
];

const forYou = [
  "You have collected tips for months and still can't say what you'd build first.",
  "You want a business that sells without your face on it.",
  "You'd rather see the whole structure once than learn it one reel at a time.",
];
---
<TemplateLayout title="Free Guide: The Faceless Income Blueprint™" description="A free 15-page guide: the whole faceless income machine on one page, a worksheet that finds your bottleneck, and a 7-day build order." stickyHref="#get" stickyLabel="Get the free Blueprint" heroBuy="#get button">

<section class="hh">
 <div class="wrap hh-grid bp2-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Free<b class="big">guide</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">FREE GUIDE · The Faceless Income Blueprint™</p>
   <h1>See the whole machine <span class="scr">on one page.</span></h1>
   <p class="what">The entire faceless income machine, on a single page, so you can stop collecting tips and start building. <b>Here's what you walk away with:</b></p>
   <ul class="chk bp2-out">{outcomes.map((o) => <li>{o}</li>)}</ul>
   <div class="rs2-form" id="get"><BlueprintForm heading="" sub="" button="Get the free Blueprint" /></div>
   <p class="see">15 pages · Free · No face required</p>
  </div>
  <figure class="bp2-fig"><div class="hh-ph"><img src="/images/covers/blueprint-real-cover.webp" sizes="(max-width: 900px) 80vw, 360px" width="480" height="621" fetchpriority="high" decoding="async" alt="The cover of The Faceless Income Blueprint™"></div></figure>
 </div>
</section>

<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>Who it's for</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <h2 class="h2">Not a laziness problem. <span class="scr">A structure problem.</span></h2>
  <div class="card dash bp2-who">
   <p>You've saved the reels. You've bookmarked the guides. You know it's possible, you've watched ordinary women do it, but every time you sit down to actually build, something's missing.</p>
   <p>This free guide puts the entire machine in front of you on a single page, so you can finally see how the pieces connect, and exactly where <em>you're</em> personally stuck. It's for you if:</p>
   <ul class="chk">{forYou.map((f) => <li>{f}</li>)}</ul>
   <p class="bp2-alt">Already selling, and about to pay for traffic? The <a href="/resources/starter-map">$10/Day Traffic Machine Starter Map</a> is the better free start.</p>
  </div>
 </div>
</section>

<section class="sec">
 <div class="wrap">
  <p class="kick">What's inside</p>
  <h2 class="h2">Four parts, <span class="scr">in build order.</span></h2>
  <div class="p44 bp2-in">
   <div class="ph"><img src="/images/pages/blueprint-pink-desk-520.webp" srcset="/images/pages/blueprint-pink-desk-520.webp 520w, /images/pages/blueprint-pink-desk-900.webp 900w" sizes="(max-width: 900px) 80vw, 380px" width="520" height="669" loading="lazy" decoding="async" alt="The pink Faceless Income Blueprint notebook on a light wooden desk in front of a pink computer, a tablet calendar and a blush tumbler."></div>
   <div class="card dash">
    <div class="faq bp2-parts">{inside.map((x, i) => <div class="qa"><span class="n">{String(i + 1).padStart(2, "0")}</span><div><h3>{x.t}</h3><p>{x.p}</p></div></div>)}</div>
    <div class="rs2-form"><BlueprintForm heading="Get it now, free." sub="Drop your email and the download opens on this page." /></div>
   </div>
  </div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">When you've read it</p>
  <h2 class="h2">Where to <span class="scr">go next.</span></h2>
  <div class="ab2-rooms">
   <a class="card dash" href="/resources/find-your-door"><span class="hm-lab">Free · No email</span><h3>Work out which door is yours.</h3><p>Thirteen questions, about three minutes, and one starting point named on screen. No email.</p><span class="btn">Find your door <span class="ar">→</span></span></a>
   <a class="card dash" href="/learn/how-to-build-a-faceless-digital-business"><span class="hm-lab">The full guide</span><h3>Read the full system.</h3><p>The long guide the Blueprint comes from, with every piece explained in order.</p><span class="btn">Read the guide <span class="ar">→</span></span></a>
   <a class="card dash" href="/membership"><span class="hm-lab">The membership</span><h3>Build it with people building the same week.</h3><p>Membership Standard is {membership.standard.perMonth} after a 7-day free trial: the classroom, the prompts, and somewhere to post the thing before you launch it.</p><span class="btn">See what's inside <span class="ar">→</span></span></a>
  </div>
  <p class="see" style="text-align:center;margin-top:30px"><a href="/resources">← All free resources</a></p>
 </div>
</section>
</TemplateLayout>
