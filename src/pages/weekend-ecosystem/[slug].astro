---
import CourseLayout from "../../layouts/CourseLayout.astro";
import { MODULES, VAULTS } from "../../we-manifest.js";

export function getStaticPaths() {
  const all = [
    ...MODULES.map((m, i) => ({
      ...m,
      prev: MODULES[i - 1] || null,
      next: MODULES[i + 1] || VAULTS[0] || null,
    })),
    ...VAULTS.map((v, i) => ({
      ...v,
      num: null,
      phase: "The Vaults",
      prev: i === 0 ? MODULES[MODULES.length - 1] : VAULTS[i - 1],
      next: VAULTS[i + 1] || null,
    })),
  ];
  return all.map((p) => ({ params: { slug: p.slug }, props: p }));
}

const { slug, num, title, phase, phaseSub, accent, prev, next } = Astro.props;
const eyebrow = num ? `${phase} — Module ${num} of 22` : phase;
const progress = num ? Math.round((num / 22) * 100) : 100;
---

<CourseLayout title={title} eyebrow={eyebrow} progress={progress} accent={accent}>
  <div id="locked" style="display:none">
    <p style="font-size:17px;line-height:1.8">
      This module is part of The Weekend Ecosystem™.
      <a href="/weekend-ecosystem" style="color:#D62E73">Enter your purchase email</a> to unlock it.
    </p>
  </div>

  <div id="loading" style="font-size:15px;color:rgba(43,22,27,.5)">Loading…</div>

  <div id="we-body"></div>

  <div id="mark" style="display:none">
    <div class="mk">
      <div class="mk-copy">
        <span class="mk-tag">Finished this module?</span>
        <p class="mk-line">Tick it off. Your progress and your certificate both run off these.</p>
      </div>
      <button id="mk-btn" class="mk-btn">
        <span class="mk-box"></span>
        <span id="mk-label">Mark complete</span>
      </button>
    </div>
    <p id="mk-count" class="mk-count"></p>
  </div>

  <div id="nav-foot" style="display:none">
    <div class="we-jump">
      {prev ? (
        <a href={`/weekend-ecosystem/${prev.slug}`} class="we-jump-card">
          <span class="we-jump-dir">← Previous</span>
          <span class="we-jump-t">{prev.title}</span>
        </a>
      ) : <span />}
      {next ? (
        <a href={`/weekend-ecosystem/${next.slug}`} class="we-jump-card we-jump-next">
          <span class="we-jump-dir">Next →</span>
          <span class="we-jump-t">{next.title}</span>
        </a>
      ) : (
        <a href="/weekend-ecosystem" class="we-jump-card we-jump-next">
          <span class="we-jump-dir">Done →</span>
          <span class="we-jump-t">Back to all modules</span>
        </a>
      )}
    </div>
  </div>

  <style>
    .mk{display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;
        margin-top:58px;padding:24px 26px;border-radius:6px;
        background:linear-gradient(120deg,color-mix(in srgb,var(--ac,#D62E73) 16%,transparent),color-mix(in srgb,var(--ac,#D62E73) 6%,transparent));
        border:1px solid color-mix(in srgb,var(--ac,#D62E73) 34%,transparent)}
    .mk-tag{display:block;font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--ac,#D62E73);margin-bottom:7px}
    .mk-line{font-size:15.5px;line-height:1.6;margin:0;color:rgba(43,22,27,.72)}
    .mk-btn{display:inline-flex;align-items:center;gap:11px;padding:13px 22px;border-radius:5px;cursor:pointer;
            background:#fff;border:1.5px solid var(--ac,#D62E73);color:var(--ac,#D62E73);
            font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:1.8px;text-transform:uppercase;
            transition:all .22s;flex-shrink:0}
    .mk-btn:hover{transform:translateY(-1px);box-shadow:0 5px 16px color-mix(in srgb,var(--ac,#D62E73) 28%,transparent)}
    .mk-box{width:16px;height:16px;border-radius:4px;border:1.5px solid currentColor;display:flex;align-items:center;justify-content:center}
    .mk-btn.done{background:var(--ac,#D62E73);border-color:var(--ac,#D62E73);color:#fff}
    .mk-btn.done .mk-box{background:#fff;border-color:#fff}
    .mk-btn.done .mk-box:after{content:"";width:4px;height:8px;border:solid var(--ac,#D62E73);border-width:0 2px 2px 0;transform:rotate(45deg) translate(-1px,-1px)}
    .mk-btn.pop{animation:pop .45s cubic-bezier(.34,1.56,.64,1)}
    @keyframes pop{0%{transform:scale(1)}45%{transform:scale(1.07)}100%{transform:scale(1)}}
    .mk-count{font-family:"JetBrains Mono",monospace;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;
              color:rgba(43,22,27,.5);margin:14px 0 0;text-align:right}
    .mk-count a{color:#D62E73;text-decoration:none}
    @media(prefers-reduced-motion:reduce){.mk-btn.pop{animation:none}}
    @media(max-width:640px){.mk{flex-direction:column;align-items:flex-start}.mk-count{text-align:left}}
    .we-jump{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:70px;padding-top:38px;border-top:1px solid rgba(43,22,27,.13)}
    .we-jump-card{display:flex;flex-direction:column;gap:8px;padding:20px 22px;border:1px solid rgba(43,22,27,.14);border-radius:4px;text-decoration:none;color:#2B161B;transition:border-color .2s,background .2s}
    .we-jump-card:hover{border-color:#D62E73;background:rgba(214,46,115,.03)}
    .we-jump-next{text-align:right;align-items:flex-end}
    .we-jump-dir{font-family:"JetBrains Mono",monospace;font-size:10px;letter-spacing:1.8px;text-transform:uppercase;color:#C8A96A}
    .we-jump-t{font-family:"Fraunces",serif;font-size:17px;line-height:1.3}
    @media(max-width:640px){.we-jump{grid-template-columns:1fr}.we-jump-next{text-align:left;align-items:flex-start}}
  </style>

</CourseLayout>

<script define:vars={{ slug }}>
  const KEY = "we_token";
  const token = localStorage.getItem(KEY);
  const body = document.getElementById("we-body");
  const loading = document.getElementById("loading");
  const locked = document.getElementById("locked");
  const navFoot = document.getElementById("nav-foot");

  function addCopyButtons() {
    document.querySelectorAll("#we-body pre").forEach((pre) => {
      const b = document.createElement("button");
      b.className = "copy-btn";
      b.textContent = "Copy";
      b.addEventListener("click", () => {
        navigator.clipboard.writeText(pre.innerText);
        b.textContent = "Copied";
        b.classList.add("done");
        setTimeout(() => {
          b.textContent = "Copy";
          b.classList.remove("done");
        }, 1600);
      });
      const bar = pre.closest(".wb-prompt")?.querySelector(".wb-prompt-bar");
      (bar || pre).appendChild(b);
    });
  }

  async function load() {
    if (!token) {
      loading.style.display = "none";
      locked.style.display = "block";
      return;
    }
    try {
      const r = await fetch("/api/module", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token, slug }),
      });
      if (r.status === 401) {
        localStorage.removeItem(KEY);
        loading.style.display = "none";
        locked.style.display = "block";
        return;
      }
      const d = await r.json();
      body.innerHTML = d.html;
      loading.style.display = "none";
      navFoot.style.display = "block";
      document.getElementById("mark").style.display = "block";
      addCopyButtons();
      wireMark();
    } catch {
      loading.textContent = "Couldn't load this module. Refresh to try again.";
    }
  }

  const DONE = "we_done";
  const TOTAL = 22;

  function getDone() {
    try { return JSON.parse(localStorage.getItem(DONE) || "[]"); } catch { return []; }
  }

  function renderMark() {
    const done = getDone();
    const isDone = done.includes(slug);
    const btn = document.getElementById("mk-btn");
    const label = document.getElementById("mk-label");
    const count = document.getElementById("mk-count");
    btn.classList.toggle("done", isDone);
    label.textContent = isDone ? "Completed" : "Mark complete";
    const n = done.length;
    if (n >= TOTAL) {
      count.innerHTML = `All ${TOTAL} complete — <a href="/weekend-ecosystem/certificate">open your certificate →</a>`;
    } else {
      count.textContent = `${n} of ${TOTAL} modules complete · ${TOTAL - n} to unlock your certificate`;
    }
  }

  function wireMark() {
    const btn = document.getElementById("mk-btn");
    renderMark();
    btn.addEventListener("click", () => {
      const done = getDone();
      const i = done.indexOf(slug);
      if (i === -1) {
        done.push(slug);
        btn.classList.add("pop");
        setTimeout(() => btn.classList.remove("pop"), 480);
      } else {
        done.splice(i, 1);
      }
      localStorage.setItem(DONE, JSON.stringify(done));
      renderMark();
    });
  }

  load();
</script>
