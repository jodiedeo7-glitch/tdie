    .pv-mnum{font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;color:rgba(43,22,27,.4);margin-right:7px}
    .pv-more{font-size:13px;color:rgba(43,22,27,.45);margin:10px 0 0;text-align:center;font-style:italic}

    .pv-eyebrow{display:block;font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:#CD9CDD;margin-bottom:10px}
    .pv-h1{display:block;font-family:"Fraunces",serif;font-size:29px;font-weight:300;letter-spacing:-.7px;color:#2B161B;margin-bottom:18px}
    .pv-lead-italic{font-family:"Cormorant Garamond",serif;font-size:19px;font-style:italic;line-height:1.6;color:#3B2228;margin:0 0 20px;padding-bottom:18px;border-bottom:1px solid rgba(43,22,27,.13)}
    .pv-step{display:flex;align-items:center;gap:13px;margin-bottom:14px}
    .pv-stepnum{width:31px;height:31px;border-radius:50%;background:#CD9CDD;color:#fff;display:flex;align-items:center;justify-content:center;font-family:"JetBrains Mono","Inter",monospace;font-size:11px;flex-shrink:0}
    .pv-steplabel{font-family:"Fraunces",serif;font-size:19px;color:#2B161B}

    .pv-prompt{border-radius:5px;overflow:hidden;border:1px solid rgba(214,46,115,.22);background:#FFFDFB;margin-bottom:14px}
    .pv-prompt-solo{max-width:640px;margin-bottom:0}
    .pv-pbar{display:flex;justify-content:space-between;align-items:center;padding:10px 13px;background:rgba(255,138,194,.16);border-bottom:1px solid rgba(214,46,115,.14)}
    .pv-pbar span{font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pink)}
    .pv-pbar em{font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;letter-spacing:1.6px;text-transform:uppercase;font-style:normal;color:var(--pink);border:1px solid rgba(214,46,115,.4);border-radius:3px;padding:3px 10px;background:#fff;cursor:pointer}
    .pv-prompt code{display:block;padding:16px 18px;font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12.5px;line-height:1.72;color:#4A2C34;white-space:pre-wrap;overflow-x:auto}

    .pv-road{display:flex;flex-direction:column;gap:8px;border:1px solid rgba(214,46,115,.18);background:rgba(255,138,194,.06);border-radius:5px;padding:14px 16px}
    .pv-road span{font-family:"JetBrains Mono","Inter",monospace;font-size:9px;letter-spacing:1.8px;text-transform:uppercase;color:var(--pink)}
    .pv-road em{font-style:normal;font-size:14.5px;color:#2B161B}

    .pv-group{font-family:"JetBrains Mono","Inter",monospace;font-size:10px;letter-spacing:2.4px;text-transform:uppercase;color:#C8A96A;margin:20px 0 14px;padding-bottom:8px;border-bottom:1px solid rgba(200,169,106,.35)}
    .pv-group:first-of-type{margin-top:6px}
    .pv-qs{display:flex;gap:14px;align-items:flex-start;padding:11px 0}
    .pv-qsn{font-family:"JetBrains Mono","Inter",monospace;font-size:10.5px;color:var(--pink);padding-top:4px;flex-shrink:0}
    .pv-qs b{display:block;font-family:"Fraunces",serif;font-weight:400;font-size:18px;color:#2B161B;margin-bottom:4px}
    .pv-qs i{display:block;font-style:normal;font-size:14.5px;line-height:1.6;color:rgba(43,22,27,.66)}
    .pv-qs-blur,.pv-group-blur{filter:blur(3.5px);opacity:.5;user-select:none;pointer-events:none}
    .pv-out{border:1px solid rgba(43,22,27,.13);border-radius:7px;padding:22px 24px 18px;margin-bottom:14px;background:#FFFDFB;max-width:720px}
    .pv-otag{font-family:"JetBrains Mono","Inter",monospace;font-size:10px;letter-spacing:2.2px;text-transform:uppercase;color:var(--pink);margin-bottom:16px}
    .pv-o{padding:12px 0;border-top:1px solid rgba(43,22,27,.09)}
    .pv-o:first-of-type{border-top:none;padding-top:0}
    .pv-o b{display:block;font-family:"Fraunces",serif;font-weight:400;font-size:18px;color:#2B161B;margin-bottom:5px}
    .pv-o i{display:block;font-style:normal;font-size:14.5px;line-height:1.62;color:rgba(43,22,27,.68)}
    .pv-o-plain i{font-family:"Cormorant Garamond",serif;font-style:italic;font-size:17.5px;color:#3B2228;line-height:1.55}
    .pv-omore{font-size:13.5px;color:rgba(43,22,27,.5);margin:14px 0 0;font-style:italic;padding-top:12px;border-top:1px solid rgba(43,22,27,.09)}
    .pv-slides{display:grid;grid-template-columns:1fr 1fr;gap:10px}
    .pv-slides span{display:flex;align-items:center;padding:18px 16px;border-radius:6px;font-family:"Fraunces",serif;font-size:15px;line-height:1.3;color:#2B161B;
                    background:linear-gradient(160deg,rgba(255,138,194,.18),rgba(203,183,247,.12));border:1px solid rgba(214,46,115,.18);min-height:74px}
    .pv-slides span:first-child{font-size:17px;background:linear-gradient(160deg,rgba(214,46,115,.2),rgba(255,138,194,.12))}
    .pv-out-half{display:grid;grid-template-columns:1fr 1fr;gap:26px}
