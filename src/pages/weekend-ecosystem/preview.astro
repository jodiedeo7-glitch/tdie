    .pv-tally{margin-left:auto;font-family:"JetBrains Mono","Inter",monospace;font-size:10px;color:#fff;background:var(--ac);padding:4px 9px;border-radius:20px}
    .pv-mods{display:flex;flex-direction:column;gap:1px}
