    @media(max-width:640px){.pv-slides,.pv-out-half{grid-template-columns:1fr}}
    .pv-two{display:grid;grid-template-columns:1fr 1fr;gap:16px;max-width:720px}
    .pv-card{border-radius:8px;padding:26px;border:1px solid rgba(43,22,27,.14);background:#FFFDFB}
    .pv-ctag{display:block;font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:#8A6B44;margin-bottom:16px}
    .pv-card p{font-size:14.5px;line-height:1.6;color:#57404A;margin:16px 0 0}
    .pv-ring{width:88px;height:88px;border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;
             background:conic-gradient(#D62E73 0 63%,rgba(43,22,27,.09) 63%)}
    .pv-ring:after{content:"";position:absolute;inset:10px;border-radius:50%;background:#FFFDFB}
    .pv-ring span{position:relative;z-index:1;font-family:"Fraunces",serif;font-size:24px;font-weight:300;color:#2B161B}
    .pv-ring small{font-size:13px;opacity:.45}
    .pv-cert{background:linear-gradient(150deg,rgba(185,162,232,.26),rgba(200,123,166,.15))}
    .pv-certh{display:block;font-family:"JetBrains Mono","Inter",monospace;font-size:9.5px;letter-spacing:2.4px;text-transform:uppercase;color:#C8A96A;margin-bottom:12px}
    .pv-certname{display:block;font-family:"Fraunces",serif;font-size:24px;font-weight:300;color:#2B161B;padding-bottom:12px;border-bottom:1px solid rgba(214,46,115,.3)}

    .pv-close{text-align:center;padding:70px 40px 66px;margin-top:60px;border-radius:8px;
              background:linear-gradient(145deg,#B9A2E8 0%,#C79AD2 34%,#C87BA6 64%,#A8446B 100%)}
    .pv-close h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,4.8vw,44px);margin:0 0 14px;letter-spacing:-.8px;color:#fff}
    .pv-clede{font-size:17px;line-height:1.7;color:#FBEEF4;max-width:48ch;margin:0 auto 32px}
    .pv-hero-btn{display:inline-block;margin-bottom:30px}
    .pv-cnote{font-size:13px;line-height:1.6;color:rgba(251,238,244,.78);margin:20px auto 0;max-width:46ch}
    .pv-cnote-alt{margin-top:12px}
    .pv-cnote-alt a{color:#FBF8F5;text-decoration:underline}
