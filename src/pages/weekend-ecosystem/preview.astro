---
import PageLayout from "../../layouts/PageLayout.astro";
import { MODULES } from "../../we-manifest.js";
import { S, HREF } from "../../we-stage.js";
import { OBJECTIONS } from "../../we-objections.js";
import Testimonial from "../../components/Testimonial.astro";
import WePrice from "../../components/WePrice.astro";
import WeBundle from "../../components/WeBundle.astro";
import WeRibbon from "../../components/WeRibbon.astro";
import "../../styles/we.css";

const phases = [...new Set(MODULES.map((m) => m.phase))].map((p) => {
  const inPhase = MODULES.filter((m) => m.phase === p);
  return {
    accent: inPhase[0].accent,
    day: inPhase[0].phaseLabel.split("·")[1]?.trim() ?? p,
    title: inPhase[0].phaseSub.split("—")[0].trim(),
    mods: inPhase,
  };
});

const SCAFFOLD = [
  "Build the scaffold for my Astro site. Use my Canon File in project knowledge as the source of truth.",
  "",
  "LIVE FACTS (these override anything that disagrees):",
  "- Domain: [yourdomain.com]",
  "- URL pattern: /learn/[slug], flat, no folders",
  "  \u2026",
].join("\n");

const onPage = [
  { id: "box", t: "Everything in the box" },
  { id: "index", t: "The module index" },
  { id: "module", t: "A real module" },
  { id: "prompts", t: "The prompts" },
  { id: "output", t: "What one prompt produces" },
  { id: "progress", t: "Progress + certificate" },
  { id: "questions", t: "Before you decide" },
];
---
<PageLayout
  ogImage="/og/weekend-ecosystem-preview.jpg"
  wide
  title="Inside The Weekend Ecosystem™"
  description="A free look inside The Weekend Ecosystem™, no email: the module index, a real module, the prompt cards, real output and the progress tracker."
>
<div class="wx wx-preview">

  <!-- HERO -->
  <section class="wx-hero">
    <div>
      <p class="wx-brand"><span class="wx-dot"></span><span><span class="wx-brand-x">A look inside </span>The Weekend Ecosystem™<span class="wx-brand-x"> · Free</span></span></p>
      <h1 class="pv-hero-h">Walk inside before you buy. <em>This is the real course.</em></h1>
      <p class="wx-lede">By Sunday: a website on a domain you own, a blog Google can find, an email list that captures, and every reader routed to your free offer and your paid one. Built from content you already wrote, without your face. <strong>Everything below is the real interface. No email, no card, nothing to enter.</strong></p>
      <nav class="pv-toc" aria-label="On this page">
        {onPage.map((x, i) => (
          <a href={`#${x.id}`}><b>{String(i).padStart(2, "0")}</b>{x.t}</a>
        ))}
      </nav>
      <div class="pv-hero-cta"><span>Ready to build yours?</span><a href="/shop/weekend-ecosystem">See the full course →</a></div>
    </div>
    <div class="wx-collage pv-collage">
      <figure class="wx-polaroid">
        <span class="wx-tape wx-tape-l" aria-hidden="true"></span>
        <img src="/images/we/preview-hero.jpg" alt="At the pink attic desk in the evening, the pasture and red barn through the window." loading="eager" width="1400" height="1737" />
        <figcaption>Friday night, the attic desk. Module&nbsp;01.</figcaption>
      </figure>
      <span class="wx-sticker wx-sticker-a" aria-hidden="true"><span>Free<br />no email</span></span>
      <span class="wx-sticker wx-sticker-b" aria-hidden="true"><span>The real<br />interface</span></span>
    </div>
  </section>

  <div class="wx-cred-strip pv-cred-strip" aria-label="Course contents">
    <div><strong>22</strong><span>modules</span></div>
    <div><strong>36</strong><span>build prompts</span></div>
    <div><strong>3</strong><span>reference vaults</span></div>
    <div><strong>∞</strong><span>future updates</span></div>
  </div>

  <WeRibbon />

  <!-- IN THE BOX -->
  <section class="wx-sec pv-sec" id="box">
    <span class="pv-n">00</span>
    <h2>Everything <em>in the box.</em></h2>
    <p class="pv-b">Before the close-ups, the whole thing at once. It's a live site you log into, and every piece below is inside it.</p>
    <WeBundle />
  </section>

  <!-- 01 INDEX -->
  <section class="wx-sec pv-sec" id="index">
    <span class="pv-n">01</span>
    <h2>The module <em>index.</em></h2>
    <p class="pv-b">Twenty-two modules across six phases. Each phase has its own colour, running from lavender on Friday night to hot pink by Sunday afternoon, so you always know where you are in the weekend.</p>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body pv-body-index">
        {phases.map((p, i) => (
          <div class="pv-phase" style={`--ac:${p.accent}`}>
            <span class="pv-edge"></span>
            <div class="pv-phead">
              <span class="pv-pnum">{String(i).padStart(2, "0")}</span>
              <div>
                <span class="pv-pday">{p.day}</span>
                <span class="pv-ptitle">{p.title}</span>
              </div>
              <span class="pv-tally">0/{p.mods.length}</span>
            </div>
            <div class="pv-mods">
              {p.mods.map((m) => (
                <span class="pv-mod">
                  <span class="pv-tick"></span>
                  <span class="pv-mnum">{String(m.num).padStart(2, "0")}</span>
                  {m.title}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 02 MODULE -->
  <section class="wx-sec pv-sec" id="module">
    <span class="pv-n">02</span>
    <h2>A real <em>module.</em></h2>
    <p class="pv-b">Every module runs the same way. The idea, then a numbered spine of actions, then the prompt you paste, then a collapsed panel of fixes for when something breaks. You never have to work out what to do next.</p>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body">
        <span class="pv-eyebrow">Phase 1 · Module 5 of 22</span>
        <span class="pv-h1">Claude Builds the Repo</span>
        <p class="pv-lead-italic">You're about to ask Claude to generate an entire website's worth of files. This works, reliably, but only with the right setup.</p>
        <div class="pv-step"><span class="pv-stepnum">01</span><span class="pv-steplabel">The scaffold prompt</span></div>
        <div class="pv-prompt">
          <div class="pv-pbar"><span>Copy this prompt</span><em>Copy</em></div>
          <code set:text={SCAFFOLD} />
        </div>
        <div class="pv-road">
          <span>If you get stuck</span>
          <em>+ Claude gave me a fragment, not the whole file</em>
          <em>+ I don't know if this file is right</em>
        </div>
      </div>
    </div>

    <div class="pv-who">
      <div class="wx-card">
        <span class="wx-kicker" style="color:#6B4FA8">Claude does</span>
        <p>Writes every file, every article, every SEO pass, every image, and commits it to your site.</p>
      </div>
      <div class="wx-hot">
        <span class="wx-kicker" style="color:#fff">You do</span>
        <p>Paste the prompt. Read what came back. Say yes, or say what to change.</p>
      </div>
    </div>

    <div class="pv-tina">
      <Testimonial variant="full" eyebrow="What a member built with it" />
    </div>
  </section>

  <!-- 03 PROMPTS -->
  <section class="wx-sec pv-sec" id="prompts">
    <span class="pv-n">03</span>
    <h2>Thirty-six prompts, <em>written out in full.</em></h2>
    <p class="pv-b">Not summaries. Not "adapt this to your business." Every prompt is complete, sits in its own copy card, and is ready to run the moment you paste it. Here's the Quick Sheet: every prompt in the order you actually use them.</p>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body">
        <span class="pv-eyebrow">Every prompt, in the order you run them</span>
        <span class="pv-h1">The Quick Sheet</span>
        <div class="pv-group">Friday night · prep</div>
        <div class="pv-qs"><span class="pv-qsn">01</span><div><b>Content inventory</b><i>Point a browser agent at your Skool group. It reads every lesson, post and file and hands you one table.</i></div></div>
        <div class="pv-qs"><span class="pv-qsn">02</span><div><b>Canon File</b><i>The document that stops Claude inventing products you don't sell.</i></div></div>
        <div class="pv-qs pv-qs-blur" aria-hidden="true"><span class="pv-qsn">03</span><div><b>Standing instruction</b><i>Makes Claude flag conflicts instead of quietly guessing.</i></div></div>
        <div class="pv-group pv-group-blur" aria-hidden="true">Saturday morning · the website</div>
        <div class="pv-qs pv-qs-blur" aria-hidden="true"><span class="pv-qsn">05</span><div><b>Site scaffold</b><i>Generates every file your site needs.</i></div></div>
        <div class="pv-qs pv-qs-blur" aria-hidden="true"><span class="pv-qsn">06</span><div><b>Homepage copy</b><i>Four sections, no fluff.</i></div></div>
        <p class="pv-more">…thirty more, each with the full prompt underneath</p>
      </div>
    </div>

    <div class="wx-card wx-mid">
      <p class="wx-mid-l">Seen enough to know it's the real thing?</p>
      <WePrice note="Both options are at checkout. Every future update included, free." />
    </div>
  </section>

  <!-- 04 OUTPUT -->
  <section class="wx-sec pv-sec" id="output">
    <span class="pv-n">04</span>
    <h2>What one prompt <em>actually produces.</em></h2>
    <p class="pv-b">This is the module people message me about afterwards. You publish an article, paste one prompt, and twenty-four finished assets come back. Below is the real output from running it against this page. Not a sample: the actual thing.</p>

    <div class="wx-card pv-out">
      <div class="pv-otag">Ten pins · titles and descriptions</div>
      <div class="pv-o"><b>How to turn your Skool content into a blog</b><i>Your best lessons are already written. They're just trapped where nobody can search them. Here's how to move them onto a site you own.</i></div>
      <div class="pv-o"><b>Where to find blog content you already wrote</b><i>Six places your best writing is already sitting. Most creators find dozens of pieces they'd forgotten about.</i></div>
      <div class="pv-o"><b>You don't need to code to build a website</b><i>Everything that used to be required, and isn't anymore. AI writes the files; you paste and approve.</i></div>
      <p class="pv-omore">+ seven more, each a different layout, each with its own image prompt and board</p>
    </div>

    <div class="wx-card pv-out">
      <div class="pv-otag">An 8-slide carousel</div>
      <div class="pv-slides">
        <span>YOU ALREADY WROTE THE BLOG POSTS.</span>
        <span>Every lesson in your classroom is an article.</span>
        <span>Every call recording is three posts.</span>
        <span>None of it is searchable.</span>
      </div>
      <p class="pv-omore">+ four more slides, plus the caption and five hashtags</p>
    </div>

    <div class="wx-card pv-out">
      <div class="pv-otag">Eight Threads posts</div>
      <div class="pv-o pv-o-plain"><i>"Count the lessons in your Skool classroom. Now count how many a stranger could find on Google today. That gap is the whole problem."</i></div>
      <div class="pv-o pv-o-plain"><i>"A post dies in three days. An article works for eighteen months. We spend almost all our time on the first one."</i></div>
      <div class="pv-o pv-o-plain"><i>"Renting: Skool, Instagram, TikTok, Pinterest. Owning: a domain, a site, an email list. Do both. But please do the second one."</i></div>
      <p class="pv-omore">+ five more, each a different structure, no two opening the same way</p>
    </div>

    <div class="wx-card pv-out pv-out-half">
      <div>
        <div class="pv-otag">Two reels</div>
        <p class="pv-osmall">A full video generation prompt plus a matching cover still in the same setting, wardrobe and palette, so the cover and the video read as one asset. On-screen text and caption included.</p>
      </div>
      <div>
        <div class="pv-otag">Plus</div>
        <p class="pv-osmall">A Facebook post in a warmer register. An email with subject line and preview text. A community post that doesn't sound like your blog. And a plain list of every headline, for reuse.</p>
      </div>
    </div>

    <p class="pv-note">Twenty-four things across six platforms, from one afternoon, and the article underneath keeps working the whole time they circulate.</p>
  </section>

  <!-- 05 PROGRESS -->
  <section class="wx-sec pv-sec" id="progress">
    <span class="pv-n">05</span>
    <h2>Progress, and <em>the certificate.</em></h2>
    <p class="pv-b">Tick each module off as you finish it. The ring fills, each phase keeps its own tally, and at twenty-two a completion certificate unlocks with your name on it.</p>

    <div class="pv-two">
      <div class="wx-card">
        <span class="pv-ctag">Your progress</span>
        <div class="pv-ring"><span>14<small>/22</small></span></div>
        <p>Over halfway. The site exists by now.</p>
      </div>
      <div class="wx-card pv-cert">
        <span class="pv-ctag">At twenty-two</span>
        <span class="pv-certname">Certificate of Completion</span>
        <p>Your name, the date, and something to post when you're done.</p>
      </div>
    </div>
  </section>

  <!-- 06 OBJECTIONS -->
  <section class="wx-sec pv-sec" id="questions">
    <span class="pv-n">06</span>
    <h2>Before <em>you decide.</em></h2>
    <p class="pv-b">The six things that stop people, answered straight. No guarantee, because there isn't one.</p>
    <div class="wx-faq pv-faq">
      {OBJECTIONS.map((o) => (
        <details open={o.id === "no-refunds"}>
          <summary>{o.q}</summary>
          <p>{o.short}</p>
        </details>
      ))}
    </div>
    <p class="pv-b pv-more-q">The full answers, the complete module list and everything that comes with it are on <a class="wx-link" href="/shop/weekend-ecosystem#questions">the sales page</a>.</p>
  </section>

  <!-- CLOSE -->
  <section class="wx-card wx-close">
    <div class="wx-close-img">
      <img src="/images/we/preview-working.jpg" alt="Typing at the farmhouse kitchen table on a bright morning, her golden retriever beside her chair." loading="lazy" width="1400" height="1737" style="object-position:55% 25%" />
    </div>
    <div class="wx-close-body">
      <span class="wx-kicker">That's the whole thing</span>
      <h2>Twenty-two modules, thirty-six prompts, <em>every future update.</em></h2>
      <p class="wx-close-l">Three reference vaults, the Quick Sheet, the Ask-For-It List, the tracker and the certificate. One payment or three.</p>
      <WePrice note="No refunds. Both options are at checkout. Every future update included, free." />
      <p class="wx-access">{S.access}</p>
      <div class="wx-final-line"><Testimonial variant="line" /></div>
    </div>
  </section>

  <div class="wx-sticky" id="wx-sticky">
    <div class="wx-sticky-in">
      <p class="wx-sticky-p"><b>$97</b>or 3 × $33.33</p>
      <a class="wx-btn" href={HREF}>{S.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>

</div>

<style>
  .page-wrap .pv-hero-h{font-size:clamp(32px,4.2vw,50px)}
  .pv-toc{display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:520px}
  .pv-toc a{display:flex;align-items:center;gap:10px;min-height:48px;padding:10px 14px;border-radius:14px;text-decoration:none;
            font-size:15px;line-height:1.3;font-weight:600;color:var(--ink);background:rgba(255,253,252,.82);border:1px solid var(--edge);
            box-shadow:0 12px 24px -20px rgba(214,46,115,.5)}
  .pv-toc a:hover{border-color:var(--hot)}
  .pv-toc b{flex:none;font:800 12px/1 Inter,sans-serif;color:var(--hot)}

  .pv-sec{scroll-margin-top:80px;padding:clamp(56px,6vw,88px) 0}
  .pv-cred-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr))}
  .pv-cred-strip div{display:flex;align-items:baseline;justify-content:center;gap:8px;padding:12px 16px;text-align:center}
  .pv-cred-strip strong{font:600 clamp(28px,3.2vw,42px)/1 Newsreader,Georgia,serif;color:var(--hot)}
  .pv-cred-strip span{font:700 12px/1.3 Inter,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft)}
  .pv-n{display:inline-block;font:800 12px/1 Inter,sans-serif;letter-spacing:2px;color:#fff;background:var(--hot);padding:7px 11px;border-radius:999px;transform:rotate(-2deg);margin-bottom:14px}
  .pv-sec h2{font-size:clamp(30px,4.4vw,44px);line-height:1.08;margin:0 0 14px}
  .pv-b{font-size:18px;line-height:1.7;max-width:640px;margin-top:0!important;margin-bottom:28px!important;color:var(--ink-soft)}
  /* Desktop: one centred 760 px reading column, left edges aligned, instead of everything hugging the left. */
  .pv-sec:not(#box) > :not(.wx-mid){margin-left:max(0px,calc((100% - 760px) / 2))}
  .pv-note{font-family:Newsreader,Georgia,serif;font-weight:600;font-style:italic;font-size:20px;line-height:1.5;color:var(--hot);margin-top:22px!important;margin-bottom:0!important;max-width:720px}

  .pv-shot{border-radius:18px;overflow:hidden;border:1px solid var(--edge);background:var(--cream);box-shadow:var(--shadow);max-width:760px}
  .pv-bar{display:flex;gap:6px;padding:12px 16px;background:rgba(26,20,23,.05);border-bottom:1px solid rgba(26,20,23,.08)}
  .pv-bar span{width:10px;height:10px;border-radius:50%;background:rgba(26,20,23,.16)}
  .pv-bar span:first-child{background:var(--bub)}
  .pv-body{padding:26px 28px 28px}
  .pv-body-index{padding:20px}

  .pv-phase{position:relative;overflow:hidden;border:1px solid rgba(26,20,23,.1);border-radius:12px;padding:18px 20px 14px 24px;margin-bottom:12px;background:#fff}
  .pv-edge{position:absolute;left:0;top:0;bottom:0;width:6px;background:var(--ac)}
  .pv-phead{display:flex;gap:13px;align-items:flex-start;padding-bottom:12px;margin-bottom:8px;border-bottom:1px solid color-mix(in srgb,var(--ac) 50%,transparent)}
  .pv-pnum{font-family:Newsreader,Georgia,serif;font-weight:600;font-size:34px;line-height:.85;color:var(--ac)}
  .pv-pday{display:block;font:700 12px/1.3 Inter,sans-serif;letter-spacing:1.8px;text-transform:uppercase;color:var(--ink-soft);margin-bottom:3px}
  .pv-ptitle{display:block;font-family:Newsreader,Georgia,serif;font-weight:600;font-size:20px;color:var(--ink)}
  .pv-tally{margin-left:auto;font:700 12px/1 Inter,sans-serif;color:#fff;background:var(--hot);padding:5px 9px;border-radius:999px}
  .pv-mods{display:flex;flex-direction:column}
  .pv-mod{position:relative;padding:8px 0 8px 26px;font-size:16px;line-height:1.4;color:var(--ink)}
  .pv-tick{position:absolute;left:0;top:10px;width:15px;height:15px;border-radius:4px;border:1.5px solid rgba(26,20,23,.28)}
  .pv-mnum{font:700 12px/1 Inter,sans-serif;color:var(--hot);margin-right:8px}

  .pv-eyebrow{display:block;font:700 12px/1.4 Inter,sans-serif;letter-spacing:2px;text-transform:uppercase;color:var(--hot);margin-bottom:10px}
  .pv-h1{display:block;font-family:Newsreader,Georgia,serif;font-weight:600;font-size:29px;line-height:1.15;color:var(--ink);margin-bottom:16px}
  .pv-lead-italic{font-family:Newsreader,Georgia,serif;font-style:italic;font-size:19px;line-height:1.6;color:var(--ink-soft);margin:0 0 20px!important;padding-bottom:18px;border-bottom:1px solid rgba(26,20,23,.12)}
  .pv-step{display:flex;align-items:center;gap:13px;margin-bottom:14px}
  .pv-stepnum{width:32px;height:32px;border-radius:50%;background:var(--hot);color:#fff;display:flex;align-items:center;justify-content:center;font:700 12px/1 Inter,sans-serif;flex-shrink:0}
  .pv-steplabel{font-family:Newsreader,Georgia,serif;font-weight:600;font-size:19px;color:var(--ink)}
  .pv-prompt{border-radius:12px;overflow:hidden;border:1px solid rgba(214,46,115,.25);background:#fff;margin-bottom:14px}
  .pv-pbar{display:flex;justify-content:space-between;align-items:center;padding:10px 14px;background:rgba(255,138,194,.16);border-bottom:1px solid rgba(214,46,115,.14)}
  .pv-pbar span{font:700 12px/1 Inter,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:var(--hot-deep)}
  .pv-pbar em{font:700 12px/1 Inter,sans-serif;letter-spacing:1.4px;text-transform:uppercase;font-style:normal;color:var(--hot-deep);border:1px solid rgba(214,46,115,.4);border-radius:999px;padding:5px 11px;background:#fff}
  .pv-prompt code{display:block;padding:16px 18px;font-family:ui-monospace,"SF Mono",Menlo,monospace;font-size:13.5px;line-height:1.7;color:#3A2A30;white-space:pre-wrap;overflow-wrap:anywhere}
  .pv-road{display:flex;flex-direction:column;gap:8px;border:1px dashed rgba(214,46,115,.4);background:rgba(255,138,194,.08);border-radius:12px;padding:14px 16px}
  .pv-road span{font:700 12px/1.3 Inter,sans-serif;letter-spacing:1.6px;text-transform:uppercase;color:var(--hot-deep)}
  .pv-road em{font-style:normal;font-size:15px;color:var(--ink)}

  .pv-who{display:grid;grid-template-columns:1fr 1fr;gap:14px;max-width:760px;margin-top:18px}
  .pv-who p{font-size:16.5px;line-height:1.55}
  .pv-who .wx-hot p{font-family:Newsreader,Georgia,serif;font-weight:600;font-size:21px;line-height:1.35;color:#fff}
  .pv-tina{max-width:760px}

  .pv-group{font:700 12px/1.3 Inter,sans-serif;letter-spacing:2px;text-transform:uppercase;color:var(--ink-soft);margin:20px 0 10px;padding-bottom:8px;border-bottom:1px solid var(--edge)}
  .pv-qs{display:flex;gap:14px;align-items:flex-start;padding:10px 0}
  .pv-qsn{font:700 12px/1 Inter,sans-serif;color:var(--hot);padding-top:6px;flex-shrink:0}
  .pv-qs b{display:block;font-family:Newsreader,Georgia,serif;font-weight:600;font-size:19px;color:var(--ink);margin-bottom:4px}
  .pv-qs i{display:block;font-style:normal;font-size:15.5px;line-height:1.55;color:var(--ink-soft)}
  .pv-qs-blur,.pv-group-blur{filter:blur(3.5px);opacity:.5;user-select:none;pointer-events:none}
  .pv-more{font-size:14.5px;color:var(--ink-soft);margin:12px 0 0!important;text-align:center;font-style:italic}

  .pv-out{max-width:760px;margin-bottom:14px}
  .pv-otag{font:700 12px/1.3 Inter,sans-serif;letter-spacing:2px;text-transform:uppercase;color:var(--hot);margin-bottom:14px}
  .pv-o{padding:12px 0;border-top:1px solid rgba(26,20,23,.08)}
  .pv-o:first-of-type{border-top:none;padding-top:0}
  .pv-o b{display:block;font-family:Newsreader,Georgia,serif;font-weight:600;font-size:19px;color:var(--ink);margin-bottom:5px}
  .pv-o i{display:block;font-style:normal;font-size:15.5px;line-height:1.6;color:var(--ink-soft)}
