---
import PageLayout from "../../layouts/PageLayout.astro";
import { MODULES } from "../../we-manifest.js";

const phases = [...new Set(MODULES.map((m) => m.phase))].map((p) => {
  const inPhase = MODULES.filter((m) => m.phase === p);
  return {
    accent: inPhase[0].accent,
    day: inPhase[0].phaseLabel.split("·")[1]?.trim() ?? p,
    title: inPhase[0].phaseSub.split("—")[0].trim(),
    mods: inPhase,
  };
});
---
<PageLayout
  noindex
  title="Inside The Weekend Ecosystem™"
  description="A look inside the course before you buy — the module index, a real module page, the prompt cards, the progress tracker and the completion certificate."
>
  <section class="pv-hero">
    <div class="page-eyebrow">A look inside · No email required</div>
    <h1>What you're actually buying</h1>
    <a class="btn pv-hero-btn" href="/shop/weekend-ecosystem">Get The Weekend Ecosystem™ <span class="a">→</span></a>
    <p class="pv-lede">Most course sales pages describe the thing. This one shows it. Everything below is the real interface — the same pages you'd log into an hour from now.</p>
    <figure class="pv-fig pv-fig-hero">
      <img src="/images/we/hook-blog-posts.jpg" alt="You already wrote the blog posts. They're just sitting in your Skool group." loading="eager" width="1200" height="1490" />
    </figure>
  </section>

  <section class="pv-sec">
    <span class="pv-n">01</span>
    <h2>The module index</h2>
    <p class="pv-b">Twenty-two modules across six phases. Each phase has its own colour, running from lavender on Friday night to hot pink by Sunday afternoon — so you always know where you are in the weekend.</p>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body pv-body-index">
        {phases.slice(0, 3).map((p, i) => (
          <div class="pv-phase" style={`--ac:${p.accent}`}>
            <span class="pv-edge"></span>
            <div class="pv-phead">
              <span class="pv-pnum">{String(i).padStart(2, "0")}</span>
              <div>
                <span class="pv-pday">{p.day}</span>
                <span class="pv-ptitle">{p.title}</span>
              </div>
              <span class="pv-tally">0/{p.mods.length}</span>
            </div>
            <div class="pv-mods">
              {p.mods.map((m) => (
                <span class="pv-mod">
                  <span class="pv-tick"></span>
                  <span class="pv-mnum">{String(m.num).padStart(2, "0")}</span>
                  {m.title}
                </span>
              ))}
            </div>
          </div>
        ))}
        <p class="pv-more">…and three more phases below</p>
      </div>
    </div>
    <figure class="pv-fig">
      <img src="/images/we/module-list.jpg" alt="The full list of 22 modules across six phases." loading="lazy" width="1100" height="1191" />
      <figcaption>All twenty-two, across the six phases of the weekend.</figcaption>
    </figure>
  </section>

  <section class="pv-sec">
    <span class="pv-n">02</span>
    <h2>A module</h2>
    <p class="pv-b">Every module runs the same way. The idea, then a numbered spine of actions, then the prompt you paste, then a collapsed panel of fixes for when something breaks. You never have to work out what to do next.</p>
    <figure class="pv-fig pv-fig-wide">
      <img src="/images/we/who-does-what.jpg" alt="Who actually does the work. Nine things Claude does, three things you do." loading="lazy" width="1200" height="1490" />
      <figcaption>What you're doing across those twenty-two modules.</figcaption>
    </figure>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body">
        <span class="pv-eyebrow">Phase 1 — Module 5 of 22</span>
        <span class="pv-h1">Claude Builds the Repo</span>
        <p class="pv-lead-italic">You're about to ask Claude to generate an entire website's worth of files. This works — reliably — but only with the right setup.</p>
        <div class="pv-step"><span class="pv-stepnum">01</span><span class="pv-steplabel">The scaffold prompt</span></div>
        <div class="pv-prompt">
          <div class="pv-pbar"><span>Copy this prompt</span><em>Copy</em></div>
          <code>Build the scaffold for my Astro site. Use my Canon<br/>File in project knowledge as the source of truth.<br/><br/>LIVE FACTS — these override anything that disagrees:<br/>- Domain: [yourdomain.com]<br/>- URL pattern: /learn/[slug] — flat, no folders<br/>&nbsp;&nbsp;…</code>
        </div>
        <div class="pv-road">
          <span>If you get stuck</span>
          <em>+ Claude gave me a fragment, not the whole file</em>
          <em>+ I don't know if this file is right</em>
        </div>
      </div>
    </div>
  </section>

  <section class="pv-sec">
    <span class="pv-n">03</span>
    <h2>Thirty-six prompts, written out in full</h2>
    <p class="pv-b">Not summaries. Not "adapt this to your business." Every prompt is complete, sits in its own copy card, and is ready to run the moment you paste it. Here's what the Quick Sheet looks like — every prompt in the order you actually use them.</p>

    <div class="pv-shot">
      <div class="pv-bar"><span></span><span></span><span></span></div>
      <div class="pv-body">
        <span class="pv-eyebrow">Every prompt, in the order you run them</span>
        <span class="pv-h1">The Quick Sheet</span>
        <div class="pv-group">Friday night — prep</div>
        <div class="pv-qs"><span class="pv-qsn">01</span><div><b>Content inventory</b><i>Point a browser agent at your Skool group. It reads every lesson, post and file and hands you one table.</i></div></div>
        <div class="pv-qs"><span class="pv-qsn">02</span><div><b>Canon File</b><i>The document that stops Claude inventing products you don't sell.</i></div></div>
        <div class="pv-qs pv-qs-blur"><span class="pv-qsn">03</span><div><b>Standing instruction</b><i>Makes Claude flag conflicts instead of quietly guessing.</i></div></div>
        <div class="pv-group pv-group-blur">Saturday morning — the website</div>
        <div class="pv-qs pv-qs-blur"><span class="pv-qsn">05</span><div><b>Site scaffold</b><i>Generates every file your site needs.</i></div></div>
        <div class="pv-qs pv-qs-blur"><span class="pv-qsn">06</span><div><b>Homepage copy</b><i>Four sections, no fluff.</i></div></div>
        <p class="pv-more">…thirty more, each with the full prompt underneath</p>
      </div>
    </div>
    <figure class="pv-fig pv-fig-wide">
      <img src="/images/we/weekend-timeline.jpg" alt="One weekend hour by hour, across six phases from Friday night to Sunday afternoon." loading="lazy" width="1200" height="1490" />
      <figcaption>The order you run them in.</figcaption>
    </figure>
  </section>

  <section class="pv-sec">
    <span class="pv-n">04</span>
    <h2>What one prompt actually produces</h2>
    <p class="pv-b">This is the module people message me about afterwards. You publish an article, paste one prompt, and twenty-four finished assets come back. Below is the real output from running it against this page — not a sample, the actual thing.</p>

    <div class="pv-out">
      <div class="pv-otag">Ten pins · titles and descriptions</div>
      <div class="pv-o"><b>How to turn your Skool content into a blog</b><i>Your best lessons are already written — they're just trapped where nobody can search them. Here's how to move them onto a site you own.</i></div>
      <div class="pv-o"><b>Where to find blog content you already wrote</b><i>Six places your best writing is already sitting. Most creators find dozens of pieces they'd forgotten about.</i></div>
      <div class="pv-o"><b>You don't need to code to build a website</b><i>Everything that used to be required, and isn't anymore. AI writes the files; you paste and approve.</i></div>
      <p class="pv-omore">+ seven more, each a different layout, each with its own image prompt and board</p>
    </div>

    <div class="pv-out">
      <div class="pv-otag">An 8-slide carousel</div>
      <div class="pv-slides">
        <span>YOU ALREADY WROTE THE BLOG POSTS.</span>
        <span>Every lesson in your classroom is an article.</span>
        <span>Every call recording is three posts.</span>
        <span>None of it is searchable.</span>
      </div>
      <p class="pv-omore">+ four more slides, plus the caption and five hashtags</p>
    </div>

    <div class="pv-out">
      <div class="pv-otag">Eight Threads posts</div>
      <div class="pv-o pv-o-plain"><i>"Count the lessons in your Skool classroom. Now count how many a stranger could find on Google today. That gap is the whole problem."</i></div>
      <div class="pv-o pv-o-plain"><i>"A post dies in three days. An article works for eighteen months. We spend almost all our time on the first one."</i></div>
      <div class="pv-o pv-o-plain"><i>"Renting: Skool, Instagram, TikTok, Pinterest. Owning: a domain, a site, an email list. Do both. But please do the second one."</i></div>
      <p class="pv-omore">+ five more, each a different structure, no two opening the same way</p>
    </div>

    <div class="pv-out pv-out-half">
      <div>
        <div class="pv-otag">Two reels</div>
        <p class="pv-osmall">A full video generation prompt plus a matching cover still in the same setting, wardrobe and palette — so the cover and the video read as one asset. On-screen text and caption included.</p>
      </div>
      <div>
        <div class="pv-otag">Plus</div>
        <p class="pv-osmall">A Facebook post in a warmer register. An email with subject line and preview text. A community post that doesn't sound like your blog. And a plain list of every headline, for reuse.</p>
      </div>
    </div>

    <figure class="pv-fig pv-fig-wide">
      <img src="/images/we/friday-sunday.jpg" alt="Friday: content scattered across a platform you don't own. Sunday: a site on a domain you own, a blog Google can find, an email list that captures." loading="lazy" width="1200" height="1490" />
    </figure>

    <p class="pv-note">Ten pins, a carousel, eight Threads posts, two reels, a Facebook post, an email and a community post. Twenty-four things, across six platforms, from one afternoon — and the article underneath keeps ranking the whole time they circulate.</p>
  </section>

  <section class="pv-sec">
    <span class="pv-n">05</span>
    <h2>Progress, and the certificate</h2>
    <p class="pv-b">Tick each module off as you finish it. The ring fills, each phase keeps its own tally, and at twenty-two a completion certificate unlocks with your name on it.</p>

    <div class="pv-two">
      <div class="pv-card">
        <span class="pv-ctag">Your progress</span>
        <div class="pv-ring"><span>14<small>/22</small></span></div>
        <p>Over halfway. The site exists by now.</p>
      </div>
      <div class="pv-card pv-cert">
        <span class="pv-ctag">At twenty-two</span>
        <span class="pv-certh">Certificate of Completion</span>
        <span class="pv-certname">Your name</span>
        <p>Something to post when you're done.</p>
      </div>
    </div>
  </section>

  <section class="pv-sec pv-sec-flush">
    <figure class="pv-fig pv-fig-wide">
      <img src="/images/we/the-numbers.jpg" alt="22 modules. 36 prompts, verbatim. 3 reference vaults. 1 weekend." loading="lazy" width="1200" height="1490" />
    </figure>
  </section>

  <section class="pv-close">
    <h2>That's the whole thing.</h2>
    <p class="pv-clede">Twenty-two modules, thirty-six prompts, three reference vaults — and every future update, free, forever.</p>
    <a class="btn pv-btn" href="/shop/weekend-ecosystem">Get The Weekend Ecosystem™ <span class="a">→</span></a>
    <p class="pv-cnote">Full details, the complete module list and the current price are all on the sales page.</p>
  </section>

  <style>
    .pv-hero{text-align:center;padding:10px 0 56px;border-bottom:1px solid rgba(43,22,27,.1)}
    .pv-hero h1{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(36px,6.4vw,64px);line-height:1.02;letter-spacing:-1.6px;margin:0 0 22px;color:#2B161B}
    .pv-lede{max-width:620px;margin:0 auto;font-family:"Cormorant Garamond",serif;font-style:italic;font-size:23px;line-height:1.55;color:#5A4048}

    .pv-sec{padding:64px 0;border-bottom:1px solid rgba(43,22,27,.09)}
    .pv-n{display:block;font-family:"JetBrains Mono","Inter",monospace;font-size:11px;letter-spacing:2.6px;color:var(--pink);margin-bottom:12px}
    .pv-sec h2{font-family:"Fraunces",serif;font-weight:300;font-size:clamp(28px,4.4vw,42px);line-height:1.08;margin:0 0 16px;letter-spacing:-.8px;color:#2B161B}
    .pv-b{font-size:17.5px;line-height:1.78;max-width:640px;margin:0 0 32px;color:#3B2228}
    .pv-note{font-size:15.5px;line-height:1.7;color:#5A4048;margin:20px 0 0;font-style:italic}

    .pv-fig{margin:34px 0 0;padding:0;max-width:560px}
    .pv-fig img{width:100%;height:auto;display:block;border-radius:8px;box-shadow:0 10px 34px rgba(43,22,27,.11)}
    .pv-fig figcaption{font-size:13.5px;color:rgba(43,22,27,.55);margin-top:12px;font-style:italic}
    .pv-fig-hero{margin:44px auto 0}
    .pv-fig-wide{max-width:600px;margin:34px auto 0}
    .pv-fig-wide figcaption{text-align:center}
    .pv-sec-flush{border-bottom:none;padding-bottom:0}
    .pv-shot{border-radius:8px;overflow:hidden;border:1px solid rgba(43,22,27,.16);background:#FBF8F5;box-shadow:0 12px 40px rgba(43,22,27,.1);max-width:720px}
    .pv-bar{display:flex;gap:6px;padding:11px 14px;background:rgba(43,22,27,.055);border-bottom:1px solid rgba(43,22,27,.09)}
    .pv-bar span{width:9px;height:9px;border-radius:50%;background:rgba(43,22,27,.16)}
    .pv-body{padding:26px 28px 28px}
    .pv-body-index{padding:20px}

    .pv-phase{position:relative;overflow:hidden;border:1px solid rgba(43,22,27,.11);border-radius:6px;padding:18px 20px;margin-bottom:12px;
              background:linear-gradient(180deg,color-mix(in srgb,var(--ac) 13%,transparent),color-mix(in srgb,var(--ac) 3%,transparent))}
    .pv-edge{position:absolute;left:0;top:0;bottom:0;width:5px;background:var(--ac)}
    .pv-phead{display:flex;gap:13px;align-items:flex-start;padding-bottom:12px;margin-bottom:10px;border-bottom:1px solid color-mix(in srgb,var(--ac) 42%,transparent)}
    .pv-pnum{font-family:"Fraunces",serif;font-size:36px;font-weight:300;line-height:.8;color:var(--ac);letter-spacing:-1.5px}
    .pv-pday{display:block;font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:#8A6B44;margin-bottom:3px}
