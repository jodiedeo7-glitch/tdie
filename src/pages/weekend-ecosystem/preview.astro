<script>
  const bar = document.getElementById("wx-sticky");
  const blocks = [...document.querySelectorAll(".wp")];
  const start = document.getElementById("index");
  if (bar && start) {
    const seen = new Set();
    const update = () => {
      const past = start.getBoundingClientRect().top < 0;
      bar.classList.toggle("on", past && seen.size === 0);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
      update();
    });
    blocks.forEach((b) => io.observe(b));
    window.addEventListener("scroll", update, { passive: true });
  }
</script>
</PageLayout>
