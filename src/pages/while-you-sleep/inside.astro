---
// WYS Look Inside: PRIVATE PREVIEW (8 Oct 2026). noindex; release hold stands.
// Centerpiece: each look's basic -> styled -> lifestyle sequence, switchable by look.
// Every inclusion, step and limit traces to claude/WYS_REFERENCE_PACK_2026-10-07.md
// (sections 2, 14-25) or the live shop page's verified limits. No invented screenshots.
// Without JavaScript every look and every photo simply shows in order.
import PageLayout from "../../layouts/PageLayout.astro";
import { Image } from "astro:assets";
import "../../styles/wys.css";
import { LANDING, WAITLIST_PAGE, PRESALE_LINE, CLOTHING, DECOR_A, DECOR_B, HOW, CHAPTERS, COVERS, NEEDS, LIMITS } from "../../data/wys-landing.js";

const looks = [
  { id: "clothing", tab: "Off Duty outfit", look: CLOTHING, how: HOW.clothing },
  { id: "entryway", tab: "Pretty Wicked entryway", look: DECOR_A, how: HOW.entryway },
  { id: "coffee", tab: "Ghoul Fuel coffee bar", look: DECOR_B, how: HOW.coffee },
];
---
<PageLayout wide noindex ogImage={CLOTHING.shots[2].img.src}
  title="Look Inside · The While-You-Sleep Storefront™"
  description="The looks, the workflow, what the kit covers, what you need and the honest limits of The While-You-Sleep Storefront™.">
<div class="wy">

  <a class="wy-back" href={LANDING}><span aria-hidden="true">←</span> The While-You-Sleep Storefront™</a>

  <header class="wy-in-top">
    <div>
      <p class="wy-badge"><span class="wy-pearl" aria-hidden="true"></span>{PRESALE_LINE}</p>
      <h1 class="wy-h1" style="margin-top:20px">Look inside <span>the storefront.</span></h1>
      <p class="wy-lede">Three real looks, start to finish. Pick one and walk it from the picks to the finished photograph.</p>
    </div>
    <a class="wy-btn wy-btn-hot" href={WAITLIST_PAGE}>Join the Waitlist <span aria-hidden="true">→</span></a>
  </header>

  <section aria-labelledby="looks-h" class="wy-looks">
    <h2 class="wy-h2" id="looks-h" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">The looks</h2>
    <div class="wy-tabs" role="tablist" aria-label="Choose a look">
      {looks.map((l, k) => (
        <button class="wy-tab" type="button" role="tab" id={`tab-${l.id}`} aria-controls={`panel-${l.id}`} aria-selected={k === 0 ? "true" : "false"} tabindex={k === 0 ? 0 : -1}>
          <Image src={l.look.shots[2].img} alt="" widths={[68]} sizes="34px" />{l.tab}
        </button>
      ))}
    </div>

    {looks.map((l) => (
      <div class="wy-stage" role="tabpanel" id={`panel-${l.id}`} aria-labelledby={`tab-${l.id}`} data-panel>
        <div class="wy-stage-view">
          <figure class="wy-stage-photo wy-chrome">
            {l.look.shots.map((s, i) => (
              <Image src={s.img} alt={s.alt} data-shot={i} widths={[480, 720, 1000]} sizes="(max-width: 960px) 92vw, 600px" />
            ))}
          </figure>
          <p class="wy-stage-cap">{l.look.note}</p>
        </div>
        <div>
          <p class="wy-kicker">{l.look.label}</p>
          <h3 class="wy-h2" style="margin:10px 0 20px">{l.look.name}</h3>
          <ol class="wy-steps" aria-label="Basic, styled and lifestyle">
            {l.look.shots.map((s, i) => (
              <Fragment>
                {i > 0 && <li class="wy-step-arrow" aria-hidden="true"><svg viewBox="0 0 16 22"><path d="M8 1 V19 M2 13 L8 20 L14 13" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></li>}
                <li>
                  <button class="wy-step-btn" type="button" data-step={i} aria-pressed={i === 2 ? "true" : "false"}>
                    <Image src={s.img} alt="" widths={[184]} sizes="92px" />
                    <span><span class="wy-step-role">{String(i + 1).padStart(2, "0")} · {s.role}</span><span class="wy-step-title">{s.title}</span><span class="wy-step-text">{s.text}</span></span>
                  </button>
                </li>
              </Fragment>
            ))}
          </ol>
          <p class="wy-stage-how"><b>Why it's built this way</b>{l.how}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="wy-sec" id="workflow" aria-labelledby="flow-h">
    <p class="wy-kicker">The workflow</p>
    <h2 class="wy-h2" id="flow-h" style="margin-top:12px">Three chapters, from setup to a scheduled pin.</h2>
    <div class="wy-chapters">
      {CHAPTERS.map((c, k) => (
        <div class="wy-chapter">
          <div class="wy-medal" aria-hidden="true"><span>{k + 1}</span></div>
          <h3>{c.t}</h3>
          <ol>{c.steps.map((s) => (<li><b>{s.b}</b>{s.p}</li>))}</ol>
        </div>
      ))}
    </div>
  </section>

  <section class="wy-sec" id="covers" aria-labelledby="covers-h">
    <p class="wy-kicker">Before you buy</p>
    <h2 class="wy-h2" id="covers-h" style="margin-top:12px">What's in it, and what you'll need.</h2>
    <div class="wy-receipt">
      <div class="wy-slip"><h3>In the kit</h3><ul>{COVERS.map((c) => (<li>{c}</li>))}</ul></div>
      <div class="wy-slip wy-slip-lav"><h3>You bring</h3><ul>{NEEDS.map((c) => (<li>{c}</li>))}</ul></div>
    </div>
  </section>

  <section class="wy-sec wy-honest" aria-labelledby="honest-h">
    <h3 id="honest-h">Good to know</h3>
    <ul>{LIMITS.map((l) => (<li>{l}</li>))}</ul>
  </section>

  <section class="wy-close wy-on-pink" aria-labelledby="close-h">
    <div>
      <p class="wy-badge"><span class="wy-pearl" aria-hidden="true"></span>{PRESALE_LINE}</p>
      <h2 class="wy-h2" id="close-h">Seen enough? Save your spot.</h2>
      <p>The presale link comes straight to your inbox the moment it opens.</p>
    </div>
    <div class="wy-btns">
      <a class="wy-btn wy-btn-hot" href={WAITLIST_PAGE}>Join the Waitlist <span aria-hidden="true">→</span></a>
      <a class="wy-btn wy-btn-pearl" href={LANDING}><span aria-hidden="true">←</span> Back to the storefront</a>
    </div>
  </section>

</div>

<script is:inline>
(function(){
  var tabs=[].slice.call(document.querySelectorAll('.wy-tab'));
  var panels=[].slice.call(document.querySelectorAll('[data-panel]'));
  function showLook(i,focus){
    tabs.forEach(function(t,k){var on=k===i;t.setAttribute('aria-selected',on?'true':'false');t.tabIndex=on?0:-1;});
    panels.forEach(function(p,k){p.hidden=k!==i;});
    if(focus)tabs[i].focus();
  }
  tabs.forEach(function(t,k){
    t.addEventListener('click',function(){showLook(k);});
    t.addEventListener('keydown',function(e){var n=null;if(e.key==='ArrowRight')n=(k+1)%tabs.length;if(e.key==='ArrowLeft')n=(k-1+tabs.length)%tabs.length;if(e.key==='Home')n=0;if(e.key==='End')n=tabs.length-1;if(n!==null){e.preventDefault();showLook(n,true);}});
  });
  panels.forEach(function(p){
    var shots=[].slice.call(p.querySelectorAll('[data-shot]')), btns=[].slice.call(p.querySelectorAll('[data-step]'));
    function showShot(i){shots.forEach(function(s,k){s.hidden=k!==i;});btns.forEach(function(b,k){b.setAttribute('aria-pressed',k===i?'true':'false');});}
    btns.forEach(function(b,k){b.addEventListener('click',function(){showShot(k);});});
    showShot(2);
  });
  showLook(0);
})();
</script>
</PageLayout>
