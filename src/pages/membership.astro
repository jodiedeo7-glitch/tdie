---
// Membership page, rebuilt 19 Nov 2026 on Jodie's Etsy template in the approved WYS style.
import TemplateLayout from "../layouts/TemplateLayout.astro";
import { SKOOL_PLANS, membership } from "../data/facts.js";
import { MEMBER_REVIEWS } from "../we-reviews.js";
import ReviewBubble from "../components/ReviewBubble.astro";
import MembershipPlans from "../components/MembershipPlans.astro";
// Every price, trial length and count on this page reads from facts.js.
const { standard: S, premium: P, trialDays } = membership;
const days = `${trialDays} days`;

const title = "Membership Plans: Standard vs Premium";
const description = `Build your faceless business with training and community from ${S.perMonth}. Premium (${P.perMonth}) adds offer and funnel training and monthly content. Both start with ${days} free.`;

// Side by side. Full course names stay, set quietly under each row.
// s / p: true = included, false = not included, string = shown as written.
const groups = [
  { h: "Community and daily photo prompts", rows: [
    { t: "The Skool community and Daily Prompts", sub: "A prompt every day, and women one step ahead of you to ask", s: true, p: true },
  ] },
  { h: "Training included in both plans", rows: [
    { t: "Foundations", sub: "The Essentials Edit · AI Foundations for Creators · Canva Crash Course", s: true, p: true },
    { t: "The brand", sub: "AI Twin / Influencer Creation · Brand Building · The Content Edit · The Tommy Kate Edit", s: true, p: true },
    { t: "Traffic and selling", sub: "The Monetization Edit · The Email Edit · The Pinterest Edit · Pinterest Foundations™ · The Shopify Edit (physical products, print on demand and dropshipping)", s: true, p: true },
    { t: "Bonuses", sub: "Vacation Vault at level 2 · Luxe Babe Prompt Pack at level 4", s: true, p: true },
  ] },
  { h: "Additional sales and systems training", rows: [
    { t: "The Offer Edit, The Funnel Edit and Scaling & Systems", sub: "What you sell, the road a stranger walks to it, and the systems that keep it running", s: false, p: true },
  ] },
  { h: "Monthly content and paid-traffic training", rows: [
    { t: "The monthly done-for-you content calendar", sub: "A new calendar every month: daily Instagram content and two Threads posts a day, released in weekly batches across month-end", s: false, p: true },
    { t: "The Ads Edit™", sub: "Paid traffic, pointed at a build that is ready for it", s: false, p: true },
  ] },
  { h: "The guides", rows: [
    { t: "The Value Vault guides", sub: "In Premium they sit in The Premium Vault, every one already unlocked", s: "À la carte", p: "All unlocked" },
    { t: "Daily Edits of the Past", sub: "The separate Premium resource for past Daily Edits", s: false, p: true },
  ] },
];

const dfy = [
  { t: "Every day, written", p: "Hooks, captions, carousel slides and Story frames supplied. Adapt the offer details instead of writing each post from scratch." },
  { t: "Two Threads posts a day", p: "Two a day, written for the platform, not captions pasted over from somewhere else." },
  { t: "A start-frame and motion prompt for every Reel", p: "Use the image and video prompts to make your visuals in your chosen tools. No footage of you is required." },
  { t: "Built on what is working", p: "Each month starts with research into posts and Reels that outperform a creator’s usual results in this niche. Those patterns shape the content." },
];

// The room: what happens inside (merged from the old /community page).
const inside = [
  { n: "01", t: "A prompt every day", p: "A new photo prompt every day for your AI persona, written so it works with your own reference photo." },
  { n: "02", t: "Skills you can use on your own brand", p: "Work through AI, branding, content and marketing lessons, then apply them to what you are building." },
  { n: "03", t: "Learn from the business you can see", p: "Explore the brand, content and systems behind The Digital Income Edit™ as you learn to build your own." },
  { n: "04", t: "A community to build alongside", p: "Bring your questions into the Skool group and learn alongside other women working through their own builds." },
];

const faq = [
  { q: "Can I choose Premium as a beginner?", a: "Yes. Premium includes all the Standard foundations, plus the extra training and unlocked guides. You can use those now. The calendar is written for faceless digital-business content; adapt its promotional details when you have an offer to put in them." },
  { q: "Does Premium write a new calendar every month?", a: "Yes. Each month covers Instagram content for every day, plus two Threads posts a day. Hooks, captions, carousel copy, Story frames and Reel prompts are supplied. Weekly batches roll out across the end of the preceding month and the start of the covered month." },
  { q: "What do I still do with the Premium content?", a: "Adapt offer mentions and brand details, generate your images and videos with the supplied prompts in your chosen tools, then publish. The membership supplies the training, written content and prompts; it does not manage or post to your accounts for you." },
  { q: "How does the free trial work?", a: `Both memberships start with ${days} free on Skool. Come in, look around, use the prompts, take a training. If it isn't for you, leave from inside the app before the week is out.` },
  { q: "How am I billed?", a: `Both are subscriptions on Skool. Monthly, Standard is ${S.perMonth} and Premium is ${P.perMonth}, billed every month until you leave.` },
  { q: "Is there an annual price?", a: `Yes. Standard is ${S.perYear} and Premium is ${P.perYear}. Paying for the year costs less than twelve monthly payments.` },
  { q: "How do I cancel?", a: "From inside the Skool app, at any time. Both memberships are subscriptions you can leave whenever you like." },
  { q: "Is The Value Vault included in Standard?", a: "No. The Value Vault is the guide collection, and Standard members buy the guides they want à la carte. The Premium Vault holds the same guides, every one already unlocked, and it comes with Premium. Two names, one set of guides; the difference is only how you pay for them." },
  { q: "Will I have to film myself for the Reels?", a: "No. Every Reel in the Premium calendar comes with a start-frame and a motion prompt. You generate the still, drop it into your video tool and post it. Not your face, not your hands, not your desk." },
];

const schema = [{
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
}];
const feed = ["/images/home/flagship-attic-560.webp","/images/home/hero-pink-knit-desk-480.webp","/images/we/hook-blog-posts-480.webp","/images/we/cover-kitchen-480.webp"];
---
<TemplateLayout title={title} description={description} schema={schema} stickyHref={SKOOL_PLANS} stickyLabel={`Start free for ${days}`}>

<!-- Template page 2: header card + photo -->
<section class="hh">
 <div class="wrap hh-grid mb-hh">
  <div class="box">
   <span class="stk" style="right:-60px;top:-56px">Either plan<b class="big">{days} free</b></span>
   <svg class="spk" style="left:-26px;bottom:60px;position:absolute"><use href="#sp"/></svg>
   <p class="kick">The Membership</p>
   <h1>Build the business. <span class="scr">Keep your life off camera.</span></h1>
   <p class="what">You don't have to turn your life into content to build a brand. Learn to use AI for the persona, the content and the work behind the business.</p>
   <p class="what"><b>Choose Standard</b> for the training and community. <b>Choose Premium</b> for everything in Standard, plus extra sales and systems training, unlocked guides and content written for you every month.</p>
   <a class="btn buy" href={SKOOL_PLANS}>Start free for {days} <span class="ar">→</span></a>
   <p class="need">Standard {S.perMonth} or {S.perYear} · Premium {P.perMonth} or {P.perYear}. Cancel in Skool before the trial ends and you pay nothing.</p>
   <p class="see"><a href="#compare">Compare the two memberships ↓</a></p>
  </div>
  <div class="hh-ph mb-shot">
   <img src="/images/pages/skool-about-current.webp" width="1440" height="979" fetchpriority="high" decoding="async" alt="The Digital Income Edit™ Skool group, as it looks today">
   <p class="hh-cap"><b>The real group.</b> On Skool. <span>Take a look inside.</span></p>
  </div>
 </div>
</section>

<!-- Template page 9: band -->
<div class="band"><svg class="spk" style="left:18%"><use href="#sp"/></svg><h2>What happens inside</h2><svg class="spk sm" style="right:19%"><use href="#sp"/></svg></div>

<!-- Template page 18: four boxes -->
<section class="sec wash" id="room">
 <div class="wrap">
  <h2 class="h2">Open the lesson. <span class="scr">Put it to work.</span></h2>
  <div class="p18 hm-four">{inside.map((i) => <div class="box"><span class="num hm-num">{i.n}</span><h3>{i.t}</h3><p>{i.p}</p></div>)}</div>
 </div>
</section>

<!-- Template page 14: text card + photo -->
<section class="sec">
 <div class="wrap p14">
  <div>
   <p class="kick" style="text-align:left">What faceless means</p>
   <h2>Your face can stay <span class="glit">off camera.</span></h2>
   <p>Faceless doesn't mean every image is empty. Your AI persona can front the brand while you stay behind it. AI Twin / Influencer Creation teaches that part in both memberships.</p>
   <span class="scr">Keep your private life yours.</span>
  </div>
  <div class="ph"><img src="/images/pages/community-dog-800.webp" width="800" height="1000" loading="lazy" decoding="async" alt="A golden retriever asleep on a rug under the desk in the TDIE studio"></div>
 </div>
</section>

<section class="sec wash">
 <div class="wrap">
  <p class="kick">What members say</p>
  <div class="hm-reviews">{MEMBER_REVIEWS.map((r) => <ReviewBubble quote={r.quote} name={r.name} source={r.source} stars={r.stars} />)}</div>
 </div>
</section>

<!-- Template page 25: price cards -->
<section class="sec" id="compare">
 <div class="wrap">
  <svg class="spk sm" style="right:80px;top:10px"><use href="#sp"/></svg>
  <p class="kick">Which one is for me?</p>
  <h2 class="h2">Build it yourself. <span class="scr">Or get the content written.</span></h2>
  <div class="hm-plans"><MembershipPlans /></div>
  <p class="mb-note"><b>New to all of this? Either plan is open to you.</b> Start with the foundations and guides. In Premium, use the promotional content when you have an offer to adapt it to.</p>
 </div>
</section>

<!-- Side by side -->
<div class="band"><svg class="spk sm" style="left:22%"><use href="#sp"/></svg><h2>Side by side</h2><svg class="spk" style="right:21%"><use href="#sp"/></svg></div>
<section class="sec wash">
 <div class="wrap">
  <div class="lead"><p>Both include the foundations. Premium adds the offer, funnel, ads and systems training, the monthly content and the unlocked guides.</p></div>
  <div class="mb-tw" role="region" aria-label="Membership comparison" tabindex="0"><table class="mb-t">
   <caption class="sr">Membership Standard compared with Membership Premium</caption>
   <thead><tr><th scope="col"><span class="sr">What you get</span></th><th scope="col">Standard<span>{S.perMonth}</span></th><th scope="col" class="p">Premium<span>{P.perMonth}</span></th></tr></thead>
   {groups.map((g) => (
    <tbody>
     <tr class="g"><th scope="rowgroup" colspan="3">{g.h}</th></tr>
     {g.rows.map((r) => (
      <tr>
       <th scope="row"><b>{r.t}</b>{r.sub && <small>{r.sub}</small>}</th>
       {[r.s, r.p].map((v, i) => (
        <td class={i === 1 ? "p" : ""}>
         {v === true && <><span class="y" aria-hidden="true">✓</span><span class="sr">Included</span></>}
         {v === false && <><span class="n" aria-hidden="true">✕</span><span class="sr">Not included</span></>}
         {typeof v === "string" && <span class="w">{v}</span>}
        </td>
       ))}
      </tr>
     ))}
    </tbody>
   ))}
  </table></div>
 </div>
</section>

<!-- Template page 44: the Premium difference -->
<section class="sec">
 <div class="wrap">
  <p class="kick">The Premium difference</p>
  <h2 class="h2">"What do I post?" <span class="scr">Already answered. Every month.</span></h2>
  <div class="lead"><p>The hook. The caption. The carousel slides. The Story frames. Two Threads posts a day. Premium gives you the writing and the visual prompts, so you can stop planning each post from zero.</p></div>
  <div class="p44 mb-dfy">
   <div class="mb-feed">
    <span class="stk r" style="left:-40px;top:-50px">Every<b class="big">month</b></span>
    <div class="mb-feed-g">{feed.map((src, i) => <span><img src={src} alt="" loading="lazy" decoding="async" width="480" height="596"><em>Day {i + 1}</em></span>)}</div>
    <p class="mb-feed-cap">Photos shown are Tommy Kate, the brand's AI persona.</p>
   </div>
   <div class="card dash">
    <h3>The Premium DFY Content Calendar</h3>
    <ul class="chk">{dfy.map((d) => <li><span><b>{d.t}.</b> {d.p}</span></li>)}</ul>
    <p class="mb-small">Written for the faceless digital-business niche, with offer mentions you can swap for your own. Adapt those details, generate the visuals in your chosen tools, then publish. Weeks roll out across the end of the month before and the start of the covered month.</p>
    <a class="btn buy" href={SKOOL_PLANS}>Start Premium free for {days} <span class="ar">→</span></a>
   </div>
  </div>
 </div>
</section>

<!-- Template page 47: questions -->
<section class="sec wash">
 <div class="wrap">
  <svg class="spk" style="left:8%;top:40px"><use href="#sp"/></svg>
  <p style="text-align:center;margin:0 0 14px"><span class="tag">Before you join</span></p>
  <h2 class="h2">Straight <span class="scr">answers.</span></h2>
  <div class="faq">{faq.map((f, i) => <div class="qa"><span class="n">{String(i+1).padStart(2,'0')}</span><div><h3>{f.q}</h3><p>{f.a}</p></div></div>)}</div>
  <p class="mb-note">Something else? <a href="mailto:hello@thedigitalincomeedit.com">Email hello@thedigitalincomeedit.com</a></p>
 </div>
</section>

<!-- Template page 42: close -->
<section class="sec">
 <div class="wrap">
  <div class="p42 dash mb-close" style="position:relative">
   <span class="stk" style="left:-44px;top:-44px">{days}<b class="big">free</b></span>
   <div class="ph"><img src="/images/home/founder-window-seat-640.webp" width="640" height="426" loading="lazy" decoding="async" alt="Tommy Kate working from a window seat"></div>
   <div class="tx">
    <p class="kick">You've seen what's inside</p>
    <h2>Come try it.</h2>
    <span class="scr">Keep the plan that fits.</span>
    <p>Use your {days} free to explore the classroom, try a prompt and start a lesson. Cancel in Skool before the trial ends to avoid the charge.</p>
    <a class="btn buy" href={SKOOL_PLANS}>Start free for {days} <span class="ar">→</span></a>
    <p class="see"><a href="https://www.skool.com/thedigitalincomeedit/about">Peek inside the Skool group first, free</a></p>
   </div>
  </div>
 </div>
</section>
</TemplateLayout>
