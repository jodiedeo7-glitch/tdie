---
import PageLayout from "../layouts/PageLayout.astro";
import "../styles/edit.css";
import { SKOOL_PLANS, membership, community } from "../data/facts.js";

// Every price, trial length and count on this page reads from facts.js.
const { standard: S, premium: P, trialDays } = membership;
const days = `${trialDays} days`;

const title = "Membership Plans: Standard vs Premium";
const description = `Standard (${S.perMonth}) is the build by hand. Premium (${P.perMonth}) writes your content month for you. Both start with ${days} free.`;

// Which one is for me: outcomes, not syllabus.
const forStandard = [
  "You want to learn each step and build it with your own hands.",
  "You are happy to write your own posts once you know what to write.",
  "You would rather buy only the Value Vault guides you need.",
];
const forPremium = [
  "You want the offer, funnel and scaling rooms, not only the foundations.",
  "You would rather open a finished month of content than write one.",
  "You want every Value Vault guide already unlocked.",
];

// Side by side. Full course names stay, set quietly under each row.
// s / p: true = included, false = not included, string = shown as written.
const groups = [
  { h: "The room", rows: [
    { t: "The Skool community and Daily Prompts", sub: "A prompt every day, and women one step ahead of you to ask", s: true, p: true },
  ] },
  { h: "Build it by hand", rows: [
    { t: "Foundations", sub: "The Essentials Edit · AI Foundations for Creators · Canva Crash Course", s: true, p: true },
    { t: "The brand", sub: "AI Twin / Influencer Creation · Brand Building · The Content Edit · The Tommy Kate Edit", s: true, p: true },
    { t: "Traffic and selling", sub: "The Monetization Edit · The Email Edit · The Pinterest Edit · Pinterest Foundations™ · The Shopify Edit (physical products, print on demand and dropshipping)", s: true, p: true },
    { t: "Bonuses", sub: "Vacation & Luxe Babe Vault bonuses", s: true, p: true },
  ] },
  { h: "The full build", rows: [
    { t: "The Offer Edit, The Funnel Edit and Scaling & Systems", sub: "What you sell, the road a stranger walks to it, and the systems that keep it running", s: false, p: true },
  ] },
  { h: "Done for you", rows: [
    { t: "The monthly done-for-you content calendar", sub: "31 days written, released a week at a time around the 1st", s: false, p: true },
    { t: "The Ads Edit™", sub: "Paid traffic, pointed at a build that is ready for it", s: false, p: true },
  ] },
  { h: "The guides", rows: [
    { t: "The Value Vault guides", sub: "In Premium they sit in The Premium Vault, every one already unlocked", s: "À la carte", p: "All unlocked" },
  ] },
];

// The calendar, drawn: 31 days in weeks of seven.
const weeks = [0, 1, 2, 3, 4].map((w) => Array.from({ length: 7 }, (_, d) => w * 7 + d + 1).filter((n) => n <= 31));

const dfy = [
  { t: "31 days written", p: "Every caption, hook, carousel slide and Story frame. Finished posts you copy and publish." },
  { t: "62 Threads posts", p: "Two a day, written for the platform, not captions pasted over from somewhere else." },
  { t: "A start-frame and motion prompt for every Reel", p: "Generate the still, drop it into your video tool, post it. You never film anything. Not your face, not your hands, not your desk." },
  { t: "Built on what is working", p: "Every month starts with hundreds of viral Reels in this niche, read before a word gets written." },
];

const faq = [
  { q: "How does the free trial work?", a: `Both memberships start with ${days} free on Skool. Come in, look around, use the prompts, take a training. If it isn't for you, leave from inside the app before the week is out.` },
  { q: "How am I billed?", a: `Both are subscriptions on Skool. Monthly, Standard is ${S.perMonth} and Premium is ${P.perMonth}, billed every month until you leave.` },
  { q: "Is there an annual price?", a: `Yes. Standard is ${S.perYear} and Premium is ${P.perYear}. Paying for the year costs less than twelve monthly payments.` },
  { q: "How do I cancel?", a: "From inside the Skool app, at any time. Both memberships are subscriptions you can leave whenever you like." },
  { q: "Is The Value Vault included in Standard?", a: "No. The Value Vault is the guide collection, and Standard members buy the guides they want à la carte. The Premium Vault holds the same guides, every one already unlocked, and it comes with Premium. Two names, one set of guides; the difference is only how you pay for them." },
  { q: "Will I have to film myself for the Reels?", a: "No. Every Reel in the Premium calendar comes with a start-frame and a motion prompt. You generate the still, drop it into your video tool and post it. Not your face, not your hands, not your desk." },
];

const schema = [{
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
}];
---
<PageLayout bare title={title} description={description} schema={schema}>

  <!-- 1. Hero: one claim, one primary, one secondary -->
  <section class="mb-hero">
    <div class="e-wrap mb-hero-grid">
      <div class="mb-hero-copy e-rise">
        <p class="e-kick">The Membership</p>
        <h1 class="mb-h1">Build it by hand, or have the month <em>written for you.</em></h1>
        <p class="e-lede">Two memberships, one Skool classroom, {community.members} women building the same architecture beside you. Standard gives you the curriculum and the room. Premium adds the rooms most builds stall in, and writes your content before you sit down.</p>
        <div class="e-actions">
          <a class="e-btn" href={SKOOL_PLANS}>Start free for {days} <span class="ar" aria-hidden="true">→</span></a>
          <a class="e-link" href="#compare">Compare the two memberships</a>
        </div>
        <dl class="mb-hero-facts">
          <div><dt>Standard</dt><dd>{S.perMonth}</dd></div>
          <div><dt>Premium</dt><dd>{P.perMonth}</dd></div>
          <div><dt>Either one</dt><dd>{days} free</dd></div>
        </dl>
      </div>
      <figure class="mb-hero-fig e-rise e-rise-2">
        <div class="mb-hero-frame">
          <img src="/images/membership-jodie.webp" width="460" height="552" fetchpriority="high" decoding="async"
               alt="A woman in a coral sweater working on a laptop at a sunlit kitchen counter, pink roses on the windowsill behind her" />
        </div>
        <figcaption class="e-credit mb-hero-credit">The classroom sits inside <b>the business it teaches</b></figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Which one is for me -->
  <section class="e-sec mb-choose e-paper" id="compare" aria-labelledby="choose-h">
    <div class="e-wrap">
      <div class="mb-head">
        <p class="e-kick">Which one is for me?</p>
        <h2 class="e-d2" id="choose-h">Same business. <em>A different amount of the work on your plate.</em></h2>
      </div>
      <div class="mb-plans">
        <article class="mb-plan e-reveal">
          <p class="mb-plan-name">{S.name}</p>
          <h3 class="mb-plan-claim">You build it <span class="mb-plan-word">by hand.</span></h3>
          <div class="mb-strip" aria-hidden="true">{Array.from({ length: 31 }, () => <span></span>)}</div>
          <p class="e-credit mb-strip-cap">Your month: you write it, with the system</p>
          <p class="mb-plan-line">The curriculum and the room. You learn each step, then do it yourself, with women one step ahead of you in the same classroom.</p>
          <p class="mb-plan-if">Choose Standard if</p>
          <ul class="e-list">{forStandard.map((i) => <li>{i}</li>)}</ul>
          <div class="mb-plan-price">
            <span class="e-price mb-price-n">{S.monthly}</span><span class="mb-price-p">/month</span>
            <span class="mb-price-alt">or {S.perYear}</span>
          </div>
          <a class="e-btn e-btn--ghost mb-plan-cta" href={SKOOL_PLANS}>Start Standard free for {days}</a>
        </article>

        <article class="mb-plan mb-plan--premium e-reveal">
          <p class="mb-plan-name">{P.name}</p>
          <h3 class="mb-plan-claim">More of it is <span class="mb-plan-word"><em>done for you.</em></span></h3>
          <div class="mb-strip mb-strip--done" aria-hidden="true">{Array.from({ length: 31 }, () => <span></span>)}</div>
          <p class="e-credit mb-strip-cap">Your month: 31 days, already written</p>
          <p class="mb-plan-line">Everything in Standard, plus The Offer Edit, The Funnel Edit, Scaling &amp; Systems and The Ads Edit™, and a month of content written for you, every month.</p>
          <p class="mb-plan-if">Choose Premium if</p>
          <ul class="e-list">{forPremium.map((i) => <li>{i}</li>)}</ul>
          <div class="mb-plan-price">
            <span class="e-price mb-price-n">{P.monthly}</span><span class="mb-price-p">/month</span>
            <span class="mb-price-alt">or {P.perYear}</span>
          </div>
          <a class="e-btn mb-plan-cta" href={SKOOL_PLANS}>Start Premium free for {days} <span class="ar" aria-hidden="true">→</span></a>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. Side by side -->
  <section class="e-sec mb-table-sec" aria-labelledby="side-h">
    <div class="e-wrap">
      <div class="mb-head mb-head--split">
        <div>
          <p class="e-kick">Side by side</p>
          <h2 class="e-d3 mb-h2-md" id="side-h">What is in each, grouped by what it does for you.</h2>
        </div>
        <p class="e-small mb-head-note">Course names sit under each row. The difference lives in the bottom three groups.</p>
      </div>

      <table class="mb-table">
        <caption class="sr">Membership Standard compared with Membership Premium</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr">What you get</span></th>
            <th scope="col">Standard<span class="mb-th-p">{S.perMonth}</span></th>
            <th scope="col" class="mb-col-p">Premium<span class="mb-th-p">{P.perMonth}</span></th>
          </tr>
        </thead>
        {groups.map((g) => (
          <tbody>
            <tr class="mb-group"><th scope="rowgroup" colspan="3">{g.h}</th></tr>
            {g.rows.map((r) => (
              <tr>
                <th scope="row">
                  <span class="mb-row-t">{r.t}</span>
                  {r.sub && <span class="mb-row-sub">{r.sub}</span>}
                </th>
                {[r.s, r.p].map((v, i) => (
                  <td class={i === 1 ? "mb-col-p" : ""}>
                    {v === true && <><span class="mb-yes" aria-hidden="true"></span><span class="sr">Included</span></>}
                    {v === false && <><span class="mb-no" aria-hidden="true"></span><span class="sr">Not included</span></>}
                    {typeof v === "string" && <span class="mb-word">{v}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </section>

  <!-- 4. Why upgrade: the calendar, shown -->
  <section class="e-sec e-dark mb-dfy" aria-labelledby="dfy-h">
    <div class="e-wrap mb-dfy-grid">
      <div class="mb-dfy-copy">
        <p class="e-kick">Why people upgrade</p>
        <h2 class="e-d2" id="dfy-h">The month arrives <em>already written.</em></h2>
        <p class="mb-dfy-lead">Most people don't quit because the business is hard. They quit on a Tuesday night, staring at a blank caption box, deciding they'll post tomorrow instead.</p>
        <p>Premium members don't have that night. Every month I write the content calendar for you: not prompts, not ideas, finished posts. Point it at your own offer; the offer days are already written and paced.</p>
        <div class="e-actions mb-dfy-cta">
          <a class="e-btn" href={SKOOL_PLANS}>Start Premium free for {days} <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="mb-dfy-side">
        <figure class="mb-cal e-unveil" aria-labelledby="cal-cap">
          <div class="mb-cal-head" aria-hidden="true">
            <span class="e-giant mb-cal-big">31</span>
            <span class="mb-cal-hl">
              <span class="mb-cal-title">Your month</span>
              <span class="mb-cal-count">31 of 31 days written</span>
            </span>
          </div>
          <div class="mb-cal-body" aria-hidden="true">
            {weeks.map((wk, i) => (
              <div class="mb-cal-row">
                <span class="mb-cal-wk">Week {i + 1}</span>
                <div class="mb-cal-days">
                  {wk.map((n) => (
                    <span class="mb-cal-day"><span class="mb-cal-n">{n}</span><span class="mb-cal-post"></span><span class="mb-cal-thr"></span></span>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <figcaption id="cal-cap" class="mb-cal-cap">
            <span class="mb-key"><span class="mb-key-post" aria-hidden="true"></span>Finished post</span>
            <span class="mb-key"><span class="mb-key-thr" aria-hidden="true"></span>Two Threads posts</span>
            <span class="mb-key-note">One month, 31 days, released a week at a time around the 1st.</span>
          </figcaption>
        </figure>

        <dl class="mb-dfy-facts">
          {dfy.map((d) => (<div><dt>{d.t}</dt><dd>{d.p}</dd></div>))}
        </dl>
      </div>
    </div>
  </section>

  <!-- 5. Straight answers -->
  <section class="e-sec mb-faq" aria-labelledby="faq-h">
    <div class="e-wrap mb-faq-grid">
      <div class="mb-faq-head">
        <p class="e-kick">Before you join</p>
        <h2 class="e-d2" id="faq-h">Straight answers.</h2>
        <p class="e-small">Something else? <a class="e-link" href="mailto:hello@thedigitalincomeedit.com">Email hello@thedigitalincomeedit.com</a></p>
      </div>
      <div class="mb-faq-list">
        {faq.map((f) => (
          <div class="mb-qa">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Close -->
  <section class="e-sec e-paper mb-close" aria-labelledby="close-h">
    <div class="e-wrap">
      <hr class="e-rule mb-close-rule" />
      <div class="mb-close-grid">
        <h2 class="e-d2" id="close-h">You climb when the current step stops being <em>your bottleneck.</em></h2>
        <div>
          <p class="e-lede">Not before. Start with the membership that fits the build you are in now. Either one is free for {days}, and both leave from inside the app whenever you like.</p>
          <div class="e-actions">
            <a class="e-btn" href={SKOOL_PLANS}>Start free for {days} <span class="ar" aria-hidden="true">→</span></a>
            <a class="e-link" href="/community">See what happens inside the room</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .mb-head{max-width:820px;margin:0 0 clamp(36px,5vw,64px)}
    .mb-head--split{max-width:none;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:24px 64px;align-items:end}
    .mb-head--split .e-d3{margin:0}
    .mb-head-note{margin:0;max-width:34em}
    .mb-h2-md{font-size:clamp(28px,3.4vw,44px)}

    /* Hero */
    .mb-hero{padding:clamp(48px,7vw,104px) 0 clamp(64px,8vw,120px)}
    .mb-hero-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,.8fr);gap:clamp(40px,6vw,96px);align-items:center}
    .mb-h1{font-size:clamp(44px,6.6vw,96px);line-height:.98;letter-spacing:-.035em;margin:0 0 28px;max-width:11.5em}
    .mb-hero .e-lede{max-width:34em}
    .mb-hero-facts{display:flex;flex-wrap:wrap;gap:0;margin:40px 0 0;padding-top:20px;border-top:var(--e-hair);max-width:560px}
    .mb-hero-facts div{flex:1 1 0;min-width:120px;padding-right:20px}
    .mb-hero-facts dt{font-size:11.5px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3);margin:0 0 4px}
    .mb-hero-facts dd{margin:0;font-family:var(--e-serif);font-weight:600;font-size:24px;letter-spacing:-.02em}
    .mb-hero-fig{margin:0 calc(var(--e-gut) * -1) 0 0;justify-self:end;width:100%;max-width:470px;align-self:start;margin-top:clamp(8px,3vw,48px)}
    .mb-hero-frame{position:relative;padding:0 0 18px 18px}
    .mb-hero-frame::before{content:"";position:absolute;left:0;bottom:0;right:18px;top:18px;border:var(--e-hair);border-radius:4px}
    .mb-hero-frame img{position:relative;width:100%;height:auto;aspect-ratio:460/552;object-fit:cover;border-radius:4px;box-shadow:var(--e-lift)}
    .mb-hero-credit{display:block;margin:16px 0 0 18px;max-width:28em}

    /* Plans */
    /* Standard is an open plan on paper; Premium is the finished room.
       The difference is carried by weight, scale and the month strip. */
    .mb-plans{display:grid;grid-template-columns:minmax(0,.86fr) minmax(0,1.14fr);gap:clamp(16px,2.4vw,28px);align-items:stretch}
    .mb-plan{display:flex;flex-direction:column;background:transparent;border:1px solid rgba(26,20,23,.28);border-radius:2px;padding:clamp(28px,3.4vw,44px)}
    .mb-plan--premium{background:var(--e-ink);color:#F6EFEA;border:0;border-top:4px solid var(--e-pink);padding:clamp(32px,4.2vw,60px);margin-top:-56px}
    .mb-plan:not(.mb-plan--premium){margin-top:40px}
    .mb-plan-word{display:block}
    .mb-plan--premium .mb-plan-claim{font-size:clamp(38px,4.6vw,64px);line-height:.98;letter-spacing:-.03em}
    .mb-strip{display:grid;grid-template-columns:repeat(31,minmax(0,1fr));gap:3px;margin:6px 0 10px;max-width:420px}
    .mb-strip span{height:22px;border:1px solid rgba(26,20,23,.4);border-radius:1px}
    .mb-strip--done{max-width:none}
    .mb-strip--done span{height:34px;border:0;background:var(--e-pink)}
    .mb-strip-cap{margin:0 0 26px}
    .mb-plan--premium .mb-strip-cap{color:rgba(246,239,234,.72)}
    .mb-plan-name{font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);margin:0 0 18px}
    .mb-plan--premium .mb-plan-name{color:var(--e-bubble)}
    .mb-plan-claim{font-size:clamp(30px,3.2vw,42px);line-height:1.04;margin:0 0 22px}
    .mb-plan--premium .mb-plan-claim em{color:var(--e-bubble)}
    .mb-plan-line{margin:0 0 28px;color:var(--e-ink-2);max-width:30em;font-size:16px}
    .mb-plan--premium .mb-plan-line{color:rgba(246,239,234,.82)}
    .mb-plan-if{font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--e-ink-3);margin:0 0 14px;padding-top:22px;border-top:1px solid var(--e-line)}
    .mb-plan--premium .mb-plan-if{color:rgba(246,239,234,.7);border-top-color:rgba(246,239,234,.16)}
    .mb-plan--premium .e-list li::before{background:var(--e-bubble)}
    .mb-plan .e-list{margin-bottom:32px;font-size:15.5px}
    .mb-plan:not(.mb-plan--premium) .mb-price-n{color:var(--e-ink)}
    .mb-plan-price{margin-top:auto;display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 8px;padding-top:24px;border-top:var(--e-hair);margin-bottom:24px}
    .mb-price-n{font-size:clamp(52px,5vw,68px);color:var(--e-pink)}
    .mb-plan--premium .mb-price-n{color:#fff}
    .mb-price-p{font-size:15px;color:var(--e-ink-3)}
    .mb-plan--premium .mb-price-p{color:rgba(246,239,234,.72)}
    .mb-price-alt{flex-basis:100%;font-size:15px;color:var(--e-ink-2)}
    .mb-plan--premium .mb-price-alt{color:rgba(246,239,234,.82)}
    .mb-plan-cta{align-self:flex-start}
    .mb-plan--premium .mb-plan-cta:hover{background:#fff;border-color:#fff;color:var(--e-ink)!important}

    /* Table */
    .mb-table{display:table;width:100%;border-collapse:collapse;font-size:16px;overflow:visible}
    .mb-table th,.mb-table td{text-align:left;vertical-align:top;padding:18px 16px;border-bottom:1px solid var(--e-line)}
    .mb-table thead th{font-family:var(--e-serif);font-weight:600;font-size:22px;letter-spacing:-.01em;border-bottom:1px solid var(--e-ink);padding-top:0;vertical-align:bottom}
    .mb-table thead th:first-child{width:auto}
    .mb-table thead th:not(:first-child),.mb-table td{width:180px;text-align:center}
    .mb-th-p{display:block;font-family:var(--e-sans);font-weight:500;font-size:13px;color:var(--e-ink-3);letter-spacing:0;margin-top:4px}
    .mb-table .mb-col-p{background:var(--e-blush)}
    .mb-table thead .mb-col-p{border-top:3px solid var(--e-pink);padding-top:16px;border-radius:4px 4px 0 0}
    .mb-table .mb-group th{font-family:var(--e-sans);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:var(--e-pink-t);padding:36px 16px 10px;border-bottom:var(--e-hair);background:var(--e-cream)}
    .mb-table tbody th{font-weight:400}
    .mb-row-t{display:block;font-weight:600;color:var(--e-ink)}
    .mb-row-sub{display:block;font-size:14px;line-height:1.55;color:var(--e-ink-3);margin-top:4px;max-width:46em}
    .mb-yes{display:inline-block;width:16px;height:9px;border-left:2px solid var(--e-pink);border-bottom:2px solid var(--e-pink);transform:rotate(-45deg);margin-top:6px}
    .mb-no{display:inline-block;width:14px;height:1px;background:rgba(26,20,23,.35);margin-top:12px}
    .mb-word{font-size:14px;font-weight:600;color:var(--e-ink-2)}
    .mb-col-p .mb-word{color:var(--e-pink-t)}

    /* DFY */
    .mb-dfy-grid{display:grid;grid-template-columns:minmax(0,.78fr) minmax(0,1.22fr);gap:clamp(40px,6vw,96px);align-items:start}
    .mb-dfy{padding-bottom:clamp(88px,11vw,160px)}
    .mb-dfy-copy{position:sticky;top:110px}
    .mb-dfy-lead{font-family:var(--e-serif);font-weight:600;font-size:clamp(22px,2.2vw,27px);line-height:1.35;letter-spacing:-.01em;color:#F6EFEA!important;margin:0 0 20px}
    .mb-dfy-copy p:not(.e-kick):not(.mb-dfy-lead){max-width:32em;font-size:16px}
    .mb-dfy-cta{margin-top:32px}
    /* The calendar is presented as a print: cream paper on the ink room. */
    .mb-cal{margin:0;background:var(--e-cream);color:var(--e-ink);border-radius:2px;padding:clamp(20px,3vw,40px);box-shadow:0 40px 80px -40px rgba(0,0,0,.7);transform:rotate(-.5deg)}
    .mb-cal-head{display:flex;align-items:flex-end;gap:clamp(14px,2vw,24px);padding-bottom:18px;margin-bottom:18px;border-bottom:var(--e-hair)}
    .mb-cal-big{color:var(--e-pink);font-size:clamp(84px,10vw,150px)}
