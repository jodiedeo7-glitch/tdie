---
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="WYS Setup Preview" description="Private WYS setup development preview" noindex wide>
  <section class="wys-setup">
    <p class="status">DEVELOPMENT PREVIEW · NOT CUSTOMER ACCESS</p>
    <h1>Set up your While-You-Sleep Storefront™</h1>
    <p>Build your business preferences once. This preview does not connect accounts or authorize publication.</p>
    <div class="wizard">
      <p>Development only: customer login and verified purchase access are not yet available.</p>
      <label for="wys-token">Temporary WYS-scoped test token (never saved)</label>
      <input id="wys-token" type="password" autocomplete="off" placeholder="Development test token" />
      <div class="actions"><button type="button" id="wys-load">Load saved setup</button><button type="button" id="wys-save-server">Save to workspace</button></div>
      <progress id="wys-progress" max="4" value="1"></progress>
      <form id="wys-form">
        <div id="wys-fields"></div>
        <div class="actions"><button type="button" id="wys-back">Back</button><button type="button" id="wys-next">Save and continue</button></div>
      </form>
      <p id="wys-status" role="status" aria-live="polite"></p>
    </div>
  </section>
</PageLayout>
<style>
.wys-setup{max-width:760px;margin:0 auto;padding:24px 0 70px;color:#1A1417}.status{font:700 13px Inter,sans-serif;color:#D62E73}.wys-setup h1{font-family:Newsreader,serif;font-weight:600;font-style:normal;font-size:clamp(30px,5vw,48px)}.wizard{background:#fff;border:2px solid #FF8AC2;border-radius:18px;padding:24px;margin-top:24px}.wizard progress{width:100%;accent-color:#D62E73}.wizard label{display:block;margin:16px 0 6px;font-weight:700}.wizard input,.wizard select{width:100%;padding:14px;border:2px solid #D62E73;border-radius:8px;font:inherit}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.actions button{background:#D62E73;color:#fff;border:0;border-radius:10px;padding:14px 18px;min-height:48px;font-weight:700;cursor:pointer}.actions button:disabled{opacity:.5}
</style>
<script>
const pages=[
[['niche','Your niche','text'],['categories','Product categories','text'],['idea','First shopping idea','text']],
[['amazon','Amazon account path','select',['Not sure','Associates','Influencer']],['destination','Approved website or storefront URL','url']],
[['pinterest','Pinterest profile','text'],['boards','Pinterest boards','text'],['instagram','Optional Instagram profile','text']],
[['mode','Preferred workflow','select',['Manual','Mixed / assisted']],['cadence','Posting schedule','text'],['budget','Maximum image generation budget in USD','number'],['persona','AI persona','select',['No','Yes, with my own approved reference']]]
];
const tokenInput=document.querySelector('#wys-token');
const loadButton=document.querySelector('#wys-load');
const saveButton=document.querySelector('#wys-save-server');
let values={};try{values=JSON.parse(sessionStorage.getItem('wys-preview-preferences')||'{}')}catch{}
const api=async(method)=>{
  const token=tokenInput?.value.trim();
  if(!token)throw Error('A verified WYS test session is required.');
  const response=await fetch('/api/wys-workspace',{method,headers:{'Authorization':'Bearer '+token,...(method==='PUT'?{'Content-Type':'application/json'}:{})},...(method==='PUT'?{body:JSON.stringify({preferences:values})}:{})});
  const body=await response.json();
  if(!response.ok)throw Error(body.error||'Workspace request failed');
  return body;
};
const fields=document.querySelector('#wys-fields');const progress=document.querySelector('#wys-progress');const back=document.querySelector('#wys-back');const next=document.querySelector('#wys-next');const status=document.querySelector('#wys-status');
if(fields&&progress&&back&&next&&status){
let step=0;
function draw(){fields.replaceChildren();progress.value=step+1;back.disabled=step===0;next.textContent=step===pages.length-1?'Save preview':'Save and continue';for(const [name,label,type,options] of pages[step]){const l=document.createElement('label');l.textContent=label;l.htmlFor='wys-'+name;const input=document.createElement(type==='select'?'select':'input');input.id='wys-'+name;if(type==='select'){for(const v of options){const opt=document.createElement('option');opt.value=v;opt.textContent=v;input.append(opt)}}else{input.type=type;if(type==='number'){input.min='0';input.step='0.01'}}input.value=values[name]||'';input.addEventListener('input',()=>{values[name]=input.value;sessionStorage.setItem('wys-preview-preferences',JSON.stringify(values))});fields.append(l,input)}status.textContent='Step '+(step+1)+' of '+pages.length+'. Saved in this browser tab only.'}
loadButton?.addEventListener('click',async()=>{try{status.textContent='Loading...';const data=await api('GET');values=data.preferences||{};sessionStorage.setItem('wys-preview-preferences',JSON.stringify(values));draw();status.textContent='Saved workspace loaded.'}catch(e){status.textContent=e.message}});
saveButton?.addEventListener('click',async()=>{try{status.textContent='Saving...';await api('PUT');status.textContent='Workspace preferences saved.'}catch(e){status.textContent=e.message}});
back.addEventListener('click',()=>{if(step>0){step--;draw()}});next.addEventListener('click',()=>{sessionStorage.setItem('wys-preview-preferences',JSON.stringify(values));if(step<pages.length-1){step++;draw()}else{status.textContent='Preview saved locally. To persist to a customer account, purchase verification and WYS authentication must be configured. No publication authorized.'}});draw()}
</script>