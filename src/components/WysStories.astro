---
import {Image} from 'astro:assets';
import {packages} from '../data/wys-packages.js';
import {WYS_ROOT} from '../data/wys.js';
const {inside=false}=Astro.props;
const stories=[
 {tag:'Pretty Wicked / Pink Halloween entryway',text:'Hot-pink pumpkins, a trail of bats and a little glow. See how five selected product types become an entryway styling story, three Pinterest graphics and a carousel.'},
 {tag:'Ghoul Fuel / Pink Halloween coffee bar',text:'A pink ghost mug, a heart-shaped stand and a few sparkling details. Follow the coffee-corner idea through its images, article and social content.'}
];
---
<section class="wys-wrap wys-section wb-featured" id={inside?'choose-package':'wys-stories'}>
 <div class="wx-centered"><p class="wys-label">Two Halloween looks to explore</p><h2>Pick a look.<br/><em>Follow the whole process.</em></h2><p>Start with five Amazon finds. See the styling images, Pinterest Pins, Instagram carousel and blog article built around them.</p></div>
 <div class="wx-look-pair">{packages.map((e,i)=><a href={`${inside?'':WYS_ROOT+'/look-inside'}#${e.slug}`} class={`wx-look-cover mat-${i}`}><div class="wx-cover-images"><Image src={e.photos[2].src} alt={e.photos[2].alt} widths={[320,480]} sizes="(max-width:700px) 235px, 280px"/><Image src={e.pins[1].src} alt={`${e.name} Pinterest graphic`} widths={[240,400]} sizes="(max-width:700px) 120px, 170px"/></div><div><p class="wb-story-kicker">{stories[i].tag}</p><h3>{e.name}</h3><p class="wb-story-description">{stories[i].text}</p><span class="wys-button">Explore {e.name} <span aria-hidden="true">→</span></span></div></a>)}</div>
</section>
