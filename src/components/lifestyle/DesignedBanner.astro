---
const {icing}=Astro.props;
const glints=[{x:5,y:37,s:20},{x:13,y:86,s:24},{x:47,y:28,s:31},{x:46,y:85,s:18},{x:94,y:37,s:24},{x:91,y:89,s:20},{x:29,y:24,s:14}];
---
<header class="tdie-brand-banner" aria-label="The Digital Income Edit brand banner">
 <div class="tdie-full-drip" style={`background-image:url('${icing}')`} aria-hidden="true"></div>
 <div class="tdie-banner-inner">
  <div class="tdie-brand-copy">
   <div class="tdie-brand-signature"><img src="/icon-512.png" width="512" height="512" alt=""/><span>The</span></div>
   <a class="tdie-banner-logo" href="/" aria-label="The Digital Income Edit — Home"><span>Digital Income</span><span>Edit<sup>™</sup></span></a>
   <p class="tdie-banner-promise">Build Your Business Backwards.<br/>Scale It Forward.<sup>™</sup></p>
  </div>
  <div class="tdie-world-collage" aria-label="Tommy Kate’s farmhouse business studio">
   <figure class="tdie-world-photo tdie-world-detail">
    <img src="/images/library/hero-office-wide-06.jpg" alt="Tommy Kate’s pink stationery, computers and golden retriever beneath her farmhouse desk" width="1600" height="900" loading="eager"/>
    <figcaption>The everyday magic</figcaption>
   </figure>
   <figure class="tdie-world-photo tdie-world-feature">
    <svg class="tdie-scalloped-mat" viewBox="0 0 320 360" preserveAspectRatio="none" aria-hidden="true"><defs><linearGradient id="tdie-frame-foil" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#ff8ac2"/><stop offset=".3" stop-color="#ffc8e2"/><stop offset=".52" stop-color="#ee6bab"/><stop offset=".72" stop-color="#ffb8d9"/><stop offset="1" stop-color="#ff8ac2"/></linearGradient></defs><path d="M16 16 Q40 -6 64 16 Q88 -6 112 16 Q136 -6 160 16 Q184 -6 208 16 Q232 -6 256 16 Q280 -6 304 16 Q326 42 304 68 Q326 94 304 120 Q326 146 304 172 Q326 198 304 224 Q326 250 304 276 Q326 310 304 344 Q280 366 256 344 Q232 366 208 344 Q184 366 160 344 Q136 366 112 344 Q88 366 64 344 Q40 366 16 344 Q-6 310 16 276 Q-6 250 16 224 Q-6 198 16 172 Q-6 146 16 120 Q-6 94 16 68 Q-6 42 16 16Z" fill="url(#tdie-frame-foil)"/></svg>
    <img src="/images/library/hero-office-wide-01.jpg" alt="Tommy Kate working in her bright farmhouse studio with her laptop and pink stationery" width="1600" height="900" loading="eager"/>
    <figcaption>Business, in her own world</figcaption>
   </figure>
  </div>
 </div>
 <svg class="tdie-jewel-field" viewBox="0 0 1440 440" preserveAspectRatio="none" aria-hidden="true"><defs><radialGradient id="tdie-pearl"><stop offset="0" stop-color="#fff"/><stop offset=".45" stop-color="#fff4fa"/><stop offset=".8" stop-color="#edb0d0"/><stop offset="1" stop-color="#fff"/></radialGradient><linearGradient id="tdie-chrome"><stop stop-color="#ff8ac2"/><stop offset=".35" stop-color="#fff"/><stop offset=".6" stop-color="#dba2c0"/><stop offset=".8" stop-color="#fff"/><stop offset="1" stop-color="#ef82b6"/></linearGradient></defs>
  {glints.map(p=><path transform={`translate(${p.x*14.4} ${p.y*4.4}) scale(${p.s/30})`} d="M0 -20 C3 -5 5 -3 15 0 C5 3 3 5 0 20 C-3 5 -5 3 -15 0 C-5 -3 -3 -5 0 -20Z" fill="url(#tdie-chrome)"/>)}
  {[{x:103,y:126,r:5},{x:181,y:111,r:3},{x:498,y:387,r:5},{x:608,y:113,r:4},{x:1308,y:340,r:6},{x:1358,y:284,r:3},{x:78,y:326,r:4},{x:623,y:348,r:3}].map(p=><circle cx={p.x} cy={p.y} r={p.r} fill="url(#tdie-pearl)"/>)}
 </svg>
</header>
