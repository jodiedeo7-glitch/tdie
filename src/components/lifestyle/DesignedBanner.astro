---
const {icing,showDrip=true}=Astro.props;
---
<div class="designed-banner tdie-repo-banner centered-boutique-banner blush-paper-banner boutique-lettering-banner">
 {showDrip && <div class="banner-top-drip" style={`background-image:url('${icing}')`} aria-hidden="true"></div>}
 <div class="banner-composition">
  <figure class="brand-photo brand-photo-studio">
   <img src="/images/home/flagship-attic-900.webp" alt="Tommy Kate in her pink attic studio with her laptop and glitter tumbler" width="900" height="1117" loading="eager"/>
   <figcaption>The pink attic studio</figcaption>
  </figure>
  <div class="brand-lockup">
   <a class="banner-wordmark" href="/" aria-label="The Digital Income Edit — Home">
    <span class="banner-the"><img class="banner-repo-icon" src="/icon-512.png" width="25" height="25" alt="" aria-hidden="true"/>The</span>
    <svg class="banner-title-art" viewBox="0 0 360 104" aria-hidden="true">
     <defs><pattern id="banner-letter-foil" width="650" height="20" patternUnits="userSpaceOnUse" patternTransform="rotate(-12)"><image href={icing} width="650" height="216.6667"/></pattern></defs>
     <text class="banner-name" x="180" y="42" text-anchor="middle">Digital</text>
     <text class="banner-edit" x="180" y="91" text-anchor="middle">Income Edit</text>
     <g class="banner-letter-sheen"><text x="180" y="42" text-anchor="middle">Digital</text><text x="180" y="91" text-anchor="middle">Income Edit</text></g>
     <text class="banner-trademark" x="310" y="70">™</text>
    </svg>
   </a>
   <p class="banner-tagline">Build Your Business Backwards.<br/>Scale It Forward.<sup>™</sup></p>
  </div>
  <figure class="brand-photo brand-photo-desk">
   <img src="/images/home/hero-pink-knit-desk-720.webp" alt="Tommy Kate working at her farmhouse window desk" width="720" height="893" loading="eager"/>
   <figcaption>The farmhouse desk</figcaption>
  </figure>
  <span class="optical-glint glint-one" aria-hidden="true"></span><span class="optical-glint glint-two" aria-hidden="true"></span><span class="optical-glint glint-three" aria-hidden="true"></span><span class="optical-glint glint-four" aria-hidden="true"></span><span class="optical-glint glint-five" aria-hidden="true"></span><span class="optical-glint glint-six" aria-hidden="true"></span>
  <span class="banner-pearl pearl-one" aria-hidden="true"></span><span class="banner-pearl pearl-two" aria-hidden="true"></span><span class="banner-pearl pearl-three" aria-hidden="true"></span><span class="banner-pearl pearl-four" aria-hidden="true"></span><span class="banner-pearl pearl-five" aria-hidden="true"></span><span class="banner-pearl pearl-six" aria-hidden="true"></span>
 </div>
 <div class="banner-rounded-edge" aria-hidden="true"></div>
</div>
