---
const {icing}=Astro.props;
const glints=[{x:'4%',y:'76%',size:21},{x:'38%',y:'28%',size:26},{x:'44%',y:'83%',size:19},{x:'92%',y:'22%',size:20}];
---
<header class="tdie-brand-banner" aria-label="The Digital Income Edit brand banner">
 <div class="tdie-full-drip" style={`background-image:url('${icing}')`} aria-hidden="true"></div>
 <div class="tdie-banner-inner">
  <div class="tdie-brand-copy">
   <div class="tdie-brand-signature"><img src="/icon-512.png" width="512" height="512" alt=""/><span>The</span></div>
   <a class="tdie-banner-logo" href="/" aria-label="The Digital Income Edit — Home"><span>Digital Income</span><span>Edit<sup>™</sup></span></a>
   <p class="tdie-banner-promise">Build Your Business Backwards.<br/>Scale It Forward.<sup>™</sup></p>
  </div>
  <div class="tdie-world-collage" aria-label="Tommy Kate’s studio and farmhouse life">
   <figure class="tdie-world-photo tdie-world-studio">
    <img src="/images/home/flagship-attic-900.webp" width="900" height="1117" alt="Tommy Kate laughing with her pink glitter tumbler in her attic studio" loading="eager"/>
    <figcaption>The pink attic studio</figcaption>
   </figure>
   <figure class="tdie-world-photo tdie-world-desk">
    <img src="/images/home/hero-pink-knit-desk-720.webp" width="720" height="893" alt="Tommy Kate at her farmhouse desk with her pink tumbler and laptop" loading="eager"/>
    <figcaption>The farmhouse desk</figcaption>
   </figure>
   <figure class="tdie-world-photo tdie-world-farm">
    <img src="/images/pages/about-porch-red-barn-840.webp" width="840" height="1042" alt="Tommy Kate on her porch with a pink mug, with the red barn behind her" loading="eager"/>
    <figcaption>Life on the farm</figcaption>
   </figure>
  </div>
 </div>
 {glints.map(p=><svg class="tdie-chrome-glint" style={`left:${p.x};top:${p.y};width:${p.size}px`} viewBox="0 0 30 40" aria-hidden="true"><defs><linearGradient id={`glint-${p.size}`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="#fff"/><stop offset=".35" stop-color="#ff8ac2"/><stop offset=".5" stop-color="#fff"/><stop offset=".7" stop-color="#b4bbc4"/><stop offset="1" stop-color="#fff"/></linearGradient></defs><path d="M15 0 C17 14 19 17 30 20 C19 23 17 26 15 40 C13 26 11 23 0 20 C11 17 13 14 15 0Z" fill={`url(#glint-${p.size})`}/></svg>)}
</header>
