---
const {icing}=Astro.props;
---
<div class="designed-banner tdie-repo-banner layered-brand-banner">
 <div class="banner-world"><img class="banner-world-work" src="/images/home/build-armchair-laptop-900.webp" alt="Tommy Kate building her business from her farmhouse armchair" width="900" height="600" loading="eager"/><img src="/images/home/founder-window-seat-1000.webp" alt="Tommy Kate with her laptop and pink glitter tumbler at her farmhouse window" width="1000" height="667" loading="eager"/></div>
 <div class="banner-top-drip" style={`background-image:url('${icing}')`} aria-hidden="true"></div>
 <div class="banner-composition">
  <div class="brand-lockup">
   <a class="banner-wordmark" href="/" aria-label="The Digital Income Edit — Home">
    <span class="banner-the"><img class="banner-repo-icon" src="/icon-512.png" width="28" height="28" alt="" aria-hidden="true"/>The</span>
    <span class="banner-name">Digital Income</span><span class="banner-edit">Edit<sup>™</sup></span>
   </a>
   <p class="banner-tagline">Build Your Business Backwards.<br/>Scale It Forward.™</p>
   <span class="paper-glint glint-one" aria-hidden="true"></span><span class="paper-glint glint-two" aria-hidden="true"></span>
  </div>
  <figure class="brand-photo brand-photo-studio"><img src="/images/home/flagship-attic-900.webp" alt="Tommy Kate in her pink attic studio" width="900" height="1117" loading="eager"/><figcaption>The pink attic studio</figcaption></figure>
 </div>
 <div class="banner-foil-edge" aria-hidden="true"></div>
</div>
