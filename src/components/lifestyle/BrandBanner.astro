---
const { icing } = Astro.props;
---
<div class="tdie-brand-banner">
  <div class="tdie-banner-drip" style={`background-image:url('${icing}')`} aria-hidden="true"></div>
  <a class="tdie-banner-brand" href="/" aria-label="The Digital Income Edit — Home">
    <span class="tdie-banner-the">The</span>
    <span class="tdie-banner-name">Digital Income</span>
    <span class="tdie-banner-edit">EDIT<sup>™</sup></span>
  </a>
</div>
