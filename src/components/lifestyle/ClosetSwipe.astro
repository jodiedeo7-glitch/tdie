---
// "Swipe the Closet": one look at a time, Tinder-style. Swipe right to save, left to skip.
// Under each photo: that look's items, each with its photo and Amazon link. (Jodie, 10 Oct 2026)
import { getImage } from 'astro:assets';
import { LOOKS, categoryOf } from '../../data/lifestyle.js';
const looks = LOOKS.filter(look => look.category === 'clothing' && look.items.some(item => item.image && item.link && item.affiliateStatus !== 'pending'));
const deck = await Promise.all(looks.map(async (look, index) => {
  const photo = look.images.find(image => image.role === 'lifestyle') || look.images.find(image => image.role === 'styled') || look.hero;
  const big = await getImage({ src: photo.src, width: 720, format: 'webp', quality: 82 });
  const thumb = await getImage({ src: photo.src, width: 160, format: 'webp', quality: 75 });
  const items = look.items.filter(item => item.image && item.link && item.affiliateStatus !== 'pending').map(item => ({
    name: item.name, image: item.image, link: item.link,
    rel: ['verified', 'legacy'].includes(item.affiliateStatus) ? 'sponsored nofollow noopener' : 'noopener nofollow',
  }));
  const cat = categoryOf(look.category)?.name;
  return { slug: look.slug, title: look.title, kicker: `${cat}${look.season && look.season !== 'Evergreen' ? ` · ${look.season}` : ''}`, src: big.src, thumb: thumb.src, alt: photo.alt, items, eager: index < 2 };
}));
const saveData = JSON.stringify(Object.fromEntries(deck.map(d => [d.slug, { t: d.title, i: d.thumb }])));
---
{deck.length > 0 && <section class="cs-band" aria-labelledby="cs-title">
  <div class="cs-plate">
    <div class="cs-intro cs-head">
      <p class="life-kicker">Swipe the closet</p>
      <h2 id="cs-title">Swipe right on <span>your next look.</span></h2>
      <p class="cs-how">Love it? Swipe right and it's saved. Not your vibe? Swipe left. Every piece is right under the photo, with its own shop link.</p>
    </div>
    <div class="cs-intro cs-extra">
      <ol class="cs-steps">
        <li><span class="cs-step-icon cs-step-love" aria-hidden="true">♥</span><span><b>Swipe right</b> to save a look you love</span></li>
        <li><span class="cs-step-icon" aria-hidden="true">✕</span><span><b>Swipe left</b> to skip to the next outfit</span></li>
        <li><span class="cs-step-icon" aria-hidden="true">↗</span><span><b>Tap a piece</b> under the photo to shop it on Amazon</span></li>
      </ol>
      <div class="cs-saved" data-cs-saved>
        <p class="cs-saved-title">Your saved looks <b data-cs-saved-count>0</b></p>
        <p class="cs-saved-empty" data-cs-saved-empty>Your favorites land here. Swipe right on a look to start your wishlist.</p>
        <ul class="cs-saved-list" data-cs-saved-list></ul>
        <button type="button" class="cs-clear" data-cs-clear hidden>Clear saved looks</button>
      </div>
      <p class="cs-note">Links go to Amazon. As an Amazon Associate I earn from qualifying purchases.</p>
    </div>
    <div class="cs-stage" data-cs data-cs-looks={saveData}>
      <p class="cs-count" aria-live="polite"><span data-cs-pos>1</span> of {deck.length}</p>
      <div class="cs-deck" data-cs-deck>
        {deck.map((d, i) => <article class="cs-card" data-cs-card data-slug={d.slug} data-pos={i === 0 ? '0' : i === 1 ? '1' : 'hidden'} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="cs-photo" data-cs-drag>
            <img src={d.src} alt={d.alt} width="720" height="1080" loading={d.eager ? 'eager' : 'lazy'} decoding="async" draggable="false" />
            <span class="cs-stamp cs-stamp-love" aria-hidden="true">Love it</span>
            <span class="cs-stamp cs-stamp-skip" aria-hidden="true">Skip</span>
          </div>
          <div class="cs-info">
            <p class="cs-kicker">{d.kicker}</p>
            <h3><a href={`/lifestyle/${d.slug}`}>{d.title}</a></h3>
            <p class="cs-items-label">Shop the pieces <span>· {d.items.length}</span></p>
            <ul class="cs-items">{d.items.map(item => <li><a href={item.link} target="_blank" rel={item.rel}><span class="cs-item-img"><img src={item.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" width="160" height="160" /></span><span class="cs-item-name">{item.name}</span><span class="cs-item-go">Shop <span aria-hidden="true">→</span><span class="life-sr"> (opens Amazon in a new tab)</span></span></a></li>)}</ul>
            <a class="cs-open" href={`/lifestyle/${d.slug}`}>See the full look <span aria-hidden="true">→</span></a>
          </div>
        </article>)}
        <div class="cs-end" data-cs-end hidden>
          <p class="cs-end-big">That's the whole closet.</p>
          <p>Your saved looks are on the left. Want another lap?</p>
          <button type="button" class="life-button" data-cs-restart>Start over</button>
        </div>
      </div>
      <div class="cs-actions">
        <button type="button" class="cs-btn cs-skip" data-cs-skip aria-label="Skip this look"><span aria-hidden="true">✕</span></button>
        <button type="button" class="cs-btn cs-undo" data-cs-undo aria-label="Go back one look" disabled><span aria-hidden="true">↺</span></button>
        <button type="button" class="cs-btn cs-love" data-cs-love aria-label="Save this look"><span aria-hidden="true">♥</span></button>
      </div>
    </div>
  </div>
</section>}
<style is:global>
.cs-band{background:url(/images/brand/gl-tile.webp) 0 0/360px 360px;padding:80px 0}
.cs-head{grid-column:1;grid-row:1;align-self:end}
.cs-extra{grid-column:1;grid-row:2;align-self:start}
.cs-stage{grid-column:2;grid-row:1/span 2}
.cs-steps{list-style:none;margin:26px 0 0;padding:0;display:grid;gap:12px}
.cs-steps li{display:flex;align-items:center;gap:14px;font-size:16px;line-height:1.4;color:#4A3640}
.cs-steps b{color:#1A1417}
.cs-step-icon{flex:none;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#fff;box-shadow:0 0 0 2px #E891B6;color:#B8245F;font-size:18px}
.cs-step-love{color:#fff;background:url(/images/brand/gl-hot.webp) 0 0/120px;box-shadow:0 0 0 2px #D62E73}
.cs-saved-empty{margin:0!important;font-size:15px;color:#4A3640!important}
.cs-saved-empty[hidden],.cs-clear[hidden]{display:none}
.cs-plate{max-width:1180px;margin:0 auto;background:#fff;border-radius:26px;box-shadow:0 40px 70px -36px rgba(110,10,50,.7);padding:52px clamp(20px,4vw,56px);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,440px);column-gap:56px;row-gap:0;align-items:start}
.cs-intro h2{font:600 clamp(30px,3.4vw,40px)/1.1 Newsreader,Georgia,serif;margin:6px 0 16px;color:#1A1417;text-wrap:balance}
.cs-intro h2 span{color:#D62E73}
.cs-how{font-size:18px;line-height:1.6;color:#4A3640;max-width:38ch}
.cs-note{font-size:13px;color:#4A3640;margin-top:22px!important}
.cs-saved{margin-top:26px;padding:20px;border-radius:20px;background:#FFF1F7;box-shadow:0 0 0 1.5px #F3D3E0}
.cs-saved-title{font:700 12px/1.4 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#B8245F;margin:0 0 12px!important}
.cs-saved-title b{display:inline-grid;place-items:center;min-width:24px;height:24px;margin-left:6px;border-radius:999px;background:#D62E73;color:#fff;letter-spacing:0;font-size:12px}
.cs-saved-list{list-style:none;margin:0;padding:0 0 6px;display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory}
.cs-saved-list li{flex:0 0 112px;scroll-snap-align:start}
.cs-saved-list a{display:block;text-decoration:none;color:#1A1417}
.cs-saved-list img{display:block;width:112px;height:168px;object-fit:cover;border-radius:12px;box-shadow:0 10px 18px -12px rgba(110,10,50,.6)}
.cs-saved-list span{display:block;margin-top:6px;font:600 13px/1.25 Inter,sans-serif}
.cs-clear{margin-top:10px;background:none;border:0;padding:8px 0;min-height:44px;font:600 13px Inter,sans-serif;color:#B8245F;text-decoration:underline;text-underline-offset:3px;cursor:pointer}
.cs-stage{position:relative;width:100%;max-width:440px;justify-self:center}
.cs-count{margin:0 0 12px!important;text-align:center;font:700 12px/1 Inter,sans-serif;letter-spacing:.2em;text-transform:uppercase;color:#B8245F}
.cs-deck{display:grid;position:relative}
.cs-card,.cs-end{grid-area:1/1;min-width:0}
.cs-card{background:#fff;border-radius:24px;overflow:hidden;box-shadow:0 0 0 1.5px #F3D3E0,0 30px 50px -30px rgba(110,10,50,.65);transition:transform .32s ease,opacity .32s ease;will-change:transform}
.cs-card[data-pos="0"]{z-index:3}
.cs-card[data-pos="1"]{z-index:2;transform:translateY(14px) scale(.95);opacity:.85;pointer-events:none}
.cs-card[data-pos="hidden"],.cs-card[data-pos="gone"]{visibility:hidden;pointer-events:none;opacity:0}
.cs-card.is-dragging{transition:none}
.cs-card.out-right{transform:translateX(130%) rotate(18deg)!important;opacity:0}
.cs-card.out-left{transform:translateX(-130%) rotate(-18deg)!important;opacity:0}
.cs-photo{position:relative;aspect-ratio:2/3;background:#FFE4EF;cursor:grab;touch-action:pan-y;user-select:none;-webkit-user-select:none}
.cs-card.is-dragging .cs-photo{cursor:grabbing}
.cs-photo img{display:block;width:100%;height:100%;object-fit:cover;pointer-events:none}
.cs-stamp{position:absolute;top:22px;padding:8px 16px;border:4px solid;border-radius:12px;background:#fff;font:800 22px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;opacity:0;transition:opacity .1s}
.cs-stamp-love{left:20px;color:#D62E73;border-color:#D62E73;transform:rotate(-12deg)}
.cs-stamp-skip{right:20px;color:#4A3640;border-color:#4A3640;transform:rotate(12deg)}
.cs-info{padding:20px 20px 22px}
.cs-kicker{margin:0 0 6px!important;font:700 11px/1.4 Inter,sans-serif;letter-spacing:.18em;text-transform:uppercase;color:#B8245F!important}
.cs-info h3{margin:0 0 14px!important;font:600 24px/1.15 Newsreader,Georgia,serif}
.cs-info h3 a{color:#1A1417;text-decoration:none}
.cs-items-label{margin:0 0 10px!important;font:700 12px/1.4 Inter,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#1A1417!important}
.cs-items-label span{color:#B8245F}
.cs-items{list-style:none;margin:0 -20px;padding:0 20px 8px;display:flex;gap:10px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:20px;scrollbar-width:thin;scrollbar-color:#D62E73 #FFE4EF}
.cs-items li{flex:0 0 132px;scroll-snap-align:start}
.cs-items a{display:flex;flex-direction:column;height:100%;padding:8px;border-radius:16px;background:#fff;box-shadow:0 0 0 1.5px #F3D3E0;text-decoration:none;color:#1A1417}
.cs-items a:hover{box-shadow:0 0 0 2px #D62E73}
.cs-item-img{display:block;aspect-ratio:1/1;border-radius:10px;overflow:hidden;background:#fff}
.cs-item-img img{display:block;width:100%;height:100%;object-fit:contain}
.cs-item-name{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin:8px 0 6px;font:600 13px/1.3 Inter,sans-serif;flex:1}
.cs-item-go{font:700 11px/1 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#B8245F}
.cs-open{display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-top:8px;font:700 12px/1.2 Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#B8245F;text-decoration:none;border-bottom:1.5px solid #FF8AC2}
.cs-end{z-index:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:40px 24px;border-radius:24px;background:#FFF1F7;box-shadow:0 0 0 1.5px #F3D3E0;min-height:420px}
.cs-end[hidden]{display:none}
.cs-end-big{font:600 30px/1.1 Newsreader,Georgia,serif;color:#1A1417!important}
.cs-actions{display:flex;justify-content:center;align-items:center;gap:22px;margin-top:22px}
.cs-btn{display:grid;place-items:center;border-radius:50%;cursor:pointer;border:0;background:#fff;box-shadow:0 0 0 2px #E891B6,0 14px 24px -12px rgba(110,10,50,.6);transition:transform .15s}
.cs-btn:hover:not(:disabled){transform:scale(1.07)}
.cs-btn:disabled{opacity:.35;cursor:default}
.cs-btn:focus-visible{outline:3px solid #B8245F;outline-offset:4px}
.cs-skip,.cs-love{width:72px;height:72px;font-size:30px}
.cs-skip{color:#4A3640}
.cs-undo{width:52px;height:52px;font-size:22px;color:#B8245F}
.cs-love{color:#fff;background:url(/images/brand/gl-hot.webp) 0 0/160px;box-shadow:0 0 0 3px #fff,0 0 0 5px #D62E73,0 14px 24px -10px rgba(150,20,70,.7);text-shadow:0 1px 3px rgba(110,10,50,.6)}
@media (max-width:900px){
 .cs-band{padding:44px 0}
 .cs-plate{grid-template-columns:minmax(0,1fr);gap:26px;margin:0 12px;padding:30px 16px;border-radius:20px}
 .cs-head,.cs-extra,.cs-stage{grid-column:1;grid-row:auto;align-self:start}
 .cs-head{order:1}.cs-stage{order:2}.cs-extra{order:3}
 .cs-head{text-align:center}.cs-how{margin-inline:auto}
 .cs-saved{text-align:left}
}
@media (prefers-reduced-motion:reduce){.cs-card{transition:none}}
</style>
<script>
  document.querySelectorAll<HTMLElement>('[data-cs]').forEach(stage => {
    const cards = Array.from(stage.querySelectorAll<HTMLElement>('[data-cs-card]'));
    const end = stage.querySelector<HTMLElement>('[data-cs-end]')!;
    const pos = stage.querySelector<HTMLElement>('[data-cs-pos]')!;
    const undoBtn = stage.querySelector<HTMLButtonElement>('[data-cs-undo]')!;
    const skipBtn = stage.querySelector<HTMLButtonElement>('[data-cs-skip]')!;
    const loveBtn = stage.querySelector<HTMLButtonElement>('[data-cs-love]')!;
    const looks: Record<string, { t: string; i: string }> = JSON.parse(stage.dataset.csLooks || '{}');
    const root = stage.closest('.cs-band')!;
    const savedBox = root.querySelector<HTMLElement>('[data-cs-saved]')!;
    const savedList = root.querySelector<HTMLElement>('[data-cs-saved-list]')!;
    const savedCount = root.querySelector<HTMLElement>('[data-cs-saved-count]')!;
    const KEY = 'tdie-closet-saved';
    let saved: string[] = [];
    try { saved = JSON.parse(localStorage.getItem(KEY) || '[]').filter((s: string) => looks[s]); } catch {}
    const store = () => { try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch {} };
    const history: { slug: string; loved: boolean }[] = [];
    let index = 0;
    const renderSaved = () => {
      root.querySelector<HTMLElement>('[data-cs-saved-empty]')!.hidden = saved.length > 0;
      root.querySelector<HTMLElement>('[data-cs-clear]')!.hidden = saved.length === 0;
      savedCount.textContent = String(saved.length);
      savedList.replaceChildren(...saved.map(slug => {
        const li = document.createElement('li');
        const a = document.createElement('a'); a.href = `/lifestyle/${slug}`;
        const img = document.createElement('img'); img.src = looks[slug].i; img.alt = ''; img.loading = 'lazy'; img.width = 112; img.height = 168;
        const span = document.createElement('span'); span.textContent = looks[slug].t;
        a.append(img, span); li.append(a); return li;
      }));
    };
    const layout = () => {
      cards.forEach((card, i) => {
        card.classList.remove('out-left', 'out-right', 'is-dragging');
        card.style.transform = '';
        const p = i < index ? 'gone' : i === index ? '0' : i === index + 1 ? '1' : 'hidden';
        card.dataset.pos = p;
        if (p === '0') card.removeAttribute('aria-hidden'); else card.setAttribute('aria-hidden', 'true');
        if (p === '1') card.querySelectorAll('img').forEach(img => img.loading = 'eager');
        card.querySelectorAll<HTMLElement>('a,button').forEach(el => p === '0' ? el.removeAttribute('tabindex') : el.setAttribute('tabindex', '-1'));
        stamps(card, 0);
      });
      const done = index >= cards.length;
      end.hidden = !done;
      skipBtn.disabled = loveBtn.disabled = done;
      undoBtn.disabled = history.length === 0;
      pos.textContent = String(Math.min(index + 1, cards.length));
    };
    const stamps = (card: HTMLElement, dx: number) => {
      const love = card.querySelector<HTMLElement>('.cs-stamp-love'); const skip = card.querySelector<HTMLElement>('.cs-stamp-skip');
      if (love) love.style.opacity = String(Math.max(0, Math.min(1, dx / 90)));
      if (skip) skip.style.opacity = String(Math.max(0, Math.min(1, -dx / 90)));
    };
    const decide = (loved: boolean) => {
      const card = cards[index]; if (!card) return;
      const slug = card.dataset.slug!;
      if (loved && !saved.includes(slug)) { saved.unshift(slug); store(); renderSaved(); }
      history.push({ slug, loved });
      card.classList.remove('is-dragging');
      card.style.transform = '';
      card.classList.add(loved ? 'out-right' : 'out-left');
      index += 1;
      const next = cards[index]; if (next) { next.dataset.pos = '0'; }
      setTimeout(layout, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 300);
    };
    const undo = () => {
      const last = history.pop(); if (!last) return;
      if (last.loved) { saved = saved.filter(s => s !== last.slug); store(); renderSaved(); }
      index = Math.max(0, index - 1); layout();
    };
    skipBtn.addEventListener('click', () => decide(false));
    loveBtn.addEventListener('click', () => decide(true));
    undoBtn.addEventListener('click', undo);
    stage.querySelector('[data-cs-restart]')?.addEventListener('click', () => { index = 0; history.length = 0; layout(); });
    root.querySelector('[data-cs-clear]')?.addEventListener('click', () => { saved = []; store(); renderSaved(); });
    stage.addEventListener('keydown', e => { if ((e.target as HTMLElement).closest('.cs-items')) return; if (e.key === 'ArrowRight') { e.preventDefault(); decide(true); } if (e.key === 'ArrowLeft') { e.preventDefault(); decide(false); } });
    cards.forEach(card => {
      const handle = card.querySelector<HTMLElement>('[data-cs-drag]')!;
      let startX = 0, startY = 0, dx = 0, active = false, id = -1;
      handle.addEventListener('pointerdown', e => { if (card.dataset.pos !== '0') return; active = true; id = e.pointerId; startX = e.clientX; startY = e.clientY; dx = 0; handle.setPointerCapture(id); card.classList.add('is-dragging'); });
      handle.addEventListener('pointermove', e => { if (!active || e.pointerId !== id) return; dx = e.clientX - startX; const dy = (e.clientY - startY) * .25; card.style.transform = `translate(${dx}px, ${dy}px) rotate(${dx / 18}deg)`; stamps(card, dx); });
      const finish = (e: PointerEvent) => { if (!active || e.pointerId !== id) return; active = false; card.classList.remove('is-dragging'); if (Math.abs(dx) > 100) decide(dx > 0); else { card.style.transform = ''; stamps(card, 0); } };
      handle.addEventListener('pointerup', finish);
      handle.addEventListener('pointercancel', finish);
    });
    renderSaved(); layout();
  });
</script>
