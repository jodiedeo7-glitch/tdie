---
import { Image } from 'astro:assets';
import { CATEGORIES, LOOKS } from '../../data/lifestyle.js';
import jewelry from '../../assets/lifestyle/categories/jewelry.jpg';
import beauty from '../../assets/lifestyle/categories/beauty.jpg';
import perfume from '../../assets/lifestyle/categories/perfume.jpg';
import books from '../../assets/lifestyle/categories/books.jpg';
import gifts from '../../assets/lifestyle/categories/gifts.jpg';
const { current } = Astro.props;
const chosen = { clothing: 'pink-suit-law-student-halloween-costume', accessories: 'pink-dog-halloween-finds', 'home-decor': 'pretty-wicked-entryway', dorm: 'pink-dorm-halloween-decor', car: 'pink-car-interior-accessories' };
const previews = { jewelry: { src: jewelry, alt: 'Gold earrings resting on a pale stone' }, beauty: { src: beauty, alt: 'Pink makeup brushes and cosmetics arranged together' }, perfume: { src: perfume, alt: 'A glass perfume bottle against a pastel blue background' }, books: { src: books, alt: 'A book with a pink spine beside a laptop' }, gifts: { src: gifts, alt: 'A pink gift box tied with a gold ribbon' } };
const categories = CATEGORIES.map(category => {
  const articles = LOOKS.filter(look => look.category === category.slug);
  const selected = articles.find(look => look.slug === chosen[category.slug]) || articles[0];
  const image = selected ? selected.images.find(image => image.role === 'lifestyle') || selected.images.find(image => image.role === 'styled') || selected.hero : previews[category.slug];
  return { ...category, count: articles.length, image, preview: !selected };
}).sort((a, b) => Number(b.count > 0) - Number(a.count > 0));
---
<nav class="life-categories" aria-label="Lifestyle categories">
  {categories.map(category => <a class="life-category-card" href={`/lifestyle/${category.slug}`} aria-current={current === category.slug ? 'page' : undefined}>
    <span class:list={['life-category-image', { 'life-category-preview': category.preview }]}><Image src={category.image.src} alt={category.image.alt} widths={[160, 240, 360, 480]} sizes="(max-width: 640px) 42vw, (max-width: 1000px) 28vw, 190px" loading="lazy" /></span>
    <span class="life-category-name">{category.name}</span>
    <span class="life-category-count">{category.count ? `${category.count} article${category.count === 1 ? '' : 's'}` : 'Collection preview'}</span>
    <span class="life-category-go">{category.count ? 'Browse the edit' : 'Explore this corner'} <span aria-hidden="true">→</span></span>
  </a>)}
</nav>
