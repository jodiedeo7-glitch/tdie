---
import { CATEGORIES, LOOKS } from '../../data/lifestyle.js';
const { current } = Astro.props;
const categories = CATEGORIES.map(category => ({ ...category, count: LOOKS.filter(look => look.category === category.slug).length })).sort((a, b) => Number(b.count > 0) - Number(a.count > 0));
---
<nav class="life-categories" aria-label="Lifestyle categories">
  {categories.map(category => <a href={`/lifestyle/${category.slug}`} aria-current={current === category.slug ? 'page' : undefined}><span>{category.name}</span><span class="life-category-count">{category.count ? `${category.count} article${category.count === 1 ? '' : 's'}` : 'Explore category'} <span aria-hidden="true">→</span></span></a>)}
</nav>
