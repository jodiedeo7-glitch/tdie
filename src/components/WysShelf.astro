---
import {Image} from 'astro:assets';
import {packages} from '../data/wys-packages.js';
import {WYS_ROOT} from '../data/wys.js';
const {inside=false}=Astro.props;
const links=[{name:'The photographs',sub:'Three views of one look',src:packages[0].photos[0].src,alt:packages[0].photos[0].alt,panel:1},{name:'The Pinterest set',sub:'Graphics + complete copy',src:packages[1].pins[1].src,alt:'Ghoul Fuel styled Pinterest graphic',panel:2},{name:'The swipe-through',sub:'A three-slide carousel',src:packages[0].slides[2].src,alt:'Pretty Wicked lifestyle Instagram slide',panel:3},{name:'The whole story',sub:'Article + selected products',src:packages[1].photos[1].src,alt:packages[1].photos[1].alt,panel:4}];
---
<section class="wb-shelf-band"><div class="wys-wrap wb-shelf"><p class="wys-label">Open your next little obsession</p><div class="wb-shelf-grid">{links.map((l,i)=><a class={`wb-category wb-category-${i}`} href={`${inside?'':WYS_ROOT+'/look-inside?view='+l.panel}#${i%2?'ghoul-fuel-coffee-bar':'pretty-wicked-entryway'}`} data-open-package={inside?l.panel:undefined}><div class="wb-category-photo"><Image src={l.src} alt={l.alt} widths={[240,400]} sizes="(max-width:700px) 40vw, 220px"/></div><h3>{l.name}</h3><p>{l.sub}</p><span>Take a look <b aria-hidden="true">↗</b></span></a>)}</div></div></section>
<script>
 document.querySelectorAll<HTMLAnchorElement>('[data-open-package]').forEach(a=>a.addEventListener('click',()=>{document.querySelector(a.hash)?.querySelector<HTMLButtonElement>(`[data-panel-button="${a.dataset.openPackage}"]`)?.click();}));
</script>
