---
import {faqs} from '../data/wys-packages.js';
---
<section class="wys-wrap wys-section"><div class="wx-faq-layout"><div><p class="wys-label">Before you decide</p><h2>Your questions,<br/><em>with real answers.</em></h2><div class="wx-note-ticket"><b>Your setup. Your choices.</b><p>Use your own accounts and tested tools, with clear setup requirements and an approval policy. Your actual tools and permissions determine the path.</p></div></div><div class="wx-faq">{faqs.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div></section>
