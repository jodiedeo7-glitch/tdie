---
import {Image} from 'astro:assets';
import {packages} from '../data/wys-packages.js';
import {contents} from '../data/wys.js';
const notes=[['Choose your route','Choose the Amazon route, tools and budget that fit your business before you start creating.'],['Connect what you actually have','Record your preferences once, so your next shopping idea starts with your business choices already in place.'],['Make one complete look','Build styling images, an article, Pinterest Pins and an Instagram carousel around the same selected products.'],['Repeat with checkpoints','Plan your next themed look or optional Outfit of the Day, and keep track of work that still needs finishing.'],['Give the look a home','Connect the content to an eligible Amazon Idea List or your approved website, so readers know where to shop.'],['Add a closet if it fits','Add a clothing-focused path if it suits your business. Requires your own authorized Brand Closet membership.']];
---
<section class="wx-kit-band" aria-labelledby="wys-kit-heading"><div class="wys-wrap wys-section"><div class="wx-centered wz-kit-heading"><p class="wys-label">Inside the planned kit</p><h2 id="wys-kit-heading">Your storefront toolkit.</h2><p>Set up your business, turn your finds into content, and use the guides and prompts again for your next idea.</p></div><div class="wx-kit-grid">{contents.map((c,i)=><details class={`wx-guide guide-${i%3}`}><summary><div class="wz-guide-visual"><span class="wx-guide-number">{c.n}</span><Image class="wb-guide-image" src={packages[i%2].photos[i%3].src} alt={packages[i%2].photos[i%3].alt} widths={[240,360,480]} sizes="(max-width:700px) 240px, 260px"/><span class="wz-guide-image-note">From the Halloween looks</span></div><span class="wx-guide-title">{i===2?'Look-building instructions':c.title}</span><span class="wz-guide-benefit">{notes[i][1]}</span><span class="wx-guide-tag"><span class="wz-guide-open">See what’s included</span><span class="wz-guide-close">Close the details</span><b aria-hidden="true">+</b></span></summary><div><h3>{notes[i][0]}</h3><p>{c.text}</p><p>{notes[i][1]}</p></div></details>)}</div><p class="wz-kit-note">Planned kit contents. Customer checkout and delivery remain closed while the kit is finalized.</p></div></section>
