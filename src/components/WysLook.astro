---
// One WYS look shown at readable size: three photos with captions OUTSIDE the photos.
// Desktop: three columns. Phones: a swipe row of near-full-width photos.
import { Image } from "astro:assets";
const { look, tone = "cream", headingLevel = "h3" } = Astro.props;
const H = headingLevel;
---
<div class={`wl-look wl-look-${tone}`}>
  <div class="wl-look-head">
    <span class="wl-cat">{look.label}</span>
    <H class="wl-look-name">{look.name}</H>
  </div>
  <p class="wl-swipe" aria-hidden="true">Swipe to see all three →</p>
  <ol class="wl-look-row" aria-label={`${look.name}: basic, styled and lifestyle photographs`}>
    {look.shots.map((s, i) => (
      <li class="wl-look-item">
        <div class="wl-frame">
          <Image src={s.img} alt={s.alt} widths={[340, 480, 680]} sizes="(max-width: 700px) 80vw, (max-width: 1100px) 31vw, 340px" />
        </div>
        <p class="wl-cap"><span class="wl-role">{String(i + 1).padStart(2, "0")} · {s.role}</span><b>{s.title}</b>{s.text}</p>
      </li>
    ))}
  </ol>
  <p class="wl-look-note">{look.note}</p>
</div>
