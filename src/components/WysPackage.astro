---
import WysPinterest from './WysPinterest.astro';
import WysProductSelection from './WysProductSelection.astro';
import WysInstagram from './WysInstagram.astro';
import WysPhoto from './WysPhoto.astro';
import {imageNotice} from '../data/wys.js';
const {example:e,number,tour=false}=Astro.props;
---
<section class:list={['wx-package',number===2&&'wx-package-lav',tour&&'wx-package-tour']} id={e.slug} data-package data-package-tour={tour || undefined}>

 <div class="wx-folder-tab">{tour ? "ONE SHOPPING IDEA / THE FULL EXAMPLE" : `THE HALLOWEEN LOOK`}</div>
 <header class="wx-package-heading"><div><p class="wys-label">{e.category}</p><h2>{e.name}</h2><p>Three styling photographs, three Pins, an Instagram carousel and a blog article.</p></div><a class="wys-text-link" href={`/lifestyle/${e.slug}`}>Read the styling article →</a></header>
 <div id={`${e.slug}-output-1`} data-panel="1" class="wx-panel"><div class="wx-output-label"><h3>The styling images</h3><p>The five finds, the decorated setting and Tommy Kate.</p></div><div class="wx-three">{e.photos.map((p,i)=><WysPhoto photo={p} treatment={['double','lavender','polaroid'][i]} label={`${i+1} / ${p.role}`}/>)}</div><p class="wx-fine">{imageNotice}</p></div>
 <div id={`${e.slug}-output-2`} data-panel="2" class="wx-panel"><div class="wx-output-label"><h3>The Pinterest content</h3><p>Three Pins with titles, descriptions and the article link.</p></div><WysPinterest example={e}/></div>
 <div id={`${e.slug}-output-3`} data-panel="3" class="wx-panel"><div class="wx-output-label"><h3>The Instagram carousel</h3><p>@itstommykate: swipe through the three slides.</p></div><WysInstagram example={e}/></div>
 <div id={`${e.slug}-output-4`} data-panel="4" class="wx-panel"><div class="wx-output-label"><h3>The blog article</h3><p>Read the full styling story, placement ideas and selected-product notes.</p></div><article class="wx-article-preview"><div class="wx-article-cover"><WysPhoto photo={e.photos[1]} treatment="double" caption={e.category}/><div><span class="wys-label">The full blog article</span><h3>{e.article.title}</h3><p>{e.article.intro}</p><a class="wys-button" href={`/lifestyle/${e.slug}`}>Open the complete styling page →</a></div></div>{e.article.sections.map((s,i)=><section class="wz-article-story"><WysPhoto photo={e.photos[[0,1,2,0][i]]} treatment={["polaroid","double","lavender","double"][i]} caption={e.photos[[0,1,2,0][i]].role}/><div><span class="wys-label">0{i+1} / The styling story</span><h4>{s.heading}</h4>{s.paragraphs.map(p=><p>{p}</p>)}</div></section>)}<p class="wx-fine">As an Amazon Associate I earn from qualifying purchases. Shopping links and Amazon lists are pending. {imageNotice}</p></article></div>
 <div id={`${e.slug}-output-5`} data-panel="5" class="wx-panel"><div class="wx-output-label"><h3>The five finds</h3><p>{e.category}: selected items and variants.</p></div><WysProductSelection example={e}/><p class="wx-fine">Styling illustrations; shopping links are pending. Check retailer photographs and measurements before buying.</p></div>
</section>
