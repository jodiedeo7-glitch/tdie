---
// Hero visual: one night's output as a Pinterest board. No phone frame.
import WysPin from './WysPin.astro';
import {liveLooks} from '../data/wys-live.js';
const [ghost, plaid] = liveLooks;
const cols = [[[ghost, 'basic'], [plaid, 'lifestyle']], [[plaid, 'basic'], [ghost, 'styled']], [[ghost, 'lifestyle'], [plaid, 'styled']]];
---
<div class="wc-night wh-board-wrap">
 <p class="wh-sticker"><span>Not a guide · It runs itself</span></p>
 <span class="wh-ex">Example: posted overnight</span>
 <div class="wh-board">{cols.map((col) => <div class="wh-board-col">{col.map(([look, role], i) => <div class="wh-pin"><WysPin look={look} role={role} sizes="(max-width:700px) 30vw, 150px" eager={i < 1}/><span class="wh-save">Save</span></div>)}</div>)}</div>
</div>
