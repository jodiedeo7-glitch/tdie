---
// The template site footer (Jodie's Etsy template), self-contained for older layouts.
import { FOOTER, SOCIAL } from "../data/site.js";
---
<footer class="tcx-foot">
 <div class="tcx-touch"><h2>Get in touch <span>questions &amp; billing</span></h2><p><a href="mailto:hello@thedigitalincomeedit.com">hello@thedigitalincomeedit.com</a></p></div>
 <div class="tcx-cols">{FOOTER.map((col) => <div><h4>{col.h}</h4>{col.links.map((l) => <a href={l.href}>{l.label}</a>)}</div>)}</div>
 <p class="tcx-soc">{SOCIAL.map((s) => <a href={s.href} rel="noopener" target="_blank">{s.label}</a>)}</p>
 <div class="tcx-copy">© 2026 The Digital Income Edit™</div>
</footer>
<style is:global>
.tcx-foot{background:#FFF0F6;color:#1A1417;font-family:Poppins,sans-serif}
.tcx-touch{text-align:center;padding:70px 20px 60px;background:radial-gradient(700px 360px at 8% 10%,#ffe6f1 0,rgba(255,230,241,0) 70%),radial-gradient(700px 360px at 92% 90%,#ffe6f1 0,rgba(255,230,241,0) 70%),#fff;border-top:2px dashed rgba(214,46,115,.5)}
.tcx-touch h2{margin:0;font:400 32px/1.2 Gilda,serif;letter-spacing:.3em;text-transform:uppercase;color:#1A1417}
.tcx-touch h2 span{display:block;font:400 70px/1.1 Allison,cursive;letter-spacing:0;text-transform:none;color:#D62E73}
.tcx-touch p{margin:12px 0 0}
.tcx-touch a{color:#D62E73}
.tcx-cols{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:30px;max-width:900px;margin:0 auto;padding:40px 24px 10px}
.tcx-cols h4{margin:0 0 12px;font:600 12px Montserrat,sans-serif;letter-spacing:.24em;text-transform:uppercase;color:#D62E73}
.tcx-cols a{display:block;margin:0 0 8px;text-decoration:none;font-size:14px;color:#1A1417}
.tcx-cols a:hover{color:#D62E73}
.tcx-soc{text-align:center;margin:20px 0 26px}
.tcx-soc a{margin:0 12px;font:600 11px Montserrat,sans-serif;letter-spacing:.2em;text-transform:uppercase;text-decoration:none;color:#1A1417}
.tcx-copy{text-align:center;padding:18px;font:500 10px Montserrat,sans-serif;letter-spacing:.24em;text-transform:uppercase;background:url(/wys-sales/img/sh-blush.webp) center/360px;border-top:1px solid #C9A86A}
@media (max-width:600px){.tcx-touch h2{font-size:22px;letter-spacing:.2em}.tcx-touch h2 span{font-size:52px}.tcx-cols{grid-template-columns:minmax(0,1fr);text-align:center;gap:18px}}
</style>
