---
import {Image} from 'astro:assets';
const {example:e}=Astro.props;
---
<div class="wz-find-selection">
 <figure class="wz-find-photo"><Image src={e.photos[0].src} alt={e.photos[0].alt} widths={[320,480,720]} sizes="(max-width:700px) 85vw, 300px"/><figcaption>Styling illustration of the five finds</figcaption></figure>
 <ol class="wz-find-list">{e.article.items.map((p,i)=><li id={`${e.slug}-find-${i}`}><span class="wz-find-number">{i+1}</span><div><h4>{p.name}</h4><p>{p.variant}</p><details><summary>Product details</summary><p>{p.note}</p></details></div></li>)}</ol>
</div>
<style>
.wz-find-selection{display:grid;grid-template-columns:minmax(0,300px) minmax(0,1fr);gap:28px;align-items:start;max-width:850px;margin:20px auto}.wz-find-photo{position:relative;margin:0;min-width:0}.wz-find-photo>img{display:block;width:100%;height:auto}.wz-find-photo figcaption{font:400 12px/1.5 Inter,sans-serif;padding:10px 0;color:#66314b}.wz-find-marker{position:absolute;transform:translate(-50%,-50%);width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#fff;color:#722449;border:1px solid #722449;font:700 12px/1 Inter,sans-serif;box-shadow:0 2px 7px #0003}.wz-find-list{list-style:none;margin:0;padding:0;display:grid;gap:15px;counter-reset:none}.wz-find-list>li{display:flex;gap:12px;margin:0;padding:0 0 14px;border-bottom:1px solid #e3cadb;scroll-margin-top:100px}.wz-find-list h4{font:600 18px/1.3 Newsreader,Georgia,serif!important;color:#952854;margin:0 0 6px!important}.wz-find-list p{font:400 14px/1.55 Inter,sans-serif!important;margin:0 0 8px!important}.wz-find-list details{font:400 12px/1.5 Inter,sans-serif}.wz-find-list summary{cursor:pointer;color:#71304f;min-height:30px}.wz-find-number{flex-shrink:0;display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:#edddf7;color:#722449;font:600 12px/1 Inter,sans-serif}.wz-find-list li:target{background:#f1e6fa}.wz-find-marker:focus-visible{outline:3px solid #722449}
@media(max-width:700px){.wz-find-selection{grid-template-columns:1fr;gap:20px}.wz-find-photo{max-width:290px;margin:auto}.wz-find-list p{font-size:16px!important}}
</style>
