---
// "One look, start to finish": three photos become three pins, a blog post
// and an Instagram carousel. Built from a live look; mockups say Example.
import {Image} from 'astro:assets';
import WysPhone from './WysPhone.astro';
import WysPin from './WysPin.astro';
import {roles} from '../data/wys-live.js';
const {look, id} = Astro.props;
const carousel = ['lifestyle', 'styled', 'basic'];
---
<div class="wc-flow" id={id}>
 <div class="wc-flow-step">
  <p class="wc-step-tag"><b>1</b> Three photos, always in this order</p>
  <div class="wc-photos">{roles.map((r) => <figure class="wc-photo">
   {r.key === 'basic' ? <WysPin look={look} role="basic" sizes="(max-width:700px) 30vw, 220px"/> : <Image src={look.photos[r.key].src} alt={look.photos[r.key].alt} widths={[240, 400, 560]} sizes="(max-width:700px) 30vw, 220px"/>}
   <figcaption><b>{r.name}</b><span>{r.note}</span></figcaption>
  </figure>)}</div>
 </div>
 <div class="wc-flow-arrow" aria-hidden="true">↓ becomes ↓</div>
 <div class="wc-flow-outputs">
  <div class="wc-out">
   <p class="wc-step-tag"><b>2</b> 3 Pinterest pins</p>
   <WysPhone app="Pinterest">
    <div class="wc-pinboard">
     <WysPin look={look} role="basic" sizes="120px"/>
     <WysPin look={look} role="styled" sizes="120px"/>
     <WysPin look={look} role="lifestyle" sizes="120px"/>
     <p class="wc-pin-link">Each pin links to the themed Amazon Idea List its products came from.</p>
    </div>
   </WysPhone>
  </div>
  <div class="wc-out">
   <p class="wc-step-tag"><b>3</b> 1 blog post</p>
   <WysPhone label="Live page" app="thedigitalincomeedit.com">
    <Image class="wc-blog-shot" src={look.blogPhone} alt={`Screenshot of the live blog post ${look.name} on a phone`} widths={[260, 520]} sizes="240px"/>
   </WysPhone>
  </div>
  <div class="wc-out">
   <p class="wc-step-tag"><b>4</b> 1 Instagram carousel</p>
   <WysPhone app="Instagram">
    <div class="wc-carousel">
     <div class="wc-carousel-track">{carousel.map((role, i) => <div class="wc-slide">{role === 'basic' ? <WysPin look={look} role="basic" sizes="240px"/> : <Image src={look.photos[role].src} alt={look.photos[role].alt} widths={[260, 520]} sizes="240px"/>}<span class="wc-slide-n">{i + 1}/3</span></div>)}</div>
     <div class="wc-dots" aria-hidden="true"><i class="on"></i><i></i><i></i></div>
     <div class="wc-order" aria-label="Carousel order: Lifestyle, then Styled, then Basic">{carousel.map((role, i) => <figure>{role === 'basic' ? <WysPin look={look} role="basic" sizes="70px"/> : <Image src={look.photos[role].src} alt="" widths={[120, 200]} sizes="70px"/>}<figcaption>{i + 1}. {roles.find((r) => r.key === role).name}</figcaption></figure>)}</div>
    </div>
   </WysPhone>
  </div>
 </div>
</div>
