---
// "One look, start to finish": three photos become three pins, a blog post
// and an Instagram carousel. Built from a live look; mockups say Example.
// No phone frames (Jodie, 10 Oct 2026).
import {Image} from 'astro:assets';
import WysPin from './WysPin.astro';
import WysIgPost from './WysIgPost.astro';
import WysBlogCard from './WysBlogCard.astro';
import {roles} from '../data/wys-live.js';
const {look, id} = Astro.props;
---
<div class="wc-flow" id={id}>
 <div class="wc-flow-step">
  <p class="wc-step-tag"><b>1</b> Three photos, always in this order</p>
  <div class="wc-photos">{roles.map((r) => <figure class="wc-photo">
   {r.key === 'basic' ? <WysPin look={look} role="basic" sizes="(max-width:700px) 30vw, 200px"/> : <Image src={look.photos[r.key].src} alt={look.photos[r.key].alt} widths={[240, 400]} sizes="(max-width:700px) 30vw, 200px"/>}
   <figcaption><b>{r.name}</b><span>{r.note}</span></figcaption>
  </figure>)}</div>
 </div>
 <div class="wc-flow-arrow" aria-hidden="true">↓ becomes ↓</div>
 <div class="wh-outs">
  <div class="wh-out wh-out-pins">
   <p class="wc-step-tag"><b>2</b> 3 Pinterest pins</p>
   <div class="wh-ex-wrap"><span class="wh-ex">Example</span>
    <div class="wh-pins">
     {['basic', 'styled', 'lifestyle'].map((r) => <div class="wh-pin"><WysPin look={look} role={r} sizes="160px"/><span class="wh-save">Save</span><span class="wh-pin-t">{look.short} · {roles.find((x) => x.key === r).name}</span></div>)}
    </div>
   </div>
   <p class="wh-out-note">Each pin links to the themed Amazon Idea List its products came from.</p>
  </div>
  <div class="wh-out wh-out-blog">
   <p class="wc-step-tag"><b>3</b> 1 blog post</p>
   <div class="wh-ex-wrap"><span class="wh-ex wh-ex-live">Live page</span><WysBlogCard look={look}/></div>
   <p class="wh-out-note"><a href={look.url} target="_blank" rel="noopener">Open the live post ↗</a></p>
  </div>
  <div class="wh-out wh-out-ig">
   <p class="wc-step-tag"><b>4</b> 1 Instagram carousel</p>
   <div class="wh-ex-wrap"><span class="wh-ex">Example</span><WysIgPost look={look}/></div>
   <p class="wh-out-note">Swipe order: Lifestyle, Styled, Basic.</p>
  </div>
 </div>
</div>
