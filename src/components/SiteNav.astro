---
// One nav for every page. Labels and order live in src/data/site.js.
// The mobile menu is a native popover: no script, keyboard and Escape work.
const {boutique=false}=Astro.props;
import {getImage} from "astro:assets";
import icingSource from "../assets/wys/pink-icing-border.png";
const icing=boutique ? await getImage({src:icingSource,format:"webp",quality:90}) : null;
import { NAV, NAV_CTA } from "../data/site.js";
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href) => path === href || path.startsWith(href + "/");
---
<header class:list={["sn",boutique && "sn-boutique"]}>
  {boutique && <div class="sn-header-icing" style={`background-image:url('${icing.src}')`} aria-hidden="true"/>}
  <div class="sn-in">
    {boutique && <nav class="sn-masthead-utility" aria-label="Browse TDIE"><a href="/">Home</a><a href="/lifestyle">Lifestyle</a></nav>}
    <a class="sn-logo" href="/">{boutique && <span class="sn-brand-sparkle" aria-hidden="true">✦</span>}The Digital Income <span>Edit™</span>{boutique && <span class="sn-brand-sparkle" aria-hidden="true">✦</span>}</a>
    {boutique && <a class="sn-masthead-note" href="/newsletter">The Weekly Edit →</a>}
    <nav class="sn-links" aria-label="Main">
      {NAV.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
      <a class="sn-cta" href={NAV_CTA.href} aria-current={isCurrent(NAV_CTA.href) ? "page" : undefined}>{NAV_CTA.label}</a>
    </nav>
    <button class="sn-menu" type="button" popovertarget="sn-drawer" aria-label="Open menu">Menu</button>
  </div>
</header>
<div id="sn-drawer" class="sn-drawer" popover>
  <button class="sn-close" type="button" popovertarget="sn-drawer" popovertargetaction="hide" aria-label="Close menu">Close</button>
  <nav aria-label="Mobile">
    <a href="/">Home</a>
    {NAV.map((l) => <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>{l.label}</a>)}
    <a class="sn-d-cta" href={NAV_CTA.href}>{NAV_CTA.label}</a>
  </nav>
</div>

<style>
  .sn{position:sticky;top:0;z-index:60;background:#FBF8F5;border-bottom:1px solid rgba(200,169,106,.45)}
  .sn-in{max-width:1240px;margin:0 auto;padding:0 clamp(16px,4vw,40px);min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px}
  .sn-logo{font-family:"Newsreader",Georgia,serif;font-weight:600;font-size:21px;line-height:1.2;letter-spacing:-.01em;color:#1A1417;display:inline-block;padding:11px 0;white-space:nowrap}
  .sn-logo span{color:#B8245F;margin-left:.25em}
  .sn-links{display:flex;align-items:center;gap:24px}
  .sn-links a{font-family:"Inter",system-ui,sans-serif;font-size:12.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:#4A3F44;
    display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid transparent;transition:color .2s,border-color .2s}
  .sn-links a:hover{color:#B8245F}
  .sn-links a[aria-current="page"]{color:#1A1417;border-bottom-color:#D62E73}
  .sn-links a.sn-cta{padding:0 18px;border-radius:0;background:#1A1417;color:#fff;border:1px solid #1A1417;letter-spacing:.1em}
  .sn-links a.sn-cta:hover,.sn-links a.sn-cta[aria-current="page"]{background:#D62E73;border-color:#D62E73;color:#fff}
  .sn-menu,.sn-close{display:none;min-width:44px;min-height:44px;padding:0 16px;border-radius:0;border:1px solid rgba(26,20,23,.25);background:transparent;
    font:600 12px/1 "Inter",system-ui,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:#1A1417;cursor:pointer}
  .sn-drawer{margin:0;inset:0;width:100%;max-width:none;height:100%;max-height:none;border:0;padding:84px 24px 32px;background:#FBF8F5;color:#1A1417}
  .sn-drawer::backdrop{background:rgba(26,20,23,.35)}
  .sn-drawer .sn-close{display:inline-flex;align-items:center;position:absolute;top:12px;right:16px}
  .sn-drawer a{display:flex;align-items:center;min-height:58px;font-family:"Newsreader",Georgia,serif;font-weight:600;font-size:30px;color:#1A1417;border-bottom:1px solid rgba(200,169,106,.4)}
  .sn-drawer a[aria-current="page"]{color:#B8245F}
  .sn-drawer a.sn-d-cta{margin-top:24px;justify-content:center;border:0;border-radius:0;background:#D62E73;color:#fff;font-family:"Inter",system-ui,sans-serif;font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .sn a:focus-visible,.sn button:focus-visible,.sn-drawer a:focus-visible,.sn-drawer button:focus-visible{outline:3px solid #D62E73;outline-offset:3px}
  @media(max-width:1020px){.sn-links{display:none}.sn-menu{display:inline-flex;align-items:center}}
  @media(max-width:480px){.sn-in{gap:12px}.sn-logo{font-size:clamp(16px,4.8vw,19px)}.sn-menu{flex-shrink:0;padding:0 12px}}
  @media(prefers-reduced-motion:reduce){.sn-links a{transition:none}}

  /* A centered boutique masthead and a separate lavender navigation ribbon. */
  .sn.sn-boutique{position:relative;background:radial-gradient(ellipse at 50% 0,#fffafd,#ffe8f3);border-top:5px solid #ef8bb9;border-bottom:5px double #dc91b6;box-shadow:0 5px 16px #b8245f12}
  .sn-boutique .sn-in{display:grid;grid-template-columns:1fr minmax(0,3fr) 1fr;gap:0;padding:20px 30px 0;max-width:1240px;position:relative}
  .sn-boutique .sn-logo{grid-column:2;text-align:center;font-size:38px;padding:15px 0 24px;white-space:normal;line-height:1.1;color:#872049}
  .sn-boutique .sn-logo span{color:#d62e73;display:block;margin:2px 0 0}
  .sn-masthead-flower{width:67px;justify-self:center;transform:rotate(-15deg);filter:drop-shadow(0 5px 3px #b8245f20)}
  .sn-masthead-flower :global(svg){width:100%;height:auto}
  .sn-masthead-note{text-align:center;font:500 11px/1.6 Inter,sans-serif;color:#872049;letter-spacing:.03em}
  .sn-boutique .sn-links{display:flex;grid-column:1/-1;justify-content:center;gap:30px;background:#ead8f8;border-top:1px solid #cba7de;padding:5px 22px;margin:0 -30px;position:relative}
  .sn-boutique .sn-links a{font-size:11px;letter-spacing:.06em;min-height:48px;color:#872049}
  .sn-boutique .sn-links a.sn-cta{border-radius:99px;background:#b8245f;border-color:#b8245f;color:#fff;min-height:42px;padding:0 20px}
  @media(max-width:1020px){.sn-boutique .sn-in{padding:12px 18px;grid-template-columns:50px minmax(0,1fr) 65px;gap:12px}.sn-boutique .sn-logo{font-size:30px;padding:12px 0}.sn-boutique .sn-links,.sn-boutique .sn-masthead-note{display:none}.sn-boutique .sn-menu{grid-column:3;grid-row:1;padding:0 10px;min-height:48px;border-radius:99px;background:#f1ddfa;border-color:#ba96d2;letter-spacing:.03em}.sn-masthead-flower{width:45px}}
  @media(max-width:480px){.sn-boutique .sn-in{padding:10px 12px;grid-template-columns:32px minmax(0,1fr) 55px;gap:8px}.sn-boutique .sn-logo{font-size:25px}.sn-masthead-flower{width:34px}.sn-boutique .sn-menu{padding:0 7px;font-size:10px}}

  /* Compact boutique header: utility links, centered wordmark, full-width pink nav. */
  .sn.sn-boutique{background:#fff9fd;border-top:3px solid #ee91bc;border-bottom:1px solid #da8bb2;box-shadow:0 4px 12px #b8245f10;isolation:isolate}
  .sn.sn-boutique:after{content:'';position:absolute;inset:auto 0 0;height:56px;background:#ffbfdc;border-top:1px solid #e59fc0;z-index:-1}
  .sn-boutique .sn-in{padding:0 24px;grid-template-columns:1fr minmax(0,2.5fr) 1fr}
  .sn-boutique .sn-logo{font-size:28px;padding:17px 0 15px;line-height:1.2;color:#872049;white-space:nowrap}.sn-boutique .sn-logo span{display:inline;margin-left:.15em;color:#d62e73}
  .sn-masthead-utility{display:flex;align-items:center;gap:18px}.sn-masthead-utility a,.sn-boutique .sn-masthead-note{font:500 11px/1.5 Inter,sans-serif;color:#872049;min-height:48px;display:flex;align-items:center}.sn-boutique .sn-masthead-note{justify-content:end;letter-spacing:0}
  .sn-boutique .sn-links{margin:0 -24px;padding:4px 20px;background:transparent;border-top:0;gap:34px;min-height:56px}.sn-boutique .sn-links a.sn-cta{min-height:40px;box-shadow:0 2px 0 #9d2356}
  @media(max-width:1020px){.sn.sn-boutique:after{display:none}.sn-boutique .sn-in{padding:6px 16px;grid-template-columns:minmax(0,1fr) 64px;gap:12px}.sn-boutique .sn-logo{grid-column:1;text-align:left;font-size:25px;padding:14px 0;white-space:normal}.sn-boutique .sn-masthead-utility,.sn-boutique .sn-masthead-note{display:none}.sn-boutique .sn-menu{grid-column:2;background:#ffe1ef;border-color:#db98b9}.sn-boutique .sn-links{display:none}}
  @media(max-width:480px){.sn-boutique .sn-logo{font-size:21px;line-height:1.2}.sn-boutique .sn-in{padding:5px 14px;grid-template-columns:minmax(0,1fr) 55px;gap:10px}.sn-boutique .sn-logo span{white-space:nowrap}}
  /* Icing belongs to the masthead. Preserve the artwork’s native 3:1 ratio. */
  .sn.sn-boutique{padding-top:140px;border-top:0;background:#fff1f8}
  .sn-header-icing{position:absolute;inset:0 0 auto;height:140px;background-repeat:repeat-x;background-size:420px 140px;background-position:-55px top;pointer-events:none}
  @media(max-width:700px){.sn.sn-boutique{padding-top:100px}.sn-header-icing{height:100px;background-size:300px 100px;background-position:-25px top}}
  /* Boutique brand lockup and ribbon form one decorated header. */
  .sn.sn-boutique{background:linear-gradient(115deg,#ffdced,#fff4fb 48%,#ead8f8);padding-top:110px;border-bottom:4px double #d98eb6}
  .sn-header-icing{height:110px;background-size:330px 110px}
  .sn-boutique .sn-in{max-width:1320px}
  .sn-boutique .sn-logo{font-size:32px;display:flex;align-items:center;justify-content:center;gap:7px;padding:16px 24px;margin:10px 0 15px;background:#fff8fd;border:4px double #e592bd;border-radius:60px;box-shadow:0 4px 0 #cfafe4,0 8px 14px #b8245f12}
  .sn-boutique .sn-logo span{margin:0}.sn-boutique .sn-logo .sn-brand-sparkle{font-family:Inter,sans-serif;font-size:22px;color:#b392ca;text-shadow:1px 1px #fff;margin:0 8px}
  .sn.sn-boutique:after{height:58px;background:linear-gradient(90deg,#f0dffa,#e4cdf5,#f0dffa);border-top:4px double #d19abe}
  .sn-boutique .sn-links{min-height:58px;gap:30px}.sn-boutique .sn-links a{font-size:11px;font-weight:600}
  @media(max-width:1020px){.sn-boutique .sn-in{grid-template-columns:minmax(0,1fr) 64px;gap:16px}.sn-boutique .sn-logo{font-size:27px;white-space:nowrap;margin:10px 0 16px;padding:15px 12px}.sn-boutique .sn-logo .sn-brand-sparkle{margin:0 4px}.sn-boutique .sn-menu{background:#ead8f8;box-shadow:0 3px 0 #d998bc}}
  @media(max-width:700px){.sn.sn-boutique{padding-top:95px}.sn-header-icing{height:95px;background-size:285px 95px}.sn-boutique .sn-logo{font-size:23px;gap:4px}.sn-boutique .sn-logo .sn-brand-sparkle{display:none}}
  @media(max-width:480px){.sn-boutique .sn-in{padding:5px 10px;gap:8px;grid-template-columns:minmax(0,1fr) 52px}.sn-boutique .sn-logo{font-size:clamp(16px,4.7vw,20px);padding:12px 6px}.sn-boutique .sn-menu{font-size:9px;min-height:48px}}
</style>
