---
// src/components/FreebieForm.astro
// MailerLite embedded capture form, styled to the brand.
// One form (account 2532349, form 193994333796435364) → all freebies capture
// into one list for now (Option 1). To segment per-pillar later, swap the
// action URL for a pillar-specific form ID — one line per page.
//
// Props:
//   heading  - the capture headline (e.g. "Get the AI Starter Kit")
//   button   - submit button label (e.g. "Send Me the Kit")
const { heading = "Get the free guide", button = "Send It to Me" } = Astro.props;
const ACTION = "https://assets.mailerlite.com/jsonp/2532349/forms/193994333796435364/subscribe";
---

<div class="freebie-capture">
  <form class="fc-form" action={ACTION} method="post" target="_blank">
    <h2 class="fc-h">{heading}</h2>
    <p class="fc-sub">Drop your email — it lands in your inbox in a minute. No spam, unsubscribe anytime.</p>
    <div class="fc-row">
      <input
        type="email"
        name="fields[email]"
        placeholder="your@email.com"
        aria-label="Email"
        required
        autocomplete="email"
      />
      <button type="submit">{button}</button>
    </div>
    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />
  </form>
</div>

<style>
  .freebie-capture {
    background: var(--white);
    border: 1px solid rgba(43,22,27,.13);
    border-top: 2px solid var(--pink);
    border-radius:2px;
    padding: 32px;
    margin: 40px 0;
  }
  .fc-h {
    font-weight: 400;
    font-family: 'Fraunces', serif;
    font-size: 24px;
    margin: 0 0 6px 0;
    color: var(--choc);
  }
  .fc-sub {
    font-size: 14px;
    color: var(--choc-meta);
    margin: 0 0 18px 0;
  }
  .fc-row { display: flex; gap: 10px; flex-wrap: wrap; }
  .fc-row input {
    flex: 1 1 240px;
    padding: 13px 16px;
    border: 1px solid var(--gray);
    border-radius:2px;
    font-size: 15px;
    font-family: inherit;
    background: #fff;
  }
  .fc-row input:focus { outline: 2px solid var(--pink); outline-offset: 1px; }
  .fc-row button {
    padding: 13px 26px;
    background: var(--pink);
    color: #fff;
    border: none;
    border-radius:2px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.15s;
  }
  .fc-row button:hover { background: var(--pink-deep); }
</style>
