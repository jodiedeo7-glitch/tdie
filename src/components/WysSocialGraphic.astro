---
import {Image} from 'astro:assets';
const {photo,title,example,index=0,format='slide'}=Astro.props;
---
<div class={`wz-social-graphic wz-social-${format} wz-social-variant-${index}`} aria-label={`${example}: ${title}`}>
 <div class="wz-social-brand">The Digital Income Edit™</div>
 <h4>{title}</h4>
 <p>{example}</p>
 <div class="wz-social-photo"><Image src={photo.src} alt={photo.alt} widths={[240,360,540,810]} sizes="(max-width:700px) 35vw, 300px"/></div>
 <div class="wz-social-foot"><span>{['The finds','The styled setting','With Tommy Kate'][index]}</span><span>{index+1} / 3</span></div>
</div>
<style>
.wz-social-graphic{position:relative;display:flex;flex-direction:column;aspect-ratio:4/5;width:100%;min-width:0;overflow:hidden;background:#ffe2ef;padding:4%;color:#932650;container-type:inline-size;box-sizing:border-box}
.wz-social-pin{aspect-ratio:2/3}.wz-social-brand{text-align:center;font:600 1.8cqw/1.2 Jost,sans-serif;letter-spacing:.18em;text-transform:uppercase;padding:1% 0 2%}.wz-social-graphic h4{font:600 6.2cqw/1.08 Gloock,Georgia,serif!important;letter-spacing:0!important;color:#ae245d!important;text-align:center;margin:0 0 2%!important;text-transform:none!important}.wz-social-graphic>p{font:500 2.2cqw/1.3 Jost,sans-serif!important;text-align:center;color:#462434!important;margin:0 0 3%!important}.wz-social-photo{flex:1;min-height:0;display:flex;justify-content:center;align-items:center;background:#fff8fc;padding:3%}.wz-social-photo img{display:block;height:100%;max-width:100%;width:auto;object-fit:contain}.wz-social-foot{display:flex;justify-content:space-between;gap:5%;padding-top:2%;font:500 1.8cqw/1.3 Jost,sans-serif;color:#462434}.wz-social-variant-1{background:#eee1fa}.wz-social-variant-1 .wz-social-photo{border-radius:18% 18% 0 0}.wz-social-variant-2{background:#ffd0e4}.wz-social-variant-2 .wz-social-photo{background:#fff}.wz-social-pin .wz-social-brand{padding-bottom:4%}.wz-social-pin h4{font-size:7cqw!important}.wz-social-pin .wz-social-photo{margin-top:2%}
</style>
