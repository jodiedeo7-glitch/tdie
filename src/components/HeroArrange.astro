---
// Arrange mode for the homepage hero promo. Only active with ?arrange in the URL.
// Jodie drags/resizes the Storefront polaroid, then copies the numbers to Claude.
---
<script is:inline>
(function(){
 if(!/[?&]arrange\b/.test(location.search))return;
 function go(){
  var hero=document.querySelector('.hero-v10'),pol=hero&&hero.querySelector('.hx-pol');if(!pol)return;
  pol.addEventListener('click',function(e){e.preventDefault()},true);
  pol.style.setProperty('cursor','move','important');pol.style.setProperty('touch-action','none');pol.style.setProperty('outline','3px dashed #D62E73','important');pol.style.setProperty('outline-offset','6px','important');
  var h=document.createElement('div');h.title='Drag to resize';document.body.style.userSelect='none';
  h.style.cssText='position:absolute;right:-18px;top:-18px;width:34px;height:34px;border-radius:50%;background:#D62E73;border:3px solid #fff;box-shadow:0 2px 8px rgba(0,0,0,.35);cursor:nwse-resize;z-index:20;touch-action:none';
  pol.appendChild(h);
  var panel=document.createElement('div');
  panel.style.cssText='position:fixed;left:50%;top:14px;transform:translateX(-50%);z-index:99999;background:#fff;border:2px solid #D62E73;border-radius:16px;padding:14px 18px;font:500 15px/1.4 Jost,sans-serif;color:#1A1417;box-shadow:0 18px 40px rgba(90,0,40,.35);display:flex;gap:14px;align-items:center;max-width:94vw;flex-wrap:wrap';
  panel.innerHTML='<b style="color:#D62E73">Arrange mode</b><span>Drag the promo to move it. Drag the pink dot (top corner) to resize.</span><span id="arr-val" style="font-weight:700"></span><button id="arr-copy" style="font:700 14px Jost,sans-serif;padding:10px 16px;border-radius:12px;border:1.5px solid #D62E73;background:#fff;color:#D62E73;cursor:pointer">Copy position</button>';
  document.body.appendChild(panel);
  var val=panel.querySelector('#arr-val');
  function rect(){var hr=hero.getBoundingClientRect(),pr=pol.getBoundingClientRect();return {hr:hr,pr:pr}}
  function setPos(l,t,w){pol.style.setProperty('left',l+'px','important');pol.style.setProperty('top',t+'px','important');pol.style.setProperty('bottom','auto','important');if(w)pol.style.setProperty('width',w+'px','important');show()}
  function show(){var hw=hero.clientWidth;var l=parseFloat(getComputedStyle(pol).left),t=parseFloat(getComputedStyle(pol).top),w=pol.offsetWidth;
   val.textContent='left '+(l/hw*100).toFixed(1)+'% · top '+Math.round(t)+'px · width '+(w/hw*100).toFixed(1)+'% (screen '+hw+'px)';}
  var mode=null,sx,sy,sl,st,sw;
  function down(e,m){mode=m;sx=e.clientX;sy=e.clientY;sl=parseFloat(getComputedStyle(pol).left);st=parseFloat(getComputedStyle(pol).top);sw=pol.offsetWidth;e.preventDefault();e.stopPropagation();(e.target.setPointerCapture&&e.target.setPointerCapture(e.pointerId))}
  pol.addEventListener('pointerdown',function(e){if(e.target===h)return;down(e,'move')});
  h.addEventListener('pointerdown',function(e){down(e,'size')});
  window.addEventListener('pointermove',function(e){if(!mode)return;var dx=e.clientX-sx,dy=e.clientY-sy;
   if(mode==='move')setPos(sl+dx,st+dy);else setPos(sl,st-(Math.max(140,sw+dx)-sw)*0.6,Math.max(140,sw+dx));});
  window.addEventListener('pointerup',function(){mode=null});
  panel.querySelector('#arr-copy').onclick=function(){var t='Hero promo position: '+val.textContent;(navigator.clipboard?navigator.clipboard.writeText(t):Promise.reject()).then(function(){panel.querySelector('#arr-copy').textContent='Copied! Paste it to Claude'},function(){prompt('Copy this and paste it to Claude:',t)})};
  show();
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',go);else go();
})();
</script>
