---
import {Image} from 'astro:assets';
import WysDecor from './WysDecor.astro';
import {packages} from '../data/wys-packages.js';
---
<section class="wz-hero-band">
 <header class="wys-wrap wz-hero wz-hero-two-looks">
  <div class="wz-polaroid-stack wz-stack-pink" aria-label="Pretty Wicked: all three styling views">{packages[0].photos.map((p,i)=><figure class={`wz-polaroid wz-polaroid-${i}`}><div class="wz-polaroid-mat"><Image src={p.src} alt={p.alt} widths={[240,360,540]} sizes="(max-width:700px) 35vw, 210px" loading="eager"/></div></figure>)}<WysDecor class="wz-stack-flower"/></div>
  <div class="wz-hero-copy"><slot/></div>
  <div class="wz-polaroid-stack wz-stack-lavender" aria-label="Ghoul Fuel: all three styling views">{packages[1].photos.map((p,i)=><figure class={`wz-polaroid wz-polaroid-${i}`}><div class="wz-polaroid-mat"><Image src={p.src} alt={p.alt} widths={[240,360,540]} sizes="(max-width:700px) 35vw, 210px" loading="eager"/></div></figure>)}</div>
 </header>
</section>
