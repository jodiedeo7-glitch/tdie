---
// The Keep It Running Kit bonus (Decision 105). Shows until the deadline, then disappears on its own:
// hidden at build time after the deadline, and removed in the browser the moment the deadline passes.
// Without JavaScript the browser cannot check the clock, so no-script visitors never see it:
// an expired deadline must never be shown, even if the site is not rebuilt after the date.
import { KIT_DEADLINE as DEADLINE, kitLive } from "../we-kit.js";
export interface Props {
  variant?: "hero" | "inline";
}
const { variant = "inline" } = Astro.props;
const live = kitLive();
---

{live && (
  <div class={`kb kb-${variant}`} data-kit-deadline={DEADLINE}>
    <span class="kb-eyebrow">Free bonus · until Sunday, October 4, 11:59 pm Eastern</span>
    <p class="kb-line"><strong>The Keep It Running Kit</strong> comes free with it: six of my paid guides, $63 worth.</p>
    <p class="kb-list">The Operating Prompts™ · The First 30 Days After Your Site Goes Live · How I Batch &amp; Schedule a Month of Pinterest in One 3-Hour Block · Build Your First Freebie in One Afternoon · My Exact $0-to-First-Sale Path · My 5-Minute Canva Pin Template Swap</p>
    <p class="kb-note">In your access email, usually within an hour of purchase, on one payment or three.</p>
  </div>
)}

{live && (
  <noscript set:html={"<style>[data-kit-deadline]{display:none!important}</style>"} />
)}

<script>
  document.querySelectorAll("[data-kit-deadline]").forEach((el) => {
    const end = Date.parse(el.getAttribute("data-kit-deadline") || "");
    if (Date.now() > end) el.remove();
  });
</script>

<style>
  /* A coupon: dashed edge, ticket notches, tilted "free" sticker. */
  .kb{position:relative;border:2px dashed rgba(214,46,115,.55);border-radius:18px;
      background:linear-gradient(135deg,rgba(255,138,194,.18),rgba(255,253,252,.92) 55%);
      padding:20px 24px 20px 26px;margin:0 0 22px;text-align:left;
      box-shadow:0 24px 40px -30px rgba(214,46,115,.6)}
  .kb::before,.kb::after{content:"";position:absolute;top:50%;width:22px;height:22px;margin-top:-11px;border-radius:50%;
      background:var(--cream,#FBF8F5);border:2px dashed rgba(214,46,115,.55)}
  .kb::before{left:-13px;clip-path:inset(0 0 0 50%)}
  .kb::after{right:-13px;clip-path:inset(0 50% 0 0)}
  .kb-hero{max-width:640px;margin:0 auto 22px}
  .kb-eyebrow{display:inline-block;font-family:Inter,sans-serif;font-weight:800;
              font-size:12px;letter-spacing:1.4px;text-transform:uppercase;
              color:#fff;background:var(--pink);padding:6px 11px;border-radius:999px;transform:rotate(-2deg);margin-bottom:10px}
  .kb-line{font-size:16px;line-height:1.6;color:#1A1417;margin:0 0 6px}
  .kb-line strong{font-family:Newsreader,serif;font-size:21px;font-weight:600;color:var(--pink)}
  .kb-list{font-size:14px;line-height:1.65;color:#4A3F44;margin:0 0 6px}
  .kb-note{font-size:14px;line-height:1.6;color:#1A1417;font-weight:600;margin:0}
</style>
