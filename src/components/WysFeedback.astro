---
// Box on every page of the private buyer website: report something weird, or send Jodie a set you love.
// Sends to /api/wys-feedback.
const {page = ''} = Astro.props;
---
<section class="wb2-sec wbf" id="tell-jodie" aria-labelledby="wbf-h">
 <div class="wys-wrap">
  <div class="wbf-card">
   <p class="wb2-kicker">Tell Jodie</p>
   <h2 id="wbf-h">Send it straight to me</h2>
   <form class="wbf-form" data-page={page} novalidate>
    <fieldset class="wbf-kind">
     <legend class="wbf-vh">What are you sending?</legend>
     <label><input type="radio" name="kind" value="feedback" checked><span>Something looks weird</span></label>
     <label><input type="radio" name="kind" value="love"><span>A set I love</span></label>
    </fieldset>
    <p class="wbf-lede" data-for="feedback">Type it out, add a screenshot if you have one, and it comes straight to me. Nothing is too small.</p>
    <p class="wbf-lede" data-for="love" hidden>Made a set you're obsessed with? Send me the photos. I'd love to see what yours is making.</p>
    <label class="wbf-hp" aria-hidden="true">Leave this empty<input name="hp" tabindex="-1" autocomplete="off"></label>
    <div class="wbf-row">
     <label><b>Your name <span>(optional)</span></b><input name="name" autocomplete="name" maxlength="80"></label>
     <label><b>Your email <span>(so I can reply)</span></b><input name="email" type="email" autocomplete="email" maxlength="200"></label>
    </div>
    <label><b data-for="feedback">What happened?</b><b data-for="love" hidden>What do you love about it? <span>(optional)</span></b><textarea name="message" rows="4" maxlength="5000" placeholder="What you did, what came back, and what you expected instead"></textarea></label>
    <label class="wbf-file"><b><span data-for="feedback">Add photos or screenshots <span>(optional, up to 3)</span></span><span data-for="love" hidden>Add the photos <span>(up to 3)</span></span></b><input name="photo" type="file" accept="image/*" multiple></label>
    <div class="wbf-previews" hidden></div>
    <div class="wbf-love" data-for="love" hidden>
     <label class="wbf-check"><input type="checkbox" name="consent"><span>Jodie can share these photos as real results, on her website and her social posts.</span></label>
     <label><b>How should I credit you? <span>(optional, like your Instagram or storefront)</span></b><input name="credit" maxlength="200"></label>
    </div>
    <button class="wb2-btn wbf-send" type="submit">Send it to Jodie <span class="arr" aria-hidden="true">→</span></button>
    <p class="wbf-status" role="status" aria-live="polite"></p>
   </form>
  </div>
 </div>
</section>
<style is:global>
 .wbf-card{max-width:760px;margin:0 auto;padding:22px 20px;border:1.5px solid var(--wys-pink);border-radius:18px;background:#fff}
 .wys-world .wbf h2{font-size:28px;margin:0 0 12px}
 .wbf-lede{margin:0;font-size:16px;max-width:60ch}
 .wbf [hidden]{display:none!important}
 .wbf-vh{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
 .wbf-kind{display:flex;flex-wrap:wrap;gap:8px;border:0;margin:0;padding:0}
 .wbf-kind label{position:relative;display:inline-flex;cursor:pointer}
 .wbf-kind input{position:absolute;opacity:0;width:1px;height:1px}
 .wbf-kind span{display:inline-flex;align-items:center;min-height:44px;padding:0 18px;border:1px solid #D9B9CB;border-radius:999px;background:#fff;font:600 15px/1.2 Jost,sans-serif;color:var(--wys-ink)}
 .wbf-kind input:checked+span{border-color:#B8245F;background:#FFE8F2;color:#8A1D4A;box-shadow:inset 0 0 0 1px #B8245F}
 .wbf-kind input:focus-visible+span{outline:3px solid #C4AFE4;outline-offset:2px}
 .wbf-form{display:grid;gap:12px}
 .wbf-form label{display:grid;gap:6px;font:600 14px/1.3 Jost,sans-serif;color:var(--wys-ink)}
 .wbf-form label b{font-weight:600}.wbf-form label b span span,.wbf-form label b>span:not([data-for]){font-weight:400;color:#7a5a6c}
 .wbf-form input:not([type=checkbox]):not([type=radio]),.wbf-form textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid #E9B4CF;border-radius:12px;font:400 16px/1.4 Jost,sans-serif;background:#fff;color:var(--wys-ink)}
 .wbf-form input:focus,.wbf-form textarea:focus{outline:3px solid #C4AFE4;outline-offset:1px}
 .wbf-form input[type=file]{padding:10px;border-style:dashed}
 .wbf-row{display:grid;gap:12px}
 @media (min-width:640px){.wbf-row{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}}
 .wbf-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
 .wbf-previews{display:flex;flex-wrap:wrap;gap:10px}
 .wbf-previews img{max-width:150px;max-height:200px;width:auto;height:auto;border-radius:10px;border:1px solid #E9B4CF}
 .wbf-love{display:grid;gap:12px}
 .wbf-form .wbf-check{display:flex;gap:10px;align-items:flex-start;font-weight:400;font-size:15px;line-height:1.45}
 .wbf-check input{margin-top:3px;width:18px;height:18px;flex:none;accent-color:#B8245F}
 .wbf .wbf-form .wbf-send{appearance:none;justify-self:start;border:1.5px solid var(--wys-pink)!important;border-radius:999px!important;background:#fff!important;color:var(--wys-ink)!important;padding:0 22px!important;min-height:48px;font:700 15px/1.2 Jost,sans-serif!important;box-shadow:none!important}
 .wbf .wbf-form .wbf-send:hover{background:#FFF5FA!important}.wbf .wbf-send:disabled{opacity:.6;cursor:wait}
 .wbf-status{margin:0;font-size:15px;min-height:1.4em}
 .wbf-status.ok{color:#1d7a4b}.wbf-status.err{color:#b3261e}
</style>
<script>
 const MAX_SIDE = 1600, MAX_PHOTOS = 3;
 function shrink(file){
  return new Promise((resolve,reject)=>{
   const img=new Image(),url=URL.createObjectURL(file);
   img.onload=()=>{let w=img.naturalWidth,h=img.naturalHeight;const s=Math.min(1,MAX_SIDE/Math.max(w,h));w=Math.round(w*s);h=Math.round(h*s);
    const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,w,h);x.drawImage(img,0,0,w,h);URL.revokeObjectURL(url);
    let q=0.85,d=c.toDataURL('image/jpeg',q);while(d.length>1700000&&q>0.4){q-=0.15;d=c.toDataURL('image/jpeg',q);}resolve(d);};
   img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('One of those files isn\'t a photo I can read.'));};img.src=url;});
 }
 document.querySelectorAll('.wbf-form').forEach(form=>{
  const status=form.querySelector('.wbf-status'),btn=form.querySelector('.wbf-send'),fileIn=form.querySelector('input[type=file]'),prev=form.querySelector('.wbf-previews'),ta=form.querySelector('textarea');
  let photos=[];
  const kind=()=>form.querySelector('[name=kind]:checked').value;
  const setKind=()=>{const k=kind();form.querySelectorAll('[data-for]').forEach(el=>{el.hidden=el.dataset.for!==k;});
   ta.placeholder=k==='love'?'The look, the photo, the pin, whatever made you smile':'What you did, what came back, and what you expected instead';status.textContent='';status.className='wbf-status';};
  form.querySelectorAll('[name=kind]').forEach(r=>r.addEventListener('change',setKind));
  try{const saved=JSON.parse(localStorage.getItem('wys-feedback-who')||'{}');if(saved.name)form.name.value=saved.name;if(saved.email)form.email.value=saved.email;if(saved.credit)form.credit.value=saved.credit;}catch{}
  fileIn.addEventListener('change',async()=>{photos=[];prev.innerHTML='';prev.hidden=true;
   const files=[...(fileIn.files||[])];if(!files.length)return;
   if(files.length>MAX_PHOTOS){status.textContent=`Only the first ${MAX_PHOTOS} photos will be sent.`;status.className='wbf-status';}
   try{for(const f of files.slice(0,MAX_PHOTOS)){const d=await shrink(f);photos.push(d);const im=document.createElement('img');im.src=d;im.alt='Your photo';prev.appendChild(im);}prev.hidden=false;}
   catch(e){photos=[];prev.innerHTML='';status.textContent=e.message;status.className='wbf-status err';fileIn.value='';}});
  form.addEventListener('submit',async e=>{e.preventDefault();
   const k=kind(),message=ta.value.trim();
   if(k==='love'&&!photos.length){status.textContent='Add at least one photo from the set you love.';status.className='wbf-status err';return;}
   if(!message&&!photos.length){status.textContent='Type a message or add a photo first.';status.className='wbf-status err';return;}
   btn.disabled=true;status.textContent='Sending…';status.className='wbf-status';
   try{try{localStorage.setItem('wys-feedback-who',JSON.stringify({name:form.name.value.trim(),email:form.email.value.trim(),credit:form.credit.value.trim()}));}catch{}
    const r=await fetch('/api/wys-feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({hp:form.hp.value,kind:k,name:form.name.value,email:form.email.value,message,page:form.dataset.page||location.pathname,consent:k==='love'&&form.consent.checked,credit:k==='love'?form.credit.value:'',photos:photos.map((d,i)=>({data:d,type:'image/jpeg',name:`photo-${i+1}.jpg`}))})});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||'That didn\'t send. Try again, or email hello@thedigitalincomeedit.com.');
    status.textContent=k==='love'?'Sent! Thank you, I can\'t wait to see it.':'Got it, thank you! It\'s on its way to me now.';status.className='wbf-status ok';
    ta.value='';fileIn.value='';photos=[];prev.innerHTML='';prev.hidden=true;form.consent.checked=false;
   }catch(err){status.textContent=err.message;status.className='wbf-status err';}
   finally{btn.disabled=false;}});
  setKind();
 });
</script>
