---
// Feedback box on every page of the private buyer website. Sends to /api/wys-feedback.
const {page = ''} = Astro.props;
---
<section class="wb2-sec wbf" id="tell-jodie" aria-labelledby="wbf-h">
 <div class="wys-wrap">
  <div class="wbf-card">
   <p class="wb2-kicker">Tell Jodie</p>
   <h2 id="wbf-h">Something look weird?</h2>
   <p class="wbf-lede">Type it out, add a screenshot if you have one, and it comes straight to me. Nothing is too small.</p>
   <form class="wbf-form" data-page={page} novalidate>
    <label class="wbf-hp" aria-hidden="true">Leave this empty<input name="hp" tabindex="-1" autocomplete="off"></label>
    <div class="wbf-row">
     <label>Your name <span>(optional)</span><input name="name" autocomplete="name" maxlength="80"></label>
     <label>Your email <span>(so I can reply)</span><input name="email" type="email" autocomplete="email" maxlength="200"></label>
    </div>
    <label>What happened?<textarea name="message" rows="5" maxlength="5000" placeholder="What you did, what came back, and what you expected instead"></textarea></label>
    <label class="wbf-file">Add a photo or screenshot <span>(optional)</span><input name="photo" type="file" accept="image/*"></label>
    <img class="wbf-preview" alt="Your photo" hidden>
    <button class="wb2-btn" type="submit">Send it to Jodie <span class="arr" aria-hidden="true">→</span></button>
    <p class="wbf-status" role="status" aria-live="polite"></p>
   </form>
  </div>
 </div>
</section>
<style>
 .wbf-card{padding:22px 20px;border:1.5px solid var(--wys-pink);border-radius:18px;background:#fff}
 .wys-world .wbf h2{font-size:28px;margin:0 0 6px}
 .wbf-lede{margin:0 0 14px;font-size:16px;max-width:60ch}
 .wbf-form{display:grid;gap:12px}
 .wbf-form label{display:grid;gap:6px;font:600 14px/1.3 Jost,sans-serif;color:var(--wys-ink)}
 .wbf-form label span{font-weight:400;color:#7a5a6c}
 .wbf-form input,.wbf-form textarea{width:100%;box-sizing:border-box;padding:12px 14px;border:1px solid #E9B4CF;border-radius:12px;font:400 16px/1.4 Jost,sans-serif;background:#fff;color:var(--wys-ink)}
 .wbf-form input:focus,.wbf-form textarea:focus{outline:3px solid #C4AFE4;outline-offset:1px}
 .wbf-form input[type=file]{padding:10px;border-style:dashed}
 .wbf-row{display:grid;gap:12px}
 @media (min-width:640px){.wbf-row{grid-template-columns:1fr 1fr}}
 .wbf-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
 .wbf-preview{max-width:220px;max-height:220px;width:auto;height:auto;border-radius:12px;border:1px solid #E9B4CF}
 .wbf-form .wb2-btn{justify-self:start}
 .wbf-status{margin:0;font-size:15px;min-height:1.4em}
 .wbf-status.ok{color:#1d7a4b}.wbf-status.err{color:#b3261e}
</style>
<script>
 const MAX_SIDE = 1600;
 function shrink(file){
  return new Promise((resolve,reject)=>{
   const img=new Image(),url=URL.createObjectURL(file);
   img.onload=()=>{let w=img.naturalWidth,h=img.naturalHeight;const s=Math.min(1,MAX_SIDE/Math.max(w,h));w=Math.round(w*s);h=Math.round(h*s);
    const c=document.createElement('canvas');c.width=w;c.height=h;const x=c.getContext('2d');x.fillStyle='#fff';x.fillRect(0,0,w,h);x.drawImage(img,0,0,w,h);URL.revokeObjectURL(url);
    let q=0.85,d=c.toDataURL('image/jpeg',q);while(d.length>1700000&&q>0.4){q-=0.15;d=c.toDataURL('image/jpeg',q);}resolve(d);};
   img.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('That file isn\'t a photo I can read.'));};img.src=url;});
 }
 document.querySelectorAll('.wbf-form').forEach(form=>{
  const status=form.querySelector('.wbf-status'),btn=form.querySelector('button'),fileIn=form.querySelector('input[type=file]'),prev=form.querySelector('.wbf-preview');
  let photo='';
  try{const saved=JSON.parse(localStorage.getItem('wys-feedback-who')||'{}');if(saved.name)form.name.value=saved.name;if(saved.email)form.email.value=saved.email;}catch{}
  fileIn.addEventListener('change',async()=>{photo='';prev.hidden=true;const f=fileIn.files&&fileIn.files[0];if(!f)return;
   try{photo=await shrink(f);prev.src=photo;prev.hidden=false;status.textContent='';status.className='wbf-status';}catch(e){status.textContent=e.message;status.className='wbf-status err';fileIn.value='';}});
  form.addEventListener('submit',async e=>{e.preventDefault();
   const message=form.message.value.trim();
   if(!message&&!photo){status.textContent='Type a message or add a photo first.';status.className='wbf-status err';return;}
   btn.disabled=true;status.textContent='Sending…';status.className='wbf-status';
   try{try{localStorage.setItem('wys-feedback-who',JSON.stringify({name:form.name.value.trim(),email:form.email.value.trim()}));}catch{}
    const r=await fetch('/api/wys-feedback',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({hp:form.hp.value,name:form.name.value,email:form.email.value,message,page:form.dataset.page||location.pathname,photo,photoType:'image/jpeg',photoName:'screenshot.jpg'})});
    const d=await r.json().catch(()=>({}));
    if(!r.ok||!d.ok)throw new Error(d.error||'That didn\'t send. Try again, or email hello@thedigitalincomeedit.com.');
    status.textContent='Got it, thank you! It\'s on its way to me now.';status.className='wbf-status ok';
    form.message.value='';fileIn.value='';photo='';prev.hidden=true;
   }catch(err){status.textContent=err.message;status.className='wbf-status err';}
   finally{btn.disabled=false;}});
 });
</script>
