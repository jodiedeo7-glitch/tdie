---
import Disclosure from './lifestyle/Disclosure.astro';
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/wys.css';
import '../styles/wys-fonts.css';
import '../styles/wys-showcase.css';
import '../styles/wys-boutique.css';
import '../styles/wys-reference.css';
import '../styles/wys-convert.css';
import '../styles/wys-home.css';
import { WYS_ROOT } from '../data/wys.js';
const {title,description,current='overview',ogImage,noindex=false,focus=false}=Astro.props;
const links=[{key:'overview',name:'The Storefront',href:WYS_ROOT},{key:'inside',name:'Look Inside',href:WYS_ROOT+'/look-inside'},{key:'waitlist',name:'Waitlist',href:WYS_ROOT+'/waitlist'}];
---
<PageLayout bare visualRefresh={false} homeChrome title={title} description={description} ogImage={ogImage} noindex={noindex}>
 <div class="wys-world">
  <a class="wys-skip" href="#wys-content">Skip to content</a>
  {!focus && <div class="wb-shopbar"><div class="wys-wrap wb-shopbar-inner"><nav aria-label="While-You-Sleep Storefront">{links.map(link=><a href={link.href} aria-current={current===link.key?'page':undefined}>{link.name}</a>)}</nav></div></div>}
  <div id="wys-content"><slot /></div>
  {!focus && <div class="wys-wrap wys-foot"><a href="/lifestyle">Explore the Lifestyle edit <span aria-hidden="true">→</span></a><a href="/shop">Back to the TDIE shop <span aria-hidden="true">→</span></a></div>}
  <div class="wys-wrap"><Disclosure /></div>
 </div>
</PageLayout>
