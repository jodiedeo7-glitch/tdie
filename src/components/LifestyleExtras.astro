---
// Lifestyle section extras (Jodie, 24 Sep 2026): the Pink Finds email signup
// plus two cards. Card 1 = TDIE (build and monetize your own AI influencer).
// Card 2 = The Brand Closet™ (affiliate, rel=sponsored + disclosure as a set,
// Standing Rule 18). Signup posts to MailerLite form 199525394616943647,
// group "Lifestyle Pink Finds" (PinkFindsSignup, 25 Sep 2026 campaign).
// Final polish pass: TDIE's own offer is the louder card (ink), the
// affiliate card sits quieter beside it, per the site's affiliate rule.
import "../styles/edit.css";
import PinkFindsSignup from "./PinkFindsSignup.astro";
import { membership as M } from "../data/facts.js";
const BC = "https://www.skool.com/the-brand-closet/about?ref=97643519c9b448d0a683ab33b6cc68ce";
---
<section class="lx" aria-label="Pink Finds email and building your own AI model">
  <PinkFindsSignup variant="box" />

  <p class="lx-eyebrow e-credit"><span>Plot twist: <b>this whole shop is run by an AI model</b></span></p>
  <div class="lx-cards">
    <a class="lx-card lx-own" href="/membership">
      <span class="lx-k">Build your own</span>
      <span class="lx-t">Create an AI influencer, then make her pay</span>
      <span class="lx-d">The girl in these photos isn't real. The shop is. Inside The Digital Income Edit™ you build your own AI twin, give her a look that stays consistent, and turn her into a business that earns while you sleep in.</span>
      <span class="lx-btn">Start with Membership Standard · {M.standard.perMonth} <span aria-hidden="true">→</span></span>
    </a>
    <a class="lx-card lx-aff" href={BC} rel="sponsored nofollow noopener" target="_blank">
      <span class="lx-k">Already have a twin? · Affiliate</span>
      <span class="lx-t">Dress her in what's trending</span>
      <span class="lx-d">The Brand Closet™ hands you trending Amazon looks, done-for-you Pinterest pins and 600+ fashion prompts ready to copy and paste for your AI twin. Copy, paste, post. Paid.</span>
      <span class="lx-btn">Join The Brand Closet™ free<span class="lx-sr"> (opens in a new tab)</span></span>
      <span class="lx-disc">Affiliate link: I earn a commission if you upgrade, at no extra cost to you.</span>
    </a>
  </div>
  <a class="lx-card lx-aff" href="/shop/weekend-ecosystem" style="margin-top:24px">
    <span class="lx-k">Your next step</span>
    <span class="lx-t">The Weekend Ecosystem™</span>
    <span class="lx-d">Explore the guide and see whether it fits what you want to build next.</span>
    <span class="lx-btn">See the guide and current offer <span aria-hidden="true">→</span></span>
  </a>
</section>

<style is:global>
  .lx{margin-top:clamp(56px,8vw,104px)}
  .lx .lx-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
  .lx .lx-eyebrow{display:flex;align-items:center;gap:12px;margin:clamp(56px,7vw,88px) 0 18px}
  .lx .lx-eyebrow::before{content:"";flex:0 0 28px;height:1px;background:var(--e-gold)}
  .lx .lx-cards{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(16px,2vw,24px);align-items:stretch}
  .lx .lx-card{display:flex;flex-direction:column;gap:12px;padding:clamp(26px,3.4vw,44px);border-radius:4px;text-decoration:none}
  .lx .lx-k{font-size:11.5px;letter-spacing:.16em;text-transform:uppercase;font-weight:700}
  .lx .lx-t{font-family:var(--e-serif);font-weight:600;letter-spacing:-.02em;line-height:1.1}
  .lx .lx-d{font-size:15.5px;line-height:1.65;max-width:34em}
  .lx .lx-btn{margin-top:auto;padding-top:14px}

  .lx .lx-own{background:var(--e-ink);color:#F6EFEA}
  .lx .lx-own .lx-k{color:var(--e-bubble)}
  .lx .lx-own .lx-t{font-size:clamp(28px,3.2vw,42px);color:#fff;max-width:14em}
  .lx .lx-own .lx-d{color:rgba(246,239,234,.84)}
  .lx .lx-own .lx-btn{align-self:flex-start;display:inline-flex;align-items:center;gap:10px;min-height:52px;margin-top:auto;padding:14px 26px;border-radius:999px;background:var(--e-pink);color:#fff;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:1.3;transition:background .2s}
  .lx .lx-own:hover .lx-btn{background:var(--e-pink-t)}
  .lx .lx-own .lx-d + .lx-btn{margin-top:18px}

  .lx .lx-aff{background:var(--e-white);border:1px solid var(--e-line);color:var(--e-ink)}
  .lx .lx-aff .lx-k{color:var(--e-ink-3)}
  .lx .lx-aff .lx-t{font-size:clamp(22px,2.2vw,26px)}
  .lx .lx-aff .lx-d{font-size:15px;color:var(--e-ink-2)}
  .lx .lx-aff .lx-btn{display:inline-flex;align-items:center;min-height:44px;font-size:14px;font-weight:600;color:var(--e-pink-t);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:5px;text-decoration-color:rgba(184,36,95,.4)}
  .lx .lx-aff:hover .lx-btn{text-decoration-color:currentColor}
  .lx .lx-disc{font-size:12.5px;color:var(--e-ink-3);line-height:1.5;padding-top:12px;border-top:var(--e-hair)}
  .lx .lx-card:focus-visible{outline:3px solid var(--e-pink);outline-offset:3px}
  @media(max-width:860px){.lx .lx-cards{grid-template-columns:1fr}}
  @media(max-width:480px){.lx .lx-own .lx-btn{align-self:stretch;justify-content:center;text-align:center}}
  @media(prefers-reduced-motion:reduce){.lx .lx-own .lx-btn{transition:none}}
</style>
