---
// Sets the storefront stage on the page (wait, presale, launch, regular) from the switch times in
// src/data/wys-live.js, then swaps the buttons and links at launch. Safe to include more
// than once: it only runs the first time.
import {WYS_PRESALE_AT, WYS_LAUNCH_AT, WYS_REGULAR_AT, WYS_CHECKOUT} from '../data/wys-live.js';
import {WYS_ROOT} from '../data/wys.js';
const P = WYS_PRESALE_AT, L = WYS_LAUNCH_AT, G = WYS_REGULAR_AT, C = WYS_CHECKOUT, R = WYS_ROOT;
---
<script is:inline define:vars={{P, L, G, C, R}}>
(function(){
 var d=document.documentElement; if(d.getAttribute('data-wys-phase'))return;
 var n=Date.now(), p=n>=Date.parse(G)&&C?'regular':n>=Date.parse(L)&&C?'launch':n>=Date.parse(P)?'presale':'wait';
 try{var q=new URLSearchParams(location.search).get('wysphase');if(q==='wait'||q==='presale'||q==='launch'||q==='regular')p=q;}catch(e){}
 d.setAttribute('data-wys-phase',p);
 if(p!=='launch'&&p!=='regular')return;
 var buy=C||(R+'#buy');
 if(/\/while-you-sleep-storefront\/waitlist\/?$/.test(location.pathname)&&!/wysphase=/.test(location.search)){location.replace(R);return;}
 function swap(){
  document.querySelectorAll('a[data-wys-cta]').forEach(function(a){a.href=buy;a.removeAttribute('target');var l=a.querySelector('[data-wys-cta-label]');if(l)l.textContent='Get the Storefront';});
  document.querySelectorAll('a[data-wys-waitlist]').forEach(function(a){a.href=R;var l=a.querySelector('[data-wys-cta-label]');if(l)l.textContent='See the storefront';});
 }
 if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',swap);else swap();
})();
</script>
<style is:global>
 html:not([data-wys-phase]) [data-wys-when]:not([data-wys-when~="wait"]),
 html[data-wys-phase="wait"] [data-wys-when]:not([data-wys-when~="wait"]),
 html[data-wys-phase="presale"] [data-wys-when]:not([data-wys-when~="presale"]),
 html[data-wys-phase="launch"] [data-wys-when]:not([data-wys-when~="launch"]),
 html[data-wys-phase="regular"] [data-wys-when]:not([data-wys-when~="regular"]){display:none!important}
</style>
<style is:global>
 .wys-world .wc-buy-box{padding:34px 26px 26px;background:#fff;border:1px solid #F3D3E0;border-radius:22px;box-shadow:0 30px 56px -34px rgba(110,10,50,.6)}
 .wys-world .wc-buy-h{margin:0 0 6px;font:400 24px/1.15 Gloock,Georgia,serif;color:#1A1417}
 .wys-world .wc-buy-price{margin:0;font:400 44px/1.1 Gloock,Georgia,serif;color:#B8245F}
 .wys-world .wc-buy-price s{font-size:.5em;color:#1A1417;margin-left:8px;text-decoration-thickness:2px}
 .wys-world .wc-buy-p{margin:6px 0 14px;font:500 15px/1.5 Jost,sans-serif;color:#1A1417}
 .wys-world .wc-buy-box .wc-cta{margin:0}
</style>
