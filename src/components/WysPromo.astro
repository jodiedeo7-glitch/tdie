---
// The While-You-Sleep Storefront™ teaser box (Decision 126, Jodie, 2 Oct 2026;
// switched on for the waitlist by Jodie, 10 Oct 2026: "the wys waitlist is live...
// especially the lifestyle and blog pages because thats all literally proof of concept").
// Sits on every Lifestyle page except /lifestyle/pink-finds, on Find Your Door and in
// the /learn articles. Product name always visible. No affiliate rate, no earnings
// claim. Prices live on the sales page; this box only names the presale date.
// `seed` picks one of the lines so neighbouring pages don't repeat.
import { WYS_CTA } from '../data/wys-live.js';
const LINES = [
  {
    k: "Behind the pins",
    t: "Want these exact pins, made automatically?",
    d: "The looks on these pages come out of an automated system. It plans the look, builds the Amazon list, makes the pins and writes the post. It's Tommy Kate's system, and you can run it on your own storefront.",
  },
  {
    k: "How this page got made",
    t: "Planned. Pinned. Posted. Blogged. You slept.",
    d: "The looks on these pages come out of Tommy Kate's storefront system, not late nights in Canva. Set it up once on your Amazon storefront and let it run.",
  },
  {
    k: "Plot twist",
    t: "Looks like these, made automatically.",
    d: "Tommy Kate's storefront system plans the look, builds the Amazon list and makes the pins. Here's how to run the same one.",
  },
  {
    k: "Steal the system",
    t: "Pin like this without designing a single pin.",
    d: "Tommy Kate's whole Amazon pin routine, set up once on your storefront. Your theme, your links, your pins.",
  },
];
const { variant = "box", seed = "" } = Astro.props;
let h = 0;
for (const ch of String(seed)) h = (h * 31 + ch.charCodeAt(0)) >>> 0;
const L = LINES[h % LINES.length];
---
<a class={`wys wys--${variant}`} href={WYS_CTA.href}>
  <span class="wys-copy">
    <span class="wys-k"><span class="wys-new">New</span>The While-You-Sleep Storefront™</span>
    <span class="wys-t">{L.t}</span>
    <span class="wys-d">{L.d}</span>
    <span class="wys-when">Waitlist open now. Member presale opens Tuesday 13 October.</span>
  </span>
  <span class="wys-go">{WYS_CTA.label} <span aria-hidden="true">→</span></span>
</a>

<style is:global>
  .wys{display:flex;flex-direction:column;gap:14px;padding:clamp(18px,2.4vw,26px);border-radius:18px;border:1.5px solid #E891B6;background:#fff;box-shadow:0 18px 34px -22px rgba(110,10,50,.6);color:#1A1417;text-decoration:none;transition:border-color .2s}
  .wys:hover{border-color:#D62E73}
  .wys:focus-visible{outline:3px solid #1A1417;outline-offset:3px}
  .wys .wys-copy{display:flex;flex-direction:column;gap:7px;min-width:0}
  .wys .wys-k{display:flex;flex-wrap:wrap;align-items:center;gap:8px 10px;font:700 11px/1.3 Jost,sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#B8245F}
  .wys .wys-new{border:1.5px solid #B8245F;border-radius:999px;padding:5px 9px;letter-spacing:.18em}
  .wys .wys-t{font:400 clamp(18px,1.6vw,20px)/1.2 Gloock,Georgia,serif;color:#1A1417}
  .wys .wys-d{font:400 15px/1.55 Jost,sans-serif;color:#1A1417;max-width:40em}
  .wys .wys-when{font:600 13px/1.4 Jost,sans-serif;color:#B8245F}
  .wys .wys-go{flex:none;align-self:flex-start;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border:1.5px solid #D62E73;border-radius:999px;background:#fff;font:700 12px/1.2 Jost,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#1A1417}
  .wys:hover .wys-go{border-color:#1A1417}
  .wys--strip{flex-direction:row;align-items:center;justify-content:space-between;gap:clamp(18px,4vw,44px)}
  .wys--strip .wys-go{align-self:center}
  @media(max-width:720px){
    .wys--strip{flex-direction:column;align-items:stretch}
    .wys .wys-go{align-self:stretch;width:100%}
  }
  @media(prefers-reduced-motion:reduce){.wys{transition:none}}
</style>
