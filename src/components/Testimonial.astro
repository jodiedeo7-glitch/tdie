---
import { FEATURED } from "../we-reviews.js";
import "../styles/review-bubble.css";

export interface Props {
  /** full = bordered card with the whole quote. pull = short quote, no card. line = one-line strip. */
  variant?: "full" | "pull" | "line";
  review?: typeof FEATURED;
  eyebrow?: string;
}
const { variant = "full", review = FEATURED, eyebrow } = Astro.props;
const stars = "★".repeat(review.stars ?? 0);
---

{variant === "line" && (
  <figure class="rv-bubble rv-center">
    <span class="rv-q o" aria-hidden="true">&ldquo;</span>
    {review.stars && <span class="rv-stars" aria-label={`${review.stars} out of 5`}>{stars}</span>}
    <blockquote>{review.line}</blockquote>
    <figcaption><b>{review.url ? <a href={review.url} target="_blank" rel="noopener">{review.name}</a> : review.name}</b></figcaption>
    <span class="rv-q c" aria-hidden="true">&rdquo;</span>
  </figure>
)}

{variant === "pull" && (
  <figure class="rv-bubble">
    <span class="rv-q o" aria-hidden="true">&ldquo;</span>
    {review.stars && <span class="rv-stars" aria-label={`${review.stars} out of 5`}>{stars}</span>}
    <blockquote>{review.pull}</blockquote>
    <figcaption><b>{review.url ? <a href={review.url} target="_blank" rel="noopener">{review.name}</a> : review.name}</b>, {review.tenure}</figcaption>
    <span class="rv-q c" aria-hidden="true">&rdquo;</span>
  </figure>
)}

{variant === "full" && (
  <figure class="rv-bubble rv-center">
    <span class="rv-q o" aria-hidden="true">&ldquo;</span>
    {review.stars && <span class="rv-stars" aria-label={`${review.stars} out of 5`}>{stars}</span>}
    <blockquote>{review.quote}</blockquote>
    <figcaption><b>{review.url ? <a href={review.url} target="_blank" rel="noopener">{review.name}</a> : review.name}</b>, {review.tenure}{review.url && <><br/><a href={review.url} target="_blank" rel="noopener">Visit {review.name.split(" ")[0]}'s blog: {review.linkLabel}</a></>}</figcaption>
    <span class="rv-q c" aria-hidden="true">&rdquo;</span>
  </figure>
)}
