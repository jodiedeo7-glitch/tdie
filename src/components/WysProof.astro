---
// Proof: the two live blog pages the system built. Screenshots of real pages.
import {Image} from 'astro:assets';
import {liveLooks} from '../data/wys-live.js';
---
<div class="wc-proof">{liveLooks.map((look) => <article class="wc-proof-card">
 <span class="wc-live-tag">Live now</span>
 <a class="wc-proof-shot" href={look.url} target="_blank" rel="noopener"><Image src={look.blogDesk} alt={`Screenshot of the live blog post ${look.name}`} widths={[480, 760, 1100]} sizes="(max-width:800px) 92vw, 540px"/></a>
 <p class="wc-proof-cat">{look.category}</p>
 <h3>{look.name}</h3>
 <p>{look.blogLine}</p>
 <a class="wc-button wc-button-small" href={look.url} target="_blank" rel="noopener">Open the live post <span aria-hidden="true">↗</span></a>
</article>)}</div>
