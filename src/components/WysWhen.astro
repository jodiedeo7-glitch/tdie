---
// One line of storefront wording that changes with the stage (see WysClock).
// presale falls back to wait; launch falls back to presale.
import WysClock from './WysClock.astro';
const {wait, presale = wait, launch = presale} = Astro.props;
---
<WysClock/>{wait === presale && presale === launch ? <span set:html={wait}/> : <>
<span data-wys-when="wait" set:html={wait}/><span data-wys-when="presale" set:html={presale}/><span data-wys-when="launch" set:html={launch}/></>}
