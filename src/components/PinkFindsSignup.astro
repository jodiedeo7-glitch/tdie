---
// Pink Finds signup (Jodie, 25 Sep 2026). Posts to the MailerLite
// "Lifestyle Pink Finds" form. Variants:
//   strip - slim bar under a page intro (Lifestyle hub, landing page)
//   side  - small box under "Shop the look" on every look page
//   box   - full box (landing page close)
// Copy and the Prime Big Deal Days switch live in src/data/pinkfinds.js.
//
// Accessibility (final polish pass, modelled on FreebieForm.astro): every
// instance owns its ids, so the two or three forms on one lifestyle page
// never share a label, an error or a response frame. A visually hidden
// <label for>, an inline error announced through role="alert" and wired
// with aria-invalid + aria-describedby, 48px field and button, and focus
// moves to the confirmation after submit. Without JavaScript the browser's
// own required/type=email validation runs. The submit mechanism is
// unchanged: a plain POST to PF_ACTION into a hidden iframe.
import { PF_ACTION, PRIME_END, PF } from "../data/pinkfinds.js";
const { variant = "strip", id } = Astro.props;
const UID = Math.random().toString(36).slice(2, 9);
const SINK = "pf-sink-" + UID;
const EMAIL_ID = "pf-email-" + UID;
const ERR_ID = "pf-err-" + UID;
const PRIV_ID = "pf-priv-" + UID;
const primeNow = Date.now() < Date.parse(PRIME_END);
---
<div class={`pf pf-${variant}`} data-pf-end={PRIME_END} id={id}>
  <iframe name={SINK} class="pf-sink" title="Signup response" tabindex="-1" aria-hidden="true"></iframe>
  <form class="pf-form" action={PF_ACTION} method="post" target={SINK} data-pf>
    <div class="pf-copy">
      <p class="pf-k">The Friday email</p>
      <p class="pf-h" data-pf-prime hidden={!primeNow}>{PF.prime.heading}</p>
      <p class="pf-h" data-pf-ever hidden={primeNow}>{PF.evergreen.heading}</p>
      <p class="pf-sub" data-pf-prime hidden={!primeNow}>{PF.prime.sub}</p>
      <p class="pf-sub" data-pf-ever hidden={primeNow}>{PF.evergreen.sub}</p>
    </div>
    <div class="pf-field">
      <div class="pf-row">
        <label class="pf-label" for={EMAIL_ID}>Email address for Pink Finds</label>
        <input
          id={EMAIL_ID}
          type="email"
          name="fields[email]"
          placeholder="your@email.com"
          required
          autocomplete="email"
          inputmode="email"
          spellcheck="false"
          autocapitalize="off"
          aria-describedby={`${ERR_ID} ${PRIV_ID}`}
        />
        <button type="submit">{PF.button}</button>
      </div>
      <p class="pf-error" id={ERR_ID} role="alert"></p>
      <p class="pf-privacy" id={PRIV_ID}>See the <a href="/privacy">privacy policy</a>.</p>
    </div>
    <input type="hidden" name="ml-submit" value="1" />
    <input type="hidden" name="anticsrf" value="true" />
    <p class="pf-done" role="status" tabindex="-1" hidden>{PF.done}</p>
  </form>
</div>

<script is:inline>
  (function () {
    var MSG_EMPTY = 'Add your email address first.';
    var MSG_BAD = 'That email looks incomplete. Check it reads like name@example.com.';
    document.querySelectorAll('[data-pf-end]').forEach(function (box) {
      var prime = Date.now() < Date.parse(box.getAttribute('data-pf-end'));
      box.querySelectorAll('[data-pf-prime]').forEach(function (el) { el.hidden = !prime; });
      box.querySelectorAll('[data-pf-ever]').forEach(function (el) { el.hidden = prime; });
    });
    document.querySelectorAll('form[data-pf]:not([data-pf-ready])').forEach(function (f) {
      f.setAttribute('data-pf-ready', '');
      // JavaScript is running, so the inline error replaces the browser bubble.
      f.noValidate = true;
      var sink = document.getElementsByName(f.target)[0];
      var input = f.querySelector('input[type="email"]');
      var err = f.querySelector('.pf-error');
      var sent = false;
      var shown = false;
      function problem() {
        var v = (input.value || '').trim();
        if (!v) return MSG_EMPTY;
        if (input.value !== v) input.value = v;
        if (!input.checkValidity() || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)) return MSG_BAD;
        return '';
      }
      function show(msg) {
        shown = !!msg;
        err.textContent = msg;
        f.classList.toggle('pf-invalid', shown);
        if (shown) input.setAttribute('aria-invalid', 'true');
        else input.removeAttribute('aria-invalid');
      }
      input.addEventListener('input', function () {
        if (shown && !problem()) show('');
      });
      f.addEventListener('submit', function (e) {
        var msg = problem();
        if (msg) {
          e.preventDefault();
          e.stopImmediatePropagation();
          show(msg);
          input.focus();
          return;
        }
        show('');
        sent = true;
        var b = f.querySelector('button[type="submit"]'); b.disabled = true; b.textContent = 'Sending...';
      });
      sink.addEventListener('load', function () {
        if (!sent) return;
        f.querySelector('.pf-field').hidden = true;
        f.querySelectorAll('.pf-sub').forEach(function (el) { el.hidden = true; });
        var d = f.querySelector('.pf-done');
        d.hidden = false;
        try { d.focus(); } catch (x) {}
        if (window.fbq) fbq('track', 'Lead', { content_name: 'Pink Finds' });
      });
    });
  })();
</script>

<style is:global>
  .pf{--pf-ink:#1A1417;--pf-ink2:#4A3F44;--pf-ink3:#6B5F64;--pf-pink:#D62E73;--pf-pinkt:#B8245F;--pf-err:#B3261E;font-family:"Jost",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--pf-ink)}
  .pf .pf-sink{position:absolute;width:0;height:0;border:0;visibility:hidden}
  .pf [hidden]{display:none !important}
  .pf .pf-form{display:flex;flex-direction:column;gap:18px}
  .pf .pf-k{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-size:11.5px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--pf-pinkt)}
  .pf .pf-k::before{content:"";width:22px;height:1px;background:#E85A9B}
  .pf .pf-h{font-family:"Gloock",Georgia,serif;font-weight:600;font-style:normal;font-size:clamp(24px,2.4vw,30px);line-height:1.12;letter-spacing:-.02em;color:var(--pf-ink);margin:0;text-wrap:balance}
  .pf .pf-sub{font-size:15px;line-height:1.6;color:var(--pf-ink2);margin:10px 0 0;max-width:34em}
  .pf .pf-label{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);clip-path:inset(50%);white-space:nowrap;border:0}
  .pf .pf-row{display:flex;gap:10px;flex-wrap:wrap}
  .pf .pf-row input{flex:1 1 220px;min-width:0;min-height:50px;padding:12px 16px;border:1px solid rgba(26,20,23,.28);border-radius:4px;font-size:16px;font-family:inherit;background:#fff;color:var(--pf-ink)}
  .pf .pf-row input::placeholder{color:var(--pf-ink3);opacity:1}
  .pf .pf-row input:focus{outline:none}
  .pf .pf-row input:focus-visible{outline:3px solid var(--pf-pink);outline-offset:2px}
  .pf .pf-row input[aria-invalid="true"]{border-color:var(--pf-err);box-shadow:inset 0 0 0 1px var(--pf-err)}
  .pf .pf-row button{min-height:50px;padding:12px 26px;background:var(--pf-pink);color:#fff;border:1px solid var(--pf-pink);border-radius:999px;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;font-family:inherit;cursor:pointer;white-space:nowrap;transition:background .2s,border-color .2s}
  .pf .pf-row button:hover{background:var(--pf-pinkt);border-color:var(--pf-pinkt)}
  .pf .pf-row button:focus-visible{outline:3px solid var(--pf-ink);outline-offset:3px}
  .pf .pf-row button:disabled{cursor:progress;opacity:.85}
  .pf .pf-error{margin:0;font-size:14px;line-height:1.45;font-weight:600;color:var(--pf-err)}
  .pf .pf-error:not(:empty){margin-top:10px}
  .pf .pf-error:not(:empty)::before{content:"!";display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;margin-right:8px;border-radius:50%;background:var(--pf-err);color:#fff;font-size:12px;vertical-align:1px}
  .pf .pf-privacy{margin:10px 0 0;font-size:13px;line-height:1.5;color:var(--pf-ink3)}
  .pf .pf-privacy a{display:inline-block;padding:13px 0;margin:-13px 0;color:inherit;text-decoration:underline;text-underline-offset:3px}
  .pf .pf-privacy a:hover{color:var(--pf-pinkt)}
  .pf .pf-privacy a:focus-visible{outline:3px solid var(--pf-pink);outline-offset:2px;border-radius:2px}
  .pf .pf-done{font-family:"Gloock",Georgia,serif;font-weight:600;font-size:22px;line-height:1.35;color:var(--pf-pinkt);margin:0;padding-left:18px;border-left:2px solid var(--pf-pink)}
  .pf .pf-done:focus{outline:none}
  .pf .pf-done:focus-visible{outline:3px solid var(--pf-pink);outline-offset:4px}

  /* strip: a slim paper band between gold hairlines */
  .pf-strip{background:#fff;border-top:1px solid rgba(232,90,155,.55);border-bottom:1px solid rgba(232,90,155,.55);padding:clamp(24px,3vw,34px) clamp(20px,3vw,36px)}
  .pf-strip .pf-form{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,6fr);gap:clamp(20px,4vw,56px);align-items:center}
  /* side: under the shopping list on a look page */
  .pf-side{background:#fff;border:1px solid rgba(26,20,23,.12);border-top:3px solid var(--pf-pink);padding:24px 22px}
  .pf-side .pf-h{font-size:22px}
  .pf-side .pf-sub{font-size:14.5px}
  .pf-side .pf-row button{flex:1 1 100%}
  /* box: the closing signup */
  .pf-box{background:#fff;border:1px solid rgba(26,20,23,.12);border-top:3px solid var(--pf-pink);padding:clamp(28px,4vw,48px)}
  .pf-box .pf-form{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,4vw,56px);align-items:end}
  .pf-box .pf-h{font-size:clamp(28px,3.2vw,40px)}
  .pf-box .pf-done,.pf-strip .pf-done{grid-column:1 / -1}
  @media(max-width:760px){
    .pf-strip .pf-form,.pf-box .pf-form{grid-template-columns:minmax(0,1fr);gap:18px}
    .pf-strip{padding:24px 20px}
  }
  @media(max-width:480px){.pf .pf-row button{flex:1 1 100%;white-space:normal}}
  @media(prefers-reduced-motion:reduce){.pf .pf-row button{transition:none}}
</style>
